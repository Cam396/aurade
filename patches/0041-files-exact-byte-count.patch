+/**
+ * AuraDE: the exact byte count, for the hover text beside a rounded size.
+ *
+ * Returns the empty string wherever an exact count would be a lie: a directory,
+ * a hosted document with no local bytes, an encrypted entry whose size is not
+ * its content, or a size that never arrived. The caller assigns the result
+ * unconditionally so an empty string clears a reused cell.
+ */
+export function auraDeExactBytes(
+    size: number|undefined, special: boolean): string {
+  if (special || typeof size !== 'number' || !isFinite(size) || size < 0) {
+    return '';
+  }
+  const exact = Math.floor(size);
+  const grouped = exact.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return exact === 1 ? '1 byte' : `${grouped} bytes`;
+}
