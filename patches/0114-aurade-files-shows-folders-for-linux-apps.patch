diff --git a/chrome/browser/ash/file_manager/aurade_file_manager_service.cc b/chrome/browser/ash/file_manager/aurade_file_manager_service.cc
new file mode 100644
index 000000000000..fb07578cc338
--- /dev/null
+++ b/chrome/browser/ash/file_manager/aurade_file_manager_service.cc
@@ -0,0 +1,175 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/file_manager/aurade_file_manager_service.h"
+
+#include <map>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/escape.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/ash/system_web_apps/system_web_app_ui_utils.h"
+#include "chromeos/ash/components/system_web_apps/system_web_app_type.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "net/base/filename_util.h"
+
+namespace ash {
+namespace {
+
+constexpr char kServiceName[] = "org.freedesktop.FileManager1";
+constexpr char kObjectPath[] = "/org/freedesktop/FileManager1";
+constexpr char kInterfaceName[] = "org.freedesktop.FileManager1";
+constexpr char kInvalidArgsError[] = "org.freedesktop.DBus.Error.InvalidArgs";
+
+// The Files app's own page; it reads what to show from the query.
+constexpr char kFilesAppUrl[] = "chrome://file-manager/";
+
+// One request opens at most this many windows, whatever it asks for.
+constexpr size_t kMaxWindows = 4;
+
+// A file URI, or a plain absolute path as some applications send instead.
+std::optional<base::FilePath> PathOf(const std::string& uri) {
+  base::FilePath path;
+  if (uri.starts_with('/')) {
+    path = base::FilePath(uri);
+  } else if (!net::FileURLToFilePath(GURL(uri), &path)) {
+    return std::nullopt;
+  }
+  if (!path.IsAbsolute() || path.ReferencesParent()) {
+    return std::nullopt;
+  }
+  return path.StripTrailingSeparators();
+}
+
+}  // namespace
+
+AuraDeFileManagerService::AuraDeFileManagerService(scoped_refptr<dbus::Bus> bus)
+    : bus_(std::move(bus)) {
+  exported_object_ = bus_->GetExportedObject(dbus::ObjectPath(kObjectPath));
+  const std::pair<const char*, Show> methods[] = {
+      {"ShowFolders", Show::kFolders},
+      {"ShowItems", Show::kItems},
+      {"ShowItemProperties", Show::kProperties},
+  };
+  for (const auto& [method, show] : methods) {
+    exported_object_->ExportMethod(
+        kInterfaceName, method,
+        base::BindRepeating(&AuraDeFileManagerService::HandleShow,
+                            weak_ptr_factory_.GetWeakPtr(), show),
+        base::BindOnce(&AuraDeFileManagerService::OnExported,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+  // Ash starts before any application, so the name is free; an installed
+  // file manager's activation file never gets used, and one already running
+  // as a daemon gives the name up.
+  bus_->RequestOwnership(kServiceName, dbus::Bus::REQUIRE_PRIMARY,
+                         base::BindOnce(&AuraDeFileManagerService::OnOwnership,
+                                        weak_ptr_factory_.GetWeakPtr()));
+}
+
+AuraDeFileManagerService::~AuraDeFileManagerService() {
+  if (bus_) {
+    bus_->UnregisterExportedObject(dbus::ObjectPath(kObjectPath));
+  }
+}
+
+// static
+GURL AuraDeFileManagerService::MakeFilesUrl(
+    const base::FilePath& directory,
+    const std::vector<base::FilePath>& selection,
+    bool properties) {
+  base::DictValue args;
+  args.Set("type", "full-page");
+  args.Set("auradeDirectory", directory.value());
+  base::ListValue selected;
+  for (const base::FilePath& path : selection) {
+    selected.Append(path.value());
+  }
+  args.Set("auradeSelection", std::move(selected));
+  if (properties) {
+    args.Set("auradeProperties", true);
+  }
+  return GURL(std::string(kFilesAppUrl) + "?" +
+              base::EscapeUrlEncodedData(base::WriteJson(args).value_or("{}"),
+                                         /*use_plus=*/false));
+}
+
+// static
+void AuraDeFileManagerService::ShowInFiles(
+    const base::FilePath& directory,
+    const std::vector<base::FilePath>& selection,
+    bool properties) {
+  Profile* profile = ProfileManager::GetActiveUserProfile();
+  if (!profile) {
+    LOG(ERROR) << "AuraDE could not show " << directory
+               << " with no user signed in";
+    return;
+  }
+  SystemAppLaunchParams params;
+  params.url = MakeFilesUrl(directory, selection, properties);
+  LaunchSystemWebAppAsync(profile, SystemWebAppType::FILE_MANAGER, params);
+}
+
+void AuraDeFileManagerService::HandleShow(
+    Show show,
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::vector<std::string> uris;
+  if (!reader.PopArrayOfStrings(&uris)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(method_call, kInvalidArgsError,
+                                                 "Expected an array of URIs"));
+    return;
+  }
+
+  std::vector<base::FilePath> paths;
+  for (const std::string& uri : uris) {
+    if (std::optional<base::FilePath> path = PathOf(uri)) {
+      paths.push_back(*path);
+    }
+  }
+
+  if (show == Show::kFolders) {
+    for (size_t i = 0; i < paths.size() && i < kMaxWindows; ++i) {
+      ShowInFiles(paths[i], {}, /*properties=*/false);
+    }
+  } else {
+    // One window per folder, with everything asked for in it selected.
+    std::map<base::FilePath, std::vector<base::FilePath>> by_folder;
+    for (const base::FilePath& path : paths) {
+      by_folder[path.DirName()].push_back(path);
+    }
+    size_t windows = 0;
+    for (const auto& [folder, items] : by_folder) {
+      if (windows++ == kMaxWindows) {
+        break;
+      }
+      ShowInFiles(folder, items, show == Show::kProperties);
+    }
+  }
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+
+void AuraDeFileManagerService::OnExported(const std::string& interface_name,
+                                          const std::string& method_name,
+                                          bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE could not export " << interface_name << "."
+                          << method_name;
+}
+
+void AuraDeFileManagerService::OnOwnership(const std::string& service_name,
+                                           bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE could not own " << service_name;
+}
+
+}  // namespace ash
