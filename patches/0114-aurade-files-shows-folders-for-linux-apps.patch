+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_FILE_MANAGER_AURADE_FILE_MANAGER_SERVICE_H_
+#define CHROME_BROWSER_ASH_FILE_MANAGER_AURADE_FILE_MANAGER_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "dbus/exported_object.h"
+#include "url/gurl.h"
+
+namespace dbus {
+class Bus;
+class MethodCall;
+}  // namespace dbus
+
+namespace ash {
+
+// The session's org.freedesktop.FileManager1. Linux applications ask it to
+// show a folder, or a file in its folder ("Show in folder" on a download,
+// "Open containing folder" in an editor), and AuraDE Files does, rather than
+// whichever other file manager is installed starting up to do it.
+class AuraDeFileManagerService final {
+ public:
+  explicit AuraDeFileManagerService(scoped_refptr<dbus::Bus> bus);
+  AuraDeFileManagerService(const AuraDeFileManagerService&) = delete;
+  AuraDeFileManagerService& operator=(const AuraDeFileManagerService&) = delete;
+  ~AuraDeFileManagerService();
+
+  // The Files app's address for showing |directory| with |selection| picked
+  // in it, and the properties of the selection open when |properties|.
+  static GURL MakeFilesUrl(const base::FilePath& directory,
+                           const std::vector<base::FilePath>& selection,
+                           bool properties);
+
+  // Opens a Files window as MakeFilesUrl describes.
+  static void ShowInFiles(const base::FilePath& directory,
+                          const std::vector<base::FilePath>& selection,
+                          bool properties);
+
+ private:
+  enum class Show { kFolders, kItems, kProperties };
+
+  void HandleShow(Show show,
+                  dbus::MethodCall* method_call,
+                  dbus::ExportedObject::ResponseSender response_sender);
+  void OnExported(const std::string& interface_name,
+                  const std::string& method_name,
+                  bool success);
+  void OnOwnership(const std::string& service_name, bool success);
+
+  scoped_refptr<dbus::Bus> bus_;
+  scoped_refptr<dbus::ExportedObject> exported_object_;
+  base::WeakPtrFactory<AuraDeFileManagerService> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_FILE_MANAGER_AURADE_FILE_MANAGER_SERVICE_H_
