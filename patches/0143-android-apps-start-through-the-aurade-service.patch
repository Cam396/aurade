+#ifndef CHROMEOS_ASH_EXPERIENCES_ARC_SESSION_ARC_AURADE_BRIDGE_H_
+#define CHROMEOS_ASH_EXPERIENCES_ARC_SESSION_ARC_AURADE_BRIDGE_H_
+
+#include <memory>
+
+#include "chromeos/ash/experiences/arc/mojom/arc_bridge.mojom.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+
+namespace arc {
+
+// The Android side of the ARC bridge, run inside Ash. On AuraDE there is no
+// guest that speaks Mojo, so this object plays the guest: it takes the remote
+// end of ArcBridgeHost, publishes an AppInstance, and answers it from the
+// org.aurade.Android1 system service. Everything above it (the launcher, the
+// shelf, App Management) is the unchanged ARC code.
+class ArcAuraDEBridge {
+ public:
+  virtual ~ArcAuraDEBridge() = default;
+};
+
+std::unique_ptr<ArcAuraDEBridge> CreateArcAuraDEBridge(
+    mojo::PendingRemote<mojom::ArcBridgeHost> host);
+
