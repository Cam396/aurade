+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROMEOS_ASH_EXPERIENCES_ARC_SESSION_ARC_AURADE_CLIENT_ADAPTER_H_
+#define CHROMEOS_ASH_EXPERIENCES_ARC_SESSION_ARC_AURADE_CLIENT_ADAPTER_H_
+
+#include <memory>
+
+namespace arc {
+
+class ArcClientAdapter;
+
+// Starts and stops the Android container through the AuraDE system service
+// (org.aurade.Android1 on the system bus) instead of session_manager and
+// concierge, neither of which exists on AuraDE. Used when Ash is started with
+// --aurade-android.
+std::unique_ptr<ArcClientAdapter> CreateArcAuraDEClientAdapter();
+
+// True when Ash was started with --aurade-android.
+bool IsAuraDEAndroidEnabled();
+
+}  // namespace arc
+
+#endif  // CHROMEOS_ASH_EXPERIENCES_ARC_SESSION_ARC_AURADE_CLIENT_ADAPTER_H_
