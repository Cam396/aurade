+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chromeos/ash/experiences/arc/session/arc_aurade_bus.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/logging.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/threading/thread.h"
+#include "dbus/bus.h"
+
+namespace arc {
+
+namespace {
+
+struct Connection {
+  std::unique_ptr<base::Thread> thread;
+  scoped_refptr<dbus::Bus> bus;
+};
+
+}  // namespace
+
+dbus::Bus* GetAuraDEAndroidBus() {
+  static base::NoDestructor<Connection> connection;
+  if (connection->bus) {
+    return connection->bus.get();
+  }
+  connection->thread = std::make_unique<base::Thread>("AuraDE Android D-Bus");
+  base::Thread::Options thread_options(base::MessagePumpType::IO, 0);
+  if (!connection->thread->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "AuraDE Android: could not start the D-Bus thread";
+    connection->thread.reset();
+    return nullptr;
+  }
+  dbus::Bus::Options options;
+  options.bus_type = dbus::Bus::SYSTEM;
+  options.connection_type = dbus::Bus::PRIVATE;
+  options.dbus_task_runner = connection->thread->task_runner();
+  connection->bus = base::MakeRefCounted<dbus::Bus>(std::move(options));
+  return connection->bus.get();
+}
+
+}  // namespace arc
