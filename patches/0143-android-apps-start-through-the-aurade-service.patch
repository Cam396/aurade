+
+namespace dbus {
+class Bus;
+}
+
+namespace arc {
+
+// A connection to the real system bus for talking to org.aurade.Android1.
+// Ash on AuraDE has no shared system bus in DBusThreadManager, so this opens
+// its own, with its own D-Bus thread, once and for the life of the process.
+// Returns null when the system bus cannot be reached. UI thread only.
+dbus::Bus* GetAuraDEAndroidBus();
+
+}  // namespace arc
