diff --git a/chromeos/ash/experiences/arc/session/arc_aurade_bridge.cc b/chromeos/ash/experiences/arc/session/arc_aurade_bridge.cc
new file mode 100644
index 000000000000..663161b9e2da
--- /dev/null
+++ b/chromeos/ash/experiences/arc/session/arc_aurade_bridge.cc
@@ -0,0 +1,350 @@
+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chromeos/ash/experiences/arc/session/arc_aurade_bridge.h"
+
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/containers/span.h"
+#include "chromeos/ash/experiences/arc/session/arc_aurade_bus.h"
+#include "chromeos/ash/experiences/arc/mojom/app.mojom.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace arc {
+
+namespace {
+
+constexpr char kService[] = "org.aurade.Android1";
+constexpr char kPath[] = "/org/aurade/Android1";
+constexpr char kInterface[] = "org.aurade.Android1";
+
+struct AppRow {
+  std::string label;
+  std::string package;
+  std::string activity;
+};
+
+class Bridge : public ArcAuraDEBridge, public mojom::AppInstance {
+ public:
+  explicit Bridge(mojo::PendingRemote<mojom::ArcBridgeHost> host)
+      : host_(std::move(host)) {
+    dbus::Bus* bus = GetAuraDEAndroidBus();
+    if (bus) {
+      proxy_ = bus->GetObjectProxy(kService, dbus::ObjectPath(kPath));
+      Watch("AppsChanged", base::BindRepeating(&Bridge::OnAppsChanged,
+                                               weak_factory_.GetWeakPtr()));
+      Watch("TaskCreated", base::BindRepeating(&Bridge::OnTaskCreatedSignal,
+                                               weak_factory_.GetWeakPtr()));
+      Watch("TaskDestroyed", base::BindRepeating(&Bridge::OnTaskDestroyedSignal,
+                                                 weak_factory_.GetWeakPtr()));
+    } else {
+      LOG(ERROR) << "AuraDE Android: no system bus";
+    }
+    host_->OnAppInstanceReady(receiver_.BindNewPipeAndPassRemote());
+  }
+
+  // mojom::AppInstance:
+  void Init(mojo::PendingRemote<mojom::AppHost> host_remote,
+            InitCallback callback) override {
+    app_host_.reset();
+    app_host_.Bind(std::move(host_remote));
+    std::move(callback).Run();
+    RefreshApps();
+  }
+
+  void CloseTask(int32_t task_id) override {
+    CallService("CloseTask", [&](dbus::MessageWriter& w) {
+      w.AppendInt32(task_id);
+    });
+  }
+  void InstallPackage(mojom::ArcPackageInfoPtr info) override {}
+  void LaunchAppWithWindowInfo(const std::string& package_name,
+                               const std::string& activity,
+                               mojom::WindowInfoPtr window_info) override {
+    CallService("Launch", [&](dbus::MessageWriter& w) {
+      w.AppendString(package_name);
+      w.AppendString(activity);
+    });
+  }
+  void LaunchAppShortcutItem(const std::string& package_name,
+                             const std::string& shortcut_id,
+                             int64_t display_id) override {}
+  void LaunchIntentWithWindowInfo(const std::string& intent_uri,
+                                  mojom::WindowInfoPtr window_info) override {}
+  void UpdateWindowInfo(mojom::WindowInfoPtr window_info) override {}
+
+  void RequestAppIcon(const std::string& package_name,
+                      const std::string& activity,
+                      int32_t pixel_size,
+                      RequestAppIconCallback callback) override {
+    FetchIcon(package_name, std::move(callback));
+  }
+  void GetAppIcon(const std::string& package_name,
+                  const std::string& activity,
+                  int32_t pixel_size,
+                  GetAppIconCallback callback) override {
+    FetchIcon(package_name,
+              base::BindOnce(&Bridge::ReplyRaw, std::move(callback)));
+  }
+  void RequestShortcutIcon(const std::string& icon_resource_id,
+                           int32_t pixel_size,
+                           RequestShortcutIconCallback callback) override {
+    std::move(callback).Run({});
+  }
+  void GetAppShortcutIcon(const std::string& icon_resource_id,
+                          int32_t pixel_size,
+                          GetAppShortcutIconCallback callback) override {
+    std::move(callback).Run(mojom::RawIconPngData::New());
+  }
+  void RequestPackageIcon(const std::string& package_name,
+                          int32_t pixel_size,
+                          bool normalize,
+                          RequestPackageIconCallback callback) override {
+    FetchIcon(package_name, std::move(callback));
+  }
+  void GetPackageIcon(const std::string& package_name,
+                      int32_t pixel_size,
+                      bool normalize,
+                      GetPackageIconCallback callback) override {
+    FetchIcon(package_name,
+              base::BindOnce(&Bridge::ReplyRaw, std::move(callback)));
+  }
+  void RemoveCachedIcon(const std::string& icon_resource_id) override {}
+  void SetTaskActive(int32_t task_id) override {}
+  void ShowPackageInfoDeprecated(const std::string& package_name,
+                                 const gfx::Rect& dimension_on_screen) override {
+  }
+  void ShowPackageInfoOnPageDeprecated(
+      const std::string& package_name,
+      mojom::ShowPackageInfoPage page,
+      const gfx::Rect& dimension_on_screen) override {}
+  void ShowPackageInfoOnPage(const std::string& package_name,
+                             mojom::ShowPackageInfoPage page,
+                             int64_t display_id) override {}
+  void SetNotificationsEnabled(const std::string& package_name,
+                               bool enabled) override {}
+  void StartPaiFlow(StartPaiFlowCallback callback) override {
+    std::move(callback).Run(mojom::PaiFlowState::UNKNOWN);
+  }
+  void StartFastAppReinstallFlow(
+      const std::vector<std::string>& arc_package_names) override {}
+  void UninstallPackage(const std::string& package_name) override {
+    CallService("Uninstall", [&](dbus::MessageWriter& w) {
+      w.AppendString(package_name);
+    });
+  }
+  void UpdateAppDetails(const std::string& package_name) override {}
+  void GetAndroidId(GetAndroidIdCallback callback) override {
+    std::move(callback).Run(0);
+  }
+  void GetAppShortcutGlobalQueryItems(
+      const std::string& query,
+      int32_t max_results,
+      GetAppShortcutGlobalQueryItemsCallback callback) override {
+    std::move(callback).Run({});
+  }
+  void GetAppShortcutItems(const std::string& package_name,
+                           GetAppShortcutItemsCallback callback) override {
+    std::move(callback).Run({});
+  }
+  void GetRecentAndSuggestedAppsFromPlayStore(
+      const std::string& query,
+      int32_t max_results,
+      GetRecentAndSuggestedAppsFromPlayStoreCallback callback) override {
+    std::move(callback).Run(
+        ::arc::ArcPlayStoreSearchRequestState::PLAY_STORE_PROXY_NOT_AVAILABLE,
+        {});
+  }
+  void IsInstallable(const std::string& package_name,
+                     IsInstallableCallback callback) override {
+    std::move(callback).Run(false);
+  }
+  void GetAppCategory(const std::string& package_name,
+                      GetAppCategoryCallback callback) override {
+    std::move(callback).Run(mojom::AppCategory::kUndefined);
+  }
+  void SetAppLocale(const std::string& package_name,
+                    const std::string& locale_tag) override {}
+
+ private:
+  using SignalHandler = base::RepeatingCallback<void(dbus::Signal*)>;
+
+  void Watch(const char* signal, SignalHandler handler) {
+    proxy_->ConnectToSignal(
+        kInterface, signal, std::move(handler),
+        base::BindOnce(
+            [](const std::string&, const std::string& name, bool ok) {
+              LOG_IF(ERROR, !ok) << "AuraDE Android: cannot watch " << name;
+            }));
+  }
+
+  template <typename Fn>
+  void CallService(const char* method, Fn&& fill) {
+    if (!proxy_) {
+      return;
+    }
+    dbus::MethodCall call(kInterface, method);
+    dbus::MessageWriter writer(&call);
+    fill(writer);
+    proxy_->CallMethodWithErrorResponse(
+        &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+        base::BindOnce(
+            [](std::string name, dbus::Response* r, dbus::ErrorResponse* e) {
+              LOG_IF(ERROR, !r) << "AuraDE Android: " << name << " failed: "
+                                << (e ? e->GetErrorName() : "no reply");
+            },
+            std::string(method)));
+  }
+
+  void RefreshApps() {
+    if (!proxy_) {
+      return;
+    }
+    dbus::MethodCall call(kInterface, "ListApps");
+    proxy_->CallMethodWithErrorResponse(
+        &call, dbus::ObjectProxy::TIMEOUT_MAX,
+        base::BindOnce(&Bridge::OnListApps, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnListApps(dbus::Response* response, dbus::ErrorResponse* error) {
+    if (!response) {
+      LOG(ERROR) << "AuraDE Android: ListApps failed: "
+                 << (error ? error->GetErrorName() : "no reply");
+      return;
+    }
+    std::vector<AppRow> rows;
+    dbus::MessageReader reader(response);
+    dbus::MessageReader array(nullptr);
+    if (reader.PopArray(&array)) {
+      while (array.HasMoreData()) {
+        dbus::MessageReader st(nullptr);
+        AppRow row;
+        if (!array.PopStruct(&st) || !st.PopString(&row.label) ||
+            !st.PopString(&row.package) || !st.PopString(&row.activity)) {
+          break;
+        }
+        rows.push_back(std::move(row));
+      }
+    }
+    if (!app_host_.is_bound()) {
+      return;
+    }
+    // A package that disappeared has to be reported as removed; a refreshed
+    // list alone leaves its launcher entry behind.
+    std::set<std::string> current;
+    for (const AppRow& row : rows) {
+      current.insert(row.package);
+    }
+    for (const std::string& gone : known_packages_) {
+      if (!current.count(gone)) {
+        app_host_->OnPackageRemoved(gone);
+      }
+    }
+    known_packages_ = std::move(current);
+    std::vector<mojom::AppInfoPtr> apps;
+    std::vector<mojom::ArcPackageInfoPtr> packages;
+    for (const AppRow& row : rows) {
+      auto app = mojom::AppInfo::New();
+      app->name = row.label;
+      app->package_name = row.package;
+      app->activity = row.activity;
+      app->sticky = false;
+      app->notifications_enabled = true;
+      apps.push_back(std::move(app));
+
+      auto pkg = mojom::ArcPackageInfo::New();
+      pkg->package_name = row.package;
+      pkg->package_version = 1;
+      pkg->last_backup_android_id = 0;
+      pkg->last_backup_time = 0;
+      pkg->sync = false;
+      packages.push_back(std::move(pkg));
+    }
+    app_host_->OnPackageListRefreshed(std::move(packages));
+    app_host_->OnAppListRefreshed(std::move(apps));
+  }
+
+  void FetchIcon(const std::string& package_name,
+                 base::OnceCallback<void(const std::vector<uint8_t>&)> done) {
+    if (!proxy_) {
+      std::move(done).Run({});
+      return;
+    }
+    dbus::MethodCall call(kInterface, "GetIcon");
+    dbus::MessageWriter writer(&call);
+    writer.AppendString(package_name);
+    proxy_->CallMethodWithErrorResponse(
+        &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+        base::BindOnce(
+            [](base::OnceCallback<void(const std::vector<uint8_t>&)> done,
+               dbus::Response* r, dbus::ErrorResponse*) {
+              std::vector<uint8_t> png;
+              if (r) {
+                dbus::MessageReader reader(r);
+                base::span<const uint8_t> bytes;
+                if (reader.PopArrayOfBytes(&bytes)) {
+                  png.assign(bytes.begin(), bytes.end());
+                }
+              }
+              std::move(done).Run(png);
+            },
+            std::move(done)));
+  }
+
+  static void ReplyRaw(base::OnceCallback<void(mojom::RawIconPngDataPtr)> cb,
+                       const std::vector<uint8_t>& png) {
+    auto icon = mojom::RawIconPngData::New();
+    icon->is_adaptive_icon = false;
+    icon->icon_png_data = png;
+    std::move(cb).Run(std::move(icon));
+  }
+
+  void OnAppsChanged(dbus::Signal*) { RefreshApps(); }
+
+  void OnTaskCreatedSignal(dbus::Signal* signal) {
+    dbus::MessageReader reader(signal);
+    int32_t id = 0;
+    std::string pkg, activity;
+    if (!reader.PopInt32(&id) || !reader.PopString(&pkg) ||
+        !reader.PopString(&activity) || !app_host_.is_bound()) {
+      return;
+    }
+    app_host_->OnTaskCreated(id, pkg, activity, std::nullopt, std::nullopt, 0);
+  }
+
+  void OnTaskDestroyedSignal(dbus::Signal* signal) {
+    dbus::MessageReader reader(signal);
+    int32_t id = 0;
+    if (reader.PopInt32(&id) && app_host_.is_bound()) {
+      app_host_->OnTaskDestroyed(id);
+    }
+  }
+
+  std::set<std::string> known_packages_;
+  mojo::Remote<mojom::ArcBridgeHost> host_;
+  mojo::Remote<mojom::AppHost> app_host_;
+  mojo::Receiver<mojom::AppInstance> receiver_{this};
+  raw_ptr<dbus::ObjectProxy> proxy_ = nullptr;
+  base::WeakPtrFactory<Bridge> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<ArcAuraDEBridge> CreateArcAuraDEBridge(
+    mojo::PendingRemote<mojom::ArcBridgeHost> host) {
+  return std::make_unique<Bridge>(std::move(host));
+}
+
+}  // namespace arc
