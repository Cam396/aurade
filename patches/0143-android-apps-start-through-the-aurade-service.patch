+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chromeos/ash/experiences/arc/session/arc_aurade_client_adapter.h"
+
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chromeos/ash/components/cryptohome/cryptohome_parameters.h"
+#include "chromeos/ash/experiences/arc/session/arc_aurade_bus.h"
+#include "chromeos/ash/experiences/arc/session/arc_client_adapter.h"
+#include "chromeos/ash/experiences/arc/session/arc_start_params.h"
+#include "chromeos/ash/experiences/arc/session/arc_upgrade_params.h"
+#include "chromeos/dbus/common/dbus_callback.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+
+namespace arc {
+
+namespace {
+
+constexpr char kSwitch[] = "aurade-android";
+constexpr char kService[] = "org.aurade.Android1";
+constexpr char kPath[] = "/org/aurade/Android1";
+constexpr char kInterface[] = "org.aurade.Android1";
+
+// A mini instance has no meaning for a container that is started by a system
+// service: nothing is preloaded, so the start is reported as done at once and
+// the whole container comes up in UpgradeArc.
+class ArcAuraDEClientAdapter : public ArcClientAdapter {
+ public:
+  ArcAuraDEClientAdapter() = default;
+  ArcAuraDEClientAdapter(const ArcAuraDEClientAdapter&) = delete;
+  ArcAuraDEClientAdapter& operator=(const ArcAuraDEClientAdapter&) = delete;
+  ~ArcAuraDEClientAdapter() override = default;
+
+  void StartMiniArc(StartParams params,
+                    chromeos::VoidDBusMethodCallback callback) override {
+    EnsureProxy();
+    std::move(callback).Run(proxy_ != nullptr);
+  }
+
+  void UpgradeArc(UpgradeParams params,
+                  chromeos::VoidDBusMethodCallback callback) override {
+    EnsureProxy();
+    if (!proxy_) {
+      std::move(callback).Run(false);
+      return;
+    }
+    dbus::MethodCall call(kInterface, "Start");
+    dbus::MessageWriter writer(&call);
+    writer.AppendString(params.locale);
+    proxy_->CallMethodWithErrorResponse(
+        &call, dbus::ObjectProxy::TIMEOUT_MAX,
+        base::BindOnce(&ArcAuraDEClientAdapter::OnStartReply,
+                       weak_factory_.GetWeakPtr(), std::move(callback)));
+  }
+
+  void StopArcInstance(bool on_shutdown, bool should_backup_log) override {
+    EnsureProxy();
+    if (!proxy_) {
+      return;
+    }
+    dbus::MethodCall call(kInterface, "Stop");
+    proxy_->CallMethod(&call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                       base::DoNothing());
+  }
+
+  void SetUserInfo(const cryptohome::Identification& cryptohome_id,
+                   const std::string& hash,
+                   const std::string& serial_number) override {}
+
+  void SetDemoModeDelegate(DemoModeDelegate* delegate) override {}
+
+  void TrimVmMemory(TrimVmMemoryCallback callback, int) override {
+    std::move(callback).Run(false, "not supported");
+  }
+
+ private:
+  void EnsureProxy() {
+    if (proxy_) {
+      return;
+    }
+    dbus::Bus* bus = GetAuraDEAndroidBus();
+    if (!bus) {
+      LOG(ERROR) << "AuraDE Android: no system bus";
+      return;
+    }
+    proxy_ = bus->GetObjectProxy(kService, dbus::ObjectPath(kPath));
+    proxy_->ConnectToSignal(
+        kInterface, "Stopped",
+        base::BindRepeating(&ArcAuraDEClientAdapter::OnStopped,
+                            weak_factory_.GetWeakPtr()),
+        base::BindOnce(&ArcAuraDEClientAdapter::OnSignalConnected,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnStartReply(chromeos::VoidDBusMethodCallback callback,
+                    dbus::Response* response,
+                    dbus::ErrorResponse* error) {
+    if (!response) {
+      LOG(ERROR) << "AuraDE Android: Start failed: "
+                 << (error ? error->GetErrorName() : "no reply");
+    }
+    std::move(callback).Run(response != nullptr);
+  }
+
+  void OnStopped(dbus::Signal* signal) {
+    for (auto& observer : observer_list_) {
+      observer.ArcInstanceStopped(/*is_system_shutdown=*/false);
+    }
+  }
+
+  void OnSignalConnected(const std::string& interface,
+                         const std::string& signal,
+                         bool success) {
+    LOG_IF(ERROR, !success) << "AuraDE Android: could not watch " << signal;
+  }
+
+  raw_ptr<dbus::ObjectProxy> proxy_ = nullptr;
+  base::WeakPtrFactory<ArcAuraDEClientAdapter> weak_factory_{this};
+};
+
+}  // namespace
+
+bool IsAuraDEAndroidEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kSwitch);
+}
+
+std::unique_ptr<ArcClientAdapter> CreateArcAuraDEClientAdapter() {
+  return std::make_unique<ArcAuraDEClientAdapter>();
+}
+
+}  // namespace arc
