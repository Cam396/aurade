+/**
+ * How many files are waiting to be moved.
+ *
+ * The dimming only says which ones while you are looking at the folder they
+ * are in. Walk into another folder and the clipboard becomes invisible again,
+ * which is where the status bar picks it up.
+ */
+export function auraDeCutCount(): number {
+  return cutUrls.size;
+}
+
 /**
  * Whether this entry is waiting to be moved.
  */
 export function auraDeIsCut(entry: Entry|FilesAppEntry): boolean {
   if (cutUrls.size === 0) {
     return false;
   }
   return cutUrls.has(entry.toURL());
 }
