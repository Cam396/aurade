+namespace file_manager::file_tasks {
+namespace {
+
+constexpr char kAuraDeHostControlPath[] = "/usr/bin/aurade-hostctl";
+
+void OpenWithLinuxMimeHandler(base::FilePath path) {
+  base::CommandLine command(base::FilePath{kAuraDeHostControlPath});
+  command.AppendArg("mime");
+  command.AppendArg("open");
+  command.AppendArgPath(path);
+  base::LaunchProcess(command, base::LaunchOptions());
+}
+
+}  // namespace
+
+OpenLinuxVirtualTask::OpenLinuxVirtualTask() = default;
+OpenLinuxVirtualTask::~OpenLinuxVirtualTask() = default;
+
+bool OpenLinuxVirtualTask::IsEnabled(Profile* profile) const {
+  // AuraDE compatibility: use the freedesktop MIME database on generic Linux
+  // while retaining ChromeOS task behavior on ChromeOS images.
+  return !base::SysInfo::IsRunningOnChromeOS() &&
+         base::PathExists(base::FilePath(kAuraDeHostControlPath));
+}
+
+std::string OpenLinuxVirtualTask::id() const {
+  return base::StrCat({ash::file_manager::kChromeUIFileManagerURL, "?",
+                       kActionIdOpenWithLinux});
+}
+
+GURL OpenLinuxVirtualTask::icon_url() const {
+  return GURL();
+}
+
+std::string OpenLinuxVirtualTask::title() const {
+  return "Open with Linux application";
+}
+
+bool OpenLinuxVirtualTask::IsDlpBlocked(
+    const std::vector<std::string>& dlp_source_urls) const {
+  return false;
+}
+
+bool OpenLinuxVirtualTask::Matches(
+    const std::vector<extensions::EntryInfo>& entries,
+    const std::vector<GURL>& file_urls) const {
+  if (entries.empty() || entries.size() != file_urls.size()) {
+    return false;
+  }
+  for (const extensions::EntryInfo& entry : entries) {
+    if (entry.is_directory || !entry.path.IsAbsolute()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool OpenLinuxVirtualTask::Execute(
+    Profile* profile,
+    const TaskDescriptor& task,
+    const std::vector<storage::FileSystemURL>& file_urls) const {
+  if (file_urls.empty()) {
+    return false;
+  }
+  for (const storage::FileSystemURL& file_url : file_urls) {
+    if (!file_url.path().IsAbsolute()) {
+      return false;
+    }
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&OpenWithLinuxMimeHandler, file_url.path()));
+  }
+  return true;
+}
+
+}  // namespace file_manager::file_tasks
