+bool IsAuraDeProtectedPackage(std::string_view package_name) {
+  static constexpr std::string_view kProtectedPackages[] = {
+      "aurade", "aurade-full",    "aurade-host-bridge",
+      "base",   "bash",           "chromiumos-ash",
+      "dbus",   "filesystem",     "glibc",
