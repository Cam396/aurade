+const base::DictValue* ReadAuraDeHostBridgeResponse(
+    dbus::Response* response,
+    base::Value* parsed_response) {
+  if (!response) {
+    return nullptr;
+  }
+
+  std::string json;
+  dbus::MessageReader reader(response);
+  if (!reader.PopString(&json)) {
+    return nullptr;
+  }
+
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict() ||
+      parsed->GetDict().FindBool("ok") != true) {
+    return nullptr;
+  }
+
+  *parsed_response = std::move(*parsed);
+  return parsed_response->GetDict().FindDict("data");
+}
+
+uint64_t ReadAuraDeSize(const base::DictValue& value) {
+  if (std::optional<int> size = value.FindInt("size")) {
+    return *size < 0 ? 0 : static_cast<uint64_t>(*size);
+  }
+  if (std::optional<double> size = value.FindDouble("size")) {
+    return *size < 0 ? 0 : static_cast<uint64_t>(*size);
+  }
+  return 0;
+}
