+  };
+  return std::ranges::contains(kProtectedPackages, package_name);
+}
+
+bool RunAuraDePacmanUninstall(const std::string& package_name) {
+  base::CommandLine uninstall(base::FilePath("/usr/bin/aurade-hostctl"));
+  uninstall.AppendArg("pacman");
+  uninstall.AppendArg("uninstall");
+  uninstall.AppendArg(package_name);
+
+  std::string output;
+  int exit_code = 1;
+  if (!base::GetAppOutputWithExitCode(uninstall, &output, &exit_code) ||
+      exit_code != 0) {
+    return false;
+  }
+  std::optional<base::Value> response =
+      base::JSONReader::Read(output, base::JSON_PARSE_RFC);
+  const base::DictValue* data = response && response->is_dict()
+                                    ? response->GetDict().FindDict("data")
+                                    : nullptr;
+  const std::string* job_id = data ? data->FindString("job_id") : nullptr;
+  if (!job_id) {
+    return false;
+  }
+
+  // AuraDE compatibility: package jobs are asynchronous and serialized by the
+  // host bridge. Wait off the UI thread so the app registry is refreshed only
+  // after pacman has committed its transaction.
+  for (int attempt = 0; attempt < 900; ++attempt) {
+    base::PlatformThread::Sleep(base::Seconds(1));
+    base::CommandLine query(base::FilePath("/usr/bin/aurade-hostctl"));
+    query.AppendArg("pacman");
+    query.AppendArg("job");
+    query.AppendArg(*job_id);
+    output.clear();
+    exit_code = 1;
+    if (!base::GetAppOutputWithExitCode(query, &output, &exit_code) ||
+        exit_code != 0) {
+      continue;
+    }
+    response = base::JSONReader::Read(output, base::JSON_PARSE_RFC);
+    data = response && response->is_dict()
+               ? response->GetDict().FindDict("data")
+               : nullptr;
+    const std::string* state = data ? data->FindString("state") : nullptr;
+    if (!state || *state == "running") {
+      continue;
+    }
+    return *state == "succeeded";
+  }
+  return false;
+}
