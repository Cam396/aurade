+// AuraDE: a name read from the PCI ids database, such as "ES1371/ES1373 /
+// Creative Labs CT2518 (Audio PCI 64V/128/5200 / ...)", makes a notification
+// that runs to four lines and a settings row that cannot be read. The sound
+// card's own short name says the same thing.
+bool IsUnwieldyName(const std::string& name) {
+  return name.size() > 40 || name.find(" / ") != std::string::npos ||
+         name.find('[') != std::string::npos;
+}
