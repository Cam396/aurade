+      closed_future.GetCallback());
+  ime_bridge->SetInputContextHandler(original_input_context);
+
+  ASSERT_TRUE(session_created);
+  ASSERT_TRUE(future.Wait());
+  // A ready context proves that the Orca manager survived while no Lobster
+  // manager was added to the session.
+  EXPECT_TRUE(future.Get().text_and_image_mode() !=
+              editor_menu::TextAndImageMode::kLobsterWithSelectedText);
+  ASSERT_TRUE(closed_future.IsReady());
+  EXPECT_EQ(closed_future.Get().text_and_image_mode(),
+            editor_menu::TextAndImageMode::kBlocked);
+}
