+/**
+ * AuraDE: says what this is and what it is running on.
+ *
+ * Help and Send feedback both left, and neither could be replaced by another
+ * link, because there is no support site to promise. What the gear menu is
+ * still the right home for is the one question a link would have answered
+ * first: what am I actually using. So this says so, in the one line it takes.
+ *
+ * The version is read out of the user agent rather than from loadTimeData,
+ * because the Files app is served the browser's own string and does not
+ * receive a build stamp of its own. A user agent that does not carry one is
+ * not worth inventing around: the name alone is still a true answer.
+ */
+export class AboutAuraDeCommand extends FilesCommand {
+  execute(_event: CommandEvent, fileManager: CommandHandlerDeps) {
+    const match = navigator.userAgent.match(/Chrome\/(\d+(?:\.\d+)*)/);
+    const message = match ? `AuraDE Files, on Chromium ${match[1]}` :
+                            'AuraDE Files';
+    fileManager.ui.toast.show(message);
+    fileManager.ui.speakA11yMessage(message);
+  }
+}
+
