+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (!base::StartsWith(line, "model name", base::CompareCase::SENSITIVE) &&
+          !base::StartsWith(line, "Hardware", base::CompareCase::SENSITIVE)) {
+        continue;
+      }
+
+      const size_t separator = line.find(':');
+      if (separator == std::string_view::npos) {
+        continue;
+      }
+
+      std::string model_name = TrimmedString(line.substr(separator + 1));
+      if (!model_name.empty()) {
+        return model_name;
+      }
+    }
+  }
+
+  std::string architecture = GetArchitecture();
+  return architecture.empty() ? "Unknown CPU" : architecture;
+}
+
+std::string GetLinuxBoardName() {
+  for (const char* path : {"/sys/class/dmi/id/product_name",
+                           "/sys/devices/virtual/dmi/id/product_name",
+                           "/sys/class/dmi/id/board_name"}) {
+    std::optional<std::string> value = ReadTrimmedFile(path);
+    if (value.has_value() && value.value() != "None" &&
+        value.value() != "System Product Name") {
+      return value.value();
+    }
+  }
+
+  return "Linux host";
+}
+
+std::string NormalizePciId(std::string value) {
+  value = TrimmedString(value);
+  if (base::StartsWith(value, "0x", base::CompareCase::INSENSITIVE_ASCII)) {
+    value = value.substr(2);
+  }
+  return LowerAscii(value);
+}
+
+bool IsPciIdToken(std::string_view value) {
+  return value.size() == 4 &&
+         std::all_of(value.begin(), value.end(),
+                     [](unsigned char c) { return std::isxdigit(c); });
+}
+
+std::string PciDeviceKey(std::string_view vendor_id,
+                         std::string_view device_id) {
+  return std::string(vendor_id) + ":" + std::string(device_id);
+}
+
+PciIdsCache& GetPciIdsCache() {
+  static base::NoDestructor<PciIdsCache> cache;
+  return *cache;
+}
+
+void PopulatePciIdsCache(PciIdsCache& cache) {
+  if (cache.loaded) {
+    return;
+  }
+  cache.loaded = true;
+
+  for (const char* path : {"/usr/share/hwdata/pci.ids",
+                           "/usr/share/misc/pci.ids", "/usr/share/pci.ids"}) {
+    std::optional<std::string> contents =
+        ReadFileContents(path, kPciIdsMaxSizeBytes);
+    if (!contents.has_value()) {
+      continue;
+    }
+
+    std::string current_vendor_id;
+    for (std::string_view line :
+         base::SplitStringPiece(contents.value(), "\n", base::KEEP_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (line.empty() || line[0] == '#') {
+        continue;
+      }
+
+      if (line[0] != '\t') {
+        if (line.size() >= 5 && IsPciIdToken(line.substr(0, 4)) &&
+            std::isspace(static_cast<unsigned char>(line[4]))) {
+          current_vendor_id = LowerAscii(std::string(line.substr(0, 4)));
+          cache.vendor_names[current_vendor_id] = TrimmedString(line.substr(4));
+        }
+        continue;
+      }
+
+      if (current_vendor_id.empty() || line.size() < 6 || line[1] == '\t' ||
+          !IsPciIdToken(line.substr(1, 4)) ||
+          !std::isspace(static_cast<unsigned char>(line[5]))) {
+        continue;
+      }
+
+      const std::string current_device_id =
+          LowerAscii(std::string(line.substr(1, 4)));
+      cache.device_names[PciDeviceKey(current_vendor_id, current_device_id)] =
+          TrimmedString(line.substr(5));
+    }
+    return;
+  }
+}
+
+std::optional<PciIdNames> ReadPciIdNames(std::string_view vendor_id,
+                                         std::string_view device_id) {
+  const std::string normalized_vendor_id =
+      NormalizePciId(std::string(vendor_id));
+  const std::string normalized_device_id =
+      NormalizePciId(std::string(device_id));
+  if (normalized_vendor_id.empty()) {
+    return std::nullopt;
+  }
+
+  PciIdsCache& cache = GetPciIdsCache();
+  PopulatePciIdsCache(cache);
+
+  PciIdNames names;
+  if (auto it = cache.vendor_names.find(normalized_vendor_id);
+      it != cache.vendor_names.end()) {
+    names.vendor_name = it->second;
+  }
+  if (!normalized_device_id.empty()) {
+    if (auto it = cache.device_names.find(
+            PciDeviceKey(normalized_vendor_id, normalized_device_id));
+        it != cache.device_names.end()) {
+      names.device_name = it->second;
+    }
+  }
+  if (!names.vendor_name.empty() || !names.device_name.empty()) {
+    return names;
+  }
+
+  return std::nullopt;
+}
+
+bool IsPrimaryDrmCardNode(std::string_view name) {
+  return base::StartsWith(name, "card", base::CompareCase::SENSITIVE) &&
+         name.size() > 4 &&
+         std::all_of(name.begin() + 4, name.end(),
+                     [](unsigned char c) { return std::isdigit(c); });
+}
+
+std::string BasenameFromPath(std::string_view path) {
+  const size_t slash = path.rfind('/');
+  if (slash == std::string_view::npos) {
+    return std::string(path);
+  }
+  return std::string(path.substr(slash + 1));
+}
+
+std::vector<std::string> ReadDirectoryNames(const std::string& path) {
+  std::vector<std::string> names;
+  DIR* dir = opendir(path.c_str());
+  if (!dir) {
+    return names;
+  }
+
+  while (dirent* entry = readdir(dir)) {
+    if (entry->d_name[0] == '.') {
+      continue;
+    }
+    names.emplace_back(entry->d_name);
+  }
+  closedir(dir);
+  std::sort(names.begin(), names.end());
+  return names;
+}
+
+bool IsIndexedSensorInputFile(std::string_view name, std::string_view prefix) {
+  constexpr std::string_view kInputSuffix = "_input";
+  if (!base::StartsWith(name, prefix, base::CompareCase::SENSITIVE) ||
+      !base::EndsWith(name, kInputSuffix, base::CompareCase::SENSITIVE) ||
+      name.size() <= prefix.size() + kInputSuffix.size()) {
+    return false;
+  }
+
+  const std::string_view index = name.substr(
+      prefix.size(), name.size() - prefix.size() - kInputSuffix.size());
+  return std::all_of(index.begin(), index.end(),
+                     [](unsigned char c) { return std::isdigit(c); });
+}
+
+std::string SensorIndex(std::string_view name, std::string_view prefix) {
+  constexpr std::string_view kInputSuffix = "_input";
+  return std::string(name.substr(
+      prefix.size(), name.size() - prefix.size() - kInputSuffix.size()));
+}
+
+std::vector<mojom::GpuSensorReadingPtr> ReadGpuSensorReadings(
+    const std::string& dev_dir,
+    std::string_view prefix,
+    bool millivalue_to_unit,
+    std::string_view fallback_label) {
+  std::vector<mojom::GpuSensorReadingPtr> readings;
+  const std::string hwmon_root = dev_dir + "hwmon";
+  for (const std::string& hwmon_name : ReadDirectoryNames(hwmon_root)) {
+    if (!base::StartsWith(hwmon_name, "hwmon", base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    const std::string hwmon_dir = hwmon_root + "/" + hwmon_name + "/";
+    std::optional<std::string> chip_name =
+        ReadTrimmedFile((hwmon_dir + "name").c_str());
+    for (const std::string& file_name : ReadDirectoryNames(hwmon_dir)) {
+      if (!IsIndexedSensorInputFile(file_name, prefix)) {
+        continue;
+      }
+
+      std::optional<int64_t> raw_value = ReadIntegerFile(hwmon_dir + file_name);
+      if (!raw_value.has_value()) {
+        continue;
+      }
+
+      const std::string index = SensorIndex(file_name, prefix);
+      std::string label =
+          ReadTrimmedFile(
+              (hwmon_dir + std::string(prefix) + index + "_label").c_str())
+              .value_or("");
+      if (label.empty()) {
+        label = std::string(fallback_label) + " " + index;
+      }
+      if (chip_name.has_value() && !chip_name->empty() &&
+          label.find(chip_name.value()) == std::string::npos) {
+        label += " (" + chip_name.value() + ")";
+      }
+
+      auto reading = mojom::GpuSensorReading::New();
+      reading->label = label;
+      reading->value = base::saturated_cast<int32_t>(
+          millivalue_to_unit ? (raw_value.value() + 500) / 1000
+                             : raw_value.value());
+      readings.push_back(std::move(reading));
+    }
+  }
+  return readings;
+}
+
+bool IsIndexedSensorFile(std::string_view name, const SensorKind& kind) {
+  if (!base::StartsWith(name, kind.prefix, base::CompareCase::SENSITIVE)) {
+    return false;
+  }
+  if (!kind.suffix.empty() &&
+      !base::EndsWith(name, kind.suffix, base::CompareCase::SENSITIVE)) {
+    return false;
+  }
+
+  const size_t suffix_size = kind.suffix.size();
+  if (name.size() <= kind.prefix.size() + suffix_size) {
+    return false;
+  }
+
+  const std::string_view index = name.substr(
+      kind.prefix.size(), name.size() - kind.prefix.size() - suffix_size);
+  return std::all_of(index.begin(), index.end(),
+                     [](unsigned char c) { return std::isdigit(c); });
+}
+
+std::string SensorIndex(std::string_view name, const SensorKind& kind) {
+  return std::string(
+      name.substr(kind.prefix.size(),
+                  name.size() - kind.prefix.size() - kind.suffix.size()));
+}
+
+std::vector<mojom::SensorInfoPtr> ReadLinuxSensorInfos() {
+  static constexpr SensorKind kSensorKinds[] = {
+      {"temp", "_input", mojom::SensorType::kTemperature, "Temperature", "C",
+       0.001},
+      {"fan", "_input", mojom::SensorType::kFan, "Fan", "RPM", 1.0},
+      {"in", "_input", mojom::SensorType::kVoltage, "Voltage", "V", 0.001},
+      {"curr", "_input", mojom::SensorType::kCurrent, "Current", "A", 0.001},
+      {"power", "_input", mojom::SensorType::kPower, "Power", "W", 0.000001},
+      {"energy", "_input", mojom::SensorType::kEnergy, "Energy", "J", 0.000001},
+      {"humidity", "_input", mojom::SensorType::kHumidity, "Humidity", "%",
+       0.001},
+      {"freq", "_input", mojom::SensorType::kFrequency, "Frequency", "MHz",
+       0.000001},
+      {"pwm", "", mojom::SensorType::kPwm, "PWM", "PWM", 1.0},
+  };
+
+  std::vector<mojom::SensorInfoPtr> sensors;
+  const std::string hwmon_root = "/sys/class/hwmon";
+  for (const std::string& hwmon_name : ReadDirectoryNames(hwmon_root)) {
+    if (!base::StartsWith(hwmon_name, "hwmon", base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    const std::string hwmon_dir = hwmon_root + "/" + hwmon_name + "/";
+    const std::string device_name =
+        ReadTrimmedFile((hwmon_dir + "name").c_str()).value_or(hwmon_name);
+
+    for (const std::string& file_name : ReadDirectoryNames(hwmon_dir)) {
+      for (const SensorKind& kind : kSensorKinds) {
+        if (!IsIndexedSensorFile(file_name, kind)) {
+          continue;
+        }
+
+        std::optional<int64_t> raw_value =
+            ReadIntegerFile(hwmon_dir + file_name);
+        if (!raw_value.has_value()) {
+          continue;
+        }
+
+        const std::string index = SensorIndex(file_name, kind);
+        std::string label =
+            ReadTrimmedFile(
+                (hwmon_dir + std::string(kind.prefix) + index + "_label")
+                    .c_str())
+                .value_or("");
+        if (label.empty()) {
+          label = std::string(kind.label) + " " + index;
+        }
+
+        auto sensor = mojom::SensorInfo::New();
+        sensor->label = label;
+        sensor->device_name = device_name;
+        sensor->path = hwmon_dir + file_name;
+        sensor->type = kind.type;
+        sensor->value = static_cast<double>(raw_value.value()) * kind.scale;
+        sensor->unit = std::string(kind.unit);
+        sensors.push_back(std::move(sensor));
+        break;
+      }
+    }
+  }
+
+  std::sort(sensors.begin(), sensors.end(),
+            [](const mojom::SensorInfoPtr& a, const mojom::SensorInfoPtr& b) {
+              return std::tie(a->device_name, a->type, a->label, a->path) <
+                     std::tie(b->device_name, b->type, b->label, b->path);
+            });
+  return sensors;
+}
+
+std::string BuildGpuDisplayName(const mojom::GpuInfo& gpu) {
+  if (!gpu.device_name.empty()) {
+    if (!gpu.vendor_name.empty() &&
+        !base::StartsWith(gpu.device_name, gpu.vendor_name,
+                          base::CompareCase::INSENSITIVE_ASCII)) {
+      return gpu.vendor_name + " " + gpu.device_name;
+    }
+    return gpu.device_name;
+  }
+  if (!gpu.vendor_name.empty()) {
+    return gpu.vendor_name + " GPU";
+  }
+  if (!gpu.driver.empty()) {
+    return gpu.driver + " GPU";
+  }
+  return gpu.drm_card.empty() ? "GPU" : "GPU " + gpu.drm_card;
+}
+
+std::vector<mojom::GpuInfoPtr> ReadLinuxGpuInfos() {
+  std::vector<mojom::GpuInfoPtr> gpus;
+  DIR* dir = opendir("/sys/class/drm");
+  if (!dir) {
+    return gpus;
+  }
+
+  while (dirent* entry = readdir(dir)) {
+    std::string name = entry->d_name;
+    // Match primary card nodes only: card0, card1, etc. Skip connectors like
+    // card0-HDMI-A-1 and render/control nodes.
+    if (!IsPrimaryDrmCardNode(name)) {
+      continue;
+    }
+
+    const std::string device_path =
+        std::string("/sys/class/drm/") + name + "/device";
+    if (access(device_path.c_str(), F_OK) != 0) {
+      continue;
+    }
+
+    auto gpu = mojom::GpuInfo::New();
+    gpu->drm_card = name;
+
+    const std::string dev_dir = device_path + "/";
+    std::optional<std::string> vendor =
+        ReadTrimmedFile((dev_dir + "vendor").c_str());
+    std::optional<std::string> device =
+        ReadTrimmedFile((dev_dir + "device").c_str());
+    if (vendor.has_value()) {
+      gpu->vendor_id = NormalizePciId(vendor.value());
+    }
+    if (device.has_value()) {
+      gpu->device_id = NormalizePciId(device.value());
+    }
+
+    std::optional<PciIdNames> names =
+        ReadPciIdNames(gpu->vendor_id, gpu->device_id);
+    if (names.has_value()) {
+      gpu->vendor_name = names->vendor_name;
+      gpu->device_name = names->device_name;
+    }
+
+    std::string driver_path = dev_dir + "driver";
+    if (access(driver_path.c_str(), F_OK) == 0) {
+      std::string link_buf(256, '\0');
+      const ssize_t link_len =
+          readlink(driver_path.c_str(), link_buf.data(), link_buf.size() - 1);
+      if (link_len > 0) {
+        link_buf.resize(static_cast<size_t>(link_len));
+        size_t slash = link_buf.rfind('/');
+        if (slash != std::string::npos) {
+          gpu->driver = link_buf.substr(slash + 1);
+        } else {
+          gpu->driver = link_buf;
+        }
+      }
+    }
+
+    std::string pci_buf(512, '\0');
+    const ssize_t pci_len =
+        readlink(device_path.c_str(), pci_buf.data(), pci_buf.size() - 1);
+    if (pci_len > 0) {
+      pci_buf.resize(static_cast<size_t>(pci_len));
+      gpu->pci_path = BasenameFromPath(pci_buf);
+    }
+
+    gpu->temperatures =
+        ReadGpuSensorReadings(dev_dir, "temp", true, "Temperature");
+    gpu->fans = ReadGpuSensorReadings(dev_dir, "fan", false, "Fan");
+
+    // Attempt to read AMD-specific utilization metrics.
+    auto usage = mojom::GpuUsage::New();
+    bool has_usage = false;
+
+    std::optional<std::string> busy =
+        ReadTrimmedFile((dev_dir + "gpu_busy_percent").c_str());
+    if (busy.has_value()) {
+      unsigned int busy_val = 0;
+      if (base::StringToUint(TrimmedString(busy.value()), &busy_val) &&
+          busy_val <= 100) {
+        usage->gpu_busy_percent = static_cast<uint8_t>(busy_val);
+        has_usage = true;
+      }
+    }
+
+    std::optional<std::string> vram_total =
+        ReadTrimmedFile((dev_dir + "mem_info_vram_total").c_str());
+    if (vram_total.has_value()) {
+      uint64_t vram_val = 0;
+      if (base::StringToUint64(TrimmedString(vram_total.value()), &vram_val)) {
+        usage->vram_total = vram_val;
+        has_usage = true;
+      }
+    }
+
+    std::optional<std::string> vram_used =
+        ReadTrimmedFile((dev_dir + "mem_info_vram_used").c_str());
+    if (vram_used.has_value()) {
+      uint64_t vram_val = 0;
+      if (base::StringToUint64(TrimmedString(vram_used.value()), &vram_val)) {
+        usage->vram_used = vram_val;
+        has_usage = true;
+      }
+    }
+
+    if (has_usage) {
+      gpu->usage = std::move(usage);
+    }
+
+    gpu->display_name = BuildGpuDisplayName(*gpu);
+    gpus.push_back(std::move(gpu));
+  }
+
+  closedir(dir);
+  return gpus;
+}
+
+bool LinuxHostHasBattery() {
+  DIR* dir = opendir("/sys/class/power_supply");
+  if (!dir) {
+    return false;
+  }
+
+  bool has_battery = false;
+  while (dirent* entry = readdir(dir)) {
+    if (entry->d_name[0] == '.') {
+      continue;
+    }
+    std::string type_path =
+        std::string("/sys/class/power_supply/") + entry->d_name + "/type";
+    std::optional<std::string> type = ReadTrimmedFile(type_path.c_str());
+    if (type.has_value() && type.value() == "Battery") {
+      has_battery = true;
+      break;
+    }
+  }
+  closedir(dir);
+  return has_battery;
+}
+
+std::optional<uint16_t> ReadLinuxAverageCpuTemperatureCelsius() {
+  DIR* dir = opendir("/sys/class/thermal");
+  if (!dir) {
+    return std::nullopt;
+  }
+
+  uint64_t total_celsius = 0;
+  uint32_t count = 0;
+  while (dirent* entry = readdir(dir)) {
+    std::string name = entry->d_name;
+    if (!base::StartsWith(name, "thermal_zone", base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    std::string temp_path = std::string("/sys/class/thermal/") + name + "/temp";
+    std::optional<std::string> temp_string = ReadTrimmedFile(temp_path.c_str());
+    if (!temp_string.has_value()) {
+      continue;
+    }
+
+    int temp = 0;
+    if (!base::StringToInt(temp_string.value(), &temp) || temp <= 0) {
+      continue;
+    }
+
+    total_celsius += temp > 1000 ? temp / 1000 : temp;
+    ++count;
+  }
+  closedir(dir);
+
+  if (count == 0) {
+    return std::nullopt;
+  }
+  return base::saturated_cast<uint16_t>(total_celsius / count);
+}
+
+void PopulateLinuxSystemInfo(mojom::SystemInfo& out_system_info) {
+  out_system_info.board_name = GetLinuxBoardName();
+  out_system_info.marketing_name = out_system_info.board_name;
+  out_system_info.cpu_model_name = GetLinuxCpuModelName();
+  out_system_info.cpu_threads_count = GetLinuxCpuThreadCount();
+  out_system_info.cpu_max_clock_speed_khz = GetLinuxCpuMaxClockSpeedKHz();
+
+  if (std::optional<LinuxMemorySnapshot> memory = ReadLinuxMemorySnapshot()) {
+    out_system_info.total_memory_kib = memory->total_memory_kib;
+  } else {
+    out_system_info.total_memory_kib = GetPhysicalMemoryKiB();
+  }
+
+  const std::string os_name =
+      ReadOsReleaseValue("PRETTY_NAME").value_or("Linux");
+  const std::string kernel_version = GetKernelVersion();
+  out_system_info.version_info = mojom::VersionInfo::New(
+      "Linux",
+      kernel_version.empty() ? os_name : os_name + " / " + kernel_version);
+
+  mojom::DeviceCapabilitiesPtr capabilities = mojom::DeviceCapabilities::New();
+  capabilities->has_battery = LinuxHostHasBattery();
+  out_system_info.device_capabilities = std::move(capabilities);
+}
+
+void FillMissingSystemInfoFromLinux(mojom::SystemInfo& out_system_info) {
+  mojom::SystemInfoPtr linux_system_info = mojom::SystemInfo::New();
+  linux_system_info->version_info = mojom::VersionInfo::New();
+  linux_system_info->device_capabilities = mojom::DeviceCapabilities::New();
+  PopulateLinuxSystemInfo(*linux_system_info);
+
+  if (out_system_info.board_name.empty()) {
+    out_system_info.board_name = linux_system_info->board_name;
+  }
+  if (out_system_info.marketing_name.empty() ||
+      out_system_info.marketing_name == "TBD") {
+    out_system_info.marketing_name = linux_system_info->marketing_name;
+  }
+  if (out_system_info.cpu_model_name.empty()) {
+    out_system_info.cpu_model_name = linux_system_info->cpu_model_name;
+  }
+  if (out_system_info.cpu_threads_count == 0) {
+    out_system_info.cpu_threads_count = linux_system_info->cpu_threads_count;
+  }
+  if (out_system_info.cpu_max_clock_speed_khz == 0) {
+    out_system_info.cpu_max_clock_speed_khz =
+        linux_system_info->cpu_max_clock_speed_khz;
+  }
+  if (out_system_info.total_memory_kib == 0) {
+    out_system_info.total_memory_kib = linux_system_info->total_memory_kib;
+  }
+  if (!out_system_info.version_info ||
+      out_system_info.version_info->full_version_string.empty()) {
+    out_system_info.version_info = linux_system_info->version_info.Clone();
+  }
+  if (!out_system_info.device_capabilities) {
+    out_system_info.device_capabilities =
+        linux_system_info->device_capabilities.Clone();
+  }
+}
+
+mojom::MemoryUsagePtr CreateLinuxMemoryUsage() {
+  mojom::MemoryUsagePtr memory_usage = mojom::MemoryUsage::New();
+  if (std::optional<LinuxMemorySnapshot> memory = ReadLinuxMemorySnapshot()) {
+    memory_usage->total_memory_kib = memory->total_memory_kib;
+    memory_usage->free_memory_kib = memory->free_memory_kib;
+    memory_usage->available_memory_kib = memory->available_memory_kib;
+    return memory_usage;
+  }
+
+  memory_usage->total_memory_kib = GetPhysicalMemoryKiB();
+  memory_usage->available_memory_kib = memory_usage->total_memory_kib;
+  memory_usage->free_memory_kib = memory_usage->available_memory_kib;
+  return memory_usage;
