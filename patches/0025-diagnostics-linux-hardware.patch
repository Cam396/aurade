new file mode 100644
index 0000000000..e2aaf52df5
--- /dev/null
+++ b/ash/webui/diagnostics_ui/resources/gpu_card.ts
@@ -0,0 +1,186 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/ash/common/cr_elements/icons.html.js';
+import 'chrome://resources/polymer/v3_0/iron-icon/iron-icon.js';
+import './data_point.js';
+import './diagnostics_card.js';
+import './diagnostics_shared.css.js';
+import './icons.html.js';
+import './percent_bar_chart.js';
+
+import type {PolymerElementProperties} from 'chrome://resources/polymer/v3_0/polymer/interfaces.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './gpu_card.html.js';
+import {getSystemDataProvider} from './mojo_interface_provider.js';
+import type {GpuInfo, GpuSensorReading, GpuUsage, SystemDataProviderInterface} from './system_data_provider.mojom-webui.js';
+import {GpuUsageObserverReceiver} from './system_data_provider.mojom-webui.js';
+
+/**
+ * @fileoverview
+ * 'gpu-card' shows information about the device's GPU(s).
+ */
+
+export class GpuCardElement extends PolymerElement {
+  static get is(): string {
+    return 'gpu-card';
+  }
+
+  static get template(): HTMLTemplateElement {
+    return getTemplate();
+  }
+
+  static get properties(): PolymerElementProperties {
+    return {
+      gpuInfo: {
+        type: Array,
+        value: () => [],
+      },
+
+      showNoGpuMessage: {
+        type: Boolean,
+        value: false,
+      },
+
+    };
+  }
+
+  private gpuInfo: GpuInfo[];
+  private showNoGpuMessage: boolean;
+  private systemDataProvider: SystemDataProviderInterface =
+      getSystemDataProvider();
+  private gpuUsageObserverReceiver: GpuUsageObserverReceiver|null = null;
+
+  constructor() {
+    super();
+    this.fetchGpuInfo();
+    this.observeGpuUsage();
+  }
+
+  override disconnectedCallback(): void {
+    super.disconnectedCallback();
+
+    if (this.gpuUsageObserverReceiver) {
+      this.gpuUsageObserverReceiver.$.close();
+    }
+  }
+
+  private observeGpuUsage(): void {
+    this.gpuUsageObserverReceiver = new GpuUsageObserverReceiver(this);
+    this.systemDataProvider.observeGpuUsage(
+        this.gpuUsageObserverReceiver.$.bindNewPipeAndPassRemote());
+  }
+
+  /**
+   * Implements GpuUsageObserver.onGpuUsageUpdated().
+   */
+  onGpuUsageUpdated(gpuInfo: GpuInfo[]): void {
+    this.gpuInfo = gpuInfo;
+    this.showNoGpuMessage = gpuInfo.length === 0;
+  }
+
+  private fetchGpuInfo(): void {
+    this.systemDataProvider.getGpuInfo().then(
+        (result: {gpuInfo: GpuInfo[]}) => {
+          this.onGpuUsageUpdated(result.gpuInfo);
+        });
+  }
+
+  protected formatVram(bytes: bigint|number): string {
+    if (bytes === 0 || bytes === undefined || bytes === null) {
+      return 'Unavailable';
+    }
+    const gb = Number(bytes) / (1024 * 1024 * 1024);
+    if (gb >= 1) {
+      return gb.toFixed(1) + ' GB';
+    }
+    const mb = Number(bytes) / (1024 * 1024);
+    return mb.toFixed(0) + ' MB';
+  }
+
+  protected formatGpuName(index: number): string {
+    return `GPU ${index + 1}`;
+  }
+
+  protected formatText(value: string): string {
+    return value || 'Unavailable';
+  }
+
+  protected formatDeviceTitle(gpu: GpuInfo, index: number): string {
+    return gpu.displayName || this.formatGpuName(index);
+  }
+
+  protected formatGpuMeta(gpu: GpuInfo): string {
+    return [gpu.driver, gpu.drmCard, gpu.pciPath].filter(Boolean).join(' / ');
+  }
+
+  protected formatNamedId(name: string, id: string): string {
+    if (name && id) {
+      return `${name} (${id})`;
+    }
+    return name || id || 'Unavailable';
+  }
+
+  protected formatPercent(value: number): string {
+    return `${value}%`;
+  }
+
+  protected formatUsage(usage: GpuUsage|null): string {
+    return usage ? this.formatPercent(usage.gpuBusyPercent) : 'Unavailable';
+  }
+
+  protected formatVramPair(usage: GpuUsage|null): string {
+    if (!usage) {
+      return 'Unavailable';
+    }
+    const used = this.formatVram(usage.vramUsed);
+    const total = this.formatVram(usage.vramTotal);
+    if (used === 'Unavailable' && total === 'Unavailable') {
+      return 'Unavailable';
+    }
+    return `${used} / ${total}`;
+  }
+
+  protected getPrimaryUsageHeader(gpuInfo: GpuInfo[]): string {
+    const gpu = gpuInfo.find((entry) => !!entry.usage);
+    if (!gpu) {
+      return gpuInfo.length === 0 ? 'No GPU detected' : 'Live usage unavailable';
+    }
+    return `${gpu.displayName || gpu.drmCard || 'GPU'} busy`;
+  }
+
+  protected getPrimaryUsageBusyPercent(gpuInfo: GpuInfo[]): number {
+    const gpu = gpuInfo.find((entry) => !!entry.usage);
+    return gpu?.usage?.gpuBusyPercent || 0;
+  }
+
+  protected hasTemperatures(gpu: GpuInfo): boolean {
+    return gpu.temperatures.length > 0;
+  }
+
+  protected hasFans(gpu: GpuInfo): boolean {
+    return gpu.fans.length > 0;
+  }
+
+  protected formatSensorLabel(sensor: GpuSensorReading): string {
+    return sensor.label || 'Sensor';
+  }
+
+  protected formatTemperature(sensor: GpuSensorReading): string {
+    return `${sensor.value} C`;
+  }
+
+  protected formatFan(sensor: GpuSensorReading): string {
+    return `${sensor.value} RPM`;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'gpu-card': GpuCardElement;
+  }
+}
+
+customElements.define(GpuCardElement.is, GpuCardElement);
