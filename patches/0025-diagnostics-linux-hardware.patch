diff --git a/ash/webui/diagnostics_ui/resources/gpu_card.html b/ash/webui/diagnostics_ui/resources/gpu_card.html
new file mode 100644
index 0000000000..f2320277c9
--- /dev/null
+++ b/ash/webui/diagnostics_ui/resources/gpu_card.html
@@ -0,0 +1,86 @@
+<style include="diagnostics-shared">
+  .gpu-section {
+    grid-column: 1 / -1;
+    padding: 10px 24px 16px;
+  }
+  .gpu-section:not(:first-of-type) {
+    border-top: 1px solid var(--cros-separator-color);
+  }
+  .gpu-name {
+    color: var(--cros-text-color-primary);
+    font-family: var(--diagnostics-roboto-font-family);
+    font-size: 14px;
+    font-weight: var(--diagnostics-medium-font-weight);
+    padding-bottom: 2px;
+  }
+  .gpu-meta,
+  .metrics-heading {
+    color: var(--cros-text-color-secondary);
+    font-family: var(--diagnostics-roboto-font-family);
+    font-size: 12px;
+  }
+  .gpu-meta {
+    padding-bottom: 12px;
+  }
+  .metrics-heading {
+    border-top: 1px solid var(--cros-separator-color);
+    margin-top: 12px;
+    padding-top: 12px;
+  }
+  .gpu-grid {
+    display: grid;
+    gap: 2px 24px;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .unavailable {
+    color: var(--cros-text-color-secondary);
+  }
+  @media (max-width: 600px) {
+    .gpu-grid {
+      grid-template-columns: 1fr;
+    }
+  }
+</style>
+<diagnostics-card>
+  <div slot="title">GPU</div>
+  <iron-icon slot="icon" icon="diagnostics:gpu"></iron-icon>
+  <percent-bar-chart slot="left-panel"
+      header="[[getPrimaryUsageHeader(gpuInfo)]]"
+      value="[[getPrimaryUsageBusyPercent(gpuInfo)]]">
+  </percent-bar-chart>
+  <template is="dom-repeat" items="[[gpuInfo]]" id="gpuList">
+    <div slot="body" class="gpu-section">
+      <div class="gpu-name">[[formatDeviceTitle(item, index)]]</div>
+      <div class="gpu-meta">[[formatGpuMeta(item)]]</div>
+      <div class="gpu-grid">
+        <data-point orientation="horizontal" header="Vendor" value="[[formatNamedId(item.vendorName, item.vendorId)]]"></data-point>
+        <data-point orientation="horizontal" header="Device" value="[[formatNamedId(item.deviceName, item.deviceId)]]"></data-point>
+        <data-point orientation="horizontal" header="Driver" value="[[formatText(item.driver)]]"></data-point>
+        <data-point orientation="horizontal" header="DRM Card" value="[[formatText(item.drmCard)]]"></data-point>
+        <data-point orientation="horizontal" header="PCI Path" value="[[formatText(item.pciPath)]]"></data-point>
+      </div>
+      <div class="metrics-heading">Live metrics</div>
+      <div class="gpu-grid">
+        <data-point orientation="horizontal" header="Utilization" value="[[formatUsage(item.usage)]]"></data-point>
+        <data-point orientation="horizontal" header="VRAM" value="[[formatVramPair(item.usage)]]"></data-point>
+        <template is="dom-repeat" items="[[item.temperatures]]" as="temperature">
+          <data-point orientation="horizontal" header="[[formatSensorLabel(temperature)]]" value="[[formatTemperature(temperature)]]"></data-point>
+        </template>
+        <template is="dom-if" if="[[!hasTemperatures(item)]]">
+          <data-point orientation="horizontal" header="Temperature" class="unavailable" value="Unavailable"></data-point>
+        </template>
+        <template is="dom-repeat" items="[[item.fans]]" as="fan">
+          <data-point orientation="horizontal" header="[[formatSensorLabel(fan)]]" value="[[formatFan(fan)]]"></data-point>
+        </template>
+        <template is="dom-if" if="[[!hasFans(item)]]">
+          <data-point orientation="horizontal" header="Fan" class="unavailable" value="Unavailable"></data-point>
+        </template>
+      </div>
+    </div>
+  </template>
+  <template is="dom-if" if="[[showNoGpuMessage]]">
+    <div slot="body" class="gpu-section">
+      <data-point orientation="horizontal" header="GPU" class="unavailable" value="No GPU detected"></data-point>
+    </div>
+  </template>
+</diagnostics-card>
