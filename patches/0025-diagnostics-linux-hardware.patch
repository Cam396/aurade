@@ -0,0 +1,168 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/ash/common/cr_elements/icons.html.js';
+import 'chrome://resources/polymer/v3_0/iron-icon/iron-icon.js';
+import './data_point.js';
+import './diagnostics_card.js';
+import './diagnostics_shared.css.js';
+import './icons.html.js';
+
+import {assert} from 'chrome://resources/js/assert.js';
+import type {PolymerElementProperties} from 'chrome://resources/polymer/v3_0/polymer/interfaces.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {DiagnosticsBrowserProxyImpl} from './diagnostics_browser_proxy.js';
+import {getTemplate} from './sensors_page.html.js';
+import {getSystemDataProvider} from './mojo_interface_provider.js';
+import type {SensorInfo, SystemDataProviderInterface} from './system_data_provider.mojom-webui.js';
+import {SensorInfoObserverReceiver, SensorType} from './system_data_provider.mojom-webui.js';
+
+interface SensorGroup {
+  deviceName: string;
+  sensors: SensorInfo[];
+}
+
+export class SensorsPageElement extends PolymerElement {
+  static get is(): 'sensors-page' {
+    return 'sensors-page' as const;
+  }
+
+  static get template(): HTMLTemplateElement {
+    return getTemplate();
+  }
+
+  static get properties(): PolymerElementProperties {
+    return {
+      sensorGroups: {
+        type: Array,
+        value: () => [],
+      },
+
+      showNoSensorsMessage: {
+        type: Boolean,
+        value: false,
+      },
+    };
+  }
+
+  private sensorGroups: SensorGroup[];
+  private showNoSensorsMessage: boolean;
+  private systemDataProvider: SystemDataProviderInterface =
+      getSystemDataProvider();
+  private browserProxy: DiagnosticsBrowserProxyImpl =
+      DiagnosticsBrowserProxyImpl.getInstance();
+  private sensorInfoObserverReceiver: SensorInfoObserverReceiver|null = null;
+
+  constructor() {
+    super();
+    this.fetchSensorInfo();
+    this.observeSensorInfo();
+  }
+
+  override disconnectedCallback(): void {
+    super.disconnectedCallback();
+
+    if (this.sensorInfoObserverReceiver) {
+      this.sensorInfoObserverReceiver.$.close();
+    }
+  }
+
+  private fetchSensorInfo(): void {
+    this.systemDataProvider.getSensorInfo().then(
+        (result: {sensors: SensorInfo[]}) => {
+          this.onSensorInfoUpdated(result.sensors);
+        });
+  }
+
+  private observeSensorInfo(): void {
+    this.sensorInfoObserverReceiver = new SensorInfoObserverReceiver(this);
+    this.systemDataProvider.observeSensorInfo(
+        this.sensorInfoObserverReceiver.$.bindNewPipeAndPassRemote());
+  }
+
+  /**
+   * Implements SensorInfoObserver.onSensorInfoUpdated().
+   */
+  onSensorInfoUpdated(sensors: SensorInfo[]): void {
+    const groups = new Map<string, SensorInfo[]>();
+    for (const sensor of sensors) {
+      const key = sensor.deviceName || 'System sensors';
+      const group = groups.get(key) || [];
+      group.push(sensor);
+      groups.set(key, group);
+    }
+
+    this.sensorGroups = Array.from(groups.entries()).map(
+        ([deviceName, groupSensors]) => ({deviceName, sensors: groupSensors}));
+    this.showNoSensorsMessage = sensors.length === 0;
+  }
+
+  /**
+   * Called by navigation-view-panel when the active page changes.
+   */
+  onNavigationPageChanged({isActive}: {isActive: boolean}): void {
+    if (!isActive) {
+      return;
+    }
+
+    const container: HTMLDivElement|null =
+        this.shadowRoot!.querySelector('#sensorsContainer');
+    assert(container);
+    container.focus();
+    this.browserProxy.recordNavigation('sensors');
+  }
+
+  protected formatSensorValue(sensor: SensorInfo): string {
+    switch (sensor.type) {
+      case SensorType.kFan:
+      case SensorType.kPwm:
+        return `${sensor.value.toFixed(0)} ${sensor.unit}`;
+      case SensorType.kTemperature:
+      case SensorType.kHumidity:
+        return `${sensor.value.toFixed(1)} ${sensor.unit}`;
+      case SensorType.kVoltage:
+      case SensorType.kCurrent:
+      case SensorType.kPower:
+      case SensorType.kEnergy:
+      case SensorType.kFrequency:
+        return `${sensor.value.toFixed(2)} ${sensor.unit}`;
+      case SensorType.kOther:
+        return `${sensor.value} ${sensor.unit}`;
+    }
+  }
+
+  protected formatSensorType(type: SensorType): string {
+    switch (type) {
+      case SensorType.kTemperature:
+        return 'Temperature';
+      case SensorType.kFan:
+        return 'Fan';
+      case SensorType.kVoltage:
+        return 'Voltage';
+      case SensorType.kCurrent:
+        return 'Current';
+      case SensorType.kPower:
+        return 'Power';
+      case SensorType.kEnergy:
+        return 'Energy';
+      case SensorType.kHumidity:
+        return 'Humidity';
