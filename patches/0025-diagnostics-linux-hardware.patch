+
+std::optional<std::string> ReadFileContents(const char* path,
+                                            size_t max_size = 4096) {
+  const int fd = open(path, O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    return std::nullopt;
+  }
+
+  std::string contents;
+  contents.reserve(std::min(max_size, static_cast<size_t>(4096)));
+  char buffer[4096];
+  while (contents.size() < max_size) {
+    const size_t bytes_to_read =
+        std::min(sizeof(buffer), max_size - contents.size());
+    const ssize_t bytes_read = read(fd, buffer, bytes_to_read);
+    if (bytes_read < 0) {
+      close(fd);
+      return std::nullopt;
+    }
+    if (bytes_read == 0) {
+      break;
+    }
+    contents.append(buffer, static_cast<size_t>(bytes_read));
+  }
+  close(fd);
+  return contents;
+}
+
+std::optional<std::string> ReadTrimmedFile(const char* path,
+                                           size_t max_size = 4096) {
+  std::optional<std::string> contents = ReadFileContents(path, max_size);
+  if (!contents.has_value()) {
+    return std::nullopt;
+  }
+
+  std::string trimmed = TrimmedString(contents.value());
+  if (trimmed.empty()) {
+    return std::nullopt;
+  }
+  return trimmed;
+}
+
+std::optional<int64_t> ReadIntegerFile(const std::string& path) {
+  std::optional<std::string> value = ReadTrimmedFile(path.c_str());
+  if (!value.has_value()) {
+    return std::nullopt;
+  }
+
+  int64_t parsed = 0;
+  if (!base::StringToInt64(value.value(), &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+std::optional<std::string> ReadOsReleaseValue(std::string_view key) {
+  std::optional<std::string> contents =
+      ReadTrimmedFile("/etc/os-release", kProcFileMaxSizeBytes);
+  if (!contents.has_value()) {
+    return std::nullopt;
+  }
+
+  const std::string prefix = std::string(key) + "=";
+  for (std::string_view line :
+       base::SplitStringPiece(contents.value(), "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (!base::StartsWith(line, prefix, base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    std::string value = TrimmedString(line.substr(prefix.size()));
+    if (value.size() >= 2 &&
+        ((value.front() == '"' && value.back() == '"') ||
+         (value.front() == '\'' && value.back() == '\''))) {
+      value = value.substr(1, value.size() - 2);
+    }
+    if (!value.empty()) {
+      return value;
+    }
+  }
+
+  return std::nullopt;
+}
+
+std::optional<uint64_t> ParseMeminfoKiB(std::string_view contents,
+                                        std::string_view key) {
+  const std::string prefix = std::string(key) + ":";
+  for (std::string_view line : base::SplitStringPiece(
+           contents, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (!base::StartsWith(line, prefix, base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    std::vector<std::string_view> fields = base::SplitStringPiece(
+        line.substr(prefix.size()), " ", base::TRIM_WHITESPACE,
+        base::SPLIT_WANT_NONEMPTY);
+    if (fields.empty()) {
+      return std::nullopt;
+    }
+
+    uint64_t value = 0;
+    if (base::StringToUint64(fields[0], &value)) {
+      return value;
+    }
+    return std::nullopt;
+  }
+
+  return std::nullopt;
+}
+
+std::optional<LinuxMemorySnapshot> ReadLinuxMemorySnapshot() {
+  std::optional<std::string> contents =
+      ReadFileContents("/proc/meminfo", kProcFileMaxSizeBytes);
+  if (!contents.has_value()) {
+    return std::nullopt;
+  }
+
+  std::optional<uint64_t> total = ParseMeminfoKiB(contents.value(), "MemTotal");
+  if (!total.has_value() || total.value() == 0) {
+    return std::nullopt;
+  }
+
+  LinuxMemorySnapshot snapshot;
+  snapshot.total_memory_kib = KiBToUint32(total.value());
+  snapshot.free_memory_kib =
+      KiBToUint32(ParseMeminfoKiB(contents.value(), "MemFree").value_or(0));
+  snapshot.available_memory_kib =
+      KiBToUint32(ParseMeminfoKiB(contents.value(), "MemAvailable")
+                      .value_or(snapshot.free_memory_kib));
+  return snapshot;
+}
