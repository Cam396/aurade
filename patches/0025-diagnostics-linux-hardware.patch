+std::optional<uint64_t> ParseProcStatCpuTime(std::string_view value) {
+  uint64_t time = 0;
+  if (base::StringToUint64(value, &time)) {
+    return time;
+  }
+  return std::nullopt;
+}
+
+std::optional<CpuUsageData> ReadLinuxCpuUsageData() {
+  std::optional<std::string> contents =
+      ReadFileContents("/proc/stat", kProcFileMaxSizeBytes);
+  if (!contents.has_value()) {
+    return std::nullopt;
+  }
+
+  for (std::string_view line :
+       base::SplitStringPiece(contents.value(), "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (!base::StartsWith(line, "cpu ", base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    std::vector<std::string_view> fields = base::SplitStringPiece(
+        line, " ", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (fields.size() < 5) {
+      return std::nullopt;
+    }
+
+    const uint64_t user = ParseProcStatCpuTime(fields[1]).value_or(0);
+    const uint64_t nice = ParseProcStatCpuTime(fields[2]).value_or(0);
+    const uint64_t system = ParseProcStatCpuTime(fields[3]).value_or(0);
+    const uint64_t idle = ParseProcStatCpuTime(fields[4]).value_or(0);
+    const uint64_t iowait =
+        fields.size() > 5 ? ParseProcStatCpuTime(fields[5]).value_or(0) : 0;
+    const uint64_t irq =
+        fields.size() > 6 ? ParseProcStatCpuTime(fields[6]).value_or(0) : 0;
+    const uint64_t softirq =
+        fields.size() > 7 ? ParseProcStatCpuTime(fields[7]).value_or(0) : 0;
+    const uint64_t steal =
+        fields.size() > 8 ? ParseProcStatCpuTime(fields[8]).value_or(0) : 0;
+
+    return CpuUsageData(user + nice, system + irq + softirq + steal,
+                        idle + iowait);
+  }
+
+  return std::nullopt;
+}
+
+std::optional<uint32_t> ReadLinuxCpuClockKHz() {
+  std::optional<std::string> contents =
+      ReadFileContents("/proc/cpuinfo", kProcFileMaxSizeBytes);
+  if (!contents.has_value()) {
+    return std::nullopt;
+  }
+
+  double max_cpu_mhz = 0;
+  for (std::string_view line :
+       base::SplitStringPiece(contents.value(), "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (!base::StartsWith(line, "cpu MHz", base::CompareCase::SENSITIVE)) {
+      continue;
+    }
+
+    const size_t separator = line.find(':');
+    if (separator == std::string_view::npos) {
+      continue;
+    }
+
+    double cpu_mhz = 0;
+    if (base::StringToDouble(TrimmedString(line.substr(separator + 1)),
+                             &cpu_mhz)) {
+      max_cpu_mhz = std::max(max_cpu_mhz, cpu_mhz);
+    }
+  }
+
+  if (max_cpu_mhz <= 0) {
+    return std::nullopt;
+  }
+
+  return base::saturated_cast<uint32_t>(max_cpu_mhz * 1000);
+}
+
+uint32_t GetLinuxCpuMaxClockSpeedKHz() {
+  uint32_t max_frequency_khz = 0;
+  if (DIR* dir = opendir("/sys/devices/system/cpu")) {
+    while (dirent* entry = readdir(dir)) {
+      std::string name = entry->d_name;
+      if (!base::StartsWith(name, "cpu", base::CompareCase::SENSITIVE) ||
+          name.size() == 3 ||
+          !std::all_of(name.begin() + 3, name.end(),
+                       [](unsigned char c) { return std::isdigit(c); })) {
+        continue;
+      }
+
+      const std::string base_path =
+          "/sys/devices/system/cpu/" + name + "/cpufreq/";
+      for (const char* file_name :
+           {"cpuinfo_max_freq", "scaling_max_freq", "scaling_cur_freq"}) {
+        std::optional<std::string> value =
+            ReadTrimmedFile((base_path + file_name).c_str());
+        uint32_t frequency_khz = 0;
+        if (value.has_value() &&
+            base::StringToUint(value.value(), &frequency_khz)) {
+          max_frequency_khz = std::max(max_frequency_khz, frequency_khz);
+        }
+      }
+    }
+    closedir(dir);
+  }
+  if (max_frequency_khz > 0) {
+    return max_frequency_khz;
+  }
+  return ReadLinuxCpuClockKHz().value_or(0);
+}
