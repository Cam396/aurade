+<style include="cr-shared-style diagnostics-shared">
+  #sensorsContainer {
+    align-items: center;
+    box-sizing: border-box;
+    display: flex;
+    flex-direction: column;
+    height: inherit;
+    position: relative;
+  }
+
+  .sensor-row {
+    border-top: 1px solid var(--cros-separator-color);
+    padding: 12px 24px;
+  }
+
+  .sensor-row:first-of-type {
+    border-top: 0;
+  }
+
+  .sensor-name {
+    color: var(--cros-text-color-primary);
+    font-family: var(--diagnostics-roboto-font-family);
+    font-size: 13px;
+    font-weight: var(--diagnostics-medium-font-weight);
+    padding-bottom: 8px;
+  }
+
+  .sensor-grid {
+    display: grid;
+    gap: 2px 24px;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  @media (max-width: 600px) {
+    .sensor-grid {
+      grid-template-columns: 1fr;
+    }
+  }
+</style>
+<div id="sensorsContainer" tabindex="0">
+  <div class="diagnostics-cards-container-nav">
+    <template is="dom-repeat" items="[[sensorGroups]]" as="group">
+      <div class="card-width">
+        <diagnostics-card is-networking-card="true">
+          <div slot="title">[[group.deviceName]]</div>
+          <iron-icon slot="icon" icon="diagnostics:sensor"></iron-icon>
+          <template is="dom-repeat" items="[[group.sensors]]" as="sensor">
+            <div slot="body" class="sensor-row">
+              <div class="sensor-name">[[sensor.label]]</div>
+              <div class="sensor-grid">
+                <data-point orientation="horizontal" header="Value" value="[[formatSensorValue(sensor)]]"></data-point>
+                <data-point orientation="horizontal" header="Type" value="[[formatSensorType(sensor.type)]]"></data-point>
+                <data-point orientation="horizontal" header="Source" value="[[sensor.path]]"></data-point>
+              </div>
+            </div>
+          </template>
+        </diagnostics-card>
+      </div>
+    </template>
+    <template is="dom-if" if="[[showNoSensorsMessage]]">
+      <div class="card-width">
+        <diagnostics-card is-networking-card="true">
+          <div slot="title">Sensors</div>
+          <iron-icon slot="icon" icon="diagnostics:sensor"></iron-icon>
+          <data-point slot="body" orientation="horizontal" header="Sensors" value="Unavailable"></data-point>
+        </diagnostics-card>
+      </div>
+    </template>
+  </div>
+</div>
