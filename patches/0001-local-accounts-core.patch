+
+bool IsAuraDeLocalAccount(const CoreAccountId& account_id,
+                          const AccountInfo& info) {
+  return base::StartsWith(account_id.ToString(), kAuraLocalGaiaIdPrefix) ||
+         base::StartsWith(info.GetGaiaId().ToString(),
+                          kAuraLocalGaiaIdPrefix) ||
+         base::EndsWith(info.GetEmail(), kAuraLocalAccountDomain);
+}
+
+std::string GetAuraDeLocalUsername(const CoreAccountId& account_id,
+                                   const AccountInfo& info) {
+  const std::string email(info.GetEmail());
+  if (base::EndsWith(email, kAuraLocalAccountDomain)) {
+    return email.substr(0, email.size() - strlen(kAuraLocalAccountDomain));
+  }
+
+  const std::string gaia_id = info.GetGaiaId().ToString();
+  if (base::StartsWith(gaia_id, kAuraLocalGaiaIdPrefix)) {
+    return gaia_id.substr(strlen(kAuraLocalGaiaIdPrefix));
+  }
+
+  const std::string account_id_string = account_id.ToString();
+  if (base::StartsWith(account_id_string, kAuraLocalGaiaIdPrefix)) {
+    return account_id_string.substr(strlen(kAuraLocalGaiaIdPrefix));
+  }
+
+  return "local";
+}
+
+AccountInfo CreateAuraDeLocalAccountInfo(const CoreAccountId& account_id,
+                                         const AccountInfo& info) {
+  const std::string username = GetAuraDeLocalUsername(account_id, info);
+  const std::string gaia_id = kAuraLocalGaiaIdPrefix + username;
+  const std::string email = username + kAuraLocalAccountDomain;
+  return AccountInfo::Builder(GaiaId(gaia_id), email)
+      .SetAccountId(account_id)
+      .SetFullName(username)
+      .SetGivenName(username)
+      .SetHostedDomain(std::string())
+      .SetAvatarUrl(std::string())
+      .SetIsChildAccount(signin::Tribool::kFalse)
+      .Build();
+}
 
