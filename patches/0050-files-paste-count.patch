+/**
+ * AuraDE: each paste command's own label, remembered the first time it is
+ * asked for.
+ *
+ * The label has to be rebuilt from the original every time, not appended to.
+ * canExecute runs on every selection change and every menu open, so appending
+ * to whatever is already there would give Paste (3) (3) (3) within a few
+ * clicks.
+ */
+const auraDePasteLabels = new WeakMap<Command, string>();
+
+/**
+ * AuraDE: says how much is on the clipboard, on the one command in the menu
+ * that acts on something the window is not showing. Paste on its own asks
+ * somebody to remember what they cut, possibly in another window, possibly
+ * ten minutes ago.
+ *
+ * The count is appended rather than replacing the label, because the label is
+ * translated and the number is not.
+ */
+function auraDeLabelPaste(command: Command, count: number) {
+  let base = auraDePasteLabels.get(command);
+  if (base === undefined) {
+    base = command.label;
+    auraDePasteLabels.set(command, base);
+  }
+  // Only when there is more than one. Paste (1) is noise: one item is the
+  // case where somebody already knows what they have.
+  command.label = count > 1 ? `${base} (${count})` : base;
+}
+
