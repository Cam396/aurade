 AuraLocalAccountScreenHandler::~AuraLocalAccountScreenHandler() = default;
 
+namespace {
+
+// AuraDE: the Linux account this session runs as, read from the password
+// database. The full name is the GECOS field up to its first comma, which is
+// where `useradd -c` and the installer put it. Either part can be empty.
+struct LinuxAccountNames {
+  std::string login;
+  std::string full_name;
+};
+
+LinuxAccountNames GetLinuxAccountNames() {
+  LinuxAccountNames names;
+  const struct passwd* entry = getpwuid(getuid());
+  if (!entry) {
+    return names;
+  }
+  if (entry->pw_name) {
+    names.login = entry->pw_name;
+  }
+  if (entry->pw_gecos) {
+    std::string gecos = entry->pw_gecos;
+    names.full_name = gecos.substr(0, gecos.find(','));
+  }
+  return names;
+}
+
+}  // namespace
