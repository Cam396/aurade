+std::string StripDesktopExecFieldCodes(const std::string& exec,
+                                       const std::string& name,
+                                       const base::FilePath& desktop_path) {
+  std::string result;
+  result.reserve(exec.size());
+  for (size_t i = 0; i < exec.size(); ++i) {
+    if (exec[i] != '%' || i + 1 >= exec.size()) {
+      result.push_back(exec[i]);
+      continue;
+    }
+
+    const char code = exec[++i];
+    switch (code) {
+      case '%':
+        result.push_back('%');
+        break;
+      case 'c':
+        result.append("\"");
+        result.append(name);
+        result.append("\"");
+        break;
+      case 'k':
+        result.append("\"");
+        result.append(desktop_path.value());
+        result.append("\"");
+        break;
+      case 'f':
+      case 'F':
+      case 'u':
+      case 'U':
+      case 'i':
+      case 'd':
+      case 'D':
+      case 'n':
+      case 'N':
+      case 'v':
+      case 'm':
+        break;
+      default:
+        break;
+    }
+  }
+  return TrimASCII(result);
+}
+
+std::string FirstExecToken(std::string_view exec) {
+  exec = base::TrimWhitespaceASCII(exec, base::TRIM_ALL);
+  if (exec.empty()) {
+    return std::string();
+  }
+
+  std::string token;
+  bool quoted = false;
+  char quote = '\0';
+  for (char c : exec) {
+    if (!quoted && (c == '\'' || c == '"')) {
+      quoted = true;
+      quote = c;
+      continue;
+    }
+    if (quoted && c == quote) {
+      quoted = false;
+      continue;
+    }
+    if (!quoted && base::IsAsciiWhitespace(c)) {
+      break;
+    }
+    token.push_back(c);
+  }
+  return token;
+}
+
+std::vector<std::string> SplitDesktopList(const std::string& value) {
+  return base::SplitString(value, ";", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY);
+}
+
+std::optional<std::string> ReadPacmanDescField(const std::string& contents,
+                                               std::string_view field_name) {
+  const std::string marker = "%" + std::string(field_name) + "%";
+  bool read_next_line = false;
+  for (std::string_view raw_line : base::SplitStringPiece(
+           contents, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    const std::string line = TrimASCII(std::string(raw_line));
+    if (read_next_line) {
+      return line.empty() ? std::nullopt : std::make_optional(line);
+    }
+    read_next_line = line == marker;
+  }
+  return std::nullopt;
+}
+
+std::map<std::string, AuraDeHostPackageMetadata>
+BuildAuraDeHostPackageMetadataMap() {
+  std::map<std::string, AuraDeHostPackageMetadata> packages_by_file;
+  const base::FilePath pacman_db("/var/lib/pacman/local");
+  if (!base::DirectoryExists(pacman_db)) {
+    return packages_by_file;
+  }
+
+  base::FileEnumerator package_dirs(pacman_db, /*recursive=*/false,
+                                    base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath package_dir = package_dirs.Next(); !package_dir.empty();
+       package_dir = package_dirs.Next()) {
+    std::string desc_contents;
+    std::string files_contents;
+    if (!base::ReadFileToString(package_dir.AppendASCII("desc"),
+                                &desc_contents) ||
+        !base::ReadFileToString(package_dir.AppendASCII("files"),
+                                &files_contents)) {
+      continue;
+    }
+
+    std::optional<std::string> name =
+        ReadPacmanDescField(desc_contents, "NAME");
+    std::optional<std::string> version =
+        ReadPacmanDescField(desc_contents, "VERSION");
+    if (!name || name->empty()) {
+      continue;
+    }
+
+    AuraDeHostPackageMetadata metadata;
+    metadata.name = *name;
+    metadata.version = version.value_or(std::string());
+
+    bool in_files = false;
+    for (std::string_view raw_line :
+         base::SplitStringPiece(files_contents, "\n", base::KEEP_WHITESPACE,
+                                base::SPLIT_WANT_ALL)) {
+      const std::string line = TrimASCII(std::string(raw_line));
+      if (line.empty()) {
+        continue;
+      }
+      if (line.front() == '%' && line.back() == '%') {
+        in_files = line == "%FILES%";
+        continue;
+      }
+      if (!in_files || !base::EndsWith(line, ".desktop")) {
+        continue;
+      }
+
+      packages_by_file.emplace("/" + line, metadata);
+    }
+  }
+
+  return packages_by_file;
+}
+
+bool CanFindExecutable(const std::string& executable,
+                       base::Environment& environment) {
+  if (executable.empty()) {
+    return false;
+  }
+
+  base::FilePath path(executable);
+  if (path.IsAbsolute()) {
+    return base::PathExists(path);
+  }
+
+  std::string path_env;
+  if (std::optional<std::string> env_path = environment.GetVar("PATH")) {
+    path_env = *env_path;
+  } else {
+    path_env = "/usr/local/bin:/usr/bin:/bin";
+  }
+
+  for (const std::string& dir : base::SplitString(
+           path_env, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (base::PathExists(base::FilePath(dir).Append(executable))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::vector<std::string> IconFileNames(const std::string& icon) {
+  const base::FilePath icon_path(icon);
+  const std::string extension = base::ToLowerASCII(icon_path.Extension());
+  if (extension == ".svg" || extension == ".png") {
+    return {icon_path.BaseName().value()};
+  }
+  return {icon + ".svg", icon + ".png", icon};
+}
+
+std::vector<base::FilePath> AuraDeIconThemeDirs(const base::FilePath& root) {
+  static constexpr const char* kThemes[] = {"hicolor", "Adwaita", "gnome"};
+  static constexpr const char* kSubdirs[] = {
+      "scalable/apps", "symbolic/apps", "512x512/apps", "256x256/apps",
+      "128x128/apps",  "96x96/apps",    "64x64/apps",   "48x48/apps",
+      "32x32/apps",    "24x24/apps",    "16x16/apps"};
+
+  std::vector<base::FilePath> dirs;
+  for (const char* theme : kThemes) {
+    for (const char* subdir : kSubdirs) {
+      dirs.push_back(root.AppendASCII(theme).AppendASCII(subdir));
+    }
+  }
+  return dirs;
+}
+
+base::FilePath ResolveAuraDeHostIconPath(const std::string& icon,
+                                         base::Environment& environment) {
+  if (icon.empty()) {
+    return base::FilePath();
+  }
+
+  const base::FilePath raw_icon_path(icon);
+  if (raw_icon_path.IsAbsolute() && base::PathExists(raw_icon_path)) {
+    return raw_icon_path;
+  }
+
+  std::vector<base::FilePath> icon_roots;
+  if (std::optional<std::string> home = environment.GetVar("HOME");
+      home && !home->empty()) {
+    icon_roots.push_back(
+        base::FilePath(*home).AppendASCII(".local/share/icons"));
+    icon_roots.push_back(base::FilePath(*home).AppendASCII(".icons"));
+  }
+  icon_roots.emplace_back("/usr/local/share/icons");
+  icon_roots.emplace_back("/usr/share/icons");
+
+  std::vector<base::FilePath> candidate_dirs;
+  candidate_dirs.emplace_back("/usr/local/share/pixmaps");
+  candidate_dirs.emplace_back("/usr/share/pixmaps");
+  for (const base::FilePath& root : icon_roots) {
+    std::vector<base::FilePath> theme_dirs = AuraDeIconThemeDirs(root);
+    candidate_dirs.insert(candidate_dirs.end(), theme_dirs.begin(),
+                          theme_dirs.end());
+  }
+
+  const std::vector<std::string> names = IconFileNames(icon);
+  for (const base::FilePath& dir : candidate_dirs) {
+    for (const std::string& name : names) {
+      const base::FilePath path = dir.Append(name);
+      if (base::PathExists(path)) {
+        return path;
+      }
+    }
+  }
+
+  for (const base::FilePath& root : icon_roots) {
+    base::FileEnumerator enumerator(root, /*recursive=*/true,
+                                    base::FileEnumerator::FILES);
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      for (const std::string& name : names) {
+        if (path.BaseName().value() == name) {
+          return path;
+        }
+      }
+    }
+  }
+
+  return base::FilePath();
+}
+
+bool InstallAuraDeHostIconOnThread(const base::FilePath& source_icon,
+                                   const base::FilePath& svg_path,
+                                   const base::FilePath& png_100p_path,
+                                   const base::FilePath& png_200p_path,
+                                   const base::FilePath& png_300p_path) {
+  if (source_icon.empty() || !base::PathExists(source_icon)) {
+    return false;
+  }
+
+  const base::FilePath icon_dir = svg_path.DirName();
+  base::DeletePathRecursively(icon_dir);
+  if (!base::CreateDirectory(icon_dir)) {
+    return false;
+  }
+
+  const std::string extension = base::ToLowerASCII(source_icon.Extension());
+  if (extension == ".svg") {
+    return base::CopyFile(source_icon, svg_path);
+  }
+  if (extension == ".png") {
+    bool ok = base::CopyFile(source_icon, png_100p_path);
+    ok &= base::CopyFile(source_icon, png_200p_path);
+    ok &= base::CopyFile(source_icon, png_300p_path);
+    return ok;
+  }
+
+  return false;
+}
