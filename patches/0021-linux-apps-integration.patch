+std::vector<AuraDeHostDesktopApp> ScanAuraDeHostDesktopApps() {
+  std::vector<base::FilePath> dirs;
+  auto environment = base::Environment::Create();
+  if (std::optional<std::string> home = environment->GetVar("HOME");
+      home && !home->empty()) {
+    dirs.push_back(
+        base::FilePath(*home).AppendASCII(".local/share/applications"));
+  }
+  dirs.emplace_back("/usr/local/share/applications");
+  dirs.emplace_back("/usr/share/applications");
+
+  std::vector<AuraDeHostDesktopApp> apps;
+  std::set<std::string> seen_desktop_ids;
+  // AuraDE compatibility: surface Arch package metadata in App Info for host
+  // Linux apps without invoking pacman once per desktop file.
+  const std::map<std::string, AuraDeHostPackageMetadata> packages_by_file =
+      BuildAuraDeHostPackageMetadataMap();
+  for (const base::FilePath& dir : dirs) {
+    base::FileEnumerator enumerator(dir, /*recursive=*/false,
+                                    base::FileEnumerator::FILES,
+                                    FILE_PATH_LITERAL("*.desktop"));
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      AuraDeHostDesktopApp app;
+      if (!ParseDesktopFile(path, *environment, &app) ||
+          !IsAuraDeHostDesktopAppAllowed(app) ||
+          !seen_desktop_ids.insert(app.desktop_file_id).second) {
+        continue;
+      }
+      const auto package = packages_by_file.find(app.desktop_path.value());
+      if (package != packages_by_file.end()) {
+        app.package_name = package->second.name;
+        app.package_version = package->second.version;
+      }
+      apps.push_back(std::move(app));
+    }
+  }
+  return apps;
+}
+
+void LaunchAuraDeHostAppOnThread(std::string command) {
+  auto environment = base::Environment::Create();
+
+  base::CommandLine command_line(base::FilePath("/bin/sh"));
+  std::string wayland_display = ChooseAuraDeHostWaylandDisplay(*environment);
+  if (ShouldUseNestedAuraDeHostCompositor(*environment)) {
+    const std::string socket_name = MakeAuraDeHostSocketName();
+    wayland_display = kAuraDeHostWaylandSocket;
+
+    command_line = base::CommandLine(base::FilePath(kAuraDeNestedWestonPath));
+    command_line.AppendArg("--backend=wayland");
+    command_line.AppendArg("--shell=kiosk-shell.so");
+    command_line.AppendArg("--renderer=pixman");
+    command_line.AppendArg("--socket=" + socket_name);
+    command_line.AppendArg("--width=1280");
+    command_line.AppendArg("--height=800");
+    command_line.AppendArg("--idle-time=0");
+    command_line.AppendArg("--");
+    command_line.AppendArg("/usr/bin/env");
+    command_line.AppendArg("WAYLAND_DISPLAY=" + socket_name);
+    command_line.AppendArg("/bin/sh");
+    command_line.AppendArg("-lc");
+    command_line.AppendArg(command);
+  } else {
+    command_line.AppendArg("-lc");
+    command_line.AppendArg(command);
+  }
+
+  base::LaunchOptions options;
+  if (std::optional<std::string> home = environment->GetVar("HOME");
+      home && !home->empty()) {
+    options.current_directory = base::FilePath(*home);
+  }
+  options.environment["WAYLAND_DISPLAY"] = wayland_display;
+  options.environment["GDK_BACKEND"] = "wayland";
+  options.environment["GSK_RENDERER"] = "cairo";
+  options.environment["LIBGL_ALWAYS_SOFTWARE"] = "1";
+  options.environment["QT_QPA_PLATFORM"] = "wayland";
+  options.environment["SDL_VIDEODRIVER"] = "wayland";
+  options.environment["MOZ_ENABLE_WAYLAND"] = "1";
+  options.environment["NO_AT_BRIDGE"] = "1";
+  options.environment["XDG_CURRENT_DESKTOP"] = "AuraDE";
+  options.environment["XDG_SESSION_DESKTOP"] = "aurade";
+  options.environment["DESKTOP_SESSION"] = "aurade";
+  options.environment["LANG"] = "C.UTF-8";
+  options.environment["LC_ALL"] = "C.UTF-8";
+  base::LaunchProcess(command_line, options);
+}
