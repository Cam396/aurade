 void CrostiniApps::CreateAppOverrides(
     const guest_os::GuestOsRegistryService::Registration& registration,
     App* app) {
+  const bool is_aurade_host_app = IsAuraDeHostRegistration(registration);
   // Per crbug.com/40624403, Crostini apps aren't going to be added in App
-  // Management.
-  app->show_in_management = false;
+  // Management. AuraDE host apps are local Linux desktop apps and should have
+  // a useful App info surface.
+  app->show_in_management = is_aurade_host_app;
+  if (!is_aurade_host_app) {
+    return;
+  }
+
+  const auto host_app = aurade_host_apps_.find(registration.app_id());
+  app->publisher_id = "aurade-host:" + registration.DesktopFileId();
+  app->window_mode = WindowMode::kWindow;
+  app->allow_window_mode_selection = false;
+  app->resize_locked = false;
+  app->allow_uninstall = false;
+  app->SetExtraField("aurade_host_app", true);
+
+  if (host_app == aurade_host_apps_.end()) {
+    app->description = "Linux desktop application";
+    return;
+  }
+
+  const AuraDeHostDesktopApp& metadata = host_app->second;
+  if (!metadata.comment.empty()) {
+    app->description = metadata.comment;
+  } else if (!metadata.generic_name.empty()) {
+    app->description = metadata.generic_name;
+  } else {
+    app->description = "Linux desktop application";
+  }
+
+  app->SetExtraField("source", "AuraDE Linux apps");
+  if (!metadata.package_name.empty()) {
+    app->version = metadata.package_name;
+    if (!metadata.package_version.empty()) {
+      app->version->append(" ");
+      app->version->append(metadata.package_version);
+    }
+  }
+  app->SetExtraField("desktop_file_id", metadata.desktop_file_id);
+  app->SetExtraField("desktop_file_path", metadata.desktop_path.value());
+  app->SetExtraField("icon_name", metadata.icon);
+  app->SetExtraField("icon_path", metadata.icon_path.value());
+  app->SetExtraField("package_name", metadata.package_name);
+  app->SetExtraField("package_version", metadata.package_version);
+  app->SetExtraField("comment", metadata.comment);
+  app->SetExtraField("generic_name", metadata.generic_name);
+  app->SetExtraField("categories", base::JoinString(metadata.categories, ", "));
+  app->SetExtraField("keywords", base::JoinString(metadata.keywords, ", "));
+  app->SetExtraField("mime_types", base::JoinString(metadata.mime_types, ", "));
+
+  if (!metadata.generic_name.empty()) {
+    app->additional_search_terms.push_back(metadata.generic_name);
+  }
+  for (const std::string& category : metadata.categories) {
+    app->additional_search_terms.push_back(category);
+  }
+  for (const std::string& keyword : metadata.keywords) {
+    app->additional_search_terms.push_back(keyword);
+  }
+}
+
+void CrostiniApps::RefreshAuraDeHostApps() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ScanAuraDeHostDesktopApps),
+      base::BindOnce(&CrostiniApps::OnAuraDeHostAppsScanned,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void CrostiniApps::OnAuraDeHostAppsScanned(
+    std::vector<AuraDeHostDesktopApp> host_apps) {
+  auto* registry =
+      guest_os::GuestOsRegistryServiceFactory::GetForProfile(profile());
+  if (!registry) {
+    return;
+  }
+
+  vm_tools::apps::ApplicationList app_list;
+  app_list.set_vm_type(vm_tools::apps::VmType::TERMINA);
+  app_list.set_vm_name(kAuraDeHostVmName);
+  app_list.set_container_name(kAuraDeHostContainerName);
+
+  aurade_host_execs_.clear();
+  aurade_host_apps_.clear();
+  std::vector<std::pair<std::string, base::FilePath>> icon_install_requests;
+  for (const AuraDeHostDesktopApp& host_app : host_apps) {
+    vm_tools::apps::App* app = app_list.add_apps();
+    app->set_desktop_file_id(host_app.desktop_file_id);
+    app->mutable_name()->add_values()->set_value(host_app.name);
+    app->set_exec(host_app.exec);
+    app->set_executable_file_name(
+        base::FilePath(FirstExecToken(host_app.exec)).BaseName().value());
+    app->set_no_display(false);
+    app->set_terminal(false);
+    app->set_startup_wm_class(host_app.startup_wm_class);
+    app->set_startup_notify(host_app.startup_notify);
+
+    const std::string app_id = guest_os::GuestOsRegistryService::GenerateAppId(
+        host_app.desktop_file_id, kAuraDeHostVmName, kAuraDeHostContainerName);
+    aurade_host_execs_.emplace(app_id, host_app.exec);
+    aurade_host_apps_.emplace(app_id, host_app);
+    if (!host_app.icon_path.empty()) {
+      icon_install_requests.emplace_back(app_id, host_app.icon_path);
+    }
+  }
+
+  registry->UpdateApplicationList(app_list);
+
+  for (const auto& [app_id, icon_path] : icon_install_requests) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&InstallAuraDeHostIconOnThread, icon_path,
+                       registry->GetIconPath(app_id, ui::kScaleFactorNone),
+                       registry->GetIconPath(app_id, ui::k100Percent),
+                       registry->GetIconPath(app_id, ui::k200Percent),
+                       registry->GetIconPath(app_id, ui::k300Percent)),
+        base::BindOnce(&CrostiniApps::OnAuraDeHostIconInstalled,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+}
+
+void CrostiniApps::OnAuraDeHostIconInstalled(bool success) {
+  if (!success || !registry()) {
+    return;
+  }
+  registry()->ContainerBadgeColorChanged(guest_os::GuestId(
+      guest_os::VmType::TERMINA, kAuraDeHostVmName, kAuraDeHostContainerName));
+}
+
+bool CrostiniApps::LaunchAuraDeHostApp(const std::string& app_id) {
+  const auto exec = aurade_host_execs_.find(app_id);
+  if (exec == aurade_host_execs_.end()) {
+    return false;
+  }
+
+  if (registry()) {
+    registry()->AppLaunched(app_id);
+  }
+
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&LaunchAuraDeHostAppOnThread, exec->second));
+  return true;
 }
 
 }  // namespace apps
