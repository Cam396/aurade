+bool ShouldUseNestedAuraDeHostCompositor(base::Environment& environment) {
+  std::optional<std::string> enable_nesting =
+      environment.GetVar("AURADE_ENABLE_HOST_APP_NESTING");
+  if (!enable_nesting || !IsTruthyEnvValue(*enable_nesting)) {
+    return false;
