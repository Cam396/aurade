+bool IsAuraDeHostRegistration(
+    const guest_os::GuestOsRegistryService::Registration& registration) {
+  return registration.VmName() == kAuraDeHostVmName &&
+         registration.ContainerName() == kAuraDeHostContainerName;
+}
