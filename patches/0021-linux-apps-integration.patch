+bool ParseDesktopFile(const base::FilePath& path,
+                      base::Environment& environment,
+                      AuraDeHostDesktopApp* app) {
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    return false;
+  }
+
+  std::map<std::string, std::string> fields;
+  bool in_desktop_entry = false;
+  for (std::string_view raw_line : base::SplitStringPiece(
+           contents, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    std::string line = TrimASCII(std::string(raw_line));
+    if (line.empty() || line[0] == '#') {
+      continue;
+    }
+    if (line.front() == '[' && line.back() == ']') {
+      in_desktop_entry = line == "[Desktop Entry]";
+      continue;
+    }
+    if (!in_desktop_entry) {
+      continue;
+    }
+
+    const size_t equals = line.find('=');
+    if (equals == std::string::npos) {
+      continue;
+    }
+    const std::string key = line.substr(0, equals);
+    if (!fields.contains(key)) {
+      fields.emplace(key, line.substr(equals + 1));
+    }
+  }
+
+  if (fields["Type"] != "Application" || fields["Name"].empty() ||
+      fields["Exec"].empty() || IsTruthyDesktopValue(fields["NoDisplay"]) ||
+      IsTruthyDesktopValue(fields["Hidden"]) ||
+      IsTruthyDesktopValue(fields["Terminal"])) {
+    return false;
+  }
+
+  if (!fields["TryExec"].empty() &&
+      !CanFindExecutable(fields["TryExec"], environment)) {
+    return false;
+  }
+
+  app->desktop_file_id = path.BaseName().value();
+  app->name = fields["Name"];
+  app->generic_name = fields["GenericName"];
+  app->comment = fields["Comment"];
+  app->exec = StripDesktopExecFieldCodes(fields["Exec"], app->name, path);
+  app->icon = fields["Icon"];
+  app->icon_path = ResolveAuraDeHostIconPath(app->icon, environment);
+  app->desktop_path = path;
+  app->categories = SplitDesktopList(fields["Categories"]);
+  app->keywords = SplitDesktopList(fields["Keywords"]);
+  app->mime_types = SplitDesktopList(fields["MimeType"]);
+  app->startup_wm_class = fields["StartupWMClass"];
+  app->startup_notify = IsTruthyDesktopValue(fields["StartupNotify"]);
+  return !app->exec.empty();
+}
+
+bool IsAuraDeHostDesktopAppAllowed(const AuraDeHostDesktopApp& app) {
+  const std::string desktop_file_id = base::ToLowerASCII(app.desktop_file_id);
+  const std::string name = base::ToLowerASCII(app.name);
+
+  static constexpr std::string_view kBlockedDesktopIds[] = {
+      "avahi-discover.desktop",  "bssh.desktop",        "bvnc.desktop",
+      "foot-server.desktop",     "footclient.desktop",  "lstopo.desktop",
+      "thunar-settings.desktop", "xfce4-about.desktop",
+  };
+  for (std::string_view blocked_id : kBlockedDesktopIds) {
+    if (desktop_file_id == blocked_id) {
+      return false;
+    }
+  }
+
+  static constexpr std::string_view kBlockedNameFragments[] = {
+      "about xfce",  "foot client",    "foot server", "hardware locality",
+      "preferences", "server browser", "settings",
+  };
+  for (std::string_view fragment : kBlockedNameFragments) {
+    if (name.find(fragment) != std::string::npos) {
+      return false;
+    }
+  }
+
+  return true;
+}
