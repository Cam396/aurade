+constexpr char kHostctl[] = "/usr/bin/aurade-hostctl";
+constexpr char kResultPrefix[] = "aurade-install://";
+constexpr char kNotificationPrefix[] = "aurade-install-";
+constexpr char kNotifierId[] = "aurade.install";
+// The app ID AuraDE's apps publisher gives the computer's own application
+// with this desktop entry: GuestOsRegistryService::GenerateAppId for its
+// "aurade-host" VM and "host" container, which this target cannot depend on.
+std::string HostAppId(const std::string& desktop_id) {
+  return crx_file::id_util::GenerateId("crostini:aurade-host/host/" +
+                                       desktop_id);
+}
+
+constexpr size_t kMinQueryLength = 2;
+constexpr int kMaxResults = 5;
+constexpr base::TimeDelta kDebounce = base::Milliseconds(250);
+constexpr base::TimeDelta kJobPollInterval = base::Seconds(1);
+// Large applications on a slow mirror take a while; an hour is the limit.
+constexpr int kMaxJobPolls = 3600;
+
+std::optional<base::Value> RunHostctl(const std::vector<std::string>& args) {
+  const base::FilePath hostctl(kHostctl);
+  if (!base::PathExists(hostctl)) {
+    return std::nullopt;
+  }
+  base::CommandLine command(hostctl);
+  for (const std::string& arg : args) {
+    command.AppendArg(arg);
+  }
+  std::string output;
+  int exit_code = 1;
+  // hostctl reports refusals as JSON with a nonzero exit, so the output is
+  // read whatever the exit code.
+  base::GetAppOutputWithExitCode(command, &output, &exit_code);
+  std::optional<base::Value> response =
+      base::JSONReader::Read(output, base::JSON_PARSE_RFC);
+  if (!response || !response->is_dict()) {
+    return std::nullopt;
+  }
+  return response;
+}
+
+std::optional<base::Value> SearchCatalog(const std::string& query) {
+  return RunHostctl({"pacman", "search", query, "--limit",
+                     base::NumberToString(kMaxResults * 2)});
+}
+
+struct InstallRequest {
+  std::string package;
+  std::u16string name;
+  std::string desktop_id;
+  gfx::ImageSkia icon;
+};
+
+struct InstallResult {
+  enum class Outcome { kInstalled, kDeclined, kFailed };
+  Outcome outcome = Outcome::kFailed;
+  std::u16string reason;
+};
+
+InstallResult RunInstall(const std::string& package) {
+  using Outcome = InstallResult::Outcome;
+  std::optional<base::Value> response =
+      RunHostctl({"pacman", "install", package});
+  if (!response) {
+    return {Outcome::kFailed, u""};
+  }
+  const base::DictValue* data = response->GetDict().FindDict("data");
+  const std::string* job_id = data ? data->FindString("job_id") : nullptr;
+  if (!job_id) {
+    const std::string* code =
+        response->GetDict().FindStringByDottedPath("error.code");
+    if (code && *code == "not_authorized") {
+      return {Outcome::kDeclined, u""};
+    }
+    if (code && *code == "busy") {
+      return {Outcome::kFailed,
+              u"Another app is being installed or removed. Try again when "
+              u"it's done."};
+    }
+    return {Outcome::kFailed, u""};
+  }
+
+  // The bridge runs pacman as a job and serializes them; wait for this one
+  // off the UI thread.
+  for (int poll = 0; poll < kMaxJobPolls; ++poll) {
+    base::PlatformThread::Sleep(kJobPollInterval);
+    std::optional<base::Value> job = RunHostctl({"pacman", "job", *job_id});
+    const base::DictValue* job_data =
+        job ? job->GetDict().FindDict("data") : nullptr;
+    const std::string* state =
+        job_data ? job_data->FindString("state") : nullptr;
+    if (!state || *state == "running") {
+      continue;
+    }
+    if (*state == "succeeded") {
+      return {Outcome::kInstalled, u""};
+    }
+    // What people meet: no network, or a package newer than the local
+    // package lists know.
+    for (const char* stream : {"stdout", "stderr"}) {
+      const std::string* text = job_data->FindString(stream);
+      if (!text) {
+        continue;
+      }
+      if (text->find("failed retrieving file") != std::string::npos ||
+          text->find("failed to retrieve some files") != std::string::npos) {
+        return {Outcome::kFailed,
+                u"It couldn't be downloaded. Check the connection, or update "
+                u"the computer and try again."};
+      }
+      if (text->find("not enough free disk space") != std::string::npos) {
+        return {Outcome::kFailed, u"There isn't enough free space."};
+      }
+    }
+    return {Outcome::kFailed, u""};
+  }
+  return {Outcome::kFailed, u""};
+}
