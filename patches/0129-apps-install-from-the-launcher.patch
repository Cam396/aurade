+// Installs one app at a time per package and reports each in a
+// notification. It outlives the launcher's searches, which come and go.
+class AuraDeAppInstaller {
+ public:
+  static AuraDeAppInstaller* Get() {
+    static base::NoDestructor<AuraDeAppInstaller> installer;
+    return installer.get();
+  }
+
+  void Install(Profile* profile, InstallRequest request) {
+    if (!installing_.insert(request.package).second) {
+      return;
+    }
+    Notify(profile, request, message_center::NOTIFICATION_TYPE_PROGRESS,
+           u"Installing " + request.name,
+           u"You may be asked for the administrator password.",
+           /*clickable=*/false);
+    const std::string package = request.package;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&RunInstall, package),
+        base::BindOnce(&AuraDeAppInstaller::OnInstalled,
+                       base::Unretained(this), std::move(request)));
+  }
+
+ private:
+  friend class base::NoDestructor<AuraDeAppInstaller>;
+  AuraDeAppInstaller() = default;
+
+  void OnInstalled(InstallRequest request, InstallResult result) {
+    installing_.erase(request.package);
+    // The person who asked may have signed out while it ran.
+    Profile* profile = ProfileManager::GetPrimaryUserProfile();
+    if (!profile) {
+      return;
+    }
+    using Outcome = InstallResult::Outcome;
+    switch (result.outcome) {
+      case Outcome::kInstalled:
+        NotifyWhenListed(std::move(request), /*tries_left=*/40);
+        return;
+      case Outcome::kDeclined:
+        // Cancelling the password prompt needs no message of its own.
+        NotificationDisplayServiceFactory::GetForProfile(profile)->Close(
+            NotificationHandler::Type::TRANSIENT,
+            kNotificationPrefix + request.package);
+        return;
+      case Outcome::kFailed:
+        Notify(profile, request, message_center::NOTIFICATION_TYPE_SIMPLE,
+               request.name + u" couldn't be installed",
+               result.reason.empty() ? u"Something went wrong. Try again later."
+                                     : result.reason,
+               /*clickable=*/false);
+        return;
+    }
+  }
+
+  // The launcher lists the app a few seconds after pacman is done: it waits
+  // for the package's files to settle, then scans. Saying it is in the
+  // launcher, and offering to open it, waits for that, but not forever.
+  void NotifyWhenListed(InstallRequest request, int tries_left) {
+    Profile* profile = ProfileManager::GetPrimaryUserProfile();
+    if (!profile) {
+      return;
+    }
+    bool listed = request.desktop_id.empty();
+    if (!listed) {
+      apps::AppServiceProxyFactory::GetForProfile(profile)
+          ->AppRegistryCache()
+          .ForOneApp(HostAppId(request.desktop_id),
+                     [&listed](const apps::AppUpdate& update) {
+                       listed = update.Readiness() == apps::Readiness::kReady;
+                     });
+    }
+    if (!listed && tries_left > 0) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&AuraDeAppInstaller::NotifyWhenListed,
+                         base::Unretained(this), std::move(request),
+                         tries_left - 1),
+          base::Milliseconds(500));
+      return;
+    }
+    Notify(profile, request, message_center::NOTIFICATION_TYPE_SIMPLE,
+           request.name + u" is installed",
+           listed ? u"It's in the launcher with your other apps."
+                  : u"It will be in the launcher in a moment.",
+           /*clickable=*/listed && !request.desktop_id.empty());
+  }
+
+  static void Launch(const std::string& package,
+                     const std::string& desktop_id,
+                     std::optional<int> button_index) {
+    Profile* profile = ProfileManager::GetPrimaryUserProfile();
+    if (!profile) {
+      return;
+    }
+    apps::AppServiceProxyFactory::GetForProfile(profile)->Launch(
+        HostAppId(desktop_id),
+        ui::EF_NONE, apps::LaunchSource::kFromInstaller, nullptr);
+    NotificationDisplayServiceFactory::GetForProfile(profile)->Close(
+        NotificationHandler::Type::TRANSIENT, kNotificationPrefix + package);
+  }
+
+  void Notify(Profile* profile,
+              const InstallRequest& request,
+              message_center::NotificationType type,
+              const std::u16string& title,
+              const std::u16string& message,
+              bool clickable) {
+    message_center::RichNotificationData data;
+    if (type == message_center::NOTIFICATION_TYPE_PROGRESS) {
+      // pacman says nothing about how far along it is that is worth showing.
+      data.progress = -1;
+    }
+    scoped_refptr<message_center::NotificationDelegate> delegate;
+    if (clickable) {
+      data.buttons.emplace_back(u"Open");
+      delegate =
+          base::MakeRefCounted<message_center::HandleNotificationClickDelegate>(
+              base::BindRepeating(&AuraDeAppInstaller::Launch,
+                                  request.package, request.desktop_id));
+    }
+    message_center::Notification notification(
+        type, kNotificationPrefix + request.package, title, message,
+        request.icon.isNull() ? ui::ImageModel()
+                              : ui::ImageModel::FromImageSkia(request.icon),
+        /*display_source=*/u"Apps", GURL(),
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId),
+        data, delegate);
+    // The outcome replaces the progress notification, and would otherwise do
+    // so silently in the closed tray; it shows itself again.
+    notification.set_renotify(type !=
+                              message_center::NOTIFICATION_TYPE_PROGRESS);
+    NotificationDisplayServiceFactory::GetForProfile(profile)->Display(
+        NotificationHandler::Type::TRANSIENT, notification,
+        /*metadata=*/nullptr);
+  }
+
+  std::set<std::string> installing_;
+};
+
+// An application in the catalog that can be installed.
+class AuraDeInstallResult : public ChromeSearchResult {
+ public:
+  AuraDeInstallResult(Profile* profile,
+                      const std::string& package,
+                      const std::string& name,
+                      const std::string& summary,
+                      const std::string& desktop_id,
+                      const std::string& icon_png,
+                      double relevance)
+      : profile_(profile),
+        package_(package),
+        name_(base::UTF8ToUTF16(name)),
+        desktop_id_(desktop_id) {
+    set_id(kResultPrefix + package);
+    SetTitle(name_);
+    SetDetails(base::UTF8ToUTF16(summary));
+    SetAccessibleName(u"Install " + name_ + u", " + base::UTF8ToUTF16(summary));
+    SetCategory(Category::kPlayStore);
+    SetDisplayType(ash::SearchResultDisplayType::kList);
+    SetResultType(ash::AppListSearchResultType::kPlayStoreApp);
+    SetMetricsType(ash::PLAY_STORE_UNINSTALLED_APP);
+    set_relevance(relevance);
+    // A list row with a badge draws the badge where the picture goes, so the
+    // download arrow is only the stand in for an app the catalog has no
+    // picture for.
+    std::string png;
+    if (icon_png.empty() || !base::Base64Decode(icon_png, &png) ||
+        png.size() > 1024 * 1024) {
+      SetIcon(IconInfo(
+          ui::ImageModel::FromVectorIcon(vector_icons::kDownloadIcon,
+                                         ui::kColorIcon, kAppIconDimension),
+          kAppIconDimension));
+    } else {
+      // The picture came from a root service's conversion of the catalog's;
+      // it is decoded out of process all the same.
+      data_decoder::DecodeImageIsolated(
+          base::as_byte_span(png), data_decoder::mojom::ImageCodec::kDefault,
+          /*shrink_to_fit=*/true, data_decoder::kDefaultMaxSizeInBytes,
+          gfx::Size(), base::BindOnce(&AuraDeInstallResult::OnIconDecoded,
+                                      weak_ptr_factory_.GetWeakPtr()));
+    }
+  }
+  AuraDeInstallResult(const AuraDeInstallResult&) = delete;
+  AuraDeInstallResult& operator=(const AuraDeInstallResult&) = delete;
+  ~AuraDeInstallResult() override = default;
+
+  // ChromeSearchResult:
+  void Open(int event_flags) override {
+    AuraDeAppInstaller::Get()->Install(
+        profile_, {package_, name_, desktop_id_, icon_});
+  }
+
+ private:
+  void OnIconDecoded(const SkBitmap& bitmap) {
+    if (bitmap.drawsNothing()) {
+      return;
+    }
+    // The catalog's pictures are 64 pixels for a 32 point icon: their pixels
+    // stay sharp on a high density screen instead of being blown up.
+    icon_ = gfx::ImageSkia::CreateFromBitmap(
+        bitmap, std::max(1.0f, static_cast<float>(bitmap.width()) /
+                                   kAppIconDimension));
+    SetIcon(IconInfo(ui::ImageModel::FromImageSkia(icon_), kAppIconDimension));
+  }
+
+  const raw_ptr<Profile> profile_;
+  const std::string package_;
+  const std::u16string name_;
+  const std::string desktop_id_;
+  gfx::ImageSkia icon_;
+  base::WeakPtrFactory<AuraDeInstallResult> weak_ptr_factory_{this};
+};
+
+}  // namespace
+
+AuraDeInstallProvider::AuraDeInstallProvider(Profile* profile)
+    : SearchProvider(SearchCategory::kPlayStore), profile_(profile) {}
+
+AuraDeInstallProvider::~AuraDeInstallProvider() = default;
+
+void AuraDeInstallProvider::Start(const std::u16string& query,
+                                  OnSearchResultsCallback on_search_done) {
+  on_search_done_ = std::move(on_search_done);
+  ++generation_;
+  query_ = base::UTF16ToUTF8(query);
+  if (query.size() < kMinQueryLength) {
+    debounce_.Stop();
+    return;
+  }
+  debounce_.Start(FROM_HERE, kDebounce,
+                  base::BindOnce(&AuraDeInstallProvider::Search,
+                                 base::Unretained(this)));
+}
+
+void AuraDeInstallProvider::StopQuery() {
+  ++generation_;
+  debounce_.Stop();
+}
+
+ash::AppListSearchResultType AuraDeInstallProvider::ResultType() const {
+  return ash::AppListSearchResultType::kPlayStoreApp;
+}
+
+void AuraDeInstallProvider::Search() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&SearchCatalog, query_),
+      base::BindOnce(&AuraDeInstallProvider::OnSearched,
+                     weak_ptr_factory_.GetWeakPtr(), generation_));
+}
+
+void AuraDeInstallProvider::OnSearched(uint64_t generation,
+                                       std::optional<base::Value> response) {
+  if (generation != generation_ || !response || !on_search_done_) {
+    return;
+  }
+  const base::ListValue* apps =
+      response->GetDict().FindListByDottedPath("data.apps");
+  if (!apps) {
+    return;
+  }
+  Results results;
+  for (const base::Value& entry : *apps) {
+    const base::DictValue* app = entry.GetIfDict();
+    if (!app || app->FindBool("installed").value_or(true)) {
+      continue;
+    }
+    const std::string* package = app->FindString("package");
+    const std::string* name = app->FindString("name");
+    if (!package || !name || package->empty() || name->empty()) {
+      continue;
+    }
+    auto value = [&](const char* key) {
+      const std::string* text = app->FindString(key);
+      return text ? *text : std::string();
+    };
+    // The catalog already ranked them; installed apps outrank them all.
+    const double relevance = 0.5 - 0.05 * results.size();
+    results.push_back(std::make_unique<AuraDeInstallResult>(
+        profile_, *package, *name, value("summary"), value("desktop_id"),
+        value("icon_png"), relevance));
+    if (results.size() >= static_cast<size_t>(kMaxResults)) {
+      break;
+    }
+  }
+  on_search_done_.Run(ResultType(), std::move(results));
+}
+
+}  // namespace app_list
