+
+#ifndef CHROME_BROWSER_ASH_APP_LIST_SEARCH_AURADE_INSTALL_PROVIDER_H_
+#define CHROME_BROWSER_ASH_APP_LIST_SEARCH_AURADE_INSTALL_PROVIDER_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/ash/app_list/search/search_provider.h"
+
+class Profile;
+
+namespace app_list {
+
+// AuraDE compatibility: the launcher finds applications that are not
+// installed yet. A search also asks the host bridge, which reads the
+// distribution's AppStream catalog, and each application it finds and the
+// computer lacks shows under "Apps to install" with its picture and summary.
+// Choosing one installs its package; the administrator password is asked for
+// first, a notification follows the install, and once it is done the app is
+// in the launcher and the notification opens it.
+class AuraDeInstallProvider : public SearchProvider {
+ public:
+  explicit AuraDeInstallProvider(Profile* profile);
+  AuraDeInstallProvider(const AuraDeInstallProvider&) = delete;
+  AuraDeInstallProvider& operator=(const AuraDeInstallProvider&) = delete;
+  ~AuraDeInstallProvider() override;
+
+  // SearchProvider:
+  void Start(const std::u16string& query,
+             OnSearchResultsCallback on_search_done) override;
+  void StopQuery() override;
+  ash::AppListSearchResultType ResultType() const override;
+
+ private:
+  void Search();
+  void OnSearched(uint64_t generation, std::optional<base::Value> response);
+
+  const raw_ptr<Profile> profile_;
+  std::string query_;
+  // Searches answer out of order; only the latest one's results show.
+  uint64_t generation_ = 0;
+  // Typing waits for a pause before the catalog is asked.
+  base::OneShotTimer debounce_;
+  base::WeakPtrFactory<AuraDeInstallProvider> weak_ptr_factory_{this};
+};
+
+}  // namespace app_list
+
+#endif  // CHROME_BROWSER_ASH_APP_LIST_SEARCH_AURADE_INSTALL_PROVIDER_H_
