+constexpr uint32_t kMaxChannels = 64;
+constexpr size_t kMaxRoutes = 256;
+constexpr uint32_t kMaxPodBytes = 16384;
+
+inline uint32_t ParseId(std::string_view text) {
+  if (text.empty()) {
+    return SPA_ID_INVALID;
+  }
+  uint32_t result = SPA_ID_INVALID;
+  const auto parsed =
+      std::from_chars(text.data(), text.data() + text.size(), result);
+  if (parsed.ec != std::errc() || parsed.ptr != text.data() + text.size()) {
+    return SPA_ID_INVALID;
+  }
+  return result;
+}
+
+inline int32_t PercentFromVolume(float volume) {
+  // AuraDE compatibility: wpctl uses the cubic perceived-volume scale. Clamp
+  // before rounding so even a valid amplified route cannot overflow lround.
+  if (!std::isfinite(volume) || volume < 0.0f) {
+    return 0;
+  }
+  return static_cast<int32_t>(
+      std::lround(std::cbrt(std::min(volume, 1.0f)) * 100.0f));
+}
+
+inline float VolumeFromPercent(int32_t percent) {
+  const float value = std::clamp(percent, 0, 100) / 100.0f;
+  return value * value * value;
+}
+
+struct Props {
+  std::optional<bool> muted;
+  std::vector<float> volumes;
+};
+
+inline bool ReadProps(const spa_pod* pod, Props* output) {
+  if (!pod || !spa_pod_is_object(pod) || pod->size > kMaxPodBytes ||
+      SPA_POD_OBJECT_TYPE(pod) != SPA_TYPE_OBJECT_Props) {
+    return false;
+  }
+  Props next;
+  if (const auto* prop = spa_pod_find_prop(pod, nullptr, SPA_PROP_mute)) {
+    bool muted = false;
+    if (spa_pod_get_bool(&prop->value, &muted) < 0) {
+      return false;
+    }
+    next.muted = muted;
+  }
+  if (const auto* prop =
+          spa_pod_find_prop(pod, nullptr, SPA_PROP_channelVolumes)) {
+    if (!spa_pod_is_array(&prop->value) ||
+        prop->value.size < sizeof(spa_pod_array_body) ||
+        SPA_POD_ARRAY_VALUE_TYPE(&prop->value) != SPA_TYPE_Float ||
+        SPA_POD_ARRAY_VALUE_SIZE(&prop->value) != sizeof(float)) {
+      return false;
+    }
+    const uint32_t bytes = prop->value.size - sizeof(spa_pod_array_body);
+    const uint32_t count = bytes / sizeof(float);
+    if (bytes % sizeof(float) != 0 || count == 0 || count > kMaxChannels) {
+      return false;
+    }
+    next.volumes.resize(count);
+    std::memcpy(next.volumes.data(), SPA_POD_ARRAY_VALUES(&prop->value), bytes);
+    for (const float volume : next.volumes) {
+      if (!std::isfinite(volume) || volume < 0.0f) {
+        return false;
+      }
+    }
+  }
+  *output = std::move(next);
+  return true;
+}
+
+inline void MergeProps(const Props& update, Props* target) {
+  // Missing fields are not a request to unmute or reset another controller's
+  // volume. PipeWire is allowed to send a mute-only Props update.
+  if (update.muted.has_value()) {
+    target->muted = update.muted;
+  }
+  if (!update.volumes.empty()) {
+    target->volumes = update.volumes;
+  }
+}
+
+struct Route {
+  int32_t index = -1;
+  int32_t profile_device = -1;
+  uint32_t direction = SPA_ID_INVALID;
+  Props props;
+};
+
+struct Level {
+  int32_t volume = 100;
+  bool muted = false;
+};
+
+inline Level ReadLevel(const Route* route, const Props& node, Level previous) {
+  const auto& props = route ? route->props : node;
+  if (props.muted.has_value()) {
+    previous.muted = *props.muted;
+  }
+  if (!props.volumes.empty()) {
+    previous.volume = PercentFromVolume(props.volumes.front());
+  }
+  return previous;
+}
+
+inline bool ReadRoute(const spa_pod* pod, Route* output) {
+  if (!pod || !spa_pod_is_object(pod) || pod->size > kMaxPodBytes ||
+      SPA_POD_OBJECT_TYPE(pod) != SPA_TYPE_OBJECT_ParamRoute) {
+    return false;
+  }
+  Route next;
+  if (const auto* direction =
+          spa_pod_find_prop(pod, nullptr, SPA_PARAM_ROUTE_direction)) {
+    // An absent direction can match either side. A present value with the
+    // wrong type must not become that wildcard through optional parsing.
+    if (spa_pod_get_id(&direction->value, &next.direction) < 0) {
+      return false;
+    }
+  }
+  const spa_pod* props = nullptr;
+  uint32_t id = SPA_PARAM_Route;
+  if (spa_pod_parse_object(pod, SPA_TYPE_OBJECT_ParamRoute, &id,
+                           SPA_PARAM_ROUTE_index, SPA_POD_Int(&next.index),
+                           SPA_PARAM_ROUTE_device,
+                           SPA_POD_Int(&next.profile_device),
+                           SPA_PARAM_ROUTE_props, SPA_POD_Pod(&props)) < 0 ||
+      next.index < 0 || next.profile_device < 0 ||
+      (next.direction != SPA_ID_INVALID &&
+       next.direction != SPA_DIRECTION_INPUT &&
+       next.direction != SPA_DIRECTION_OUTPUT) ||
+      !ReadProps(props, &next.props) || !next.props.muted.has_value() ||
+      next.props.volumes.empty()) {
+    return false;
+  }
+  *output = std::move(next);
+  return true;
+}
+
+// AuraDE compatibility: Route callbacks are an enumeration, not individual
+// replacement events. Publish at the matching core sync, including an empty
+// result, so a removed headphone route cannot remain the write destination.
+class RouteSnapshot {
+ public:
+  explicit RouteSnapshot(uint32_t global_device = SPA_ID_INVALID)
+      : global_device_(global_device) {}
+
+  void Begin(int sequence) {
+    sequence_ = sequence;
+    pending_.clear();
+    loading_ = true;
+    overflow_ = false;
+  }
+
+  bool Add(int sequence, const spa_pod* pod) {
+    if (!loading_ || sequence != sequence_) {
+      return false;
+    }
+    Route route;
+    if (!ReadRoute(pod, &route)) {
+      return false;
+    }
+    if (pending_.size() >= kMaxRoutes) {
+      overflow_ = true;
+      return false;
+    }
+    pending_.push_back(std::move(route));
+    return true;
+  }
+
+  bool Complete(int sequence) {
+    if (!loading_ || sequence != sequence_) {
+      return false;
+    }
+    current_ = overflow_ ? std::vector<Route>() : std::move(pending_);
+    loading_ = false;
+    return true;
+  }
+
+  void Clear() {
+    pending_.clear();
+    current_.clear();
+    loading_ = false;
+  }
+
+  bool loading() const { return loading_; }
+
+  const Route* Find(uint32_t global_device,
+                    uint32_t profile_device,
+                    uint32_t direction) const {
+    if (global_device == SPA_ID_INVALID || global_device != global_device_ ||
+        profile_device == SPA_ID_INVALID) {
+      return nullptr;
+    }
+    for (const auto& route : current_) {
+      if (static_cast<uint32_t>(route.profile_device) == profile_device &&
+          (route.direction == SPA_ID_INVALID || route.direction == direction)) {
+        return &route;
+      }
+    }
+    return nullptr;
+  }
+
+ private:
+  uint32_t global_device_;
+  int sequence_ = 0;
+  bool loading_ = false;
+  bool overflow_ = false;
+  std::vector<Route> current_;
+  std::vector<Route> pending_;
+};
+
+template <typename RouteWriter, typename NodeWriter>
+bool WriteProps(const Route* route,
+                uint32_t channels,
+                std::optional<int32_t> volume,
+                std::optional<bool> mute,
+                RouteWriter write_route,
+                NodeWriter write_node) {
+  if ((!volume.has_value() && !mute.has_value()) || channels == 0 ||
+      channels > kMaxChannels ||
+      (route && (route->index < 0 || route->profile_device < 0))) {
+    return false;
+  }
+  alignas(8) std::array<uint8_t, 1024> buffer{};
+  spa_pod_builder builder = SPA_POD_BUILDER_INIT(buffer.data(), buffer.size());
+  spa_pod_frame outer;
+  if (route) {
+    spa_pod_builder_push_object(&builder, &outer, SPA_TYPE_OBJECT_ParamRoute,
+                                SPA_PARAM_Route);
+    spa_pod_builder_add(&builder, SPA_PARAM_ROUTE_index,
+                        SPA_POD_Int(route->index), SPA_PARAM_ROUTE_device,
+                        SPA_POD_Int(route->profile_device),
+                        SPA_PARAM_ROUTE_save, SPA_POD_Bool(true), 0);
+    spa_pod_builder_prop(&builder, SPA_PARAM_ROUTE_props, 0);
+  }
+  spa_pod_frame props_frame;
+  spa_pod_builder_push_object(&builder, &props_frame, SPA_TYPE_OBJECT_Props,
+                              SPA_PARAM_Props);
+  if (mute.has_value()) {
+    spa_pod_builder_prop(&builder, SPA_PROP_mute, 0);
+    spa_pod_builder_bool(&builder, *mute);
+  }
+  if (volume.has_value()) {
+    // Match wpctl's scalar setter: set each channel equally. Sending only the
+    // changed fields preserves channel maps, monitor gains and other Props.
+    std::array<float, kMaxChannels> values;
+    values.fill(VolumeFromPercent(*volume));
+    spa_pod_builder_prop(&builder, SPA_PROP_channelVolumes, 0);
+    spa_pod_builder_array(&builder, sizeof(float), SPA_TYPE_Float, channels,
+                          values.data());
+  }
+  const spa_pod* pod =
+      static_cast<const spa_pod*>(spa_pod_builder_pop(&builder, &props_frame));
+  if (route) {
+    pod = static_cast<const spa_pod*>(spa_pod_builder_pop(&builder, &outer));
+  }
+  if (!pod || builder.state.offset > buffer.size()) {
+    return false;
+  }
+  // Acceptance is not confirmation. The caller must wait for a parameter
+  // event before updating the state shown to Ash, even when this returns true.
+  return (route ? write_route(pod) : write_node(pod)) >= 0;
+}
