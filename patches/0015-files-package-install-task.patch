+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/file_manager/virtual_tasks/install_package_virtual_task.h"
+
+#include <string>
+#include <vector>
+
+#include "ash/webui/file_manager/url_constants.h"
+#include "base/process/launch.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/system/sys_info.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/ash/file_manager/file_tasks.h"
+#include "chrome/browser/ash/file_manager/virtual_tasks/id_constants.h"
+#include "chrome/browser/profiles/profile.h"
+#include "storage/browser/file_system/file_system_url.h"
+#include "url/gurl.h"
+
+namespace file_manager::file_tasks {
+
+namespace {
+
+constexpr char kAuraDeSystemHelperPath[] = "/usr/bin/aurade-system-helper";
+
+// Returns the extension string for the given file path, including compound
+// extensions like ".pkg.tar.zst".
+std::string GetPackageExtension(const base::FilePath& path) {
+  const std::string name = path.value();
+  // Check compound Arch extensions first.
+  if (base::EndsWith(name, ".pkg.tar.zst",
+                     base::CompareCase::INSENSITIVE_ASCII)) {
+    return ".pkg.tar.zst";
+  }
+  if (base::EndsWith(name, ".pkg.tar.xz",
+                     base::CompareCase::INSENSITIVE_ASCII)) {
+    return ".pkg.tar.xz";
+  }
+  return "";
+}
+
+bool IsSupportedPackage(const base::FilePath& path) {
+  const std::string extension = GetPackageExtension(path);
+  return extension == ".pkg.tar.zst" || extension == ".pkg.tar.xz";
+}
+
+// Runs the package install helper on the thread pool (fire-and-forget).
+void RunPackageInstall(const base::FilePath& path) {
+  base::LaunchOptions options;
+  base::LaunchProcess(
+      {"pkexec", kAuraDeSystemHelperPath, "install-package", path.value()},
+      options);
+}
+
+}  // namespace
+
+InstallPackageVirtualTask::InstallPackageVirtualTask() {
+  // No extensions registered via matcher_file_extensions_; Matches() is
+  // overridden to handle compound extensions like .pkg.tar.zst.
+}
+
+bool InstallPackageVirtualTask::IsEnabled(Profile* profile) const {
+  return !base::SysInfo::IsRunningOnChromeOS();
+}
+
+std::string InstallPackageVirtualTask::id() const {
+  return base::StrCat({ash::file_manager::kChromeUIFileManagerURL, "?",
+                       kActionIdInstallPackage});
+}
+
+std::string InstallPackageVirtualTask::title() const {
+  return "Install Arch package";
+}
+
+GURL InstallPackageVirtualTask::icon_url() const {
+  return GURL();
+}
+
+bool InstallPackageVirtualTask::IsDlpBlocked(
+    const std::vector<std::string>& dlp_source_urls) const {
+  return false;
+}
+
+bool InstallPackageVirtualTask::Matches(
+    const std::vector<extensions::EntryInfo>& entries,
+    const std::vector<GURL>& file_urls) const {
+  if (entries.empty()) {
+    return false;
+  }
+  for (const auto& entry : entries) {
+    if (!IsSupportedPackage(entry.path)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool InstallPackageVirtualTask::Execute(
+    Profile* profile,
+    const TaskDescriptor& task,
+    const std::vector<storage::FileSystemURL>& file_urls) const {
+  if (file_urls.empty()) {
+    return false;
+  }
+  for (const auto& file_url : file_urls) {
+    const base::FilePath path = file_url.path();
+    if (!IsSupportedPackage(path)) {
+      continue;
+    }
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&RunPackageInstall, path));
+  }
+  return true;
+}
+
+}  // namespace file_manager::file_tasks
