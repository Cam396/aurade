+// found in the LICENSE file.
+
+import {isNativeEntry, unwrapEntry} from '../../common/js/entry_utils.js';
+import type {FilesAppEntry} from '../../common/js/files_app_entry_types.js';
+
+/**
+ * AuraDE: how big is that folder, actually.
+ *
+ * Every file manager on a desktop can answer this and Files cannot. The Size
+ * column shows a dash for every directory, because a directory has no size of
+ * its own and finding out means walking the whole tree underneath it. Files
+ * already owns that walk: `chrome.fileManagerPrivate.getDirectorySize` runs it
+ * in the browser process, and the details panel calls it whenever a folder is
+ * selected. Nothing surfaces it in the list, which is where somebody clearing
+ * a disk is actually looking.
+ *
+ * So this is on demand and never automatic. Measuring is expensive in a way
+ * that is invisible until the tree is large, and a list that silently measured
+ * every folder it drew would spend a spinning disk on numbers nobody asked
+ * for. The answer arrives because somebody asked for it, and is remembered
+ * afterwards so asking twice is free.
+ */
+
+/**
+ * Remembered measurements, keyed by entry URL.
+ *
+ * Capped, because this is never cleared while the window lives and a long
+ * session that walks a large tree would otherwise hold a number for every
+ * folder it ever visited. Sixty four folders is far more than anybody measures
+ * by hand in one sitting.
+ */
+const AURADE_FOLDER_SIZE_LIMIT = 64;
+
+const folderSizes = new Map<string, number>();
+
+/**
+ * URLs currently being measured, so a second invocation on the same folder
+ * joins the first walk instead of starting another one. Without this, holding
+ * the menu item down would queue a walk per keypress and each one would read
+ * the whole tree again.
+ */
+const inFlight = new Map<string, Promise<number|undefined>>();
+
+/**
+ * Whether Files can measure this entry at all.
+ *
+ * A directory is not enough. `getDirectorySize` takes a real filesystem
+ * directory, so the fake roots that Files synthesises, and any entry belonging
+ * to a provider rather than to a disk, have to be turned away here rather than
+ * fail in the callback where there is nothing useful to say about them.
+ */
+export function auraDeCanMeasureSize(entry: Entry|FilesAppEntry): boolean {
+  if (!entry || !entry.isDirectory) {
+    return false;
+  }
+  return isNativeEntry(unwrapEntry(entry) as Entry | FilesAppEntry);
+}
+
+/**
+ * The measurement for this folder if one has been taken, otherwise undefined.
+ *
+ * Undefined and not -1: -1 is what the metadata carries for a directory that
+ * has no size, and the two mean different things. Undefined here means nobody
+ * has asked yet.
+ */
+export function auraDeMeasuredFolderSize(entry: Entry|FilesAppEntry): number
+    |undefined {
+  if (!entry || !entry.isDirectory) {
+    return undefined;
+  }
+  return folderSizes.get(entry.toURL());
+}
+
+/**
+ * Records a measurement, evicting the least recently recorded one when full.
+ *
+ * The delete before the set is what makes the eviction a real LRU. A Map keeps
+ * insertion order, so setting a key that is already present leaves it where it
+ * first went in; deleting first moves it to the end, and the oldest key is
+ * then genuinely the one at the front.
+ */
+function remember(url: string, size: number) {
+  folderSizes.delete(url);
+  folderSizes.set(url, size);
+  while (folderSizes.size > AURADE_FOLDER_SIZE_LIMIT) {
+    const oldest = folderSizes.keys().next();
+    if (oldest.done) {
+      break;
+    }
+    folderSizes.delete(oldest.value);
+  }
+}
+
+/**
+ * Walks the folder and returns its total size in bytes, or undefined if the
+ * walk could not be done.
+ *
+ * `chrome.runtime.lastError` has to be read inside the callback. The extension
+ * bindings clear it as soon as the callback returns, and a failed call still
+ * invokes the callback, with a size that is undefined or stale rather than
+ * with an exception. Checking it is the only way to tell a folder of zero
+ * bytes from a folder that could not be read.
+ */
+export function auraDeMeasureFolderSize(entry: Entry|FilesAppEntry):
+    Promise<number|undefined> {
+  if (!auraDeCanMeasureSize(entry)) {
+    return Promise.resolve(undefined);
+  }
+  const url = entry.toURL();
+  const existing = inFlight.get(url);
+  if (existing) {
+    return existing;
+  }
+  const directoryEntry = unwrapEntry(entry) as DirectoryEntry;
+  const walk = new Promise<number|undefined>(resolve => {
+    chrome.fileManagerPrivate.getDirectorySize(directoryEntry, size => {
+      if (chrome.runtime.lastError || typeof size !== 'number' ||
+          !isFinite(size) || size < 0) {
+        resolve(undefined);
+        return;
+      }
+      remember(url, size);
+      resolve(size);
+    });
+  }).finally(() => {
+    inFlight.delete(url);
+  });
+  inFlight.set(url, walk);
+  return walk;
+}
+
+/**
+ * Forgets every measurement. Exists for tests, which would otherwise carry one
+ * case's numbers into the next.
+ */
+export function auraDeForgetFolderSizes() {
+  folderSizes.clear();
+  inFlight.clear();
+}
