+/**
+ * AuraDE: measures the selected folders and shows how much they hold.
+ *
+ * Files answers "how much room is left" in the status bar and never answers
+ * "what is using it", which is the question somebody clearing a disk actually
+ * has. The walk is the one the details panel already runs; what is new is
+ * asking for it deliberately, on the folders picked out, and putting the
+ * answer in the Size column where a size belongs.
+ *
+ * Deliberately on demand and deliberately not on a keyboard shortcut. Every
+ * free chord in this window is read by ash first, and taking one somebody
+ * already uses is a worse trade than a trip to the context menu; the same
+ * reasoning that kept Copy name and Copy path off the keyboard.
+ */
+export class CalculateSizeCommand extends FilesCommand {
+  execute(_event: CommandEvent, fileManager: CommandHandlerDeps) {
+    const entries =
+        fileManager.getSelection().entries.filter(auraDeCanMeasureSize);
+    if (entries.length === 0) {
+      return;
+    }
+    const label = entries.length === 1 ? entries[0]!.name :
+                                         `${entries.length} folders`;
+    // Announced rather than shown, because a walk that finishes instantly
+    // would make a toast flash and vanish, which reads as a glitch.
+    fileManager.ui.speakA11yMessage(`Measuring ${label}`);
+    Promise.all(entries.map(entry => auraDeMeasureFolderSize(entry)))
+        .then(sizes => {
+          const measured = sizes.filter(size => size !== undefined);
+          // Redraw whatever landed, even on a partial failure, so a folder
+          // that did answer shows its number.
+          if (measured.length > 0) {
+            fileManager.ui.listContainer.currentList.redraw();
+          }
+          let message: string;
+          if (measured.length === 0) {
+            message = `Could not measure ${label}`;
+          } else {
+            const total = measured.reduce((sum, size) => sum + size!, 0);
+            message = entries.length === 1 ?
+                `${entries[0]!.name} holds ${bytesToString(total)}` :
+                `${measured.length} folders hold ${bytesToString(total)}`;
+          }
+          fileManager.ui.toast.show(message);
+          fileManager.ui.speakA11yMessage(message);
+        });
+  }
+
+  override canExecute(event: CanExecuteEvent, fileManager: CommandHandlerDeps) {
+    const entries = fileManager.getSelection().entries;
+    // Every selected entry has to be measurable, not merely one of them. A
+    // mixed selection of files and folders offering "Calculate size" would
+    // quietly measure the folders and ignore the files, and the total would be
+    // wrong in a way nothing on screen explains.
+    const canMeasure =
+        entries.length > 0 && entries.every(auraDeCanMeasureSize);
+    event.canExecute = canMeasure;
+    event.command.setHidden(!canMeasure);
+    event.command.label = entries.length > 1 ?
+        `Calculate ${entries.length} folder sizes` :
+        'Calculate size';
+  }
+}
