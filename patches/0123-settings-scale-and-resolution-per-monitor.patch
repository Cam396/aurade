+
+// Adds what Ash knows of a monitor to the display state read from the
+// system: its scale, the scale it is recommended, and its current mode.
+void AddAuraMonitorState(int64_t display_id, base::DictValue& value) {
+  AuraDisplaySource* source = AuraDisplaySource::Get();
+  const AuraDisplaySource::Monitor* monitor =
+      source ? source->GetMonitor(display_id) : nullptr;
+  if (!monitor) {
+    return;
+  }
+  base::ListValue scale_options;
+  for (float scale : AuraDisplaySource::GetScaleOptions()) {
+    scale_options.Append(scale);
+  }
+  value.Set("perDisplay", true);
+  value.Set("displayId", base::NumberToString(display_id));
+  value.Set("connector", monitor->connector);
+  value.Set("configuredScale", monitor->scale);
+  value.Set("currentScale", monitor->scale);
+  value.Set("recommendedScale", monitor->recommended_scale);
+  value.Set("scaleOptions", std::move(scale_options));
+  value.Set("scaleAvailable", true);
+  value.Set("currentMode",
+            base::StringPrintf("%dx%d", monitor->bounds_in_pixels.width(),
+                               monitor->bounds_in_pixels.height()));
+}
