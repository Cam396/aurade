   return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
 }
 
+// HACK(AuraDE): Creates a vertical gradient wallpaper as fallback for
+// standalone Ash mode where no ChromeOS wallpaper assets are available.
+// TODO: Replace with proper wallpaper asset loading or user-configurable
+// background once local account support is implemented.
+// FIXME: This should be configurable via right-click context menu.
+gfx::ImageSkia CreateAuraDeGradientWallpaper() {
+  constexpr int kWidth = 1920;
+  constexpr int kHeight = 1080;
+  // Dark teal -> deep navy gradient (similar to ChromeOS default style).
+  constexpr SkColor kTopColor = SkColorSetRGB(0x1a, 0x2a, 0x3a);
+  constexpr SkColor kBottomColor = SkColorSetRGB(0x0d, 0x12, 0x1e);
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(kWidth, kHeight);
+  for (int y = 0; y < kHeight; ++y) {
+    float t = static_cast<float>(y) / kHeight;
+    SkColor color = SkColorSetARGB(
+        255,
+        static_cast<uint8_t>(SkColorGetR(kTopColor) * (1.0f - t) +
+                              SkColorGetR(kBottomColor) * t),
+        static_cast<uint8_t>(SkColorGetG(kTopColor) * (1.0f - t) +
+                              SkColorGetG(kBottomColor) * t),
+        static_cast<uint8_t>(SkColorGetB(kTopColor) * (1.0f - t) +
+                              SkColorGetB(kBottomColor) * t));
+    for (int x = 0; x < kWidth; ++x) {
+      *bitmap.getAddr32(x, y) = color;
+    }
+  }
+  return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+}
