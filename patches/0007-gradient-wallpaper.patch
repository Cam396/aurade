+void WallpaperWidgetController::UpdateWallpaperBounds() {
+  if (!widget_ || !widget_->GetNativeWindow()) {
+    return;
+  }
+
+  const gfx::Rect bounds(root_window_->bounds().size());
+  widget_->SetBounds(bounds);
+  if (wallpaper_underlay_layer_) {
+    wallpaper_underlay_layer_->SetBounds(bounds);
+  }
+  if (wallpaper_view_) {
+    wallpaper_view_->ClearCachedImage();
+    wallpaper_view_->SchedulePaint();
+  }
