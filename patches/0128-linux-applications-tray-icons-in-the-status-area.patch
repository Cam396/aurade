+// One StatusNotifierItem, shown as an icon on every monitor's shelf.
+class StatusNotifierHost::Item {
+ public:
+  Item(StatusNotifierHost* host,
+       std::string key,
+       std::string bus_name,
+       std::string owner,
+       std::string path,
+       int64_t icon_id);
+  Item(const Item&) = delete;
+  Item& operator=(const Item&) = delete;
+  ~Item();
+
+  const std::string& bus_name() const { return bus_name_; }
+  const std::string& owner() const { return owner_; }
+  const std::string& path() const { return path_; }
+
+  // Draws the icon again for the monitors and color mode there are now, and
+  // shows it on each monitor.
+  void Reload();
+
+ private:
+  void UpdateIcons();
+  void OnChanged(dbus::Signal* signal);
+  void Refresh();
+  void OnRefreshed(dbus::Response* response);
+  void ReadProperty(const std::string& property, dbus::MessageReader* value);
+  void SetMenuPath(const std::string& menu_path);
+
+  void LoadIcon();
+  void OnIconFile(uint64_t generation, std::optional<IconFile> file);
+  void RenderSvg(uint64_t generation,
+                 std::string svg,
+                 bool symbolic,
+                 int attempt);
+  void OnSvgRendered(uint64_t generation,
+                     std::string svg,
+                     bool symbolic,
+                     int attempt,
+                     std::string png);
+  void OnIconDecoded(uint64_t generation,
+                     bool symbolic,
+                     const SkBitmap& bitmap);
+  void SetImage(gfx::ImageSkia image);
+
+  std::u16string Tooltip() const;
+  bool IsShown() const;
+  TrayIconHandlers MakeHandlers();
+
+  void Activate(const gfx::Point& point);
+  void OnActivated(const gfx::Point& point,
+                   dbus::Response* response,
+                   dbus::ErrorResponse* error);
+  void SecondaryActivate(const gfx::Point& point);
+  void Scroll(int delta, bool horizontal);
+  std::unique_ptr<ui::SimpleMenuModel> CreateMenu(const gfx::Point& point);
+  void ShowMenu(const gfx::Point& point);
+  void CallItem(const char* method, const gfx::Point& point);
+
+  bool HasMenu() const;
+  void OnMenuChanged(dbus::Signal* signal);
+  void FetchMenu();
+  void OnMenu(dbus::Response* response);
+  void OnAboutToShow(dbus::Response* response);
+  void SendMenuEvent(int32_t id, const std::string& event_id);
+
+  const raw_ptr<StatusNotifierHost> host_;
+  const std::string key_;
+  const std::string bus_name_;
+  const std::string owner_;
+  const std::string path_;
+  const int64_t icon_id_;
+  const raw_ptr<dbus::ObjectProxy> proxy_;
+  raw_ptr<dbus::ObjectProxy> menu_proxy_ = nullptr;
+  std::string menu_path_;
+
+  // org.kde.StatusNotifierItem
+  std::string id_;
+  std::string title_;
+  std::string status_ = "Active";
+  std::string icon_name_;
+  std::string attention_icon_name_;
+  std::string theme_path_;
+  std::vector<Pixmap> icon_pixmaps_;
+  std::vector<Pixmap> attention_pixmaps_;
+  std::string tooltip_title_;
+  std::string tooltip_text_;
+  bool item_is_menu_ = false;
+  // Set when the item answers Activate with an error: its menu is all it
+  // has, as with libappindicator.
+  bool activate_unsupported_ = false;
+  bool refreshed_ = false;
+
+  // What the icon was last made from, so a refresh that changed nothing
+  // about it does not make it again.
+  std::string icon_source_;
+  uint64_t icon_generation_ = 0;
+  // The pixels across the icon being made needs, for the densest monitor.
+  int icon_target_px_ = kIconSizeDip;
+  gfx::ImageSkia image_;
+  // Where each named icon was found, by what it was made from.
+  std::map<std::string, base::FilePath> icon_paths_;
+
+  std::optional<MenuNode> menu_;
+
+  base::OneShotTimer refresh_timer_;
+  base::OneShotTimer menu_timer_;
+  base::WeakPtrFactory<Item> weak_ptr_factory_{this};
+};
+
+StatusNotifierHost::Item::Item(StatusNotifierHost* host,
+                               std::string key,
+                               std::string bus_name,
+                               std::string owner,
+                               std::string path,
+                               int64_t icon_id)
+    : host_(host),
+      key_(std::move(key)),
+      bus_name_(std::move(bus_name)),
+      owner_(std::move(owner)),
+      path_(std::move(path)),
+      icon_id_(icon_id),
+      proxy_(host->bus_->GetObjectProxyWithOptions(
+          owner_,
+          dbus::ObjectPath(path_),
+          dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS)) {
+  for (const char* signal :
+       {"NewTitle", "NewIcon", "NewAttentionIcon", "NewOverlayIcon",
+        "NewToolTip", "NewStatus", "NewIconThemePath", "NewMenu"}) {
+    proxy_->ConnectToSignal(kItemInterface, signal,
+                            base::BindRepeating(&Item::OnChanged,
+                                                weak_ptr_factory_.GetWeakPtr()),
+                            base::DoNothing());
+  }
+  Refresh();
+}
+
+StatusNotifierHost::Item::~Item() {
+  if (Shell::HasInstance()) {
+    TrayIconConfiguration configuration;
+    configuration.id = icon_id_;
+    for (aura::Window* root_window : Shell::GetAllRootWindows()) {
+      Shell::Get()->RemoveStatusTrayIcon(
+          configuration,
+          display::Screen::Get()->GetDisplayNearestWindow(root_window).id());
+    }
+  }
+  SetMenuPath(std::string());
+  host_->bus_->RemoveObjectProxyWithOptions(
+      owner_, dbus::ObjectPath(path_),
+      dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS, base::DoNothing());
+}
+
+void StatusNotifierHost::Item::Reload() {
+  if (!refreshed_) {
+    return;
+  }
+  LoadIcon();
+  UpdateIcons();
+}
+
+void StatusNotifierHost::Item::UpdateIcons() {
+  if (!Shell::HasInstance()) {
+    return;
+  }
+  TrayIconConfiguration configuration;
+  configuration.id = icon_id_;
+  const bool shown = IsShown();
+  if (shown) {
+    configuration.image = image_;
+    configuration.tool_tip = Tooltip();
+  }
+  // Each monitor's status area is asked rather than remembered: a monitor
+  // plugged in again comes back with the same display ID and an empty one.
+  for (aura::Window* root_window : Shell::GetAllRootWindows()) {
+    const int64_t display_id =
+        display::Screen::Get()->GetDisplayNearestWindow(root_window).id();
+    if (!shown) {
+      Shell::Get()->RemoveStatusTrayIcon(configuration, display_id);
+    } else if (!Shell::Get()->UpdateStatusTrayIcon(configuration,
+                                                   display_id)) {
+      Shell::Get()->AddStatusTrayIcon(configuration, display_id,
+                                      MakeHandlers());
+    }
+  }
+}
+
+void StatusNotifierHost::Item::OnChanged(dbus::Signal* signal) {
+  refresh_timer_.Start(FROM_HERE, kRefreshDelay,
+                       base::BindOnce(&Item::Refresh, base::Unretained(this)));
+}
+
+void StatusNotifierHost::Item::Refresh() {
+  dbus::MethodCall method_call(kPropertiesInterface, "GetAll");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(kItemInterface);
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::BindOnce(&Item::OnRefreshed,
+                                    weak_ptr_factory_.GetWeakPtr()));
+}
+
+void StatusNotifierHost::Item::OnRefreshed(dbus::Response* response) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  dbus::MessageReader properties(nullptr);
+  if (!reader.PopArray(&properties)) {
+    return;
+  }
+  std::string menu_path;
+  // Properties an item leaves out are as if empty.
+  icon_pixmaps_.clear();
+  attention_pixmaps_.clear();
+  while (properties.HasMoreData()) {
+    dbus::MessageReader entry(nullptr);
+    std::string property;
+    dbus::MessageReader value(nullptr);
+    if (!properties.PopDictEntry(&entry) || !entry.PopString(&property) ||
+        !entry.PopVariant(&value)) {
+      return;
+    }
+    if (property == "Menu") {
+      PopText(&value, &menu_path);
+    } else {
+      ReadProperty(property, &value);
+    }
+  }
+  refreshed_ = true;
+  SetMenuPath(menu_path);
+  LoadIcon();
+  UpdateIcons();
+}
+
+void StatusNotifierHost::Item::ReadProperty(const std::string& property,
+                                            dbus::MessageReader* value) {
+  if (property == "Id") {
+    PopText(value, &id_);
+  } else if (property == "Title") {
+    PopText(value, &title_);
+  } else if (property == "Status") {
+    PopText(value, &status_);
+  } else if (property == "IconName") {
+    PopText(value, &icon_name_);
+  } else if (property == "AttentionIconName") {
+    PopText(value, &attention_icon_name_);
+  } else if (property == "IconThemePath") {
+    PopText(value, &theme_path_);
+  } else if (property == "IconPixmap") {
+    PopPixmaps(value, &icon_pixmaps_);
+  } else if (property == "AttentionIconPixmap") {
+    PopPixmaps(value, &attention_pixmaps_);
+  } else if (property == "ItemIsMenu") {
+    value->PopBool(&item_is_menu_);
+  } else if (property == "ToolTip") {
+    dbus::MessageReader tooltip(nullptr);
+    std::string icon;
+    std::vector<Pixmap> pixmaps;
+    std::string title;
+    std::string text;
+    if (value->PopStruct(&tooltip) && PopText(&tooltip, &icon) &&
+        PopPixmaps(&tooltip, &pixmaps) && PopText(&tooltip, &title) &&
+        PopText(&tooltip, &text)) {
+      tooltip_title_ = StripMarkup(title);
+      tooltip_text_ = StripMarkup(text);
+    }
+  }
+}
+
+void StatusNotifierHost::Item::SetMenuPath(const std::string& menu_path) {
+  // Qt names this path when an item has no menu.
+  const bool valid = dbus::ObjectPath(menu_path).IsValid() &&
+                     menu_path != "/" && menu_path != "/NO_DBUSMENU";
+  const std::string new_path = valid ? menu_path : std::string();
+  if (new_path == menu_path_) {
+    return;
+  }
+  if (menu_proxy_) {
+    // The item and its menu can be one object; that proxy is the item's.
+    if (menu_path_ != path_) {
+      host_->bus_->RemoveObjectProxyWithOptions(
+          owner_, dbus::ObjectPath(menu_path_),
+          dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS, base::DoNothing());
+    }
+    menu_proxy_ = nullptr;
+  }
+  menu_path_ = new_path;
+  menu_.reset();
+  if (menu_path_.empty()) {
+    return;
+  }
+  menu_proxy_ = host_->bus_->GetObjectProxyWithOptions(
+      owner_, dbus::ObjectPath(menu_path_),
+      dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS);
+  for (const char* signal : {"LayoutUpdated", "ItemsPropertiesUpdated"}) {
+    menu_proxy_->ConnectToSignal(
+        kMenuInterface, signal,
+        base::BindRepeating(&Item::OnMenuChanged,
+                            weak_ptr_factory_.GetWeakPtr()),
+        base::DoNothing());
+  }
+  FetchMenu();
+}
+
+void StatusNotifierHost::Item::LoadIcon() {
+  const bool attention = status_ == "NeedsAttention";
+  const std::vector<Pixmap>& pixmaps =
+      attention && !attention_pixmaps_.empty() ? attention_pixmaps_
+                                               : icon_pixmaps_;
+  const std::string& name = attention && !attention_icon_name_.empty()
+                                ? attention_icon_name_
+                                : icon_name_;
+  const bool dark = IsDarkMode();
+  const int target_px = IconTargetPixels();
+
+  // A name is what the application chose to be seen by; its pixmaps are for
+  // trays that cannot look the name up.
+  if (!name.empty()) {
+    const std::string source = "name:" + name + "\n" + theme_path_ + "\n" +
+                               (dark ? "dark" : "light") + "\n" +
+                               base::NumberToString(target_px);
+    if (source == icon_source_ && !image_.isNull()) {
+      return;
+    }
+    icon_source_ = source;
+    icon_target_px_ = target_px;
+    const uint64_t generation = ++icon_generation_;
+    IconQuery query;
+    query.name = name;
+    query.theme_path = theme_path_;
+    query.dark = dark;
+    query.target_px = target_px;
+    if (auto it = icon_paths_.find(icon_source_); it != icon_paths_.end()) {
+      query.known_path = it->second;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&FindIconFile, std::move(query)),
+        base::BindOnce(&Item::OnIconFile, weak_ptr_factory_.GetWeakPtr(),
+                       generation));
+    return;
+  }
+
+  if (const Pixmap* pixmap = PickPixmap(pixmaps, target_px)) {
+    std::string source = "pixmap:" + base::NumberToString(pixmap->width) +
+                         "x" + base::NumberToString(pixmap->height) + ":";
+    source.append(pixmap->argb.begin(), pixmap->argb.end());
+    if (source == icon_source_ && !image_.isNull()) {
+      return;
+    }
+    icon_source_ = std::move(source);
+    ++icon_generation_;
+    SetImage(ToTrayImage(PixmapToBitmap(*pixmap)));
+    return;
+  }
+
+  icon_source_.clear();
+  ++icon_generation_;
+  SetImage(gfx::ImageSkia());
+}
+
+void StatusNotifierHost::Item::OnIconFile(uint64_t generation,
+                                          std::optional<IconFile> file) {
+  if (generation != icon_generation_) {
+    return;
+  }
+  if (!file) {
+    // The name leads nowhere; pixmaps, when the item sends them too, are
+    // better than a letter.
+    const std::vector<Pixmap>& pixmaps =
+        status_ == "NeedsAttention" && !attention_pixmaps_.empty()
+            ? attention_pixmaps_
+            : icon_pixmaps_;
+    if (const Pixmap* pixmap = PickPixmap(pixmaps, icon_target_px_)) {
+      SetImage(ToTrayImage(PixmapToBitmap(*pixmap)));
+    } else {
+      SetImage(gfx::ImageSkia());
+    }
+    return;
+  }
+  // Indicators that cycle through many names keep a few of them.
+  if (icon_paths_.size() >= kMaxKnownIconPaths) {
+    icon_paths_.clear();
+  }
+  icon_paths_[icon_source_] = file->path;
+  const bool symbolic = IsSymbolicIcon(file->path);
+  if (IsSvg(file->path)) {
+    RenderSvg(generation, std::move(file->bytes), symbolic, /*attempt=*/1);
+    return;
+  }
+  // Pictures from applications are decoded out of process.
+  data_decoder::DecodeImageIsolated(
+      base::as_byte_span(file->bytes),
+      data_decoder::mojom::ImageCodec::kDefault,
+      /*shrink_to_fit=*/true, data_decoder::kDefaultMaxSizeInBytes,
+      gfx::Size(icon_target_px_, icon_target_px_),
+      base::BindOnce(&Item::OnIconDecoded, weak_ptr_factory_.GetWeakPtr(),
+                     generation, symbolic));
+}
+
+void StatusNotifierHost::Item::RenderSvg(uint64_t generation,
+                                         std::string svg,
+                                         bool symbolic,
+                                         int attempt) {
+  if (generation != icon_generation_) {
+    return;
+  }
+  apps::SvgIconTranscoder* transcoder = host_->GetSvgTranscoder();
+  if (!transcoder) {
+    SetImage(gfx::ImageSkia());
+    return;
+  }
+  // A renderer draws the SVG, so it is never parsed here.
+  const std::string data = svg;
+  const int size = std::max(kSvgRenderSizePx, icon_target_px_);
+  transcoder->Transcode(
+      data, base::FilePath(), gfx::Size(size, size),
+      base::BindOnce(&Item::OnSvgRendered, weak_ptr_factory_.GetWeakPtr(),
+                     generation, std::move(svg), symbolic, attempt));
+}
+
+void StatusNotifierHost::Item::OnSvgRendered(uint64_t generation,
+                                             std::string svg,
+                                             bool symbolic,
+                                             int attempt,
+                                             std::string png) {
+  if (generation != icon_generation_) {
+    return;
+  }
+  if (png.empty()) {
+    if (attempt < kMaxSvgAttempts) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&Item::RenderSvg, weak_ptr_factory_.GetWeakPtr(),
+                         generation, std::move(svg), symbolic, attempt + 1),
+          kSvgRetryDelay);
+    } else {
+      SetImage(gfx::ImageSkia());
+    }
+    return;
+  }
+  // Encoded in this process from the bitmap the renderer drew, so decoding
+  // it here is safe.
+  OnIconDecoded(generation, symbolic,
+                gfx::PNGCodec::Decode(base::as_byte_span(png)));
+}
+
+void StatusNotifierHost::Item::OnIconDecoded(uint64_t generation,
+                                             bool symbolic,
+                                             const SkBitmap& bitmap) {
+  if (generation != icon_generation_) {
+    return;
+  }
+  if (bitmap.drawsNothing()) {
+    SetImage(gfx::ImageSkia());
+    return;
+  }
+  SkBitmap copy;
+  if (symbolic && copy.tryAllocN32Pixels(bitmap.width(), bitmap.height()) &&
+      bitmap.readPixels(copy.info(), copy.getPixels(), copy.rowBytes(), 0,
+                        0)) {
+    TintBitmap(&copy, SymbolicColor());
+    SetImage(ToTrayImage(copy));
+    return;
+  }
+  SetImage(ToTrayImage(bitmap));
+}
+
+void StatusNotifierHost::Item::SetImage(gfx::ImageSkia image) {
+  image_ = image.isNull()
+               ? LetterIcon(!title_.empty() ? title_
+                            : !tooltip_title_.empty() ? tooltip_title_
+                                                      : id_)
+               : std::move(image);
+  UpdateIcons();
+}
+
+std::u16string StatusNotifierHost::Item::Tooltip() const {
+  std::string tooltip = !tooltip_title_.empty() ? tooltip_title_
+                        : !title_.empty()       ? title_
+                                                : id_;
+  if (!tooltip_text_.empty() && tooltip_text_ != tooltip) {
+    tooltip += "\n" + tooltip_text_;
+  }
+  return base::UTF8ToUTF16(tooltip);
+}
+
+bool StatusNotifierHost::Item::IsShown() const {
+  // Passive items are idle; trays on other desktops hide them too.
+  return refreshed_ && status_ != "Passive" && !image_.isNull();
+}
+
+TrayIconHandlers StatusNotifierHost::Item::MakeHandlers() {
+  TrayIconHandlers handlers;
+  handlers.activate =
+      base::BindRepeating(&Item::Activate, weak_ptr_factory_.GetWeakPtr());
+  handlers.secondary_activate = base::BindRepeating(
+      &Item::SecondaryActivate, weak_ptr_factory_.GetWeakPtr());
+  handlers.scroll =
+      base::BindRepeating(&Item::Scroll, weak_ptr_factory_.GetWeakPtr());
+  handlers.menu = base::BindRepeating(
+      [](base::WeakPtr<Item> item, const gfx::Point& point)
+          -> std::unique_ptr<ui::SimpleMenuModel> {
+        return item ? item->CreateMenu(point) : nullptr;
+      },
+      weak_ptr_factory_.GetWeakPtr());
+  return handlers;
+}
+
+void StatusNotifierHost::Item::Activate(const gfx::Point& point) {
+  if (HasMenu() && (item_is_menu_ || activate_unsupported_)) {
+    ShowMenu(point);
+    return;
+  }
+  dbus::MethodCall method_call(kItemInterface, "Activate");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt32(point.x());
+  writer.AppendInt32(point.y());
+  proxy_->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&Item::OnActivated, weak_ptr_factory_.GetWeakPtr(),
+                     point));
+}
+
+void StatusNotifierHost::Item::OnActivated(const gfx::Point& point,
+                                           dbus::Response* response,
+                                           dbus::ErrorResponse* error) {
+  if (response || !error || !HasMenu()) {
+    return;
+  }
+  // libappindicator's items have no Activate; their menu is the click.
+  activate_unsupported_ = true;
+  ShowMenu(point);
+}
+
+void StatusNotifierHost::Item::SecondaryActivate(const gfx::Point& point) {
+  CallItem("SecondaryActivate", point);
+}
+
+void StatusNotifierHost::Item::Scroll(int delta, bool horizontal) {
+  dbus::MethodCall method_call(kItemInterface, "Scroll");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt32(delta);
+  writer.AppendString(horizontal ? "horizontal" : "vertical");
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+}
+
+std::unique_ptr<ui::SimpleMenuModel> StatusNotifierHost::Item::CreateMenu(
+    const gfx::Point& point) {
+  if (!HasMenu()) {
+    // Without dbusmenu, an application shows its own menu.
+    CallItem("ContextMenu", point);
+    return nullptr;
+  }
+  // Applications that fill their menu as it opens get the chance to.
+  dbus::MethodCall method_call(kMenuInterface, "AboutToShow");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt32(menu_->id);
+  menu_proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                          base::BindOnce(&Item::OnAboutToShow,
+                                         weak_ptr_factory_.GetWeakPtr()));
+  return std::make_unique<DbusMenuModel>(
+      *menu_, base::BindRepeating(&Item::SendMenuEvent,
+                                  weak_ptr_factory_.GetWeakPtr()));
+}
+
+void StatusNotifierHost::Item::ShowMenu(const gfx::Point& point) {
+  if (!Shell::HasInstance()) {
+    return;
+  }
+  TrayIconConfiguration configuration;
+  configuration.id = icon_id_;
+  Shell::Get()->ShowStatusTrayIconMenu(configuration, DisplayIdAt(point));
+}
+
+void StatusNotifierHost::Item::CallItem(const char* method,
+                                        const gfx::Point& point) {
+  dbus::MethodCall method_call(kItemInterface, method);
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt32(point.x());
+  writer.AppendInt32(point.y());
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+}
+
+bool StatusNotifierHost::Item::HasMenu() const {
+  return menu_proxy_ && menu_ && !menu_->children.empty();
+}
+
+void StatusNotifierHost::Item::OnMenuChanged(dbus::Signal* signal) {
+  menu_timer_.Start(FROM_HERE, kMenuFetchDelay,
+                    base::BindOnce(&Item::FetchMenu, base::Unretained(this)));
+}
+
+void StatusNotifierHost::Item::FetchMenu() {
+  if (!menu_proxy_) {
+    return;
+  }
+  dbus::MethodCall method_call(kMenuInterface, "GetLayout");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt32(0);
+  writer.AppendInt32(-1);
+  writer.AppendArrayOfStrings({});
+  menu_proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                          base::BindOnce(&Item::OnMenu,
+                                         weak_ptr_factory_.GetWeakPtr()));
+}
+
+void StatusNotifierHost::Item::OnMenu(dbus::Response* response) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  uint32_t revision = 0;
+  MenuNode root;
+  size_t count = 0;
+  if (!reader.PopUint32(&revision) ||
+      !PopMenuNode(&reader, /*depth=*/0, &count, &root)) {
+    LOG(WARNING) << "AuraDE tray could not read the menu of " << key_;
+    return;
+  }
+  menu_ = std::move(root);
+}
+
+void StatusNotifierHost::Item::OnAboutToShow(dbus::Response* response) {
+  bool needs_update = false;
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  if (reader.PopBool(&needs_update) && needs_update) {
+    FetchMenu();
+  }
+}
+
+void StatusNotifierHost::Item::SendMenuEvent(int32_t id,
+                                             const std::string& event_id) {
+  if (!menu_proxy_) {
+    return;
+  }
+  dbus::MethodCall method_call(kMenuInterface, "Event");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt32(id);
+  writer.AppendString(event_id);
+  writer.AppendVariantOfInt32(0);
+  writer.AppendUint32(0);
+  menu_proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                          base::DoNothing());
+}
+
+StatusNotifierHost::StatusNotifierHost() = default;
+
+StatusNotifierHost::~StatusNotifierHost() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  items_.clear();
+  svg_transcoder_.reset();
+  bus_proxy_ = nullptr;
+  watcher_ = nullptr;
+  if (bus_) {
+    bus_->ShutdownOnDBusThreadAndBlock();
+    bus_.reset();
+  }
+  if (dbus_thread_) {
+    dbus_thread_->Stop();
+  }
+}
+
+// static
+std::unique_ptr<StatusNotifierHost> StatusNotifierHost::Create() {
+  auto host = std::unique_ptr<StatusNotifierHost>(new StatusNotifierHost());
+  if (!host->Start()) {
+    return nullptr;
+  }
+  return host;
+}
+
+bool StatusNotifierHost::Start() {
+  if (!Shell::HasInstance()) {
+    return false;
+  }
+  dbus_thread_ = std::make_unique<base::Thread>("AuraDE tray D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!dbus_thread_->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "AuraDE tray could not start its D-Bus thread";
+    return false;
+  }
+
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SESSION;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = dbus_thread_->task_runner();
+  bus_ = new dbus::Bus(std::move(bus_options));
+
+  watcher_ = bus_->GetExportedObject(dbus::ObjectPath(kWatcherPath));
+  const auto export_method = [this](const char* interface_name,
+                                    const char* method_name,
+                                    auto handler) {
+    watcher_->ExportMethod(
+        interface_name, method_name,
+        base::BindRepeating(handler, weak_ptr_factory_.GetWeakPtr()),
+        base::BindOnce(&StatusNotifierHost::OnExported,
+                       weak_ptr_factory_.GetWeakPtr()));
+  };
+  export_method(kWatcherInterface, "RegisterStatusNotifierItem",
+                &StatusNotifierHost::HandleRegisterItem);
+  export_method(kWatcherInterface, "RegisterStatusNotifierHost",
+                &StatusNotifierHost::HandleRegisterHost);
+  export_method(kPropertiesInterface, "Get", &StatusNotifierHost::HandleGet);
+  export_method(kPropertiesInterface, "GetAll",
+                &StatusNotifierHost::HandleGetAll);
+  export_method(kIntrospectableInterface, "Introspect",
+                &StatusNotifierHost::HandleIntrospect);
+
+  bus_proxy_ = bus_->GetObjectProxy(kBusService, dbus::ObjectPath(kBusPath));
+  bus_proxy_->ConnectToSignal(
+      kBusInterface, "NameOwnerChanged",
+      base::BindRepeating(&StatusNotifierHost::OnNameOwnerChanged,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::DoNothing());
+
+  // The methods are exported on the D-Bus thread before the name is asked
+  // for there, so no application finds the watcher without them.
+  bus_->RequestOwnership(kWatcherService, dbus::Bus::REQUIRE_PRIMARY,
+                         base::BindOnce(&StatusNotifierHost::OnOwnership,
+                                        weak_ptr_factory_.GetWeakPtr()));
+  shell_observation_.Observe(Shell::Get());
+  if (auto* color_mode = DarkLightModeController::Get()) {
+    color_mode_observation_.Observe(color_mode);
+  }
+  return true;
+}
+
+void StatusNotifierHost::OnOwnership(const std::string& service_name,
+                                     bool success) {
+  if (!success) {
+    LOG(ERROR) << "AuraDE could not own " << service_name
+               << "; Linux applications' tray icons will not show";
+    return;
+  }
+  // Applications that found no host wait for one.
+  dbus::Signal signal(kWatcherInterface, "StatusNotifierHostRegistered");
+  watcher_->SendSignal(&signal);
+}
+
+void StatusNotifierHost::OnExported(const std::string& interface_name,
+                                    const std::string& method_name,
+                                    bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE tray could not export " << interface_name
+                          << "." << method_name;
+}
+
+void StatusNotifierHost::HandleRegisterItem(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string service;
+  if (!reader.PopString(&service) || service.empty()) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, "org.freedesktop.DBus.Error.InvalidArgs",
+            "No service given"));
+    return;
+  }
+  // An item names its bus name, or only its object path on the
+  // connection it called from, or both as the watcher lists them.
+  std::string bus_name = service;
+  std::string path = kDefaultItemPath;
+  if (const size_t slash = service.find('/'); slash != std::string::npos) {
+    bus_name = slash ? service.substr(0, slash) : method_call->GetSender();
+    path = service.substr(slash);
+  }
+  if (bus_name.empty() || !dbus::ObjectPath(path).IsValid()) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, "org.freedesktop.DBus.Error.InvalidArgs",
+            "Not a bus name or object path"));
+    return;
+  }
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+
+  if (items_.contains(bus_name + path)) {
+    return;
+  }
+  if (IsUniqueName(bus_name)) {
+    AddItem(bus_name, bus_name, path);
+    return;
+  }
+  dbus::MethodCall get_owner(kBusInterface, "GetNameOwner");
+  dbus::MessageWriter writer(&get_owner);
+  writer.AppendString(bus_name);
+  bus_proxy_->CallMethod(
+      &get_owner, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&StatusNotifierHost::OnGetNameOwner,
+                     weak_ptr_factory_.GetWeakPtr(), bus_name, path));
+}
+
+void StatusNotifierHost::HandleRegisterHost(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+  dbus::Signal signal(kWatcherInterface, "StatusNotifierHostRegistered");
+  watcher_->SendSignal(&signal);
+}
+
+void StatusNotifierHost::HandleGet(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string interface_name;
+  std::string property;
+  if (!reader.PopString(&interface_name) || !reader.PopString(&property) ||
+      interface_name != kWatcherInterface) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, "org.freedesktop.DBus.Error.UnknownInterface",
+            "No such interface"));
+    return;
+  }
+  std::unique_ptr<dbus::Response> response =
+      dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter writer(response.get());
+  if (property == "RegisteredStatusNotifierItems") {
+    std::vector<std::string> keys;
+    for (const auto& [key, item] : items_) {
+      keys.push_back(key);
+    }
+    dbus::MessageWriter variant(nullptr);
+    writer.OpenVariant("as", &variant);
+    variant.AppendArrayOfStrings(keys);
+    writer.CloseContainer(&variant);
+  } else if (property == "IsStatusNotifierHostRegistered") {
+    writer.AppendVariantOfBool(true);
+  } else if (property == "ProtocolVersion") {
+    writer.AppendVariantOfInt32(0);
+  } else {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, "org.freedesktop.DBus.Error.UnknownProperty",
+            "No such property"));
+    return;
+  }
+  std::move(response_sender).Run(std::move(response));
+}
+
+void StatusNotifierHost::HandleGetAll(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string interface_name;
+  if (!reader.PopString(&interface_name) ||
+      interface_name != kWatcherInterface) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, "org.freedesktop.DBus.Error.UnknownInterface",
+            "No such interface"));
+    return;
+  }
+  std::unique_ptr<dbus::Response> response =
+      dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter writer(response.get());
+  dbus::MessageWriter array(nullptr);
+  writer.OpenArray("{sv}", &array);
+
+  dbus::MessageWriter entry(nullptr);
+  array.OpenDictEntry(&entry);
+  entry.AppendString("RegisteredStatusNotifierItems");
+  std::vector<std::string> keys;
+  for (const auto& [key, item] : items_) {
+    keys.push_back(key);
+  }
+  dbus::MessageWriter variant(nullptr);
+  entry.OpenVariant("as", &variant);
+  variant.AppendArrayOfStrings(keys);
+  entry.CloseContainer(&variant);
+  array.CloseContainer(&entry);
+
+  array.OpenDictEntry(&entry);
+  entry.AppendString("IsStatusNotifierHostRegistered");
+  entry.AppendVariantOfBool(true);
+  array.CloseContainer(&entry);
+
+  array.OpenDictEntry(&entry);
+  entry.AppendString("ProtocolVersion");
+  entry.AppendVariantOfInt32(0);
+  array.CloseContainer(&entry);
+
+  writer.CloseContainer(&array);
+  std::move(response_sender).Run(std::move(response));
+}
+
+void StatusNotifierHost::HandleIntrospect(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  std::unique_ptr<dbus::Response> response =
+      dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter writer(response.get());
+  writer.AppendString(kWatcherIntrospection);
+  std::move(response_sender).Run(std::move(response));
+}
+
+void StatusNotifierHost::OnGetNameOwner(const std::string& bus_name,
+                                        const std::string& path,
+                                        dbus::Response* response) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string owner;
+  if (reader.PopString(&owner) && IsUniqueName(owner)) {
+    AddItem(bus_name, owner, path);
+  }
+}
+
+void StatusNotifierHost::OnNameOwnerChanged(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  std::string name;
+  std::string old_owner;
+  std::string new_owner;
+  if (!reader.PopString(&name) || !reader.PopString(&old_owner) ||
+      !reader.PopString(&new_owner) || old_owner.empty()) {
+    return;
+  }
+  // An item goes with its connection, or with the name it registered by
+  // when that changes hands; an application that restarts registers again.
+  std::vector<std::string> gone;
+  for (const auto& [key, item] : items_) {
+    if (item->bus_name() == name || item->owner() == name) {
+      gone.push_back(key);
+    }
+  }
+  for (const std::string& key : gone) {
+    RemoveItem(key);
+  }
+}
+
+void StatusNotifierHost::AddItem(const std::string& bus_name,
+                                 const std::string& owner,
+                                 const std::string& path) {
+  const std::string key = bus_name + path;
+  if (items_.contains(key) || items_.size() >= kMaxItems) {
+    return;
+  }
+  // The same object registered under a second name is one item.
+  for (const auto& [other_key, item] : items_) {
+    if (item->owner() == owner && item->path() == path) {
+      return;
+    }
+  }
+  items_.emplace(key, std::make_unique<Item>(this, key, bus_name, owner, path,
+                                             next_icon_id_++));
+  EmitItemSignal("StatusNotifierItemRegistered", key);
+}
+
+void StatusNotifierHost::RemoveItem(const std::string& key) {
+  if (items_.erase(key)) {
+    EmitItemSignal("StatusNotifierItemUnregistered", key);
+  }
+}
+
+void StatusNotifierHost::EmitItemSignal(const char* signal_name,
+                                        const std::string& key) {
+  dbus::Signal signal(kWatcherInterface, signal_name);
+  dbus::MessageWriter writer(&signal);
+  writer.AppendString(key);
+  watcher_->SendSignal(&signal);
+}
+
+void StatusNotifierHost::OnRootWindowAdded(aura::Window* root_window) {
+  ReloadIcons();
+}
+
+void StatusNotifierHost::OnColorModeChanged(bool dark_mode_enabled) {
+  ReloadIcons();
+}
+
+void StatusNotifierHost::OnDisplayMetricsChanged(
+    const display::Display& display,
+    uint32_t changed_metrics) {
+  if (changed_metrics &
+      display::DisplayObserver::DISPLAY_METRIC_DEVICE_SCALE_FACTOR) {
+    ReloadIcons();
+  }
+}
+
+void StatusNotifierHost::ReloadIcons() {
+  for (const auto& [key, item] : items_) {
+    item->Reload();
+  }
+}
+
+apps::SvgIconTranscoder* StatusNotifierHost::GetSvgTranscoder() {
+  if (!svg_transcoder_) {
+    Profile* profile = ProfileManager::GetPrimaryUserProfile();
+    if (!profile) {
+      return nullptr;
+    }
+    svg_transcoder_ = std::make_unique<apps::SvgIconTranscoder>(profile);
+  }
+  return svg_transcoder_.get();
+}
+
+}  // namespace ash
