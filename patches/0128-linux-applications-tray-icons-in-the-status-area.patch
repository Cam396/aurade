+
+namespace apps {
+class SvgIconTranscoder;
+}  // namespace apps
+
+namespace aura {
+class Window;
+}  // namespace aura
+
+namespace base {
+class Thread;
+}  // namespace base
+
+namespace dbus {
+class Bus;
+class MethodCall;
+class ObjectProxy;
+class Response;
+class Signal;
+}  // namespace dbus
+
+namespace ash {
+
+// AuraDE compatibility: Linux applications put icons in the system tray with
+// StatusNotifierItem, the protocol KDE's and GNOME's trays read; Discord,
+// Steam, Telegram and Nextcloud are among them. Ash is the session's
+// StatusNotifierWatcher and its host: each item shows as an icon in the
+// status area on every monitor, with its tooltip. The left button activates
+// the application, the middle button does its second action, the wheel
+// scrolls it and the right button opens the application's own menu, read
+// over dbusmenu. Icons are drawn for the densest monitor and again when the
+// color mode or a monitor's scale changes.
+class StatusNotifierHost : public ShellObserver,
+                           public ColorModeObserver,
+                           public display::DisplayObserver {
+ public:
+  // Returns null when the host cannot start.
+  static std::unique_ptr<StatusNotifierHost> Create();
+
+  StatusNotifierHost(const StatusNotifierHost&) = delete;
+  StatusNotifierHost& operator=(const StatusNotifierHost&) = delete;
+  ~StatusNotifierHost() override;
+
+  // ShellObserver:
+  void OnRootWindowAdded(aura::Window* root_window) override;
+
+  // ColorModeObserver:
+  void OnColorModeChanged(bool dark_mode_enabled) override;
+
+  // display::DisplayObserver:
+  void OnDisplayMetricsChanged(const display::Display& display,
+                               uint32_t changed_metrics) override;
+
+ private:
+  class Item;
+
+  StatusNotifierHost();
+
+  bool Start();
+  void OnOwnership(const std::string& service_name, bool success);
+  void OnExported(const std::string& interface_name,
+                  const std::string& method_name,
+                  bool success);
+
+  // org.kde.StatusNotifierWatcher and what any D-Bus object answers.
+  void HandleRegisterItem(dbus::MethodCall* method_call,
+                          dbus::ExportedObject::ResponseSender response_sender);
+  void HandleRegisterHost(dbus::MethodCall* method_call,
+                          dbus::ExportedObject::ResponseSender response_sender);
+  void HandleGet(dbus::MethodCall* method_call,
+                 dbus::ExportedObject::ResponseSender response_sender);
+  void HandleGetAll(dbus::MethodCall* method_call,
+                    dbus::ExportedObject::ResponseSender response_sender);
+  void HandleIntrospect(dbus::MethodCall* method_call,
+                        dbus::ExportedObject::ResponseSender response_sender);
+
+  void OnGetNameOwner(const std::string& bus_name,
+                      const std::string& path,
+                      dbus::Response* response);
+  void OnNameOwnerChanged(dbus::Signal* signal);
+  void AddItem(const std::string& bus_name,
+               const std::string& owner,
+               const std::string& path);
+  void RemoveItem(const std::string& key);
+  void EmitItemSignal(const char* signal_name, const std::string& key);
+  void ReloadIcons();
+
+  // Rasterizes SVG icons in a renderer for every item, made on first use.
+  apps::SvgIconTranscoder* GetSvgTranscoder();
+
+  std::unique_ptr<base::Thread> dbus_thread_;
+  scoped_refptr<dbus::Bus> bus_;
+  raw_ptr<dbus::ExportedObject> watcher_ = nullptr;
+  raw_ptr<dbus::ObjectProxy> bus_proxy_ = nullptr;
+  std::unique_ptr<apps::SvgIconTranscoder> svg_transcoder_;
+  // The items, by the bus name and object path each registered with, the
+  // form the watcher's own property lists them in.
+  std::map<std::string, std::unique_ptr<Item>> items_;
+  // Clear of the IDs Chrome's own status icons count up from 2, and small
+  // enough to become a view's ID.
+  int64_t next_icon_id_ = int64_t{1} << 24;
+  base::ScopedObservation<Shell, ShellObserver> shell_observation_{this};
+  base::ScopedObservation<DarkLightModeController, ColorModeObserver>
+      color_mode_observation_{this};
+  display::ScopedDisplayObserver display_observer_{this};
+  base::WeakPtrFactory<StatusNotifierHost> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_STATUS_NOTIFIER_HOST_H_
