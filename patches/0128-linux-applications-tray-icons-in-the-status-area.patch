+
+#ifndef ASH_SYSTEM_TRAY_INTERACTIVE_TRAY_ICON_H_
+#define ASH_SYSTEM_TRAY_INTERACTIVE_TRAY_ICON_H_
+
+#include <memory>
+#include <string>
+
+#include "ash/ash_export.h"
+#include "ash/system/tray/imaged_tray_icon.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+
+namespace ui {
+class Event;
+class ImageModel;
+class MouseWheelEvent;
+class SimpleMenuModel;
+}  // namespace ui
+
+namespace ash {
+
+class Shelf;
+struct TrayIconHandlers;
+
+// AuraDE compatibility: a status tray icon that answers the way a Linux
+// application's tray icon does on other desktops. The left button activates
+// the application, the middle button does its second action, the wheel
+// scrolls it and the right button opens its menu.
+class ASH_EXPORT InteractiveTrayIcon : public ImagedTrayIcon {
+  METADATA_HEADER(InteractiveTrayIcon, ImagedTrayIcon)
+
+ public:
+  InteractiveTrayIcon(Shelf* shelf,
+                      const ui::ImageModel& image_model,
+                      const std::u16string& tooltip,
+                      TrayIconHandlers handlers);
+  InteractiveTrayIcon(const InteractiveTrayIcon&) = delete;
+  InteractiveTrayIcon& operator=(const InteractiveTrayIcon&) = delete;
+  ~InteractiveTrayIcon() override;
+
+  // Shows the icon's menu as the right button would.
+  void ShowMenu();
+
+  // views::View:
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override;
+
+ protected:
+  // TrayBackgroundView:
+  std::unique_ptr<ui::SimpleMenuModel> CreateContextMenuModel() override;
+
+ private:
+  void OnPressed(const ui::Event& event);
+
+  std::unique_ptr<TrayIconHandlers> handlers_;
+};
+
+}  // namespace ash
+
+#endif  // ASH_SYSTEM_TRAY_INTERACTIVE_TRAY_ICON_H_
