+// found in the LICENSE file.
+
+#include "ash/system/tray/interactive_tray_icon.h"
+
+#include <utility>
+
+#include "ash/constants/tray_background_view_catalog.h"
+#include "ash/shell.h"
+#include "base/functional/bind.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/mojom/menu_source_type.mojom-shared.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/menus/simple_menu_model.h"
+
+namespace ash {
+
+InteractiveTrayIcon::InteractiveTrayIcon(Shelf* shelf,
+                                         const ui::ImageModel& image_model,
+                                         const std::u16string& tooltip,
+                                         TrayIconHandlers handlers)
+    : ImagedTrayIcon(shelf,
+                     image_model,
+                     /*tooltip=*/tooltip,
+                     /*accessibility_name=*/tooltip,
+                     TrayBackgroundViewCatalogName::kChromeCustom),
+      handlers_(std::make_unique<TrayIconHandlers>(std::move(handlers))) {
+  SetCallback(base::BindRepeating(&InteractiveTrayIcon::OnPressed,
+                                  base::Unretained(this)));
+  SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                           ui::EF_MIDDLE_MOUSE_BUTTON);
+  SetContextMenuEnabled(!handlers_->menu.is_null());
+}
+
+InteractiveTrayIcon::~InteractiveTrayIcon() = default;
+
+void InteractiveTrayIcon::ShowMenu() {
+  ShowContextMenu(GetBoundsInScreen().CenterPoint(),
+                  ui::mojom::MenuSourceType::kMouse);
+}
+
+bool InteractiveTrayIcon::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  if (handlers_->scroll.is_null()) {
+    return ImagedTrayIcon::OnMouseWheel(event);
+  }
+  if (event.y_offset()) {
+    handlers_->scroll.Run(event.y_offset(), /*horizontal=*/false);
+  }
+  if (event.x_offset()) {
+    handlers_->scroll.Run(event.x_offset(), /*horizontal=*/true);
+  }
+  return true;
+}
+
+std::unique_ptr<ui::SimpleMenuModel>
+InteractiveTrayIcon::CreateContextMenuModel() {
+  return handlers_->menu.is_null()
+             ? nullptr
+             : handlers_->menu.Run(GetBoundsInScreen().CenterPoint());
+}
+
+void InteractiveTrayIcon::OnPressed(const ui::Event& event) {
+  const gfx::Point point = GetBoundsInScreen().CenterPoint();
+  if (event.IsMouseEvent() && (event.flags() & ui::EF_MIDDLE_MOUSE_BUTTON)) {
+    if (!handlers_->secondary_activate.is_null()) {
+      handlers_->secondary_activate.Run(point);
+    }
+    return;
+  }
+  if (!handlers_->activate.is_null()) {
+    handlers_->activate.Run(point);
+  }
+}
+
+BEGIN_METADATA(InteractiveTrayIcon)
+END_METADATA
+
+}  // namespace ash
