+    <signal name="StatusNotifierItemUnregistered">
+      <arg type="s"/>
+    </signal>
+    <signal name="StatusNotifierHostRegistered"/>
+    <signal name="StatusNotifierHostUnregistered"/>
+  </interface>
+  <interface name="org.freedesktop.DBus.Properties">
+    <method name="Get">
+      <arg name="interface_name" type="s" direction="in"/>
+      <arg name="property_name" type="s" direction="in"/>
+      <arg name="value" type="v" direction="out"/>
+    </method>
+    <method name="GetAll">
+      <arg name="interface_name" type="s" direction="in"/>
+      <arg name="properties" type="a{sv}" direction="out"/>
+    </method>
+  </interface>
+  <interface name="org.freedesktop.DBus.Introspectable">
+    <method name="Introspect">
+      <arg name="xml_data" type="s" direction="out"/>
+    </method>
+  </interface>
+</node>
+)";
+
+// The icons' size in the status area, in DIPs.
+constexpr int kIconSizeDip = 20;
+// SVG icons are drawn at this size and scaled down from it.
+constexpr int kSvgRenderSizePx = 64;
+// The first SVG asks start the renderer that draws them and fail.
+constexpr int kMaxSvgAttempts = 4;
+constexpr base::TimeDelta kSvgRetryDelay = base::Seconds(1);
+
+// Bounds on what one application can make the desktop hold.
+constexpr size_t kMaxItems = 64;
+constexpr int kMaxPixmapSize = 512;
+constexpr size_t kMaxIconFileBytes = 1024 * 1024;
+constexpr size_t kMaxTextBytes = 512;
+constexpr int kMaxMenuDepth = 8;
+constexpr size_t kMaxMenuNodes = 1000;
+constexpr size_t kMaxThemeDirectories = 512;
+constexpr size_t kMaxKnownIconPaths = 64;
+
+// Items change several properties at once, each with its own signal.
+constexpr base::TimeDelta kRefreshDelay = base::Milliseconds(50);
+constexpr base::TimeDelta kMenuFetchDelay = base::Milliseconds(100);
+
+bool IsUniqueName(std::string_view name) {
+  return !name.empty() && name[0] == ':';
+}
+
+std::string Truncated(std::string text) {
+  std::string out;
+  base::TruncateUTF8ToByteSize(text, kMaxTextBytes, &out);
+  return out;
+}
+
+// A string, or an object path where the specification says string, or the
+// other way around.
+bool PopText(dbus::MessageReader* value, std::string* out) {
+  if (value->GetDataType() == dbus::Message::OBJECT_PATH) {
+    dbus::ObjectPath path;
+    if (!value->PopObjectPath(&path)) {
+      return false;
+    }
+    *out = path.value();
+    return true;
+  }
+  std::string text;
+  if (!value->PopString(&text)) {
+    return false;
+  }
+  *out = Truncated(std::move(text));
+  return true;
+}
+
+// Tooltips may carry the markup KDE's trays show.
+std::string StripMarkup(std::string_view text) {
+  std::string out;
+  bool in_tag = false;
+  for (char c : text) {
+    if (c == '<') {
+      in_tag = true;
+    } else if (c == '>') {
+      in_tag = false;
+    } else if (!in_tag) {
+      out += c;
+    }
+  }
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&lt;", "<");
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&gt;", ">");
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&quot;", "\"");
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&apos;", "'");
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&#39;", "'");
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&nbsp;", " ");
+  base::ReplaceSubstringsAfterOffset(&out, 0, "&amp;", "&");
+  return std::string(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+}
+
+// One picture in an item's a(iiay): ARGB32 pixels in network byte order.
+struct Pixmap {
+  int width = 0;
+  int height = 0;
+  std::vector<uint8_t> argb;
+};
+
+bool PopPixmaps(dbus::MessageReader* value, std::vector<Pixmap>* out) {
+  out->clear();
+  dbus::MessageReader array(nullptr);
+  if (!value->PopArray(&array)) {
+    return false;
+  }
+  while (array.HasMoreData()) {
+    dbus::MessageReader entry(nullptr);
+    Pixmap pixmap;
+    base::span<const uint8_t> bytes;
+    if (!array.PopStruct(&entry) || !entry.PopInt32(&pixmap.width) ||
+        !entry.PopInt32(&pixmap.height) || !entry.PopArrayOfBytes(&bytes)) {
+      return false;
+    }
+    if (pixmap.width <= 0 || pixmap.height <= 0 ||
+        pixmap.width > kMaxPixmapSize || pixmap.height > kMaxPixmapSize ||
+        bytes.size() != static_cast<size_t>(pixmap.width) *
+                            static_cast<size_t>(pixmap.height) * 4) {
+      continue;
+    }
+    pixmap.argb.assign(bytes.begin(), bytes.end());
+    out->push_back(std::move(pixmap));
+  }
+  return true;
+}
+
+// The smallest picture at least `target_px` across, or else the largest.
+const Pixmap* PickPixmap(const std::vector<Pixmap>& pixmaps, int target_px) {
+  const Pixmap* best = nullptr;
+  for (const Pixmap& pixmap : pixmaps) {
+    const int size = std::max(pixmap.width, pixmap.height);
+    if (!best) {
+      best = &pixmap;
+      continue;
+    }
+    const int best_size = std::max(best->width, best->height);
+    if ((best_size < target_px && size > best_size) ||
+        (size >= target_px && size < best_size)) {
+      best = &pixmap;
+    }
+  }
+  return best;
+}
+
+SkBitmap PixmapToBitmap(const Pixmap& pixmap) {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocN32Pixels(pixmap.width, pixmap.height)) {
+    return SkBitmap();
+  }
+  size_t i = 0;
+  for (int y = 0; y < pixmap.height; ++y) {
+    for (int x = 0; x < pixmap.width; ++x, i += 4) {
+      *bitmap.getAddr32(x, y) =
+          SkPreMultiplyARGB(pixmap.argb[i], pixmap.argb[i + 1],
+                            pixmap.argb[i + 2], pixmap.argb[i + 3]);
+    }
+  }
+  return bitmap;
+}
+
+// Symbolic icons are drawn in one color that the desktop chooses.
+void TintBitmap(SkBitmap* bitmap, SkColor color) {
+  for (int y = 0; y < bitmap->height(); ++y) {
+    for (int x = 0; x < bitmap->width(); ++x) {
+      *bitmap->getAddr32(x, y) = SkPreMultiplyARGB(
+          SkColorGetA(bitmap->getColor(x, y)), SkColorGetR(color),
+          SkColorGetG(color), SkColorGetB(color));
+    }
+  }
+}
+
+bool IsDarkMode() {
+  auto* controller = DarkLightModeController::Get();
+  return !controller || controller->IsDarkModeEnabled();
+}
+
+SkColor SymbolicColor() {
+  return IsDarkMode() ? SkColorSetRGB(0xE3, 0xE3, 0xE3)
+                      : SkColorSetRGB(0x1F, 0x1F, 0x1F);
+}
+
+// The status area draws icons `kIconSizeDip` across, resampled well for each
+// display's scale, and keeps their shape.
+gfx::ImageSkia ToTrayImage(const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing()) {
+    return gfx::ImageSkia();
+  }
+  const int longest = std::max(bitmap.width(), bitmap.height());
+  const float scale = static_cast<float>(longest) / kIconSizeDip;
+  const gfx::Size size(
+      std::max(1, base::ClampRound(bitmap.width() / scale)),
+      std::max(1, base::ClampRound(bitmap.height() / scale)));
+  return gfx::ImageSkiaOperations::CreateResizedImage(
+      gfx::ImageSkia::CreateFromBitmap(bitmap, scale),
+      skia::ImageOperations::RESIZE_BEST, size);
+}
+
+// The display a point on the screen is on.
+int64_t DisplayIdAt(const gfx::Point& screen_point) {
+  return display::Screen::Get()->GetDisplayNearestPoint(screen_point).id();
+}
+
+// The pixels an icon needs on the densest display.
+int IconTargetPixels() {
+  float scale = 1.f;
+  for (const display::Display& display :
+       display::Screen::Get()->GetAllDisplays()) {
+    scale = std::max(scale, display.device_scale_factor());
+  }
+  return static_cast<int>(std::ceil(kIconSizeDip * scale));
+}
+
+// For an item whose icon cannot be found: its initial on a disc, so it can
+// still be reached.
+class LetterIconSource : public gfx::CanvasImageSource {
+ public:
+  explicit LetterIconSource(std::u16string letter)
+      : gfx::CanvasImageSource(gfx::Size(kIconSizeDip, kIconSizeDip)),
+        letter_(std::move(letter)),
+        dark_(IsDarkMode()) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(dark_ ? SkColorSetRGB(0x5F, 0x63, 0x68)
+                         : SkColorSetRGB(0xDA, 0xDC, 0xE0));
+    canvas->DrawCircle(gfx::PointF(kIconSizeDip / 2.f, kIconSizeDip / 2.f),
+                       kIconSizeDip / 2.f, flags);
+    canvas->DrawStringRectWithFlags(
+        letter_, gfx::FontList().DeriveWithWeight(gfx::Font::Weight::BOLD),
+        dark_ ? SK_ColorWHITE : SkColorSetRGB(0x1F, 0x1F, 0x1F),
+        gfx::Rect(size()), gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  const std::u16string letter_;
+  const bool dark_;
+};
+
+gfx::ImageSkia LetterIcon(const std::string& name) {
+  std::u16string letter = u"?";
+  for (char16_t c : base::UTF8ToUTF16(name)) {
+    if (base::IsAsciiAlphaNumeric(c) || c > 0x7f) {
+      letter = std::u16string(1, base::ToUpperASCII(c));
+      break;
+    }
+  }
+  return gfx::ImageSkia(std::make_unique<LetterIconSource>(std::move(letter)),
+                        gfx::Size(kIconSizeDip, kIconSizeDip));
+}
+
+// What an icon is looked up by, and what was found, on the blocking pool.
+struct IconQuery {
+  std::string name;
+  std::string theme_path;
+  bool dark = true;
+  int target_px = kIconSizeDip;
+  // Where this name was found before, tried first.
+  base::FilePath known_path;
+};
+
+struct IconFile {
+  base::FilePath path;
+  std::string bytes;
+};
+
+// Not base::ReadFileToString: a name could lead to a pipe or a device, and
+// reading one of those may never end.
+std::optional<std::string> ReadIconFile(const base::FilePath& path) {
+  base::ScopedFD fd(HANDLE_EINTR(open(
+      path.value().c_str(), O_RDONLY | O_CLOEXEC | O_NOCTTY | O_NONBLOCK)));
+  if (!fd.is_valid()) {
+    return std::nullopt;
+  }
+  struct stat info;
+  if (fstat(fd.get(), &info) != 0 || !S_ISREG(info.st_mode) ||
+      info.st_size <= 0 ||
+      static_cast<uint64_t>(info.st_size) > kMaxIconFileBytes) {
+    return std::nullopt;
+  }
+  std::string bytes(static_cast<size_t>(info.st_size), '\0');
+  if (!base::ReadFromFD(fd.get(), bytes)) {
+    return std::nullopt;
+  }
+  return bytes;
+}
+
+bool IsSvg(const base::FilePath& path) {
+  return base::EqualsCaseInsensitiveASCII(path.Extension(), ".svg");
+}
+
+// "22x22", "22x22@2", "22", "22@2x", "scalable" or "symbolic" in an icon
+// theme's directory names: the size in pixels, 0 for any size, -1 for none.
+int IconDirectorySize(std::string_view name) {
+  if (name == "scalable" || name == "symbolic") {
+    return 0;
+  }
+  int scale = 1;
+  if (const size_t at = name.find('@'); at != std::string_view::npos) {
+    std::string_view scale_text = name.substr(at + 1);
+    if (scale_text.ends_with('x')) {
+      scale_text.remove_suffix(1);
+    }
+    if (!base::StringToInt(scale_text, &scale) || scale < 1 || scale > 4) {
+      return -1;
+    }
+    name = name.substr(0, at);
+  }
+  if (const size_t x = name.find('x'); x != std::string_view::npos) {
+    name = name.substr(0, x);
+  }
+  int size = 0;
+  if (!base::StringToInt(name, &size) || size <= 0 || size > 1024) {
+    return -1;
+  }
+  return size * scale;
+}
+
+// The size of the icon at `path`, from the directories it is in: hicolor
+// puts the size first ("22x22/apps"), Breeze puts it last ("apps/22").
+int IconFileSize(const base::FilePath& path) {
+  const base::FilePath parent = path.DirName();
+  const int size = IconDirectorySize(parent.BaseName().value());
+  return size >= 0 ? size
+                   : IconDirectorySize(parent.DirName().BaseName().value());
+}
+
+// The best of `found` for `target_px`: the smallest fixed size at least that,
+// else one that scales, else one of a size its path does not tell, as in an
+// application's own directory, else the largest there is.
+std::optional<base::FilePath> PickIconFile(
+    const std::vector<base::FilePath>& found,
+    int target_px) {
+  std::optional<base::FilePath> larger;
+  int larger_size = 0;
+  std::optional<base::FilePath> scalable;
+  std::optional<base::FilePath> unsized;
+  std::optional<base::FilePath> smaller;
+  int smaller_size = 0;
+  for (const base::FilePath& path : found) {
+    const int size = IconFileSize(path);
+    if (size <= 0) {
+      std::optional<base::FilePath>& slot = IsSvg(path) ? scalable : unsized;
+      if (!slot) {
+        slot = path;
+      }
+    } else if (size >= target_px) {
+      if (!larger || size < larger_size) {
+        larger = path;
+        larger_size = size;
+      }
+    } else if (size > smaller_size) {
+      smaller = path;
+      smaller_size = size;
+    }
+  }
+  if (larger) {
+    return larger;
+  }
+  if (scalable) {
+    return scalable;
+  }
+  if (unsized) {
+    return unsized;
+  }
+  return smaller;
+}
+
+// Icons drawn in one color for the desktop to choose: GNOME's naming, or
+// Breeze's and Adwaita's directory of them.
+bool IsSymbolicIcon(const base::FilePath& path) {
+  return base::EndsWith(path.BaseName().RemoveFinalExtension().value(),
+                        "-symbolic") ||
+         path.value().find("/symbolic/") != std::string::npos;
+}
+
+void AddIfExists(const base::FilePath& dir,
+                 const std::string& name,
+                 std::vector<base::FilePath>* found) {
+  for (const char* extension : {".png", ".svg"}) {
+    const base::FilePath path = dir.Append(name + extension);
+    if (base::PathExists(path)) {
+      found->push_back(path);
+    }
+  }
+}
+
+// Every directory of `theme_dir` that holds `name`, as its index.theme lists
+// them, or two levels down when it has none.
+std::vector<base::FilePath> FindInTheme(const base::FilePath& theme_dir,
+                                        const std::string& name) {
+  std::vector<base::FilePath> found;
+  if (!base::DirectoryExists(theme_dir)) {
+    return found;
+  }
+  std::vector<std::string> directories;
+  std::string index;
+  if (base::ReadFileToStringWithMaxSize(theme_dir.Append("index.theme"),
+                                        &index, 512 * 1024)) {
+    for (std::string_view line : base::SplitStringPiece(
+             index, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      for (std::string_view key : {"Directories=", "ScaledDirectories="}) {
+        if (base::StartsWith(line, key)) {
+          for (std::string_view directory : base::SplitStringPiece(
+                   line.substr(key.size()), ",", base::TRIM_WHITESPACE,
+                   base::SPLIT_WANT_NONEMPTY)) {
+            if (directories.size() < kMaxThemeDirectories &&
+                directory.find("..") == std::string_view::npos) {
+              directories.emplace_back(directory);
+            }
+          }
+        }
+      }
+    }
+  }
+  if (directories.empty()) {
+    base::FileEnumerator top(theme_dir, /*recursive=*/false,
+                             base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath first = top.Next(); !first.empty();
+         first = top.Next()) {
+      base::FileEnumerator inner(first, /*recursive=*/false,
+                                 base::FileEnumerator::DIRECTORIES);
+      for (base::FilePath second = inner.Next(); !second.empty();
+           second = inner.Next()) {
+        if (directories.size() >= kMaxThemeDirectories) {
+          break;
+        }
+        directories.push_back(
+            first.BaseName().Append(second.BaseName()).value());
+      }
+      AddIfExists(first, name, &found);
+    }
+  }
+  for (const std::string& directory : directories) {
+    AddIfExists(theme_dir.Append(directory), name, &found);
+  }
+  return found;
+}
+
+std::vector<base::FilePath> IconRoots() {
+  std::vector<base::FilePath> roots;
+  std::unique_ptr<base::Environment> environment = base::Environment::Create();
+  if (std::optional<std::string> data_home =
+          environment->GetVar("XDG_DATA_HOME");
+      data_home && !data_home->empty()) {
+    roots.push_back(base::FilePath(*data_home).Append("icons"));
+  } else if (std::optional<std::string> home = environment->GetVar("HOME");
+             home && !home->empty()) {
+    roots.push_back(base::FilePath(*home).Append(".local/share/icons"));
+  }
+  if (std::optional<std::string> home = environment->GetVar("HOME");
+      home && !home->empty()) {
+    roots.push_back(base::FilePath(*home).Append(".icons"));
+  }
+  const std::string data_dirs = environment->GetVar("XDG_DATA_DIRS")
+                                    .value_or("/usr/local/share:/usr/share");
+  for (std::string_view dir : base::SplitStringPiece(
+           data_dirs, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    roots.push_back(base::FilePath(dir).Append("icons"));
+  }
+  return roots;
+}
+
+std::optional<IconFile> ReadIconAt(const base::FilePath& path) {
+  std::optional<std::string> bytes = ReadIconFile(path);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  return IconFile{path, std::move(*bytes)};
+}
+
+// Finds the icon called `name` the way trays on other desktops do: the
+// item's own directory, then the icon themes, then pixmaps.
+std::optional<IconFile> FindNamedIcon(const IconQuery& query,
+                                      const std::string& name) {
+  // Breeze's status icons are drawn for the background they sit on.
+  const std::vector<std::string> themes = {
+      query.dark ? "breeze-dark" : "breeze", "Adwaita", "AdwaitaLegacy",
+      "hicolor"};
+
+  if (!query.theme_path.empty()) {
+    const base::FilePath theme_path(query.theme_path);
+    if (theme_path.IsAbsolute() &&
+        query.theme_path.find("..") == std::string::npos) {
+      std::vector<base::FilePath> found;
+      AddIfExists(theme_path, name, &found);
+      if (found.empty()) {
+        found = FindInTheme(theme_path, name);
+      }
+      if (found.empty()) {
+        for (const std::string& theme : themes) {
+          found = FindInTheme(theme_path.Append(theme), name);
+          if (!found.empty()) {
+            break;
+          }
+        }
+      }
+      if (std::optional<base::FilePath> path =
+              PickIconFile(found, query.target_px)) {
+        if (std::optional<IconFile> file = ReadIconAt(*path)) {
+          return file;
+        }
+      }
+    }
+  }
+
+  const std::vector<base::FilePath> roots = IconRoots();
+  for (const std::string& theme : themes) {
+    std::vector<base::FilePath> found;
+    for (const base::FilePath& root : roots) {
+      std::vector<base::FilePath> in_root =
+          FindInTheme(root.Append(theme), name);
+      found.insert(found.end(), in_root.begin(), in_root.end());
+    }
+    if (std::optional<base::FilePath> path =
+            PickIconFile(found, query.target_px)) {
+      if (std::optional<IconFile> file = ReadIconAt(*path)) {
+        return file;
+      }
+    }
+  }
+
+  std::vector<base::FilePath> found;
+  AddIfExists(base::FilePath("/usr/share/pixmaps"), name, &found);
+  if (std::optional<base::FilePath> path =
+          PickIconFile(found, query.target_px)) {
+    return ReadIconAt(*path);
+  }
+  return std::nullopt;
+}
+
+// An item's icon: a path, or a name looked up where it was found before and
+// then everywhere.
+std::optional<IconFile> FindIconFile(const IconQuery& query) {
+  if (!query.known_path.empty()) {
+    if (std::optional<IconFile> file = ReadIconAt(query.known_path)) {
+      return file;
+    }
+  }
+
+  if (base::FilePath(query.name).IsAbsolute()) {
+    if (query.name.find("..") != std::string::npos) {
+      return std::nullopt;
+    }
+    for (const char* extension : {"", ".png", ".svg"}) {
+      if (std::optional<IconFile> file =
+              ReadIconAt(base::FilePath(query.name + extension))) {
+        return file;
+      }
+    }
+    return std::nullopt;
+  }
+  if (query.name.find('/') != std::string::npos) {
+    return std::nullopt;
+  }
+
+  if (std::optional<IconFile> file = FindNamedIcon(query, query.name)) {
+    return file;
+  }
+  // A theme may draw only the symbolic icon of a name, or only the full
+  // color one; each stands in for the other.
+  constexpr std::string_view kSymbolic = "-symbolic";
+  return FindNamedIcon(
+      query, base::EndsWith(query.name, kSymbolic)
+                 ? query.name.substr(0, query.name.size() - kSymbolic.size())
+                 : query.name + std::string(kSymbolic));
+}
+
+// One entry of an application's dbusmenu layout.
+struct MenuNode {
+  int32_t id = 0;
+  std::string label;
+  bool separator = false;
+  bool enabled = true;
+  bool visible = true;
+  std::string toggle_type;
+  int32_t toggle_state = 0;
+  bool submenu = false;
+  std::vector<MenuNode> children;
+};
+
+bool PopMenuNode(dbus::MessageReader* reader,
+                 int depth,
+                 size_t* count,
+                 MenuNode* node) {
+  if (depth > kMaxMenuDepth || ++*count > kMaxMenuNodes) {
+    return false;
+  }
+  dbus::MessageReader entry(nullptr);
+  dbus::MessageReader properties(nullptr);
+  if (!reader->PopStruct(&entry) || !entry.PopInt32(&node->id) ||
+      !entry.PopArray(&properties)) {
+    return false;
+  }
+  while (properties.HasMoreData()) {
+    dbus::MessageReader property(nullptr);
+    std::string key;
+    dbus::MessageReader value(nullptr);
+    if (!properties.PopDictEntry(&property) || !property.PopString(&key) ||
+        !property.PopVariant(&value)) {
+      return false;
+    }
+    if (key == "type") {
+      std::string type;
+      node->separator = value.PopString(&type) && type == "separator";
+    } else if (key == "label") {
+      PopText(&value, &node->label);
+    } else if (key == "enabled") {
+      value.PopBool(&node->enabled);
+    } else if (key == "visible") {
+      value.PopBool(&node->visible);
+    } else if (key == "toggle-type") {
+      value.PopString(&node->toggle_type);
+    } else if (key == "toggle-state") {
+      value.PopInt32(&node->toggle_state);
+    } else if (key == "children-display") {
+      std::string display;
+      node->submenu = value.PopString(&display) && display == "submenu";
+    }
+  }
+  dbus::MessageReader children(nullptr);
+  if (!entry.PopArray(&children)) {
+    return false;
+  }
+  while (children.HasMoreData()) {
+    dbus::MessageReader child(nullptr);
+    MenuNode child_node;
+    if (!children.PopVariant(&child) ||
+        !PopMenuNode(&child, depth + 1, count, &child_node)) {
+      return false;
+    }
+    node->children.push_back(std::move(child_node));
+  }
+  return true;
+}
+
+// dbusmenu marks a mnemonic with an underscore and doubles a literal one.
+// Ash's tray menus show no mnemonics, so the marks go and labels are drawn
+// as they read.
+std::u16string ToMenuLabel(const std::string& label) {
+  std::string out;
+  for (size_t i = 0; i < label.size(); ++i) {
+    if (label[i] != '_') {
+      out += label[i];
+    } else if (i + 1 < label.size() && label[i + 1] == '_') {
+      out += '_';
+      ++i;
+    }
+  }
+  return base::UTF8ToUTF16(out);
+}
+
+// An application's menu as Ash shows it. It answers through the item while
+// the item lives; command IDs are dbusmenu IDs plus one.
+class DbusMenuModel : public ui::SimpleMenuModel,
+                      public ui::SimpleMenuModel::Delegate {
+ public:
+  using EventCallback =
+      base::RepeatingCallback<void(int32_t id, const std::string& event_id)>;
+
+  DbusMenuModel(const MenuNode& root, EventCallback send_event)
+      : ui::SimpleMenuModel(this), send_event_(std::move(send_event)) {
+    menu_ids_[this] = root.id;
+    Build(this, root);
+  }
+
+  DbusMenuModel(const DbusMenuModel&) = delete;
+  DbusMenuModel& operator=(const DbusMenuModel&) = delete;
+  ~DbusMenuModel() override = default;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override {
+    return checked_.contains(command_id);
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    send_event_.Run(command_id - 1, "clicked");
+  }
+
+  void OnMenuWillShow(ui::SimpleMenuModel* source) override {
+    if (auto it = menu_ids_.find(source); it != menu_ids_.end()) {
+      send_event_.Run(it->second, "opened");
+    }
+  }
+
+  void MenuClosed(ui::SimpleMenuModel* source) override {
+    if (auto it = menu_ids_.find(source); it != menu_ids_.end()) {
+      send_event_.Run(it->second, "closed");
+    }
+  }
+
+ private:
+  void Build(ui::SimpleMenuModel* model, const MenuNode& node) {
+    for (const MenuNode& child : node.children) {
+      if (!child.visible) {
+        continue;
+      }
+      if (child.separator) {
+        // No separator first, last or twice.
+        if (model->GetItemCount() &&
+            model->GetTypeAt(model->GetItemCount() - 1) !=
+                ui::MenuModel::TYPE_SEPARATOR) {
+          model->AddSeparator(ui::NORMAL_SEPARATOR);
+        }
+        continue;
+      }
+      const int command_id = child.id + 1;
+      const std::u16string label = ToMenuLabel(child.label);
+      if (!child.children.empty()) {
+        auto submenu = std::make_unique<ui::SimpleMenuModel>(this);
+        menu_ids_[submenu.get()] = child.id;
+        Build(submenu.get(), child);
+        model->AddSubMenu(command_id, label, submenu.get());
+        submenus_.push_back(std::move(submenu));
+      } else if (child.toggle_type == "checkmark") {
+        model->AddCheckItem(command_id, label);
+      } else if (child.toggle_type == "radio") {
+        model->AddRadioItem(command_id, label, /*group_id=*/node.id);
+      } else {
+        model->AddItem(command_id, label);
+      }
+      if (child.toggle_state == 1) {
+        checked_.insert(command_id);
+      }
+      model->SetEnabledAt(model->GetItemCount() - 1, child.enabled);
+    }
+    if (model->GetItemCount() &&
+        model->GetTypeAt(model->GetItemCount() - 1) ==
+            ui::MenuModel::TYPE_SEPARATOR) {
+      model->RemoveItemAt(model->GetItemCount() - 1);
+    }
+  }
+
+  const EventCallback send_event_;
+  std::set<int> checked_;
+  std::vector<std::unique_ptr<ui::SimpleMenuModel>> submenus_;
+  // The dbusmenu ID of each menu, for the events that say it opened.
+  std::map<const ui::SimpleMenuModel*, int32_t> menu_ids_;
+};
+
