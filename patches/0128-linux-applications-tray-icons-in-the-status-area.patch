+// AuraDE compatibility: how a status tray icon answers besides a plain click,
+// for the icons Linux applications put there. A null callback does nothing.
+struct ASH_EXPORT TrayIconHandlers {
+  TrayIconHandlers();
+  TrayIconHandlers(TrayIconHandlers&&);
+  TrayIconHandlers& operator=(TrayIconHandlers&&);
+  ~TrayIconHandlers();
+
+  // The left button, a tap or the keyboard pressed the icon at `screen_point`.
+  base::RepeatingCallback<void(const gfx::Point& screen_point)> activate;
+  // The middle button pressed it.
+  base::RepeatingCallback<void(const gfx::Point& screen_point)>
+      secondary_activate;
+  // The wheel turned over it, `delta` in wheel units, 120 a notch.
+  base::RepeatingCallback<void(int delta, bool horizontal)> scroll;
+  // The right button, a long press or the menu key, on the icon at
+  // `screen_point`: the menu to show, or null for none.
+  base::RepeatingCallback<std::unique_ptr<ui::SimpleMenuModel>(
+      const gfx::Point& screen_point)>
+      menu;
+};
