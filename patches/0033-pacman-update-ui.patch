+constexpr char kAuraHostBridgeService[] = "org.aurade.HostBridge";
+constexpr char kAuraHostBridgePath[] = "/org/aurade/HostBridge";
+constexpr char kAuraHostBridgeInterface[] = "org.aurade.HostBridge1";
+constexpr char kAuraPacmanListUpdates[] = "PacmanListUpdates";
+constexpr char kAuraPacmanUpgrade[] = "PacmanUpgrade";
+constexpr char kAuraJobGet[] = "JobGet";
+constexpr char kLoginManagerService[] = "org.freedesktop.login1";
+constexpr char kLoginManagerPath[] = "/org/freedesktop/login1";
+constexpr char kLoginManagerInterface[] = "org.freedesktop.login1.Manager";
+constexpr char kAuraRollbackEntry[] = "aurade-rollback.conf";
+constexpr base::TimeDelta kAuraInitialUpdateDelay = base::Minutes(1);
+constexpr base::TimeDelta kAuraUpdateCheckInterval = base::Hours(6);
+constexpr base::TimeDelta kAuraJobPollInterval = base::Seconds(2);
+constexpr int kAuraHostBridgeTimeoutMs = 310000;
+
+// AuraDE compatibility: translate the Arch host bridge's package operations
+// into update_engine states so the existing settings, progress, and restart
+// notification surfaces remain the single system-update UI on generic Linux.
+class UpdateEngineClientAura : public UpdateEngineClient {
+ public:
+  UpdateEngineClientAura() {
+    last_status_.set_current_operation(update_engine::Operation::IDLE);
+    last_status_.set_progress(0.0);
+    rollback_available_ = base::PathExists(
+        base::FilePath("/boot/loader/entries/aurade-rollback.conf"));
+  }
+
+  UpdateEngineClientAura(const UpdateEngineClientAura&) = delete;
+  UpdateEngineClientAura& operator=(const UpdateEngineClientAura&) = delete;
+  ~UpdateEngineClientAura() override = default;
+
+  void Init(dbus::Bus* bus) override {
+    CHECK(bus);
+    host_bridge_proxy_ = bus->GetObjectProxy(
+        kAuraHostBridgeService, dbus::ObjectPath(kAuraHostBridgePath));
+    login_manager_proxy_ = bus->GetObjectProxy(
+        kLoginManagerService, dbus::ObjectPath(kLoginManagerPath));
+
+    initial_update_timer_.Start(
+        FROM_HERE, kAuraInitialUpdateDelay, this,
+        &UpdateEngineClientAura::CheckForDeferredUpdates);
+    periodic_update_timer_.Start(
+        FROM_HERE, kAuraUpdateCheckInterval, this,
+        &UpdateEngineClientAura::CheckForDeferredUpdates);
+  }
+
+  void AddObserver(Observer* observer) override {
+    observers_.AddObserver(observer);
+  }
+
+  void RemoveObserver(Observer* observer) override {
+    observers_.RemoveObserver(observer);
+  }
+
+  bool HasObserver(const Observer* observer) const override {
+    return observers_.HasObserver(observer);
+  }
+
+  void RequestUpdateCheck(UpdateCheckCallback callback) override {
+    RequestUpdateCheckInternal(std::move(callback), /*apply_update=*/true,
+                               /*mark_deferred=*/false);
+  }
+
+  void RequestUpdateCheckWithoutApplying(
+      UpdateCheckCallback callback) override {
+    RequestUpdateCheckInternal(std::move(callback), /*apply_update=*/false,
+                               /*mark_deferred=*/false);
+  }
+
+  void RebootAfterUpdate() override {
+    dbus::MethodCall method_call(kLoginManagerInterface, "Reboot");
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendBool(true);
+    login_manager_proxy_->CallMethod(
+        &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+        base::BindOnce([](dbus::Response* response) {
+          if (!response) {
+            LOG(ERROR) << "AuraDE update: logind rejected restart";
+          }
+        }));
+  }
+
+  void Rollback() override {
+    if (!rollback_available_) {
+      LOG(ERROR) << "AuraDE update: no rollback boot entry is available";
+      return;
+    }
+
+    dbus::MethodCall method_call(kLoginManagerInterface,
+                                 "SetRebootToBootLoaderEntry");
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendString(kAuraRollbackEntry);
+    login_manager_proxy_->CallMethod(
+        &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+        base::BindOnce(&UpdateEngineClientAura::OnRollbackEntrySelected,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void CanRollbackCheck(RollbackCheckCallback callback) override {
+    rollback_available_ = rollback_available_ ||
+                          base::PathExists(base::FilePath(
+                              "/boot/loader/entries/aurade-rollback.conf"));
+    std::move(callback).Run(rollback_available_);
+  }
+
+  update_engine::StatusResult GetLastStatus() override { return last_status_; }
+
+  void SetChannel(const std::string& target_channel,
+                  bool is_powerwash_allowed) override {
+    target_channel_ = target_channel;
+  }
+
+  void GetChannel(bool get_current_channel,
+                  GetChannelCallback callback) override {
+    std::move(callback).Run(get_current_channel ? current_channel_
+                                                : target_channel_);
+  }
+
+  void GetEolInfo(GetEolInfoCallback callback) override {
+    std::move(callback).Run(EolInfo());
+  }
+
+  void SetUpdateOverCellularPermission(bool allowed,
+                                       base::OnceClosure callback) override {
+    std::move(callback).Run();
+  }
+
+  void SetUpdateOverCellularOneTimePermission(
+      const std::string& update_version,
+      int64_t update_size,
+      UpdateOverCellularOneTimePermissionCallback callback) override {
+    std::move(callback).Run(true);
+  }
+
+  void ToggleFeature(const std::string& feature, bool enable) override {
+    VLOG(1) << "AuraDE update: ignoring update_engine feature " << feature;
+  }
+
+  void IsFeatureEnabled(const std::string& feature,
+                        IsFeatureEnabledCallback callback) override {
+    std::move(callback).Run(std::nullopt);
+  }
+
+  void ApplyDeferredUpdateAdvanced(
+      bool shutdown_after_update,
+      base::OnceClosure failure_callback) override {
+    if (!updates_available_ || update_job_running_) {
+      if (failure_callback) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, std::move(failure_callback));
+      }
+      return;
+    }
+    StartUpgrade(std::move(failure_callback));
+  }
+
+ private:
+  using HostResponseCallback =
+      base::OnceCallback<void(std::optional<base::DictValue>)>;
+
+  static std::optional<base::DictValue> ReadHostResponse(
+      dbus::Response* response) {
+    if (!response) {
+      LOG(ERROR) << "AuraDE update: host bridge did not respond";
+      return std::nullopt;
+    }
+
+    dbus::MessageReader reader(response);
+    std::string json;
+    if (!reader.PopString(&json)) {
+      LOG(ERROR) << "AuraDE update: host bridge returned a non-string reply";
+      return std::nullopt;
+    }
+
+    std::optional<base::Value> envelope =
+        base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+    if (!envelope || !envelope->is_dict()) {
+      LOG(ERROR) << "AuraDE update: host bridge returned invalid JSON";
+      return std::nullopt;
+    }
+
+    const base::DictValue& root = envelope->GetDict();
+    if (!root.FindBool("ok").value_or(false)) {
+      const base::DictValue* error = root.FindDict("error");
+      const std::string* message =
+          error ? error->FindString("message") : nullptr;
+      LOG(ERROR) << "AuraDE update: "
+                 << (message ? *message : "host bridge operation failed");
+      return std::nullopt;
+    }
+
+    const base::DictValue* data = root.FindDict("data");
+    if (!data) {
+      LOG(ERROR) << "AuraDE update: host bridge response has no data";
+      return std::nullopt;
+    }
+    return data->Clone();
+  }
+
+  void CallHostBridge(std::string_view method, HostResponseCallback callback) {
+    dbus::MethodCall method_call(kAuraHostBridgeInterface, std::string(method));
+    host_bridge_proxy_->CallMethod(
+        &method_call, kAuraHostBridgeTimeoutMs,
+        base::BindOnce(
+            [](HostResponseCallback callback, dbus::Response* response) {
+              std::move(callback).Run(
+                  UpdateEngineClientAura::ReadHostResponse(response));
+            },
+            std::move(callback)));
+  }
+
+  void CallHostBridge(std::string_view method,
+                      std::string_view argument,
+                      HostResponseCallback callback) {
+    dbus::MethodCall method_call(kAuraHostBridgeInterface, std::string(method));
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendString(std::string(argument));
+    host_bridge_proxy_->CallMethod(
+        &method_call, kAuraHostBridgeTimeoutMs,
+        base::BindOnce(
+            [](HostResponseCallback callback, dbus::Response* response) {
+              std::move(callback).Run(
+                  UpdateEngineClientAura::ReadHostResponse(response));
+            },
+            std::move(callback)));
+  }
+
+  static std::string ToUpdateVersion(const base::ListValue& packages) {
+    const std::string* arch_version = nullptr;
+    for (const base::Value& package : packages) {
+      const base::DictValue* dict = package.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      const std::string* candidate = dict->FindString("available_version");
+      if (!candidate) {
+        continue;
+      }
+      if (!arch_version) {
+        arch_version = candidate;
+      }
+      const std::string* name = dict->FindString("name");
+      if (name && (*name == "chromiumos-ash" || *name == "aurade")) {
+        arch_version = candidate;
+        break;
+      }
+    }
+
+    std::string normalized;
+    bool needs_separator = false;
+    for (char c : arch_version ? *arch_version : std::string()) {
+      if (std::isdigit(static_cast<unsigned char>(c))) {
+        if (needs_separator && !normalized.empty()) {
+          normalized.push_back('.');
+        }
+        normalized.push_back(c);
+        needs_separator = false;
+      } else if (!normalized.empty()) {
+        needs_separator = true;
+      }
+    }
+    if (base::Version(normalized).IsValid()) {
+      return normalized;
+    }
+    return "0.0.0.1";
+  }
+
+  void PublishStatus(update_engine::Operation operation, double progress) {
+    last_status_.set_current_operation(operation);
+    last_status_.set_progress(progress);
+    last_status_.set_last_checked_time(base::Time::Now().ToTimeT());
+    last_status_.set_new_version(update_version_);
+    last_status_.set_new_size(0);
+    last_status_.set_is_enterprise_rollback(false);
+    last_status_.set_will_powerwash_after_reboot(false);
+    last_status_.set_is_interactive(true);
+    last_status_.set_will_defer_update(
+        operation == update_engine::Operation::UPDATED_BUT_DEFERRED);
+    for (auto& observer : observers_) {
+      observer.UpdateStatusChanged(last_status_);
+    }
+  }
+
+  void CheckForDeferredUpdates() {
+    if (check_in_flight_ || update_job_running_ || updates_available_ ||
+        last_status_.current_operation() ==
+            update_engine::Operation::UPDATED_NEED_REBOOT) {
+      return;
+    }
+    RequestUpdateCheckInternal(UpdateCheckCallback(), /*apply_update=*/false,
+                               /*mark_deferred=*/true);
+  }
+
+  void RequestUpdateCheckInternal(UpdateCheckCallback callback,
+                                  bool apply_update,
+                                  bool mark_deferred) {
+    if (update_job_running_ || check_in_flight_) {
+      if (callback) {
+        std::move(callback).Run(UPDATE_RESULT_FAILED);
+      }
+      return;
+    }
+
+    if (updates_available_) {
+      if (callback) {
+        std::move(callback).Run(UPDATE_RESULT_SUCCESS);
+      }
+      if (apply_update) {
+        StartUpgrade(base::OnceClosure());
+      }
+      return;
+    }
+
+    if (last_status_.current_operation() ==
+        update_engine::Operation::UPDATED_NEED_REBOOT) {
+      if (callback) {
+        std::move(callback).Run(UPDATE_RESULT_SUCCESS);
+      }
+      return;
+    }
+
+    check_in_flight_ = true;
+    update_version_.clear();
+    PublishStatus(update_engine::Operation::CHECKING_FOR_UPDATE, 0.0);
+    CallHostBridge(
+        kAuraPacmanListUpdates,
+        base::BindOnce(&UpdateEngineClientAura::OnUpdatesListed,
+                       weak_factory_.GetWeakPtr(), std::move(callback),
+                       apply_update, mark_deferred));
+  }
+
+  void OnUpdatesListed(UpdateCheckCallback callback,
+                       bool apply_update,
+                       bool mark_deferred,
+                       std::optional<base::DictValue> data) {
+    check_in_flight_ = false;
+    if (!data) {
+      PublishStatus(update_engine::Operation::ERROR, 0.0);
+      if (callback) {
+        std::move(callback).Run(UPDATE_RESULT_FAILED);
+      }
+      return;
+    }
+
+    const base::ListValue* packages = data->FindList("packages");
+    if (!packages) {
+      PublishStatus(update_engine::Operation::ERROR, 0.0);
+      if (callback) {
+        std::move(callback).Run(UPDATE_RESULT_FAILED);
+      }
+      return;
+    }
+
+    updates_available_ = !packages->empty();
+    if (!updates_available_) {
+      update_version_.clear();
+      PublishStatus(update_engine::Operation::IDLE, 0.0);
+      if (callback) {
+        std::move(callback).Run(UPDATE_RESULT_SUCCESS);
+      }
+      return;
+    }
+
+    update_version_ = ToUpdateVersion(*packages);
+    PublishStatus(mark_deferred ? update_engine::Operation::UPDATED_BUT_DEFERRED
+                                : update_engine::Operation::UPDATE_AVAILABLE,
+                  0.0);
+    if (callback) {
+      std::move(callback).Run(UPDATE_RESULT_SUCCESS);
+    }
+    if (apply_update) {
+      StartUpgrade(base::OnceClosure());
+    }
+  }
+
+  void StartUpgrade(base::OnceClosure failure_callback) {
+    if (!updates_available_ || update_job_running_) {
+      if (failure_callback) {
+        std::move(failure_callback).Run();
+      }
+      return;
+    }
+
+    update_job_running_ = true;
+    update_progress_ = 0.01;
+    PublishStatus(update_engine::Operation::DOWNLOADING, update_progress_);
+    CallHostBridge(kAuraPacmanUpgrade,
+                   base::BindOnce(&UpdateEngineClientAura::OnUpgradeStarted,
+                                  weak_factory_.GetWeakPtr(),
+                                  std::move(failure_callback)));
+  }
+
+  void OnUpgradeStarted(base::OnceClosure failure_callback,
+                        std::optional<base::DictValue> data) {
+    const std::string* job_id = data ? data->FindString("job_id") : nullptr;
+    if (!job_id || job_id->empty()) {
+      update_job_running_ = false;
+      PublishStatus(update_engine::Operation::ERROR, update_progress_);
+      if (failure_callback) {
+        std::move(failure_callback).Run();
+      }
+      return;
+    }
+
+    update_job_id_ = *job_id;
+    ScheduleJobPoll(base::Milliseconds(250));
+  }
+
+  void ScheduleJobPoll(base::TimeDelta delay) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&UpdateEngineClientAura::PollUpdateJob,
+                       weak_factory_.GetWeakPtr()),
+        delay);
+  }
+
+  void PollUpdateJob() {
+    if (!update_job_running_ || update_job_id_.empty()) {
+      return;
+    }
+    CallHostBridge(kAuraJobGet, update_job_id_,
+                   base::BindOnce(&UpdateEngineClientAura::OnJobPolled,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void OnJobPolled(std::optional<base::DictValue> data) {
+    const std::string* state = data ? data->FindString("state") : nullptr;
+    if (!state) {
+      update_job_running_ = false;
+      update_job_id_.clear();
+      PublishStatus(update_engine::Operation::ERROR, update_progress_);
+      return;
+    }
+
+    if (*state == "running") {
+      update_progress_ = std::min(0.9, update_progress_ + 0.02);
+      PublishStatus(update_engine::Operation::DOWNLOADING, update_progress_);
+      ScheduleJobPoll(kAuraJobPollInterval);
+      return;
+    }
+
+    update_job_running_ = false;
+    update_job_id_.clear();
+    if (*state != "succeeded") {
+      PublishStatus(update_engine::Operation::ERROR, update_progress_);
+      return;
+    }
