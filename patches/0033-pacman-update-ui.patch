+    rollback_available_ =
+        data->FindBool("rollback_available").value_or(rollback_available_);
+    if (const std::string* snapshot = data->FindString("rollback_snapshot")) {
+      rollback_snapshot_ = *snapshot;
+    }
+    updates_available_ = false;
+    PublishStatus(update_engine::Operation::FINALIZING, 1.0);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&UpdateEngineClientAura::FinishSuccessfulUpgrade,
+                       weak_factory_.GetWeakPtr()),
+        base::Milliseconds(500));
+  }
+
+  void FinishSuccessfulUpgrade() {
+    PublishStatus(update_engine::Operation::UPDATED_NEED_REBOOT, 1.0);
+    if (rollback_available_) {
+      LOG(INFO) << "AuraDE update: rollback snapshot available at "
+                << rollback_snapshot_;
+    }
+  }
+
+  void OnRollbackEntrySelected(dbus::Response* response) {
+    if (!response) {
+      LOG(ERROR) << "AuraDE update: could not select rollback boot entry";
+      return;
+    }
+    RebootAfterUpdate();
+  }
+
+  base::ObserverList<Observer> observers_;
+  raw_ptr<dbus::ObjectProxy> host_bridge_proxy_ = nullptr;
+  raw_ptr<dbus::ObjectProxy> login_manager_proxy_ = nullptr;
+  update_engine::StatusResult last_status_;
+  std::string current_channel_ = "stable-channel";
+  std::string target_channel_ = "stable-channel";
+  std::string update_version_;
+  std::string update_job_id_;
+  std::string rollback_snapshot_;
+  bool check_in_flight_ = false;
+  bool update_job_running_ = false;
+  bool updates_available_ = false;
+  bool rollback_available_ = false;
+  double update_progress_ = 0.0;
+  base::OneShotTimer initial_update_timer_;
+  base::RepeatingTimer periodic_update_timer_;
+  base::WeakPtrFactory<UpdateEngineClientAura> weak_factory_{this};
+};
