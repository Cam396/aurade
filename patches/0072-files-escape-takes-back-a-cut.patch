+
+  /**
+   * AuraDE: Escape takes back a cut.
+   *
+   * Cutting dims the files and leaves them dimmed, which is the point of it,
+   * but the only ways out were to paste them somewhere or to copy something
+   * else. Changing your mind is the commonest thing a person does after a cut
+   * and there was no way at all to say so, which left the files sitting there
+   * half faded, describing a move that was never going to happen.
+   *
+   * The clipboard is emptied as well as the marks. Clearing only the dimming
+   * would leave a paste still able to move the files, so the screen would say
+   * one thing while Ctrl+V did another, and that is worse than either on its
+   * own. See auraDeForgetClipboardCut_ for why that is not done the way the
+   * rest of this file does it.
+   *
+   * Nothing is preventDefault'd and nothing is announced. When there was no
+   * cut this returns before doing anything and Escape goes on to mean whatever
+   * it already meant, and when there was one, the dimming disappearing is the
+   * acknowledgement. A toast on top of that would be telling someone what they
+   * just watched happen.
+   */
+  private auraDeOnKeyDown_(event: KeyboardEvent) {
+    if (event.key !== 'Escape' || event.ctrlKey || event.altKey ||
+        event.metaKey || event.shiftKey) {
+      return;
+    }
+    // The same guard the cut itself uses, so Escape in the rename box or in
+    // the search field still means cancel this edit and nothing else.
+    if (!this.isDocumentWideEvent_()) {
+      return;
+    }
+    if (!auraDeClearCut()) {
+      return;
+    }
+    this.auraDeRedrawForCutMarks_();
+    this.auraDeForgetClipboardCut_();
+  }
+
+  /**
+   * AuraDE: empty the system clipboard, but only if it is still holding the
+   * cut that was just taken back.
+   *
+   * Not simulateCommand_('cut', ...) with an fs/clear payload, which is what
+   * onPaste_ does a few methods down and is the obvious thing to copy. That
+   * does nothing here and, as far as this can tell, nothing there either:
+   * execCommand('cut') on the dispatcher iframe returns false and fires no cut
+   * event at all, so the handler that would write the payload never runs.
+   * Measured on the hardware after this shipped once relying on it. Making the
+   * iframe contentEditable and giving it a selection does not help; the
+   * command is simply not permitted in this document. It goes unnoticed in
+   * onPaste_ because by the time it runs the files have already been moved, so
+   * a clipboard still describing them is harmless.
+   *
+   * The async clipboard writes for real, which is the same conclusion this
+   * codebase reached about copy.
+   *
+   * Guarded on the clipboard still being ours, because a person who cut in
+   * Files and then copied something in another application would otherwise
+   * lose that when they pressed Escape here. Only the Files app's own copy
+   * clears the marks, so this is a state that can be reached. Escape means
+   * never mind about the cut, and it should cost nothing else.
+   */
+  private auraDeForgetClipboardCut_() {
+    let holdsOurCut = false;
+    this.simulateCommand_('paste', (clipboardEvent: Event) => {
+      const clipboardData = getClipboardData(clipboardEvent as ClipboardEvent);
+      holdsOurCut = !!clipboardData && !!clipboardData.getData('fs/sources') &&
+          clipboardData.getData('fs/effectallowed') === 'move';
+    });
+    if (!holdsOurCut) {
+      return;
+    }
+    navigator.clipboard.writeText('').catch((error: any) => {
+      console.warn('AuraDE: could not empty the clipboard: ' + error);
+    });
   }
 
