index 000000000000..142ebe1c977b
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/session/navigation_session.ts
@@ -0,0 +1,195 @@
+/**
+ * One browsing context: a tab, or one side of a split.
+ *
+ * This exists because `DirectoryModel` owns exactly one current directory, one
+ * selection model and one watcher, and subscribes to a single store. Tabs and
+ * split panes are therefore a data model change rather than a component, and
+ * building them as components would work perfectly against a mock and then come
+ * apart against production. Each session owns its own listing, selection,
+ * search, cancellation and watcher lifetime.
+ */
+import type {FilesBackendPort} from '../port/port.js';
+import type {ChangeEvent, EntryDto, FileKey} from '../port/types.js';
+import {FilesError} from '../port/types.js';
+
+export interface SessionState {
+  readonly current: FileKey|null;
+  readonly entries: readonly EntryDto[];
+  readonly revision: number;
+  readonly loading: boolean;
+  readonly error: FilesError|null;
+  readonly selection: ReadonlySet<FileKey>;
+}
+
+type Listener = (state: SessionState) => void;
+
+export class NavigationSession {
+  private current: FileKey|null = null;
+  private entries: EntryDto[] = [];
+  private revision = 0;
+  private loading = false;
+  private error: FilesError|null = null;
+  private selection = new Set<FileKey>();
+  private anchor: FileKey|null = null;
+  private controller: AbortController|null = null;
+  private readonly listeners = new Set<Listener>();
+
+  constructor(readonly id: string, private readonly port: FilesBackendPort) {}
+
+  subscribe(listener: Listener): () => void {
+    this.listeners.add(listener);
+    listener(this.snapshot());
+    return () => this.listeners.delete(listener);
+  }
+
+  snapshot(): SessionState {
+    return {
+      current: this.current,
+      entries: this.entries.slice(),
+      revision: this.revision,
+      loading: this.loading,
+      error: this.error,
+      selection: new Set(this.selection),
+    };
+  }
+
+  private publish(): void {
+    const state = this.snapshot();
+    for (const listener of this.listeners) {
+      listener(state);
+    }
+  }
+
+  /**
+   * Watching starts before the listing and the buffered events are replayed
+   * afterwards.
+   *
+   * Listing first and then watching drops every change that lands in between,
+   * which is a directory that silently shows a state it was never in. The
+   * revision on each event is what says whether it is already reflected in what
+   * the listing returned.
+   */
+  async navigate(key: FileKey): Promise<void> {
+    this.controller?.abort();
+    const controller = new AbortController();
+    this.controller = controller;
+
+    this.current = key;
+    this.entries = [];
+    this.selection.clear();
+    this.anchor = null;
+    this.loading = true;
+    this.error = null;
+    this.publish();
+
+    const buffered: ChangeEvent[] = [];
+    let listed = false;
+    const pump = (async () => {
+      try {
+        for await (const event of this.port.watch(key, controller.signal)) {
+          if (listed) {
+            this.applyChange(event);
+            this.publish();
+          } else {
+            buffered.push(event);
+          }
+        }
+      } catch {
+        // A watch that cannot start is not a reason to show nothing; the
+        // listing below still stands, it simply will not update itself.
+      }
+    })();
+    void pump;
+
+    try {
+      for await (const page of this.port.list(key, {signal: controller.signal})) {
+        if (controller.signal.aborted) {
+          return;
+        }
+        this.revision = page.revision;
+        this.entries.push(...page.entries);
+        this.publish();
+      }
+      listed = true;
+      for (const event of buffered) {
+        if (event.revision > this.revision) {
+          this.applyChange(event);
+        }
+      }
+      this.loading = false;
+      this.publish();
+    } catch (error) {
+      if (controller.signal.aborted) {
+        return;
+      }
+      this.loading = false;
+      this.error = error instanceof FilesError ?
+          error :
+          new FilesError('io', 'That folder could not be opened.');
+      this.publish();
+    }
+  }
+
+  private applyChange(event: ChangeEvent): void {
+    this.revision = event.revision;
+    switch (event.kind) {
+      case 'added':
+        for (const entry of event.entries) {
+          if (!this.entries.some(e => e.key === entry.key)) {
+            this.entries.push(entry);
+          }
+        }
+        break;
+      case 'removed': {
+        const gone = new Set(event.keys);
+        this.entries = this.entries.filter(e => !gone.has(e.key));
+        // A selection that keeps naming something that is no longer there is
+        // how an operation later runs against nothing.
+        for (const key of gone) {
+          this.selection.delete(key);
+        }
+        break;
+      }
+      case 'changed':
+        break;
+      case 'gone':
+        this.entries = [];
+        this.selection.clear();
+        this.error = new FilesError('not-found', 'This folder is no longer there.');
+        break;
+    }
+  }
+
+  select(key: FileKey, mode: 'replace'|'toggle'|'range' = 'replace'): void {
+    if (mode === 'replace') {
+      this.selection = new Set([key]);
+      this.anchor = key;
+    } else if (mode === 'toggle') {
+      if (!this.selection.delete(key)) {
+        this.selection.add(key);
+      }
+      this.anchor = key;
+    } else {
+      // Ranges are resolved over indices rather than by walking rendered rows,
+      // because at a hundred thousand entries only a handful exist in the DOM.
+      const from = this.anchor ? this.indexOf(this.anchor) : 0;
+      const to = this.indexOf(key);
+      if (from >= 0 && to >= 0) {
+        const [lo, hi] = from <= to ? [from, to] : [to, from];
+        this.selection = new Set(
+            this.entries.slice(lo, hi + 1).map(entry => entry.key));
+      }
+    }
+    this.publish();
+  }
+
+  private indexOf(key: FileKey): number {
+    return this.entries.findIndex(entry => entry.key === key);
+  }
+
+  dispose(): void {
+    this.controller?.abort();
+    this.controller = null;
+    this.listeners.clear();
+  }
+}
diff --git a/ui/file_manager/file_manager/aurade/tests/contract/port_contract.ts b/ui/file_manager/file_manager/aurade/tests/contract/port_contract.ts
