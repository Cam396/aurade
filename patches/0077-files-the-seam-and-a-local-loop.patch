@@ -0,0 +1,406 @@
+/**
+ * An in memory backend, so the frontend can be built and tested without a
+ * ChromeOS session, a mount, or the Dell.
+ *
+ * This is the whole velocity argument. The greeter was built in four days
+ * because it ran headless against a mocked greetd socket and never needed the
+ * target machine to iterate. Files was slow because every check meant syncing a
+ * pak over ssh and pressing keys on a laptop.
+ *
+ * It injects latency and failure on purpose. A backend that always answers
+ * instantly and always succeeds trains a UI that cannot cope with the one that
+ * does neither.
+ */
+import type {FilesBackendPort} from './port.js';
+import type {ChangeEvent, DialogMode, EntryDto, EntryPage, FileKey, IoProgress, IoRequest, IoState, ListOptions, Metadata, MetadataField, MetadataSnapshot, TaskDescriptor, TaskId, Volume} from './types.js';
+import {asFileKey, FilesError} from './types.js';
+
+interface Node {
+  key: FileKey;
+  name: string;
+  isDirectory: boolean;
+  parent: FileKey|null;
+  children: FileKey[];
+  metadata: Metadata;
+  /** Set to make an operation touching this node fail, for failure tests. */
+  fail?: FilesError;
+}
+
+export interface MockOptions {
+  /** Milliseconds before any call answers. Zero by default so tests stay fast. */
+  latencyMs?: number;
+  /** Entries per page. Small values exercise the streaming path. */
+  pageSize?: number;
+  dialogMode?: DialogMode|null;
+}
+
+/** A queue that turns pushes into an async iterable, with abort support. */
+class Stream<T> {
+  private readonly pending: T[] = [];
+  private wake: (() => void)|null = null;
+  private closed = false;
+
+  push(value: T): void {
+    this.pending.push(value);
+    this.wake?.();
+  }
+
+  close(): void {
+    this.closed = true;
+    this.wake?.();
+  }
+
+  async * iterate(signal?: AbortSignal): AsyncIterable<T> {
+    while (true) {
+      if (signal?.aborted) {
+        return;
+      }
+      if (this.pending.length) {
+        yield this.pending.shift()!;
+        continue;
+      }
+      if (this.closed) {
+        return;
+      }
+      await new Promise<void>(resolve => {
+        this.wake = resolve;
+        signal?.addEventListener('abort', () => resolve(), {once: true});
+      });
+      this.wake = null;
+    }
+  }
+}
+
+export class MockBackend implements FilesBackendPort {
+  private readonly nodes = new Map<FileKey, Node>();
+  private readonly volumeList: Volume[] = [];
+  /**
+   * One revision per directory. `list` reports the revision it read at and
+   * `watch` stamps every change with the revision it produced, which is what
+   * lets a caller tell that it missed nothing between the two.
+   */
+  private readonly revisions = new Map<FileKey, number>();
+  private readonly watchers = new Map<FileKey, Set<Stream<ChangeEvent>>>();
+  private readonly ioStreams = new Set<Stream<IoProgress>>();
+  private readonly cancelled = new Set<TaskId>();
+  private nextTask = 1;
+  private options: Required<Omit<MockOptions, 'dialogMode'>>&
+      {dialogMode: DialogMode|null};
+
+  constructor(options: MockOptions = {}) {
+    this.options = {
+      latencyMs: options.latencyMs ?? 0,
+      pageSize: options.pageSize ?? 200,
+      dialogMode: options.dialogMode ?? null,
+    };
+  }
+
+  // ---- test construction -------------------------------------------------
+
+  addVolume(volume: Volume): this {
+    this.volumeList.push(volume);
+    if (!this.nodes.has(volume.root)) {
+      this.put({
+        key: volume.root,
+        name: volume.label,
+        isDirectory: true,
+        parent: null,
+        children: [],
+        metadata: {},
+      });
+    }
+    return this;
+  }
+
+  /** Adds an entry and notifies watchers of its parent, as a real change would. */
+  add(parent: FileKey, name: string, isDirectory: boolean,
+      metadata: Metadata = {}): FileKey {
+    const key = asFileKey(`${parent}/${name}`);
+    const node: Node = {key, name, isDirectory, parent, children: [], metadata};
+    this.put(node);
+    const parentNode = this.nodes.get(parent);
+    if (parentNode && !parentNode.children.includes(key)) {
+      parentNode.children.push(key);
+    }
+    const revision = this.bump(parent);
+    this.emit(parent, {kind: 'added', revision, entries: [toDto(node)]});
+    return key;
+  }
+
+  remove(key: FileKey): void {
+    const node = this.nodes.get(key);
+    if (!node) {
+      return;
+    }
+    const parent = node.parent;
+    this.nodes.delete(key);
+    if (parent) {
+      const parentNode = this.nodes.get(parent);
+      if (parentNode) {
+        parentNode.children = parentNode.children.filter(c => c !== key);
+      }
+      const revision = this.bump(parent);
+      this.emit(parent, {kind: 'removed', revision, keys: [key]});
+    }
+  }
+
+  /** Makes any operation touching this entry fail, for failure path tests. */
+  setFailure(key: FileKey, error: FilesError|undefined): void {
+    const node = this.nodes.get(key);
+    if (node) {
+      node.fail = error;
+    }
+  }
+
+  setLatency(ms: number): void {
+    this.options.latencyMs = ms;
+  }
+
+  private put(node: Node): void {
+    this.nodes.set(node.key, node);
+    if (node.isDirectory && !this.revisions.has(node.key)) {
+      this.revisions.set(node.key, 1);
+    }
+  }
+
+  private bump(key: FileKey): number {
+    const next = (this.revisions.get(key) ?? 1) + 1;
+    this.revisions.set(key, next);
+    return next;
+  }
+
+  private emit(key: FileKey, event: ChangeEvent): void {
+    for (const stream of this.watchers.get(key) ?? []) {
+      stream.push(event);
+    }
+  }
+
+  /**
+   * Always yields, even at zero latency.
+   *
+   * Returning synchronously made a copy of three files finish before its own
+   * caller got the task id back, so nothing could observe it running and
+   * cancellation was untestable. Nothing in the real backend is synchronous,
+   * and a mock that completes instantly trains a UI that never sees an
+   * intermediate state.
+   */
+  private async settle(): Promise<void> {
+    await new Promise(resolve => setTimeout(resolve, this.options.latencyMs));
+  }
+
+  private require(key: FileKey): Node {
+    const node = this.nodes.get(key);
+    if (!node) {
+      throw new FilesError('not-found', `There is no entry at ${key}.`);
+    }
+    if (node.fail) {
+      throw node.fail;
+    }
+    return node;
+  }
+
+  // ---- FilesBackendPort --------------------------------------------------
+
+  async * list(key: FileKey, options: ListOptions = {}):
+      AsyncIterable<EntryPage> {
+    await this.settle();
+    const node = this.require(key);
+    if (!node.isDirectory) {
+      throw new FilesError('unsupported', `${node.name} is not a folder.`);
+    }
+    const revision = this.revisions.get(key) ?? 1;
+    const size = options.pageSize ?? this.options.pageSize;
+    const all = node.children.map(child => this.nodes.get(child))
+                    .filter((n): n is Node => !!n)
+                    .filter(n => options.showHidden || !n.name.startsWith('.'))
+                    .map(toDto);
+    for (let i = 0; i < all.length || i === 0; i += size) {
+      if (options.signal?.aborted) {
+        return;
+      }
+      const slice = all.slice(i, i + size);
+      yield {revision, entries: slice, done: i + size >= all.length};
+      if (i + size >= all.length) {
+        return;
+      }
+      // Between pages, not just before the first. A listing that arrives all at
+      // once leaves no window for a change to race it, which is the window the
+      // session's buffered replay exists to close.
+      await this.settle();
+    }
+  }
+
+  async metadata(keys: readonly FileKey[], fields: readonly MetadataField[]):
+      Promise<MetadataSnapshot> {
+    await this.settle();
+    const out = new Map<FileKey, Metadata>();
+    for (const key of keys) {
+      const node = this.nodes.get(key);
+      if (!node) {
+        continue;
+      }
+      const picked: Record<string, unknown> = {};
+      for (const field of fields) {
+        if (field in node.metadata) {
+          picked[field] = (node.metadata as Record<string, unknown>)[field];
+        }
+      }
+      out.set(key, picked as Metadata);
+    }
+    return out;
+  }
+
+  async * watch(key: FileKey, signal?: AbortSignal): AsyncIterable<ChangeEvent> {
+    const stream = new Stream<ChangeEvent>();
+    let set = this.watchers.get(key);
+    if (!set) {
+      set = new Set();
+      this.watchers.set(key, set);
+    }
+    set.add(stream);
+    try {
+      yield* stream.iterate(signal);
+    } finally {
+      set.delete(stream);
+    }
+  }
+
+  async volumes(): Promise<readonly Volume[]> {
+    await this.settle();
+    return this.volumeList.slice();
+  }
+
+  async * search(query: string, scope: FileKey, options: ListOptions = {}):
+      AsyncIterable<EntryPage> {
+    await this.settle();
+    const needle = query.toLowerCase();
+    const found: EntryDto[] = [];
+    const walk = (key: FileKey) => {
+      const node = this.nodes.get(key);
+      if (!node) {
+        return;
+      }
+      if (node.key !== scope && node.name.toLowerCase().includes(needle)) {
+        found.push(toDto(node));
+      }
+      node.children.forEach(walk);
+    };
+    walk(scope);
+    const revision = this.revisions.get(scope) ?? 1;
+    const size = options.pageSize ?? this.options.pageSize;
+    for (let i = 0; i < found.length || i === 0; i += size) {
+      if (options.signal?.aborted) {
+        return;
+      }
+      yield {
+        revision,
+        entries: found.slice(i, i + size),
+        done: i + size >= found.length,
+      };
+      if (i + size >= found.length) {
+        return;
+      }
+    }
+  }
+
+  async tasks(keys: readonly FileKey[]): Promise<readonly TaskDescriptor[]> {
+    await this.settle();
+    if (!keys.length) {
+      return [];
+    }
+    return [
+      {id: 'mock-view', title: 'Preview', isDefault: true, isDlpBlocked: false},
+      {id: 'mock-edit', title: 'Edit', isDefault: false, isDlpBlocked: false},
+    ];
+  }
+
+  async executeTask(taskId: string, keys: readonly FileKey[]): Promise<void> {
+    await this.settle();
+    for (const key of keys) {
+      this.require(key);
+    }
+  }
+
+  async startIo(request: IoRequest): Promise<TaskId> {
+    const taskId = `task-${this.nextTask++}` as TaskId;
+    // Deliberately not awaited. The point of this model is that the operation
+    // outlives the call, and the window, the way the real one does.
+    void this.runIo(taskId, request);
+    return taskId;
+  }
+
+  private async runIo(taskId: TaskId, request: IoRequest): Promise<void> {
+    const total = request.sources.length;
+    const report = (state: IoState, processed: number, error?: FilesError) => {
+      const progress: IoProgress = {
+        taskId,
+        kind: request.kind,
+        state,
+        processed,
+        total,
+        error,
+      };
+      for (const stream of this.ioStreams) {
+        stream.push(progress);
+      }
+    };
+    report('queued', 0);
+    for (let i = 0; i < total; i++) {
+      await this.settle();
+      if (this.cancelled.has(taskId)) {
+        report('cancelled', i);
+        return;
+      }
+      const node = this.nodes.get(request.sources[i]!);
+      if (!node) {
+        report('failed', i, new FilesError('not-found', 'It is no longer there.'));
+        return;
+      }
+      if (node.fail) {
+        report('failed', i, node.fail);
+        return;
+      }
+      report('running', i + 1);
+    }
+    report('succeeded', total);
+  }
+
+  async * subscribeIo(signal?: AbortSignal): AsyncIterable<IoProgress> {
+    const stream = new Stream<IoProgress>();
+    this.ioStreams.add(stream);
+    try {
+      yield* stream.iterate(signal);
+    } finally {
+      this.ioStreams.delete(stream);
+    }
+  }
+
+  async cancelIo(taskId: TaskId): Promise<void> {
+    this.cancelled.add(taskId);
+  }
+
+  async dialogMode(): Promise<DialogMode|null> {
+    await this.settle();
+    return this.options.dialogMode;
+  }
+
+  async confirmDialog(keys: readonly FileKey[]): Promise<void> {
+    await this.settle();
+    for (const key of keys) {
+      this.require(key);
+    }
+  }
+
+  async cancelDialog(): Promise<void> {
+    await this.settle();
+  }
+}
+
+function toDto(node: Node): EntryDto {
+  return {
+    key: node.key,
+    name: node.name,
+    isDirectory: node.isDirectory,
+    parent: node.parent,
+  };
+}
