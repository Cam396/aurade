@@ -0,0 +1,349 @@
+/**
+ * The contract every backend must satisfy, mock and real alike.
+ *
+ * Parameterised by a factory rather than written against the mock, because a
+ * suite that only exercises the mock proves the mock agrees with itself. The
+ * same file runs against ChromeBackend, and a difference between them is a bug
+ * in whichever one is lying.
+ */
+import type {FilesBackendPort} from '../../port/port.js';
+import type {ChangeEvent, EntryDto, FileKey, IoProgress, Volume} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+
+export interface Fixture {
+  port: FilesBackendPort;
+  root: FileKey;
+  /** Adds an entry out of band, the way another process would. */
+  add(parent: FileKey, name: string, isDirectory: boolean): FileKey;
+  remove(key: FileKey): void;
+  failWith(key: FileKey, error: FilesError): void;
+}
+
+export interface Case {
+  name: string;
+  run(fixture: Fixture): Promise<void>;
+}
+
+class AssertionError extends Error {}
+
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(`${message}: expected ${expected}, got ${actual}`);
+  }
+}
+
+async function collect(pages: AsyncIterable<{entries: readonly EntryDto[]}>):
+    Promise<EntryDto[]> {
+  const out: EntryDto[] = [];
+  for await (const page of pages) {
+    out.push(...page.entries);
+  }
+  return out;
+}
+
+async function rejects(
+    body: () => Promise<unknown>, code: string, message: string):
+    Promise<void> {
+  try {
+    await body();
+  } catch (error) {
+    assert(error instanceof FilesError, `${message}: not a FilesError`);
+    equal(error.code, code, message);
+    return;
+  }
+  throw new AssertionError(`${message}: nothing was thrown`);
+}
+
+export const CASES: Case[] = [
+  {
+    name: 'lists the entries in a directory',
+    async run({port, root, add}) {
+      add(root, 'alpha.txt', false);
+      add(root, 'beta', true);
+      const entries = await collect(port.list(root));
+      equal(entries.length, 2, 'entry count');
+      assert(entries.some(e => e.name === 'alpha.txt'), 'alpha.txt is listed');
+      assert(
+          entries.find(e => e.name === 'beta')!.isDirectory,
+          'beta is a directory');
+    },
+  },
+  {
+    name: 'pages a long listing and marks only the last page done',
+    async run({port, root, add}) {
+      for (let i = 0; i < 25; i++) {
+        add(root, `file-${i}.txt`, false);
+      }
+      const dones: boolean[] = [];
+      let total = 0;
+      for await (const page of port.list(root, {pageSize: 10})) {
+        dones.push(page.done);
+        total += page.entries.length;
+      }
+      equal(total, 25, 'entries across all pages');
+      equal(dones.filter(d => d).length, 1, 'exactly one page marked done');
+      equal(dones[dones.length - 1], true, 'the last page is the one marked');
+    },
+  },
+  {
+    name: 'hides dotfiles unless asked',
+    async run({port, root, add}) {
+      add(root, 'visible.txt', false);
+      add(root, '.hidden', false);
+      equal((await collect(port.list(root))).length, 1, 'hidden by default');
+      equal(
+          (await collect(port.list(root, {showHidden: true}))).length, 2,
+          'shown when asked');
+    },
+  },
+  {
+    name: 'stops listing when the caller aborts',
+    async run({port, root, add}) {
+      for (let i = 0; i < 50; i++) {
+        add(root, `f${i}`, false);
+      }
+      const controller = new AbortController();
+      let pages = 0;
+      for await (const _page of port.list(
+                   root, {pageSize: 5, signal: controller.signal})) {
+        pages++;
+        controller.abort();
+      }
+      equal(pages, 1, 'iteration stopped after the abort');
+    },
+  },
+  {
+    name: 'reports not-found for an entry that is not there',
+    async run({port}) {
+      await rejects(
+          () => collect(port.list(asFileKey('nowhere'))), 'not-found',
+          'listing a missing directory');
+    },
+  },
+  {
+    name: 'refuses to list something that is not a directory',
+    async run({port, root, add}) {
+      const file = add(root, 'plain.txt', false);
+      await rejects(
+          () => collect(port.list(file)), 'unsupported', 'listing a file');
+    },
+  },
+  {
+    name: 'returns metadata in one batch, limited to the fields asked for',
+    async run({port, root, add}) {
+      const a = add(root, 'a.txt', false);
+      const b = add(root, 'b.txt', false);
+      const snapshot = await port.metadata([a, b], ['size']);
+      equal(snapshot.size, 2, 'one entry per key');
+      assert(!('mimeType' in (snapshot.get(a) ?? {})), 'unrequested field absent');
+    },
+  },
+  {
+    name: 'watch reports an addition made after the listing',
+    async run({port, root, add}) {
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(root, controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await Promise.resolve();
+      add(root, 'late.txt', false);
+      await pump;
+      controller.abort();
+      equal(seen.length, 1, 'one change observed');
+      equal(seen[0]!.kind, 'added', 'the change is an addition');
+    },
+  },
+  {
+    name: 'the revision advances between a listing and a later change',
+    async run({port, root, add}) {
+      add(root, 'first.txt', false);
+      let listed = -1;
+      for await (const page of port.list(root)) {
+        listed = page.revision;
+      }
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(root, controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await Promise.resolve();
+      add(root, 'second.txt', false);
+      await pump;
+      controller.abort();
+      assert(
+          seen[0]!.revision > listed,
+          `change revision ${seen[0]!.revision} must exceed listed ${listed}`);
+    },
+  },
+  {
+    name: 'watch reports a removal',
+    async run({port, root, add, remove}) {
+      const doomed = add(root, 'doomed.txt', false);
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(root, controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await Promise.resolve();
+      remove(doomed);
+      await pump;
+      controller.abort();
+      equal(seen[0]!.kind, 'removed', 'the change is a removal');
+    },
+  },
+  {
+    name: 'search finds an entry nested below the scope',
+    async run({port, root, add}) {
+      const deep = add(root, 'deep', true);
+      add(deep, 'needle.txt', false);
+      add(root, 'unrelated.txt', false);
+      const found = await collect(port.search('needle', root));
+      equal(found.length, 1, 'one match');
+      equal(found[0]!.name, 'needle.txt', 'the right match');
+    },
+  },
+  {
+    name: 'offers tasks for a selection and runs one',
+    async run({port, root, add}) {
+      const file = add(root, 'openable.txt', false);
+      const tasks = await port.tasks([file]);
+      assert(tasks.length > 0, 'at least one task offered');
+      assert(tasks.some(t => t.isDefault), 'one task is the default');
+      await port.executeTask(tasks[0]!.id, [file]);
+    },
+  },
+  {
+    name: 'an io operation runs to completion and reports progress',
+    async run({port, root, add}) {
+      const file = add(root, 'copied.txt', false);
+      const controller = new AbortController();
+      const seen: IoProgress[] = [];
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          seen.push(progress);
+          if (progress.state === 'succeeded' || progress.state === 'failed') {
+            break;
+          }
+        }
+      })();
+      await port.startIo({kind: 'copy', sources: [file], destination: root});
+      await pump;
+      controller.abort();
+      equal(seen[seen.length - 1]!.state, 'succeeded', 'final state');
+      assert(seen.some(p => p.state === 'queued'), 'reported being queued');
+    },
+  },
+  {
+    name: 'an io failure arrives as a typed error, not a string',
+    async run({port, root, add, failWith}) {
+      const file = add(root, 'busy.txt', false);
+      failWith(file, new FilesError(
+                         'busy', 'It is open somewhere else.',
+                         {pid: 4012, name: 'celluloid'}));
+      const controller = new AbortController();
+      let last: IoProgress|null = null;
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          last = progress;
+          if (progress.state === 'failed' || progress.state === 'succeeded') {
+            break;
+          }
+        }
+      })();
+      await port.startIo({kind: 'move', sources: [file], destination: root});
+      await pump;
+      controller.abort();
+      equal(last!.state, 'failed', 'the operation failed');
+      equal(last!.error!.code, 'busy', 'the error is typed');
+      equal(last!.error!.holder!.name, 'celluloid', 'the holder is named');
+    },
+  },
+  {
+    name: 'a cancelled io operation stops and says it was cancelled',
+    async run({port, root, add}) {
+      const files = [add(root, 'x', false), add(root, 'y', false),
+                     add(root, 'z', false)];
+      const controller = new AbortController();
+      let last: IoProgress|null = null;
+      const taskIdHolder: {id?: string} = {};
+      const pump = (async () => {
+        for await (const progress of port.subscribeIo(controller.signal)) {
+          last = progress;
+          if (progress.state === 'running' && taskIdHolder.id) {
+            await port.cancelIo(progress.taskId);
+          }
+          if (progress.state === 'cancelled' || progress.state === 'succeeded') {
+            break;
+          }
+        }
+      })();
+      taskIdHolder.id =
+          await port.startIo({kind: 'copy', sources: files, destination: root});
+      await pump;
+      controller.abort();
+      equal(last!.state, 'cancelled', 'the operation reported cancellation');
+    },
+  },
+  {
+    name: 'volumes are reported with their capacity and removability',
+    async run({port}) {
+      const volumes: readonly Volume[] = await port.volumes();
+      assert(volumes.length > 0, 'at least one volume');
+      const system = volumes.find(v => v.kind === 'system');
+      assert(!!system, 'a system volume exists');
+      assert(!system!.removable, 'the system volume is not removable');
+    },
+  },
+  {
+    name: 'reports no dialog mode when not launched as a picker',
+    async run({port}) {
+      equal(await port.dialogMode(), null, 'dialog mode');
+    },
+  },
+];
+
+export interface Result {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+export async function runContract(
+    label: string, makeFixture: () => Promise<Fixture>|Fixture):
+    Promise<Result[]> {
+  const results: Result[] = [];
+  for (const testCase of CASES) {
+    try {
+      await testCase.run(await makeFixture());
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  const failed = results.filter(r => !r.ok);
+  console.log(`${label}: ${results.length - failed.length}/${results.length} passed`);
+  for (const result of failed) {
+    console.log(`  FAIL ${result.name}\n       ${result.error}`);
+  }
+  return results;
+}
