@@ -0,0 +1,58 @@
+/**
+ * The boundary between the AuraDE frontend and everything we kept.
+ *
+ * This is not a second copy of application state. The Files store already
+ * holds normalised entries, volumes and the current directory, and its own
+ * README forbids it depending on the UI layer, so the store sits above this and
+ * the components sit above that. What lives here is external capability and
+ * effect: the things only the browser process can do.
+ *
+ * Two implementations, one contract suite run against both. A suite that only
+ * exercises the mock proves the mock agrees with itself.
+ */
+import type {ChangeEvent, DialogMode, EntryPage, FileKey, IoProgress, IoRequest, ListOptions, MetadataField, MetadataSnapshot, TaskDescriptor, TaskId, Volume} from './types.js';
+
+export interface FilesBackendPort {
+  /** Streamed and cancellable; a directory of 100,000 entries is normal. */
+  list(key: FileKey, options?: ListOptions): AsyncIterable<EntryPage>;
+
+  /** Always batched. There is deliberately no per file variant. */
+  metadata(keys: readonly FileKey[], fields: readonly MetadataField[]):
+      Promise<MetadataSnapshot>;
+
+  /** Revisions align with `list`, so no change is lost between the two. */
+  watch(key: FileKey, signal?: AbortSignal): AsyncIterable<ChangeEvent>;
+
+  volumes(): Promise<readonly Volume[]>;
+
+  search(query: string, scope: FileKey, options?: ListOptions):
+      AsyncIterable<EntryPage>;
+
+  /** "Open with": web apps, PWAs, Android, Crostini and internal viewers. */
+  tasks(keys: readonly FileKey[]): Promise<readonly TaskDescriptor[]>;
+  executeTask(taskId: string, keys: readonly FileKey[]): Promise<void>;
+
+  /**
+   * File operations belong to the browser process, not to this window. Start a
+   * copy and close Files and it carries on and keeps reporting to the system
+   * tray, so the UI subscribes by id and reconnects rather than holding a
+   * handle that dies with the window.
+   */
+  startIo(request: IoRequest): Promise<TaskId>;
+  subscribeIo(signal?: AbortSignal): AsyncIterable<IoProgress>;
+  cancelIo(taskId: TaskId): Promise<void>;
+
+  /** Null unless Files was launched as the system file dialog. */
+  dialogMode(): Promise<DialogMode|null>;
+  confirmDialog(keys: readonly FileKey[]): Promise<void>;
+  cancelDialog(): Promise<void>;
+}
+
+/**
+ * Deliberately absent: shred.
+ *
+ * Per file secure deletion cannot be honoured on Btrfs, on an SSD, on eMMC or
+ * under snapshots. A signature that promises it is a safety lie in the worst
+ * possible place, so the capability does not exist rather than existing and
+ * being unreliable.
+ */
