@@ -0,0 +1,157 @@
+/**
+ * The vocabulary the AuraDE frontend speaks.
+ *
+ * Everything here is a plain immutable value. Chromium `Entry` objects never
+ * reach a component: they are live handles owned by the plumbing, the list
+ * rebuilds them as rows recycle, and a component holding one is a component
+ * holding something that can change underneath it. Patch 0071 learned this the
+ * hard way and keys its cut marks by URL for the same reason.
+ */
+
+/**
+ * Identity for anything the file manager can show.
+ *
+ * Deliberately not a path. ChromeOS does not address files by POSIX path, and
+ * a string path cannot express Recent, Trash, Drive, MTP, an archive, a
+ * DocumentsProvider root or any File System Provider volume. The brand stops a
+ * raw path being passed where a key belongs.
+ */
+export type FileKey = string&{readonly __fileKey: unique symbol};
+
+export function asFileKey(value: string): FileKey {
+  return value as FileKey;
+}
+
+export type TaskId = string&{readonly __taskId: unique symbol};
+
+export interface EntryDto {
+  readonly key: FileKey;
+  readonly name: string;
+  readonly isDirectory: boolean;
+  readonly parent: FileKey|null;
+}
+
+/**
+ * Metadata is separate from the entry and always fetched in batches.
+ *
+ * ChromeOS resolves these through several asynchronous providers, including
+ * Drive sync state and enterprise data loss prevention. Asking per file across
+ * a directory of thousands is the wrong shape no matter how fast any one
+ * answer is.
+ */
+export type MetadataField = 'size'|'modificationTime'|'mimeType'|'pinned'|
+    'shared'|'availableOffline'|'restricted';
+
+export interface Metadata {
+  readonly size?: number;
+  readonly modificationTime?: number;
+  readonly mimeType?: string;
+  readonly pinned?: boolean;
+  readonly shared?: boolean;
+  readonly availableOffline?: boolean;
+  /** Blocked by policy. The UI must say so rather than silently failing. */
+  readonly restricted?: boolean;
+}
+
+export type MetadataSnapshot = ReadonlyMap<FileKey, Metadata>;
+
+export type VolumeKind = 'system'|'removable'|'archive'|'provided'|'drive'|
+    'android'|'crostini'|'mtp'|'trash'|'recent';
+
+export interface Volume {
+  readonly id: string;
+  readonly root: FileKey;
+  readonly label: string;
+  readonly kind: VolumeKind;
+  readonly removable: boolean;
+  readonly readOnly: boolean;
+  /** Null where the notion does not apply, such as Recent. */
+  readonly capacity: {readonly total: number, readonly free: number}|null;
+}
+
+/**
+ * A page of a listing, carrying the revision it was read at.
+ *
+ * The revision is shared with `watch`. Without it, `list` followed by `watch`
+ * silently drops every change that lands between the two calls, and the list
+ * shows a directory that no longer exists in that state.
+ */
+export interface EntryPage {
+  readonly revision: number;
+  readonly entries: readonly EntryDto[];
+  readonly done: boolean;
+}
+
+export interface ListOptions {
+  readonly signal?: AbortSignal;
+  readonly showHidden?: boolean;
+  readonly pageSize?: number;
+}
+
+export type ChangeEvent =
+    {readonly kind: 'added', readonly revision: number,
+     readonly entries: readonly EntryDto[]}|
+    {readonly kind: 'removed', readonly revision: number,
+     readonly keys: readonly FileKey[]}|
+    {readonly kind: 'changed', readonly revision: number,
+     readonly keys: readonly FileKey[]}|
+    /** The directory itself went away, which is not the same as being empty. */
+    {readonly kind: 'gone', readonly revision: number};
+
+export type FilesErrorCode = 'not-found'|'permission-denied'|'busy'|
+    'read-only'|'no-space'|'cancelled'|'unsupported'|'io';
+
+/**
+ * Typed, because the UI has to say something different for each of these and
+ * matching on a message string is how that stops working in another language.
+ */
+export class FilesError extends Error {
+  constructor(
+      readonly code: FilesErrorCode, message: string,
+      /** Names the holding process for `busy`, so the UI can offer to end it. */
+      readonly holder?: {readonly pid: number, readonly name: string}) {
+    super(message);
+    this.name = 'FilesError';
+  }
+}
+
+export type IoKind = 'copy'|'move'|'trash'|'restore'|'delete'|'compress'|
+    'extract';
+
+export interface IoRequest {
+  readonly kind: IoKind;
+  readonly sources: readonly FileKey[];
+  readonly destination?: FileKey;
+}
+
+export type IoState = 'queued'|'running'|'succeeded'|'failed'|'cancelled';
+
+export interface IoProgress {
+  readonly taskId: TaskId;
+  readonly kind: IoKind;
+  readonly state: IoState;
+  readonly processed: number;
+  readonly total: number;
+  readonly currentName?: string;
+  readonly error?: FilesError;
+}
+
+/** The picker contract. Files is the system file dialog and must behave as one. */
+export type DialogKind = 'open-file'|'open-multi'|'open-folder'|'open-upload'|
+    'save-as'|'save-folder';
+
+export interface DialogMode {
+  readonly kind: DialogKind;
+  readonly typeList: readonly string[];
+  /** Callers that need a real Linux path cannot be offered Drive or a provider. */
+  readonly allowedPaths: 'native'|'any';
+  readonly defaultName?: string;
+}
+
+export interface TaskDescriptor {
+  readonly id: string;
+  readonly title: string;
+  readonly iconUrl?: string;
+  readonly isDefault: boolean;
+  readonly isDlpBlocked: boolean;
+}
diff --git a/ui/file_manager/file_manager/aurade/session/navigation_session.ts b/ui/file_manager/file_manager/aurade/session/navigation_session.ts
