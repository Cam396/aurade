+<!doctype html>
+<meta charset="utf-8">
+<title>AuraDE Files harness</title>
+<link rel="stylesheet" href="../../ui/tokens.css">
+<style>
+  html, body { margin: 0; background: var(--aurade-ground); }
+  body { font: 13px system-ui, sans-serif; }
+  #stage { padding: 8px 0; }
+  .aurade-panel {
+    background: var(--aurade-panel);
+    border: 1px solid var(--aurade-line);
+    border-radius: var(--aurade-radius-panel);
+    margin: 8px;
+    padding: 4px 0;
+  }
+</style>
+<div id="stage"></div>
+<script type="module">
+  import {STORIES} from './stories.js';
+  const name = new URLSearchParams(location.search).get('story');
+  const story = STORIES.find(s => s.name === name);
+  const stage = document.getElementById('stage');
+  if (!story) {
+    stage.textContent = 'No story named ' + name;
+  } else {
+    if (story.theme) {
+      document.documentElement.dataset.auradeTheme = story.theme;
+    }
+    if (story.density) {
+      document.documentElement.dataset.auradeDensity = story.density;
+    }
+    story.render(stage);
+  }
+  // Fonts settle after first paint, and a golden taken before they do differs
+  // from one taken after by a pixel here and there on every glyph.
+  document.fonts.ready.then(() => {
+    requestAnimationFrame(() => document.documentElement.classList.add('ready'));
+  });
+</script>
