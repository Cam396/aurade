+/**
+ * Every visual state worth pinning, rendered in isolation.
+ *
+ * A golden per story is what stops a hairline moving by a pixel and nobody
+ * noticing until it is on the hardware. Each one is deterministic: a fixed
+ * clock, fixed sizes, no randomness, no network.
+ */
+import type {EntryDto, Metadata} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {createRow, updateRow} from '../../ui/file_row.js';
+
+export interface Story {
+  readonly name: string;
+  readonly width: number;
+  readonly height: number;
+  readonly theme?: 'light'|'dark';
+  readonly density?: 'compact'|'relaxed';
+  render(root: HTMLElement): void;
+}
+
+const NOW = new Date('2026-09-02T15:30:00').getTime();
+const ROOT = asFileKey('mock://myfiles');
+
+function entry(name: string, isDirectory = false): EntryDto {
+  return {key: asFileKey(`${ROOT}/${name}`), name, isDirectory, parent: ROOT};
+}
+
+interface Row {
+  entry: EntryDto;
+  metadata?: Metadata;
+  selected?: boolean;
+  cut?: boolean;
+  share?: number;
+}
+
+function panel(root: HTMLElement, rows: Row[]): void {
+  const panelEl = document.createElement('div');
+  panelEl.className = 'aurade-panel';
+  panelEl.setAttribute('role', 'listbox');
+  for (const row of rows) {
+    const element = createRow();
+    updateRow(element, {
+      entry: row.entry,
+      metadata: row.metadata,
+      selected: row.selected ?? false,
+      cut: row.cut ?? false,
+      share: row.share,
+      now: NOW,
+    });
+    panelEl.appendChild(element);
+  }
+  root.appendChild(panelEl);
+}
+
+const SAMPLE: Row[] = [
+  {
+    entry: entry('Downloads', true),
+    metadata: {modificationTime: NOW - 43 * 60_000},
+  },
+  {
+    entry: entry('holiday-in-porto.jpeg'),
+    metadata: {size: 4_713_211, modificationTime: NOW - 3 * 3_600_000},
+    share: 0.62,
+  },
+  {
+    entry: entry('linux-6.18.2-1-x86_64.pkg.tar.zst'),
+    metadata: {size: 1_884_160, modificationTime: NOW - 86_400_000},
+    share: 0.25,
+  },
+  {
+    entry: entry('navigation_session.ts'),
+    metadata: {size: 7_168, modificationTime: NOW - 26 * 86_400_000},
+    share: 0.01,
+  },
+  {
+    entry: entry('quarterly-report.pdf'),
+    metadata: {
+      size: 512_000,
+      modificationTime: new Date('2025-05-12T09:04:00').getTime(),
+    },
+    share: 0.07,
+  },
+];
+
+export const STORIES: Story[] = [
+  {
+    name: 'rows-light',
+    width: 720,
+    height: 260,
+    theme: 'light',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'rows-dark',
+    width: 720,
+    height: 260,
+    theme: 'dark',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'row-selected',
+    width: 720,
+    height: 120,
+    theme: 'dark',
+    render: root => panel(root, [
+      {...SAMPLE[0]!, selected: true},
+      SAMPLE[1]!,
+    ]),
+  },
+  {
+    name: 'row-cut',
+    width: 720,
+    height: 120,
+    theme: 'dark',
+    render: root => panel(root, [
+      {...SAMPLE[1]!, cut: true},
+      SAMPLE[2]!,
+    ]),
+  },
+  {
+    name: 'row-long-name',
+    width: 420,
+    height: 120,
+    theme: 'dark',
+    render: root => panel(root, [
+      {
+        entry: entry(
+            'a-name-that-keeps-going-well-past-what-the-column-can-hold.txt'),
+        metadata: {size: 1024, modificationTime: NOW},
+      },
+      SAMPLE[3]!,
+    ]),
+  },
+  {
+    name: 'rows-compact',
+    width: 720,
+    height: 220,
+    theme: 'dark',
+    density: 'compact',
+    render: root => panel(root, SAMPLE),
+  },
+  {
+    name: 'rows-relaxed',
+    width: 720,
+    height: 320,
+    theme: 'dark',
+    density: 'relaxed',
+    render: root => panel(root, SAMPLE),
+  },
+];
diff --git a/ui/file_manager/file_manager/aurade/tests/run.sh b/ui/file_manager/file_manager/aurade/tests/run.sh
new file mode 100755
index 000000000000..752e049a005a
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/run.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+# The local loop. No ChromeOS session, no pak, no Dell.
+#
+# One tool: tsc checks and emits. esbuild would be faster but this tree ships it
+# without its platform binary, and at this size the difference is a second. The
+# imports carry .js specifiers, so node runs the emitted tree directly with no
+# bundler in the way.
+set -uo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+AURADE="$(dirname "$HERE")"
+SRC="$(cd "$AURADE/../../../.." && pwd)"
+NODE="$SRC/third_party/node/linux/node-linux-x64/bin/node"
+TSC="$SRC/third_party/node/node_modules/typescript/bin/tsc"
+OUT="$(mktemp -d)"
+trap 'rm -rf "$OUT"' EXIT
+
+fail() { printf 'aurade port contract: %s\n' "$*" >&2; exit 1; }
+[ -x "$NODE" ] || fail "node not found at $NODE"
+[ -f "$TSC" ] || fail "tsc not found at $TSC"
+
+# skipLibCheck applies to the shipped .d.ts files only: lib.dom.d.ts refers to
+# TrustedHTML, which needs a package this tree does not put on our path. Our own
+# sources are still checked in full, and --strict stays on.
+echo "==> check and emit"
+"$NODE" "$TSC" --strict --skipLibCheck --target es2022 --module es2022 \
+  --moduleResolution bundler --lib es2022,dom \
+  --rootDir "$AURADE" --outDir "$OUT" \
+  "$AURADE"/port/*.ts "$AURADE"/session/*.ts "$AURADE"/ui/*.ts "$AURADE"/tests/contract/*.ts "$AURADE"/tests/session/*.ts \
+  "$AURADE"/tests/ui/*.ts \
+  || fail "the types do not check"
+
+printf '{"type":"module"}' > "$OUT/package.json"
+echo "==> run"
+"$NODE" "$OUT/tests/contract/run_mock.js" || fail "the contract did not pass"
+echo "aurade port contract: PASS"
diff --git a/ui/file_manager/file_manager/aurade/tests/session/session_test.ts b/ui/file_manager/file_manager/aurade/tests/session/session_test.ts
new file mode 100644
index 000000000000..1ad1af452540
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/session/session_test.ts
@@ -0,0 +1,194 @@
+/** Tests for the per pane browsing context. */
+import type {MockOptions} from '../../port/mock_backend.js';
+import {MockBackend} from '../../port/mock_backend.js';
+import type {FileKey} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {NavigationSession} from '../../session/navigation_session.js';
+
+const ROOT = asFileKey('mock://myfiles');
+
+function backendWithRoot(options: MockOptions = {}): MockBackend {
+  const backend = new MockBackend(options);
+  backend.addVolume({
+    id: 'system',
+    root: ROOT,
+    label: 'My files',
+    kind: 'system',
+    removable: false,
+    readOnly: false,
+    capacity: {total: 512e9, free: 8.7e9},
+  });
+  return backend;
+}
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(`${message}: expected ${expected}, got ${actual}`);
+  }
+}
+
+interface Case {
+  name: string;
+  run(): Promise<void>;
+}
+
+const CASES: Case[] = [
+  {
+    name: 'navigating populates the pane and clears loading',
+    async run() {
+      const backend = backendWithRoot();
+      backend.add(ROOT, 'one.txt', false);
+      backend.add(ROOT, 'two.txt', false);
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(ROOT);
+      const state = session.snapshot();
+      equal(state.entries.length, 2, 'entry count');
+      equal(state.loading, false, 'loading finished');
+      equal(state.error, null, 'no error');
+      session.dispose();
+    },
+  },
+  {
+    name: 'a change that lands during the listing is not lost',
+    async run() {
+      // The whole reason watching starts before listing.
+      //
+      // The entry has to appear after the listing has snapshotted the
+      // directory, or the listing simply contains it and the assertion is
+      // answered by the wrong thing. One entry per page plus latency gives a
+      // real window: the addition lands between pages, so it cannot be in the
+      // listing and only the buffered replay can deliver it.
+      const backend = backendWithRoot({pageSize: 1, latencyMs: 5});
+      for (let i = 0; i < 3; i++) {
+        backend.add(ROOT, `pre${i}.txt`, false);
+      }
+      const session = new NavigationSession('pane-a', backend);
+      let injected = false;
+      const stop = session.subscribe(state => {
+        if (!injected && state.entries.length === 1) {
+          injected = true;
+          backend.add(ROOT, 'during.txt', false);
+        }
+      });
+      await session.navigate(ROOT);
+      stop();
+      assert(injected, 'the test never reached the window it meant to test');
+      const names = session.snapshot().entries.map(e => e.name);
+      assert(
+          names.includes('during.txt'),
+          `the entry added mid listing is missing: ${names.join(', ')}`);
+      session.dispose();
+    },
+  },
+  {
+    name: 'navigating again abandons the first listing',
+    async run() {
+      const backend = backendWithRoot();
+      const other = backend.add(ROOT, 'other', true) as FileKey;
+      backend.add(ROOT, 'root-file.txt', false);
+      backend.add(other, 'inner.txt', false);
+      backend.setLatency(15);
+      const session = new NavigationSession('pane-a', backend);
+      const first = session.navigate(ROOT);
+      await new Promise(resolve => setTimeout(resolve, 3));
+      backend.setLatency(0);
+      await session.navigate(other);
+      await first;
+      const state = session.snapshot();
+      equal(state.current, other, 'the pane is on the second directory');
+      const names = state.entries.map(e => e.name);
+      assert(
+          !names.includes('root-file.txt'),
+          `the abandoned listing bled through: ${names.join(', ')}`);
+      session.dispose();
+    },
+  },
+  {
+    name: 'two panes hold independent selections',
+    async run() {
+      const backend = backendWithRoot();
+      const a = backend.add(ROOT, 'a.txt', false);
+      backend.add(ROOT, 'b.txt', false);
+      const left = new NavigationSession('left', backend);
+      const right = new NavigationSession('right', backend);
+      await left.navigate(ROOT);
+      await right.navigate(ROOT);
+      left.select(a);
+      equal(left.snapshot().selection.size, 1, 'left has a selection');
+      equal(right.snapshot().selection.size, 0, 'right is untouched');
+      left.dispose();
+      right.dispose();
+    },
+  },
+  {
+    name: 'a range selection is resolved over indices',
+    async run() {
+      const backend = backendWithRoot();
+      const keys: FileKey[] = [];
+      for (let i = 0; i < 10; i++) {
+        keys.push(backend.add(ROOT, `f${i}.txt`, false));
+      }
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(ROOT);
+      session.select(keys[2]!);
+      session.select(keys[6]!, 'range');
+      equal(session.snapshot().selection.size, 5, 'inclusive range of five');
+      session.dispose();
+    },
+  },
+  {
+    name: 'a removed entry drops out of the selection',
+    async run() {
+      const backend = backendWithRoot();
+      const doomed = backend.add(ROOT, 'doomed.txt', false);
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(ROOT);
+      session.select(doomed);
+      equal(session.snapshot().selection.size, 1, 'selected to begin with');
+      backend.remove(doomed);
+      await new Promise(resolve => setTimeout(resolve, 5));
+      equal(session.snapshot().selection.size, 0, 'selection dropped it');
+      assert(
+          !session.snapshot().entries.some(e => e.key === doomed),
+          'the row is gone too');
+      session.dispose();
+    },
+  },
+  {
+    name: 'opening something that is not there reports it rather than hanging',
+    async run() {
+      const backend = backendWithRoot();
+      const session = new NavigationSession('pane-a', backend);
+      await session.navigate(asFileKey('mock://nowhere'));
+      const state = session.snapshot();
+      equal(state.loading, false, 'loading finished');
+      assert(!!state.error, 'an error is reported');
+      equal(state.error!.code, 'not-found', 'the error is typed');
+      session.dispose();
+    },
+  },
+];
+
+export async function runSessionTests(): Promise<boolean> {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const testCase of CASES) {
+    try {
+      await testCase.run();
+      passed++;
+    } catch (error) {
+      failures.push(
+          `  FAIL ${testCase.name}\n       ${
+              error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`NavigationSession: ${passed}/${CASES.length} passed`);
+  failures.forEach(line => console.log(line));
+  return failures.length === 0;
+}
