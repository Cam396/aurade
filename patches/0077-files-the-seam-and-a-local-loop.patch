@@ -0,0 +1,55 @@
+/** Runs the shared contract against the in memory backend. */
+import {MockBackend} from '../../port/mock_backend.js';
+import type {FileKey} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {runSessionTests} from '../session/session_test.js';
+import {runFormatTests} from '../ui/format_test.js';
+import type {Fixture} from './port_contract.js';
+import {runContract} from './port_contract.js';
+
+const ROOT = asFileKey('mock://myfiles');
+
+function makeFixture(): Fixture {
+  const backend = new MockBackend();
+  backend.addVolume({
+    id: 'system',
+    root: ROOT,
+    label: 'My files',
+    kind: 'system',
+    removable: false,
+    readOnly: false,
+    capacity: {total: 512e9, free: 8.7e9},
+  });
+  backend.addVolume({
+    id: 'usb',
+    root: asFileKey('mock://usb'),
+    label: 'Samsung Flash Drive',
+    kind: 'removable',
+    removable: true,
+    readOnly: false,
+    capacity: {total: 128e9, free: 96e9},
+  });
+  return {
+    port: backend,
+    root: ROOT,
+    add: (parent: FileKey, name: string, isDirectory: boolean) =>
+        backend.add(parent, name, isDirectory, {size: 1024}),
+    remove: (key: FileKey) => backend.remove(key),
+    failWith: (key: FileKey, error: FilesError) =>
+        backend.setFailure(key, error),
+  };
+}
+
+// Declared rather than pulled in from @types/node, which is not on this
+// tree's path and would be a dependency for one property.
+declare const process: {exitCode: number};
+
+async function main(): Promise<void> {
+  const contract = await runContract('MockBackend', makeFixture);
+  const sessions = await runSessionTests();
+  const formats = runFormatTests();
+  process.exitCode =
+      contract.every(r => r.ok) && sessions && formats ? 0 : 1;
+}
+
+void main();
diff --git a/ui/file_manager/file_manager/aurade/tests/harness/golden.py b/ui/file_manager/file_manager/aurade/tests/harness/golden.py
new file mode 100755
index 000000000000..663c47f75cd8
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/harness/golden.py
@@ -0,0 +1,298 @@
+#!/usr/bin/env python3
+"""Render every story headlessly and diff it against a stored golden.
+
+The point is that a hairline moving by a pixel fails here, on this machine, in
+seconds, rather than being noticed on the Dell three days later or not at all.
+
+Served over http rather than opened as a file:// url on purpose. Under file://
+Chrome refuses the stylesheet's relative fetches in ways that silently change
+what is drawn, and a golden of a page that failed to load its own styles is
+worse than no golden.
+"""
+import argparse
+import functools
+import http.server
+import os
+import shutil
+import socket
+import socketserver
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+import numpy
+from PIL import Image
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+AURADE = os.path.dirname(os.path.dirname(HERE))
+SRC = os.path.abspath(os.path.join(AURADE, "..", "..", "..", ".."))
+NODE = os.path.join(SRC, "third_party/node/linux/node-linux-x64/bin/node")
+TSC = os.path.join(SRC, "third_party/node/node_modules/typescript/bin/tsc")
+GOLDENS = os.path.join(HERE, "goldens")
+
+# Antialiasing moves an edge pixel by a shade or two between runs, so a channel
+# has to move by more than this before it counts at all.
+CHANNEL_TOLERANCE = 8
+
+# And then only a handful of counted pixels is forgiven, as an absolute number
+# rather than a share of the image.
+#
+# A share of the area was wrong and hid a real change: fixing the image glyph
+# moved about a hundred and twenty pixels, which failed the two short stories
+# and passed the tall ones, because a thousandth of a larger picture is a larger
+# allowance. Noise scales with the length of the edges, not with the area, and
+# this renderer is deterministic enough that two runs of unchanged code agree
+# exactly, so the allowance can be small and flat.
+ALLOWED_PIXELS = 12
+
+
+def build(out):
+    """Compile the harness and lay it out the way the page expects."""
+    sources = []
+    for folder in ("port", "session", "ui", "tests/harness"):
+        directory = os.path.join(AURADE, folder)
+        sources += [os.path.join(directory, f)
+                    for f in sorted(os.listdir(directory)) if f.endswith(".ts")]
+    result = subprocess.run(
+        [NODE, TSC, "--strict", "--skipLibCheck", "--target", "es2022",
+         "--module", "es2022", "--moduleResolution", "bundler",
+         "--lib", "es2022,dom", "--rootDir", AURADE, "--outDir", out] + sources,
+        capture_output=True, text=True)
+    if result.returncode:
+        sys.stderr.write(result.stdout + result.stderr)
+        raise SystemExit("the harness does not compile")
+    os.makedirs(os.path.join(out, "ui"), exist_ok=True)
+    shutil.copy(os.path.join(AURADE, "ui/tokens.css"),
+                os.path.join(out, "ui/tokens.css"))
+    shutil.copy(os.path.join(HERE, "index.html"),
+                os.path.join(out, "tests/harness/index.html"))
+
+
+def story_names():
+    """Read the story list out of the source rather than keeping a second copy."""
+    text = open(os.path.join(HERE, "stories.ts")).read()
+    names, marker = [], "    name: '"
+    for line in text.splitlines():
+        if line.startswith(marker):
+            names.append(line[len(marker):].split("'")[0])
+    return names
+
+
+class QuietHandler(http.server.SimpleHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+
+def serve(root):
+    handler = functools.partial(QuietHandler, directory=root)
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        port = probe.getsockname()[1]
+    server = socketserver.TCPServer(("127.0.0.1", port), handler)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    return server, port
+
+
+class Browser:
+    """One browser for the whole run, driven over the debugger.
+
+    Relaunching Chrome per story cost twenty five seconds each, almost all of it
+    startup network work that has nothing to do with drawing a row, and seven
+    stories of that never finished inside any sane timeout. Navigating one
+    instance costs milliseconds, and the viewport can be set per story instead
+    of being baked into a command line.
+    """
+
+    def __init__(self, profile):
+        with socket.socket() as probe:
+            probe.bind(("127.0.0.1", 0))
+            port = probe.getsockname()[1]
+        self.port = port
+        self.process = subprocess.Popen(
+            ["google-chrome", "--headless=new", "--no-sandbox", "--disable-gpu",
+             "--hide-scrollbars", "--no-first-run", "--disable-extensions",
+             "--disable-background-networking", "--no-proxy-server",
+             "--force-device-scale-factor=1",
+             "--user-data-dir=" + profile,
+             "--remote-debugging-port=%d" % port, "about:blank"],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        self.socket = self._connect()
+        self.next_id = 0
+        self.call("Page.enable")
+
+    def _connect(self):
+        import json
+        import urllib.error
+        import urllib.request
+        import websocket
+        deadline = time.time() + 40
+        while time.time() < deadline:
+            try:
+                with urllib.request.urlopen(
+                        "http://127.0.0.1:%d/json/list" % self.port,
+                        timeout=2) as response:
+                    targets = json.load(response)
+                for target in targets:
+                    if target.get("type") == "page":
+                        # suppress_origin because remote debugging rejects the
+                        # handshake outright over an origin it was not told to
+                        # allow, which reads as a plain connection failure.
+                        return websocket.create_connection(
+                            target["webSocketDebuggerUrl"], timeout=40,
+                            suppress_origin=True)
+            except (urllib.error.URLError, OSError, ValueError):
+                time.sleep(0.2)
+        raise SystemExit("the browser never came up")
+
+    def call(self, method, **params):
+        import json
+        self.next_id += 1
+        message_id = self.next_id
+        self.socket.send(json.dumps(
+            {"id": message_id, "method": method, "params": params}))
+        while True:
+            message = json.loads(self.socket.recv())
+            if message.get("id") == message_id:
+                if "error" in message:
+                    raise SystemExit("%s failed: %s"
+                                     % (method, message["error"]))
+                return message.get("result", {})
+
+    def wait_for(self, event, timeout=30):
+        import json
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            self.socket.settimeout(max(0.1, deadline - time.time()))
+            try:
+                message = json.loads(self.socket.recv())
+            except Exception:
+                return False
+            if message.get("method") == event:
+                return True
+        return False
+
+    def shoot(self, url, width, height, out):
+        import base64
+        self.call("Emulation.setDeviceMetricsOverride", width=width,
+                  height=height, deviceScaleFactor=1, mobile=False)
+        self.call("Page.navigate", url=url)
+        self.wait_for("Page.loadEventFired")
+        # The story marks itself ready once fonts have settled; a shot taken
+        # before that differs from one taken after on every glyph edge.
+        deadline = time.time() + 5
+        while time.time() < deadline:
+            ready = self.call(
+                "Runtime.evaluate",
+                expression="document.documentElement.classList.contains('ready')",
+                returnByValue=True)
+            if ready.get("result", {}).get("value"):
+                break
+            time.sleep(0.05)
+        data = self.call("Page.captureScreenshot", format="png",
+                         captureBeyondViewport=False)
+        with open(out, "wb") as handle:
+            handle.write(base64.b64decode(data["data"]))
+        return os.path.exists(out)
+
+    def close(self):
+        try:
+            self.socket.close()
+        except Exception:
+            pass
+        self.process.terminate()
+        try:
+            self.process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            self.process.kill()
+
+
+def compare(golden_path, shot_path, diff_path):
+    golden = numpy.asarray(Image.open(golden_path).convert("RGB")).astype(int)
+    shot = numpy.asarray(Image.open(shot_path).convert("RGB")).astype(int)
+    if golden.shape != shot.shape:
+        return False, "size changed from %sx%s to %sx%s" % (
+            golden.shape[1], golden.shape[0], shot.shape[1], shot.shape[0])
+    delta = numpy.abs(golden - shot)
+    moved = (delta.max(axis=2) > CHANNEL_TOLERANCE)
+    count = int(moved.sum())
+    allowed = ALLOWED_PIXELS
+    if count <= allowed:
+        return True, ""
+    highlight = numpy.array(shot)
+    highlight[moved] = [255, 0, 128]
+    Image.fromarray(highlight.astype("uint8")).save(diff_path)
+    return False, ("%d pixels moved (allowed %d), largest change %d"
+                   % (count, int(allowed), int(delta.max())))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--update", action="store_true",
+                        help="accept what is rendered now as the golden")
+    parser.add_argument("--only", help="run one story by name")
+    parser.add_argument("--artifacts", default=None,
+                        help="where to leave shots and diffs on failure")
+    args = parser.parse_args()
+
+    stories = {}
+    text = open(os.path.join(HERE, "stories.ts")).read()
+    current = None
+    for line in text.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("name: '"):
+            current = stripped[len("name: '"):].split("'")[0]
+            stories[current] = [720, 260]
+        elif current and stripped.startswith("width:"):
+            stories[current][0] = int(stripped.split(":")[1].strip(" ,"))
+        elif current and stripped.startswith("height:"):
+            stories[current][1] = int(stripped.split(":")[1].strip(" ,"))
+
+    names = [args.only] if args.only else story_names()
+    os.makedirs(GOLDENS, exist_ok=True)
+    artifacts = args.artifacts or tempfile.mkdtemp(prefix="aurade-golden-")
+    os.makedirs(artifacts, exist_ok=True)
+
+    work = tempfile.mkdtemp(prefix="aurade-harness-")
+    try:
+        build(work)
+        server, port = serve(work)
+        browser = Browser(os.path.join(work, "profile"))
+        failures = []
+        for name in names:
+            width, height = stories.get(name, [720, 260])
+            shot = os.path.join(artifacts, name + ".png")
+            url = ("http://127.0.0.1:%d/tests/harness/index.html?story=%s"
+                   % (port, name))
+            if not browser.shoot(url, width, height, shot):
+                failures.append("%s: nothing was rendered" % name)
+                continue
+            golden = os.path.join(GOLDENS, name + ".png")
+            if args.update or not os.path.exists(golden):
+                shutil.copy(shot, golden)
+                print("  recorded  %s (%dx%d)" % (name, width, height))
+                continue
+            ok, why = compare(golden, shot, os.path.join(artifacts,
+                                                         name + ".diff.png"))
+            if ok:
+                print("  matches   %s" % name)
+            else:
+                print("  CHANGED   %s: %s" % (name, why))
+                failures.append(name)
+        browser.close()
+        server.shutdown()
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+    if failures:
+        print("\ngolden renders: %d changed. Shots and diffs in %s"
+              % (len(failures), artifacts))
+        print("If the change is intended, re-run with --update.")
+        return 1
+    print("\ngolden renders: %d matched" % len(names))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
