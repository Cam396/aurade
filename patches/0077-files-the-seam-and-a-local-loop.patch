+++ b/ui/file_manager/file_manager/aurade/tests/ui/format_test.ts
@@ -0,0 +1,106 @@
+/** The grammar and the arithmetic, which is where most of the craft lives. */
+import {formatCount, formatDate, formatSelection, formatSize, kindOf, labelForKind} from '../../ui/format.js';
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${JSON.stringify(expected)}, got ${
+            JSON.stringify(actual)}`);
+  }
+}
+
+interface Case {
+  name: string;
+  run(): void;
+}
+
+/** A fixed clock, so "yesterday" does not depend on when the suite runs. */
+const NOW = new Date('2026-09-02T15:30:00').getTime();
+const minutes = (n: number) => NOW - n * 60_000;
+const days = (n: number) => NOW - n * 86_400_000;
+
+const CASES: Case[] = [
+  {
+    name: 'sizes never claim a precision they do not have',
+    run() {
+      equal(formatSize(512), '512 bytes', 'bytes stay exact');
+      equal(formatSize(1024), '1.0 KB', 'one kibibyte');
+      equal(formatSize(1536), '1.5 KB', 'one and a half');
+      equal(formatSize(1024 * 1024 * 2.44), '2.4 MB', 'three significant figures');
+      equal(formatSize(1024 * 1024 * 512), '512 MB', 'no decimal above ten');
+      equal(formatSize(undefined), '', 'nothing is not zero');
+    },
+  },
+  {
+    name: 'counts are written the way somebody would say them',
+    run() {
+      equal(formatCount(0, 1), '1 file', 'never 1 file(s)');
+      equal(formatCount(1, 0), '1 folder', 'singular folder');
+      equal(formatCount(3, 2), '3 folders and 2 files', 'both halves');
+      equal(formatCount(0, 0), 'Nothing here yet', 'never 0 files');
+      equal(formatSelection(0), 'No items selected', 'never 0 selected');
+      equal(formatSelection(1), '1 item selected', 'singular selection');
+    },
+  },
+  {
+    name: 'dates age the way somebody would say them',
+    run() {
+      equal(formatDate(NOW - 5_000, NOW), 'Just now', 'under a minute');
+      equal(formatDate(minutes(1), NOW), '1 minute ago', 'singular minute');
+      equal(formatDate(minutes(14), NOW), '14 minutes ago', 'plural minutes');
+      const today = formatDate(NOW - 3 * 3_600_000, NOW);
+      equal(today.startsWith('Today at '), true, `today: got ${today}`);
+      const yesterday = formatDate(days(1), NOW);
+      equal(
+          yesterday.startsWith('Yesterday at '), true,
+          `yesterday: got ${yesterday}`);
+      const thisYear = formatDate(days(30), NOW);
+      equal(
+          /^[A-Z][a-z]+day/.test(thisYear), true,
+          `this year names the weekday: got ${thisYear}`);
+      const older = formatDate(new Date('2025-05-12T09:00:00').getTime(), NOW);
+      equal(older.includes('2025'), true, `older carries the year: got ${older}`);
+      equal(formatDate(undefined, NOW), '', 'nothing is not the epoch');
+    },
+  },
+  {
+    name: 'an Arch package is recognised by the half that matters',
+    run() {
+      equal(
+          kindOf('linux-6.18.2-1-x86_64.pkg.tar.zst', false), 'package',
+          'the compound extension wins over the tail');
+      equal(labelForKind('package'), 'Package', 'and it is labelled as one');
+      equal(kindOf('notes.tar.zst', false), 'archive', 'a plain archive is not');
+    },
+  },
+  {
+    name: 'file kinds come off the extension, and a folder is a folder',
+    run() {
+      equal(kindOf('anything', true), 'folder', 'directories short circuit');
+      equal(kindOf('holiday.JPEG', false), 'image', 'case does not matter');
+      equal(kindOf('main.ts', false), 'code', 'source is code');
+      equal(kindOf('README', false), 'file', 'no extension is just a file');
+      equal(kindOf('trailing.', false), 'file', 'an empty extension is not a kind');
+      equal(kindOf('.bashrc', false), 'file', 'a leading dot is not an extension');
+    },
+  },
+];
+
+export function runFormatTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      passed++;
+    } catch (error) {
+      failures.push(
+          `  FAIL ${testCase.name}\n       ${
+              error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`format: ${passed}/${CASES.length} passed`);
+  failures.forEach(line => console.log(line));
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/file_row.ts b/ui/file_manager/file_manager/aurade/ui/file_row.ts
new file mode 100644
index 000000000000..5624683207a5
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/file_row.ts
@@ -0,0 +1,110 @@
+/**
+ * One row, as a create step and an update step.
+ *
+ * Deliberately not a custom element and deliberately no shadow root per row: at
+ * a hundred thousand entries a shadow root per row is a hundred thousand style
+ * scopes, and the rows are recycled anyway.
+ *
+ * The split matters more than it looks. ChromeOS's `List.mergeItems` reuses the
+ * element it already made and never re-runs the render path for a row that is
+ * already on screen, which is why a patch that set a class during rendering
+ * changed nothing for any visible row. `updateRow` always writes every field,
+ * so a recycled row cannot keep a stale one.
+ */
+import type {EntryDto, Metadata} from '../port/types.js';
+import type {FileKind} from './format.js';
+import {formatDate, formatSize, kindOf, labelForKind} from './format.js';
+
+export interface RowModel {
+  readonly entry: EntryDto;
+  readonly metadata?: Metadata;
+  readonly selected: boolean;
+  readonly cut: boolean;
+  /** This entry's share of the folder, 0 to 1, for the bar behind the size. */
+  readonly share?: number;
+  readonly now: number;
+}
+
+/** Inline, so a glyph is never a separate resource that a transplant cannot carry. */
+const GLYPHS: Record<FileKind, string> = {
+  folder: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h3.6l1.5 1.8h6.9A1.5 1.5 0 0 1 18 7.3v6.2A1.5 1.5 0 0 1 16.5 15h-12A1.5 1.5 0 0 1 3 13.5z',
+  image: 'M3.5 5.5h13v9h-13zM5.5 12.5l3-3.5 2.5 3 2-2.5 2.5 3',
+  audio: 'M8 14a2 2 0 1 1-2-2V4l8-1.5V12a2 2 0 1 1-2-2V5.2L8 6z',
+  video: 'M3.5 5.5h9v9h-9zM12.5 10l4-2.5v5z',
+  archive: 'M3.5 5.5h13v9h-13zM9.2 5.5v1.6M10.8 7.1v1.6M9.2 8.7v1.6M10.8 10.3v1.6',
+  code: 'M7.5 6 4 10l3.5 4M12.5 6 16 10l-3.5 4',
+  document: 'M5 3h6l4 4v10H5zm6 0v4h4',
+  package: 'M10 2.5 17 6v8l-7 3.5L3 14V6zM3 6l7 3.5L17 6M10 9.5V17',
+  file: 'M5 3h6l4 4v10H5z',
+};
+
+/**
+ * Which glyphs are drawn as outlines rather than filled.
+ *
+ * The pictorial ones have to be. A frame with something inside it, filled with
+ * a single non zero winding path, floods to a solid block, which is exactly
+ * what the image glyph did on its first render.
+ */
+const STROKED: ReadonlySet<FileKind> = new Set<FileKind>(
+    ['code', 'document', 'package', 'image', 'video', 'archive']);
+
+export function createRow(): HTMLElement {
+  const row = document.createElement('div');
+  row.className = 'aurade-row';
+  row.setAttribute('role', 'option');
+  row.tabIndex = -1;
+  row.innerHTML = `
+    <span class="aurade-tile"><svg class="aurade-glyph" viewBox="0 0 20 20" aria-hidden="true"><path/></svg></span>
+    <span class="aurade-name"></span>
+    <span class="aurade-size"></span>
+    <span class="aurade-type"></span>
+    <span class="aurade-date"></span>`;
+  return row;
+}
+
+export function updateRow(row: HTMLElement, model: RowModel): void {
+  const {entry, metadata, selected, cut, share, now} = model;
+  const kind = kindOf(entry.name, entry.isDirectory);
+
+  row.dataset['key'] = entry.key;
+  row.dataset['directory'] = String(entry.isDirectory);
+  row.dataset['cut'] = String(cut);
+  row.setAttribute('aria-selected', String(selected));
+
+  const path = row.querySelector('path')!;
+  path.setAttribute('d', GLYPHS[kind]);
+  if (STROKED.has(kind)) {
+    path.setAttribute('fill', 'none');
+    path.setAttribute('stroke', 'currentColor');
+    path.setAttribute('stroke-width', '1.6');
+    path.setAttribute('stroke-linejoin', 'round');
+    path.setAttribute('stroke-linecap', 'round');
+  } else {
+    path.setAttribute('fill', 'currentColor');
+    path.removeAttribute('stroke');
+  }
+
+  row.querySelector('.aurade-name')!.textContent = entry.name;
+  // A folder has no meaningful size of its own, and printing a dash for one is
+  // an answer to a question nobody asked.
+  row.querySelector('.aurade-size')!.textContent =
+      entry.isDirectory ? '' : formatSize(metadata?.size);
+  row.querySelector('.aurade-type')!.textContent = labelForKind(kind);
+  row.querySelector('.aurade-date')!.textContent =
+      formatDate(metadata?.modificationTime, now);
+
+  const size = row.querySelector('.aurade-size') as HTMLElement;
+  size.style.setProperty(
+      '--aurade-share', share ? `${Math.round(share * 100)}%` : '0%');
+
+  // The accessible name carries what the columns say, because a screen reader
+  // reading "Downloads 2.4 MB Folder Today at 3:15 PM" as four separate cells
+  // is not how anybody would say it.
+  row.setAttribute(
+      'aria-label',
+      [entry.name, labelForKind(kind),
+       entry.isDirectory ? '' : formatSize(metadata?.size),
+       formatDate(metadata?.modificationTime, now)]
+          .filter(Boolean)
+          .join(', '));
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/format.ts b/ui/file_manager/file_manager/aurade/ui/format.ts
new file mode 100644
index 000000000000..869026d5becc
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/format.ts
@@ -0,0 +1,151 @@
+/**
+ * Turning numbers into the sentences a person actually reads.
+ *
+ * Separate from the row so it can be tested on its own, because most of what
+ * makes a file manager feel considered is here rather than in the layout: never
+ * printing "1 item(s)", never claiming a precision the number does not have,
+ * and ageing dates the way somebody would say them out loud.
+ */
+
+const KIB = 1024;
+
+/**
+ * Sizes carry three significant figures at most.
+ *
+ * "1.4 MB" and not "1.44 MB", because the second digit after the point is
+ * noise that changes while you are reading it.
+ */
+export function formatSize(bytes: number|undefined): string {
+  if (bytes === undefined) {
+    return '';
+  }
+  if (bytes < KIB) {
+    return `${bytes} bytes`;
+  }
+  const units = ['KB', 'MB', 'GB', 'TB', 'PB'];
+  let value = bytes / KIB;
+  let unit = 0;
+  while (value >= KIB && unit < units.length - 1) {
+    value /= KIB;
+    unit++;
+  }
+  const digits = value < 10 ? 1 : 0;
+  return `${value.toFixed(digits)} ${units[unit]}`;
+}
+
+/** The grammar rule: never "item(s)", never "0 files". */
+export function formatCount(folders: number, files: number): string {
+  const parts: string[] = [];
+  if (folders > 0) {
+    parts.push(folders === 1 ? '1 folder' : `${folders} folders`);
+  }
+  if (files > 0) {
+    parts.push(files === 1 ? '1 file' : `${files} files`);
+  }
+  if (!parts.length) {
+    return 'Nothing here yet';
+  }
+  return parts.join(' and ');
+}
+
+export function formatSelection(count: number): string {
+  if (count === 0) {
+    return 'No items selected';
+  }
+  return count === 1 ? '1 item selected' : `${count} items selected`;
+}
+
+function clockTime(date: Date): string {
+  return date.toLocaleTimeString(
+      undefined, {hour: 'numeric', minute: '2-digit'});
+}
+
+/**
+ * Dates age the way somebody would say them.
+ *
+ * `now` is a parameter rather than read from the clock so this can be tested
+ * without waiting for tomorrow.
+ */
+export function formatDate(when: number|undefined, now: number): string {
+  if (when === undefined) {
+    return '';
+  }
+  const date = new Date(when);
+  const current = new Date(now);
+  const seconds = Math.floor((now - when) / 1000);
+
+  if (seconds < 60) {
+    return 'Just now';
+  }
+  if (seconds < 3600) {
+    const minutes = Math.floor(seconds / 60);
+    return minutes === 1 ? '1 minute ago' : `${minutes} minutes ago`;
+  }
+
+  const sameDay = date.toDateString() === current.toDateString();
+  if (sameDay) {
+    return `Today at ${clockTime(date)}`;
+  }
+
+  const yesterday = new Date(current);
+  yesterday.setDate(current.getDate() - 1);
+  if (date.toDateString() === yesterday.toDateString()) {
+    return `Yesterday at ${clockTime(date)}`;
+  }
+
+  if (date.getFullYear() === current.getFullYear()) {
+    return date.toLocaleDateString(
+        undefined, {weekday: 'long', day: 'numeric', month: 'long'});
+  }
+  return date.toLocaleDateString(
+      undefined, {day: 'numeric', month: 'long', year: 'numeric'});
+}
+
+export type FileKind = 'folder'|'image'|'audio'|'video'|'archive'|'code'|
+    'document'|'package'|'file';
+
+const BY_EXTENSION: ReadonlyMap<string, FileKind> = new Map(Object.entries({
+  png: 'image', jpg: 'image', jpeg: 'image', gif: 'image', webp: 'image',
+  svg: 'image', bmp: 'image', avif: 'image',
+  mp3: 'audio', flac: 'audio', ogg: 'audio', wav: 'audio', m4a: 'audio',
+  mp4: 'video', mkv: 'video', webm: 'video', mov: 'video', avi: 'video',
+  zip: 'archive', tar: 'archive', gz: 'archive', xz: 'archive',
+  zst: 'archive', bz2: 'archive', rar: 'archive', '7z': 'archive',
+  ts: 'code', js: 'code', py: 'code', rs: 'code', c: 'code', h: 'code',
+  cc: 'code', cpp: 'code', sh: 'code', json: 'code', html: 'code',
+  css: 'code', go: 'code', java: 'code',
+  pdf: 'document', doc: 'document', docx: 'document', odt: 'document',
+  txt: 'document', md: 'document', rtf: 'document',
+}) as Array<[string, FileKind]>);
+
+export function kindOf(name: string, isDirectory: boolean): FileKind {
+  if (isDirectory) {
+    return 'folder';
+  }
+  // Arch packages are a compound extension and the interesting half is not the
+  // last one, so they are matched before the generic tail.
+  if (/\.pkg\.tar\.(zst|xz|gz)$/i.test(name)) {
+    return 'package';
+  }
+  const dot = name.lastIndexOf('.');
+  if (dot <= 0 || dot === name.length - 1) {
+    return 'file';
+  }
+  return BY_EXTENSION.get(name.slice(dot + 1).toLowerCase()) ?? 'file';
+}
+
+const LABELS: Record<FileKind, string> = {
+  folder: 'Folder',
+  image: 'Image',
+  audio: 'Audio',
+  video: 'Video',
+  archive: 'Archive',
+  code: 'Code',
+  document: 'Document',
+  package: 'Package',
+  file: 'File',
+};
+
+export function labelForKind(kind: FileKind): string {
+  return LABELS[kind];
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/tokens.css b/ui/file_manager/file_manager/aurade/ui/tokens.css
new file mode 100644
index 000000000000..dd41f23f038b
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/tokens.css
@@ -0,0 +1,186 @@
+/**
+ * The AuraDE surface vocabulary.
+ *
+ * The accent is not a new decision. The greeter already defines it, in GTK
+ * theme variables rather than in its stylesheet: accent_bg_color is #6d4ea1 in
+ * theme.css and #d1bcff in theme-dark.css, and the installer's token table
+ * carries the same pair. Counting literal hex in greeter.css and concluding the
+ * greeter was achromatic was a mistake; it uses @accent_color for focus rings
+ * and the active pod.
+ *
+ * Surfaces are taken from the greeter's own values: translucent grounds, white
+ * hairlines, white overlay interactive states, and deep soft shadows.
+ */
+
+:root {
+  --aurade-accent: #6d4ea1;
+  --aurade-on-accent: #ffffff;
+
+  --aurade-ground: #f4f2f9;
+  --aurade-panel: #ffffff;
+  --aurade-line: #e6e2f0;
+  --aurade-ink: #1c1a24;
+  --aurade-quiet: #6b6580;
+
+  --aurade-row-hover: rgba(0, 0, 0, .04);
+  --aurade-row-selected: rgba(109, 78, 161, .12);
+  --aurade-tile: #f0edf7;
+  --aurade-tile-dir: #e4dbf8;
+  --aurade-tile-selected: #dbcdf6;
+  --aurade-glyph: #6f6885;
+  --aurade-tag-bg: #f7f5fc;
+
+  --aurade-radius-row: 11px;
+  --aurade-radius-tile: 11px;
+  --aurade-radius-panel: 16px;
+  --aurade-radius-pill: 999px;
+
+  --aurade-row-height: 40px;
+  --aurade-tile-size: 32px;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-aurade-theme="light"]) {
+    --aurade-accent: #d1bcff;
+    --aurade-on-accent: #3f1d6c;
+
+    --aurade-ground: #100f16;
+    --aurade-panel: #191823;
+    --aurade-line: #262433;
+    --aurade-ink: #efecf8;
+    --aurade-quiet: #948ea8;
+
+    --aurade-row-hover: rgba(255, 255, 255, .06);
+    --aurade-row-selected: rgba(209, 188, 255, .16);
+    --aurade-tile: #23212f;
+    --aurade-tile-dir: #372c57;
+    --aurade-tile-selected: #4a3b74;
+    --aurade-glyph: #a79dc4;
+    --aurade-tag-bg: #211f2c;
+  }
+}
+
+/* Repeated rather than shared, because a media query and an attribute cannot
+   select the same block. The attribute form is what lets both themes be
+   rendered and diffed without emulating the reader's system setting. */
+:root[data-aurade-theme="dark"] {
+    --aurade-accent: #d1bcff;
+    --aurade-on-accent: #3f1d6c;
+
+    --aurade-ground: #100f16;
+    --aurade-panel: #191823;
+    --aurade-line: #262433;
+    --aurade-ink: #efecf8;
+    --aurade-quiet: #948ea8;
+
+    --aurade-row-hover: rgba(255, 255, 255, .06);
+    --aurade-row-selected: rgba(209, 188, 255, .16);
+    --aurade-tile: #23212f;
+    --aurade-tile-dir: #372c57;
+    --aurade-tile-selected: #4a3b74;
+    --aurade-glyph: #a79dc4;
+    --aurade-tag-bg: #211f2c;
+}
+
+/* Density is fixed per mode, never measured. Dynamic row heights across a
+   hundred thousand entries make the scrollbar thumb jitter and drop frames. */
+:root[data-aurade-density="compact"] { --aurade-row-height: 32px; --aurade-tile-size: 26px; }
+:root[data-aurade-density="relaxed"] { --aurade-row-height: 52px; --aurade-tile-size: 38px; }
+
+.aurade-row {
+  align-items: center;
+  block-size: var(--aurade-row-height);
+  border-radius: var(--aurade-radius-row);
+  box-sizing: border-box;
+  color: var(--aurade-ink);
+  display: grid;
+  gap: 12px;
+  grid-template-columns: var(--aurade-tile-size) 1fr 84px 96px 132px;
+  margin-inline: 8px;
+  padding-inline: 8px;
+  position: relative;
+  user-select: none;
+}
+
+.aurade-row:hover { background: var(--aurade-row-hover); }
+
+/* Selection and focus differ by shape as well as colour, because colour alone
+   is not a distinction everyone can see. */
+.aurade-row[aria-selected="true"] {
+  background: var(--aurade-row-selected);
+  box-shadow: inset 3px 0 0 0 var(--aurade-accent);
+}
+.aurade-row:focus-visible {
+  outline: 2px solid var(--aurade-accent);
+  outline-offset: -2px;
+}
+
+/* A cut entry is dashed as well as dimmed, so it reads as pending rather than
+   as disabled. */
+.aurade-row[data-cut="true"] { opacity: .55; }
+.aurade-row[data-cut="true"] .aurade-tile {
+  border: 1px dashed var(--aurade-quiet);
+}
+
+.aurade-tile {
+  align-items: center;
+  background: var(--aurade-tile);
+  block-size: var(--aurade-tile-size);
+  border-radius: var(--aurade-radius-tile);
+  box-sizing: border-box;
+  display: flex;
+  inline-size: var(--aurade-tile-size);
+  justify-content: center;
+}
+.aurade-row[data-directory="true"] .aurade-tile { background: var(--aurade-tile-dir); }
+.aurade-row[aria-selected="true"] .aurade-tile { background: var(--aurade-tile-selected); }
+
+.aurade-glyph {
+  block-size: 18px;
+  color: var(--aurade-glyph);
+  inline-size: 18px;
+}
+.aurade-row[data-directory="true"] .aurade-glyph { color: var(--aurade-accent); }
+
+.aurade-name {
+  font-size: 13px;
+  font-weight: 550;
+  letter-spacing: -.005em;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.aurade-size, .aurade-date {
+  color: var(--aurade-quiet);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+}
+
+/* A quiet proportional bar behind the size, so the large item in a folder of
+   five hundred is visible without reading a digit. */
+.aurade-size { position: relative; }
+.aurade-size::before {
+  background: currentColor;
+  block-size: 100%;
+  content: '';
+  inset-block-start: 0;
+  inset-inline-start: 0;
+  inline-size: var(--aurade-share, 0%);
+  opacity: .10;
+  position: absolute;
+  border-radius: 3px;
+}
+
+.aurade-type {
+  background: var(--aurade-tag-bg);
+  border: 1px solid var(--aurade-line);
+  border-radius: var(--aurade-radius-pill);
+  color: var(--aurade-quiet);
+  font-size: 10.5px;
+  font-weight: 600;
+  justify-self: start;
+  letter-spacing: .04em;
+  line-height: 15px;
+  padding: 2px 9px;
+}
