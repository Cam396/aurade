+/**
+ * Checks adapter/platform.ts against the machine, one claim at a time.
+ *
+ * The local loop can prove the adapter translates correctly. It cannot prove
+ * the description it translates against is right, because the fake is written
+ * from that same description: if the description is wrong, both agree and both
+ * are wrong together. On 2026-09-03 that is exactly what had happened, in seven
+ * places, six of which would have failed on first use.
+ *
+ * So this is the other half of the contract, and it runs where the fake cannot:
+ * inside a live Files app renderer, against the real chrome.fileManagerPrivate.
+ *
+ *   /mnt/build/aurade-work/lab eval "$(cat platform_probe.js)"
+ *
+ * The Files app has to be open, since fileManagerPrivate is gated to that
+ * origin. If no page target exists:
+ *
+ *   curl -s -X PUT "http://127.0.0.1:19222/json/new?chrome://file-manager"
+ *
+ * Everything here reads, except one directory it creates under My files and
+ * removes in a finally. That directory is the only way to see a watch event or
+ * a progress report, which are two of the shapes most worth checking.
+ *
+ * Signatures are learned by making a deliberately invalid call and reading the
+ * binding's own rejection, which names the expected signature without
+ * performing anything.
+ */
+(async () => {
+  const fmp = chrome.fileManagerPrivate;
+  const results = [];
+  const check = (claim, ok, detail) =>
+      results.push({claim, ok: !!ok, detail: detail === undefined ? null : detail});
+  const resolveOne = (u) =>
+      new Promise((res, rej) => webkitResolveLocalFileSystemURL(u, res, rej));
+  const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+
+  // --- the enums our tables mirror ---
+  check('PlatformIoType matches IoTaskType',
+        same(Object.values(fmp.IoTaskType).sort(),
+             ['copy', 'delete', 'empty_trash', 'extract', 'move', 'restore',
+              'restore_to_destination', 'trash', 'zip'].sort()),
+        Object.values(fmp.IoTaskType));
+  check('PlatformIoState matches IoTaskState',
+        same(Object.values(fmp.IoTaskState).sort(),
+             ['cancelled', 'error', 'in_progress', 'need_password', 'paused',
+              'queued', 'scanning', 'success'].sort()),
+        Object.values(fmp.IoTaskState));
+  check('every volume type VOLUME_KINDS maps still exists',
+        ['downloads', 'local_root', 'system_internal', 'removable', 'archive',
+         'provided', 'documents_provider', 'smb', 'drive', 'android_files',
+         'crostini', 'guest_os', 'mtp', 'media_view']
+            .filter(t => !Object.values(fmp.VolumeType).includes(t)),
+        Object.values(fmp.VolumeType));
+
+  // --- signatures, from the bindings' own refusals ---
+  const signature = (name, args) => {
+    try {
+      fmp[name].apply(fmp, args.concat([() => {}]));
+      return 'ACCEPTED, which it should not have been';
+    } catch (error) {
+      return String(error.message)
+          .replace(/^Error in invocation of /, '')
+          .replace(/: No matching signature\.$/, '');
+    }
+  };
+  const signatures = {
+    getFileTasks: signature('getFileTasks', [123]),
+    selectFiles: signature('selectFiles', [123]),
+    searchFiles: signature('searchFiles', [123]),
+    startIOTask: signature('startIOTask', [123]),
+    getEntryProperties: signature('getEntryProperties', [123]),
+  };
+  check('getFileTasks takes entries and dlp source urls',
+        signatures.getFileTasks.includes('array entries, array dlpSourceUrls'),
+        signatures.getFileTasks);
+  check('selectFiles takes the urls and a local path flag',
+        signatures.selectFiles.includes('array selectedPaths, boolean shouldReturnLocalPath'),
+        signatures.selectFiles);
+  check('startIOTask takes a type, entries and params',
+        signatures.startIOTask.includes(
+            'IoTaskType type, array entries, fileManagerPrivate.IoTaskParams params'),
+        signatures.startIOTask);
+  check('getEntryProperties takes entries, not urls',
+        signatures.getEntryProperties.includes('array entries, array names'),
+        signatures.getEntryProperties);
+
+  // --- volumes: the label and the root come from VolumeManager, not the API ---
+  const metadataList = await new Promise(r => fmp.getVolumeMetadataList(r));
+  const metaKeys = Object.keys(metadataList[0] || {});
+  check('VolumeMetadata carries neither a label nor a root, so listVolumes needs VolumeManager',
+        !metaKeys.includes('label') && !metaKeys.includes('root'), metaKeys);
+  const vm = window.fileManager && window.fileManager.volumeManager;
+  check('VolumeManager is reachable and its volumes carry a label and a display root',
+        !!(vm && vm.volumeInfoList.length &&
+           vm.volumeInfoList.item(0).label && vm.volumeInfoList.item(0).displayRoot),
+        vm ? vm.volumeInfoList.length + ' volumes' : 'no VolumeManager');
+
+  const root = vm && vm.volumeInfoList.item(0).displayRoot;
+  if (!root) {
+    return JSON.stringify({results, verdict: 'incomplete, no volume to work in'}, null, 1);
+  }
+
+  // --- resolve and its failure mode ---
+  check('entry.toURL() round trips through webkitResolveLocalFileSystemURL',
+        (await resolveOne(root.toURL())).toURL() === root.toURL());
+  try {
+    await resolveOne(root.toURL().replace(/\/?$/, '/not-here-0e1f2a'));
+    check('a missing path rejects with a DOMException', false, 'it resolved');
+  } catch (error) {
+    check('a missing path rejects with a DOMException',
+          error instanceof DOMException && error.name === 'NotFoundError',
+          error && error.name);
+  }
+
+  // --- readEntries terminates with an empty array ---
+  const reader = root.createReader();
+  const chunks = [];
+  for (let i = 0; i < 200; i++) {
+    const chunk = await new Promise((res, rej) => reader.readEntries(res, rej));
+    chunks.push(chunk.length);
+    if (!chunk.length) break;
+  }
+  check('readEntries ends with an empty array',
+        chunks[chunks.length - 1] === 0, chunks);
+
+  // --- metadata comes from MetadataModel, positionally ---
+  const listing = await new Promise((res, rej) => root.createReader().readEntries(res, rej));
+  const file = listing.find(entry => !entry.isDirectory);
+  const model = window.fileManager && window.fileManager.metadataModel_;
+  if (file && model) {
+    const items = await model.get(listing.slice(0, 3), ['size', 'modificationTime']);
+    check('MetadataModel answers positionally',
+          items.length === Math.min(3, listing.length), items.length);
+    check('modificationTime is a Date from MetadataModel',
+          items.some(item => item.modificationTime instanceof Date));
+    const raw = await new Promise(
+        r => fmp.getEntryProperties([file], ['size', 'modificationTime'], r));
+    check('getEntryProperties alone answers nothing for a local file, so MetadataModel is required',
+          Object.keys(raw[0] || {}).length === 0, Object.keys(raw[0] || {}));
+    try {
+      await model.get([file], ['restricted']);
+      check('MetadataModel rejects a name it does not know', false, 'it accepted restricted');
+    } catch (error) {
+      check('MetadataModel rejects a name it does not know', true,
+            String(error.message).slice(0, 60));
+    }
+    try {
+      const restricted = await model.get([file], ['isDlpRestricted']);
+      check('isDlpRestricted is the name the model knows it by',
+            'isDlpRestricted' in (restricted[0] || {}),
+            Object.keys(restricted[0] || {}));
+    } catch (error) {
+      check('isDlpRestricted is the name the model knows it by', false,
+            String(error.message).slice(0, 60));
+    }
+    check('and getEntryProperties does not know that name at all, which is why the model is used',
+          !Object.values(fmp.EntryPropertyName).includes('isDlpRestricted'));
+  }
+
+  // --- tasks arrive wrapped ---
+  if (file) {
+    const answer = await new Promise(
+        r => fmp.getFileTasks([file], [file.toURL()], r));
+    check('getFileTasks answers with a wrapper, not an array',
+          !Array.isArray(answer) && Array.isArray(answer.tasks),
+          Object.keys(answer));
+  }
+
+  // --- search needs both a cap and a type ---
+  try {
+    await new Promise((res, rej) => {
+      try { fmp.searchFiles({rootDir: root, query: 'a', types: 'ALL'}, res); }
+      catch (error) { rej(error); }
+    });
+    check('searchFiles requires maxResults', false, 'it accepted the call');
+  } catch (error) {
+    check('searchFiles requires maxResults', error instanceof TypeError);
+  }
+  try {
+    await new Promise((res, rej) => {
+      try { fmp.searchFiles({rootDir: root, query: 'a', maxResults: 5}, res); }
+      catch (error) { rej(error); }
+    });
+    check('searchFiles requires types', false, 'it accepted the call');
+  } catch (error) {
+    check('searchFiles requires types', error instanceof TypeError);
+  }
+
+  // --- the watch event, and a progress report, inside one directory of our own ---
+  const stamp = 'aurade-probe-' + Date.now();
+  const box = await new Promise(
+      (res, rej) => root.getDirectory(stamp, {create: true}, res, rej));
+  try {
+    const src = await new Promise(
+        (res, rej) => box.getDirectory('src', {create: true}, res, rej));
+    const dest = await new Promise(
+        (res, rej) => box.getDirectory('dest', {create: true}, res, rej));
+    const seed = await new Promise(
+        (res, rej) => src.getFile('seed.txt', {create: true}, res, rej));
+
+    const events = [];
+    const onChange = (event) => events.push(Object.keys(event).sort().join(','));
+    fmp.onDirectoryChanged.addListener(onChange);
+    await new Promise(r => fmp.addFileWatch(src, r));
+    try {
+      await new Promise((res, rej) => src.getFile('appeared.txt', {create: true}, res, rej));
+      await new Promise(r => setTimeout(r, 2500));
+    } finally {
+      await new Promise(r => fmp.removeFileWatch(src, r));
+      fmp.onDirectoryChanged.removeListener(onChange);
+    }
+    check('a watch event is an entry and an event type, with no changed files',
+          events.length > 0 && events.every(keys => keys === 'entry,eventType'),
+          events);
+
+    const progress = [];
+    const onIo = (status) => progress.push(status);
+    fmp.onIOTaskProgressStatus.addListener(onIo);
+    try {
+      const taskId = await new Promise((res, rej) => {
+        try {
+          fmp.startIOTask('copy', [seed],
+                          {destinationFolder: dest, showNotification: false}, res);
+        } catch (error) { rej(error); }
+      });
+      check('startIOTask answers with a number', typeof taskId === 'number', taskId);
+      await new Promise(r => setTimeout(r, 3000));
+    } finally {
+      fmp.onIOTaskProgressStatus.removeListener(onIo);
+    }
+    const last = progress[progress.length - 1];
+    check('ProgressStatus carries every field PlatformIoProgress reads',
+          !!last && ['taskId', 'type', 'state', 'bytesTransferred', 'totalBytes',
+                     'sourceName', 'itemCount', 'numRemainingItems']
+                        .every(field => field in last),
+          last ? Object.keys(last) : 'no progress reported');
+    check('errorName is the empty string rather than absent when nothing failed',
+          !!last && last.state === 'success' && last.errorName === '',
+          last && JSON.stringify(last.errorName));
+  } finally {
+    await new Promise(res => box.removeRecursively(res, res));
+  }
+
+  const failed = results.filter(r => !r.ok);
+  return JSON.stringify({
+    checked: results.length,
+    failed: failed.length,
+    verdict: failed.length ? 'platform.ts disagrees with this machine' :
+                             'platform.ts agrees with this machine',
+    failures: failed,
+    all: results,
+  }, null, 1);
+})()
