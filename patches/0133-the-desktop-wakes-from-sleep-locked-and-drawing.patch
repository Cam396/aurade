+    base::PowerMonitorDeviceSource::HandleSystemResumed();
     RequestStatusUpdate();
     GetScreenBrightnessPercent(base::BindOnce(
         &FakePowerManagerClient::OnHostScreenBrightnessChanged,
@@ -1228,8 +1233,16 @@ void FakePowerManagerClient::SendSuspendDone(base::TimeDelta sleep_duration) {
   if (render_process_manager_delegate_)
     render_process_manager_delegate_->SuspendDone();
 
+  // AuraDE: as the real client does, the observers hear SuspendDoneEx, whose
+  // default passes the duration on to SuspendDone. Ash's power event observer
+  // only listens for SuspendDoneEx, and that is where it starts compositing
+  // again after stopping it for sleep: with SuspendDone alone, the desktop
+  // came back from sleep frozen, only the pointer moving.
+  power_manager::SuspendDone proto;
+  proto.set_suspend_duration(sleep_duration.ToInternalValue());
+  proto.set_deepest_state(power_manager::SuspendDone_SuspendState_TO_RAM);
   for (auto& observer : observers_)
-    observer.SuspendDone(sleep_duration);
+    observer.SuspendDoneEx(proto);
 }
 
