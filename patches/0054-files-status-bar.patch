diff --git a/ui/file_manager/file_manager/foreground/css/file_manager.css b/ui/file_manager/file_manager/foreground/css/file_manager.css
--- a/ui/file_manager/file_manager/foreground/css/file_manager.css
+++ b/ui/file_manager/file_manager/foreground/css/file_manager.css
@@ -2290,3 +2290,49 @@
     --cros-sys-ripple_primary: color-mix(in srgb, #d1bcff 12%, transparent);
   }
 }
+
+/* AuraDE: the status bar at the foot of the file list.
+ *
+ * The panel is a column flexbox whose list is flex: auto, so a sibling placed
+ * after the list and given flex: none pins itself to the bottom and the list
+ * gives up exactly that much height. No positioning, no z-index, nothing that
+ * can drift out of alignment with the scrollbar.
+ *
+ * It exists because the app already computed this text and then threw it away.
+ * The directory summary is written into #files-selected-label, which
+ * file_manager.css sets to display: none unless body.check-select, so the one
+ * number worth having when nothing is selected was being rendered into a
+ * hidden element. This is where it goes instead.
+ *
+ * It carries visibleif="full-page" so the file picker dialogs, which are the
+ * same document, do not grow a status bar they have no use for.
+ */
+#aurade-status-bar {
+  align-items: center;
+  border-top: 1px solid var(--cros-sys-separator);
+  box-sizing: border-box;
+  color: var(--cros-sys-on_surface_variant);
+  display: flex;
+  flex: none;
+  font-size: 12px;
+  gap: 16px;
+  height: 28px;
+  justify-content: space-between;
+  padding: 0 16px;
+  user-select: none;
+}
+
+#aurade-status-count,
+#aurade-status-selection {
+  /* These are numbers that change in place as you move through a folder.
+   * Proportional digits make the text jitter every time the count ticks. */
+  font-variant-numeric: tabular-nums;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+#aurade-status-selection {
+  color: var(--cros-sys-primary);
+  text-align: end;
+}
