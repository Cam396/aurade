+
+  /**
+   * AuraDE: keeps the status bar current.
+   *
+   * The elements are held in locals rather than read back off this between the
+   * null check and the use. auraDeDirectorySummary_ is a method call, and a
+   * method call invalidates narrowing on a mutable property, so the checked
+   * fields would be nullable again by the time they were assigned to.
+   *
+   * The count is asked for on every update, including when something is
+   * selected, because auraDeDirectorySummary_ is what sets the title that
+   * carries the forty two note. Reading the title before that call would show
+   * whatever the previous folder left behind.
+   */
+  private auraDeUpdateStatusBar_(selectionText: string) {
+    const count = this.auraDeStatusCount_ ??
+        document.querySelector<HTMLElement>('#aurade-status-count');
+    const selectionEl = this.auraDeStatusSelection_ ??
+        document.querySelector<HTMLElement>('#aurade-status-selection');
+    if (!count || !selectionEl) {
+      return;
+    }
+    this.auraDeStatusCount_ = count;
+    this.auraDeStatusSelection_ = selectionEl;
+
+    const summary = this.auraDeDirectorySummary_();
+    // An empty folder still says so. A blank bar reads as broken.
+    count.textContent = summary || 'Empty folder';
+    count.title = this.filesSelectedLabel_.title;
+
+    // The toolbar already shows the selection in full when there is one, so
+    // repeating it here would be noise; this half stays empty until there is
+    // something to say.
+    selectionEl.textContent =
+        this.selectionHandler_.selection.totalCount === 0 ? '' : selectionText;
   }
 
