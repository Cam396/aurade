+// One filter an application offers: a name and its patterns, each a glob
+// (type 0) or a MIME type (type 1), as the portal hands them over.
+struct PortalFileFilter {
+  PortalFileFilter();
+  PortalFileFilter(const PortalFileFilter&);
+  PortalFileFilter& operator=(const PortalFileFilter&);
+  ~PortalFileFilter();
+
+  std::string name;
+  std::vector<std::pair<uint32_t, std::string>> patterns;
+};
+
+// The extensions a portal glob names, if it names any: "*.png" and GTK's
+// case-blind "*.[pP][nN][gG]" are both "png"; "*" and "*.*" name none.
+std::optional<std::string> ExtensionOfGlob(const std::string& glob);
+
+// The picker's file types for |filters|, with |current| chosen. Fills
+// |kept| with the index in |filters| of each type it made.
+ui::SelectFileDialog::FileTypeInfo FileTypesForFilters(
+    const std::vector<PortalFileFilter>& filters,
+    const std::optional<PortalFileFilter>& current,
+    int* file_type_index,
+    std::vector<size_t>* kept);
+
+// The file chooser half of AuraDE's xdg-desktop-portal backend. When a Linux
+// application asks the portal for a file to open or a place to save one,
+// the AuraDE Files picker asks, the one web pages and Ash itself use, rather
+// than GTK's own dialog. One picker shows at a time; later requests wait.
+class AuraDeFileChooserPortal final {
+ public:
+  AuraDeFileChooserPortal(scoped_refptr<dbus::Bus> bus,
+                          scoped_refptr<dbus::ExportedObject> portal_object);
+  AuraDeFileChooserPortal(const AuraDeFileChooserPortal&) = delete;
+  AuraDeFileChooserPortal& operator=(const AuraDeFileChooserPortal&) = delete;
+  ~AuraDeFileChooserPortal();
+
+ private:
+  class Request;
+  enum class Kind { kOpenFile, kSaveFile, kSaveFiles };
+
+  void HandleChoose(Kind kind,
+                    dbus::MethodCall* method_call,
+                    dbus::ExportedObject::ResponseSender response_sender);
+  void HandleClose(const std::string& handle,
+                   dbus::MethodCall* method_call,
+                   dbus::ExportedObject::ResponseSender response_sender);
+  void OnExported(const std::string& interface_name,
+                  const std::string& method_name,
+                  bool success);
+  // Shows the front request's picker, if it is not showing yet.
+  void ShowNext();
+  // Ends |request| and moves on to the next.
+  void Finish(Request* request);
+
+  scoped_refptr<dbus::Bus> bus_;
