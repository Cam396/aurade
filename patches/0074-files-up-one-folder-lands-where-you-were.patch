+  /**
+   * AuraDE: up one folder, landing on the one you just left.
+   *
+   * Going up used to leave nothing selected at all, so you arrived in a folder
+   * of thirteen things with no indication of which one you had just come out
+   * of, and had to find it again by reading. Every other file manager puts the
+   * cursor on it, and it is the difference between arriving somewhere and
+   * being put somewhere.
+   *
+   * Patch 0059 already restores the scroll position for the folder being
+   * returned to. This is the other half: the scroll says where you were
+   * looking, this says what you were looking at.
+   */
+  private auraDeGoUp_() {
+    const store = getStore();
+    const state = store.getState();
+    const components = state.currentDirectory?.pathComponents;
+    if (!components || components.length < 2) {
+      return;
+    }
+    const leaving = this.directoryModel_.getCurrentDirEntry();
+    const parent = components[components.length - 2]!;
+    if (leaving) {
+      this.auraDeSelectOnceScanned_(leaving);
+    }
+    store.dispatch(changeDirectory({toKey: parent.key}));
+  }
+
+  /**
+   * AuraDE: select an entry once the folder it lives in has finished loading.
+   *
+   * The directory change is asynchronous, so selecting straight after
+   * dispatching it would run against the file list of the folder being left.
+   *
+   * Both completion events, because a folder that is already cached need not
+   * be scanned again and announces itself as a rescan instead, and arriving
+   * somewhere familiar is the commonest case of going up there is. Whichever
+   * arrives first removes both.
+   *
+   * No check that the right folder loaded. selectEntry matches on URL against
+   * whatever list is current, so if something else has navigated in the
+   * meantime it finds nothing and does nothing, which is the correct outcome
+   * without needing to be told.
+   */
+  private auraDeSelectOnceScanned_(
+      entry: NonNullable<ReturnType<DirectoryModel['getCurrentDirEntry']>>) {
+    const model = this.directoryModel_;
+    const done = () => {
+      model.removeEventListener('cur-dir-scan-completed', done);
+      model.removeEventListener('cur-dir-rescan-completed', done);
+      model.selectEntry(entry as Entry);
+    };
+    model.addEventListener('cur-dir-scan-completed', done);
+    model.addEventListener('cur-dir-rescan-completed', done);
+  }
+
