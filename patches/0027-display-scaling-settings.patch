+base::DictValue GetAuraFeatureProfileValueOnBlockingThread() {
+  return AuraFeatureProfileStateToValue(GetAuraFeatureProfileState());
+}
+
+std::string BuildUpdatedAuraFeaturesConfig(const std::string& original,
+                                           const std::string& profile) {
+  if (original.empty()) {
+    return "# AuraDE feature settings\n" +
+           std::string(kAuraFeatureProfileEnv) + "=" + profile + "\n";
+  }
+
+  std::vector<std::string> output;
+  bool wrote_profile = false;
+
+  for (const std::string& line : base::SplitString(
+           original, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    std::string trimmed;
+    base::TrimWhitespaceASCII(line, base::TRIM_ALL, &trimmed);
+    const size_t separator = trimmed.find('=');
+    const std::string key =
+        separator == std::string::npos ? std::string()
+                                       : trimmed.substr(0, separator);
+    if (key == kAuraFeatureProfileEnv || key == "profile") {
+      output.push_back(std::string(kAuraFeatureProfileEnv) + "=" + profile);
+      wrote_profile = true;
+      continue;
+    }
+    output.push_back(line);
+  }
+
+  if (!wrote_profile) {
+    if (!output.empty() && !output.back().empty()) {
+      output.push_back(std::string());
+    }
+    output.push_back(std::string(kAuraFeatureProfileEnv) + "=" + profile);
+  }
+
+  return base::JoinString(output, "\n") + "\n";
+}
+
+bool WriteAuraFeatureProfile(const std::string& profile) {
+  const std::optional<base::FilePath> config_path =
+      GetAuraFeaturesConfigFile();
+  if (!config_path || !base::CreateDirectory(config_path->DirName())) {
+    return false;
+  }
+
+  std::string original;
+  base::ReadFileToString(*config_path, &original);
+  return base::WriteFile(*config_path,
+                         BuildUpdatedAuraFeaturesConfig(original, profile));
+}
+
+base::DictValue SetAuraFeatureProfileOnBlockingThread(
+    std::string requested_profile) {
+  requested_profile = NormalizeAuraFeatureProfile(requested_profile);
+
+  std::string status;
+  bool success = false;
+  if (requested_profile.empty()) {
+    status = "Unsupported feature profile";
+  } else if (!WriteAuraFeatureProfile(requested_profile)) {
+    status = "Unable to save feature profile";
+  } else {
+    status = "Ready";
+    success = true;
+  }
+
+  base::DictValue result =
+      AuraFeatureProfileStateToValue(GetAuraFeatureProfileState());
+  result.Set("success", success);
+  result.Set("status", status);
+  return result;
+}
+
+std::string GetConfiguredWestonMode() {
+  const std::optional<base::FilePath> config_path = GetWestonConfigFile();
+  if (!config_path) {
+    return std::string();
+  }
+
+  std::string contents;
+  if (!base::ReadFileToString(*config_path, &contents)) {
+    return std::string();
+  }
+
+  bool in_output_section = false;
+  for (const std::string& line : base::SplitString(
+           contents, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    std::string trimmed;
+    base::TrimWhitespaceASCII(line, base::TRIM_ALL, &trimmed);
+    if (trimmed.starts_with("[") && trimmed.ends_with("]")) {
+      in_output_section = trimmed == "[output]";
+      continue;
+    }
+    if (!in_output_section || !trimmed.starts_with("mode=")) {
+      continue;
+    }
+
+    const std::string mode = trimmed.substr(5);
+    return IsValidMode(mode) ? mode : std::string();
+  }
+
+  return std::string();
+}
+
+AuraDisplayState GetAuraDisplayState() {
+  AuraDisplayState state;
+
+  base::FileEnumerator drm_outputs(base::FilePath(kSysDrmPath),
+                                   /*recursive=*/false,
+                                   base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath output = drm_outputs.Next(); !output.empty();
+       output = drm_outputs.Next()) {
+    const std::string basename = output.BaseName().value();
+    if (!basename.starts_with("card") ||
+        basename.find('-') == std::string::npos) {
+      continue;
+    }
+
+    std::string modes_text;
+    if (!base::ReadFileToString(output.Append("modes"), &modes_text) ||
+        modes_text.empty()) {
+      continue;
+    }
+
+    state.connector = ConnectorNameFromPath(output);
+    for (std::string mode :
+         base::SplitString(modes_text, "\n", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY)) {
+      if (IsValidMode(mode) && std::find(state.modes.begin(), state.modes.end(),
+                                         mode) == state.modes.end()) {
+        state.modes.push_back(std::move(mode));
+      }
+    }
+    break;
+  }
+
+  state.configured_mode = GetConfiguredWestonMode();
+  state.configured_scale = GetConfiguredAuraDisplayScale();
+  state.current_scale = state.configured_scale;
+  state.available = !state.connector.empty() && !state.modes.empty();
+  return state;
+}
+
+base::DictValue AuraDisplayStateToValue(const AuraDisplayState& state) {
+  base::ListValue modes;
+  for (const std::string& mode : state.modes) {
+    modes.Append(mode);
+  }
+
+  base::DictValue value;
+  value.Set("available", state.available);
+  value.Set("connector", state.connector);
+  value.Set("configuredMode", state.configured_mode);
+  value.Set("currentMode", state.configured_mode);
+  value.Set("configuredScale", state.configured_scale);
+  value.Set("currentScale", state.current_scale);
+  value.Set("scaleAvailable", true);
+  value.Set("requiresRestart", true);
+  value.Set("modes", std::move(modes));
+  base::ListValue scale_options;
+  for (double scale : kAuraDisplayScaleOptions) {
+    scale_options.Append(scale);
+  }
+  value.Set("scaleOptions", std::move(scale_options));
+  value.Set("status", state.available ? "Ready" : "No DRM display modes found");
+  return value;
+}
+
+base::DictValue GetAuraDisplayValueOnBlockingThread() {
+  return AuraDisplayStateToValue(GetAuraDisplayState());
+}
+
+std::string BuildUpdatedWestonConfig(const std::string& original,
+                                     const std::string& connector,
+                                     const std::string& mode) {
+  std::vector<std::string> output;
+  bool in_output_section = false;
+  bool saw_output_section = false;
+  bool wrote_name = false;
+  bool wrote_mode = false;
+
+  auto finish_output_section = [&]() {
+    if (!in_output_section) {
+      return;
+    }
+    if (!wrote_name) {
+      output.push_back("name=" + connector);
+    }
+    if (!wrote_mode) {
+      output.push_back("mode=" + mode);
+    }
+    wrote_name = false;
+    wrote_mode = false;
+  };
+
+  for (const std::string& line : base::SplitString(
+           original, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    std::string trimmed;
+    base::TrimWhitespaceASCII(line, base::TRIM_ALL, &trimmed);
+    if (trimmed.starts_with("[") && trimmed.ends_with("]")) {
+      finish_output_section();
+      in_output_section = trimmed == "[output]";
+      saw_output_section |= in_output_section;
+      output.push_back(line);
+      continue;
+    }
+
+    if (in_output_section && trimmed.starts_with("name=")) {
+      output.push_back("name=" + connector);
+      wrote_name = true;
+      continue;
+    }
+    if (in_output_section && trimmed.starts_with("mode=")) {
+      output.push_back("mode=" + mode);
+      wrote_mode = true;
+      continue;
+    }
+
+    output.push_back(line);
+  }
+
+  finish_output_section();
+
+  if (!saw_output_section) {
+    if (!output.empty() && !output.back().empty()) {
+      output.push_back(std::string());
+    }
+    output.push_back("[output]");
+    output.push_back("name=" + connector);
+    output.push_back("mode=" + mode);
+  }
+
+  return base::JoinString(output, "\n") + "\n";
+}
+
+bool WriteWestonDisplayMode(const std::string& connector,
+                            const std::string& mode) {
+  const std::optional<base::FilePath> config_path = GetWestonConfigFile();
+  if (!config_path || !base::CreateDirectory(config_path->DirName())) {
+    return false;
+  }
+
+  std::string original;
+  base::ReadFileToString(*config_path, &original);
+  return base::WriteFile(*config_path,
+                         BuildUpdatedWestonConfig(original, connector, mode));
+}
+
+base::DictValue SetAuraDisplayModeOnBlockingThread(std::string requested_mode) {
+  AuraDisplayState state = GetAuraDisplayState();
+  const bool valid_mode = IsValidMode(requested_mode) &&
+                          std::find(state.modes.begin(), state.modes.end(),
+                                    requested_mode) != state.modes.end();
+
+  std::string status;
+  bool success = false;
+  if (!state.available) {
+    status = "No DRM display modes found";
+  } else if (!valid_mode) {
+    status = "Unsupported display mode";
+  } else if (!WriteWestonDisplayMode(state.connector, requested_mode)) {
+    status = "Unable to save display mode";
+  } else {
+    state.configured_mode = requested_mode;
+    status = "Ready";
+    success = true;
+  }
+
+  base::DictValue result = AuraDisplayStateToValue(state);
+  result.Set("success", success);
+  result.Set("status", status);
+  return result;
+}
+
+base::DictValue SetAuraDisplayScaleOnBlockingThread(double requested_scale) {
+  AuraDisplayState state = GetAuraDisplayState();
+
+  std::string status;
+  bool success = false;
+  if (!IsValidAuraDisplayScale(requested_scale)) {
+    status = "Unsupported display scale";
+  } else if (!WriteAuraDisplayScale(requested_scale)) {
+    status = "Unable to save display scale";
+  } else {
+    state.configured_scale = NormalizeAuraDisplayScale(requested_scale);
+    state.current_scale = state.configured_scale;
+    status = "Ready";
+    success = true;
+  }
+
+  base::DictValue result = AuraDisplayStateToValue(state);
+  result.Set("success", success);
+  result.Set("status", status);
+  return result;
+}
+
+double GetCurrentAuraDisplayScale() {
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return kAuraDisplayScaleDefault;
+  }
+
+  const display::Display& primary = display::Screen::Get()->GetPrimaryDisplay();
+  if (primary.id() == display::kInvalidDisplayId) {
+    return kAuraDisplayScaleDefault;
+  }
+
+  return NormalizeAuraDisplayScale(primary.device_scale_factor());
+}
+
+bool ApplyAuraDisplayScale(double scale) {
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return false;
+  }
+
+  scale = NormalizeAuraDisplayScale(scale);
+  auto env = base::Environment::Create();
+  env->SetVar(kAuraDisplayScaleEnv, base::NumberToString(scale));
+
+  display::DisplayManager* display_manager = Shell::Get()->display_manager();
+  if (!display_manager || display_manager->active_display_list().empty()) {
+    return false;
+  }
+
+  const display::Display& primary = display::Screen::Get()->GetPrimaryDisplay();
+  if (primary.id() == display::kInvalidDisplayId) {
+    return false;
+  }
+
+  display::ManagedDisplayInfo display_info =
+      display_manager->GetDisplayInfo(primary.id());
+  gfx::Rect native_bounds = display_info.bounds_in_native();
+  if (native_bounds.IsEmpty()) {
+    native_bounds = gfx::Rect(display_info.size_in_pixel());
+  }
+  if (native_bounds.IsEmpty()) {
+    return false;
+  }
+
+  const display::ManagedDisplayMode scaled_host_mode(
+      native_bounds.size(), display_info.refresh_rate(),
+      display_info.is_interlaced(), true, scale);
+
+  // AuraDE compatibility: use Ash's device scale factor for Linux desktop UI
+  // scaling. Unlike ChromeOS display zoom, this keeps the native host surface
+  // fixed while changing the DIP coordinate space used by shelf, wallpaper,
+  // windows, and web UI.
+  display_info.set_device_scale_factor(scale);
+  display_info.set_zoom_factor(1.f);
+  display_info.SetBounds(native_bounds);
+  display_info.SetManagedDisplayModes({scaled_host_mode});
+  display_info.AddZoomFactorForSize(native_bounds.size().ToString(), 1.f);
+
+  display::DisplayInfoList display_info_list;
+  for (const display::Display& active_display :
+       display_manager->active_display_list()) {
+    display_info_list.push_back(
+        active_display.id() == primary.id()
+            ? display_info
+            : display_manager->GetDisplayInfo(active_display.id()));
+  }
+  display_manager->OnNativeDisplaysChanged(display_info_list);
+  return true;
+}
