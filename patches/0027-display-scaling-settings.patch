+std::string ConnectorNameFromPath(const base::FilePath& path) {
+  const std::string basename = path.BaseName().value();
+  const size_t separator = basename.find('-');
+  if (separator == std::string::npos) {
+    return basename;
+  }
+  return basename.substr(separator + 1);
+}
+
+bool IsValidMode(const std::string& mode) {
+  const std::vector<std::string> parts = base::SplitString(
+      mode, "x", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.size() != 2) {
+    return false;
+  }
+
+  int width = 0;
+  int height = 0;
+  return base::StringToInt(parts[0], &width) &&
+         base::StringToInt(parts[1], &height) && width > 0 && height > 0 &&
+         width <= 10000 && height <= 10000;
