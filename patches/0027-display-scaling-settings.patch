+void DisplayHandler::ResolveAuraFeatureProfileInfo(std::string callback_id,
+                                                   base::DictValue info) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+
+  ResolveJavascriptCallback(base::Value(std::move(callback_id)), info);
+}
+
+void DisplayHandler::ResolveAuraFeatureProfile(std::string callback_id,
+                                               base::DictValue result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+
+  const bool success = result.FindBool("success").value_or(false);
+  if (!success) {
+    const std::string* status = result.FindString("status");
+    RejectJavascriptCallback(base::Value(std::move(callback_id)),
+                             base::Value(status ? *status : "Failed"));
+    return;
+  }
+
+  ResolveJavascriptCallback(base::Value(std::move(callback_id)), result);
+}
+
 }  // namespace ash::settings
