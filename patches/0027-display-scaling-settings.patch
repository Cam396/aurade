+  }
+
+  for (const std::string& line : base::SplitString(
+           contents, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (!line.starts_with("scale=")) {
+      continue;
+    }
+
+    double scale = kAuraDisplayScaleDefault;
+    if (base::StringToDouble(line.substr(6), &scale) &&
+        IsValidAuraDisplayScale(scale)) {
+      return scale;
+    }
+  }
+
+  return kAuraDisplayScaleDefault;
+}
+
+bool WriteAuraDisplayScale(double scale) {
+  const std::optional<base::FilePath> config_path = GetAuraDisplayConfigFile();
+  if (!config_path || !base::CreateDirectory(config_path->DirName())) {
+    return false;
+  }
+
+  scale = NormalizeAuraDisplayScale(scale);
+  return base::WriteFile(*config_path, "# AuraDE display settings\nscale=" +
+                                           base::NumberToString(scale) + "\n");
+}
+
+std::string NormalizeAuraFeatureProfile(std::string profile) {
+  std::string trimmed_profile;
+  base::TrimWhitespaceASCII(profile, base::TRIM_ALL, &trimmed_profile);
+  profile = std::move(trimmed_profile);
+  if (profile.size() >= 2 &&
+      ((profile.front() == '"' && profile.back() == '"') ||
+       (profile.front() == '\'' && profile.back() == '\''))) {
+    profile = profile.substr(1, profile.size() - 2);
+  }
+
+  profile = base::ToLowerASCII(profile);
+  if (profile == kAuraFeatureProfileStandard ||
+      profile == kAuraFeatureProfilePlus ||
+      profile == kAuraFeatureProfileAdvancedPlus ||
+      profile == kAuraFeatureProfileAdvancedPlusAi) {
+    return profile;
+  }
+  return std::string();
+}
+
+int GetPhysicalMemoryGiB() {
+  const uint64_t memory =
+      base::SysInfo::AmountOfTotalPhysicalMemory().InBytes();
+  if (memory == 0) {
+    return 0;
+  }
+  return static_cast<int>((memory + kBytesPerGiB - 1) / kBytesPerGiB);
+}
+
+std::string GetDefaultAuraFeatureProfile() {
+  const uint64_t memory =
+      base::SysInfo::AmountOfTotalPhysicalMemory().InBytes();
+  return memory >= kAuraPlusProfileMinRamBytes ? kAuraFeatureProfilePlus
+                                               : kAuraFeatureProfileStandard;
+}
+
+std::string GetConfiguredAuraFeatureProfile(bool* configured) {
+  *configured = false;
+  const std::string default_profile = GetDefaultAuraFeatureProfile();
+  const std::optional<base::FilePath> config_path =
+      GetAuraFeaturesConfigFile();
+  if (!config_path) {
+    return default_profile;
+  }
+
+  std::string contents;
+  if (!base::ReadFileToString(*config_path, &contents)) {
+    return default_profile;
+  }
+
+  for (const std::string& line : base::SplitString(
+           contents, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (line.starts_with("#")) {
+      continue;
+    }
+
+    const size_t separator = line.find('=');
+    if (separator == std::string::npos) {
+      continue;
+    }
+
+    const std::string key = line.substr(0, separator);
+    if (key != kAuraFeatureProfileEnv && key != "profile") {
+      continue;
+    }
+
+    const std::string profile =
+        NormalizeAuraFeatureProfile(line.substr(separator + 1));
+    if (!profile.empty()) {
+      *configured = true;
+      return profile;
+    }
+  }
+
+  return default_profile;
+}
+
+std::string GetCurrentAuraFeatureProfile(const std::string& fallback) {
+  auto env = base::Environment::Create();
+  std::optional<std::string> profile = env->GetVar(kAuraFeatureProfileEnv);
+  if (!profile || profile->empty()) {
+    return fallback;
+  }
+
+  const std::string normalized = NormalizeAuraFeatureProfile(*profile);
+  return normalized.empty() ? fallback : normalized;
+}
+
+AuraFeatureProfileState GetAuraFeatureProfileState() {
+  AuraFeatureProfileState state;
+  state.default_profile = GetDefaultAuraFeatureProfile();
+  state.memory_gb = GetPhysicalMemoryGiB();
+  state.configured_profile =
+      GetConfiguredAuraFeatureProfile(&state.configured);
+  state.current_profile = GetCurrentAuraFeatureProfile(state.configured_profile);
+  return state;
+}
+
+base::DictValue AuraFeatureProfileStateToValue(
+    const AuraFeatureProfileState& state) {
+  base::ListValue profiles;
+  profiles.Append(kAuraFeatureProfileStandard);
+  profiles.Append(kAuraFeatureProfilePlus);
+  profiles.Append(kAuraFeatureProfileAdvancedPlus);
+  profiles.Append(kAuraFeatureProfileAdvancedPlusAi);
+
+  base::DictValue value;
+  value.Set("available", state.available);
+  value.Set("configured", state.configured);
+  value.Set("configuredProfile", state.configured_profile);
+  value.Set("currentProfile", state.current_profile);
+  value.Set("defaultProfile", state.default_profile);
+  value.Set("memoryGb", state.memory_gb);
+  value.Set("profiles", std::move(profiles));
+  value.Set("requiresRestart",
+            state.configured_profile != state.current_profile);
+  value.Set("status", "Ready");
+  return value;
+}
