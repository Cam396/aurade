+
+void DisplayHandler::ResolveAuraDisplayMode(std::string callback_id,
+                                            base::DictValue result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+
+  const bool success = result.FindBool("success").value_or(false);
+  if (!success) {
+    const std::string* status = result.FindString("status");
+    RejectJavascriptCallback(base::Value(std::move(callback_id)),
+                             base::Value(status ? *status : "Failed"));
+    return;
+  }
+
+  ResolveJavascriptCallback(base::Value(std::move(callback_id)), result);
+}
+
+void DisplayHandler::ResolveAuraDisplayScale(std::string callback_id,
+                                             base::DictValue result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+
+  const bool success = result.FindBool("success").value_or(false);
+  if (!success) {
+    const std::string* status = result.FindString("status");
+    RejectJavascriptCallback(base::Value(std::move(callback_id)),
+                             base::Value(status ? *status : "Failed"));
+    return;
+  }
+
+  const std::optional<double> scale = result.FindDouble("configuredScale");
+  if (!scale || !ApplyAuraDisplayScale(*scale)) {
+    RejectJavascriptCallback(base::Value(std::move(callback_id)),
+                             base::Value("Unable to apply display scale"));
+    return;
+  }
+
+  result.Set("currentScale", GetCurrentAuraDisplayScale());
+  ResolveJavascriptCallback(base::Value(std::move(callback_id)), result);
+}
