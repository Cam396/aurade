+// AuraDE: an unclean shutdown can leave an installed app's icon files at zero
+// bytes. Chrome never fetches them again and the manifest update refuses to run
+// over icons it cannot read, so the app keeps a blank icon for good. Returns
+// the install URLs of the apps whose resources hold an empty icon.
+std::vector<GURL> FindAppsWithEmptyIcons(
+    std::vector<std::pair<GURL, base::FilePath>> app_dirs) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  std::vector<GURL> broken;
+  for (const auto& [install_url, dir] : app_dirs) {
+    // ALL, because the default only walks into folders that match the
+    // pattern, and the icons sit in folders such as "Icons".
+    base::FileEnumerator icons(
+        dir, /*recursive=*/true, base::FileEnumerator::FILES,
+        FILE_PATH_LITERAL("*.png"),
+        base::FileEnumerator::FolderSearchPolicy::ALL);
+    for (base::FilePath icon = icons.Next(); !icon.empty();
+         icon = icons.Next()) {
+      if (icons.GetInfo().GetSize() == 0) {
+        broken.push_back(install_url);
+        break;
+      }
+    }
+  }
+  return broken;
+}
+
+void ForceReinstallAppsWithEmptyIcons(
+    PreinstalledWebAppManager::ConsumeInstallOptions callback,
+    std::vector<ExternalInstallOptions> options_list,
+    std::vector<GURL> broken) {
+  for (ExternalInstallOptions& options : options_list) {
+    if (std::ranges::contains(broken, options.install_url)) {
+      LOG(WARNING) << "Reinstalling " << options.install_url
+                   << " to replace its empty icon files";
+      options.force_reinstall = true;
+    }
+  }
+  std::move(callback).Run(std::move(options_list));
+}
+
