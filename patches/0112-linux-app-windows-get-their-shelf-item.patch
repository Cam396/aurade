+Profile* AppServiceAppWindowCrostiniTracker::PrimaryProfile() const {
+  Profile* profile = ash::ProfileHelper::Get()->GetProfileByAccountId(
+      user_manager::UserManager::Get()->GetPrimaryUser()->GetAccountId());
+  // AuraDE compatibility: the desktop's own Linux applications belong to its
+  // one user, whose profile the shelf already holds. The lookup by account can
+  // come back empty in an AuraDE session, and then no Linux application window
+  // was ever matched to its app: none had a shelf item or a running dot,
+  // however it was started.
+  if (!profile && !base::SysInfo::IsRunningOnChromeOS()) {
+    static bool logged = false;
+    LOG_IF(WARNING, !std::exchange(logged, true))
+        << "AuraDE: Linux app windows are matched in the shelf's profile";
+    profile = app_service_controller_->owner()->profile();
+  }
+  return profile;
+}
