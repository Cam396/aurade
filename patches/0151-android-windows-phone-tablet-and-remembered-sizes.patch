+
+void ArcResizeLockManager::RestoreWindowSize(aura::Window* window) {
+  if (!pref_delegate_ || !size_restored_windows_.insert(window).second) {
+    return;
+  }
+  const auto app_id = GetAppId(window);
+  if (!app_id) {
+    return;
+  }
+  const std::optional<gfx::Size> saved = pref_delegate_->GetSavedWindowSize(*app_id);
+  views::Widget* const widget = views::Widget::GetWidgetForNativeWindow(window);
+  if (!saved || !widget || widget->GetWindowBoundsInScreen().size() == *saved) {
+    return;
+  }
+  // A saved size means the user had the window in its normal state.
+  window->SetProperty(aura::client::kShowStateKey,
+                      ui::mojom::WindowShowState::kNormal);
+  widget->CenterWindow(*saved);
+  // Phone and Tablet stay chosen too: nothing on the Android side reports the
+  // mode back, so the window is told what the app was left at.
+  if (pref_delegate_->GetSavedWindowLocked(*app_id)) {
+    window->SetProperty(ash::kArcResizeLockTypeKey,
+                        ash::ArcResizeLockType::RESIZE_DISABLED_TOGGLABLE);
+  }
+}
+
+void ArcResizeLockManager::SaveWindowSize(aura::Window* window) {
+  if (!pref_delegate_ || !window->IsVisible()) {
+    return;
+  }
+  const auto app_id = GetAppId(window);
+  if (!app_id) {
+    return;
+  }
+  // A maximized, full screen or snapped window has the screen's size, not one
+  // the user picked for the app.
+  if (window->GetProperty(aura::client::kShowStateKey) !=
+      ui::mojom::WindowShowState::kNormal) {
+    return;
+  }
+  views::Widget* const widget = views::Widget::GetWidgetForNativeWindow(window);
+  if (!widget) {
+    return;
+  }
+  pref_delegate_->SetSavedWindowSize(
+      *app_id, widget->GetWindowBoundsInScreen().size(),
+      window->GetProperty(ash::kArcResizeLockTypeKey) ==
+          ash::ArcResizeLockType::RESIZE_DISABLED_TOGGLABLE);
 }
 
