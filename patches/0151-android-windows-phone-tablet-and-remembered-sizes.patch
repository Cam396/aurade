+std::optional<gfx::Size> ArcAppListPrefs::GetSavedWindowSize(
+    const std::string& app_id) const {
+  // Kept apart from the app's own entry: a refresh of the app list drops and
+  // re-adds entries, and the size has to outlive that.
+  const base::DictValue* entry =
+      prefs_->GetDict(kAuraDEWindowSizes).FindDict(app_id);
+  if (!entry) {
+    return std::nullopt;
+  }
+  const std::optional<int> width = entry->FindInt("width");
+  const std::optional<int> height = entry->FindInt("height");
+  if (!width || !height || *width <= 0 || *height <= 0) {
+    return std::nullopt;
+  }
+  return gfx::Size(*width, *height);
+}
+
+bool ArcAppListPrefs::GetSavedWindowLocked(const std::string& app_id) const {
+  const base::DictValue* entry =
+      prefs_->GetDict(kAuraDEWindowSizes).FindDict(app_id);
+  return entry && entry->FindBool("locked").value_or(false);
+}
+
+void ArcAppListPrefs::SetSavedWindowSize(const std::string& app_id,
+                                         const gfx::Size& size,
+                                         bool locked) {
+  ScopedDictPrefUpdate update(prefs_, kAuraDEWindowSizes);
+  base::DictValue entry;
+  entry.Set("width", size.width());
+  entry.Set("height", size.height());
+  entry.Set("locked", locked);
+  update->Set(app_id, std::move(entry));
+}
