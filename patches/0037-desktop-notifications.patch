+TEST_F(DesktopNotificationServiceTest, CloseNotificationSignalsRequest) {
+  std::unique_ptr<dbus::Response> response = NotifyDirect(NotifyOptions());
+  ASSERT_TRUE(response);
+  const uint32_t notification_id = ReadNotificationId(response.get());
+
+  dbus::MethodCall close_call(kInterfaceName, "CloseNotification");
+  dbus::MessageWriter close_writer(&close_call);
+  close_writer.AppendUint32(notification_id);
+  response = CallMethod(&close_call);
+  ASSERT_TRUE(response);
+  EXPECT_EQ(dbus::Message::MESSAGE_METHOD_RETURN, response->GetMessageType());
+  EXPECT_EQ("NotificationClosed", signal_name_);
+  EXPECT_EQ(notification_id, signal_notification_id_);
+  EXPECT_EQ(3u, signal_close_reason_);
+  EXPECT_FALSE(message_center::MessageCenter::Get()->FindNotificationById(
+      "freedesktop:" + std::to_string(notification_id)));
+}
