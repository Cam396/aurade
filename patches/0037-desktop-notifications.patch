+TEST_F(DesktopNotificationServiceTest, ResolvesIconNameFromTheme) {
+  base::ScopedTempDir home;
+  ASSERT_TRUE(home.CreateUniqueTempDir());
+  base::ScopedEnvironmentVariableOverride home_override("HOME",
+                                                        home.GetPath().value());
+  const base::FilePath icon_directory =
+      home.GetPath().AppendASCII(".local/share/icons/hicolor/48x48/apps");
+  ASSERT_TRUE(base::CreateDirectory(icon_directory));
+
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(3, 3);
+  bitmap.eraseColor(SK_ColorBLUE);
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false);
+  ASSERT_TRUE(png);
+  ASSERT_TRUE(base::WriteFile(
+      icon_directory.AppendASCII("aurade-notification-test.png"), *png));
+
+  NotifyOptions options;
+  options.icon = "aurade-notification-test";
+  std::unique_ptr<dbus::Response> response = NotifyDirect(options);
+  ASSERT_TRUE(response);
+  const uint32_t notification_id = ReadNotificationId(response.get());
+  task_environment_.RunUntilIdle();
+
+  message_center::Notification* notification =
+      message_center::MessageCenter::Get()->FindNotificationById(
+          "freedesktop:" + std::to_string(notification_id));
+  ASSERT_TRUE(notification);
+  EXPECT_FALSE(notification->icon().IsEmpty());
+  EXPECT_EQ(3, notification->icon().Size().width());
+  EXPECT_EQ(3, notification->icon().Size().height());
+}
