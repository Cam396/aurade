+base::FilePath ResolveNamedIcon(const std::string& icon_name) {
+  if (icon_name.empty() || icon_name.size() > kMaxIconNameBytes ||
+      !base::IsStringUTF8(icon_name)) {
+    return base::FilePath();
+  }
+
+  const base::FilePath input(icon_name);
+  if (input.IsAbsolute()) {
+    return base::ToLowerASCII(input.Extension()) == ".png" &&
+                   base::PathExists(input)
+               ? input
+               : base::FilePath();
+  }
+  if (input.BaseName().value() != icon_name || icon_name == "." ||
+      icon_name == "..") {
+    return base::FilePath();
+  }
+
+  std::vector<std::string> names;
+  if (base::ToLowerASCII(input.Extension()) == ".png") {
+    names.push_back(icon_name);
+  } else if (input.Extension().empty()) {
+    names.push_back(icon_name + ".png");
+  } else {
+    return base::FilePath();
+  }
+
+  for (const base::FilePath& directory : IconSearchDirectories()) {
+    for (const std::string& name : names) {
+      const base::FilePath candidate = directory.AppendASCII(name);
+      if (base::PathExists(candidate)) {
+        return candidate;
+      }
+    }
+  }
+  return base::FilePath();
+}
+
+gfx::Image LoadNamedIconOnBlockingThread(std::string icon_name) {
+  const base::FilePath path = ResolveNamedIcon(icon_name);
+  if (path.empty()) {
+    return gfx::Image();
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, kMaxImageBytes)) {
+    return gfx::Image();
+  }
+  SkBitmap bitmap = gfx::PNGCodec::Decode(base::as_byte_span(contents));
+  if (bitmap.drawsNothing() || bitmap.width() > kMaxImageDimension ||
+      bitmap.height() > kMaxImageDimension) {
+    return gfx::Image();
+  }
+  return gfx::Image::CreateFrom1xBitmap(bitmap);
+}
