+
+bool DesktopNotificationService::ParseNotifyRequest(
+    dbus::MethodCall* method_call,
+    NotifyRequest* request,
+    std::string* error_message) {
+  if (method_call->GetSignature() != "susssasa{sv}i") {
+    *error_message = "Notify has invalid arguments.";
+    return false;
+  }
+
+  dbus::MessageReader reader(method_call);
+  std::vector<std::string> action_strings;
+  dbus::MessageReader hints_reader(nullptr);
+  if (!reader.PopString(&request->app_name) ||
+      !reader.PopUint32(&request->replaces_id) ||
+      !reader.PopString(&request->app_icon) ||
+      !reader.PopString(&request->summary) ||
+      !reader.PopString(&request->body) ||
+      !reader.PopArrayOfStrings(&action_strings) ||
+      !reader.PopArray(&hints_reader)) {
+    *error_message = "Notify has invalid arguments.";
+    return false;
+  }
+
+  size_t total_text_bytes = 0;
+  if (!AddTextSize(request->app_name, &total_text_bytes) ||
+      !AddTextSize(request->summary, &total_text_bytes) ||
+      !AddTextSize(request->body, &total_text_bytes) ||
+      request->app_icon.size() > kMaxIconNameBytes ||
+      !base::IsStringUTF8(request->app_icon)) {
+    *error_message = "Notify contains invalid or oversized text.";
+    return false;
+  }
+  if (action_strings.size() % 2 != 0 ||
+      action_strings.size() > kMaxActionStrings) {
+    *error_message = "Notify contains an invalid action list.";
+    return false;
+  }
+
+  size_t action_button_count = 0;
+  for (size_t index = 0; index < action_strings.size(); index += 2) {
+    if (!AddTextSize(action_strings[index], &total_text_bytes) ||
+        !AddTextSize(action_strings[index + 1], &total_text_bytes) ||
+        action_strings[index].empty()) {
+      *error_message = "Notify contains an invalid action.";
+      return false;
+    }
+    if (action_strings[index] == "default") {
+      request->default_action = action_strings[index];
+      continue;
+    }
+    ++action_button_count;
+    request->actions.emplace_back(action_strings[index],
+                                  action_strings[index + 1]);
+  }
+  if (action_button_count > kMaxActionButtons) {
+    *error_message = "Notify contains too many action buttons.";
+    return false;
+  }
+
+  size_t hint_count = 0;
+  while (hints_reader.HasMoreData()) {
+    if (++hint_count > kMaxHints) {
+      *error_message = "Notify contains too many hints.";
+      return false;
+    }
+    dbus::MessageReader entry_reader(nullptr);
+    dbus::MessageReader variant_reader(nullptr);
+    std::string key;
+    if (!hints_reader.PopDictEntry(&entry_reader) ||
+        !entry_reader.PopString(&key) ||
+        !entry_reader.PopVariant(&variant_reader) ||
+        entry_reader.HasMoreData() || !base::IsStringUTF8(key) ||
+        key.size() > 256) {
+      *error_message = "Notify contains an invalid hint.";
+      return false;
+    }
+
+    if (key == "urgency") {
+      if (!variant_reader.PopByte(&request->urgency) ||
+          variant_reader.HasMoreData() || request->urgency > 2) {
+        *error_message = "The urgency hint is invalid.";
+        return false;
+      }
+    } else if (key == "resident") {
+      if (!variant_reader.PopBool(&request->resident) ||
+          variant_reader.HasMoreData()) {
+        *error_message = "The resident hint is invalid.";
+        return false;
+      }
+    } else if (key == "desktop-entry") {
+      if (!variant_reader.PopString(&request->desktop_entry) ||
+          variant_reader.HasMoreData() ||
+          !AddTextSize(request->desktop_entry, &total_text_bytes)) {
+        *error_message = "The desktop-entry hint is invalid.";
+        return false;
+      }
+    } else if (key == "image-path" || key == "image_path") {
+      if (!variant_reader.PopString(&request->image_path) ||
+          variant_reader.HasMoreData() ||
+          request->image_path.size() > kMaxIconNameBytes ||
+          !base::IsStringUTF8(request->image_path)) {
+        *error_message = "The image path hint is invalid.";
+        return false;
+      }
+    } else if (key == "image-data" || key == "image_data" ||
+               key == "icon_data") {
+      std::optional<gfx::Image> image =
+          ReadRawImage(&variant_reader, error_message);
+      if (!image) {
+        return false;
+      }
+      request->raw_icon = std::move(*image);
+    }
+  }
+
+  if (!reader.PopInt32(&request->expire_timeout) || reader.HasMoreData() ||
+      request->expire_timeout < -1) {
+    *error_message = "The expiration timeout is invalid.";
+    return false;
+  }
+  return true;
+}
+
+uint32_t DesktopNotificationService::AllocateNotificationId() {
+  for (size_t attempt = 0; attempt <= notifications_.size(); ++attempt) {
+    const uint32_t candidate = next_notification_id_++;
+    if (next_notification_id_ == 0) {
+      next_notification_id_ = 1;
+    }
+    if (candidate != 0 && !notifications_.contains(candidate)) {
+      return candidate;
+    }
+  }
+  return 0;
+}
+
+void DesktopNotificationService::HandleNotify(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  NotifyRequest request;
+  std::string error_message;
+  if (!ParseNotifyRequest(method_call, &request, &error_message)) {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call, error_message));
+    return;
+  }
+
+  message_center::MessageCenter* message_center =
+      message_center::MessageCenter::Get();
+  if (!message_center) {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call,
+                              "The notification center is not available."));
+    return;
+  }
+
+  const bool replacing =
+      request.replaces_id != 0 && notifications_.contains(request.replaces_id);
+  if (!replacing && notifications_.size() >= kMaxNotifications) {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call,
+                              "The notification limit has been reached."));
+    return;
+  }
+
+  const uint32_t notification_id =
+      replacing ? request.replaces_id : AllocateNotificationId();
+  if (notification_id == 0) {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call,
+                              "A notification identifier is not available."));
+    return;
+  }
+
+  std::unique_ptr<NotificationRecord> new_record;
+  NotificationRecord* record = nullptr;
+  if (replacing) {
+    record = notifications_.at(notification_id).get();
+    record->expiration_timer.Stop();
+    record->pending_close_reason.reset();
+    record->button_action_keys.clear();
+  } else {
+    new_record = std::make_unique<NotificationRecord>();
+    record = new_record.get();
+    record->id = notification_id;
+    record->message_center_id =
+        "freedesktop:" + base::NumberToString(notification_id);
+  }
+  record->generation = next_generation_++;
+  record->default_action = request.default_action;
+  record->resident = request.resident;
+
+  message_center::RichNotificationData rich_data;
+  switch (request.urgency) {
+    case 0:
+      rich_data.priority = message_center::LOW_PRIORITY;
+      break;
+    case 2:
+      rich_data.priority = message_center::MAX_PRIORITY;
+      rich_data.never_timeout = true;
+      break;
+    default:
+      rich_data.priority = message_center::DEFAULT_PRIORITY;
+      break;
+  }
+  if (request.expire_timeout == 0) {
+    rich_data.never_timeout = true;
+  }
+  for (const auto& [action_key, label] : request.actions) {
+    record->button_action_keys.push_back(action_key);
+    rich_data.buttons.emplace_back(base::UTF8ToUTF16(label));
+  }
+
+  ui::ImageModel icon;
+  if (request.raw_icon) {
+    icon = ui::ImageModel::FromImage(*request.raw_icon);
+  }
+  const std::string source =
+      !request.app_name.empty()
+          ? request.app_name
+          : (!request.desktop_entry.empty() ? request.desktop_entry
+                                            : "Application");
+  const std::string notifier =
+      !request.desktop_entry.empty() ? request.desktop_entry : source;
+  message_center::NotifierId notifier_id(
+      message_center::NotifierType::APPLICATION, notifier);
+  auto notification = std::make_unique<message_center::Notification>(
+      message_center::NOTIFICATION_TYPE_SIMPLE, record->message_center_id,
+      base::UTF8ToUTF16(request.summary), base::UTF8ToUTF16(request.body), icon,
+      base::UTF8ToUTF16(source), GURL(), notifier_id, rich_data,
+      base::MakeRefCounted<NotificationDelegate>(weak_ptr_factory_.GetWeakPtr(),
+                                                 notification_id));
+
+  if (replacing) {
+    message_center->UpdateNotification(record->message_center_id,
+                                       std::move(notification));
+  } else {
+    notifications_.emplace(notification_id, std::move(new_record));
+    message_center->AddNotification(std::move(notification));
+  }
+
+  ScheduleExpiration(notification_id, request.expire_timeout, request.urgency);
+  if (!request.raw_icon) {
+    const std::string named_icon =
+        !request.image_path.empty() ? request.image_path : request.app_icon;
+    if (!named_icon.empty()) {
+      LoadNamedIcon(notification_id, record->generation, named_icon);
+    }
+  }
+
+  auto response = dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter writer(response.get());
+  writer.AppendUint32(notification_id);
+  std::move(response_sender).Run(std::move(response));
+}
+
+void DesktopNotificationService::ScheduleExpiration(uint32_t notification_id,
+                                                    int32_t expire_timeout,
+                                                    uint8_t urgency) {
+  auto iterator = notifications_.find(notification_id);
+  if (iterator == notifications_.end() || expire_timeout == 0 || urgency == 2) {
+    return;
+  }
+  const base::TimeDelta delay = expire_timeout < 0
+                                    ? kDefaultExpiration
+                                    : base::Milliseconds(expire_timeout);
+  iterator->second->expiration_timer.Start(
+      FROM_HERE, delay,
+      base::BindOnce(&DesktopNotificationService::ExpireNotification,
+                     weak_ptr_factory_.GetWeakPtr(), notification_id));
+}
+
+void DesktopNotificationService::ExpireNotification(uint32_t notification_id) {
+  CloseNotification(notification_id, kClosedExpired);
+}
+
+void DesktopNotificationService::HandleCloseNotification(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  if (method_call->GetSignature() != "u") {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call,
+                              "CloseNotification has invalid arguments."));
+    return;
+  }
+  dbus::MessageReader reader(method_call);
+  uint32_t notification_id = 0;
+  if (!reader.PopUint32(&notification_id) || reader.HasMoreData()) {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call,
+                              "CloseNotification has invalid arguments."));
+    return;
+  }
+  if (!notifications_.contains(notification_id)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, kInvalidNotificationError,
+            "The notification is not active."));
+    return;
+  }
+  CloseNotification(notification_id, kClosedByRequest);
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+
+void DesktopNotificationService::HandleGetCapabilities(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  if (!method_call->GetSignature().empty()) {
+    std::move(response_sender)
+        .Run(InvalidArguments(method_call,
+                              "GetCapabilities does not accept arguments."));
+    return;
+  }
+  auto response = dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter writer(response.get());
+  writer.AppendArrayOfStrings({"actions", "body", "icon-static"});
+  std::move(response_sender).Run(std::move(response));
+}
+
+void DesktopNotificationService::HandleGetServerInformation(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  if (!method_call->GetSignature().empty()) {
+    std::move(response_sender)
+        .Run(InvalidArguments(
+            method_call, "GetServerInformation does not accept arguments."));
+    return;
+  }
+  auto response = dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter writer(response.get());
+  writer.AppendString("AuraDE");
+  writer.AppendString("AuraDE");
+  writer.AppendString("0.2.0");
+  writer.AppendString("1.2");
+  std::move(response_sender).Run(std::move(response));
+}
+
+void DesktopNotificationService::CloseNotification(uint32_t notification_id,
+                                                   uint32_t reason) {
+  auto iterator = notifications_.find(notification_id);
+  if (iterator == notifications_.end()) {
+    return;
+  }
+  iterator->second->pending_close_reason = reason;
+  message_center::MessageCenter* message_center =
+      message_center::MessageCenter::Get();
+  if (message_center && message_center->FindNotificationById(
+                            iterator->second->message_center_id)) {
+    message_center->RemoveNotification(iterator->second->message_center_id,
+                                       reason == kClosedByUser);
+    return;
+  }
+  EmitNotificationClosed(notification_id, reason);
+  notifications_.erase(iterator);
+}
+
+void DesktopNotificationService::OnNotificationClosed(uint32_t notification_id,
+                                                      bool by_user) {
+  auto iterator = notifications_.find(notification_id);
+  if (iterator == notifications_.end()) {
+    return;
+  }
+  const uint32_t reason = iterator->second->pending_close_reason.value_or(
+      by_user ? kClosedByUser : kClosedByRequest);
+  iterator->second->expiration_timer.Stop();
+  EmitNotificationClosed(notification_id, reason);
+  notifications_.erase(iterator);
+}
+
+void DesktopNotificationService::OnNotificationClicked(
+    uint32_t notification_id,
+    const std::optional<int>& button_index) {
+  auto iterator = notifications_.find(notification_id);
+  if (iterator == notifications_.end()) {
+    return;
+  }
+
+  std::string action_key;
+  if (button_index) {
+    if (*button_index < 0 || static_cast<size_t>(*button_index) >=
+                                 iterator->second->button_action_keys.size()) {
+      return;
+    }
+    action_key = iterator->second->button_action_keys[*button_index];
+  } else {
+    action_key = iterator->second->default_action;
+  }
+  if (action_key.empty()) {
+    return;
+  }
+
+  const bool resident = iterator->second->resident;
+  EmitActionInvoked(notification_id, action_key);
+  if (!resident) {
+    CloseNotification(notification_id, kClosedByUser);
+  }
+}
+
+void DesktopNotificationService::EmitNotificationClosed(
+    uint32_t notification_id,
+    uint32_t reason) {
+  if (!exported_object_) {
+    return;
+  }
+  dbus::Signal signal(kInterfaceName, kClosedSignal);
+  dbus::MessageWriter writer(&signal);
+  writer.AppendUint32(notification_id);
+  writer.AppendUint32(reason);
+  exported_object_->SendSignal(&signal);
+}
+
+void DesktopNotificationService::EmitActionInvoked(
+    uint32_t notification_id,
+    const std::string& action_key) {
+  if (!exported_object_) {
+    return;
+  }
+  dbus::Signal signal(kInterfaceName, kActionSignal);
+  dbus::MessageWriter writer(&signal);
+  writer.AppendUint32(notification_id);
+  writer.AppendString(action_key);
+  exported_object_->SendSignal(&signal);
+}
+
+void DesktopNotificationService::LoadNamedIcon(uint32_t notification_id,
+                                               uint64_t generation,
+                                               std::string icon_name) {
+  if (pending_icon_loads_ >= kMaxPendingIconLoads) {
+    return;
+  }
+  ++pending_icon_loads_;
+  if (!base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+          base::BindOnce(&LoadNamedIconOnBlockingThread, std::move(icon_name)),
+          base::BindOnce(&DesktopNotificationService::OnNamedIconLoaded,
+                         weak_ptr_factory_.GetWeakPtr(), notification_id,
+                         generation))) {
+    --pending_icon_loads_;
+  }
+}
+
+void DesktopNotificationService::OnNamedIconLoaded(uint32_t notification_id,
+                                                   uint64_t generation,
+                                                   gfx::Image image) {
+  CHECK_GT(pending_icon_loads_, 0u);
+  --pending_icon_loads_;
+  auto iterator = notifications_.find(notification_id);
+  if (iterator == notifications_.end() ||
+      iterator->second->generation != generation || image.IsEmpty()) {
+    return;
+  }
+  if (message_center::MessageCenter* message_center =
+          message_center::MessageCenter::Get()) {
+    message_center->SetNotificationIcon(iterator->second->message_center_id,
+                                        ui::ImageModel::FromImage(image));
+  }
+}
+
+DesktopNotificationServiceHost::DesktopNotificationServiceHost() = default;
+
+DesktopNotificationServiceHost::~DesktopNotificationServiceHost() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  service_.reset();
+  exported_object_.reset();
+  if (bus_) {
+    bus_->ShutdownOnDBusThreadAndBlock();
+    bus_.reset();
+  }
+  if (dbus_thread_) {
+    dbus_thread_->Stop();
+  }
+}
+
+// static
+std::unique_ptr<DesktopNotificationServiceHost>
+DesktopNotificationServiceHost::Create() {
+  auto host = std::unique_ptr<DesktopNotificationServiceHost>(
+      new DesktopNotificationServiceHost());
+  if (!host->Start()) {
+    return nullptr;
+  }
+  return host;
+}
+
+bool DesktopNotificationServiceHost::Start() {
+  dbus_thread_ =
+      std::make_unique<base::Thread>("AuraDE notification D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!dbus_thread_->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "AuraDE notification service could not start its D-Bus "
+                  "thread";
+    return false;
+  }
+
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SESSION;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = dbus_thread_->task_runner();
+  bus_ = new dbus::Bus(std::move(bus_options));
+  exported_object_ = bus_->GetExportedObject(dbus::ObjectPath(kObjectPath));
+  service_ = std::make_unique<DesktopNotificationService>();
+  service_->Start(exported_object_);
+  bus_->RequestOwnership(
+      kServiceName, dbus::Bus::REQUIRE_PRIMARY_ALLOW_REPLACEMENT,
+      base::BindOnce(&DesktopNotificationServiceHost::OnOwnership,
+                     weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
+
+void DesktopNotificationServiceHost::OnOwnership(
+    const std::string& service_name,
+    bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE could not own " << service_name;
+}
+
+}  // namespace ash
