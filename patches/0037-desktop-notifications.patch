+std::optional<gfx::Image> ReadRawImage(dbus::MessageReader* variant_reader,
+                                       std::string* error_message) {
+  dbus::MessageReader struct_reader(nullptr);
+  int32_t width = 0;
+  int32_t height = 0;
+  int32_t row_stride = 0;
+  bool has_alpha = false;
+  int32_t bits_per_sample = 0;
+  int32_t channels = 0;
+  base::span<const uint8_t> bytes;
+  if (!variant_reader->PopStruct(&struct_reader) ||
+      !struct_reader.PopInt32(&width) || !struct_reader.PopInt32(&height) ||
+      !struct_reader.PopInt32(&row_stride) ||
+      !struct_reader.PopBool(&has_alpha) ||
+      !struct_reader.PopInt32(&bits_per_sample) ||
+      !struct_reader.PopInt32(&channels) ||
+      !struct_reader.PopArrayOfBytes(&bytes) || struct_reader.HasMoreData() ||
+      variant_reader->HasMoreData()) {
+    *error_message = "The image-data hint has invalid fields.";
+    return std::nullopt;
+  }
+
+  const int32_t expected_channels = has_alpha ? 4 : 3;
+  if (width <= 0 || height <= 0 || width > kMaxImageDimension ||
+      height > kMaxImageDimension || row_stride <= 0 || bits_per_sample != 8 ||
+      channels != expected_channels) {
+    *error_message = "The image-data hint has unsupported dimensions.";
+    return std::nullopt;
+  }
+
+  base::CheckedNumeric<size_t> minimum_row = width;
+  minimum_row *= channels;
+  base::CheckedNumeric<size_t> expected_size = row_stride;
+  expected_size *= height;
+  if (!minimum_row.IsValid() || !expected_size.IsValid() ||
+      static_cast<size_t>(row_stride) < minimum_row.ValueOrDie() ||
+      expected_size.ValueOrDie() != bytes.size() ||
+      bytes.size() > kMaxImageBytes) {
+    *error_message = "The image-data hint is too large or incomplete.";
+    return std::nullopt;
+  }
+
+  std::vector<SkColor> pixels(static_cast<size_t>(width) * height);
+  for (size_t y = 0; y < static_cast<size_t>(height); ++y) {
+    const base::span<const uint8_t> source_row = bytes.subspan(
+        y * static_cast<size_t>(row_stride), minimum_row.ValueOrDie());
+    for (size_t x = 0; x < static_cast<size_t>(width); ++x) {
+      const base::span<const uint8_t> source_pixel = source_row.subspan(
+          x * static_cast<size_t>(channels), static_cast<size_t>(channels));
+      pixels.at(y * static_cast<size_t>(width) + x) =
+          SkPreMultiplyARGB(has_alpha ? source_pixel[3] : 255, source_pixel[0],
+                            source_pixel[1], source_pixel[2]);
+    }
+  }
+
+  const SkImageInfo image_info = SkImageInfo::MakeN32Premul(width, height);
+  const SkPixmap source_pixmap(image_info, pixels.data(),
+                               image_info.minRowBytes());
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(image_info)) {
+    *error_message = "The image-data hint cannot be allocated.";
+    return std::nullopt;
+  }
+  if (!bitmap.writePixels(source_pixmap)) {
+    *error_message = "The image-data hint cannot be copied.";
+    return std::nullopt;
+  }
+  bitmap.setImmutable();
+  return gfx::Image::CreateFrom1xBitmap(bitmap);
+}
