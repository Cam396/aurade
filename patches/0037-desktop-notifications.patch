+TEST_F(DesktopNotificationServiceTest, RejectsMalformedRequestsAndRecovers) {
+  dbus::MethodCall wrong_count(kInterfaceName, "Notify");
+  dbus::MessageWriter wrong_count_writer(&wrong_count);
+  wrong_count_writer.AppendString("only one argument");
+  std::unique_ptr<dbus::Response> response = CallNotifyDirect(&wrong_count);
+  ASSERT_TRUE(response);
+  EXPECT_EQ(dbus::Message::MESSAGE_ERROR, response->GetMessageType());
+
+  NotifyOptions odd_actions;
+  odd_actions.actions = {"open"};
+  response = NotifyDirect(odd_actions);
+  ASSERT_TRUE(response);
+  EXPECT_EQ(dbus::Message::MESSAGE_ERROR, response->GetMessageType());
+
+  NotifyOptions oversized_image;
+  RawImage image;
+  image.width = 1024;
+  image.height = 1024;
+  image.row_stride = 4097;
+  image.bytes.assign(static_cast<size_t>(image.row_stride) * image.height, 0);
+  oversized_image.raw_image = std::move(image);
+  response = NotifyDirect(oversized_image);
+  ASSERT_TRUE(response);
+  EXPECT_EQ(dbus::Message::MESSAGE_ERROR, response->GetMessageType());
+
+  dbus::MethodCall invalid_utf8(kInterfaceName, "Notify");
+  AppendNotifyArguments(&invalid_utf8, NotifyOptions());
+  DBusMessageIter iterator;
+  ASSERT_TRUE(dbus_message_iter_init(invalid_utf8.raw_message(), &iterator));
+  const char* app_name = nullptr;
+  dbus_message_iter_get_basic(&iterator, &app_name);
+  ASSERT_TRUE(app_name);
+  const_cast<char*>(app_name)[0] = static_cast<char>(0xff);
+  response = CallNotifyDirect(&invalid_utf8);
+  ASSERT_TRUE(response);
+  EXPECT_EQ(dbus::Message::MESSAGE_ERROR, response->GetMessageType());
+
+  response = NotifyDirect(NotifyOptions());
+  ASSERT_TRUE(response);
+  EXPECT_EQ(dbus::Message::MESSAGE_METHOD_RETURN, response->GetMessageType());
+  EXPECT_EQ(1u, message_center::MessageCenter::Get()->NotificationCount());
+}
