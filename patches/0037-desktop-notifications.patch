+TEST_F(DesktopNotificationServiceTest, EmitsCorrectActionKey) {
+  NotifyOptions options;
+  options.resident = true;
+  options.actions = {"default", "Open",    "accept",
+                     "Accept",  "dismiss", "Dismiss"};
+
+  dbus::MethodCall method_call(kInterfaceName, "Notify");
+  AppendNotifyArguments(&method_call, options);
+  std::unique_ptr<dbus::Response> response = CallMethod(&method_call);
+  ASSERT_TRUE(response);
+  const uint32_t notification_id = ReadNotificationId(response.get());
+  message_center::Notification* notification =
+      message_center::MessageCenter::Get()->FindNotificationById(
+          "freedesktop:" + std::to_string(notification_id));
+  ASSERT_TRUE(notification);
+  ASSERT_EQ(2u, notification->buttons().size());
+  EXPECT_EQ(u"Accept", notification->buttons()[0].title);
+  EXPECT_EQ(u"Dismiss", notification->buttons()[1].title);
+
+  message_center::MessageCenter::Get()->ClickOnNotificationButton(
+      notification->id(), 1);
+  EXPECT_EQ("ActionInvoked", signal_name_);
+  EXPECT_EQ(notification_id, signal_notification_id_);
+  EXPECT_EQ("dismiss", signal_action_key_);
+}
