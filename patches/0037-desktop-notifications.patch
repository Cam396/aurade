+DesktopNotificationService::DesktopNotificationService() = default;
+
+DesktopNotificationService::~DesktopNotificationService() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  if (message_center::MessageCenter* message_center =
+          message_center::MessageCenter::Get()) {
+    std::vector<std::string> ids;
+    ids.reserve(notifications_.size());
+    for (const auto& [id, record] : notifications_) {
+      ids.push_back(record->message_center_id);
+    }
+    for (const std::string& id : ids) {
+      message_center->RemoveNotification(id, false);
+    }
+  }
+  notifications_.clear();
+}
