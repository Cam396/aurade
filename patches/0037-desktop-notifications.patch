+std::unique_ptr<dbus::Response> InvalidArguments(dbus::MethodCall* method_call,
+                                                 const std::string& message) {
+  return dbus::ErrorResponse::FromMethodCall(method_call,
+                                             kInvalidArgumentsError, message);
+}
+
+bool AddTextSize(const std::string& value, size_t* total) {
+  if (!base::IsStringUTF8(value) || value.size() > kMaxTextBytes ||
+      *total > kMaxTotalTextBytes - value.size()) {
+    return false;
+  }
+  *total += value.size();
+  return true;
+}
