+TEST_F(DesktopNotificationServiceTest, ReportsOnlyImplementedCapabilities) {
+  std::unique_ptr<dbus::Response> response = GetCapabilitiesDirect();
+
+  ASSERT_TRUE(response);
+  dbus::MessageReader reader(response.get());
+  std::vector<std::string> capabilities;
+  ASSERT_TRUE(reader.PopArrayOfStrings(&capabilities));
+  EXPECT_EQ((std::vector<std::string>{"actions", "body", "icon-static"}),
+            capabilities);
+}
+
+TEST_F(DesktopNotificationServiceTest, ReportsServerInformation) {
+  std::unique_ptr<dbus::Response> response = GetServerInformationDirect();
+  ASSERT_TRUE(response);
+  dbus::MessageReader reader(response.get());
+  std::string name;
+  std::string vendor;
+  std::string version;
+  std::string specification_version;
+  EXPECT_TRUE(reader.PopString(&name));
+  EXPECT_TRUE(reader.PopString(&vendor));
+  EXPECT_TRUE(reader.PopString(&version));
+  EXPECT_TRUE(reader.PopString(&specification_version));
+  EXPECT_FALSE(reader.HasMoreData());
+  EXPECT_EQ("AuraDE", name);
+  EXPECT_EQ("AuraDE", vendor);
+  EXPECT_EQ("0.2.0", version);
+  EXPECT_EQ("1.2", specification_version);
+}
