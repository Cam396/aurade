+void DesktopNotificationService::Start(
+    scoped_refptr<dbus::ExportedObject> exported_object) {
+  exported_object_ = std::move(exported_object);
+  exported_object_->ExportMethod(
+      kInterfaceName, kNotifyMethod,
+      base::BindRepeating(&DesktopNotificationService::HandleNotify,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&DesktopNotificationService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+  exported_object_->ExportMethod(
+      kInterfaceName, kCloseMethod,
+      base::BindRepeating(&DesktopNotificationService::HandleCloseNotification,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&DesktopNotificationService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+  exported_object_->ExportMethod(
+      kInterfaceName, kCapabilitiesMethod,
+      base::BindRepeating(&DesktopNotificationService::HandleGetCapabilities,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&DesktopNotificationService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+  exported_object_->ExportMethod(
+      kInterfaceName, kServerInformationMethod,
+      base::BindRepeating(
+          &DesktopNotificationService::HandleGetServerInformation,
+          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&DesktopNotificationService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
