+class DesktopNotificationServiceTest : public testing::Test {
+ public:
+  DesktopNotificationServiceTest() = default;
+
+  void SetUp() override {
+    message_center::MessageCenter::Initialize();
+    exported_object_ =
+        new dbus::MockExportedObject(nullptr, dbus::ObjectPath(kObjectPath));
+    EXPECT_CALL(*exported_object_, ExportMethod(kInterfaceName, testing::_,
+                                                testing::_, testing::_))
+        .WillRepeatedly(testing::Invoke(
+            this, &DesktopNotificationServiceTest::MockExportMethod));
+    EXPECT_CALL(*exported_object_, SendSignal(testing::_))
+        .WillRepeatedly(testing::Invoke(
+            this, &DesktopNotificationServiceTest::MockSendSignal));
+    service_ = std::make_unique<DesktopNotificationService>();
+    service_->Start(exported_object_);
+  }
+
+  void TearDown() override {
+    service_.reset();
+    exported_object_.reset();
+    message_center::MessageCenter::Shutdown();
+  }
+
+ protected:
+  void MockExportMethod(
+      const std::string& interface_name,
+      const std::string& method_name,
+      dbus::ExportedObject::MethodCallCallback method_callback,
+      dbus::ExportedObject::OnExportedCallback on_exported_callback) {
+    method_callbacks_[method_name] = std::move(method_callback);
+    std::move(on_exported_callback).Run(interface_name, method_name, true);
+  }
+
+  void MockSendSignal(dbus::Signal* signal) {
+    signal_name_ = signal->GetMember();
+    dbus::MessageReader reader(signal);
+    EXPECT_TRUE(reader.PopUint32(&signal_notification_id_));
+    if (signal_name_ == "ActionInvoked") {
+      EXPECT_TRUE(reader.PopString(&signal_action_key_));
+    } else if (signal_name_ == "NotificationClosed") {
+      EXPECT_TRUE(reader.PopUint32(&signal_close_reason_));
+    } else {
+      ADD_FAILURE() << "Unexpected signal: " << signal_name_;
+    }
+    EXPECT_FALSE(reader.HasMoreData());
+  }
+
+  std::unique_ptr<dbus::Response> CallMethod(dbus::MethodCall* method_call) {
+    method_call->SetSerial(1);
+    const auto callback = method_callbacks_.find(method_call->GetMember());
+    EXPECT_NE(method_callbacks_.end(), callback);
+    if (callback == method_callbacks_.end()) {
+      return nullptr;
+    }
+    std::unique_ptr<dbus::Response> response;
+    callback->second.Run(method_call,
+                         base::BindOnce(
+                             [](std::unique_ptr<dbus::Response>* destination,
+                                std::unique_ptr<dbus::Response> value) {
+                               *destination = std::move(value);
+                             },
+                             &response));
+    return response;
+  }
+
+  std::unique_ptr<dbus::Response> CallNotifyDirect(
+      dbus::MethodCall* method_call) {
+    return CallMethod(method_call);
+  }
+
+  std::unique_ptr<dbus::Response> NotifyDirect(const NotifyOptions& options) {
+    dbus::MethodCall method_call(kInterfaceName, "Notify");
+    AppendNotifyArguments(&method_call, options);
+    return CallNotifyDirect(&method_call);
+  }
+
+  std::unique_ptr<dbus::Response> GetCapabilitiesDirect() {
+    dbus::MethodCall method_call(kInterfaceName, "GetCapabilities");
+    return CallMethod(&method_call);
+  }
+
+  std::unique_ptr<dbus::Response> GetServerInformationDirect() {
+    dbus::MethodCall method_call(kInterfaceName, "GetServerInformation");
+    return CallMethod(&method_call);
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  scoped_refptr<dbus::MockExportedObject> exported_object_;
+  std::unique_ptr<DesktopNotificationService> service_;
+  std::map<std::string, dbus::ExportedObject::MethodCallCallback>
+      method_callbacks_;
+  std::string signal_name_;
+  uint32_t signal_notification_id_ = 0;
+  uint32_t signal_close_reason_ = 0;
+  std::string signal_action_key_;
+};
