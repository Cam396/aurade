+constexpr char kObjectPath[] = "/org/freedesktop/Notifications";
+constexpr char kInterfaceName[] = "org.freedesktop.Notifications";
+
+struct RawImage {
+  int32_t width = 2;
+  int32_t height = 2;
+  int32_t row_stride = 8;
+  bool has_alpha = true;
+  int32_t bits_per_sample = 8;
+  int32_t channels = 4;
+  std::vector<uint8_t> bytes = {
+      255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255,
+  };
+};
+
+struct NotifyOptions {
+  std::string app_name = "Test app";
+  std::string icon;
+  std::string summary = "A readable title";
+  std::string body = "A readable message";
+  std::vector<std::string> actions;
+  bool resident = false;
+  std::optional<uint8_t> urgency;
+  std::optional<RawImage> raw_image;
+  int32_t expire_timeout = 0;
+};
+
+void AppendNotifyArguments(dbus::MethodCall* method_call,
+                           const NotifyOptions& options) {
+  dbus::MessageWriter writer(method_call);
+  writer.AppendString(options.app_name);
+  writer.AppendUint32(0);
+  writer.AppendString(options.icon);
+  writer.AppendString(options.summary);
+  writer.AppendString(options.body);
+  writer.AppendArrayOfStrings(options.actions);
+
+  dbus::MessageWriter hints_writer(nullptr);
+  writer.OpenArray("{sv}", &hints_writer);
+  if (options.resident) {
+    dbus::MessageWriter entry_writer(nullptr);
+    dbus::MessageWriter variant_writer(nullptr);
+    hints_writer.OpenDictEntry(&entry_writer);
+    entry_writer.AppendString("resident");
+    entry_writer.OpenVariant("b", &variant_writer);
+    variant_writer.AppendBool(true);
+    entry_writer.CloseContainer(&variant_writer);
+    hints_writer.CloseContainer(&entry_writer);
+  }
+  if (options.urgency) {
+    dbus::MessageWriter entry_writer(nullptr);
+    dbus::MessageWriter variant_writer(nullptr);
+    hints_writer.OpenDictEntry(&entry_writer);
+    entry_writer.AppendString("urgency");
+    entry_writer.OpenVariant("y", &variant_writer);
+    variant_writer.AppendByte(*options.urgency);
+    entry_writer.CloseContainer(&variant_writer);
+    hints_writer.CloseContainer(&entry_writer);
+  }
+  if (options.raw_image) {
+    const RawImage& image = *options.raw_image;
+    dbus::MessageWriter entry_writer(nullptr);
+    dbus::MessageWriter variant_writer(nullptr);
+    dbus::MessageWriter struct_writer(nullptr);
+    hints_writer.OpenDictEntry(&entry_writer);
+    entry_writer.AppendString("image-data");
+    entry_writer.OpenVariant("(iiibiiay)", &variant_writer);
+    variant_writer.OpenStruct(&struct_writer);
+    struct_writer.AppendInt32(image.width);
+    struct_writer.AppendInt32(image.height);
+    struct_writer.AppendInt32(image.row_stride);
+    struct_writer.AppendBool(image.has_alpha);
+    struct_writer.AppendInt32(image.bits_per_sample);
+    struct_writer.AppendInt32(image.channels);
+    struct_writer.AppendArrayOfBytes(image.bytes);
+    variant_writer.CloseContainer(&struct_writer);
+    entry_writer.CloseContainer(&variant_writer);
+    hints_writer.CloseContainer(&entry_writer);
+  }
+  writer.CloseContainer(&hints_writer);
+  writer.AppendInt32(options.expire_timeout);
+}
+
+uint32_t ReadNotificationId(dbus::Response* response) {
+  dbus::MessageReader reader(response);
+  uint32_t notification_id = 0;
+  EXPECT_TRUE(reader.PopUint32(&notification_id));
+  EXPECT_FALSE(reader.HasMoreData());
+  return notification_id;
+}
