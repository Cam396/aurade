+std::vector<base::FilePath> IconSearchDirectories() {
+  std::vector<base::FilePath> roots;
+  auto environment = base::Environment::Create();
+  if (std::optional<std::string> home = environment->GetVar("HOME");
+      home && !home->empty()) {
+    roots.push_back(base::FilePath(*home).AppendASCII(".local/share/icons"));
+    roots.push_back(base::FilePath(*home).AppendASCII(".icons"));
+  }
+  roots.emplace_back("/usr/local/share/icons");
+  roots.emplace_back("/usr/share/icons");
+
+  std::vector<base::FilePath> directories;
+  directories.emplace_back("/usr/local/share/pixmaps");
+  directories.emplace_back("/usr/share/pixmaps");
+  static constexpr std::array<const char*, 3> kThemes = {"hicolor", "Adwaita",
+                                                         "gnome"};
+  static constexpr std::array<const char*, 11> kSizes = {
+      "1024x1024", "512x512", "256x256", "128x128", "96x96", "64x64",
+      "48x48",     "32x32",   "24x24",   "22x22",   "16x16"};
+  static constexpr std::array<const char*, 6> kContexts = {
+      "apps", "status", "actions", "devices", "mimetypes", "places"};
+  for (const base::FilePath& root : roots) {
+    for (const char* theme : kThemes) {
+      for (const char* size : kSizes) {
+        for (const char* context : kContexts) {
+          directories.push_back(
+              root.AppendASCII(theme).AppendASCII(size).AppendASCII(context));
+        }
+      }
+      for (const char* context : kContexts) {
+        directories.push_back(root.AppendASCII(theme)
+                                  .AppendASCII("scalable")
+                                  .AppendASCII(context));
+      }
+    }
+  }
+  return directories;
+}
