+namespace ash {
+
+// Implements the freedesktop.org notification service for Linux applications
+// running in an AuraDE session. Requests stay on the user's session bus and
+// are translated into Ash message center notifications.
+class DesktopNotificationService final
+    : public CrosDBusService::ServiceProviderInterface {
+ public:
+  DesktopNotificationService();
+  DesktopNotificationService(const DesktopNotificationService&) = delete;
+  DesktopNotificationService& operator=(const DesktopNotificationService&) =
+      delete;
+  ~DesktopNotificationService() override;
+
+  // CrosDBusService::ServiceProviderInterface:
+  void Start(scoped_refptr<dbus::ExportedObject> exported_object) override;
+
+ private:
+  class NotificationDelegate;
+  struct NotificationRecord;
+  struct NotifyRequest;
+
+  void HandleNotify(dbus::MethodCall* method_call,
+                    dbus::ExportedObject::ResponseSender response_sender);
+  void HandleCloseNotification(
+      dbus::MethodCall* method_call,
+      dbus::ExportedObject::ResponseSender response_sender);
+  void HandleGetCapabilities(
+      dbus::MethodCall* method_call,
+      dbus::ExportedObject::ResponseSender response_sender);
+  void HandleGetServerInformation(
+      dbus::MethodCall* method_call,
+      dbus::ExportedObject::ResponseSender response_sender);
+  void OnExported(const std::string& interface_name,
+                  const std::string& method_name,
+                  bool success);
+
+  bool ParseNotifyRequest(dbus::MethodCall* method_call,
+                          NotifyRequest* request,
+                          std::string* error_message);
+  uint32_t AllocateNotificationId();
+  void ScheduleExpiration(uint32_t notification_id,
+                          int32_t expire_timeout,
+                          uint8_t urgency);
+  void ExpireNotification(uint32_t notification_id);
+  void CloseNotification(uint32_t notification_id, uint32_t reason);
+  void OnNotificationClosed(uint32_t notification_id, bool by_user);
+  void OnNotificationClicked(uint32_t notification_id,
+                             const std::optional<int>& button_index);
+  void EmitNotificationClosed(uint32_t notification_id, uint32_t reason);
+  void EmitActionInvoked(uint32_t notification_id,
+                         const std::string& action_key);
+  void LoadNamedIcon(uint32_t notification_id,
+                     uint64_t generation,
+                     std::string icon_name);
+  void OnNamedIconLoaded(uint32_t notification_id,
+                         uint64_t generation,
+                         gfx::Image image);
+
+  scoped_refptr<dbus::ExportedObject> exported_object_;
+  std::map<uint32_t, std::unique_ptr<NotificationRecord>> notifications_;
+  uint32_t next_notification_id_ = 1;
+  uint64_t next_generation_ = 1;
+  size_t pending_icon_loads_ = 0;
+  base::WeakPtrFactory<DesktopNotificationService> weak_ptr_factory_{this};
+};
+
+// Owns the private session bus connection used by the notification service.
+// The service itself remains separate so its parser and message center bridge
+// can be tested without a live D-Bus daemon.
+class DesktopNotificationServiceHost final {
+ public:
+  static std::unique_ptr<DesktopNotificationServiceHost> Create();
+
+  DesktopNotificationServiceHost(const DesktopNotificationServiceHost&) =
+      delete;
+  DesktopNotificationServiceHost& operator=(
+      const DesktopNotificationServiceHost&) = delete;
+  ~DesktopNotificationServiceHost();
+
+ private:
+  DesktopNotificationServiceHost();
+  bool Start();
+  void OnOwnership(const std::string& service_name, bool success);
+
+  std::unique_ptr<base::Thread> dbus_thread_;
+  scoped_refptr<dbus::Bus> bus_;
+  scoped_refptr<dbus::ExportedObject> exported_object_;
+  std::unique_ptr<DesktopNotificationService> service_;
+  base::WeakPtrFactory<DesktopNotificationServiceHost> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_DESKTOP_NOTIFICATION_SERVICE_H_
