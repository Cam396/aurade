+/**
+ * AuraDE: the whole timestamp, for the same reason as the byte count.
+ *
+ * The Date column says "Yesterday 10:15 PM" or "Tuesday 4:02 PM", which is the
+ * right thing to read and, once somebody is comparing two versions of the same
+ * file, the wrong thing to trust. The exact time lives on hover, where it costs
+ * nobody anything until it is wanted.
+ *
+ * Returns the empty string for a time that cannot be shown, which is also what
+ * clears the tooltip on a recycled row.
+ */
+export function auraDeExactTime(modTime: Date|number|undefined): string {
+  if (modTime === undefined || modTime === null) {
+    return '';
+  }
+  const date = modTime instanceof Date ? modTime : new Date(modTime);
+  const value = date.getTime();
+  if (!isFinite(value)) {
+    return '';
+  }
+  try {
+    return date.toLocaleString(
+        /*locales=*/ undefined, {dateStyle: 'full', timeStyle: 'medium'});
+  } catch (error) {
+    // dateStyle and timeStyle are widely supported but not universally, and a
+    // tooltip is never worth throwing over.
+    return date.toLocaleString();
+  }
+}
