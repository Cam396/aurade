 bool ShouldArcAlwaysStart() {
+  // On AuraDE the start mode only means "no Play Store, no terms of service".
+  // Whether Android runs is the user's choice in Settings (the arc.enabled
+  // preference), so it is not started unconditionally there.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("aurade-android")) {
+    return false;
+  }
   return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
              ash::switches::kArcStartMode) == kAlwaysStartWithNoPlayStore;
 }
