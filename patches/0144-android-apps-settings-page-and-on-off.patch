+void AndroidAppsHandler::ConnectAuradeProgress() {
+  if (aurade_proxy_) {
+    return;
+  }
+  dbus::Bus* bus = arc::GetAuraDEAndroidBus();
+  if (!bus) {
+    return;
+  }
+  aurade_proxy_ =
+      bus->GetObjectProxy(kAuradeService, dbus::ObjectPath(kAuradePath));
+  aurade_proxy_->ConnectToSignal(
+      kAuradeInterface, "Progress",
+      base::BindRepeating(&AndroidAppsHandler::OnAuradeProgress,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce([](const std::string&, const std::string&, bool ok) {
+        LOG_IF(ERROR, !ok) << "AuraDE Android: could not watch Progress";
+      }));
+}
+
+void AndroidAppsHandler::HandleRequestAuradeAndroidInfo(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsAuraDEAndroidEnabled()) {
+    return;
+  }
+  ConnectAuradeProgress();
+  if (!aurade_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kAuradeInterface, "Info");
+  aurade_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&AndroidAppsHandler::OnAuradeInfoReply,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnAuradeInfoReply(dbus::Response* response,
+                                           dbus::ErrorResponse* error) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string json;
+  if (!reader.PopString(&json)) {
+    return;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (parsed && parsed->is_dict()) {
+    FireWebUIListener("aurade-android-info", *parsed);
+  }
+}
+
+void AndroidAppsHandler::HandleAuradeAndroidCall(const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsAuraDEAndroidEnabled() || args.size() != 1 ||
+      !args[0].is_string()) {
+    return;
+  }
+  const std::string& what = args[0].GetString();
+  // Only these three exist; the page cannot ask for anything else.
+  const char* method = what == "update"   ? "Update"
+                       : what == "remove" ? "Remove"
+                                          : nullptr;
+  if (!method) {
+    return;
+  }
+  ConnectAuradeProgress();
+  if (!aurade_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kAuradeInterface, method);
+  aurade_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_MAX,
+      base::BindOnce(&AndroidAppsHandler::OnAuradeCallReply,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnAuradeCallReply(dbus::Response* response,
+                                           dbus::ErrorResponse* error) {
+  LOG_IF(ERROR, !response) << "AuraDE Android: call failed: "
+                           << (error ? error->GetErrorName() : "no reply");
+  HandleRequestAuradeAndroidInfo(base::ListValue());
+}
+
+void AndroidAppsHandler::HandleRequestAuradeNetworkApps(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsAuraDEAndroidEnabled()) {
+    return;
+  }
+  ConnectAuradeProgress();
+  if (!aurade_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kAuradeInterface, "NetworkApps");
+  aurade_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&AndroidAppsHandler::OnAuradeNetworkAppsReply,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnAuradeNetworkAppsReply(
+    dbus::Response* response,
+    dbus::ErrorResponse* error) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string json;
+  if (!reader.PopString(&json)) {
+    return;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (parsed && parsed->is_list()) {
+    FireWebUIListener("aurade-android-network-apps", *parsed);
+  }
+}
+
+void AndroidAppsHandler::HandleSetAuradeNetworkAllowed(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (!arc::IsAuraDEAndroidEnabled() || args.size() != 2 ||
+      !args[0].is_string() || !args[1].is_bool()) {
+    return;
+  }
+  ConnectAuradeProgress();
+  if (!aurade_proxy_) {
+    return;
+  }
+  dbus::MethodCall call(kAuradeInterface, "SetNetworkAllowed");
+  dbus::MessageWriter writer(&call);
+  writer.AppendString(args[0].GetString());
+  writer.AppendBool(args[1].GetBool());
+  aurade_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_MAX,
+      base::BindOnce(
+          [](base::WeakPtr<AndroidAppsHandler> self, dbus::Response* response,
+             dbus::ErrorResponse* error) {
+            LOG_IF(ERROR, !response)
+                << "AuraDE Android: network switch failed: "
+                << (error ? error->GetErrorName() : "no reply");
+            if (self) {
+              self->HandleRequestAuradeNetworkApps(base::ListValue());
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void AndroidAppsHandler::OnAuradeProgress(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  std::string stage;
+  int32_t percent = 0;
+  if (!reader.PopString(&stage) || !reader.PopInt32(&percent)) {
+    return;
+  }
+  FireWebUIListener("aurade-android-progress", base::Value(stage),
+                    base::Value(percent));
+  if (stage == "done" || stage == "failed") {
+    HandleRequestAuradeAndroidInfo(base::ListValue());
+  }
+}
+
