+/**
+ * AuraDE: the location of an entry the way Files itself writes it, for
+ * example My files/Downloads/report.pdf. Returns the empty string when the
+ * entry sits on no volume Files can place, which happens for fake roots and
+ * for a volume unmounted between the selection and the copy.
+ */
+function auraDeDisplayPath(
+    entry: Entry|FilesAppEntry, volumeManager: VolumeManager): string {
+  const components =
+      PathComponent.computeComponentsFromEntry(entry, volumeManager);
+  return components.map(component => component.name).join('/');
+}
+
+/**
+ * AuraDE: copies the location of the selected files to the clipboard.
+ *
+ * Telling somebody where a file is means reading the breadcrumb and retyping
+ * it, and the breadcrumb elides the middle of a long path, so the part most
+ * worth quoting is the part that is not on screen to copy.
+ *
+ * The string this writes is the one the details panel already shows under
+ * File location, so what gets pasted matches what the window says. It is
+ * deliberately not dressed up as a native filesystem path: nothing the Files
+ * frontend can call returns one, and a path that looked like it would paste
+ * into a terminal and then did not work would be worse than a path that is
+ * honest about what it is.
+ *
+ * Uses the async clipboard for the reason CopyNameCommand documents above.
+ */
+export class CopyPathCommand extends FilesCommand {
+  execute(_event: CommandEvent, fileManager: CommandHandlerDeps) {
+    const paths =
+        fileManager.getSelection()
+            .entries.map(
+                entry => auraDeDisplayPath(entry, fileManager.volumeManager))
+            .filter(path => path.length > 0);
+    if (paths.length === 0) {
+      return;
+    }
+    // One path per line, so a multiple selection pastes into a list rather
+    // than a run-on sentence somebody has to split by hand.
+    navigator.clipboard.writeText(paths.join('\n'))
+        .then(() => {
+          const message = paths.length === 1 ?
+              `Copied the path ${paths[0]}` :
+              `Copied ${paths.length} paths`;
+          fileManager.ui.toast.show(message);
+          fileManager.ui.speakA11yMessage(message);
+        })
+        .catch(() => {
+          const message = 'Could not reach the clipboard';
+          fileManager.ui.toast.show(message);
+          fileManager.ui.speakA11yMessage(message);
+        });
+  }
+
+  override canExecute(event: CanExecuteEvent, fileManager: CommandHandlerDeps) {
+    const count = fileManager.getSelection().entries.length;
+    event.canExecute = count > 0;
+    event.command.setHidden(count === 0);
+    // The label counts, for the same reason Copy name counts.
+    event.command.label = count > 1 ? `Copy ${count} paths` : 'Copy path';
+  }
+}
+
 /**
