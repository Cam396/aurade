+  // AuraDE compatibility: exo hands every client buffer to the GPU through
+  // the shared context the compositor draws with, and has no software path.
+  // A desktop composited in software has no such context, and exo then
+  // crashes the browser as it starts, or the first time a client attaches a
+  // buffer. So the Wayland server stays off, exactly as it does without the
+  // switch, and says why once.
+  if (!aura::Env::GetInstance()
+           ->context_factory()
+           ->SharedMainThreadRasterContextProvider()) {
+    LOG(WARNING) << "Not starting the Wayland server: the desktop is "
+                    "composited in software and exo needs GPU compositing.";
+    return nullptr;
+  }
