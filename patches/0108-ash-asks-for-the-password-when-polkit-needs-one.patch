+constexpr char kPolkitServiceName[] = "org.freedesktop.PolicyKit1";
+constexpr char kPolkitAuthorityPath[] = "/org/freedesktop/PolicyKit1/Authority";
+constexpr char kPolkitAuthorityInterface[] =
+    "org.freedesktop.PolicyKit1.Authority";
+constexpr char kRegisterMethod[] = "RegisterAuthenticationAgent";
+constexpr char kAgentInterface[] =
+    "org.freedesktop.PolicyKit1.AuthenticationAgent";
+constexpr char kAgentPath[] = "/org/aurade/PolicyKit1/AuthenticationAgent";
+constexpr char kBeginMethod[] = "BeginAuthentication";
+constexpr char kCancelMethod[] = "CancelAuthentication";
+constexpr char kCancelledError[] = "org.freedesktop.PolicyKit1.Error.Cancelled";
+constexpr char kHelperSocket[] = "/run/polkit/agent-helper.socket";
+
+// A password check can take a while when PAM delays after a wrong one, but
+// a helper that never answers must not hold the dialog forever.
+constexpr int kHelperTimeoutSeconds = 60;
+
+std::optional<std::string> UserName(uid_t uid) {
+  const passwd* entry = getpwuid(uid);
+  if (!entry || !entry->pw_name) {
+    return std::nullopt;
+  }
+  return std::string(entry->pw_name);
+}
+
+// The start time of this process, in clock ticks since boot, which polkit
+// uses with the pid to tell this process from a later one with the same pid.
+std::optional<uint64_t> ProcessStartTime() {
+  std::string stat;
+  if (!base::ReadFileToString(base::FilePath("/proc/self/stat"), &stat)) {
+    return std::nullopt;
+  }
+  // The command name in parentheses may hold spaces; fields resume after it.
+  const size_t close = stat.rfind(')');
+  if (close == std::string::npos) {
+    return std::nullopt;
+  }
+  const std::vector<std::string_view> fields = base::SplitStringPiece(
+      std::string_view(stat).substr(close + 1), " ", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  // Field 22 (starttime) is the 20th after the command name.
+  uint64_t start_time = 0;
+  if (fields.size() < 20 || !base::StringToUint64(fields[19], &start_time)) {
+    return std::nullopt;
+  }
+  return start_time;
+}
+
+// The logind session this process belongs to, as logind itself finds it: by
+// the session scope its cgroup sits in.
+std::optional<std::string> LogindSessionId() {
+  std::string cgroup;
+  if (!base::ReadFileToString(base::FilePath("/proc/self/cgroup"), &cgroup)) {
+    return std::nullopt;
+  }
+  constexpr std::string_view kPrefix = "/session-";
+  constexpr std::string_view kSuffix = ".scope";
+  const size_t start = cgroup.find(kPrefix);
+  if (start == std::string::npos) {
+    return std::nullopt;
+  }
+  const size_t id_start = start + kPrefix.size();
+  const size_t end = cgroup.find(kSuffix, id_start);
+  if (end == std::string::npos || end == id_start) {
+    return std::nullopt;
+  }
+  return cgroup.substr(id_start, end - id_start);
+}
+
+bool WriteLine(int fd, std::string_view line) {
+  return base::WriteFileDescriptor(fd, line) &&
+         base::WriteFileDescriptor(fd, "\n");
+}
+
+std::optional<std::string> ReadLine(int fd) {
+  std::string line;
+  while (line.size() < 4096) {
+    char c = 0;
+    const ssize_t read = HANDLE_EINTR(::read(fd, &c, 1));
+    if (read <= 0) {
+      return std::nullopt;
+    }
+    if (c == '\n') {
+      return line;
+    }
+    line.push_back(c);
+  }
+  return std::nullopt;
+}
