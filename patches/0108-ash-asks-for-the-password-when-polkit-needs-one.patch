+// What polkit's helper made of a password.
+struct PolkitHelperResult {
+  bool success = false;
+  // The last error PAM gave, if any, to show the user.
+  std::string error_message;
+};
+
+// Talks to polkit-agent-helper-1 through its socket for one authentication:
+// sends the user and the cookie, answers the password prompt and reads the
+// verdict. Blocks, so runs off the UI thread. The password is wiped after use.
+PolkitHelperResult RunPolkitAgentHelper(const std::string& user_name,
+                                        const std::string& cookie,
+                                        std::string password);
+
+// The polkit authentication agent for an AuraDE session. Without one, every
+// action that needs an administrator's password is refused outright, so
+// removing or updating packages from Settings could never work. Ash
+// registers itself for its own session and asks for the password in a
+// system dialog, as other desktops do.
+class PolkitAgentService final {
+ public:
+  static std::unique_ptr<PolkitAgentService> Create();
+
+  PolkitAgentService(const PolkitAgentService&) = delete;
+  PolkitAgentService& operator=(const PolkitAgentService&) = delete;
+  ~PolkitAgentService();
+
+ private:
+  class PasswordFieldController;
+
+  struct Request {
+    Request();
+    Request(Request&&);
+    Request& operator=(Request&&);
+    ~Request();
+
+    std::string cookie;
+    std::string message;
+    std::string user_name;
+    bool for_current_user = true;
+    dbus::ExportedObject::ResponseSender response_sender;
+    std::unique_ptr<dbus::Response> response_template;
+    std::unique_ptr<dbus::ErrorResponse> cancel_template;
+  };
+
+  PolkitAgentService();
+  bool Start();
+  void Register();
+  void OnRegistered(dbus::Response* response, dbus::ErrorResponse* error);
+  void OnPolkitOwnerChanged(const std::string& service_owner);
+  void OnExported(const std::string& interface_name,
+                  const std::string& method_name,
+                  bool success);
+
+  void HandleBeginAuthentication(
+      dbus::MethodCall* method_call,
+      dbus::ExportedObject::ResponseSender response_sender);
+  void HandleCancelAuthentication(
+      dbus::MethodCall* method_call,
+      dbus::ExportedObject::ResponseSender response_sender);
+
+  // Shows the dialog for the request at the front of the queue, if any and
+  // none is showing.
+  void ShowNext(const std::u16string& error);
+  void OnPasswordEntered(int dialog_id, std::u16string password);
+  void OnDialogDismissed(int dialog_id);
+  void OnHelperFinished(PolkitHelperResult result);
+  void Finish(bool authenticated);
+  void CloseDialog();
+
+  std::unique_ptr<base::Thread> dbus_thread_;
+  scoped_refptr<dbus::Bus> bus_;
+  scoped_refptr<dbus::ExportedObject> exported_object_;
+  raw_ptr<dbus::ObjectProxy> authority_ = nullptr;
+
+  std::deque<Request> requests_;
+  // Outlives the dialog's password field, which points at it.
+  std::unique_ptr<PasswordFieldController> password_controller_;
+  std::unique_ptr<views::Widget> dialog_;
+  // Names the dialog on screen, so late word from a closed one is ignored.
+  int dialog_id_ = 0;
+  // True while the helper checks a password for the front request.
+  bool checking_ = false;
+
+  base::WeakPtrFactory<PolkitAgentService> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_POLKIT_AGENT_SERVICE_H_
