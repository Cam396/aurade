+}  // namespace
+
+PolkitHelperResult RunPolkitAgentHelper(const std::string& user_name,
+                                        const std::string& cookie,
+                                        std::string password) {
+  PolkitHelperResult result;
+  base::ScopedFD fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  const std::string_view path(kHelperSocket);
+  base::span(address.sun_path).first(path.size()).copy_from(base::span(path));
+  timeval timeout = {.tv_sec = kHelperTimeoutSeconds, .tv_usec = 0};
+  if (!fd.is_valid() ||
+      setsockopt(fd.get(), SOL_SOCKET, SO_RCVTIMEO, &timeout,
+                 sizeof(timeout)) != 0 ||
+      HANDLE_EINTR(connect(fd.get(), reinterpret_cast<sockaddr*>(&address),
+                           sizeof(address))) != 0) {
+    PLOG(ERROR) << "AuraDE could not reach the polkit helper";
+    std::fill(password.begin(), password.end(), '\0');
+    return result;
+  }
+
+  bool answered = false;
+  if (WriteLine(fd.get(), user_name) && WriteLine(fd.get(), cookie)) {
+    while (std::optional<std::string> line = ReadLine(fd.get())) {
+      if (line->starts_with("PAM_PROMPT_ECHO_OFF ") ||
+          line->starts_with("PAM_PROMPT_ECHO_ON ")) {
+        // One password is all this dialog asks for; a second prompt (a code,
+        // a new password) is beyond it, so the attempt fails.
+        if (answered || !WriteLine(fd.get(), password)) {
+          break;
+        }
+        answered = true;
+      } else if (line->starts_with("PAM_ERROR_MSG ")) {
+        result.error_message = line->substr(sizeof("PAM_ERROR_MSG ") - 1);
+      } else if (line->starts_with("SUCCESS")) {
+        result.success = true;
+        break;
+      } else if (!line->starts_with("PAM_TEXT_INFO ")) {
+        break;
+      }
+    }
+  }
+  std::fill(password.begin(), password.end(), '\0');
+  return result;
+}
