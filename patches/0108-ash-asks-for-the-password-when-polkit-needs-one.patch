+// Enter in the password field means the same as the dialog's Continue button.
+class PolkitAgentService::PasswordFieldController
+    : public views::TextfieldController {
+ public:
+  explicit PasswordFieldController(base::RepeatingClosure on_submit)
+      : on_submit_(std::move(on_submit)) {}
+  ~PasswordFieldController() override = default;
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() != ui::EventType::kKeyPressed ||
+        key_event.key_code() != ui::VKEY_RETURN) {
+      return false;
+    }
+    on_submit_.Run();
+    return true;
+  }
+
+ private:
+  base::RepeatingClosure on_submit_;
+};
+
+PolkitAgentService::Request::Request() = default;
+PolkitAgentService::Request::Request(Request&&) = default;
+PolkitAgentService::Request& PolkitAgentService::Request::operator=(
+    Request&&) = default;
+PolkitAgentService::Request::~Request() = default;
+
+PolkitAgentService::PolkitAgentService() = default;
+
+PolkitAgentService::~PolkitAgentService() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  CloseDialog();
+  for (Request& request : requests_) {
+    std::move(request.response_sender).Run(std::move(request.cancel_template));
+  }
+  requests_.clear();
+  exported_object_.reset();
+  if (bus_) {
+    bus_->ShutdownOnDBusThreadAndBlock();
+    bus_.reset();
+  }
+  if (dbus_thread_) {
+    dbus_thread_->Stop();
+  }
+}
+
+// static
+std::unique_ptr<PolkitAgentService> PolkitAgentService::Create() {
+  auto service =
+      std::unique_ptr<PolkitAgentService>(new PolkitAgentService());
+  if (!service->Start()) {
+    return nullptr;
+  }
+  return service;
+}
+
+bool PolkitAgentService::Start() {
+  dbus_thread_ = std::make_unique<base::Thread>("AuraDE polkit D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!dbus_thread_->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "AuraDE polkit agent could not start its D-Bus thread";
+    return false;
+  }
+
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SYSTEM;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = dbus_thread_->task_runner();
+  bus_ = new dbus::Bus(std::move(bus_options));
+
+  exported_object_ = bus_->GetExportedObject(dbus::ObjectPath(kAgentPath));
+  exported_object_->ExportMethod(
+      kAgentInterface, kBeginMethod,
+      base::BindRepeating(&PolkitAgentService::HandleBeginAuthentication,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&PolkitAgentService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+  exported_object_->ExportMethod(
+      kAgentInterface, kCancelMethod,
+      base::BindRepeating(&PolkitAgentService::HandleCancelAuthentication,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&PolkitAgentService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+
+  authority_ = bus_->GetObjectProxy(kPolkitServiceName,
+                                    dbus::ObjectPath(kPolkitAuthorityPath));
+  // polkitd forgets its agents when it restarts; register again when it
+  // comes back.
+  bus_->ListenForServiceOwnerChange(
+      kPolkitServiceName,
+      base::BindRepeating(&PolkitAgentService::OnPolkitOwnerChanged,
+                          weak_ptr_factory_.GetWeakPtr()));
+  Register();
+  return true;
+}
+
+void PolkitAgentService::Register() {
+  dbus::MethodCall call(kPolkitAuthorityInterface, kRegisterMethod);
+  dbus::MessageWriter writer(&call);
+  // polkit hands an authentication to the agent registered for the asking
+  // process's session, matched by session id. An agent registered by process
+  // is accepted but never asked, so name the session; polkit only takes an
+  // agent from inside the session it serves.
+  dbus::MessageWriter subject(nullptr);
+  writer.OpenStruct(&subject);
+  dbus::MessageWriter details(nullptr);
+  if (const std::optional<std::string> session_id = LogindSessionId()) {
+    subject.AppendString("unix-session");
+    subject.OpenArray("{sv}", &details);
+    dbus::MessageWriter id(nullptr);
+    details.OpenDictEntry(&id);
+    id.AppendString("session-id");
+    id.AppendVariantOfString(*session_id);
+    details.CloseContainer(&id);
+  } else {
+    const std::optional<uint64_t> start_time = ProcessStartTime();
+    if (!start_time) {
+      LOG(ERROR) << "AuraDE polkit agent found neither its session nor its "
+                    "start time";
+      return;
+    }
+    subject.AppendString("unix-process");
+    subject.OpenArray("{sv}", &details);
+    dbus::MessageWriter pid(nullptr);
+    details.OpenDictEntry(&pid);
+    pid.AppendString("pid");
+    pid.AppendVariantOfUint32(static_cast<uint32_t>(base::GetCurrentProcId()));
+    details.CloseContainer(&pid);
+    dbus::MessageWriter start(nullptr);
+    details.OpenDictEntry(&start);
+    start.AppendString("start-time");
+    start.AppendVariantOfUint64(*start_time);
+    details.CloseContainer(&start);
+  }
+  subject.CloseContainer(&details);
+  writer.CloseContainer(&subject);
+  writer.AppendString("en_US.UTF-8");
+  writer.AppendString(kAgentPath);
+  authority_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&PolkitAgentService::OnRegistered,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PolkitAgentService::OnRegistered(dbus::Response* response,
+                                      dbus::ErrorResponse* error) {
+  if (!response) {
+    LOG(ERROR) << "AuraDE polkit agent was not registered: "
+               << (error ? error->GetErrorName() : "no reply");
+    return;
+  }
+  LOG(WARNING) << "AuraDE polkit agent registered";
+}
+
+void PolkitAgentService::OnPolkitOwnerChanged(
+    const std::string& service_owner) {
+  if (!service_owner.empty()) {
+    Register();
+  }
+}
+
+void PolkitAgentService::OnExported(const std::string& interface_name,
+                                    const std::string& method_name,
+                                    bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE could not export " << interface_name
+                          << "." << method_name;
+}
+
+void PolkitAgentService::HandleBeginAuthentication(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string action_id;
+  std::string message;
+  std::string icon_name;
+  dbus::MessageReader details(nullptr);
+  std::string cookie;
+  dbus::MessageReader identities(nullptr);
+  if (!reader.PopString(&action_id) || !reader.PopString(&message) ||
+      !reader.PopString(&icon_name) || !reader.PopArray(&details) ||
+      !reader.PopString(&cookie) || !reader.PopArray(&identities)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, kCancelledError, "Malformed request"));
+    return;
+  }
+
+  // polkit lists who may vouch for the action, with groups already resolved
+  // to their members. The person at the desktop is the one to ask when they
+  // are on the list; otherwise ask for the first account that is.
+  const uid_t own_uid = getuid();
+  std::optional<uid_t> chosen;
+  while (identities.HasMoreData()) {
+    dbus::MessageReader identity(nullptr);
+    std::string kind;
+    dbus::MessageReader fields(nullptr);
+    if (!identities.PopStruct(&identity) || !identity.PopString(&kind) ||
+        !identity.PopArray(&fields)) {
+      break;
+    }
+    if (kind != "unix-user") {
+      continue;
+    }
+    while (fields.HasMoreData()) {
+      dbus::MessageReader field(nullptr);
+      std::string key;
+      uint32_t uid = 0;
+      if (!fields.PopDictEntry(&field) || !field.PopString(&key)) {
+        break;
+      }
+      if (key == "uid" && field.PopVariantOfUint32(&uid)) {
+        if (uid == own_uid || !chosen) {
+          chosen = uid;
+        }
+      }
+    }
+  }
+  std::optional<std::string> user_name =
+      chosen ? UserName(*chosen) : std::nullopt;
+  if (!user_name) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, kCancelledError, "No account can authorize this"));
+    return;
+  }
+
+  Request request;
+  request.cookie = cookie;
+  request.message = message;
+  request.user_name = *user_name;
+  request.for_current_user = *chosen == own_uid;
+  request.response_sender = std::move(response_sender);
+  request.response_template = dbus::Response::FromMethodCall(method_call);
+  request.cancel_template = dbus::ErrorResponse::FromMethodCall(
+      method_call, kCancelledError, "Authentication was cancelled");
+  requests_.push_back(std::move(request));
+  ShowNext(std::u16string());
+}
+
+void PolkitAgentService::HandleCancelAuthentication(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string cookie;
+  reader.PopString(&cookie);
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+
+  auto it = std::ranges::find(requests_, cookie, &Request::cookie);
+  if (it == requests_.end()) {
+    return;
+  }
+  if (it == requests_.begin()) {
+    // The front request is the one on screen, or the one being checked.
+    Finish(false);
+    return;
+  }
+  std::move(it->response_sender).Run(std::move(it->cancel_template));
+  requests_.erase(it);
+}
+
+void PolkitAgentService::ShowNext(const std::u16string& error) {
+  if (dialog_ || checking_ || requests_.empty()) {
+    return;
+  }
+  const Request& request = requests_.front();
+
+  auto dialog = std::make_unique<SystemDialogDelegateView>();
+  dialog->SetIcon(vector_icons::kLockIcon);
+  dialog->SetTitleText(u"Enter your password");
+  std::u16string description = base::UTF8ToUTF16(request.message);
+  if (!request.for_current_user) {
+    description += u"\n\nThis needs the password for " +
+                   base::UTF8ToUTF16(request.user_name) + u".";
+  }
+  if (!error.empty()) {
+    description = error + u"\n\n" + description;
+  }
+  dialog->SetDescription(description);
+  dialog->SetAcceptButtonText(u"Continue");
+  dialog->SetCancelButtonText(u"Cancel");
+
+  auto field = std::make_unique<SystemTextfield>(SystemTextfield::Type::kLarge);
+  field->SetTextInputType(ui::TEXT_INPUT_TYPE_PASSWORD);
+  field->SetPlaceholderText(u"Password");
+  field->GetViewAccessibility().SetName(u"Password");
+  field->SetShowFocusRing(true);
+  SystemTextfield* password = dialog->SetMiddleContentView(std::move(field));
+  dialog->SetMiddleContentAlignment(views::LayoutAlignment::kStretch);
+  dialog->SetInitiallyFocusedView(password);
+
+  // The dialog's callbacks run inside the widget, which must not be torn
+  // down under them, so each one hands back to the service on a fresh task.
+  const int dialog_id = ++dialog_id_;
+  auto submit = base::BindRepeating(
+      [](base::WeakPtr<PolkitAgentService> service, int id,
+         SystemTextfield* field) {
+        std::u16string text(field->GetText());
+        field->SetText(std::u16string());
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&PolkitAgentService::OnPasswordEntered,
+                                      service, id, std::move(text)));
+      },
+      weak_ptr_factory_.GetWeakPtr(), dialog_id, base::Unretained(password));
+  auto dismiss = base::BindRepeating(
+      [](base::WeakPtr<PolkitAgentService> service, int id) {
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&PolkitAgentService::OnDialogDismissed,
+                                      service, id));
+      },
+      weak_ptr_factory_.GetWeakPtr(), dialog_id);
+  dialog->SetAcceptCallback(submit);
+  dialog->SetCancelCallback(dismiss);
+  dialog->SetCloseCallback(dismiss);
+  dialog->SetModalType(ui::mojom::ModalType::kSystem);
+
+  password_controller_ = std::make_unique<PasswordFieldController>(submit);
+  password->set_controller(password_controller_.get());
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.delegate = dialog.release();
+  params.name = "AuraDePolkitAuthenticationDialog";
+  dialog_ = std::make_unique<views::Widget>();
+  dialog_->Init(std::move(params));
+  dialog_->Show();
+}
+
+void PolkitAgentService::OnPasswordEntered(int dialog_id,
+                                           std::u16string password) {
+  if (dialog_id != dialog_id_ || requests_.empty() || checking_) {
+    std::fill(password.begin(), password.end(), u'\0');
+    return;
+  }
+  CloseDialog();
+  checking_ = true;
+  const Request& request = requests_.front();
+  std::string utf8 = base::UTF16ToUTF8(password);
+  std::fill(password.begin(), password.end(), u'\0');
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&RunPolkitAgentHelper, request.user_name, request.cookie,
+                     std::move(utf8)),
+      base::BindOnce(&PolkitAgentService::OnHelperFinished,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PolkitAgentService::OnDialogDismissed(int dialog_id) {
+  // A submitted password closes the dialog too; that is not a cancel. Nor is
+  // the closing of a dialog that has already been replaced.
+  if (dialog_id != dialog_id_ || checking_ || requests_.empty()) {
+    return;
+  }
+  Finish(false);
+}
+
+void PolkitAgentService::OnHelperFinished(PolkitHelperResult result) {
+  checking_ = false;
+  if (requests_.empty()) {
+    return;
+  }
+  if (result.success) {
+    Finish(true);
+    return;
+  }
+  // Ask again, as polkit allows; the person can always cancel.
+  std::u16string error = u"That password didn't work. Try again.";
+  if (!result.error_message.empty()) {
+    error = base::UTF8ToUTF16(result.error_message);
+  }
+  ShowNext(error);
+}
+
+void PolkitAgentService::Finish(bool authenticated) {
+  CloseDialog();
+  checking_ = false;
+  if (requests_.empty()) {
+    return;
+  }
+  Request request = std::move(requests_.front());
+  requests_.pop_front();
+  if (authenticated) {
+    std::move(request.response_sender)
+        .Run(std::move(request.response_template));
+  } else {
+    std::move(request.response_sender).Run(std::move(request.cancel_template));
+  }
+  ShowNext(std::u16string());
+}
+
+void PolkitAgentService::CloseDialog() {
+  if (dialog_) {
+    // Cancel and Continue have already closed it by the time this runs.
+    if (!dialog_->IsClosed()) {
+      dialog_->CloseNow();
+    }
+    dialog_.reset();
+  }
+  password_controller_.reset();
+}
+
+}  // namespace ash
