diff --git a/ui/file_manager/file_manager/aurade/ui/places.ts b/ui/file_manager/file_manager/aurade/ui/places.ts
new file mode 100644
index 000000000000..bfe6b1b3599d
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/places.ts
@@ -0,0 +1,69 @@
+/**
+ * Volumes, as places you can go.
+ *
+ * This is the only thing that knows what a VolumeKind means. The sidebar groups
+ * by the place kind it is handed and stays ignorant of the fact that `drive`
+ * means somebody's Google Drive rather than a disk in the machine, which is the
+ * sort of detail that otherwise ends up hardcoded in a view and wrong for the
+ * next backend.
+ *
+ * Nothing is invented here. A place appears because a volume backs it, so there
+ * is no destination in the sidebar that leads somewhere the backend has never
+ * heard of.
+ */
+import type {Volume} from '../port/types.js';
+import type {Place, PlaceKind} from './sidebar.js';
+
+/** Somewhere else that happens to be mounted here: cloud, phone, container. */
+const ELSEWHERE = new Set(['drive', 'provided', 'android', 'crostini']);
+
+export function placeKindFor(volume: Volume): PlaceKind {
+  if (volume.kind === 'recent') {
+    return 'recent';
+  }
+  if (volume.kind === 'trash') {
+    return 'trash';
+  }
+  if (ELSEWHERE.has(volume.kind)) {
+    return 'network';
+  }
+  return 'volume';
+}
+
+export interface PlacesOptions {
+  /** Omitted or zero means the basket is not offered at all. */
+  readonly basketCount?: number;
+  readonly basketKey?: string;
+}
+
+export function placesFor(
+    volumes: readonly Volume[], options: PlacesOptions = {}): Place[] {
+  const places: Place[] = volumes.map(volume => ({
+    key: volume.root,
+    label: volume.label,
+    kind: placeKindFor(volume),
+    volume,
+  }));
+  const {basketCount, basketKey} = options;
+  if (basketCount !== undefined && basketKey !== undefined) {
+    places.push({
+      key: basketKey as Place['key'],
+      label: 'Basket',
+      kind: 'basket',
+      badge: basketCount,
+    });
+  }
+  return places;
+}
+
+/**
+ * Where to land when the window opens.
+ *
+ * The first real volume rather than the first place: opening onto Recent shows
+ * a list assembled from everywhere, which is a fine thing to ask for and a poor
+ * thing to be given before you have asked for anything.
+ */
+export function firstDestination(places: readonly Place[]): Place|undefined {
+  return places.find(place => place.kind === 'volume') ??
+      places.find(place => place.kind === 'network') ?? places[0];
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/shell.ts b/ui/file_manager/file_manager/aurade/ui/shell.ts
new file mode 100644
index 000000000000..defcb2356475
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/shell.ts
@@ -0,0 +1,198 @@
+/**
+ * The window: places on the left, what is in them on the right.
+ *
+ * This is the first thing that talks to the port rather than being handed data,
+ * so it is also the first place the seam has to actually hold. Everything it
+ * needs is behind `FilesBackendPort`, which is why the whole of it runs against
+ * `MockBackend` in a browser with no session, no pak and no machine.
+ *
+ * Metadata is fetched against the window on screen rather than the directory.
+ * A hundred thousand entries is a normal directory and forty of them are
+ * visible, so asking for all of it to fill a screen is the difference between
+ * opening instantly and not opening.
+ */
+import type {FilesBackendPort} from '../port/port.js';
+import type {EntryDto, FileKey, Metadata, MetadataField} from '../port/types.js';
+import {FilesError} from '../port/types.js';
+import type {SessionState} from '../session/navigation_session.js';
+import {NavigationSession} from '../session/navigation_session.js';
+import type {EmptyReason} from './copy.js';
+import {FileList} from './file_list.js';
+import {firstDestination, placesFor} from './places.js';
+import type {Place} from './sidebar.js';
+import {Sidebar} from './sidebar.js';
+
+const FIELDS: readonly MetadataField[] = ['size', 'modificationTime'];
+
+export interface ShellOptions {
+  readonly rowHeight?: number;
+  /** Omit both to leave the basket out entirely rather than showing an empty one. */
+  readonly basketKey?: string;
+  readonly basketCount?: number;
+}
+
+function element(tag: string, className: string): HTMLElement {
+  const node = document.createElement(tag);
+  node.className = className;
+  return node;
+}
+
+/** What an empty view means, given why it is empty. */
+function reasonFor(error: FilesError|null): EmptyReason {
+  if (!error) {
+    return 'empty';
+  }
+  // "This folder is empty" is a lie when the truth is that it could not be
+  // read, and the two look identical if the code is not consulted.
+  return error.code === 'not-found' ? 'gone' : 'unreadable';
+}
+
+export class FilesShell {
+  private readonly root: HTMLElement;
+  private readonly notice: HTMLElement;
+  private readonly sidebar: Sidebar;
+  private readonly list: FileList;
+  private readonly session: NavigationSession;
+  private readonly metadata = new Map<FileKey, Metadata>();
+  private entries: readonly EntryDto[] = [];
+  private unsubscribe: (() => void)|null = null;
+  /**
+   * Bumped on every navigation. A metadata reply that arrives after you have
+   * moved on belongs to a directory nobody is looking at, and applying it is
+   * work done on behalf of a screen that no longer exists.
+   */
+  private generation = 0;
+  private range: {first: number, count: number} = {first: 0, count: 0};
+
+  constructor(
+      container: HTMLElement,
+      private readonly port: FilesBackendPort,
+      private readonly options: ShellOptions = {}) {
+    this.root = element('div', 'aurade-shell');
+
+    const aside = element('div', 'aurade-shell-aside');
+    this.sidebar = new Sidebar(aside, {onSelect: place => void this.goTo(place)});
+
+    const main = element('div', 'aurade-shell-main');
+    this.notice = element('p', 'aurade-shell-notice');
+    this.notice.hidden = true;
+    // A status rather than an alert: it is worth saying, and not worth
+    // interrupting whatever the screen reader was in the middle of.
+    this.notice.setAttribute('role', 'status');
+    const listHost = element('div', 'aurade-shell-list');
+    main.append(this.notice, listHost);
+
+    this.list = new FileList(listHost, {
+      rowHeight: options.rowHeight,
+      onActivate: entry => void this.activate(entry),
+      onRangeChange: (first, count) => void this.fillMetadata(first, count),
+    });
+
+    this.root.append(aside, main);
+    container.appendChild(this.root);
+
+    this.session = new NavigationSession('main', port);
+    this.unsubscribe = this.session.subscribe(state => this.apply(state));
+  }
+
+  /** Loads the places and opens the first real one. */
+  async start(): Promise<void> {
+    let volumes;
+    try {
+      volumes = await this.port.volumes();
+    } catch (error) {
+      // A sidebar with nothing in it and no explanation reads as a broken
+      // window. Say which part failed.
+      this.say('The places on this computer could not be read.');
+      return;
+    }
+    const places = placesFor(volumes, {
+      basketKey: this.options.basketKey,
+      basketCount: this.options.basketCount,
+    });
+    this.sidebar.setPlaces(places);
+    const destination = firstDestination(places);
+    if (!destination) {
+      this.say('No drives are available yet.');
+      return;
+    }
+    await this.goTo(destination);
+  }
+
+  private say(message: string): void {
+    this.notice.textContent = message;
+    this.notice.hidden = false;
+  }
+
+  private async goTo(place: Place): Promise<void> {
+    this.notice.hidden = true;
+    this.sidebar.setSelected(place.key);
+    await this.navigate(place.key);
+  }
+
+  private async navigate(key: FileKey): Promise<void> {
+    this.generation++;
+    this.metadata.clear();
+    await this.session.navigate(key);
+  }
+
+  private async activate(entry: EntryDto): Promise<void> {
+    if (!entry.isDirectory) {
+      return;
+    }
+    // Going somewhere the sidebar does not list is ordinary, and the marker
+    // has to come off rather than keep pointing at the drive you left.
+    this.sidebar.setSelected(entry.key);
+    await this.navigate(entry.key);
+  }
+
+  private apply(state: SessionState): void {
+    this.entries = state.entries;
+    this.list.setEntries(state.entries);
+    if (state.error) {
+      this.list.setEmptyReason(reasonFor(state.error));
+    } else if (!state.loading && state.entries.length === 0) {
+      this.list.setEmptyReason('empty');
+    }
+  }
+
+  private async fillMetadata(first: number, count: number): Promise<void> {
+    this.range = {first, count};
+    const generation = this.generation;
+    const wanted = this.entries.slice(first, first + count)
+                       .filter(entry => !this.metadata.has(entry.key))
+                       .map(entry => entry.key);
+    if (!wanted.length) {
+      return;
+    }
+    let snapshot;
+    try {
+      snapshot = await this.port.metadata(wanted, FIELDS);
+    } catch {
+      // A row without a size is worth far more than a window that refuses to
+      // draw, so this is deliberately not surfaced.
+      return;
+    }
+    if (generation !== this.generation) {
+      return;
+    }
+    for (const [key, value] of snapshot) {
+      this.metadata.set(key, value);
+    }
+    this.list.setMetadata(this.metadata);
+  }
+
+  /** For tests and for the window: what is on screen right now. */
+  state(): SessionState {
+    return this.session.snapshot();
+  }
+
+  destroy(): void {
+    this.unsubscribe?.();
+    this.unsubscribe = null;
+    this.session.dispose();
+    this.list.destroy();
+    this.sidebar.destroy();
+    this.root.remove();
+  }
+}
