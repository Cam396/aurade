+
+
+/* The window. Places on the left, what is in them on the right, each on its
+   own panel so the ground shows between them: the greeter does the same thing,
+   and it is what stops a file manager reading as one undifferentiated grid. */
+.aurade-shell {
+  background: var(--aurade-ground);
+  block-size: 100%;
+  box-sizing: border-box;
+  display: flex;
+  gap: 8px;
+  padding: 8px;
+}
+.aurade-shell-aside {
+  background: var(--aurade-panel);
+  border: 1px solid var(--aurade-line);
+  border-radius: var(--aurade-radius-panel);
+  display: flex;
+  flex: none;
+  overflow: hidden;
+}
+.aurade-shell-main {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 8px;
