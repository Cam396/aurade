diff --git a/ui/file_manager/file_manager/aurade/tests/dom/shell_test.ts b/ui/file_manager/file_manager/aurade/tests/dom/shell_test.ts
new file mode 100644
index 000000000000..22eb69a28dc2
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/dom/shell_test.ts
@@ -0,0 +1,363 @@
+/**
+ * The window, driven end to end against the port.
+ *
+ * Every other suite hands a component its data. This one does not: it builds a
+ * backend, hands the shell nothing but the port, and asks what appeared on
+ * screen. That is the seam being load bearing rather than merely declared, and
+ * it is the first test that would notice if the two halves stopped agreeing.
+ */
+import {MockBackend} from '../../port/mock_backend.js';
+import type {FilesBackendPort} from '../../port/port.js';
+import type {FileKey, MetadataField} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {FilesShell} from '../../ui/shell.js';
+
+const ROOT = asFileKey('mock://myfiles');
+const USB = asFileKey('mock://usb');
+const DRIVE = asFileKey('mock://gdrive');
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+/** Counts what the shell actually asked the backend for. */
+class CountingPort implements FilesBackendPort {
+  metadataCalls = 0;
+  metadataKeys = 0;
+  constructor(private readonly inner: FilesBackendPort) {}
+  list(key: FileKey, options?: Parameters<FilesBackendPort['list']>[1]) {
+    return this.inner.list(key, options);
+  }
+  metadata(keys: readonly FileKey[], fields: readonly MetadataField[]) {
+    this.metadataCalls++;
+    this.metadataKeys += keys.length;
+    return this.inner.metadata(keys, fields);
+  }
+  watch(key: FileKey, signal?: AbortSignal) {
+    return this.inner.watch(key, signal);
+  }
+  volumes() {
+    return this.inner.volumes();
+  }
+  search(q: string, scope: FileKey, o?: Parameters<FilesBackendPort['search']>[2]) {
+    return this.inner.search(q, scope, o);
+  }
+  tasks(keys: readonly FileKey[]) {
+    return this.inner.tasks(keys);
+  }
+  executeTask(id: string, keys: readonly FileKey[]) {
+    return this.inner.executeTask(id, keys);
+  }
+  startIo(request: Parameters<FilesBackendPort['startIo']>[0]) {
+    return this.inner.startIo(request);
+  }
+  subscribeIo(signal?: AbortSignal) {
+    return this.inner.subscribeIo(signal);
+  }
+  cancelIo(id: Parameters<FilesBackendPort['cancelIo']>[0]) {
+    return this.inner.cancelIo(id);
+  }
+  dialogMode() {
+    return this.inner.dialogMode();
+  }
+  confirmDialog(keys: readonly FileKey[]) {
+    return this.inner.confirmDialog(keys);
+  }
+  cancelDialog() {
+    return this.inner.cancelDialog();
+  }
+}
+
+function backendWith(fileCount = 6): MockBackend {
+  const backend = new MockBackend();
+  // Recent first on purpose: the shell must not land on it just because it is
+  // the first thing the backend happened to return.
+  backend.addVolume({
+    id: 'recent',
+    root: asFileKey('mock://recent'),
+    label: 'Recent',
+    kind: 'recent',
+    removable: false,
+    readOnly: false,
+    capacity: null,
+  });
+  backend.addVolume({
+    id: 'system',
+    root: ROOT,
+    label: 'Home',
+    kind: 'system',
+    removable: false,
+    readOnly: false,
+    capacity: {total: 32 * 1024 ** 3, free: 8 * 1024 ** 3},
+  });
+  backend.addVolume({
+    id: 'usb',
+    root: USB,
+    label: 'CRUZER',
+    kind: 'removable',
+    removable: true,
+    readOnly: false,
+    capacity: {total: 16 * 1024 ** 3, free: 128 * 1024 ** 2},
+  });
+  backend.addVolume({
+    id: 'gdrive',
+    root: DRIVE,
+    label: 'Google Drive',
+    kind: 'drive',
+    removable: false,
+    readOnly: false,
+    capacity: null,
+  });
+  backend.add(ROOT, 'Documents', true);
+  for (let i = 0; i < fileCount; i++) {
+    backend.add(ROOT, `home-${i}.txt`, false, {size: (i + 1) * 4096});
+  }
+  backend.add(USB, 'holiday.jpg', false, {size: 2 * 1024 ** 2});
+  return backend;
+}
+
+interface Harness {
+  shell: FilesShell;
+  host: HTMLElement;
+  port: CountingPort;
+  names(): string[];
+  places(): string[];
+  headings(): string[];
+  currentPlace(): string|null;
+  notice(): string|null;
+  destroy(): void;
+}
+
+function makeHarness(backend: MockBackend = backendWith()): Harness {
+  const host = document.createElement('div');
+  host.style.height = '420px';
+  host.style.width = '900px';
+  document.body.appendChild(host);
+  const port = new CountingPort(backend);
+  const shell = new FilesShell(host, port, {rowHeight: 40});
+  return {
+    shell,
+    host,
+    port,
+    names: () => [...host.querySelectorAll<HTMLElement>('.aurade-row')]
+                     .map(row => row.querySelector('.aurade-name')?.textContent ?? ''),
+    places: () => [...host.querySelectorAll<HTMLElement>('.aurade-place-label')]
+                      .map(node => node.textContent ?? ''),
+    headings: () =>
+        [...host.querySelectorAll<HTMLElement>('.aurade-place-heading')]
+            .map(node => node.textContent ?? ''),
+    currentPlace: () => {
+      const current = host.querySelector('.aurade-place[aria-current="page"]');
+      return current?.querySelector('.aurade-place-label')?.textContent ?? null;
+    },
+    notice: () => {
+      const notice = host.querySelector<HTMLElement>('.aurade-shell-notice');
+      return notice && !notice.hidden ? notice.textContent : null;
+    },
+    destroy: () => {
+      shell.destroy();
+      host.remove();
+    },
+  };
+}
+
+/** Lets the microtask queue and any zero latency awaits drain. */
+async function settle(times = 6): Promise<void> {
+  for (let i = 0; i < times; i++) {
+    await new Promise(resolve => setTimeout(resolve, 0));
+  }
+}
+
+interface DomResult {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+const CASES: Array<{name: string, run: () => Promise<void>}> = [
+  {
+    name: 'the window asks the backend what places exist',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const places = h.places();
+      for (const expected of ['Recent', 'Home', 'CRUZER', 'Google Drive']) {
+        assert(places.includes(expected),
+               `${expected} is missing from ${JSON.stringify(places)}`);
+      }
+      h.destroy();
+    },
+  },
+  {
+    name: 'somebody elses drive is not filed as part of this computer',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const headings = h.headings();
+      assert(headings.includes('Elsewhere'),
+             `Google Drive has no home of its own: ${JSON.stringify(headings)}`);
+      const groups = [...h.host.querySelectorAll('.aurade-place-group')];
+      const computer = groups.find(
+          group => group.querySelector('.aurade-place-heading')?.textContent ===
+              'This computer')!;
+      const inside = [...computer.querySelectorAll('.aurade-place-label')]
+                         .map(node => node.textContent);
+      equal(inside.join(','), 'Home',
+            'this computer should hold only what is actually in it');
+      h.destroy();
+    },
+  },
+  {
+    name: 'it opens on a drive rather than on Recent',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      // Recent is the first volume the backend returns, and landing there
+      // shows a list assembled from everywhere before you have asked for
+      // anything.
+      equal(h.currentPlace(), 'Home', 'the window opened somewhere else');
+      assert(h.names().some(name => name.startsWith('home-')),
+             `the listing is not Home: ${JSON.stringify(h.names().slice(0, 4))}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'choosing a place shows what is in it',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const usb = [...h.host.querySelectorAll<HTMLElement>('.aurade-place')]
+                      .find(button =>
+                                button.querySelector('.aurade-place-label')
+                                    ?.textContent === 'CRUZER')!;
+      usb.click();
+      await settle();
+      equal(h.currentPlace(), 'CRUZER', 'the marker did not move');
+      equal(h.names().join(','), 'holiday.jpg',
+            'the list still shows the previous drive');
+      h.destroy();
+    },
+  },
+  {
+    name: 'opening a folder takes the marker off the drive you left',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      const row = [...h.host.querySelectorAll<HTMLElement>('.aurade-row')].find(
+          candidate => (candidate.textContent ?? '').includes('Documents'))!;
+      assert(row, 'Documents is not on screen');
+      row.dispatchEvent(new MouseEvent('dblclick', {bubbles: true}));
+      await settle();
+      equal(h.currentPlace(), null,
+            'the sidebar still claims you are at the drive root');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a huge directory does not stat every entry to fill one screen',
+    run: async () => {
+      const backend = backendWith(0);
+      for (let i = 0; i < 20_000; i++) {
+        backend.add(ROOT, `bulk-${i}.txt`, false, {size: 1024});
+      }
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle(10);
+      assert(h.port.metadataKeys > 0, 'no metadata was fetched at all');
+      assert(h.port.metadataKeys < 200,
+             `asked for ${h.port.metadataKeys} of 20,000 records to fill one screen`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'sizes appear on the rows once they arrive',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const text = [...h.host.querySelectorAll<HTMLElement>('.aurade-row')]
+                       .map(row => row.textContent ?? '')
+                       .join(' ');
+      assert(/\d\s?(bytes|KB|MB|GB)/.test(text),
+             `no size reached the rows: ${text.slice(0, 160)}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'a folder that cannot be read does not claim to be empty',
+    run: async () => {
+      const backend = backendWith();
+      backend.setFailure(
+          ROOT, new FilesError('permission-denied', 'nope'));
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const title =
+          h.host.querySelector('.aurade-empty-title')?.textContent ?? '';
+      assert(title.length > 0, 'nothing was said at all');
+      assert(!/empty/i.test(title),
+             `a refused folder was reported as empty: ${title}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'places that cannot be read say so instead of a blank frame',
+    run: async () => {
+      const backend = backendWith();
+      backend.volumes = () => Promise.reject(new FilesError('io', 'no'));
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const notice = h.notice();
+      assert(notice && notice.length > 0,
+             'the window came up blank with no explanation');
+      equal(h.places().length, 0, 'places appeared from somewhere');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the notice is announced without interrupting',
+    run: async () => {
+      const backend = backendWith();
+      backend.volumes = () => Promise.reject(new FilesError('io', 'no'));
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle();
+      const notice = h.host.querySelector('.aurade-shell-notice')!;
+      equal(notice.getAttribute('role'), 'status',
+            'a notice this mild should not be an alert');
+      h.destroy();
+    },
+  },
+];
+
+export async function runShellDomTests(): Promise<DomResult[]> {
+  const results: DomResult[] = [];
+  for (const testCase of CASES) {
+    try {
+      await testCase.run();
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  return results;
+}
