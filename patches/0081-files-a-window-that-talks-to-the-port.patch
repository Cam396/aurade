diff --git a/ui/file_manager/file_manager/aurade/tests/ui/places_test.ts b/ui/file_manager/file_manager/aurade/tests/ui/places_test.ts
new file mode 100644
index 000000000000..db1012c0aa88
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/ui/places_test.ts
@@ -0,0 +1,143 @@
+/**
+ * Volume kinds, and what they mean in a sidebar.
+ *
+ * This is the only place that knows `drive` means somebody's Google Drive
+ * rather than a disk, so it is the only place that can get it wrong.
+ */
+import type {Volume, VolumeKind} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {firstDestination, placeKindFor, placesFor} from '../../ui/places.js';
+
+function volume(id: string, kind: VolumeKind, removable = false): Volume {
+  return {
+    id,
+    root: asFileKey(`mock://${id}`),
+    label: id,
+    kind,
+    removable,
+    readOnly: false,
+    capacity: null,
+  };
+}
+
+interface Check {
+  name: string;
+  run(): void;
+}
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'a cloud, a phone and a container are not this computer',
+    run() {
+      for (const kind of ['drive', 'provided', 'android', 'crostini'] as
+           VolumeKind[]) {
+        equal(placeKindFor(volume('x', kind)), 'network',
+              `${kind} was filed as part of the machine`);
+      }
+    },
+  },
+  {
+    name: 'a disk is a disk whether or not it comes out',
+    run() {
+      equal(placeKindFor(volume('x', 'system')), 'volume', 'system');
+      equal(placeKindFor(volume('x', 'removable', true)), 'volume', 'removable');
+      equal(placeKindFor(volume('x', 'mtp')), 'volume', 'mtp');
+      equal(placeKindFor(volume('x', 'archive')), 'volume', 'archive');
+    },
+  },
+  {
+    name: 'recent and trash are places you go, not drives you have',
+    run() {
+      equal(placeKindFor(volume('x', 'recent')), 'recent', 'recent');
+      equal(placeKindFor(volume('x', 'trash')), 'trash', 'trash');
+    },
+  },
+  {
+    name: 'nothing is invented that the backend did not offer',
+    run() {
+      const places = placesFor([volume('a', 'system')]);
+      equal(places.length, 1, 'a place appeared from nowhere');
+      // A Basket nobody asked for is a destination that leads somewhere the
+      // backend has never heard of.
+      assert(!places.some(place => place.kind === 'basket'),
+             'a basket was offered without one existing');
+    },
+  },
+  {
+    name: 'the basket appears only when there is one',
+    run() {
+      const withBasket =
+          placesFor([volume('a', 'system')], {basketKey: 'fake://basket',
+                                              basketCount: 2});
+      assert(withBasket.some(place => place.kind === 'basket'),
+             'the basket was dropped');
+      const keyOnly =
+          placesFor([volume('a', 'system')], {basketKey: 'fake://basket'});
+      assert(!keyOnly.some(place => place.kind === 'basket'),
+             'a basket with no count is not a basket');
+    },
+  },
+  {
+    name: 'the capacity survives the mapping',
+    run() {
+      const disk: Volume = {
+        ...volume('a', 'system'),
+        capacity: {total: 100, free: 50},
+      };
+      const [place] = placesFor([disk]);
+      equal(place!.volume?.capacity?.free, 50,
+            'the sidebar cannot draw what the mapping threw away');
+    },
+  },
+  {
+    name: 'the window opens on a drive, not on Recent',
+    run() {
+      const places = placesFor(
+          [volume('recent', 'recent'), volume('home', 'system')]);
+      equal(firstDestination(places)?.label, 'home',
+            'opening onto Recent shows everywhere before you asked for anywhere');
+    },
+  },
+  {
+    name: 'with no local disk it still opens somewhere',
+    run() {
+      const places =
+          placesFor([volume('recent', 'recent'), volume('gdrive', 'drive')]);
+      equal(firstDestination(places)?.label, 'gdrive',
+            'a machine with only a cloud mount should still open onto it');
+      equal(firstDestination([]), undefined, 'nothing to open is not a crash');
+    },
+  },
+];
+
+export function runPlacesTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const check of CHECKS) {
+    try {
+      check.run();
+      passed++;
+    } catch (error) {
+      failures.push(`  FAIL ${check.name}\n       ${
+          error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`places: ${passed}/${CHECKS.length} passed`);
+  for (const failure of failures) {
+    console.log(failure);
+  }
+  return failures.length === 0;
+}
