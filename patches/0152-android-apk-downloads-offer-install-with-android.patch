 namespace {
 
+// AuraDE: a finished .apk is offered to the Android service.
+bool IsAndroidPackage(const DownloadUIModel& item) {
+#if BUILDFLAG(IS_CHROMEOS)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("aurade-android")) {
+    return false;
+  }
+  return item.GetTargetFilePath().MatchesExtension(FILE_PATH_LITERAL(".apk"));
+#else
+  return false;
+#endif
+}
+
+void InstallAndroidPackage(const base::FilePath& path) {
+  base::LaunchOptions options;
+  base::Process process = base::LaunchProcess(
+      {"/usr/bin/aurade-android-install", path.value()}, options);
+  if (process.IsValid()) {
+    int exit_code = 0;
+    process.WaitForExit(&exit_code);
+  }
+}
