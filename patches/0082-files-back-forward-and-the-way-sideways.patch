+    name: 'the popover is actually on screen and not clipped away',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle();
+      await h.openRow('Documents');
+      await settle();
+      h.host.querySelector<HTMLElement>('.aurade-chevron[data-chevron="0"]')!
+          .click();
+      await settle();
+      const option =
+          h.host.querySelector<HTMLElement>('.aurade-path-option')!;
+      assert(option, 'no options were rendered');
+      const box = option.getBoundingClientRect();
+      assert(box.width > 0 && box.height > 0, 'the option has no size');
+      // A rect is reported whether or not an ancestor clips it, so the rect
+      // alone proves nothing. Hit testing is what a person actually does, and
+      // it is what an overflow:hidden ancestor breaks: the popover lived inside
+      // the path bar, which clips, and was sliced off at the height of the
+      // toolbar while still reporting its full size.
+      const hit = document.elementFromPoint(
+          Math.round(box.left + box.width / 2),
+          Math.round(box.top + box.height / 2));
+      assert(hit === option || option.contains(hit),
+             `something else is at the option's own centre: ${
+                 hit ? (hit as HTMLElement).className : 'nothing'}`);
+      // Visible is not the same as in the right place. The offsets are
+      // computed in script against the toolbar's box, so if the toolbar stops
+      // being the containing block the popover is still perfectly hittable and
+      // simply lands somewhere else entirely.
+      const popover = h.host.querySelector<HTMLElement>('.aurade-path-popover')!;
+      const chevron = h.host.querySelector<HTMLElement>(
+          '.aurade-chevron[data-chevron="0"]')!;
+      const bar = h.host.querySelector<HTMLElement>('.aurade-toolbar')!;
+      const popoverBox = popover.getBoundingClientRect();
+      const chevronBox = chevron.getBoundingClientRect();
+      assert(Math.abs(popoverBox.left - chevronBox.left) <= 2,
+             `the popover opened ${
+                 Math.round(popoverBox.left - chevronBox.left)}px away from its chevron`);
+      assert(popoverBox.top >= bar.getBoundingClientRect().bottom - 1,
+             'the popover opened over the toolbar rather than below it');
+      h.destroy();
+    },
+  },
