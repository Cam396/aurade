diff --git a/ui/file_manager/file_manager/aurade/tests/ui/history_test.ts b/ui/file_manager/file_manager/aurade/tests/ui/history_test.ts
new file mode 100644
index 000000000000..253762dfcef4
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/ui/history_test.ts
@@ -0,0 +1,129 @@
+/** Back, forward, and the trail. */
+import {asFileKey} from '../../port/types.js';
+import type {Trail, Visit} from '../../ui/history.js';
+import {History} from '../../ui/history.js';
+
+function visit(name: string): Visit {
+  return {key: asFileKey(`mock://${name}`), label: name};
+}
+function labels(trail: Trail|null): string {
+  return trail ? trail.map(step => step.label).join('/') : 'null';
+}
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+const HOME: Trail = [visit('home')];
+const DOCS: Trail = [visit('home'), visit('docs')];
+const WORK: Trail = [visit('home'), visit('docs'), visit('work')];
+
+interface Check {
+  name: string;
+  run(): void;
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'nothing to go back to at the start',
+    run() {
+      const history = new History();
+      equal(history.canGoBack(), false, 'back');
+      equal(history.canGoForward(), false, 'forward');
+      equal(history.current(), null, 'current');
+      equal(history.back(), null, 'back at the start is not a crash');
+    },
+  },
+  {
+    name: 'back and forward walk the route',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(WORK);
+      equal(labels(history.back()), 'home/docs', 'one back');
+      equal(labels(history.back()), 'home', 'two back');
+      equal(history.canGoBack(), false, 'and no further');
+      equal(labels(history.forward()), 'home/docs', 'forward again');
+    },
+  },
+  {
+    name: 'going somewhere new discards the branch you left',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(WORK);
+      history.back();
+      history.visit([visit('home'), visit('docs'), visit('photos')]);
+      equal(history.canGoForward(), false,
+            'work should not still be ahead of photos');
+      equal(labels(history.back()), 'home/docs', 'and back still works');
+    },
+  },
+  {
+    name: 'arriving where you already are is not a step',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(DOCS);
+      history.visit(DOCS);
+      equal(labels(history.back()), 'home',
+            'clicking the same place three times filled the history');
+    },
+  },
+  {
+    name: 'up removes the last step and stops at a root',
+    run() {
+      equal(labels(History.up(WORK)), 'home/docs', 'up from work');
+      equal(labels(History.up(HOME)), 'null', 'up from a root goes nowhere');
+    },
+  },
+  {
+    name: 'clicking a crumb cuts the trail there',
+    run() {
+      equal(labels(History.truncate(WORK, 0)), 'home', 'first crumb');
+      equal(labels(History.truncate(WORK, 1)), 'home/docs', 'second crumb');
+      equal(labels(History.truncate(WORK, 2)), 'home/docs/work', 'the last one');
+    },
+  },
+  {
+    name: 'stepping sideways replaces the last step rather than adding one',
+    run() {
+      equal(labels(History.sibling(WORK, visit('play'))), 'home/docs/play',
+            'a sibling is not a child');
+    },
+  },
+  {
+    name: 'an empty trail is refused rather than recorded',
+    run() {
+      const history = new History();
+      history.visit([]);
+      equal(history.current(), null, 'nowhere is not a place you have been');
+    },
+  },
+];
+
+export function runHistoryTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const check of CHECKS) {
+    try {
+      check.run();
+      passed++;
+    } catch (error) {
+      failures.push(`  FAIL ${check.name}\n       ${
+          error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`history: ${passed}/${CHECKS.length} passed`);
+  for (const failure of failures) {
+    console.log(failure);
+  }
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/history.ts b/ui/file_manager/file_manager/aurade/ui/history.ts
new file mode 100644
index 000000000000..ecc8995a5164
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/history.ts
@@ -0,0 +1,88 @@
+/**
+ * Back, forward, and how you got here.
+ *
+ * A breadcrumb is not a parsed path. `FileKey` is deliberately opaque, because
+ * a key can be a fake-entry:// for Recent or an archive mounted inside another
+ * archive, and none of those have a parent you can find by splitting on a
+ * slash. So the trail is a record of the route taken rather than a
+ * decomposition of the destination, which is also the only version that stays
+ * true when the same folder is reachable two ways.
+ */
+import type {FileKey} from '../port/types.js';
+
+export interface Visit {
+  readonly key: FileKey;
+  readonly label: string;
+}
+
+export type Trail = readonly Visit[];
+
+export class History {
+  private readonly entries: Trail[] = [];
+  private index = -1;
+
+  /**
+   * Records arriving somewhere. Anything ahead is discarded, the same way a
+   * browser does: once you go back and then somewhere new, the branch you left
+   * is not somewhere you can return to by pressing forward.
+   */
+  visit(trail: Trail): void {
+    if (!trail.length) {
+      return;
+    }
+    const here = this.current();
+    if (here && here.length === trail.length &&
+        here[here.length - 1]!.key === trail[trail.length - 1]!.key) {
+      // Arriving where you already are is not a step. Without this, clicking
+      // the same place twice fills the history with entries that all go
+      // nowhere, and back stops meaning anything.
+      return;
+    }
+    this.entries.length = this.index + 1;
+    this.entries.push(trail.slice());
+    this.index = this.entries.length - 1;
+  }
+
+  current(): Trail|null {
+    return this.entries[this.index] ?? null;
+  }
+
+  canGoBack(): boolean {
+    return this.index > 0;
+  }
+
+  canGoForward(): boolean {
+    return this.index >= 0 && this.index < this.entries.length - 1;
+  }
+
+  back(): Trail|null {
+    if (!this.canGoBack()) {
+      return null;
+    }
+    this.index--;
+    return this.current();
+  }
+
+  forward(): Trail|null {
+    if (!this.canGoForward()) {
+      return null;
+    }
+    this.index++;
+    return this.current();
+  }
+
+  /** The trail with the last step removed, or null at a root. */
+  static up(trail: Trail): Trail|null {
+    return trail.length > 1 ? trail.slice(0, -1) : null;
+  }
+
+  /** Everything down to and including `level`, for a breadcrumb click. */
+  static truncate(trail: Trail, level: number): Trail {
+    return trail.slice(0, level + 1);
+  }
+
+  /** Replaces the last step, for stepping sideways to a sibling. */
+  static sibling(trail: Trail, visit: Visit): Trail {
+    return [...trail.slice(0, -1), visit];
+  }
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/path_bar.ts b/ui/file_manager/file_manager/aurade/ui/path_bar.ts
new file mode 100644
index 000000000000..eb3c6095e96e
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/path_bar.ts
@@ -0,0 +1,266 @@
+/**
+ * Where you are, and the way sideways.
+ *
+ * The chevron between two crumbs is not decoration. It lists what else was in
+ * the folder to its left, so stepping from Documents/Work to Documents/Play is
+ * one click rather than up then down. Dolphin and Nautilus both have this and
+ * it is the single most missed thing when moving off them.
+ *
+ * A breadcrumb, not a path. See `history.ts` for why a `FileKey` cannot simply
+ * be split on a slash.
+ */
+import type {Trail, Visit} from './history.js';
+import {History} from './history.js';
+
+export interface PathBarOptions {
+  readonly onGo?: (trail: Trail) => void;
+  /**
+   * What else is in the folder at `level`. Returning an empty list is a fine
+   * answer and says the popover has nothing to show, which is different from
+   * the call failing.
+   */
+  readonly siblings?: (level: number) => Promise<readonly Visit[]>;
+}
+
+const CHEVRON =
+    '<svg class="aurade-chevron-glyph" viewBox="0 0 20 20" aria-hidden="true">' +
+    '<path d="M8 6l4 4-4 4" fill="none" stroke="currentColor" ' +
+    'stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
+
+export class PathBar {
+  private readonly nav: HTMLElement;
+  private readonly list: HTMLElement;
+  private trail: Trail = [];
+  private popover: HTMLElement|null = null;
+  private openAt = -1;
+  /** Bumped per open, so a slow reply for a closed popover is dropped. */
+  private generation = 0;
+
+  constructor(
+      container: HTMLElement, private readonly options: PathBarOptions = {}) {
+    this.nav = document.createElement('nav');
+    this.nav.className = 'aurade-path';
+    this.nav.setAttribute('aria-label', 'Location');
+    this.list = document.createElement('ol');
+    this.list.className = 'aurade-path-list';
+    this.nav.appendChild(this.list);
+    container.appendChild(this.nav);
+    this.nav.addEventListener('click', this.onClick);
+    this.nav.addEventListener('keydown', this.onKeyDown);
+    document.addEventListener('pointerdown', this.onDocumentPointerDown, true);
+  }
+
+  setTrail(trail: Trail): void {
+    this.trail = trail.slice();
+    this.close();
+    this.render();
+  }
+
+  private render(): void {
+    this.list.textContent = '';
+    this.trail.forEach((visit, level) => {
+      if (level > 0) {
+        this.list.appendChild(this.renderChevron(level - 1));
+      }
+      this.list.appendChild(this.renderCrumb(visit, level));
+    });
+    // A trailing chevron so the last folder's own contents are reachable the
+    // same way as every other level. Without it the deepest folder is the one
+    // place you cannot step sideways from.
+    if (this.trail.length) {
+      this.list.appendChild(this.renderChevron(this.trail.length - 1));
+    }
+  }
+
+  private renderCrumb(visit: Visit, level: number): HTMLElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'aurade-crumb';
+    button.dataset['level'] = String(level);
+    button.textContent = visit.label;
+    if (level === this.trail.length - 1) {
+      button.setAttribute('aria-current', 'page');
+    }
+    item.appendChild(button);
+    return item;
+  }
+
+  private renderChevron(level: number): HTMLElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'aurade-chevron';
+    button.dataset['chevron'] = String(level);
+    button.setAttribute('aria-expanded', 'false');
+    button.setAttribute('aria-haspopup', 'menu');
+    const at = this.trail[level];
+    // The name has to say which folder is about to be listed, because on a
+    // deep path there are five of these and they are otherwise identical.
+    button.setAttribute('aria-label', `What else is in ${at?.label ?? 'here'}`);
+    button.innerHTML = CHEVRON;
+    item.appendChild(button);
+    return item;
+  }
+
+  private async open(level: number, chevron: HTMLElement): Promise<void> {
+    if (this.openAt === level) {
+      this.close();
+      return;
+    }
+    this.close();
+    if (!this.options.siblings) {
+      return;
+    }
+    this.openAt = level;
+    chevron.setAttribute('aria-expanded', 'true');
+    const generation = ++this.generation;
+    let entries: readonly Visit[];
+    try {
+      entries = await this.options.siblings(level);
+    } catch {
+      if (generation === this.generation) {
+        this.showPopover(chevron, null);
+      }
+      return;
+    }
+    if (generation !== this.generation) {
+      return;
+    }
+    this.showPopover(chevron, entries);
+  }
+
+  private showPopover(chevron: HTMLElement, entries: readonly Visit[]|null):
+      void {
+    const popover = document.createElement('div');
+    popover.className = 'aurade-path-popover';
+    popover.setAttribute('role', 'menu');
+    if (entries === null) {
+      const message = document.createElement('p');
+      message.className = 'aurade-path-popover-empty';
+      message.textContent = 'That folder could not be read.';
+      popover.appendChild(message);
+    } else if (!entries.length) {
+      const message = document.createElement('p');
+      message.className = 'aurade-path-popover-empty';
+      // Not "no results": there is nothing wrong, there is simply nothing
+      // beside you.
+      message.textContent = 'No other folders here.';
+      popover.appendChild(message);
+    } else {
+      for (const entry of entries) {
+        const option = document.createElement('button');
+        option.type = 'button';
+        option.className = 'aurade-path-option';
+        option.setAttribute('role', 'menuitem');
+        option.dataset['key'] = entry.key;
+        option.textContent = entry.label;
+        popover.appendChild(option);
+      }
+    }
+    // Anchored to the toolbar rather than to the chevron's own list item. The
+    // path bar clips horizontally so a deep trail cannot push the toolbar
+    // wider, and a clip is a clip: keeping the popover inside it cut the
+    // popover off at the height of the bar.
+    const host = (this.nav.parentElement ?? this.nav) as HTMLElement;
+    popover.addEventListener('click', this.onPopoverClick);
+    popover.addEventListener('keydown', this.onKeyDown);
+    host.appendChild(popover);
+    const anchor = chevron.getBoundingClientRect();
+    const frame = host.getBoundingClientRect();
+    popover.style.insetBlockStart = `${Math.round(frame.height) + 2}px`;
+    if (getComputedStyle(host).direction === 'rtl') {
+      popover.style.right = `${Math.round(frame.right - anchor.right)}px`;
+    } else {
+      // Clamped so a chevron near the right edge does not open a popover that
+      // runs off the window.
+      const width = popover.offsetWidth;
+      const left = Math.min(
+          Math.round(anchor.left - frame.left),
+          Math.max(0, Math.round(frame.width - width - 4)));
+      popover.style.left = `${left}px`;
+    }
+    this.popover = popover;
+    const first = popover.querySelector<HTMLElement>('.aurade-path-option');
+    first?.focus();
+  }
+
+  private close(): void {
+    this.generation++;
+    this.popover?.remove();
+    this.popover = null;
+    if (this.openAt >= 0) {
+      this.nav
+          .querySelector(`[data-chevron="${this.openAt}"]`)
+          ?.setAttribute('aria-expanded', 'false');
+    }
+    this.openAt = -1;
+  }
+
+  private onPopoverClick = (event: MouseEvent): void => {
+    const option = (event.target as HTMLElement|null)
+                       ?.closest?.('.aurade-path-option') as HTMLElement|null;
+    if (!option) {
+      return;
+    }
+    const level = this.openAt;
+    const key = option.dataset['key']!;
+    const label = option.textContent ?? '';
+    this.close();
+    // Truncate to the chevron's own level, then step in. That is a sibling of
+    // whatever was next, which is the whole point of the control.
+    const base = History.truncate(this.trail, level);
+    this.options.onGo?.([...base, {key: key as Visit['key'], label}]);
+  };
+
+  private onClick = (event: MouseEvent): void => {
+    const target = event.target as HTMLElement|null;
+    const chevron = target?.closest?.('.aurade-chevron') as HTMLElement|null;
+    if (chevron) {
+      void this.open(Number(chevron.dataset['chevron']), chevron);
+      return;
+    }
+    const crumb = target?.closest?.('.aurade-crumb') as HTMLElement|null;
+    if (crumb) {
+      this.close();
+      const level = Number(crumb.dataset['level']);
+      if (level < this.trail.length - 1) {
+        this.options.onGo?.(History.truncate(this.trail, level));
+      }
+    }
+  };
+
+  private onKeyDown = (event: KeyboardEvent): void => {
+    if (event.key !== 'Escape' || this.openAt < 0) {
+      return;
+    }
+    const chevron = this.nav.querySelector<HTMLElement>(
+        `[data-chevron="${this.openAt}"]`);
+    this.close();
+    // Focus goes back to what opened it, or it lands on the document body and
+    // the next Tab starts from the top of the page.
+    chevron?.focus();
+    event.preventDefault();
+  };
+
+  private onDocumentPointerDown = (event: Event): void => {
+    if (this.openAt < 0) {
+      return;
+    }
+    const target = event.target as Node|null;
+    // The popover is a sibling of the path bar now, so containment has to be
+    // checked against both or the first click on an option closes it before
+    // that click can land.
+    const inside = target &&
+        (this.nav.contains(target) || this.popover?.contains(target));
+    if (!inside) {
+      this.close();
+    }
+  };
+
+  destroy(): void {
+    document.removeEventListener(
+        'pointerdown', this.onDocumentPointerDown, true);
+    this.nav.remove();
+  }
+}
