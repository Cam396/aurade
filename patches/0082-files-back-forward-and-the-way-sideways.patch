+  }
+
+  private onPopoverClick = (event: MouseEvent): void => {
+    const option = (event.target as HTMLElement|null)
+                       ?.closest?.('.aurade-path-option') as HTMLElement|null;
+    if (!option) {
+      return;
+    }
+    const level = this.openAt;
+    const key = option.dataset['key']!;
+    const label = option.textContent ?? '';
+    this.close();
+    // Truncate to the chevron's own level, then step in. That is a sibling of
+    // whatever was next, which is the whole point of the control.
+    const base = History.truncate(this.trail, level);
