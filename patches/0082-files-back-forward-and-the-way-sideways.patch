diff --git a/ui/file_manager/file_manager/aurade/tests/ui/history_test.ts b/ui/file_manager/file_manager/aurade/tests/ui/history_test.ts
new file mode 100644
index 000000000000..253762dfcef4
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/ui/history_test.ts
@@ -0,0 +1,129 @@
+/** Back, forward, and the trail. */
+import {asFileKey} from '../../port/types.js';
+import type {Trail, Visit} from '../../ui/history.js';
+import {History} from '../../ui/history.js';
+
+function visit(name: string): Visit {
+  return {key: asFileKey(`mock://${name}`), label: name};
+}
+function labels(trail: Trail|null): string {
+  return trail ? trail.map(step => step.label).join('/') : 'null';
+}
+
+class AssertionError extends Error {}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+const HOME: Trail = [visit('home')];
+const DOCS: Trail = [visit('home'), visit('docs')];
+const WORK: Trail = [visit('home'), visit('docs'), visit('work')];
+
+interface Check {
+  name: string;
+  run(): void;
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'nothing to go back to at the start',
+    run() {
+      const history = new History();
+      equal(history.canGoBack(), false, 'back');
+      equal(history.canGoForward(), false, 'forward');
+      equal(history.current(), null, 'current');
+      equal(history.back(), null, 'back at the start is not a crash');
+    },
+  },
+  {
+    name: 'back and forward walk the route',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(WORK);
+      equal(labels(history.back()), 'home/docs', 'one back');
+      equal(labels(history.back()), 'home', 'two back');
+      equal(history.canGoBack(), false, 'and no further');
+      equal(labels(history.forward()), 'home/docs', 'forward again');
+    },
+  },
+  {
+    name: 'going somewhere new discards the branch you left',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(WORK);
+      history.back();
+      history.visit([visit('home'), visit('docs'), visit('photos')]);
+      equal(history.canGoForward(), false,
+            'work should not still be ahead of photos');
+      equal(labels(history.back()), 'home/docs', 'and back still works');
+    },
+  },
+  {
+    name: 'arriving where you already are is not a step',
+    run() {
+      const history = new History();
+      history.visit(HOME);
+      history.visit(DOCS);
+      history.visit(DOCS);
+      history.visit(DOCS);
+      equal(labels(history.back()), 'home',
+            'clicking the same place three times filled the history');
+    },
+  },
+  {
+    name: 'up removes the last step and stops at a root',
+    run() {
+      equal(labels(History.up(WORK)), 'home/docs', 'up from work');
+      equal(labels(History.up(HOME)), 'null', 'up from a root goes nowhere');
+    },
+  },
+  {
+    name: 'clicking a crumb cuts the trail there',
+    run() {
+      equal(labels(History.truncate(WORK, 0)), 'home', 'first crumb');
+      equal(labels(History.truncate(WORK, 1)), 'home/docs', 'second crumb');
+      equal(labels(History.truncate(WORK, 2)), 'home/docs/work', 'the last one');
+    },
+  },
+  {
+    name: 'stepping sideways replaces the last step rather than adding one',
+    run() {
+      equal(labels(History.sibling(WORK, visit('play'))), 'home/docs/play',
+            'a sibling is not a child');
+    },
+  },
+  {
+    name: 'an empty trail is refused rather than recorded',
+    run() {
+      const history = new History();
+      history.visit([]);
+      equal(history.current(), null, 'nowhere is not a place you have been');
+    },
+  },
+];
+
+export function runHistoryTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const check of CHECKS) {
+    try {
+      check.run();
+      passed++;
+    } catch (error) {
+      failures.push(`  FAIL ${check.name}\n       ${
+          error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`history: ${passed}/${CHECKS.length} passed`);
+  for (const failure of failures) {
+    console.log(failure);
+  }
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/aurade/ui/history.ts b/ui/file_manager/file_manager/aurade/ui/history.ts
new file mode 100644
index 000000000000..ecc8995a5164
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/history.ts
@@ -0,0 +1,88 @@
+/**
+ * Back, forward, and how you got here.
+ *
+ * A breadcrumb is not a parsed path. `FileKey` is deliberately opaque, because
+ * a key can be a fake-entry:// for Recent or an archive mounted inside another
+ * archive, and none of those have a parent you can find by splitting on a
+ * slash. So the trail is a record of the route taken rather than a
+ * decomposition of the destination, which is also the only version that stays
+ * true when the same folder is reachable two ways.
+ */
+import type {FileKey} from '../port/types.js';
+
+export interface Visit {
+  readonly key: FileKey;
+  readonly label: string;
+}
+
+export type Trail = readonly Visit[];
+
+export class History {
+  private readonly entries: Trail[] = [];
+  private index = -1;
+
+  /**
+   * Records arriving somewhere. Anything ahead is discarded, the same way a
+   * browser does: once you go back and then somewhere new, the branch you left
+   * is not somewhere you can return to by pressing forward.
+   */
+  visit(trail: Trail): void {
+    if (!trail.length) {
+      return;
+    }
+    const here = this.current();
+    if (here && here.length === trail.length &&
+        here[here.length - 1]!.key === trail[trail.length - 1]!.key) {
+      // Arriving where you already are is not a step. Without this, clicking
+      // the same place twice fills the history with entries that all go
+      // nowhere, and back stops meaning anything.
+      return;
+    }
+    this.entries.length = this.index + 1;
+    this.entries.push(trail.slice());
+    this.index = this.entries.length - 1;
+  }
+
+  current(): Trail|null {
+    return this.entries[this.index] ?? null;
+  }
+
+  canGoBack(): boolean {
+    return this.index > 0;
+  }
+
+  canGoForward(): boolean {
+    return this.index >= 0 && this.index < this.entries.length - 1;
+  }
+
+  back(): Trail|null {
+    if (!this.canGoBack()) {
+      return null;
+    }
+    this.index--;
+    return this.current();
+  }
+
+  forward(): Trail|null {
+    if (!this.canGoForward()) {
+      return null;
+    }
+    this.index++;
+    return this.current();
+  }
+
+  /** The trail with the last step removed, or null at a root. */
+  static up(trail: Trail): Trail|null {
+    return trail.length > 1 ? trail.slice(0, -1) : null;
+  }
+
+  /** Everything down to and including `level`, for a breadcrumb click. */
+  static truncate(trail: Trail, level: number): Trail {
+    return trail.slice(0, level + 1);
+  }
+
+  /** Replaces the last step, for stepping sideways to a sibling. */
+  static sibling(trail: Trail, visit: Visit): Trail {
+    return [...trail.slice(0, -1), visit];
+  }
+}
