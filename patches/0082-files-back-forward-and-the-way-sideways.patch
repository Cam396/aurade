+/**
+ * Back, forward, up, and where you are.
+ *
+ * Three buttons and a path bar. The buttons are disabled rather than hidden
+ * when there is nowhere to go, because a control that appears and disappears
+ * moves everything beside it and makes the row impossible to aim at.
+ */
+import type {Trail} from './history.js';
+import type {PathBarOptions} from './path_bar.js';
+import {PathBar} from './path_bar.js';
+
+const GLYPHS = {
+  back: 'M12.5 4.5 7 10l5.5 5.5',
+  forward: 'M7.5 4.5 13 10l-5.5 5.5',
+  up: 'M10 15.5V5m0 0-4.5 4.5M10 5l4.5 4.5',
+};
+
+export interface ToolbarOptions extends PathBarOptions {
+  readonly onBack?: () => void;
+  readonly onForward?: () => void;
+  readonly onUp?: () => void;
+}
+
+function button(kind: keyof typeof GLYPHS, label: string): HTMLButtonElement {
+  const element = document.createElement('button');
+  element.type = 'button';
+  element.className = 'aurade-tool';
+  element.dataset['tool'] = kind;
+  // The name is on the button rather than on a tooltip, because a tooltip is
+  // not a name and a glyph on its own has none.
+  element.setAttribute('aria-label', label);
+  element.disabled = true;
+  element.innerHTML =
+      `<svg class="aurade-tool-glyph" viewBox="0 0 20 20" aria-hidden="true">` +
+      `<path d="${GLYPHS[kind]}" fill="none" stroke="currentColor" ` +
+      `stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
+  return element;
+}
+
+export class Toolbar {
+  private readonly bar: HTMLElement;
+  private readonly back: HTMLButtonElement;
+  private readonly forward: HTMLButtonElement;
+  private readonly up: HTMLButtonElement;
+  readonly pathBar: PathBar;
+
+  constructor(container: HTMLElement, options: ToolbarOptions = {}) {
+    this.bar = document.createElement('div');
+    this.bar.className = 'aurade-toolbar';
+    this.bar.setAttribute('role', 'toolbar');
+    this.bar.setAttribute('aria-label', 'Navigation');
+
+    const group = document.createElement('div');
+    group.className = 'aurade-tool-group';
+    this.back = button('back', 'Back');
+    this.forward = button('forward', 'Forward');
+    this.up = button('up', 'Up one folder');
+    group.append(this.back, this.forward, this.up);
+
+    this.back.addEventListener('click', () => options.onBack?.());
+    this.forward.addEventListener('click', () => options.onForward?.());
+    this.up.addEventListener('click', () => options.onUp?.());
+
+    this.bar.appendChild(group);
