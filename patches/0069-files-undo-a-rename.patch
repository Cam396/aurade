+  /**
+   * AuraDE: offer to put the old name back, on the toast that is already used
+   * to undo a delete.
+   *
+   * Renaming is the operation people mistype, and until now the only way back
+   * was to remember the old name and type it again. Deleting a file has
+   * offered an undo for years; the one that is actually a slip of the fingers
+   * offered nothing.
+   *
+   * The undo goes through renameEntry rather than calling moveTo directly.
+   * moveTo overwrites whatever sits at the destination, and renameFile checks
+   * for an existing entry first and throws instead. A toast lives for several
+   * seconds, which is long enough for something to appear at the old name, and
+   * silently destroying it would be a worse bug than the one being undone.
+   */
+  private auraDeOfferRenameUndo_(
+      renamed: Entry|FilesAppEntry, oldName: string,
+      volumeInfo: VolumeInfo|null) {
+    this.toast_.show(strf('AURADE_RENAME_UNDO_TOAST', renamed.name), {
+      text: str('AURADE_UNDO_ACTION_LABEL'),
+      callback: async () => {
+        try {
+          const restored =
+              await renameEntry(renamed, oldName, volumeInfo, false);
+          await this.directoryModel_.onRenameEntry(renamed, restored!);
+        } catch (error: any) {
+          // A toast, not a dialog. The rename being undone already succeeded,
+          // so nothing is broken, and a modal would be out of proportion to
+          // somebody who has simply changed their mind twice.
+          console.warn('AuraDE: could not undo the rename: ' + error);
+          this.toast_.show(str('AURADE_RENAME_UNDO_FAILED'));
+        }
+      },
+    });
