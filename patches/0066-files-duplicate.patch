 }
 
 /**
+ * AuraDE: whether this entry sits directly in this folder.
+ *
+ * The selection is not always in the folder on screen. In search results and
+ * in Recent, the rows come from wherever they happen to live, and a copy into
+ * the current folder would then be a fetch rather than a duplicate: a file
+ * would appear in a folder it was never in, from a command that promised to
+ * leave things where they are.
+ *
+ * The volume is compared as well as the path, because fullPath is relative to
+ * its own filesystem and two volumes can hold the same one.
+ */
+function auraDeSitsIn(
+    entry: Entry|FilesAppEntry, dirEntry: Entry|FilesAppEntry,
+    volumeManager: VolumeManager): boolean {
+  const path = entry.fullPath;
+  const dir = dirEntry.fullPath;
+  if (!path || !dir) {
+    return false;
+  }
+  const slash = path.lastIndexOf('/');
+  const parent = slash <= 0 ? '/' : path.slice(0, slash);
+  if (parent !== dir) {
+    return false;
+  }
+  return volumeManager.getVolumeInfo(entry) ===
+      volumeManager.getVolumeInfo(dirEntry);
+}
+
+/**
+ * AuraDE: makes a second copy of the selection, beside the first.
+ *
+ * Every desktop file manager has this and Files does not, so the way to get a
+ * spare copy before editing something is copy, then paste, then find the thing
+ * that paste put somewhere. Three steps and a guess, for what is one intention.
+ *
+ * The rename is not ours. A copy task always runs its destination through
+ * GenerateUnusedFilename, so copying into the folder the file is already in
+ * lands as "report (1).pdf" with no conflict dialog and nothing to answer.
+ * That is the whole implementation: the naming, the progress panel, the undo
+ * entry and the error reporting are the ones Files already has.
+ *
+ * No keyboard shortcut, for the same reason as Copy name and Copy path: ash
+ * reads every chord in this window first, and Ctrl+D in particular is already
+ * spoken for.
+ */
+export class DuplicateCommand extends FilesCommand {
+  execute(_event: CommandEvent, fileManager: CommandHandlerDeps) {
+    if (isOnTrashRoot(fileManager)) {
+      return;
+    }
+    const dirEntry = fileManager.getCurrentDirectoryEntry();
+    const entries = fileManager.getSelection().entries;
+    if (!dirEntry || entries.length === 0) {
+      return;
+    }
+    // Checked again here and not only in canExecute, because canExecute runs
+    // when the menu is built and the selection can change under a command
+    // invoked from anywhere else.
+    if (!entries.every(
+            entry => auraDeSitsIn(entry, dirEntry, fileManager.volumeManager))) {
+      return;
+    }
+    startIOTask(
+        chrome.fileManagerPrivate.IoTaskType.COPY, entries,
+        {destinationFolder: dirEntry as DirectoryEntry});
+    const message = entries.length === 1 ?
+        `Duplicating ${entries[0]!.name}` :
+        `Duplicating ${entries.length} items`;
+    fileManager.ui.speakA11yMessage(message);
+  }
+
+  override canExecute(event: CanExecuteEvent, fileManager: CommandHandlerDeps) {
+    const dirEntry = fileManager.getCurrentDirectoryEntry();
+    const entries = fileManager.getSelection().entries;
+    const canDuplicate = !!dirEntry && entries.length > 0 &&
+        !isOnTrashRoot(fileManager) &&
+        !fileManager.directoryModel.isReadOnly() &&
+        entries.every(
+            entry => auraDeSitsIn(entry, dirEntry, fileManager.volumeManager)) &&
+        entries.every(shouldShowMenuItemsForEntry.bind(
+            null, fileManager.volumeManager));
+    event.canExecute = canDuplicate;
+    event.command.setHidden(!canDuplicate);
+    event.command.label = entries.length > 1 ?
+        `Duplicate ${entries.length} items` :
+        'Duplicate';
+  }
+}
