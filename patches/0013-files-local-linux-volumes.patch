+void VolumeManager::RegisterAuraDELocalRootVolumes() {
+  const base::FilePath home = base::GetHomeDir();
+  if (!home.empty()) {
+    RegisterLocalRootVolume(u"Home", home.value());
+    RegisterLocalRootVolume(u"Desktop", home.AppendASCII("Desktop").value());
+    RegisterLocalRootVolume(u"Documents", home.AppendASCII("Documents").value());
+    RegisterLocalRootVolume(u"Downloads", home.AppendASCII("Downloads").value());
+    RegisterLocalRootVolume(u"Music", home.AppendASCII("Music").value());
+    RegisterLocalRootVolume(u"Pictures", home.AppendASCII("Pictures").value());
+    RegisterLocalRootVolume(u"Videos", home.AppendASCII("Videos").value());
+  }
+
+  RegisterLocalRootVolume(u"Filesystem Root", "/");
+  RegisterLocalRootVolume(u"Users", "/home");
+  // AuraDE compatibility: udisks2 mounts removable media below
+  // /run/media/$USER. Keep that standard hierarchy exposed as the stable
+  // local_root:media entry used by Files.
+  RegisterLocalRootVolume(u"Media", "/run/media");
+  RegisterLocalRootVolume(u"Mounts", "/mnt");
+  RegisterLocalRootVolume(u"Local Software", "/usr/local");
+  RegisterLocalRootVolume(u"Optional Software", "/opt");
+}
+
+void VolumeManager::RegisterLocalRootVolume(const std::u16string& label,
+                                            const std::string& path) {
+  const base::FilePath real_path(path);
+  std::unique_ptr<Volume> volume = Volume::CreateForLocalRoot(
+      real_path, real_path, base::UTF16ToUTF8(label));
+
+  // Register with ExternalMountPoints so the fileManagerPrivate API can
+  // resolve filesystem URLs for this path. Use the volume ID as the mount name
+  // so getVolumeRoot can bypass reverse path lookup for overlapping paths.
+  // AuraDE compatibility: register as kFileSystemTypeLocal, matching the
+  // standard Downloads mount. kFileSystemTypeLocalMedia is owned by the
+  // media-gallery backend, whose MediaPathFilter hides every non-media file
+  // from directory listings.
+  const std::string mount_name = volume->volume_id();
+  storage::ExternalMountPoints* const mount_points =
+      storage::ExternalMountPoints::GetSystemInstance();
+  mount_points->RevokeFileSystem(mount_name);
+  mount_points->RegisterFileSystem(mount_name, storage::kFileSystemTypeLocal,
+                                   storage::FileSystemMountOption(), real_path);
+  DoMountEvent(std::move(volume));
+}
