   void OnSessionStateChanged() override {
     TRACE_EVENT0("ui",
                  "ChromeShelfControllerInitializer::OnSessionStateChanged");
-    DCHECK(!chrome_shelf_controller_);
-    DCHECK(!ChromeShelfController::instance());
+    if (chrome_shelf_controller_ || ChromeShelfController::instance()) {
+      // HACK(AuraDE): If we created the shelf early at LOGIN_PRIMARY with the
+      // sign-in profile, switch to the user's profile when the session becomes
+      // active. The observer was intentionally kept alive for this transition.
+      if (ChromeShelfController::instance() &&
+          session_manager::SessionManager::Get()->session_state() ==
+              session_manager::SessionState::ACTIVE) {
+        ChromeShelfController::instance()->OnUserProfileReadyToSwitch(
+            ProfileManager::GetActiveUserProfile());
+        session_manager::SessionManager::Get()->RemoveObserver(this);
+      }
+      return;
+    }
 
+    // Create the shelf when the session reaches ACTIVE and a user profile
+    // is available. On linux-chromeos, LOGIN_PRIMARY uses the sign-in profile
+    // which lacks proper services (e.g. AppServiceProxy), so we avoid creating
+    // the shelf at that state — it would crash on Init().
+    // The shelf is instead created here at ACTIVE, then the OnUserProfileLoaded
+    // handler below calls OnUserProfileReadyToSwitch to bind it.
     if (session_manager::SessionManager::Get()->session_state() ==
-        session_manager::SessionState::ACTIVE) {
+            session_manager::SessionState::ACTIVE) {
       chrome_shelf_controller_ = std::make_unique<ChromeShelfController>(
           nullptr, ash::ShelfModel::Get());
       chrome_shelf_controller_->Init();
 
+      // Shelf layout manager needs to recalculate visibility now that the
+      // ChromeShelfController exists. Without this the shelf stays hidden
+      // because UpdateVisibilityState was called during session activation
+      // before the controller was ready.
+      if (auto* shelf = ash::Shelf::ForWindow(
+              ash::Shell::GetPrimaryRootWindow())) {
+        shelf->shelf_layout_manager()->UpdateVisibilityState(
+            /*force_layout=*/true);
+      }
+
       session_manager::SessionManager::Get()->RemoveObserver(this);
     }
   }
@@ -216,6 +246,50 @@ class ChromeBrowserMainExtraPartsAsh::UserProfileLoadedObserver
     if (multi_user_window_manager_browser_adaptor_) {
       multi_user_window_manager_browser_adaptor_->AddUser(account_id);
