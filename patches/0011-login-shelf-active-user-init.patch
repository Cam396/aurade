+
+    // HACK(AuraDE): Notify subsystems of the active user so their internal
+    // state is initialized. On real ChromeOS this happens via
+    // SessionControllerImpl::SetUserSessionOrder (triggered by the
+    // session_manager daemon over Mojo), but on linux-chromeos with stubs
+    // that call never arrives. Without this:
+    //   - MultiUserWindowManager: current_account_id_ stays empty, any
+    //     transient window creation (right-click menu) SIGABRTs.
+    //   - DesksClient: active_profile_ stays null, desks storage manager
+    //     never created, any saved-desk/recap access DCHECKs on null.
+    //   - ShelfController: auto_hide_behavior stays kAlwaysHidden (default),
+    //     so the shelf never allocates space or becomes visible.
+    //   - GeolocationPrivacySwitchController: cached_access_level_ stays
+    //     empty, crashes when Settings opens.
+    // Only fan out manually when ash already has a user session. In the
+    // shim-driven local-account flow the profile loads before the first
+    // session reaches ash; MultiUserWindowManager and DesksClient are
+    // ash::SessionObservers, so they get this notification naturally once
+    // chrome pushes the session moments later.
+    const bool ash_has_user_session =
+        ash::Shell::Get()->session_controller()->GetUserSession(0) != nullptr;
+    if (ash_has_user_session) {
+      if (auto* muwm = ash::MultiUserWindowManager::Get()) {
+        muwm->OnActiveUserSessionChanged(account_id);
+      }
+      if (auto* desks_client = DesksClient::Get()) {
+        desks_client->OnActiveUserSessionChanged(account_id);
+      }
+    }
+    if (profile) {
+      // The ShelfController's OnActiveUserPrefServiceChanged (which reads
+      // auto_hide from user prefs) is private and never called on
+      // linux-chromeos (no session_manager daemon). Without it the shelf
+      // stays in its default kAlwaysHidden state. Override it directly.
+      for (aura::Window* root : ash::Shell::Get()->GetAllRootWindows()) {
+        if (auto* shelf = ash::Shelf::ForWindow(root)) {
+          shelf->SetAutoHideBehavior(
+              ash::ShelfAutoHideBehavior::kNever);
+          shelf->shelf_layout_manager()->UpdateVisibilityState(
+              /*force_layout=*/true);
+        }
+      }
+    }
+
     if (ChromeShelfController::instance()) {
       ChromeShelfController::instance()->OnUserProfileReadyToSwitch(profile);
     }
