+TEST_F(VersionUpdaterCrosTest,
+       GenericUpdateFailureRemainsVisibleUntilSuccessfulRetry) {
+  base::test::ScopedChromeOSVersionInfo version_info(/*lsb_release=*/"",
+                                                     base::Time());
+  SetEthernetService();
+
+  update_engine::StatusResult status;
+  status.set_current_operation(update_engine::Operation::ERROR);
+  status.set_last_attempt_error(
+      static_cast<int32_t>(update_engine::ErrorCode::kError));
+  fake_update_engine_client_->set_default_status(status);
+
+  StrictMock<base::MockCallback<VersionUpdater::StatusCallback>> mock_callback;
+  testing::InSequence sequence;
+  EXPECT_CALL(mock_callback, Run(VersionUpdater::FAILED, _, _, _, _, _, _))
+      .Times(2);
+  EXPECT_CALL(mock_callback, Run(VersionUpdater::CHECKING, _, _, _, _, _, _));
+  EXPECT_CALL(mock_callback, Run(VersionUpdater::UPDATED, _, _, _, _, _, _));
+
+  version_updater_->GetUpdateStatus(mock_callback.Get());
+
+  status.set_current_operation(update_engine::Operation::IDLE);
+  fake_update_engine_client_->NotifyObserversThatStatusChanged(status);
+
+  status.set_current_operation(update_engine::Operation::CHECKING_FOR_UPDATE);
+  status.set_last_attempt_error(
+      static_cast<int32_t>(update_engine::ErrorCode::kSuccess));
+  fake_update_engine_client_->NotifyObserversThatStatusChanged(status);
+
+  status.set_current_operation(update_engine::Operation::IDLE);
+  fake_update_engine_client_->NotifyObserversThatStatusChanged(status);
+}
