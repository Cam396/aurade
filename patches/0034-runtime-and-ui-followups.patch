+auto RespondWithJson(std::string expected_method, std::string json) {
+  return [expected_method = std::move(expected_method), json = std::move(json)](
+             dbus::MethodCall* method_call, int /* timeout_ms */,
+             dbus::MockObjectProxy::ResponseCallback callback) {
+    EXPECT_EQ(expected_method, method_call->GetMember());
+    std::unique_ptr<dbus::Response> response = dbus::Response::CreateEmpty();
+    dbus::MessageWriter writer(response.get());
+    writer.AppendString(json);
+    std::move(callback).Run(response.get());
+  };
+}
+
+auto RespondWithNoResponse(std::string expected_method) {
+  return [expected_method = std::move(expected_method)](
+             dbus::MethodCall* method_call, int /* timeout_ms */,
+             dbus::MockObjectProxy::ResponseCallback callback) {
+    EXPECT_EQ(expected_method, method_call->GetMember());
+    std::move(callback).Run(nullptr);
+  };
+}
