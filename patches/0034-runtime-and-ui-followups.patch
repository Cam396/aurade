+class RecordingUpdateEngineObserver : public UpdateEngineClient::Observer {
+ public:
+  void UpdateStatusChanged(const update_engine::StatusResult& status) override {
+    statuses.push_back(status);
+  }
+
+  std::vector<update_engine::StatusResult> statuses;
+};
+
+class UpdateEngineClientAuraTest : public ::testing::Test {
+ public:
+  UpdateEngineClientAuraTest()
+      : bus_(base::MakeRefCounted<::testing::NiceMock<dbus::MockBus>>(
+            dbus::Bus::Options{})),
+        host_bridge_proxy_(base::MakeRefCounted<dbus::MockObjectProxy>(
+            bus_.get(),
+            kAuraHostBridgeService,
+            dbus::ObjectPath(kAuraHostBridgePath))),
+        login_manager_proxy_(base::MakeRefCounted<dbus::MockObjectProxy>(
+            bus_.get(),
+            kLoginManagerService,
+            dbus::ObjectPath(kLoginManagerPath))) {}
+
+ protected:
+  void SetUp() override {
+    ON_CALL(*bus_, GetObjectProxy(kAuraHostBridgeService,
+                                  dbus::ObjectPath(kAuraHostBridgePath)))
+        .WillByDefault(Return(host_bridge_proxy_.get()));
+    ON_CALL(*bus_, GetObjectProxy(kLoginManagerService,
+                                  dbus::ObjectPath(kLoginManagerPath)))
+        .WillByDefault(Return(login_manager_proxy_.get()));
+
+    UpdateEngineClient::InitializeAura(bus_.get());
+    client_ = UpdateEngineClient::Get();
+    ASSERT_TRUE(client_);
+    client_->AddObserver(&observer_);
+  }
+
+  void TearDown() override {
+    if (UpdateEngineClient::Get()) {
+      if (client_ && client_->HasObserver(&observer_)) {
+        client_->RemoveObserver(&observer_);
+      }
+      UpdateEngineClient::Shutdown();
+    }
+    client_ = nullptr;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  scoped_refptr<dbus::MockBus> bus_;
+  scoped_refptr<dbus::MockObjectProxy> host_bridge_proxy_;
+  scoped_refptr<dbus::MockObjectProxy> login_manager_proxy_;
+  raw_ptr<UpdateEngineClient> client_ = nullptr;
+  RecordingUpdateEngineObserver observer_;
+};
+
+TEST_F(UpdateEngineClientAuraTest, FailureRecoversAndRetainedUpdateCanRetry) {
+  EXPECT_CALL(*host_bridge_proxy_, CallMethod(_, _, _))
+      .WillOnce(RespondWithJson(
+          "PacmanListUpdates",
+          R"({"ok":true,"data":{"packages":[{"name":"aurade","available_version":"152.1660893-9"}]}})"))
+      .WillOnce(RespondWithJson(
+          "PacmanUpgrade",
+          R"({"ok":false,"error":{"code":"not_authorized","message":"the requested operation was not authorized"}})"))
+      .WillOnce(RespondWithJson(
+          "PacmanUpgrade",
+          R"({"ok":true,"data":{"job_id":"0123456789abcdef0123456789abcdef","state":"running"}})"));
+
+  std::optional<UpdateEngineClient::UpdateCheckResult> first_result;
+  client_->RequestUpdateCheck(base::BindOnce(
+      [](std::optional<UpdateEngineClient::UpdateCheckResult>* result,
+         UpdateEngineClient::UpdateCheckResult value) { *result = value; },
+      &first_result));
+
+  ASSERT_TRUE(first_result.has_value());
+  EXPECT_EQ(*first_result,
+            UpdateEngineClient::UpdateCheckResult::UPDATE_RESULT_SUCCESS);
+  ASSERT_EQ(observer_.statuses.size(), 4u);
+  EXPECT_EQ(observer_.statuses.back().current_operation(),
+            update_engine::Operation::ERROR);
+  EXPECT_EQ(observer_.statuses.back().last_attempt_error(),
+            static_cast<int32_t>(update_engine::ErrorCode::kError));
+  EXPECT_EQ(client_->GetLastStatus().current_operation(),
+            update_engine::Operation::ERROR);
+
+  task_environment_.RunUntilIdle();
+
+  ASSERT_EQ(observer_.statuses.size(), 5u);
+  EXPECT_EQ(observer_.statuses.back().current_operation(),
+            update_engine::Operation::IDLE);
+  EXPECT_EQ(observer_.statuses.back().last_attempt_error(),
+            static_cast<int32_t>(update_engine::ErrorCode::kError));
+
+  std::optional<UpdateEngineClient::UpdateCheckResult> retry_result;
+  client_->RequestUpdateCheck(base::BindOnce(
+      [](std::optional<UpdateEngineClient::UpdateCheckResult>* result,
+         UpdateEngineClient::UpdateCheckResult value) { *result = value; },
+      &retry_result));
+
+  ASSERT_TRUE(retry_result.has_value());
+  EXPECT_EQ(*retry_result,
+            UpdateEngineClient::UpdateCheckResult::UPDATE_RESULT_SUCCESS);
+  ASSERT_EQ(observer_.statuses.size(), 6u);
+  EXPECT_EQ(observer_.statuses.back().current_operation(),
+            update_engine::Operation::DOWNLOADING);
+  EXPECT_EQ(observer_.statuses.back().last_attempt_error(),
+            static_cast<int32_t>(update_engine::ErrorCode::kSuccess));
