 namespace ash {
 
 namespace {
+
+// AuraDE: Sleep, which a Chromebook leaves to its lid and a Linux desktop
+// offers in its power menu. Its command is local to this menu, so it needs no
+// view id. Whether the computer can sleep is read once, off the UI thread,
+// and the item shows only when it can.
+constexpr int kAuraDeSleepCommand = 0x5a5e;
+std::atomic<int> g_can_sleep{-1};
+
+void ReadCanSleep() {
+  std::string states;
+  if (!base::ReadFileToString(base::FilePath("/sys/power/state"), &states)) {
+    g_can_sleep = 0;
+    return;
+  }
+  const std::vector<std::string> parts = base::SplitString(
+      states, " \n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  g_can_sleep = std::ranges::find(parts, "mem") != parts.end() ? 1 : 0;
+}
+
 // Rounded corner constants.
