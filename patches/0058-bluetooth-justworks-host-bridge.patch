+// Supplies Ash Bluetooth state from the AuraDE host bridge on generic Linux.
+// Adapter control, discovery, device operations, and JustWorks pairing are
+// supported. PIN and passkey pairing require a BlueZ agent on the host. Until
+// that separate contract exists, those requests finish with a pairing failure
+// instead of waiting or appearing to succeed.
+class AuraDeBluetoothService
+    : public bluetooth_config::mojom::CrosBluetoothConfig,
+      public bluetooth_config::mojom::DevicePairingHandler {
+ public:
+  explicit AuraDeBluetoothService(dbus::Bus* system_bus);
+  AuraDeBluetoothService(const AuraDeBluetoothService&) = delete;
+  AuraDeBluetoothService& operator=(const AuraDeBluetoothService&) = delete;
+  ~AuraDeBluetoothService() override;
+
+  void BindReceiver(
+      mojo::PendingReceiver<bluetooth_config::mojom::CrosBluetoothConfig>
+          receiver);
+
+ private:
+  struct HostDevice {
+    std::string address;
+    std::string adapter;
+    std::string name;
+    std::string alias;
+    std::string icon;
+    bool paired = false;
+    bool connected = false;
+    std::vector<std::string> uuids;
+  };
+
+  struct HostState {
+    bool adapter_available = false;
+    bool powered = false;
+    bool discovering = false;
+    std::string adapter_path;
+    std::map<std::string, HostDevice> devices;
+  };
+
+  struct BridgeResponse {
+    bool ok = false;
+    std::string error_code;
+    std::string error_message;
+    std::string dbus_error;
+    base::DictValue data;
+  };
+
+  using BridgeCallback = base::OnceCallback<void(BridgeResponse)>;
+
+  // bluetooth_config::mojom::CrosBluetoothConfig:
+  void ObserveSystemProperties(
+      mojo::PendingRemote<bluetooth_config::mojom::SystemPropertiesObserver>
+          observer) override;
+  void ObserveDeviceStatusChanges(
+      mojo::PendingRemote<
+          bluetooth_config::mojom::BluetoothDeviceStatusObserver> observer)
+      override;
+  void ObserveDiscoverySessionStatusChanges(
+      mojo::PendingRemote<
+          bluetooth_config::mojom::DiscoverySessionStatusObserver> observer)
+      override;
+  void SetBluetoothEnabledState(bool enabled) override;
+  void SetBluetoothEnabledWithoutPersistence() override;
+  void SetBluetoothHidDetectionInactive(bool is_using_bluetooth) override;
+  void StartDiscovery(
+      mojo::PendingRemote<bluetooth_config::mojom::BluetoothDiscoveryDelegate>
+          delegate) override;
+  void Connect(const std::string& device_id, ConnectCallback callback) override;
+  void Disconnect(const std::string& device_id,
+                  DisconnectCallback callback) override;
+  void Forget(const std::string& device_id, ForgetCallback callback) override;
+  void SetDeviceNickname(const std::string& device_id,
+                         const std::string& nickname) override;
+
+  // bluetooth_config::mojom::DevicePairingHandler:
+  void PairDevice(
+      const std::string& device_id,
+      mojo::PendingRemote<bluetooth_config::mojom::DevicePairingDelegate>
+          delegate,
+      PairDeviceCallback callback) override;
+  void FetchDevice(const std::string& device_address,
+                   FetchDeviceCallback callback) override;
+
+  static BridgeResponse ReadBridgeResponse(dbus::Response* response);
+  static BridgeResponse ParseBridgeJson(std::string_view json);
+  static std::optional<HostState> ParseHostState(
+      const BridgeResponse& response);
+  static bool IsValidAddress(std::string_view address);
+  static bluetooth_config::mojom::DeviceType DeviceTypeFor(
+      const HostDevice& device);
+  static bluetooth_config::mojom::AudioOutputCapability AudioCapabilityFor(
+      const HostDevice& device);
+  static std::u16string PublicNameFor(const HostDevice& device);
+  static bluetooth_config::mojom::PairingResult PairingFailureFor(
+      const BridgeResponse& response);
+
+  void CallNoArgumentMethod(std::string_view method, BridgeCallback callback);
+  void CallBoolMethod(std::string_view method,
+                      bool value,
+                      BridgeCallback callback);
+  void CallStringMethod(std::string_view method,
+                        std::string_view value,
+                        BridgeCallback callback);
+  void RefreshState();
+  void OnStateRefreshed(BridgeResponse response);
+  void ApplyHostState(HostState state);
+  void OnBridgeEvent(dbus::Signal* signal);
+  void OnBridgeSignalConnected(const std::string& interface_name,
+                               const std::string& signal_name,
+                               bool connected);
+
+  bluetooth_config::mojom::BluetoothDevicePropertiesPtr BuildDeviceProperties(
+      const HostDevice& device) const;
+  bluetooth_config::mojom::PairedBluetoothDevicePropertiesPtr
+  BuildPairedDeviceProperties(const HostDevice& device) const;
+  bluetooth_config::mojom::BluetoothSystemPropertiesPtr BuildSystemProperties()
+      const;
+  std::vector<bluetooth_config::mojom::BluetoothDevicePropertiesPtr>
+  BuildDiscoveredDevices() const;
+  const HostDevice* FindDevice(std::string_view device_id) const;
+
+  void NotifySystemProperties();
+  void NotifyDeviceChanges(const HostState& old_state,
+                           const HostState& new_state);
+  void NotifyDiscoveredDevices();
+  void NotifyDiscoverySessionStatus(bool active);
+
+  void OnPowerChanged(bool requested_state, BridgeResponse response);
+  void RunDeviceAction(std::string_view method,
+                       std::string_view device_id,
+                       base::OnceCallback<void(bool)> callback);
+  void OnDeviceAction(base::OnceCallback<void(bool)> callback,
+                      BridgeResponse response);
+
+  void ActivateDiscoveryDelegate(mojo::RemoteSetElementId id);
+  void OnDiscoveryStarted(BridgeResponse response);
+  void OnDiscoveryStopped(BridgeResponse response);
+  void OnDiscoveryDelegateDisconnected(mojo::RemoteSetElementId id);
+  void StopDiscoveryClients();
+
+  void OnPairDevice(PairDeviceCallback callback, BridgeResponse response);
