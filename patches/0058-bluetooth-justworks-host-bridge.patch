+
+namespace ash {
+
+class AuraDeBluetoothServiceTest : public testing::Test {
+ protected:
+  base::test::TaskEnvironment task_environment_;
+};
+
+TEST_F(AuraDeBluetoothServiceTest, ParsesBridgeState) {
+  constexpr char kState[] = R"({
+    "schema":1,
+    "operation":"bluetooth.state",
+    "ok":true,
+    "data":{
+      "adapters":[{
+        "path":"/org/bluez/hci0",
+        "powered":true,
+        "discovering":true
+      }],
+      "devices":[
+        {
+          "address":"AA:BB:CC:DD:EE:01",
+          "adapter":"/org/bluez/hci0",
+          "name":"Headphones",
+          "alias":"Desk headphones",
+          "icon":"audio-headphones",
+          "paired":true,
+          "connected":true,
+          "uuids":[]
+        },
+        {
+          "address":"aa:bb:cc:dd:ee:02",
+          "adapter":"/org/bluez/hci0",
+          "name":"Keyboard",
+          "alias":"",
+          "icon":"input-keyboard",
+          "paired":false,
+          "connected":false,
+          "uuids":[]
+        }
+      ]
+    }
+  })";
+
+  AuraDeBluetoothService::BridgeResponse response =
+      AuraDeBluetoothService::ParseBridgeJson(kState);
+  ASSERT_TRUE(response.ok);
+  std::optional<AuraDeBluetoothService::HostState> state =
+      AuraDeBluetoothService::ParseHostState(response);
+  ASSERT_TRUE(state);
+  EXPECT_TRUE(state->adapter_available);
+  EXPECT_TRUE(state->powered);
+  EXPECT_TRUE(state->discovering);
+  ASSERT_EQ(2u, state->devices.size());
+  EXPECT_TRUE(state->devices.at("AA:BB:CC:DD:EE:01").paired);
+  EXPECT_EQ("AA:BB:CC:DD:EE:02",
+            state->devices.at("AA:BB:CC:DD:EE:02").address);
+
+  AuraDeBluetoothService service(nullptr);
+  service.host_state_ = std::move(*state);
+  service.has_host_state_ = true;
+  auto properties = service.BuildSystemProperties();
+  EXPECT_EQ(bluetooth_config::mojom::BluetoothSystemState::kEnabled,
+            properties->system_state);
+  ASSERT_EQ(1u, properties->paired_devices.size());
+  EXPECT_EQ(u"Desk headphones",
+            properties->paired_devices[0]->device_properties->public_name);
+  auto discovered = service.BuildDiscoveredDevices();
+  ASSERT_EQ(1u, discovered.size());
+  EXPECT_EQ(u"Keyboard", discovered[0]->public_name);
+}
+
+TEST_F(AuraDeBluetoothServiceTest, RejectsMalformedState) {
+  AuraDeBluetoothService::BridgeResponse response =
+      AuraDeBluetoothService::ParseBridgeJson("not json");
+  EXPECT_FALSE(response.ok);
+
+  std::string invalid_utf8 =
+      "{\"schema\":1,\"operation\":\"bluetooth.state\",\"ok\":true,"
+      "\"data\":{\"adapters\":[],\"devices\":[]}}";
+  invalid_utf8[1] = static_cast<char>(0xff);
+  response = AuraDeBluetoothService::ParseBridgeJson(invalid_utf8);
+  EXPECT_FALSE(response.ok);
+
+  std::string oversized(1024 * 1024 + 1, 'x');
+  response = AuraDeBluetoothService::ParseBridgeJson(oversized);
+  EXPECT_FALSE(response.ok);
+
+  constexpr char kWrongContainerTypes[] = R"({
+    "schema":1,
+    "operation":"bluetooth.state",
+    "ok":true,
+    "data":{"adapters":{},"devices":[]}
+  })";
+  response = AuraDeBluetoothService::ParseBridgeJson(kWrongContainerTypes);
+  ASSERT_TRUE(response.ok);
+  EXPECT_FALSE(AuraDeBluetoothService::ParseHostState(response));
+
+  std::string too_many_devices =
+      "{\"schema\":1,\"operation\":\"bluetooth.state\",\"ok\":true,"
+      "\"data\":{\"adapters\":[],\"devices\":[";
+  for (size_t index = 0; index < 257; ++index) {
+    if (index) {
+      too_many_devices += ',';
+    }
+    too_many_devices += "{}";
+  }
+  too_many_devices += "]}}";
+  response = AuraDeBluetoothService::ParseBridgeJson(too_many_devices);
+  ASSERT_TRUE(response.ok);
+  EXPECT_FALSE(AuraDeBluetoothService::ParseHostState(response));
+
+  constexpr char kBadAddress[] = R"({
+    "schema":1,
+    "operation":"bluetooth.state",
+    "ok":true,
+    "data":{
+      "adapters":[{
+        "path":"/org/bluez/hci0",
+        "powered":true,
+        "discovering":false
+      }],
+      "devices":[{
+        "address":"not-an-address",
+        "paired":false,
+        "connected":false
+      }]
+    }
+  })";
+  response = AuraDeBluetoothService::ParseBridgeJson(kBadAddress);
+  ASSERT_TRUE(response.ok);
+  EXPECT_FALSE(AuraDeBluetoothService::ParseHostState(response));
+
+  EXPECT_FALSE(
+      AuraDeBluetoothService::IsValidAddress(std::string(1024 * 1024, 'A')));
+  EXPECT_TRUE(AuraDeBluetoothService::IsValidAddress("01:23:45:67:89:ab"));
+}
+
+TEST_F(AuraDeBluetoothServiceTest, MapsDeviceTypesAndAudio) {
+  AuraDeBluetoothService::HostDevice keyboard;
+  keyboard.icon = "input-keyboard";
+  EXPECT_EQ(bluetooth_config::mojom::DeviceType::kKeyboard,
+            AuraDeBluetoothService::DeviceTypeFor(keyboard));
+  EXPECT_EQ(
+      bluetooth_config::mojom::AudioOutputCapability::kNotCapableOfAudioOutput,
+      AuraDeBluetoothService::AudioCapabilityFor(keyboard));
+
+  AuraDeBluetoothService::HostDevice headset;
+  headset.icon = "audio-headset";
+  EXPECT_EQ(bluetooth_config::mojom::DeviceType::kHeadset,
+            AuraDeBluetoothService::DeviceTypeFor(headset));
+  EXPECT_EQ(
+      bluetooth_config::mojom::AudioOutputCapability::kCapableOfAudioOutput,
+      AuraDeBluetoothService::AudioCapabilityFor(headset));
+
+  AuraDeBluetoothService::HostDevice uuid_audio;
+  uuid_audio.uuids = {"0000110b-0000-1000-8000-00805f9b34fb"};
+  EXPECT_EQ(
+      bluetooth_config::mojom::AudioOutputCapability::kCapableOfAudioOutput,
+      AuraDeBluetoothService::AudioCapabilityFor(uuid_audio));
+}
+
+TEST_F(AuraDeBluetoothServiceTest, ClassifiesInteractivePairingFailure) {
+  AuraDeBluetoothService::BridgeResponse no_agent;
+  no_agent.error_code = "backend_failed";
+  no_agent.error_message = "host service operation failed";
+  no_agent.dbus_error = "org.bluez.Error.AuthenticationRejected";
+  EXPECT_EQ(bluetooth_config::mojom::PairingResult::kAuthFailed,
+            AuraDeBluetoothService::PairingFailureFor(no_agent));
+
+  AuraDeBluetoothService::BridgeResponse unavailable;
+  unavailable.error_code = "backend_unavailable";
+  unavailable.error_message = "BlueZ is unavailable";
+  EXPECT_EQ(bluetooth_config::mojom::PairingResult::kNonAuthFailure,
+            AuraDeBluetoothService::PairingFailureFor(unavailable));
+}
+
+}  // namespace ash
