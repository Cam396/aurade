+  RunDeviceAction("BluetoothDisconnect", device_id, std::move(callback));
+}
+
+void AuraDeBluetoothService::Forget(const std::string& device_id,
+                                    ForgetCallback callback) {
+  RunDeviceAction("BluetoothForget", device_id, std::move(callback));
+}
+
+void AuraDeBluetoothService::SetDeviceNickname(const std::string& device_id,
+                                               const std::string& nickname) {
+  // The frozen host contract has no nickname operation. Leaving the existing
+  // BlueZ alias unchanged is honest and avoids claiming a write succeeded.
+  static_cast<void>(device_id);
+  static_cast<void>(nickname);
+}
+
+void AuraDeBluetoothService::PairDevice(
+    const std::string& device_id,
+    mojo::PendingRemote<bluetooth_config::mojom::DevicePairingDelegate>
+        delegate,
+    PairDeviceCallback callback) {
+  const HostDevice* device = FindDevice(device_id);
+  if (!device || device->paired || pairing_in_flight_) {
+    std::move(callback).Run(
+        bluetooth_config::mojom::PairingResult::kNonAuthFailure);
+    return;
+  }
+
+  pairing_in_flight_ = true;
+  if (delegate.is_valid()) {
+    pairing_delegate_.Bind(std::move(delegate));
+  }
+  CallStringMethod(
+      "BluetoothPair", device->address,
+      base::BindOnce(&AuraDeBluetoothService::OnPairDevice,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AuraDeBluetoothService::FetchDevice(const std::string& device_address,
+                                         FetchDeviceCallback callback) {
+  const HostDevice* device = FindDevice(device_address);
+  std::move(callback).Run(device ? BuildDeviceProperties(*device) : nullptr);
+}
+
+AuraDeBluetoothService::BridgeResponse
+AuraDeBluetoothService::ReadBridgeResponse(dbus::Response* response) {
+  if (!response ||
+      response->GetMessageType() != dbus::Message::MESSAGE_METHOD_RETURN) {
+    BridgeResponse result;
+    result.error_code = "transport_error";
+    result.error_message = "the Bluetooth service did not respond";
+    return result;
+  }
+
+  std::string json;
+  dbus::MessageReader reader(response);
+  if (!reader.PopString(&json) || reader.HasMoreData()) {
+    BridgeResponse result;
+    result.error_code = "invalid_response";
+    result.error_message = "the Bluetooth service returned an invalid reply";
+    return result;
+  }
+  return ParseBridgeJson(json);
+}
+
+AuraDeBluetoothService::BridgeResponse AuraDeBluetoothService::ParseBridgeJson(
+    std::string_view json) {
+  BridgeResponse result;
+  if (json.size() > kMaxBridgeResponseBytes || !base::IsStringUTF8(json)) {
+    result.error_code = "invalid_response";
+    result.error_message = "the Bluetooth service returned an invalid reply";
+    return result;
+  }
+
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    result.error_code = "invalid_response";
+    result.error_message = "the Bluetooth service returned invalid JSON";
+    return result;
+  }
+
+  const base::DictValue& envelope = parsed->GetDict();
+  const std::optional<int> schema = envelope.FindInt("schema");
+  const std::optional<bool> ok = envelope.FindBool("ok");
+  const std::string* operation = envelope.FindString("operation");
+  if (!schema || *schema != 1 || !ok || !operation || operation->empty() ||
+      operation->size() > 128 || !base::IsStringUTF8(*operation)) {
+    result.error_code = "invalid_response";
+    result.error_message = "the Bluetooth service returned an invalid envelope";
+    return result;
+  }
+
+  if (*ok) {
+    const base::DictValue* data = envelope.FindDict("data");
+    if (!data) {
+      result.error_code = "invalid_response";
+      result.error_message = "the Bluetooth service omitted its result";
+      return result;
+    }
+    result.ok = true;
+    result.data = data->Clone();
+    return result;
+  }
+
+  const base::DictValue* error = envelope.FindDict("error");
+  if (!error ||
+      !ReadBoundedString(*error, "code", 128, true, &result.error_code) ||
+      !ReadBoundedString(*error, "message", 1024, true,
+                         &result.error_message)) {
+    result.error_code = "invalid_response";
+    result.error_message = "the Bluetooth service returned an invalid error";
+    return result;
+  }
+  if (const base::DictValue* details = error->FindDict("details")) {
+    ReadBoundedString(*details, "dbus_error", 512, false, &result.dbus_error);
+  }
+  return result;
+}
+
+std::optional<AuraDeBluetoothService::HostState>
+AuraDeBluetoothService::ParseHostState(const BridgeResponse& response) {
+  if (!response.ok) {
+    return std::nullopt;
+  }
+  const base::ListValue* adapters = response.data.FindList("adapters");
+  const base::ListValue* devices = response.data.FindList("devices");
+  if (!adapters || !devices || adapters->size() > kMaxAdapters ||
+      devices->size() > kMaxDevices) {
+    return std::nullopt;
+  }
+
+  HostState state;
+  if (!adapters->empty()) {
+    const base::DictValue* adapter = (*adapters)[0].GetIfDict();
+    if (!adapter || !ReadBoundedString(*adapter, "path", kMaxDeviceTextBytes,
+                                       true, &state.adapter_path)) {
+      return std::nullopt;
+    }
+    const std::optional<bool> powered = adapter->FindBool("powered");
+    const std::optional<bool> discovering = adapter->FindBool("discovering");
+    if (!powered || !discovering) {
+      return std::nullopt;
+    }
+    state.adapter_available = true;
+    state.powered = *powered;
+    state.discovering = *discovering;
+  }
+  if (!state.adapter_available) {
+    return state;
+  }
+
+  for (const base::Value& value : *devices) {
+    const base::DictValue* dictionary = value.GetIfDict();
+    HostDevice device;
+    if (!dictionary ||
+        !ReadBoundedString(*dictionary, "address", kMaxDeviceTextBytes, true,
+                           &device.address) ||
+        !ReadBoundedString(*dictionary, "adapter", kMaxDeviceTextBytes, false,
+                           &device.adapter) ||
+        !ReadBoundedString(*dictionary, "name", kMaxDeviceTextBytes, false,
+                           &device.name) ||
+        !ReadBoundedString(*dictionary, "alias", kMaxDeviceTextBytes, false,
+                           &device.alias) ||
+        !ReadBoundedString(*dictionary, "icon", kMaxDeviceTextBytes, false,
+                           &device.icon)) {
+      return std::nullopt;
+    }
+    if (!IsValidAddress(device.address)) {
+      return std::nullopt;
+    }
+    device.address = base::ToUpperASCII(device.address);
+
+    const std::optional<bool> paired = dictionary->FindBool("paired");
+    const std::optional<bool> connected = dictionary->FindBool("connected");
+    if (!paired || !connected) {
+      return std::nullopt;
+    }
+    device.paired = *paired;
+    device.connected = *connected;
+
+    if (const base::Value* uuids_value = dictionary->Find("uuids")) {
+      const base::ListValue* uuids = uuids_value->GetIfList();
+      if (!uuids || uuids->size() > kMaxDeviceUuids) {
+        return std::nullopt;
+      }
+      for (const base::Value& uuid : *uuids) {
+        if (!uuid.is_string() || uuid.GetString().size() > kMaxUuidBytes ||
+            !base::IsStringUTF8(uuid.GetString())) {
+          return std::nullopt;
+        }
+        device.uuids.push_back(base::ToLowerASCII(uuid.GetString()));
+      }
+    }
+
+    if (state.adapter_available && !device.adapter.empty() &&
+        device.adapter != state.adapter_path) {
+      continue;
+    }
+    if (!state.devices.emplace(device.address, std::move(device)).second) {
+      return std::nullopt;
+    }
+  }
+  return state;
+}
+
+bool AuraDeBluetoothService::IsValidAddress(std::string_view address) {
+  if (address.size() != 17) {
+    return false;
+  }
+  for (size_t index = 0; index < address.size(); ++index) {
+    if ((index + 1) % 3 == 0) {
+      if (address[index] != ':') {
+        return false;
+      }
+    } else if (!IsHexCharacter(address[index])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bluetooth_config::mojom::DeviceType AuraDeBluetoothService::DeviceTypeFor(
+    const HostDevice& device) {
+  const std::string icon = base::ToLowerASCII(device.icon);
+  const bool keyboard = icon.find("keyboard") != std::string::npos;
+  const bool mouse = icon.find("mouse") != std::string::npos;
+  if (keyboard && mouse) {
+    return bluetooth_config::mojom::DeviceType::kKeyboardMouseCombo;
+  }
+  if (keyboard) {
+    return bluetooth_config::mojom::DeviceType::kKeyboard;
+  }
+  if (mouse) {
+    return bluetooth_config::mojom::DeviceType::kMouse;
+  }
+  if (icon.find("headset") != std::string::npos ||
+      icon.find("headphone") != std::string::npos ||
+      icon.find("audio") != std::string::npos) {
+    return bluetooth_config::mojom::DeviceType::kHeadset;
+  }
+  if (icon.find("phone") != std::string::npos) {
+    return bluetooth_config::mojom::DeviceType::kPhone;
+  }
+  if (icon.find("computer") != std::string::npos) {
+    return bluetooth_config::mojom::DeviceType::kComputer;
+  }
+  if (icon.find("video") != std::string::npos ||
+      icon.find("camera") != std::string::npos) {
+    return bluetooth_config::mojom::DeviceType::kVideoCamera;
+  }
+  if (icon.find("game") != std::string::npos) {
+    return bluetooth_config::mojom::DeviceType::kGameController;
+  }
+  if (icon.find("tablet") != std::string::npos) {
+    return bluetooth_config::mojom::DeviceType::kTablet;
+  }
+  return bluetooth_config::mojom::DeviceType::kUnknown;
+}
+
+bluetooth_config::mojom::AudioOutputCapability
+AuraDeBluetoothService::AudioCapabilityFor(const HostDevice& device) {
+  const std::string icon = base::ToLowerASCII(device.icon);
+  if (icon.find("audio") != std::string::npos ||
+      icon.find("headset") != std::string::npos ||
+      icon.find("headphone") != std::string::npos) {
+    return bluetooth_config::mojom::AudioOutputCapability::
+        kCapableOfAudioOutput;
+  }
+  for (const std::string& uuid : device.uuids) {
+    if (uuid.find("0000110b-") != std::string::npos ||
+        uuid.find("00001108-") != std::string::npos ||
+        uuid.find("0000111e-") != std::string::npos) {
+      return bluetooth_config::mojom::AudioOutputCapability::
+          kCapableOfAudioOutput;
+    }
+  }
+  return bluetooth_config::mojom::AudioOutputCapability::
+      kNotCapableOfAudioOutput;
+}
+
+std::u16string AuraDeBluetoothService::PublicNameFor(const HostDevice& device) {
+  const std::string& source =
+      !device.alias.empty()
+          ? device.alias
+          : (!device.name.empty() ? device.name : device.address);
+  std::u16string name = base::UTF8ToUTF16(source);
+  for (char16_t& character : name) {
+    if (character < 0x20 || character == 0x7f) {
+      character = u' ';
+    }
+  }
+  return name;
+}
+
+bluetooth_config::mojom::PairingResult
+AuraDeBluetoothService::PairingFailureFor(const BridgeResponse& response) {
+  const std::string reason =
+      base::ToLowerASCII(response.error_code + " " + response.error_message +
+                         " " + response.dbus_error);
+  if (reason.find("auth") != std::string::npos ||
+      reason.find("reject") != std::string::npos ||
+      reason.find("cancel") != std::string::npos ||
+      reason.find("agent") != std::string::npos ||
+      reason.find("passkey") != std::string::npos ||
+      reason.find("pin") != std::string::npos) {
+    return bluetooth_config::mojom::PairingResult::kAuthFailed;
+  }
+  return bluetooth_config::mojom::PairingResult::kNonAuthFailure;
+}
+
+void AuraDeBluetoothService::CallNoArgumentMethod(std::string_view method,
+                                                  BridgeCallback callback) {
+  if (!host_bridge_proxy_) {
+    BridgeResponse response;
+    response.error_code = "transport_error";
+    response.error_message = "the Bluetooth service is unavailable";
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+  dbus::MethodCall method_call(kHostBridgeInterface, std::string(method));
+  host_bridge_proxy_->CallMethod(
+      &method_call, kHostBridgeTimeoutMs,
+      base::BindOnce(
+          [](BridgeCallback callback, dbus::Response* response) {
+            std::move(callback).Run(ReadBridgeResponse(response));
+          },
+          std::move(callback)));
+}
+
+void AuraDeBluetoothService::CallBoolMethod(std::string_view method,
+                                            bool value,
+                                            BridgeCallback callback) {
+  if (!host_bridge_proxy_) {
+    BridgeResponse response;
+    response.error_code = "transport_error";
+    response.error_message = "the Bluetooth service is unavailable";
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+  dbus::MethodCall method_call(kHostBridgeInterface, std::string(method));
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendBool(value);
+  host_bridge_proxy_->CallMethod(
+      &method_call, kHostBridgeTimeoutMs,
+      base::BindOnce(
+          [](BridgeCallback callback, dbus::Response* response) {
+            std::move(callback).Run(ReadBridgeResponse(response));
+          },
+          std::move(callback)));
+}
+
+void AuraDeBluetoothService::CallStringMethod(std::string_view method,
+                                              std::string_view value,
+                                              BridgeCallback callback) {
+  if (!host_bridge_proxy_) {
+    BridgeResponse response;
+    response.error_code = "transport_error";
+    response.error_message = "the Bluetooth service is unavailable";
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+  dbus::MethodCall method_call(kHostBridgeInterface, std::string(method));
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(std::string(value));
+  host_bridge_proxy_->CallMethod(
+      &method_call, kHostBridgeTimeoutMs,
+      base::BindOnce(
+          [](BridgeCallback callback, dbus::Response* response) {
+            std::move(callback).Run(ReadBridgeResponse(response));
+          },
+          std::move(callback)));
+}
+
+void AuraDeBluetoothService::RefreshState() {
+  if (refresh_in_flight_) {
+    refresh_pending_ = true;
+    return;
+  }
+  refresh_in_flight_ = true;
+  CallNoArgumentMethod("BluetoothGetState",
+                       base::BindOnce(&AuraDeBluetoothService::OnStateRefreshed,
+                                      weak_factory_.GetWeakPtr()));
+}
+
+void AuraDeBluetoothService::OnStateRefreshed(BridgeResponse response) {
+  refresh_in_flight_ = false;
+  std::optional<HostState> state = ParseHostState(response);
+  if (state) {
+    ApplyHostState(std::move(*state));
+  } else {
+    LOG(ERROR) << "AuraDE Bluetooth: state refresh failed: "
+               << response.error_code << " " << response.error_message;
+  }
+  if (std::exchange(refresh_pending_, false)) {
+    RefreshState();
+  }
+}
+
+void AuraDeBluetoothService::ApplyHostState(HostState state) {
+  const HostState old_state = host_state_;
+  const bool discovery_ended =
+      has_host_state_ && old_state.discovering && !state.discovering;
+  host_state_ = std::move(state);
+
+  if (has_host_state_) {
+    NotifyDeviceChanges(old_state, host_state_);
+  }
+  has_host_state_ = true;
+  NotifySystemProperties();
+  NotifyDiscoveredDevices();
+
+  if ((!host_state_.adapter_available || !host_state_.powered ||
+       discovery_ended) &&
+      !discovery_request_in_flight_ && !discovery_delegates_.empty()) {
+    StopDiscoveryClients();
+  }
+}
+
+void AuraDeBluetoothService::OnBridgeEvent(dbus::Signal* signal) {
+  std::string json;
+  dbus::MessageReader reader(signal);
+  if (!reader.PopString(&json) || reader.HasMoreData() ||
+      json.size() > kMaxEventBytes || !base::IsStringUTF8(json)) {
+    return;
+  }
+  std::optional<base::Value> event =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!event || !event->is_dict()) {
+    return;
+  }
+  const base::DictValue& dictionary = event->GetDict();
+  const std::string* source = dictionary.FindString("source");
+  if (!source) {
+    source = dictionary.FindString("domain");
+  }
+  if (source && *source == "bluetooth") {
+    RefreshState();
+  }
+}
+
+void AuraDeBluetoothService::OnBridgeSignalConnected(
+    const std::string& interface_name,
+    const std::string& signal_name,
+    bool connected) {
+  if (!connected) {
+    LOG(ERROR) << "AuraDE Bluetooth: host event signal is unavailable";
+  }
+}
+
+bluetooth_config::mojom::BluetoothDevicePropertiesPtr
+AuraDeBluetoothService::BuildDeviceProperties(const HostDevice& device) const {
+  auto properties = bluetooth_config::mojom::BluetoothDeviceProperties::New();
+  properties->id = device.address;
+  properties->address = device.address;
+  properties->public_name = PublicNameFor(device);
+  properties->device_type = DeviceTypeFor(device);
+  properties->audio_capability = AudioCapabilityFor(device);
+  properties->battery_info = nullptr;
+  properties->image_info = nullptr;
+  properties->connection_state =
+      device.connected
+          ? bluetooth_config::mojom::DeviceConnectionState::kConnected
+          : bluetooth_config::mojom::DeviceConnectionState::kNotConnected;
+  properties->is_blocked_by_policy = false;
+  return properties;
+}
+
+bluetooth_config::mojom::PairedBluetoothDevicePropertiesPtr
+AuraDeBluetoothService::BuildPairedDeviceProperties(
+    const HostDevice& device) const {
+  auto properties =
+      bluetooth_config::mojom::PairedBluetoothDeviceProperties::New();
+  properties->device_properties = BuildDeviceProperties(device);
+  properties->nickname = std::nullopt;
+  return properties;
+}
+
+bluetooth_config::mojom::BluetoothSystemPropertiesPtr
+AuraDeBluetoothService::BuildSystemProperties() const {
+  auto properties = bluetooth_config::mojom::BluetoothSystemProperties::New();
+  if (!host_state_.adapter_available) {
+    properties->system_state =
+        bluetooth_config::mojom::BluetoothSystemState::kUnavailable;
+    properties->modification_state = bluetooth_config::mojom::
+        BluetoothModificationState::kCannotModifyBluetooth;
+    return properties;
+  }
+
+  properties->modification_state =
+      bluetooth_config::mojom::BluetoothModificationState::kCanModifyBluetooth;
+  if (pending_power_state_) {
+    properties->system_state =
+        *pending_power_state_
+            ? bluetooth_config::mojom::BluetoothSystemState::kEnabling
+            : bluetooth_config::mojom::BluetoothSystemState::kDisabling;
+  } else {
+    properties->system_state =
+        host_state_.powered
+            ? bluetooth_config::mojom::BluetoothSystemState::kEnabled
+            : bluetooth_config::mojom::BluetoothSystemState::kDisabled;
+  }
+
+  std::vector<const HostDevice*> paired_devices;
+  for (const auto& [address, device] : host_state_.devices) {
+    if (device.paired) {
+      paired_devices.push_back(&device);
+    }
+  }
+  std::sort(paired_devices.begin(), paired_devices.end(),
+            [](const HostDevice* left, const HostDevice* right) {
+              if (left->connected != right->connected) {
+                return left->connected > right->connected;
+              }
+              return PublicNameFor(*left) < PublicNameFor(*right);
+            });
+  for (const HostDevice* device : paired_devices) {
+    properties->paired_devices.push_back(BuildPairedDeviceProperties(*device));
+  }
+  return properties;
+}
+
+std::vector<bluetooth_config::mojom::BluetoothDevicePropertiesPtr>
+AuraDeBluetoothService::BuildDiscoveredDevices() const {
+  std::vector<const HostDevice*> discovered_devices;
+  for (const auto& [address, device] : host_state_.devices) {
+    if (!device.paired) {
+      discovered_devices.push_back(&device);
+    }
+  }
+  std::sort(discovered_devices.begin(), discovered_devices.end(),
+            [](const HostDevice* left, const HostDevice* right) {
+              return PublicNameFor(*left) < PublicNameFor(*right);
+            });
+
+  std::vector<bluetooth_config::mojom::BluetoothDevicePropertiesPtr> result;
+  result.reserve(discovered_devices.size());
+  for (const HostDevice* device : discovered_devices) {
+    result.push_back(BuildDeviceProperties(*device));
+  }
+  return result;
+}
+
+const AuraDeBluetoothService::HostDevice* AuraDeBluetoothService::FindDevice(
+    std::string_view device_id) const {
+  if (!IsValidAddress(device_id)) {
+    return nullptr;
+  }
+  const auto device = host_state_.devices.find(base::ToUpperASCII(device_id));
+  return device == host_state_.devices.end() ? nullptr : &device->second;
+}
+
+void AuraDeBluetoothService::NotifySystemProperties() {
+  ForEachObserver(system_observers_, [this](auto* observer) {
+    observer->OnPropertiesUpdated(BuildSystemProperties());
+  });
+}
+
+void AuraDeBluetoothService::NotifyDeviceChanges(const HostState& old_state,
+                                                 const HostState& new_state) {
+  for (const auto& [address, device] : new_state.devices) {
+    const auto previous = old_state.devices.find(address);
+    const HostDevice* old_device =
+        previous == old_state.devices.end() ? nullptr : &previous->second;
+    if (device.paired && (!old_device || !old_device->paired)) {
+      ForEachObserver(
+          device_status_observers_, [this, &device](auto* observer) {
+            observer->OnDevicePaired(BuildPairedDeviceProperties(device));
+          });
+    }
+    if (device.paired && device.connected &&
+        (!old_device || !old_device->connected)) {
+      ForEachObserver(
+          device_status_observers_, [this, &device](auto* observer) {
+            observer->OnDeviceConnected(BuildPairedDeviceProperties(device));
+          });
+    }
+    if (device.paired && !device.connected && old_device &&
+        old_device->connected) {
+      ForEachObserver(
+          device_status_observers_, [this, &device](auto* observer) {
+            observer->OnDeviceDisconnected(BuildPairedDeviceProperties(device));
+          });
+    }
+  }
+}
+
+void AuraDeBluetoothService::NotifyDiscoveredDevices() {
+  std::vector<mojo::RemoteSetElementId> ids(active_discovery_delegates_.begin(),
+                                            active_discovery_delegates_.end());
+  for (mojo::RemoteSetElementId id : ids) {
+    if (auto* delegate = discovery_delegates_.Get(id)) {
+      delegate->OnDiscoveredDevicesListChanged(BuildDiscoveredDevices());
+    }
+  }
+}
+
+void AuraDeBluetoothService::NotifyDiscoverySessionStatus(bool active) {
+  ForEachObserver(discovery_status_observers_, [active](auto* observer) {
+    observer->OnHasAtLeastOneDiscoverySessionChanged(active);
+  });
+}
+
+void AuraDeBluetoothService::OnPowerChanged(bool requested_state,
+                                            BridgeResponse response) {
+  pending_power_state_.reset();
+  if (!response.ok) {
+    LOG(ERROR) << "AuraDE Bluetooth: power change failed: "
+               << response.error_code << " " << response.error_message;
+    NotifySystemProperties();
+    return;
+  }
+  host_state_.powered = requested_state;
+  NotifySystemProperties();
+  if (!requested_state && !discovery_delegates_.empty()) {
+    StopDiscoveryClients();
+  }
+  RefreshState();
+}
+
+void AuraDeBluetoothService::RunDeviceAction(
+    std::string_view method,
+    std::string_view device_id,
+    base::OnceCallback<void(bool)> callback) {
+  const HostDevice* device = FindDevice(device_id);
+  if (!device) {
+    std::move(callback).Run(false);
+    return;
+  }
+  CallStringMethod(
+      method, device->address,
+      base::BindOnce(&AuraDeBluetoothService::OnDeviceAction,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AuraDeBluetoothService::OnDeviceAction(
+    base::OnceCallback<void(bool)> callback,
+    BridgeResponse response) {
+  if (!response.ok) {
+    LOG(ERROR) << "AuraDE Bluetooth: device operation failed: "
+               << response.error_code << " " << response.error_message;
+  }
+  std::move(callback).Run(response.ok);
+  if (response.ok) {
+    RefreshState();
+  }
+}
+
+void AuraDeBluetoothService::ActivateDiscoveryDelegate(
+    mojo::RemoteSetElementId id) {
+  if (active_discovery_delegates_.contains(id)) {
+    return;
+  }
+  auto* delegate = discovery_delegates_.Get(id);
+  if (!delegate) {
+    return;
+  }
+
+  mojo::PendingRemote<bluetooth_config::mojom::DevicePairingHandler> handler;
+  pairing_receivers_.Add(this, handler.InitWithNewPipeAndPassReceiver());
+  delegate->OnBluetoothDiscoveryStarted(std::move(handler));
+  active_discovery_delegates_.insert(id);
+  delegate->OnDiscoveredDevicesListChanged(BuildDiscoveredDevices());
+}
+
+void AuraDeBluetoothService::OnDiscoveryStarted(BridgeResponse response) {
+  discovery_request_in_flight_ = false;
+  if (!response.ok) {
+    LOG(ERROR) << "AuraDE Bluetooth: discovery could not start: "
+               << response.error_code << " " << response.error_message;
+    StopDiscoveryClients();
+    return;
+  }
+
+  host_state_.discovering = true;
+  if (discovery_delegates_.empty()) {
+    discovery_request_in_flight_ = true;
+    CallNoArgumentMethod(
+        "BluetoothStopDiscovery",
+        base::BindOnce(&AuraDeBluetoothService::OnDiscoveryStopped,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+
+  std::vector<mojo::RemoteSetElementId> ids;
+  for (auto iterator = discovery_delegates_.begin();
+       iterator != discovery_delegates_.end(); ++iterator) {
+    ids.push_back(iterator.id());
+  }
+  for (mojo::RemoteSetElementId id : ids) {
+    ActivateDiscoveryDelegate(id);
+  }
+  RefreshState();
+}
+
+void AuraDeBluetoothService::OnDiscoveryStopped(BridgeResponse response) {
+  discovery_request_in_flight_ = false;
+  host_state_.discovering = false;
+  if (!response.ok) {
+    LOG(ERROR) << "AuraDE Bluetooth: discovery could not stop: "
+               << response.error_code << " " << response.error_message;
+  }
+  if (!discovery_delegates_.empty() && host_state_.adapter_available &&
+      host_state_.powered) {
+    discovery_request_in_flight_ = true;
+    CallNoArgumentMethod(
+        "BluetoothStartDiscovery",
+        base::BindOnce(&AuraDeBluetoothService::OnDiscoveryStarted,
+                       weak_factory_.GetWeakPtr()));
+  } else {
+    RefreshState();
+  }
+}
+
+void AuraDeBluetoothService::OnDiscoveryDelegateDisconnected(
+    mojo::RemoteSetElementId id) {
+  active_discovery_delegates_.erase(id);
+  if (!discovery_delegates_.empty()) {
+    return;
+  }
+  NotifyDiscoverySessionStatus(false);
+  if (host_state_.discovering && !discovery_request_in_flight_) {
+    discovery_request_in_flight_ = true;
+    CallNoArgumentMethod(
+        "BluetoothStopDiscovery",
+        base::BindOnce(&AuraDeBluetoothService::OnDiscoveryStopped,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void AuraDeBluetoothService::StopDiscoveryClients() {
+  std::vector<mojo::RemoteSetElementId> ids;
+  for (auto iterator = discovery_delegates_.begin();
+       iterator != discovery_delegates_.end(); ++iterator) {
+    ids.push_back(iterator.id());
+  }
+  for (mojo::RemoteSetElementId id : ids) {
+    if (auto* delegate = discovery_delegates_.Get(id)) {
+      delegate->OnBluetoothDiscoveryStopped();
+    }
+  }
+  discovery_delegates_.Clear();
+  active_discovery_delegates_.clear();
+  NotifyDiscoverySessionStatus(false);
+}
+
+void AuraDeBluetoothService::OnPairDevice(PairDeviceCallback callback,
+                                          BridgeResponse response) {
+  pairing_in_flight_ = false;
+  pairing_delegate_.reset();
+  if (!response.ok) {
+    LOG(ERROR) << "AuraDE Bluetooth: pairing failed: " << response.error_code
+               << " " << response.error_message;
+    std::move(callback).Run(PairingFailureFor(response));
+    return;
+  }
+  std::move(callback).Run(bluetooth_config::mojom::PairingResult::kSuccess);
+  RefreshState();
+}
+
