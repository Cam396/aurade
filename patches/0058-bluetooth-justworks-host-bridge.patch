+  FRIEND_TEST_ALL_PREFIXES(AuraDeBluetoothServiceTest,
+                           ClassifiesInteractivePairingFailure);
+
+  raw_ptr<dbus::ObjectProxy> host_bridge_proxy_ = nullptr;
+  mojo::ReceiverSet<bluetooth_config::mojom::CrosBluetoothConfig> receivers_;
+  mojo::ReceiverSet<bluetooth_config::mojom::DevicePairingHandler>
+      pairing_receivers_;
