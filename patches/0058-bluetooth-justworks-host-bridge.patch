+AuraDeBluetoothService::AuraDeBluetoothService(dbus::Bus* system_bus) {
+  discovery_delegates_.set_disconnect_handler(base::BindRepeating(
+      &AuraDeBluetoothService::OnDiscoveryDelegateDisconnected,
+      base::Unretained(this)));
+  if (!system_bus) {
+    LOG(ERROR) << "AuraDE Bluetooth: the shared system bus is unavailable";
+    return;
+  }
+
+  host_bridge_proxy_ = system_bus->GetObjectProxy(
+      kHostBridgeService, dbus::ObjectPath(kHostBridgePath));
+  if (!host_bridge_proxy_) {
+    LOG(ERROR) << "AuraDE Bluetooth: the host bridge is unavailable";
+    return;
+  }
+
+  host_bridge_proxy_->ConnectToSignal(
+      kHostBridgeInterface, kHostBridgeEvent,
+      base::BindRepeating(&AuraDeBluetoothService::OnBridgeEvent,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&AuraDeBluetoothService::OnBridgeSignalConnected,
+                     weak_factory_.GetWeakPtr()));
+  RefreshState();
+}
+
+AuraDeBluetoothService::~AuraDeBluetoothService() = default;
+
+void AuraDeBluetoothService::BindReceiver(
+    mojo::PendingReceiver<bluetooth_config::mojom::CrosBluetoothConfig>
+        receiver) {
+  receivers_.Add(this, std::move(receiver));
+}
+
+void AuraDeBluetoothService::ObserveSystemProperties(
+    mojo::PendingRemote<bluetooth_config::mojom::SystemPropertiesObserver>
+        observer) {
+  const mojo::RemoteSetElementId id =
+      system_observers_.Add(std::move(observer));
+  if (auto* remote = system_observers_.Get(id)) {
+    remote->OnPropertiesUpdated(BuildSystemProperties());
+  }
+}
+
+void AuraDeBluetoothService::ObserveDeviceStatusChanges(
+    mojo::PendingRemote<bluetooth_config::mojom::BluetoothDeviceStatusObserver>
+        observer) {
+  device_status_observers_.Add(std::move(observer));
+}
+
+void AuraDeBluetoothService::ObserveDiscoverySessionStatusChanges(
+    mojo::PendingRemote<bluetooth_config::mojom::DiscoverySessionStatusObserver>
+        observer) {
+  const mojo::RemoteSetElementId id =
+      discovery_status_observers_.Add(std::move(observer));
+  if (auto* remote = discovery_status_observers_.Get(id)) {
+    remote->OnHasAtLeastOneDiscoverySessionChanged(
+        !discovery_delegates_.empty());
+  }
+}
+
+void AuraDeBluetoothService::SetBluetoothEnabledState(bool enabled) {
+  if (!host_state_.adapter_available || pending_power_state_ ||
+      host_state_.powered == enabled) {
+    return;
+  }
+
+  pending_power_state_ = enabled;
+  NotifySystemProperties();
+  CallBoolMethod("BluetoothSetPowered", enabled,
+                 base::BindOnce(&AuraDeBluetoothService::OnPowerChanged,
+                                weak_factory_.GetWeakPtr(), enabled));
+}
+
+void AuraDeBluetoothService::SetBluetoothEnabledWithoutPersistence() {
+  SetBluetoothEnabledState(true);
+}
+
+void AuraDeBluetoothService::SetBluetoothHidDetectionInactive(
+    bool is_using_bluetooth) {
+  // AuraDE compatibility: the host owns the persisted adapter state. HID
+  // detection must not replace that choice with an in-process preference.
+  static_cast<void>(is_using_bluetooth);
+}
+
+void AuraDeBluetoothService::StartDiscovery(
+    mojo::PendingRemote<bluetooth_config::mojom::BluetoothDiscoveryDelegate>
+        delegate) {
+  if (!delegate.is_valid()) {
+    return;
+  }
+  if (!host_state_.adapter_available || !host_state_.powered) {
+    mojo::Remote<bluetooth_config::mojom::BluetoothDiscoveryDelegate> remote(
+        std::move(delegate));
+    remote->OnBluetoothDiscoveryStopped();
+    return;
+  }
+
+  const bool was_empty = discovery_delegates_.empty();
+  const mojo::RemoteSetElementId id =
+      discovery_delegates_.Add(std::move(delegate));
+  if (was_empty) {
+    NotifyDiscoverySessionStatus(true);
+  }
+
+  if (host_state_.discovering && !discovery_request_in_flight_) {
+    ActivateDiscoveryDelegate(id);
+    return;
+  }
+  if (discovery_request_in_flight_) {
+    return;
+  }
+
+  discovery_request_in_flight_ = true;
+  CallNoArgumentMethod(
+      "BluetoothStartDiscovery",
+      base::BindOnce(&AuraDeBluetoothService::OnDiscoveryStarted,
+                     weak_factory_.GetWeakPtr()));
+}
