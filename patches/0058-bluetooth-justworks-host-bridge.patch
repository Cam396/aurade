+constexpr char kHostBridgeService[] = "org.aurade.HostBridge";
+constexpr char kHostBridgePath[] = "/org/aurade/HostBridge";
+constexpr char kHostBridgeInterface[] = "org.aurade.HostBridge1";
+constexpr char kHostBridgeEvent[] = "Event";
+constexpr int kHostBridgeTimeoutMs = 30000;
+constexpr size_t kMaxBridgeResponseBytes = 1024 * 1024;
+constexpr size_t kMaxEventBytes = 64 * 1024;
+constexpr size_t kMaxAdapters = 8;
+constexpr size_t kMaxDevices = 256;
+constexpr size_t kMaxDeviceTextBytes = 512;
+constexpr size_t kMaxDeviceUuids = 64;
+constexpr size_t kMaxUuidBytes = 128;
+
+bool ReadBoundedString(const base::DictValue& dictionary,
+                       std::string_view key,
+                       size_t maximum_bytes,
+                       bool required,
+                       std::string* destination) {
+  const base::Value* value = dictionary.Find(key);
+  if (!value) {
+    destination->clear();
+    return !required;
+  }
+  if (!value->is_string() || value->GetString().size() > maximum_bytes ||
+      !base::IsStringUTF8(value->GetString())) {
+    return false;
+  }
+  *destination = value->GetString();
+  return true;
+}
+
+bool IsHexCharacter(char character) {
+  return (character >= '0' && character <= '9') ||
+         (character >= 'a' && character <= 'f') ||
+         (character >= 'A' && character <= 'F');
+}
+
+template <typename ObserverSet, typename Callback>
+void ForEachObserver(ObserverSet& observers, Callback callback) {
+  for (auto& observer : observers) {
+    callback(observer.get());
+  }
+}
