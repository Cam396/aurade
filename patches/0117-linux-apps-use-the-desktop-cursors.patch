@@ -0,0 +1,178 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/wp_cursor_shape.h"
+
+#include <cursor-shape-v1-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+
+#include <memory>
+
+#include "base/compiler_specific.h"
+#include "base/memory/raw_ptr.h"
+#include "components/exo/pointer.h"
+#include "components/exo/wayland/server_util.h"
+#include "ui/base/cursor/mojom/cursor_type.mojom-shared.h"
+
+namespace exo::wayland {
+
+namespace {
+
+ui::mojom::CursorType GetCursorType(uint32_t shape) {
+  switch (shape) {
+#define ADD_CASE(wayland, chrome)                 \
+  case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_##wayland: \
+    return ui::mojom::CursorType::chrome
+
+    ADD_CASE(DEFAULT, kPointer);
+    ADD_CASE(CONTEXT_MENU, kContextMenu);
+    ADD_CASE(HELP, kHelp);
+    ADD_CASE(POINTER, kHand);
+    ADD_CASE(PROGRESS, kProgress);
+    ADD_CASE(WAIT, kWait);
+    ADD_CASE(CELL, kCell);
+    ADD_CASE(CROSSHAIR, kCross);
+    ADD_CASE(TEXT, kIBeam);
+    ADD_CASE(VERTICAL_TEXT, kVerticalText);
+    ADD_CASE(ALIAS, kAlias);
+    ADD_CASE(COPY, kCopy);
+    ADD_CASE(MOVE, kMove);
+    ADD_CASE(NO_DROP, kNoDrop);
+    ADD_CASE(NOT_ALLOWED, kNotAllowed);
+    ADD_CASE(GRAB, kGrab);
+    ADD_CASE(GRABBING, kGrabbing);
+    ADD_CASE(E_RESIZE, kEastResize);
+    ADD_CASE(N_RESIZE, kNorthResize);
+    ADD_CASE(NE_RESIZE, kNorthEastResize);
+    ADD_CASE(NW_RESIZE, kNorthWestResize);
+    ADD_CASE(S_RESIZE, kSouthResize);
+    ADD_CASE(SE_RESIZE, kSouthEastResize);
+    ADD_CASE(SW_RESIZE, kSouthWestResize);
+    ADD_CASE(W_RESIZE, kWestResize);
+    ADD_CASE(EW_RESIZE, kEastWestResize);
+    ADD_CASE(NS_RESIZE, kNorthSouthResize);
+    ADD_CASE(NESW_RESIZE, kNorthEastSouthWestResize);
+    ADD_CASE(NWSE_RESIZE, kNorthWestSouthEastResize);
+    ADD_CASE(COL_RESIZE, kColumnResize);
+    ADD_CASE(ROW_RESIZE, kRowResize);
+    ADD_CASE(ALL_SCROLL, kMove);
+    ADD_CASE(ZOOM_IN, kZoomIn);
+    ADD_CASE(ZOOM_OUT, kZoomOut);
+    ADD_CASE(DND_ASK, kContextMenu);
+    ADD_CASE(ALL_RESIZE, kMove);
+#undef ADD_CASE
+    default:
+      return ui::mojom::CursorType::kNull;
+  }
+}
+
+// A device names the wl_pointer it was made for. The pointer can go away
+// first, and then the device is inert, as the protocol says.
+struct CursorShapeDevice {
+  raw_ptr<wl_resource> pointer_resource = nullptr;
+  wl_listener pointer_destroyed;
+};
+
+void OnPointerDestroyed(wl_listener* listener, void* data) {
+  // SAFETY: `listener` is the pointer_destroyed member of a
+  // CursorShapeDevice, which is the only listener this notify is set on.
+  CursorShapeDevice* device = UNSAFE_BUFFERS(wl_container_of(
+      listener, /*sample=*/device, /*member=*/pointer_destroyed));
+  device->pointer_resource = nullptr;
+  wl_list_remove(&device->pointer_destroyed.link);
+  wl_list_init(&device->pointer_destroyed.link);
+}
+
+void cursor_shape_device_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void cursor_shape_device_set_shape(wl_client* client,
+                                   wl_resource* resource,
+                                   uint32_t serial,
+                                   uint32_t shape) {
+  ui::mojom::CursorType cursor_type = GetCursorType(shape);
+  if (cursor_type == ui::mojom::CursorType::kNull) {
+    wl_resource_post_error(resource,
+                           WP_CURSOR_SHAPE_DEVICE_V1_ERROR_INVALID_SHAPE,
+                           "Unrecognized shape %u", shape);
+    return;
+  }
+  auto* device = GetUserDataAs<CursorShapeDevice>(resource);
+  if (!device || !device->pointer_resource) {
+    return;
+  }
+  GetUserDataAs<Pointer>(device->pointer_resource.get())
+      ->SetCursorType(cursor_type);
+}
+
+const struct wp_cursor_shape_device_v1_interface
+    cursor_shape_device_implementation = {cursor_shape_device_destroy,
+                                          cursor_shape_device_set_shape};
+
+void DestroyDevice(wl_resource* resource) {
+  auto* device = GetUserDataAs<CursorShapeDevice>(resource);
+  if (device->pointer_resource) {
+    wl_list_remove(&device->pointer_destroyed.link);
+  }
+  delete device;
+}
+
+void CreateDevice(wl_client* client,
+                  wl_resource* manager,
+                  uint32_t id,
+                  wl_resource* pointer_resource) {
+  wl_resource* resource =
+      wl_resource_create(client, &wp_cursor_shape_device_v1_interface,
+                         wl_resource_get_version(manager), id);
+  auto* device = new CursorShapeDevice();
+  wl_list_init(&device->pointer_destroyed.link);
+  if (pointer_resource) {
+    device->pointer_resource = pointer_resource;
+    device->pointer_destroyed.notify = OnPointerDestroyed;
+    wl_resource_add_destroy_listener(pointer_resource,
+                                     &device->pointer_destroyed);
+  }
+  wl_resource_set_implementation(resource, &cursor_shape_device_implementation,
+                                 device, DestroyDevice);
+}
+
+void cursor_shape_manager_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void cursor_shape_manager_get_pointer(wl_client* client,
+                                      wl_resource* resource,
+                                      uint32_t id,
+                                      wl_resource* pointer) {
+  CreateDevice(client, resource, id, pointer);
+}
+
+// exo has no tablet tools, so a device made for one never has a cursor to set.
+void cursor_shape_manager_get_tablet_tool_v2(wl_client* client,
+                                             wl_resource* resource,
+                                             uint32_t id,
+                                             wl_resource* tablet_tool) {
+  CreateDevice(client, resource, id, nullptr);
+}
+
+const struct wp_cursor_shape_manager_v1_interface
+    cursor_shape_manager_implementation = {
+        cursor_shape_manager_destroy, cursor_shape_manager_get_pointer,
+        cursor_shape_manager_get_tablet_tool_v2};
+
+}  // namespace
+
+void bind_cursor_shape_manager(wl_client* client,
+                               void* data,
+                               uint32_t version,
+                               uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &wp_cursor_shape_manager_v1_interface, version, id);
+  wl_resource_set_implementation(resource, &cursor_shape_manager_implementation,
+                                 data, nullptr);
+}
+
+}  // namespace exo::wayland
