+
+namespace exo::wayland {
+
+// AuraDE: the standard cursor-shape protocol, so Linux apps that name a CSS
+// shape get Ash's own cursor instead of drawing one from their theme.
+constexpr uint32_t kCursorShapeVersion = 2;
+
+void bind_cursor_shape_manager(wl_client* client,
+                               void* data,
+                               uint32_t version,
+                               uint32_t id);
+
+}  // namespace exo::wayland
