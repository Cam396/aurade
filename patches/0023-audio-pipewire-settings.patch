+  if (metadata && metadata->is_dict()) {
+    const std::string* name = metadata->GetDict().FindString("name");
+    if (name) {
+      return *name;
+    }
+  }
+
+  return value;
+}
+
+std::string PipeWireDefaultValue(const std::string& node_name) {
+  base::DictValue metadata;
+  metadata.Set("name", node_name);
+  std::string value;
+  CHECK(base::JSONWriter::Write(metadata, &value));
+  return value;
+}
+
+std::string FirstNonEmpty(std::initializer_list<std::string> values) {
+  for (const std::string& value : values) {
+    if (!value.empty()) {
+      return value;
+    }
+  }
+  return std::string();
+}
+
+std::string FirstNonEmpty(const std::vector<std::string>& values) {
+  for (const std::string& value : values) {
+    if (!value.empty()) {
+      return value;
+    }
+  }
+  return std::string();
+}
+
+std::string DeviceIdentityKey(bool is_input,
+                              const std::string& node_name,
+                              const spa_dict* props) {
+  std::vector<std::string> candidates = {
+      DictString(props, PW_KEY_DEVICE_SERIAL),
+      DictString(props, SPA_KEY_API_BLUEZ5_ADDRESS),
+      DictString(props, PW_KEY_DEVICE_BUS_PATH),
+      DictString(props, PW_KEY_DEVICE_STRING),
+      DictString(props, PW_KEY_DEVICE_SYSFS_PATH),
+      DictString(props, PW_KEY_OBJECT_PATH),
+  };
+
+  const std::string alsa_card_longname =
+      DictString(props, SPA_KEY_API_ALSA_CARD_LONGNAME);
+  const std::string alsa_pcm_device =
+      DictString(props, SPA_KEY_API_ALSA_PCM_DEVICE);
+  if (!alsa_card_longname.empty() || !alsa_pcm_device.empty()) {
+    candidates.push_back(alsa_card_longname + ":" + alsa_pcm_device);
+  }
+
+  const std::string alsa_card_id = DictString(props, SPA_KEY_API_ALSA_CARD_ID);
+  const std::string alsa_pcm_id = DictString(props, SPA_KEY_API_ALSA_PCM_ID);
+  if (!alsa_card_id.empty() || !alsa_pcm_id.empty()) {
+    candidates.push_back(alsa_card_id + ":" + alsa_pcm_id);
+  }
+
+  candidates.push_back(node_name);
+  const std::string key = FirstNonEmpty(candidates);
+  return base::StringPrintf("%s:%s", is_input ? "input" : "output",
+                            key.c_str());
+}
+
+std::string NodeType(bool is_input,
+                     const std::string& media_class,
+                     const std::string& bus,
+                     const std::string& form_factor,
+                     const std::string& api,
+                     const std::string& icon_name,
+                     const std::string& text) {
+  std::string haystack =
+      base::ToLowerASCII(media_class + " " + bus + " " + form_factor + " " +
+                         api + " " + icon_name + " " + text);
+  if (haystack.find("bluetooth") != std::string::npos ||
+      haystack.find("bluez") != std::string::npos) {
+    return "BLUETOOTH";
+  }
+  if (haystack.find("usb") != std::string::npos) {
+    return "USB";
+  }
+  if (haystack.find("hdmi") != std::string::npos ||
+      haystack.find("displayport") != std::string::npos ||
+      haystack.find("display port") != std::string::npos) {
+    return "HDMI";
+  }
+  if (haystack.find("headphone") != std::string::npos ||
+      haystack.find("headset") != std::string::npos ||
+      haystack.find("hands-free") != std::string::npos) {
+    return is_input ? "MIC" : "HEADPHONE";
+  }
+  if (is_input && (haystack.find("webcam") != std::string::npos ||
+                   haystack.find("microphone") != std::string::npos)) {
+    return "INTERNAL_MIC";
+  }
+  if (!is_input && haystack.find("speaker") != std::string::npos) {
+    return "INTERNAL_SPEAKER";
+  }
+  if (is_input) {
+    return "INTERNAL_MIC";
+  }
+  return "INTERNAL_SPEAKER";
+}
+
+int32_t PercentFromVolume(float volume) {
+  if (!std::isfinite(volume)) {
+    return 100;
+  }
+  return std::clamp(static_cast<int32_t>(std::lround(volume * 100.0f)), 0, 100);
+}
+
+float VolumeFromPercent(int32_t percent) {
+  return std::clamp(percent, 0, 100) / 100.0f;
+}
