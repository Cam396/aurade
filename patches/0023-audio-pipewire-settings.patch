+
+  static void OnCoreDone(void* data, uint32_t id, int seq) {
+    auto* state = static_cast<State*>(data);
+    if (id == PW_ID_CORE && seq == state->sync_seq) {
+      state->initial_sync_done = true;
+      pw_thread_loop_signal(state->thread_loop.get(), false);
+    }
+  }
+
+  static void OnCoreError(void* data,
+                          uint32_t id,
+                          int seq,
+                          int res,
+                          const char* message) {
+    auto* state = static_cast<State*>(data);
+    state->core_failed = true;
+    pw_thread_loop_signal(state->thread_loop.get(), false);
+  }
+
+  static void OnRegistryGlobal(void* data,
+                               uint32_t id,
+                               uint32_t permissions,
+                               const char* type,
+                               uint32_t version,
+                               const spa_dict* props) {
+    auto* state = static_cast<State*>(data);
+    if (!type) {
+      return;
+    }
+
+    if (std::string(type) == PW_TYPE_INTERFACE_Metadata) {
+      // AuraDE compatibility: PipeWire can expose more than one metadata
+      // object. A single CRAS client only needs the default metadata, and a
+      // single spa_hook must not be reused across multiple proxy listener
+      // lists.
+      if (DictString(props, PW_KEY_METADATA_NAME) != kDefaultMetadataName) {
+        return;
+      }
+      {
+        base::AutoLock locked(state->lock);
+        if (state->metadata) {
+          return;
+        }
+      }
+      pw_metadata* metadata = static_cast<pw_metadata*>(pw_registry_bind(
+          state->registry.get(), id, type, PW_VERSION_METADATA, 0));
+      if (!metadata) {
+        return;
+      }
+      PipeWireMetadataAddListener(metadata, &state->metadata_listener,
+                                  &kMetadataEvents, state);
+      {
+        base::AutoLock locked(state->lock);
+        state->metadata = metadata;
+        state->metadata_id = id;
+      }
+      return;
+    }
+
+    if (std::string(type) != PW_TYPE_INTERFACE_Node) {
+      return;
+    }
+
+    std::string media_class = DictString(props, PW_KEY_MEDIA_CLASS);
+    const bool is_sink = media_class == "Audio/Sink";
+    const bool is_source = media_class == "Audio/Source";
+    if (!is_sink && !is_source) {
+      return;
+    }
+
+    pw_node* pipewire_node = static_cast<pw_node*>(
+        pw_registry_bind(state->registry.get(), id, type, PW_VERSION_NODE, 0));
+    if (!pipewire_node) {
+      return;
+    }
+
+    PipeWireNode node;
+    node.pipewire_id = id;
+    node.state = state;
+    node.node = pipewire_node;
+    node.is_input = is_source;
+    node.media_class = media_class;
+    node.node_name = DictString(props, PW_KEY_NODE_NAME);
+    if (node.node_name.empty()) {
+      node.node_name = base::StringPrintf("pipewire-node-%u", id);
+    }
+    {
+      base::AutoLock locked(state->lock);
+      state->RefreshNodeIdentityLocked(node, props);
+    }
+    if (node.description.empty()) {
+      node.description = node.node_name;
+    }
+    if (node.device_name.empty()) {
+      node.device_name = node.description;
+    }
+    if (node.type.empty()) {
+      node.type = NodeType(node.is_input, node.media_class, node.device_bus,
+                           node.device_form_factor, node.device_api,
+                           node.device_icon_name,
+                           node.description + " " + node.node_name);
+    }
+    if (!node.stable_device_id) {
+      node.stable_device_id = StableNodeId(node.is_input, node.node_name);
+    }
+    if (!node.cras_node_id) {
+      node.cras_node_id = StableNodeId(node.is_input, node.node_name);
+    }
+
+    PipeWireNode* stored_node = nullptr;
+    {
+      base::AutoLock locked(state->lock);
+      auto node_iter = state->nodes.emplace(id, std::move(node)).first;
+      stored_node = &node_iter->second;
+      state->RebuildAudioStateLocked();
+    }
+    PipeWireNodeAddListener(stored_node->node.get(), &stored_node->listener,
+                            &kNodeEvents, stored_node);
+    uint32_t params[] = {SPA_PARAM_Props};
+    PipeWireNodeSubscribeParams(stored_node->node.get(), params, 1);
+    PipeWireNodeEnumParams(stored_node->node.get(), 0, SPA_PARAM_Props, 0,
+                           UINT32_MAX, nullptr);
+    state->PostNodesChangedIfNeeded();
+  }
+
+  static void OnRegistryGlobalRemove(void* data, uint32_t id) {
+    auto* state = static_cast<State*>(data);
+    bool changed = false;
+    pw_metadata* metadata_to_destroy = nullptr;
+    pw_node* node_to_destroy = nullptr;
+    {
+      base::AutoLock locked(state->lock);
+      if (id == state->metadata_id) {
+        if (state->metadata) {
+          spa_hook_remove(&state->metadata_listener);
+          metadata_to_destroy = state->metadata;
+        }
+        state->metadata = nullptr;
+        state->metadata_id = 0;
+      } else {
+        auto node = state->nodes.find(id);
+        if (node != state->nodes.end()) {
+          if (node->second.node) {
+            spa_hook_remove(&node->second.listener);
+            node_to_destroy = node->second.node;
+          }
+          state->nodes.erase(node);
+          state->RebuildAudioStateLocked();
+          changed = true;
+        }
+      }
+    }
+    if (metadata_to_destroy) {
+      pw_proxy_destroy(reinterpret_cast<pw_proxy*>(metadata_to_destroy));
+    }
+    if (node_to_destroy) {
+      pw_proxy_destroy(reinterpret_cast<pw_proxy*>(node_to_destroy));
+    }
+    if (changed) {
+      state->PostNodesChangedIfNeeded();
+    }
+  }
+
+  static int OnMetadataProperty(void* data,
+                                uint32_t subject,
+                                const char* key,
+                                const char* type,
+                                const char* value) {
+    auto* state = static_cast<State*>(data);
+    if (!key) {
+      return 0;
+    }
+    bool changed = false;
+    {
+      base::AutoLock locked(state->lock);
+      if (std::string(key) == kDefaultSinkKey) {
+        state->default_sink_name = ExtractMetadataNodeName(value);
+        state->RebuildAudioStateLocked();
+        changed = true;
+      } else if (std::string(key) == kDefaultSourceKey) {
+        state->default_source_name = ExtractMetadataNodeName(value);
+        state->RebuildAudioStateLocked();
+        changed = true;
+      }
+    }
+    if (changed) {
+      state->PostNodesChangedIfNeeded();
+    }
+    return 0;
+  }
+
+  static void OnNodeInfo(void* data, const pw_node_info* info) {
+    auto* node_data = static_cast<PipeWireNode*>(data);
+    if (!node_data || !node_data->state || !info) {
+      return;
+    }
+    State* state = node_data->state;
+    {
+      base::AutoLock locked(state->lock);
+      state->RefreshNodeInfoLocked(*node_data, info);
+    }
+    state->PostNodesChangedIfNeeded();
+  }
+
+  static void OnNodeParam(void* data,
+                          int seq,
+                          uint32_t id,
+                          uint32_t index,
+                          uint32_t next,
+                          const spa_pod* param) {
+    if (id != SPA_PARAM_Props) {
+      return;
+    }
+    auto* node_data = static_cast<PipeWireNode*>(data);
+    if (!node_data || !node_data->state) {
+      return;
+    }
+    State* state = node_data->state;
+    NodeParamChange change;
+    {
+      base::AutoLock locked(state->lock);
+      change = state->ApplyPropsParamLocked(*node_data, param);
+    }
+    if (change.volume_changed) {
+      if (change.is_input) {
+        state->PostInputNodeGainChanged(change.node_id, change.volume);
+      } else {
+        state->PostOutputNodeVolumeChanged(change.node_id, change.volume);
+      }
+    }
+    if (change.mute_changed && change.is_active) {
+      if (change.is_input) {
+        state->PostInputMuteChanged(change.muted);
+      } else {
+        state->PostOutputMuteChanged(change.muted);
+      }
+    }
+  }
+
+  static const pw_core_events kCoreEvents;
+  static const pw_registry_events kRegistryEvents;
+  static const pw_metadata_events kMetadataEvents;
+  static const pw_node_events kNodeEvents;
+
+  mutable base::Lock lock;
+  bool started = false;
+  bool initial_sync_done = false;
+  bool core_failed = false;
+  int sync_seq = 0;
+
+  raw_ptr<pw_thread_loop> thread_loop = nullptr;
+  raw_ptr<pw_context> context = nullptr;
+  raw_ptr<pw_core> core = nullptr;
+  raw_ptr<pw_registry> registry = nullptr;
+  raw_ptr<pw_metadata> metadata = nullptr;
+  uint32_t metadata_id = 0;
+  spa_hook core_listener = {};
+  spa_hook registry_listener = {};
+  spa_hook metadata_listener = {};
+
+  std::map<uint32_t, PipeWireNode> nodes;
+  std::map<uint64_t, uint32_t> pipewire_id_by_cras_id;
+  std::map<uint64_t, std::string> name_by_cras_id;
+  AudioNodeList node_list;
+  VolumeState volume_state;
+  uint64_t active_output_node_id = 0;
+  uint64_t active_input_node_id = 0;
+  std::string default_sink_name;
+  std::string default_source_name;
+  bool nodes_changed_pending = false;
+  base::RepeatingCallback<void(uint64_t)> on_active_input_node_changed;
+  base::RepeatingCallback<void(uint64_t)> on_active_output_node_changed;
+  base::RepeatingCallback<void(bool)> on_input_mute_changed;
+  base::RepeatingCallback<void(uint64_t, int)> on_input_node_gain_changed;
+  base::RepeatingClosure on_nodes_changed;
+  base::RepeatingCallback<void(bool)> on_output_mute_changed;
+  base::RepeatingCallback<void(uint64_t, int)> on_output_node_volume_changed;
+};
