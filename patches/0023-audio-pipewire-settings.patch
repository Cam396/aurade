+
+struct PipeWireCrasAudioClient::State {
+  struct PipeWireNode {
+    uint32_t pipewire_id = 0;
+    uint64_t cras_node_id = 0;
+    uint64_t stable_device_id = 0;
+    raw_ptr<State> state = nullptr;
+    bool is_input = false;
+    std::string node_name;
+    std::string description;
+    std::string device_name;
+    std::string device_bus;
+    std::string device_form_factor;
+    std::string device_api;
+    std::string device_icon_name;
+    std::string media_class;
+    std::string type;
+    uint32_t channels = 2;
+    uint32_t sample_rate = 0;
+    std::string node_latency;
+    int32_t volume = 100;
+    bool muted = false;
+    uint64_t plugged_time = 0;
+    raw_ptr<pw_node> node = nullptr;
+    spa_hook listener = {};
+  };
+
+  struct NodeParamChange {
+    bool is_input = false;
+    bool is_active = false;
+    bool volume_changed = false;
+    bool mute_changed = false;
+    uint64_t node_id = 0;
+    int32_t volume = 100;
+    bool muted = false;
+  };
+
+  // Lock order: when a path needs both locks, it must take PipeWire's thread
+  // loop lock first and `lock` second. PipeWire callbacks already run under
+  // the thread loop, so reversing the order would deadlock against callbacks.
+  State() {
+    volume_state.output_volume = 100;
+    volume_state.input_gain = 100;
+  }
+
+  ~State() { Stop(); }
+
+  bool Start() {
+    if (!g_pipewire_initialized) {
+      pw_init(nullptr, nullptr);
+      g_pipewire_initialized = true;
+    }
+
+    thread_loop = pw_thread_loop_new("aurade-pipewire-audio", nullptr);
+    if (!thread_loop) {
+      return false;
+    }
+
+    context =
+        pw_context_new(pw_thread_loop_get_loop(thread_loop.get()), nullptr, 0);
+    if (!context) {
+      Stop();
+      return false;
+    }
+
+    core = pw_context_connect(context.get(), nullptr, 0);
+    if (!core) {
+      Stop();
+      return false;
+    }
+
+    PipeWireCoreAddListener(core.get(), &core_listener, &kCoreEvents, this);
+    registry = pw_core_get_registry(core.get(), PW_VERSION_REGISTRY, 0);
+    if (!registry) {
+      Stop();
+      return false;
+    }
+    PipeWireRegistryAddListener(registry.get(), &registry_listener,
+                                &kRegistryEvents, this);
+
+    if (pw_thread_loop_start(thread_loop.get()) < 0) {
+      Stop();
+      return false;
+    }
+
+    pw_thread_loop_lock(thread_loop.get());
+    sync_seq = PipeWireCoreSync(core.get(), PW_ID_CORE, 0);
+    while (!initial_sync_done && !core_failed) {
+      pw_thread_loop_wait(thread_loop.get());
+    }
+    pw_thread_loop_unlock(thread_loop.get());
+
+    started = !core_failed;
+    return started;
+  }
+
+  void Stop() {
+    if (thread_loop) {
+      pw_thread_loop_stop(thread_loop.get());
+    }
+
+    for (auto& [id, node] : nodes) {
+      if (node.node) {
+        spa_hook_remove(&node.listener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy*>(node.node.get()));
+      }
+    }
+    nodes.clear();
+
+    if (metadata) {
+      spa_hook_remove(&metadata_listener);
+      pw_proxy_destroy(reinterpret_cast<pw_proxy*>(metadata.get()));
+      metadata = nullptr;
+    }
+    if (registry) {
+      pw_proxy_destroy(reinterpret_cast<pw_proxy*>(registry.get()));
+      registry = nullptr;
+    }
+    if (core) {
+      pw_core_disconnect(core.get());
+      core = nullptr;
+    }
+    if (context) {
+      pw_context_destroy(context.get());
+      context = nullptr;
+    }
+    if (thread_loop) {
+      pw_thread_loop_destroy(thread_loop.get());
+      thread_loop = nullptr;
+    }
+    started = false;
+  }
+
+  void RebuildAudioStateLocked() EXCLUSIVE_LOCKS_REQUIRED(lock) {
+    node_list.clear();
+    pipewire_id_by_cras_id.clear();
+    name_by_cras_id.clear();
+
+    uint64_t active_output = 0;
+    uint64_t active_input = 0;
+    uint64_t first_output = 0;
+    uint64_t first_input = 0;
+
+    for (const auto& [pipewire_id, node] : nodes) {
+      if (!node.node) {
+        continue;
+      }
+
+      const uint64_t cras_id = node.cras_node_id;
+      pipewire_id_by_cras_id[cras_id] = pipewire_id;
+      name_by_cras_id[cras_id] = node.node_name;
+
+      if (node.is_input) {
+        if (!first_input) {
+          first_input = cras_id;
+        }
+        if (!default_source_name.empty() &&
+            default_source_name == node.node_name) {
+          active_input = cras_id;
+        }
+      } else {
+        if (!first_output) {
+          first_output = cras_id;
+        }
+        if (!default_sink_name.empty() && default_sink_name == node.node_name) {
+          active_output = cras_id;
+        }
+      }
+    }
+
+    if (!active_output) {
+      active_output = first_output;
+    }
+    if (!active_input) {
+      active_input = first_input;
+    }
+    active_output_node_id = active_output;
+    active_input_node_id = active_input;
+
+    for (const auto& [pipewire_id, node] : nodes) {
+      if (!node.node) {
+        continue;
+      }
+      const bool active =
+          node.cras_node_id == (node.is_input ? active_input : active_output);
+      AudioNode audio_node(
+          node.is_input, node.cras_node_id, true, node.stable_device_id,
+          node.stable_device_id,
+          node.device_name.empty() ? node.description : node.device_name,
+          node.type,
+          node.description.empty() ? node.node_name : node.description, active,
+          node.plugged_time, node.channels, node.is_input ? 1 : 0,
+          node.is_input ? 0 : NUMBER_OF_VOLUME_STEPS_DEFAULT,
+          node.sample_rate, node.node_latency);
+      node_list.push_back(std::move(audio_node));
+
+      if (active) {
+        if (node.is_input) {
+          volume_state.input_gain = node.volume;
+          volume_state.input_mute = node.muted;
+        } else {
+          volume_state.output_volume = node.volume;
+          volume_state.output_system_mute = node.muted;
+          volume_state.output_user_mute = node.muted;
+        }
+      }
+    }
+  }
+
+  void RefreshNodeIdentityLocked(PipeWireNode& node, const spa_dict* props)
+      EXCLUSIVE_LOCKS_REQUIRED(lock) {
+    if (!props) {
+      return;
+    }
+
+    std::string node_name = DictString(props, PW_KEY_NODE_NAME);
+    if (!node_name.empty()) {
+      node.node_name = node_name;
+    }
+
+    std::string description = DictString(props, PW_KEY_NODE_DESCRIPTION);
+    if (description.empty()) {
+      description = DictString(props, PW_KEY_NODE_NICK);
+    }
+    if (description.empty()) {
+      description = DictString(props, PW_KEY_MEDIA_NAME);
+    }
+    if (description.empty()) {
+      description = DictString(props, PW_KEY_DEVICE_DESCRIPTION);
+    }
+    if (!description.empty()) {
+      node.description = description;
+    }
+
+    node.device_name = FirstNonEmpty({
+        DictString(props, PW_KEY_DEVICE_PRODUCT_NAME),
+        DictString(props, PW_KEY_DEVICE_DESCRIPTION),
+        DictString(props, SPA_KEY_API_ALSA_CARD_LONGNAME),
+        DictString(props, SPA_KEY_API_ALSA_CARD_NAME),
+        node.description,
+        node.node_name,
+    });
+    node.device_bus = DictString(props, PW_KEY_DEVICE_BUS);
+    node.device_form_factor = DictString(props, PW_KEY_DEVICE_FORM_FACTOR);
+    node.device_api = DictString(props, PW_KEY_DEVICE_API);
+    if (node.device_api.empty()) {
+      node.device_api = DictString(props, PW_KEY_FACTORY_NAME);
+    }
+    node.device_icon_name = DictString(props, PW_KEY_DEVICE_ICON_NAME);
+    node.channels =
+        DictUInt32(props, PW_KEY_AUDIO_CHANNELS, node.is_input ? 1u : 2u);
+    node.sample_rate = DictUInt32(props, PW_KEY_AUDIO_RATE, node.sample_rate);
+    node.node_latency = DictString(props, PW_KEY_NODE_LATENCY);
+    node.plugged_time =
+        DictUInt64(props, PW_KEY_NODE_PLUGGED,
+                   DictUInt64(props, PW_KEY_DEVICE_PLUGGED, node.plugged_time));
+    node.cras_node_id = StableNodeId(
+        node.is_input,
+        FirstNonEmpty(
+            {node.node_name,
+             DeviceIdentityKey(node.is_input, node.node_name, props)}));
+    node.stable_device_id = StableNodeId(
+        node.is_input, DeviceIdentityKey(node.is_input, node.node_name, props));
+    node.type = NodeType(
+        node.is_input, node.media_class, node.device_bus,
+        node.device_form_factor, node.device_api, node.device_icon_name,
+        node.description + " " + node.device_name + " " + node.node_name + " " +
+            DictString(props, PW_KEY_NODE_NAME));
+  }
+
+  void RefreshNodeInfoLocked(PipeWireNode& node, const pw_node_info* info)
+      EXCLUSIVE_LOCKS_REQUIRED(lock) {
+    RefreshNodeIdentityLocked(node, info->props);
+    RebuildAudioStateLocked();
+  }
+
+  NodeParamChange ApplyPropsParamLocked(PipeWireNode& node,
+                                        const spa_pod* param)
+      EXCLUSIVE_LOCKS_REQUIRED(lock) {
+    NodeParamChange change;
+    change.is_input = node.is_input;
+    change.node_id = node.cras_node_id;
+    change.volume = node.volume;
+    change.muted = node.muted;
+
+    if (!param) {
+      return change;
+    }
+
+    bool muted = node.muted;
+    const int32_t previous_volume = node.volume;
+    const bool previous_muted = node.muted;
+    uint32_t child_size = 0;
+    uint32_t child_type = 0;
+    uint32_t n_values = 0;
+    const void* values = nullptr;
+
+    uint32_t object_id = SPA_PARAM_Props;
+    spa_pod_parse_object(
+        param, SPA_TYPE_OBJECT_Props, &object_id, SPA_PROP_mute,
+        SPA_POD_OPT_Bool(&muted), SPA_PROP_channelVolumes,
+        SPA_POD_OPT_Array(&child_size, &child_type, &n_values, &values));
+
+    node.muted = muted;
+    if (values && child_type == SPA_TYPE_Float && child_size == sizeof(float) &&
+        n_values > 0 && n_values <= kMaxAudioChannels) {
+      // PipeWire's SPA parser returns array payloads as an untyped C pointer.
+      // Bound the channel count before reintroducing the float span.
+      auto volumes = UNSAFE_BUFFERS(
+          base::span(static_cast<const float*>(values), n_values));
+      const float sum = std::accumulate(volumes.begin(), volumes.end(), 0.0f);
+      node.volume = PercentFromVolume(sum / n_values);
+    }
+    RebuildAudioStateLocked();
+
+    change.is_active =
+        node.cras_node_id ==
+        (node.is_input ? active_input_node_id : active_output_node_id);
+    change.volume_changed = previous_volume != node.volume;
+    change.mute_changed = previous_muted != node.muted;
+    change.volume = node.volume;
+    change.muted = node.muted;
+    return change;
+  }
+
+  void PostNodesChangedIfNeeded() {
+    bool should_post = false;
+    {
+      base::AutoLock locked(lock);
+      if (!nodes_changed_pending) {
+        nodes_changed_pending = true;
+        should_post = true;
+      }
+    }
+    if (should_post && !on_nodes_changed.is_null()) {
+      on_nodes_changed.Run();
+    }
+  }
