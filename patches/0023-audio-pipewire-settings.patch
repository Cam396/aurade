+std::optional<base::FilePath> GetAuraAudioQualityConfigFile() {
+  auto env = base::Environment::Create();
+  std::optional<std::string> home = env->GetVar("HOME");
+  if (!home || home->empty()) {
+    return std::nullopt;
+  }
+
+  return base::FilePath(*home).Append(kAuraAudioQualityConfigPath);
+}
+
+mojom::LinuxAudioQualityProfile ReadAuraAudioQualityProfileFromDisk() {
+  const std::optional<base::FilePath> config_path =
+      GetAuraAudioQualityConfigFile();
+  if (config_path && base::PathExists(*config_path)) {
+    return mojom::LinuxAudioQualityProfile::kHighQuality;
+  }
+  return mojom::LinuxAudioQualityProfile::kBalanced;
+}
+
+bool WriteAuraAudioQualityProfile(bool enabled) {
+  const std::optional<base::FilePath> config_path =
+      GetAuraAudioQualityConfigFile();
+  if (!config_path) {
+    return false;
+  }
+
+  if (!enabled) {
+    return base::DeleteFile(*config_path) || !base::PathExists(*config_path);
+  }
+
+  if (!base::CreateDirectory(config_path->DirName())) {
+    return false;
+  }
+  return base::WriteFile(*config_path, kAuraHighQualityPipeWireConfig);
+}
+
+void RestartAuraAudioStackIfAvailable() {
+  base::FilePath helper(kAuraAudioHelperPath);
+  if (!base::PathExists(helper)) {
+    return;
+  }
+
+  base::CommandLine command_line(helper);
+  command_line.AppendArg("restart");
+  base::LaunchProcess(command_line, base::LaunchOptions());
+}
 
