+  state_->on_active_input_node_changed = base::BindPostTask(
+      task_runner, base::BindRepeating(
+                       &PipeWireCrasAudioClient::NotifyActiveInputNodeChanged,
+                       weak_factory_.GetWeakPtr()));
+  state_->on_active_output_node_changed = base::BindPostTask(
+      task_runner, base::BindRepeating(
+                       &PipeWireCrasAudioClient::NotifyActiveOutputNodeChanged,
+                       weak_factory_.GetWeakPtr()));
+  state_->on_input_mute_changed = base::BindPostTask(
+      task_runner,
+      base::BindRepeating(&PipeWireCrasAudioClient::NotifyInputMuteChanged,
+                          weak_factory_.GetWeakPtr()));
+  state_->on_input_node_gain_changed = base::BindPostTask(
+      task_runner,
+      base::BindRepeating(&PipeWireCrasAudioClient::NotifyInputNodeGainChanged,
+                          weak_factory_.GetWeakPtr()));
+  state_->on_nodes_changed = base::BindPostTask(
+      task_runner,
+      base::BindRepeating(&PipeWireCrasAudioClient::NotifyNodesChanged,
+                          weak_factory_.GetWeakPtr()));
+  state_->on_output_mute_changed = base::BindPostTask(
+      task_runner,
+      base::BindRepeating(&PipeWireCrasAudioClient::NotifyOutputMuteChanged,
+                          weak_factory_.GetWeakPtr()));
+  state_->on_output_node_volume_changed = base::BindPostTask(
+      task_runner, base::BindRepeating(
+                       &PipeWireCrasAudioClient::NotifyOutputNodeVolumeChanged,
+                       weak_factory_.GetWeakPtr()));
