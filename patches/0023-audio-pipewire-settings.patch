+bool PipeWireCrasAudioClient::SetDefaultNode(uint64_t node_id, bool is_input) {
+  pw_thread_loop* loop = nullptr;
+  std::string node_name;
+
+  {
+    base::AutoLock locked(state_->lock);
+    auto name = state_->name_by_cras_id.find(node_id);
+    if (name == state_->name_by_cras_id.end()) {
+      return false;
+    }
+    node_name = name->second;
+    loop = state_->thread_loop;
+  }
+
+  if (loop) {
+    const std::string value = PipeWireDefaultValue(node_name);
+    pw_thread_loop_lock(loop);
+    pw_metadata* metadata = nullptr;
+    {
+      base::AutoLock locked(state_->lock);
+      metadata = state_->metadata;
+    }
+    if (metadata) {
+      PipeWireMetadataSetProperty(
+          metadata, 0, is_input ? kDefaultSourceKey : kDefaultSinkKey,
+          kMetadataJsonType, value.c_str());
+    }
+    pw_thread_loop_unlock(loop);
+  }
+
+  {
+    base::AutoLock locked(state_->lock);
+    if (is_input) {
+      state_->default_source_name = node_name;
+    } else {
+      state_->default_sink_name = node_name;
+    }
+    state_->RebuildAudioStateLocked();
+  }
+  return true;
+}
+
+bool PipeWireCrasAudioClient::SetNodeProps(uint64_t node_id,
+                                           std::optional<int32_t> volume,
+                                           std::optional<bool> mute) {
+  pw_thread_loop* loop = nullptr;
+
+  {
+    base::AutoLock locked(state_->lock);
+    loop = state_->thread_loop;
+  }
+
+  if (!loop) {
+    return false;
+  }
+
+  pw_thread_loop_lock(loop);
+  pw_node* node = nullptr;
+  uint32_t channels = 2;
+  {
+    base::AutoLock locked(state_->lock);
+    auto pipewire_id = state_->pipewire_id_by_cras_id.find(node_id);
+    if (pipewire_id != state_->pipewire_id_by_cras_id.end()) {
+      auto pipewire_node = state_->nodes.find(pipewire_id->second);
+      if (pipewire_node != state_->nodes.end()) {
+        node = pipewire_node->second.node;
+        channels = std::max(pipewire_node->second.channels, 1u);
+      }
+    }
+  }
+  if (!node) {
+    pw_thread_loop_unlock(loop);
+    return false;
+  }
+
+  uint8_t buffer[512];
+  spa_pod_builder builder = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+  spa_pod_frame frame;
+  spa_pod_builder_push_object(&builder, &frame, SPA_TYPE_OBJECT_Props,
+                              SPA_PARAM_Props);
+  if (mute.has_value()) {
+    spa_pod_builder_prop(&builder, SPA_PROP_mute, 0);
+    spa_pod_builder_bool(&builder, *mute);
+  }
+  if (volume.has_value()) {
+    std::vector<float> channel_volumes(channels, VolumeFromPercent(*volume));
+    spa_pod_builder_prop(&builder, SPA_PROP_channelVolumes, 0);
+    spa_pod_builder_array(&builder, sizeof(float), SPA_TYPE_Float, channels,
+                          channel_volumes.data());
+  }
+  const spa_pod* pod =
+      static_cast<const spa_pod*>(spa_pod_builder_pop(&builder, &frame));
+
+  const int result = PipeWireNodeSetParam(node, SPA_PARAM_Props, 0, pod);
+  pw_thread_loop_unlock(loop);
+  return result >= 0;
+}
+
+void PipeWireCrasAudioClient::SetOutputNodeVolume(uint64_t node_id,
+                                                  int32_t volume) {
+  if (!SetNodeProps(node_id, std::clamp(volume, 0, 100), std::nullopt)) {
+    return;
+  }
+  {
+    base::AutoLock locked(state_->lock);
+    auto pipewire_id = state_->pipewire_id_by_cras_id.find(node_id);
+    if (pipewire_id != state_->pipewire_id_by_cras_id.end()) {
+      state_->nodes[pipewire_id->second].volume = std::clamp(volume, 0, 100);
+      state_->RebuildAudioStateLocked();
+    }
+  }
+  state_->PostOutputNodeVolumeChanged(node_id, std::clamp(volume, 0, 100));
+}
+
+void PipeWireCrasAudioClient::SetOutputUserMute(bool mute_on) {
+  uint64_t node_id = 0;
+  {
+    base::AutoLock locked(state_->lock);
+    node_id = state_->active_output_node_id;
+  }
+  if (node_id) {
+    SetNodeProps(node_id, std::nullopt, mute_on);
+  }
+  {
+    base::AutoLock locked(state_->lock);
+    state_->volume_state.output_user_mute = mute_on;
+    state_->volume_state.output_system_mute = mute_on;
+    auto pipewire_id = state_->pipewire_id_by_cras_id.find(node_id);
+    if (pipewire_id != state_->pipewire_id_by_cras_id.end()) {
+      state_->nodes[pipewire_id->second].muted = mute_on;
+      state_->RebuildAudioStateLocked();
+    }
+  }
+  state_->PostOutputMuteChanged(mute_on);
+}
