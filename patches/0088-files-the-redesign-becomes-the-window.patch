new file mode 100644
index 0000000..92f9cf5
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/app/mount.ts
@@ -0,0 +1,97 @@
+/**
+ * The redesign, mounted by the app rather than pushed into it.
+ *
+ * `tests/harness/live_shell.js` proved this assembly by injecting it over the
+ * debugger, which was enough to see it and not enough to ship it: nothing in
+ * the Files app constructed any of this, so opening the window normally still
+ * gave you the stock one. This is the same three lines, run by the app itself.
+ *
+ * The stock UI is not torn down. It is still initialised and still holds every
+ * piece we have not replaced: the dialogs, the IO progress panel, the context
+ * menus, the crostini share flow. This draws over it, opaque and full window,
+ * so the machinery underneath stays alive and reachable while the surface is
+ * ours. Remove `#aurade-shell` and the old window is exactly as it was, which
+ * is the property that makes it safe to put this in front of a real
+ * filesystem before all of those have an answer.
+ *
+ * Every collaborator arrives as an argument. Nothing here reads a global, so
+ * the local loop can compile it without the ChromeOS type definitions and the
+ * hardware harness can build the same thing from the running app's own
+ * objects.
+ */
+import type {FileManagerPrivateSlice, LastErrorSource, MetadataModelSlice, ResolveUrl, VolumeManagerSlice} from '../adapter/chromeos_platform.js';
+import {ChromeOsPlatform} from '../adapter/chromeos_platform.js';
+import {ChromeOsBackend} from '../adapter/chromeos_backend.js';
+import {TOKENS_CSS} from '../ui/tokens_css.js';
+import {FilesShell} from '../ui/shell.js';
+
+export interface MountOptions {
+  readonly api: FileManagerPrivateSlice;
+  readonly runtime: LastErrorSource;
+  readonly volumes: VolumeManagerSlice;
+  readonly metadata: MetadataModelSlice;
+  readonly resolveUrl: ResolveUrl;
+  /** Defaults to the document body. */
+  readonly container?: HTMLElement;
+}
+
+/** The id of the element the shell lives in, so it can be found and removed. */
+export const MOUNT_ID = 'aurade-shell';
+
+/** The id of the style element, so a second mount replaces rather than repeats. */
+const STYLE_ID = 'aurade-tokens';
+
+/**
+ * Puts the stylesheet in the document.
+ *
+ * As a `<style>` rather than a `<link>`, because the stylesheet cannot be its
+ * own pak resource: a new resource is a new id, the id map is compiled into
+ * chrome, and that is a full link rather than a pak swap. `tools/gen_tokens.py`
+ * turns `ui/tokens.css` into the string this writes, and `tests/run.sh` fails
+ * if the two have drifted.
+ */
+function applyTokens(): void {
+  let style = document.getElementById(STYLE_ID);
+  if (!style) {
+    style = document.createElement('style');
+    style.id = STYLE_ID;
+    document.head.appendChild(style);
+  }
+  style.textContent = TOKENS_CSS;
+}
+
+/**
+ * Builds the window and starts it.
+ *
+ * Returns null rather than throwing when it cannot start. A window that fails
+ * halfway is worse than the old window, so the host element goes away again
+ * and the app underneath is what you see. Deciding that here rather than in
+ * the caller means there is one place that knows what the fallback is.
+ */
+export async function mountAuradeShell(options: MountOptions):
+    Promise<FilesShell|null> {
+  const existing = document.getElementById(MOUNT_ID);
+  if (existing) {
+    existing.remove();
+  }
+  applyTokens();
+  const host = document.createElement('div');
+  host.id = MOUNT_ID;
+  (options.container ?? document.body).appendChild(host);
+
+  try {
+    const platform = new ChromeOsPlatform(
+        options.api, options.runtime, options.volumes, options.metadata,
+        options.resolveUrl,
+        // Null is an ordinary window rather than a picker. Dialog mode comes
+        // later, and passing the launch parameters here is all it will need.
+        null);
+    const shell = new FilesShell(host, new ChromeOsBackend(platform));
+    await shell.start();
+    return shell;
+  } catch (error) {
+    host.remove();
+    console.error('AuraDE Files did not start, leaving the stock window', error);
+    return null;
+  }
+}
