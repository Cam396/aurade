diff --git a/ui/file_manager/file_manager/aurade/tools/gen_tokens.py b/ui/file_manager/file_manager/aurade/tools/gen_tokens.py
new file mode 100755
index 0000000..2f422c2
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tools/gen_tokens.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Turns ui/tokens.css into a TypeScript module.
+
+The stylesheet cannot ship as its own pak resource. A new resource is a new id,
+the id map is compiled into chrome, and adding one means a full link: 43,084
+edges and about six hours on hardware that overheats. `pak-swap-resources.py`
+refuses to insert an id for exactly this reason. So the tokens travel inside a
+resource that already exists, which is the bundled JavaScript.
+
+`ui/tokens.css` stays the single source. The harness pages and the goldens link
+it directly; the app imports the module this writes. `tests/run.sh` regenerates
+and fails if the result would differ, so the two cannot drift.
+
+  python3 gen_tokens.py [--check]
+"""
+import argparse
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+AURADE = os.path.dirname(HERE)
+SOURCE = os.path.join(AURADE, "ui/tokens.css")
+OUTPUT = os.path.join(AURADE, "ui/tokens_css.ts")
+
+HEADER = """/**
+ * The stylesheet, as a string the bundle can carry.
+ *
+ * Generated by `tools/gen_tokens.py` from `ui/tokens.css`, which is the source
+ * of truth. Do not edit this file; edit the stylesheet and run the generator,
+ * or just run `tests/run.sh`, which checks that this is current.
+ *
+ * It exists because a new pak resource needs a new id, a new id is compiled
+ * into chrome, and that is a full link. See the generator for the details.
+ */
+"""
+
+
+def render():
+    with open(SOURCE) as handle:
+        css = handle.read()
+    return HEADER + "export const TOKENS_CSS = " + json.dumps(css) + ";\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check", action="store_true",
+                        help="exit non zero if the file is not current")
+    args = parser.parse_args()
+
+    wanted = render()
+    current = None
+    if os.path.exists(OUTPUT):
+        with open(OUTPUT) as handle:
+            current = handle.read()
+    if current == wanted:
+        return 0
+    if args.check:
+        sys.stderr.write(
+            "ui/tokens_css.ts is stale. Run tools/gen_tokens.py\n")
+        return 1
+    with open(OUTPUT, "w") as handle:
+        handle.write(wanted)
+    print("wrote %s" % os.path.relpath(OUTPUT, AURADE))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
