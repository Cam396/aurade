+export const TOKENS_CSS = "/**\n * The AuraDE surface vocabulary.\n *\n * The accent is not a new decision. The greeter already defines it, in GTK\n * theme variables rather than in its stylesheet: accent_bg_color is #6d4ea1 in\n * theme.css and #d1bcff in theme-dark.css, and the installer's token table\n * carries the same pair. Counting literal hex in greeter.css and concluding the\n * greeter was achromatic was a mistake; it uses @accent_color for focus rings\n * and the active pod.\n *\n * Surfaces are taken from the greeter's own values: translucent grounds, white\n * hairlines, white overlay interactive states, and deep soft shadows.\n */\n\n:root {\n  --aurade-accent: #6d4ea1;\n  --aurade-on-accent: #ffffff;\n\n  --aurade-ground: #f4f2f9;\n  --aurade-panel: #ffffff;\n  --aurade-line: #e6e2f0;\n  --aurade-ink: #1c1a24;\n  --aurade-quiet: #6b6580;\n\n  --aurade-row-hover: rgba(0, 0, 0, .04);\n  --aurade-row-selected: rgba(109, 78, 161, .12);\n  --aurade-tile: #f0edf7;\n  --aurade-tile-dir: #e4dbf8;\n  --aurade-tile-selected: #dbcdf6;\n  --aurade-glyph: #6f6885;\n  --aurade-tag-bg: #f7f5fc;\n  --aurade-warn: #a1651a;\n  --aurade-danger: #b3261e;\n\n  --aurade-radius-row: 11px;\n  --aurade-radius-tile: 11px;\n  --aurade-radius-panel: 16px;\n  --aurade-radius-pill: 999px;\n\n  --aurade-row-height: 40px;\n  --aurade-tile-size: 32px;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-aurade-theme=\"light\"]) {\n    --aurade-accent: #d1bcff;\n    --aurade-on-accent: #3f1d6c;\n\n    --aurade-ground: #100f16;\n    --aurade-panel: #191823;\n    --aurade-line: #262433;\n    --aurade-ink: #efecf8;\n    --aurade-quiet: #948ea8;\n\n    --aurade-row-hover: rgba(255, 255, 255, .06);\n    --aurade-row-selected: rgba(209, 188, 255, .16);\n    --aurade-tile: #23212f;\n    --aurade-tile-dir: #372c57;\n    --aurade-tile-selected: #4a3b74;\n    --aurade-glyph: #a79dc4;\n    --aurade-tag-bg: #211f2c;\n  --aurade-warn: #e6b062;\n  --aurade-danger: #f2b8b5;\n  }\n}\n\n/* Repeated rather than shared, because a media query and an attribute cannot\n   select the same block. The attribute form is what lets both themes be\n   rendered and diffed without emulating the reader's system setting. */\n:root[data-aurade-theme=\"dark\"] {\n    --aurade-accent: #d1bcff;\n    --aurade-on-accent: #3f1d6c;\n\n    --aurade-ground: #100f16;\n    --aurade-panel: #191823;\n    --aurade-line: #262433;\n    --aurade-ink: #efecf8;\n    --aurade-quiet: #948ea8;\n\n    --aurade-row-hover: rgba(255, 255, 255, .06);\n    --aurade-row-selected: rgba(209, 188, 255, .16);\n    --aurade-tile: #23212f;\n    --aurade-tile-dir: #372c57;\n    --aurade-tile-selected: #4a3b74;\n    --aurade-glyph: #a79dc4;\n    --aurade-tag-bg: #211f2c;\n  --aurade-warn: #e6b062;\n  --aurade-danger: #f2b8b5;\n}\n\n/* Density is fixed per mode, never measured. Dynamic row heights across a\n   hundred thousand entries make the scrollbar thumb jitter and drop frames. */\n:root[data-aurade-density=\"compact\"] { --aurade-row-height: 32px; --aurade-tile-size: 26px; }\n:root[data-aurade-density=\"relaxed\"] { --aurade-row-height: 52px; --aurade-tile-size: 38px; }\n\n.aurade-row {\n  align-items: center;\n  block-size: var(--aurade-row-height);\n  border-radius: var(--aurade-radius-row);\n  box-sizing: border-box;\n  color: var(--aurade-ink);\n  display: grid;\n  gap: 12px;\n  grid-template-columns: var(--aurade-tile-size) 1fr 84px 96px 132px;\n  margin-inline: 8px;\n  padding-inline: 8px;\n  position: relative;\n  user-select: none;\n}\n\n.aurade-row:hover { background: var(--aurade-row-hover); }\n\n/* Selection and focus differ by shape as well as colour, because colour alone\n   is not a distinction everyone can see. */\n.aurade-row[aria-selected=\"true\"] {\n  background: var(--aurade-row-selected);\n  box-shadow: inset 3px 0 0 0 var(--aurade-accent);\n}\n.aurade-row:focus-visible {\n  outline: 2px solid var(--aurade-accent);\n  outline-offset: -2px;\n}\n\n/* A cut entry is dashed as well as dimmed, so it reads as pending rather than\n   as disabled. */\n.aurade-row[data-cut=\"true\"] { opacity: .55; }\n.aurade-row[data-cut=\"true\"] .aurade-tile {\n  border: 1px dashed var(--aurade-quiet);\n}\n\n.aurade-tile {\n  align-items: center;\n  background: var(--aurade-tile);\n  block-size: var(--aurade-tile-size);\n  border-radius: var(--aurade-radius-tile);\n  box-sizing: border-box;\n  display: flex;\n  inline-size: var(--aurade-tile-size);\n  justify-content: center;\n}\n.aurade-row[data-directory=\"true\"] .aurade-tile { background: var(--aurade-tile-dir); }\n.aurade-row[aria-selected=\"true\"] .aurade-tile { background: var(--aurade-tile-selected); }\n\n.aurade-glyph {\n  block-size: 18px;\n  color: var(--aurade-glyph);\n  inline-size: 18px;\n}\n.aurade-row[data-directory=\"true\"] .aurade-glyph { color: var(--aurade-accent); }\n\n.aurade-name {\n  font-size: 13px;\n  font-weight: 550;\n  letter-spacing: -.005em;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.aurade-size, .aurade-date {\n  color: var(--aurade-quiet);\n  font-size: 12px;\n  font-variant-numeric: tabular-nums;\n}\n\n/* A quiet proportional bar behind the size, so the large item in a folder of\n   five hundred is visible without reading a digit. */\n.aurade-size { position: relative; }\n.aurade-size::before {\n  background: currentColor;\n  block-size: 100%;\n  content: '';\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  inline-size: var(--aurade-share, 0%);\n  opacity: .10;\n  position: absolute;\n  border-radius: 3px;\n}\n\n.aurade-type {\n  background: var(--aurade-tag-bg);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-pill);\n  color: var(--aurade-quiet);\n  font-size: 10.5px;\n  font-weight: 600;\n  justify-self: start;\n  letter-spacing: .04em;\n  line-height: 15px;\n  padding: 2px 9px;\n}\n\n/* The list owns its scrolling. The spacer carries the full extent so the\n   scrollbar is honest about how much there is, and the surface holding the\n   recycled rows is moved rather than repositioned per row. */\n.aurade-list {\n  block-size: 100%;\n  overflow-y: auto;\n  overflow-x: hidden;\n  position: relative;\n}\n.aurade-list:focus-visible { outline: none; }\n.aurade-list-spacer { position: relative; }\n.aurade-list-surface {\n  inset-block-start: 0;\n  inset-inline: 0;\n  position: absolute;\n  will-change: transform;\n}\n\n/* An empty view should read as prepared rather than abandoned, so it is\n   centred and quiet rather than a message pinned to the top left. */\n/* An author `display` beats the user agent's `[hidden] { display: none }`\n   regardless of specificity, because author styles win on origin. So setting\n   .hidden on this element did nothing at all and every folder with files in it\n   also announced that it was empty. */\n.aurade-empty[hidden] { display: none; }\n.aurade-empty {\n  align-items: center;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  justify-content: center;\n  min-block-size: 220px;\n  padding: 32px 24px;\n  text-align: center;\n}\n.aurade-empty-title {\n  color: var(--aurade-ink);\n  font-size: 14px;\n  font-weight: 600;\n  margin: 0;\n}\n.aurade-empty-detail {\n  color: var(--aurade-quiet);\n  font-size: 13px;\n  margin: 0;\n  /* Wide enough that a two line detail breaks after a clause rather than\n     stranding \"files.\" on its own. */\n  max-inline-size: 48ch;\n}\n\n\n/* The sidebar: where you can go, as opposed to what is in front of you.\n\n   Group headings are quiet and small rather than uppercase and tracked out.\n   Small caps at this size is a legibility cost paid for a filing cabinet\n   aesthetic nobody asked for, and these are three or four words that want to\n   be skimmed past on the way to the thing underneath. */\n.aurade-sidebar {\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n  inline-size: 232px;\n  overflow-y: auto;\n  padding: 12px 10px;\n}\n.aurade-place-heading {\n  color: var(--aurade-quiet);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: .01em;\n  margin: 0 0 4px;\n  padding-inline: 10px;\n}\n.aurade-place-list {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.aurade-place {\n  align-items: center;\n  background: none;\n  border: 0;\n  border-radius: var(--aurade-radius-row);\n  color: var(--aurade-ink);\n  cursor: default;\n  display: flex;\n  font: inherit;\n  gap: 10px;\n  inline-size: 100%;\n  padding: 7px 10px;\n  position: relative;\n  text-align: start;\n}\n.aurade-place:hover { background: var(--aurade-row-hover); }\n.aurade-place:focus-visible {\n  outline: 2px solid var(--aurade-accent);\n  outline-offset: -2px;\n}\n.aurade-place[aria-current=\"page\"] {\n  background: var(--aurade-row-selected);\n  color: var(--aurade-accent);\n  font-weight: 600;\n}\n/* A rail rather than a full bleed fill. The fill alone reads as a hover that\n   got stuck; the rail is what says this is where you are. */\n.aurade-place[aria-current=\"page\"]::before {\n  background: var(--aurade-accent);\n  block-size: 16px;\n  border-radius: var(--aurade-radius-pill);\n  content: \"\";\n  inline-size: 3px;\n  inset-block-start: 50%;\n  inset-inline-start: 1px;\n  position: absolute;\n  translate: 0 -50%;\n}\n.aurade-place-glyph {\n  block-size: 18px;\n  color: var(--aurade-glyph);\n  flex: none;\n  inline-size: 18px;\n}\n.aurade-place[aria-current=\"page\"] .aurade-place-glyph { color: inherit; }\n.aurade-place-label {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.aurade-place-badge {\n  background: var(--aurade-tag-bg);\n  border-radius: var(--aurade-radius-pill);\n  color: var(--aurade-quiet);\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n  margin-inline-start: auto;\n  padding: 1px 7px;\n}\n.aurade-place[aria-current=\"page\"] .aurade-place-badge {\n  background: var(--aurade-panel);\n  color: var(--aurade-accent);\n}\n\n/* Capacity sits under the drive it belongs to, indented to the label rather\n   than the glyph, so the eye reads it as a note about that row. */\n.aurade-place-capacity {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 1px 10px 6px 38px;\n}\n.aurade-place-free {\n  color: var(--aurade-quiet);\n  font-size: 11px;\n}\n.aurade-place-bar {\n  background: var(--aurade-line);\n  block-size: 3px;\n  border-radius: var(--aurade-radius-pill);\n  overflow: hidden;\n}\n.aurade-place-bar-fill {\n  background: var(--aurade-accent);\n  block-size: 100%;\n  border-radius: inherit;\n}\n.aurade-place-bar-fill[data-level=\"high\"] { background: var(--aurade-warn); }\n.aurade-place-bar-fill[data-level=\"full\"] { background: var(--aurade-danger); }\n\n\n/* Where the app mounts us.\n\n   Opaque and over everything, because the stock window is still underneath and\n   still running: it owns the dialogs, the progress panel and the menus we have\n   not replaced. Drawing over it rather than deleting it is what makes this\n   reversible, and `mountAuradeShell` removes this element if the shell fails\n   to start, which puts the old window straight back. */\n#aurade-shell {\n  background: var(--aurade-ground);\n  inset: 0;\n  overflow: hidden;\n  position: fixed;\n  z-index: 2147483647;\n}\n\n/* The window. Places on the left, what is in them on the right, each on its\n   own panel so the ground shows between them: the greeter does the same thing,\n   and it is what stops a file manager reading as one undifferentiated grid. */\n.aurade-shell {\n  background: var(--aurade-ground);\n  block-size: 100%;\n  box-sizing: border-box;\n  display: flex;\n  gap: 8px;\n  padding: 8px;\n}\n.aurade-shell-aside {\n  background: var(--aurade-panel);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-panel);\n  display: flex;\n  flex: none;\n  overflow: hidden;\n}\n.aurade-shell-main {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  gap: 8px;\n  /* Without this a long file name makes the whole window wider instead of\n     being truncated, and the sidebar gets pushed off the left edge. */\n  min-inline-size: 0;\n}\n.aurade-shell-list {\n  background: var(--aurade-panel);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-panel);\n  flex: 1;\n  min-block-size: 0;\n  overflow: hidden;\n  padding: 4px 0;\n}\n.aurade-shell-notice {\n  background: var(--aurade-panel);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-panel);\n  color: var(--aurade-quiet);\n  font-size: 13px;\n  margin: 0;\n  padding: 11px 15px;\n}\n\n\n/* The toolbar. Back, forward, up, then where you are.\n\n   The buttons are disabled rather than removed when there is nowhere to go: a\n   control that appears and disappears shifts everything beside it, and the one\n   thing you need from back and forward is that they are always in the same\n   place. */\n.aurade-toolbar {\n  align-items: center;\n  /* The containing block for a sibling popover, which cannot live inside the\n     path bar because that clips. */\n  position: relative;\n  background: var(--aurade-panel);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-panel);\n  display: flex;\n  flex: none;\n  gap: 8px;\n  min-block-size: 44px;\n  padding: 5px 8px;\n}\n.aurade-tool-group {\n  display: flex;\n  flex: none;\n  gap: 2px;\n}\n.aurade-tool {\n  align-items: center;\n  background: none;\n  border: 0;\n  border-radius: var(--aurade-radius-tile);\n  block-size: 30px;\n  color: var(--aurade-glyph);\n  cursor: default;\n  display: flex;\n  inline-size: 30px;\n  justify-content: center;\n  padding: 0;\n}\n.aurade-tool:hover:not(:disabled) {\n  background: var(--aurade-row-hover);\n  color: var(--aurade-ink);\n}\n.aurade-tool:focus-visible {\n  outline: 2px solid var(--aurade-accent);\n  outline-offset: -2px;\n}\n/* Not display:none and not 0.3 either. A disabled control still has to read as\n   a control, or the row looks like it lost something. */\n.aurade-tool:disabled { opacity: .38; }\n.aurade-tool-glyph { block-size: 18px; inline-size: 18px; }\n\n.aurade-path {\n  flex: 1;\n  min-inline-size: 0;\n  overflow: hidden;\n}\n.aurade-path-list {\n  align-items: center;\n  display: flex;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.aurade-path-list > li { display: flex; position: relative; }\n.aurade-crumb {\n  background: none;\n  border: 0;\n  border-radius: var(--aurade-radius-tile);\n  color: var(--aurade-quiet);\n  cursor: default;\n  font: inherit;\n  max-inline-size: 22ch;\n  overflow: hidden;\n  padding: 5px 8px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.aurade-crumb:hover { background: var(--aurade-row-hover); }\n.aurade-crumb:focus-visible,\n.aurade-chevron:focus-visible,\n.aurade-path-option:focus-visible {\n  outline: 2px solid var(--aurade-accent);\n  outline-offset: -2px;\n}\n/* Where you are is the one crumb that is not a link to somewhere else, so it\n   is the one that reads as text rather than as an action. */\n.aurade-crumb[aria-current=\"page\"] {\n  color: var(--aurade-ink);\n  font-weight: 600;\n}\n.aurade-chevron {\n  align-items: center;\n  background: none;\n  border: 0;\n  border-radius: var(--aurade-radius-tile);\n  block-size: 24px;\n  color: var(--aurade-glyph);\n  cursor: default;\n  display: flex;\n  inline-size: 20px;\n  justify-content: center;\n  opacity: .6;\n  padding: 0;\n}\n.aurade-chevron:hover,\n.aurade-chevron[aria-expanded=\"true\"] {\n  background: var(--aurade-row-hover);\n  color: var(--aurade-ink);\n  opacity: 1;\n}\n.aurade-chevron-glyph { block-size: 16px; inline-size: 16px; }\n\n.aurade-path-popover {\n  background: var(--aurade-panel);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-tile);\n  box-shadow: 0 12px 32px rgba(0, 0, 0, .22), 0 2px 6px rgba(0, 0, 0, .12);\n  display: flex;\n  flex-direction: column;\n  max-block-size: 320px;\n  min-inline-size: 200px;\n  overflow-y: auto;\n  padding: 5px;\n  position: absolute;\n  z-index: 20;\n}\n.aurade-path-option {\n  background: none;\n  border: 0;\n  border-radius: var(--aurade-radius-tile);\n  color: var(--aurade-ink);\n  cursor: default;\n  font: inherit;\n  overflow: hidden;\n  padding: 7px 10px;\n  text-align: start;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.aurade-path-option:hover { background: var(--aurade-row-hover); }\n.aurade-path-popover-empty {\n  color: var(--aurade-quiet);\n  margin: 0;\n  padding: 8px 10px;\n}\n\n\n/* The status bar. What is in front of you on the left, how much room is left\n   on the right, and nothing in the middle until there is an undo to put there. */\n.aurade-status {\n  align-items: center;\n  background: var(--aurade-panel);\n  border: 1px solid var(--aurade-line);\n  border-radius: var(--aurade-radius-panel);\n  color: var(--aurade-quiet);\n  display: flex;\n  flex: none;\n  font-size: 12px;\n  gap: 16px;\n  justify-content: space-between;\n  min-block-size: 34px;\n  padding: 6px 14px;\n}\n.aurade-status-summary {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.aurade-status-space {\n  align-items: center;\n  display: flex;\n  flex: none;\n  gap: 8px;\n}\n.aurade-status-track {\n  background: var(--aurade-line);\n  block-size: 3px;\n  border-radius: var(--aurade-radius-pill);\n  inline-size: 72px;\n  overflow: hidden;\n}\n.aurade-status-fill {\n  background: var(--aurade-accent);\n  block-size: 100%;\n  border-radius: inherit;\n}\n.aurade-status-fill[data-level=\"high\"] { background: var(--aurade-warn); }\n.aurade-status-fill[data-level=\"full\"] { background: var(--aurade-danger); }\n";
