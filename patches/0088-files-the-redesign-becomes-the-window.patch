index 0000000..c5d41fd
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/svg.ts
@@ -0,0 +1,73 @@
+/**
+ * Glyphs as nodes rather than as markup.
+ *
+ * Every glyph in this app used to be a template string assigned to innerHTML.
+ * That works in a plain page and throws on chrome://file-manager, which
+ * requires Trusted Types and refuses a bare string at that sink. Nothing local
+ * caught it, because the harness pages carried no such policy. They do now, so
+ * this particular way of being wrong cannot come back quietly.
+ *
+ * Building the nodes is the right way round for SVG regardless.
+ * `createElement('svg')` makes an HTMLUnknownElement that renders nothing,
+ * which is why the string form was reached for in the first place.
+ */
+
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+/** How a glyph's path is painted. */
+export interface Stroke {
+  /** Drawn as an outline rather than filled. */
+  readonly stroked: boolean;
+  /** Line width when stroked. Ignored when filled. */
+  readonly width?: number;
+}
+
+/**
+ * An `<svg>` holding one empty `<path>`.
+ *
+ * Empty because a recycled row keeps the element it already has and only ever
+ * changes the path's attributes. See `file_row.ts` for why that split matters.
+ */
+export function glyphElement(className: string): SVGElement {
+  const svg = document.createElementNS(SVG_NS, 'svg');
+  // setAttribute rather than `.className`: on an SVGElement that property is a
+  // read only SVGAnimatedString, and assigning a string to it does nothing at
+  // all rather than failing.
+  svg.setAttribute('class', className);
+  svg.setAttribute('viewBox', '0 0 20 20');
+  svg.setAttribute('aria-hidden', 'true');
+  svg.appendChild(document.createElementNS(SVG_NS, 'path'));
+  return svg;
+}
+
+/**
+ * Points an existing path at a shape.
+ *
+ * Every attribute the other branch sets is cleared here, because a recycled row
+ * that goes from a stroked glyph to a filled one keeps whatever the last one
+ * left behind.
+ */
+export function drawPath(path: Element, d: string, stroke: Stroke): void {
+  path.setAttribute('d', d);
+  if (stroke.stroked) {
+    path.setAttribute('fill', 'none');
+    path.setAttribute('stroke', 'currentColor');
+    path.setAttribute('stroke-width', String(stroke.width ?? 1.6));
+    path.setAttribute('stroke-linejoin', 'round');
+    path.setAttribute('stroke-linecap', 'round');
+  } else {
+    path.setAttribute('fill', 'currentColor');
+    path.removeAttribute('stroke');
+    path.removeAttribute('stroke-width');
+    path.removeAttribute('stroke-linejoin');
+    path.removeAttribute('stroke-linecap');
+  }
+}
+
+/** A finished glyph, for the places that draw one and never change it. */
+export function glyph(
+    className: string, d: string, stroke: Stroke): SVGElement {
+  const svg = glyphElement(className);
+  drawPath(svg.firstElementChild!, d, stroke);
+  return svg;
+}
