From 7fb8a3d337c178cc5e5b7cf752c6117182b57639 Mon Sep 17 00:00:00 2001
From: Cameron Payne <cameron.paynevmware@gmail.com>
Date: Fri, 21 Aug 2026 14:05:21 -0500
Subject: Disable firmware and device checks for generic AuraDE hosts


diff --git a/ash/shell.cc b/ash/shell.cc
index fdaeceeb32a120be68aba15abdaf028338284879..505d705f04c4d4621ee621ee98ba41d8d41c3463 100644
--- a/ash/shell.cc
+++ b/ash/shell.cc
@@ -2103,24 +2103,9 @@ void Shell::OnFirstSessionStarted() {
 }
 
 void Shell::OnFirstSessionReady() {
-  // Initialize the fwupd (firmware updater) DBus client only when the user
-  // session is active. Since the fwupd service is only relevant during an
-  // active user session, this prevents a bug in which the service would start
-  // up earlier than expected and causes a delay during boot.
-  // See b/250002264 for more details.
-  if (!FwupdClient::Get() && !firmware_update_notification_controller_ &&
-      !features::IsBlockFwupdClientEnabled()) {
-    chromeos::InitializeDBusClient<FwupdClient>(dbus_bus_.get());
-    firmware_update_manager_ = std::make_unique<FirmwareUpdateManager>();
-    // The notification controller is registered as an observer before
-    // requesting updates to allow a notification to be shown if a critical
-    // firmware update is found.
-    firmware_update_notification_controller_ =
-        std::make_unique<FirmwareUpdateNotificationController>(
-            message_center::MessageCenter::Get());
-    firmware_update_manager_->RequestAllUpdates(
-        FirmwareUpdateManager::Source::kStartup);
-  }
+  // HACK(AuraDE): FirmwareUpdateManager removed for standalone Ash on generic
+  // Linux. ChromeOS firmware update DBus service does not exist on standard
+  // PCs. TODO: Re-enable with a stub or desktop-appropriate firmware check.
 }
 
 void Shell::OnSessionStateChanged(session_manager::SessionState state) {
diff --git a/chromeos/constants/devicetype.cc b/chromeos/constants/devicetype.cc
index be187d587bd562e58a7665b8277051fe9e2221c4..b308d9dd3dc84851d82d70b5a7c2a2cb26898092 100644
--- a/chromeos/constants/devicetype.cc
+++ b/chromeos/constants/devicetype.cc
@@ -41,12 +41,10 @@ DeviceType GetDeviceType() {
     return DeviceType::kChromebit;
   if (value == "CHROMEBOX")
     return DeviceType::kChromebox;
-  // Don't log errors for VMs, which are type "OTHER".
-  if (value == "OTHER") {
-    return DeviceType::kUnknown;
-  }
-  LOG(ERROR) << "Unknown device type \"" << value << "\"";
-  return DeviceType::kUnknown;
+  // AuraDE compatibility: Default to Chromebook for generic Linux so Ash UI
+  // remains active. ChromeOS normally reads the device type from ChromeOS
+  // firmware/BIOS, which does not exist on standard Linux hardware.
+  return DeviceType::kChromebook;
 }
 
