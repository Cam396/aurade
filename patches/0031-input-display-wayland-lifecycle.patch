+void WaylandEventSource::OnSwipeEvent(EventType event_type,
+                                      const gfx::Vector2dF& delta,
+                                      uint32_t finger_count,
+                                      base::TimeTicks timestamp,
+                                      int device_id) {
+  // AuraDE compatibility: Weston owns libinput, so Ash cannot consume its
+  // native gesture stream. Preserve compositor three and four-finger swipes as
+  // the same finger-counted scroll events emitted by ChromeOS evdev.
+  ScrollEvent event(event_type, pointer_location_, pointer_location_, timestamp,
+                    pointer_flags_, delta.x(), delta.y(), delta.x(), delta.y(),
+                    finger_count);
+  event.set_source_device_id(device_id);
+
+  auto* target = window_manager_->GetCurrentPointerFocusedWindow();
+  if (!target) {
+    return;
+  }
+  SetTargetAndDispatchEvent(&event, target);
+}
