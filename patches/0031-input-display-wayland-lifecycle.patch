+TEST_F(WaylandPointerGesturesTest, SwipePreservesFingerCount) {
+  EnterPoint();
+
+  std::unique_ptr<Event> update_event;
+  std::unique_ptr<Event> end_event;
+  EXPECT_CALL(delegate_, DispatchEvent(testing::_))
+      .Times(2)
+      .WillOnce(CloneEvent(&update_event))
+      .WillOnce(CloneEvent(&end_event));
+
+  PostToServerAndWait([surface_id = window_->root_surface()->get_surface_id()](
+                          wl::TestWaylandServerThread* server) {
+    auto* const swipe = server->wp_pointer_gestures().swipe()->resource();
+    auto* const surface =
+        server->GetObject<wl::MockSurface>(surface_id)->resource();
+    zwp_pointer_gesture_swipe_v1_send_begin(swipe, server->GetNextSerial(),
+                                            server->GetNextTime(), surface,
+                                            /*fingers=*/3);
+    zwp_pointer_gesture_swipe_v1_send_update(swipe, server->GetNextTime(),
+                                             wl_fixed_from_int(12),
+                                             wl_fixed_from_int(-7));
+    zwp_pointer_gesture_swipe_v1_send_end(swipe, server->GetNextSerial(),
+                                          server->GetNextTime(),
+                                          /*cancelled=*/0);
+  });
+
+  ASSERT_TRUE(update_event);
+  ASSERT_TRUE(update_event->IsScrollEvent());
+  EXPECT_EQ(EventType::kScroll, update_event->type());
+  EXPECT_EQ(3, update_event->AsScrollEvent()->finger_count());
+  EXPECT_EQ(12.0f, update_event->AsScrollEvent()->x_offset());
+  EXPECT_EQ(-7.0f, update_event->AsScrollEvent()->y_offset());
+
+  ASSERT_TRUE(end_event);
+  ASSERT_TRUE(end_event->IsScrollEvent());
+  EXPECT_EQ(EventType::kScrollFlingStart, end_event->type());
+  EXPECT_EQ(3, end_event->AsScrollEvent()->finger_count());
+}
