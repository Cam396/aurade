+constexpr char kAuraManagedInputEnv[] = "AURADE_ENABLE_WESTON_INPUT_SETTINGS";
+constexpr char kWestonConfigPath[] = ".config/weston.ini";
+
+bool IsAuraManagedInputEnabled() {
+  auto env = base::Environment::Create();
+  const std::optional<std::string> enabled = env->GetVar(kAuraManagedInputEnv);
+  return enabled && *enabled == "1";
+}
+
+std::string BoolValue(bool value) {
+  return value ? "true" : "false";
+}
+
+std::string BuildUpdatedWestonInputConfig(
+    const std::string& original,
+    const std::map<std::string, std::string>& settings) {
+  const std::vector<std::string> lines = base::SplitString(
+      original, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::vector<std::string> output;
+  bool in_libinput_section = false;
+  bool saw_libinput_section = false;
+  std::map<std::string, bool> wrote_setting;
+  for (const auto& [key, value] : settings) {
+    wrote_setting[key] = false;
+  }
+
+  auto finish_section = [&]() {
+    if (!in_libinput_section) {
+      return;
+    }
+    for (const auto& [key, value] : settings) {
+      if (!wrote_setting[key]) {
+        output.push_back(key + "=" + value);
+        wrote_setting[key] = true;
+      }
+    }
+  };
+
+  for (const std::string& line : lines) {
+    std::string trimmed;
+    base::TrimWhitespaceASCII(line, base::TRIM_ALL, &trimmed);
+    if (trimmed.starts_with("[") && trimmed.ends_with("]")) {
+      finish_section();
+      in_libinput_section = trimmed == "[libinput]";
+      saw_libinput_section |= in_libinput_section;
+      output.push_back(line);
+      continue;
+    }
+
+    if (in_libinput_section) {
+      const size_t separator = trimmed.find('=');
+      const std::string key = separator == std::string::npos
+                                  ? std::string()
+                                  : trimmed.substr(0, separator);
+      const auto replacement = settings.find(key);
+      if (replacement != settings.end()) {
+        output.push_back(key + "=" + replacement->second);
+        wrote_setting[key] = true;
+        continue;
+      }
+    }
+    output.push_back(line);
+  }
+  finish_section();
+
+  if (!saw_libinput_section) {
+    if (!output.empty() && !output.back().empty()) {
+      output.push_back(std::string());
+    }
+    output.push_back("[libinput]");
+    for (const auto& [key, value] : settings) {
+      output.push_back(key + "=" + value);
+    }
+  }
+  return base::JoinString(output, "\n") + "\n";
+}
+
+void PersistAuraTouchpadSettingsOnBlockingThread(
+    std::map<std::string, std::string> weston_settings) {
+  auto env = base::Environment::Create();
+  const std::optional<std::string> home = env->GetVar("HOME");
+  if (!home || home->empty()) {
+    return;
+  }
+  const base::FilePath config_path =
+      base::FilePath(*home).Append(kWestonConfigPath);
+  if (!base::CreateDirectory(config_path.DirName())) {
+    return;
+  }
+
+  std::string original;
+  base::ReadFileToString(config_path, &original);
+  // AuraDE compatibility: Weston owns libinput in a nested Wayland session.
+  // Persist Ash touchpad preferences into the compositor configuration that
+  // the session wrapper consumes on the next compositor start.
+  base::ImportantFileWriter::WriteFileAtomically(
+      config_path, BuildUpdatedWestonInputConfig(original, weston_settings));
+}
+
+scoped_refptr<base::SequencedTaskRunner> GetAuraInputWriter() {
+  static const base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>>
+      writer(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+  return *writer;
+}
+
+void PersistAuraTouchpadSettings(const TouchpadSettings& settings) {
+  if (!IsAuraManagedInputEnabled()) {
+    return;
+  }
+
+  std::map<std::string, std::string> weston_settings;
+  if (settings.IsTapToClickSet()) {
+    weston_settings["enable-tap"] = BoolValue(settings.GetTapToClick());
+  }
+  if (settings.IsTapDraggingSet()) {
+    weston_settings["tap-and-drag"] = BoolValue(settings.GetTapDragging());
+  }
+  if (settings.IsNaturalScrollSet()) {
+    weston_settings["natural-scroll"] = BoolValue(settings.GetNaturalScroll());
+  }
+  if (settings.IsAccelerationSet()) {
+    weston_settings["accel-profile"] =
+        settings.GetAcceleration() ? "adaptive" : "flat";
+  }
+  if (settings.IsSensitivitySet()) {
+    const double normalized =
+        std::clamp((settings.GetSensitivity() - 3) / 2.0, -1.0, 1.0);
+    weston_settings["accel-speed"] = base::NumberToString(normalized);
+  }
+  if (weston_settings.empty()) {
+    return;
+  }
+
+  GetAuraInputWriter()->PostTask(
+      FROM_HERE, base::BindOnce(&PersistAuraTouchpadSettingsOnBlockingThread,
+                                std::move(weston_settings)));
+}
