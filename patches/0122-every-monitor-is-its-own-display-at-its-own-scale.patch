+void AuraDisplaySource::OnMouseEvent(ui::MouseEvent* event) {
+  if (event->type() != ui::EventType::kMouseMoved &&
+      event->type() != ui::EventType::kMouseDragged) {
+    return;
+  }
+  // Ash only moves the cursor to another display when it warps it there
+  // itself. Here the compositor moves it, so follow it: the cursor is drawn
+  // for the scale of the display it is on.
+  if (!Shell::HasInstance() || !Shell::Get()->cursor_manager()) {
+    return;
+  }
+  Shell* shell = Shell::Get();
+  const display::Display display =
+      display::Screen::Get()->GetDisplayNearestPoint(
+          aura::Env::GetInstance()->last_mouse_location());
+  if (display.is_valid() &&
+      shell->cursor_manager()->GetDisplay().id() != display.id()) {
+    shell->cursor_manager()->SetDisplay(display);
+  }
+}
+
+void AuraDisplaySource::ReadConfig(const std::string& text) {
+  for (const std::string& line : base::SplitString(
+           text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (line.starts_with("#")) {
+      continue;
+    }
+    const size_t separator = line.find('=');
+    if (separator == std::string::npos) {
+      continue;
+    }
+    const std::string key(
+        base::TrimWhitespaceASCII(line.substr(0, separator), base::TRIM_ALL));
+    double value = 0;
+    if (!base::StringToDouble(
+            base::TrimWhitespaceASCII(line.substr(separator + 1),
+                                      base::TRIM_ALL),
+            &value)) {
+      continue;
+    }
+    if (key == kScaleKey) {
+      legacy_scale_ = NormalizeScale(value);
+    } else if (key.starts_with(kMonitorScalePrefix)) {
+      saved_scales_[key.substr(
+          std::char_traits<char>::length(kMonitorScalePrefix))] =
+          NormalizeScale(value);
+    }
+  }
+}
+
+bool AuraDisplaySource::RefreshMonitors() {
+  std::vector<Monitor> monitors;
+  for (const display::Display& display : platform_screen_->GetAllDisplays()) {
+    Monitor monitor;
+    monitor.platform_id = display.id();
+    if (const std::optional<ui::PlatformScreen::OutputInfo> info =
+            platform_screen_->GetOutputInfo(display.id())) {
+      monitor.connector = info->name;
+      monitor.make = info->make;
+      monitor.model = info->model;
+      monitor.size_mm = gfx::Size(info->width_mm, info->height_mm);
+      if (info->refresh_millihertz > 0) {
+        monitor.refresh_rate = info->refresh_millihertz / 1000.f;
+      }
+    }
+    if (monitor.connector.empty()) {
+      monitor.connector = base::StringPrintf("output-%zu", monitors.size() + 1);
+    }
+    monitor.bounds_in_pixels =
+        gfx::Rect(display.bounds().origin(), display.GetSizeInPixel());
+    monitor.internal = IsInternalConnector(monitor.connector);
+    monitor.key = MonitorKey(monitor);
+    monitor.recommended_scale = RecommendScale(
+        monitor.bounds_in_pixels.size(), monitor.size_mm, monitor.internal);
+    auto saved = saved_scales_.find(monitor.key);
+    monitor.scale = saved != saved_scales_.end()
+                        ? saved->second
+                        : legacy_scale_.value_or(monitor.recommended_scale);
+    monitors.push_back(std::move(monitor));
+  }
+
+  // The laptop's own panel first, then left to right as the compositor has
+  // them, so the first display Ash is given is the one it should make
+  // primary when it has no arrangement saved for this set of monitors.
+  std::ranges::stable_sort(monitors, [](const Monitor& a, const Monitor& b) {
+    return std::make_tuple(!a.internal, a.bounds_in_pixels.x(),
+                           a.bounds_in_pixels.y()) <
+           std::make_tuple(!b.internal, b.bounds_in_pixels.x(),
+                           b.bounds_in_pixels.y());
+  });
+
+  // Two outputs whose connectors give the same index, on two graphics
+  // cards, say, take the next free one.
+  std::set<uint8_t> used_indices;
+  for (Monitor& monitor : monitors) {
+    uint8_t index = ConnectorIndex(monitor.connector);
+    while (!used_indices.insert(index).second) {
+      ++index;
+    }
+    monitor.display_id = MonitorDisplayId(monitor.key, index);
+  }
+
+  auto same = [](const Monitor& a, const Monitor& b) {
+    return a.platform_id == b.platform_id && a.display_id == b.display_id &&
+           a.bounds_in_pixels == b.bounds_in_pixels && a.scale == b.scale &&
+           a.refresh_rate == b.refresh_rate;
+  };
+  const bool changed = !std::ranges::equal(monitors, monitors_, same);
+  monitors_ = std::move(monitors);
+  return changed;
+}
+
+display::ManagedDisplayInfo AuraDisplaySource::BuildDisplayInfo(
+    const Monitor& monitor) const {
+  display::ManagedDisplayInfo info(monitor.display_id, MonitorName(monitor),
+                                   /*has_overscan=*/false);
+  const gfx::Size size = monitor.bounds_in_pixels.size();
+  info.SetBounds(monitor.bounds_in_pixels);
+  // The scale is the display's own device scale factor, which 0027's root
+  // window transformer applies, and display zoom stays at 100%.
+  info.set_device_scale_factor(monitor.scale);
+  info.set_zoom_factor(1.f);
+  info.AddZoomFactorForSize(size.ToString(), 1.f);
+  info.set_refresh_rate(monitor.refresh_rate);
+  info.SetManagedDisplayModes({display::ManagedDisplayMode(
+      size, monitor.refresh_rate, /*is_interlaced=*/false, /*native=*/true,
+      monitor.scale)});
+  info.set_native(true);
+  info.set_from_native_platform(true);
+  info.set_connection_type(monitor.internal
+                               ? display::DISPLAY_CONNECTION_TYPE_INTERNAL
+                               : display::DISPLAY_CONNECTION_TYPE_UNKNOWN);
+  if (display::IsDisplaySizeValid(monitor.size_mm)) {
+    info.set_physical_size(monitor.size_mm);
+    info.set_device_dpi(display::kInchInMm * size.width() /
+                        monitor.size_mm.width());
+  }
+  return info;
+}
+
+void AuraDisplaySource::ApplyToDisplayManager() {
+  if (monitors_.empty()) {
+    return;
+  }
+  base::flat_set<int64_t> internal_ids;
+  display::DisplayInfoList infos;
+  for (const Monitor& monitor : monitors_) {
+    if (monitor.internal) {
+      internal_ids.insert(monitor.display_id);
+    }
+    infos.push_back(BuildDisplayInfo(monitor));
+    LOG(WARNING) << "Display " << monitor.display_id << " is "
+                 << monitor.connector << " (" << monitor.make << " "
+                 << monitor.model << ") "
+                 << monitor.bounds_in_pixels.ToString() << " "
+                 << monitor.size_mm.ToString() << "mm at scale "
+                 << monitor.scale << ", recommended "
+                 << monitor.recommended_scale;
+  }
+  display::SetInternalDisplayIds(std::move(internal_ids));
+  display_manager_->OnNativeDisplaysChanged(infos);
+}
+
+void AuraDisplaySource::OnOutputsChanged() {
+  if (RefreshMonitors()) {
+    ApplyToDisplayManager();
+  }
+}
+
+void AuraDisplaySource::PlaceHosts() {
+  if (!Shell::HasInstance() || !Shell::Get()->window_tree_host_manager()) {
+    return;
+  }
+  Shell* shell = Shell::Get();
+  std::map<gfx::AcceleratedWidget, int64_t> placed;
+  for (const Monitor& monitor : monitors_) {
+    AshWindowTreeHost* ash_host =
+        shell->window_tree_host_manager()->GetAshWindowTreeHostForDisplayId(
+            monitor.display_id);
+    if (!ash_host) {
+      continue;
+    }
+    // Every Ash host on Ozone is a WindowTreeHostPlatform, the mirroring
+    // and unified ones included.
+    auto* host =
+        static_cast<aura::WindowTreeHostPlatform*>(ash_host->AsWindowTreeHost());
+    if (!host->platform_window()) {
+      continue;
+    }
+    // A host's compositor takes up its display's scale only when the
+    // platform window reports new bounds, and a monitor whose scale changes
+    // keeps its size, so the host is told to look again.
+    display::Display display;
+    if (display::Screen::Get()->GetDisplayWithDisplayId(monitor.display_id,
+                                                        &display) &&
+        host->compositor()->device_scale_factor() !=
+            display.device_scale_factor()) {
+      static_cast<ui::PlatformWindowDelegate*>(host)->OnBoundsChanged(
+          ui::PlatformWindowDelegate::BoundsChange(/*origin_changed=*/false));
+    }
+    const gfx::AcceleratedWidget widget = host->GetAcceleratedWidget();
+    placed[widget] = monitor.platform_id;
+    auto it = placed_hosts_.find(widget);
+    if (it != placed_hosts_.end() && it->second == monitor.platform_id) {
+      continue;
+    }
+    host->platform_window()->SetFullscreen(true, monitor.platform_id);
+  }
+  placed_hosts_ = std::move(placed);
+}
+
+void AuraDisplaySource::WriteLayout() {
+  // One line per display Ash shows: the connector, then where Ash has the
+  // display in its logical coordinates.
+  std::string text;
+  for (const Monitor& monitor : monitors_) {
+    display::Display display;
+    if (!display::Screen::Get()->GetDisplayWithDisplayId(monitor.display_id,
+                                                         &display)) {
+      continue;
+    }
+    const gfx::Rect bounds = display.bounds();
+    text += base::StringPrintf("%s %d %d %d %d\n", monitor.connector.c_str(),
+                               bounds.x(), bounds.y(), bounds.width(),
+                               bounds.height());
+  }
+  if (text.empty() || text == last_layout_) {
+    return;
+  }
+  last_layout_ = text;
+  file_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WriteFileOnBlockingThread, GetLayoutPath(), text));
+}
+
+void AuraDisplaySource::SaveScales(std::map<std::string, float> scales) {
+  file_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&SaveScalesOnBlockingThread, GetConfigPath(),
+                                std::move(scales)));
+}
+
+}  // namespace ash
