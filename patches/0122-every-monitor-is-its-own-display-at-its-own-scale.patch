+std::optional<PlatformScreen::OutputInfo> WaylandScreen::GetOutputInfo(
+    int64_t display_id) const {
+  if (!connection_) {
+    return std::nullopt;
+  }
+  for (const auto& [output_id, id] : display_id_map_) {
+    if (id != display_id) {
+      continue;
+    }
+    const WaylandOutput* output =
+        connection_->wayland_output_manager()->GetOutput(output_id);
+    if (!output) {
+      return std::nullopt;
+    }
+    const WaylandOutput::Metrics& metrics = output->GetMetrics();
+    OutputInfo info;
+    info.name = metrics.name;
+    info.make = metrics.make;
+    info.model = metrics.model;
+    info.width_mm = metrics.physical_size_mm.width();
+    info.height_mm = metrics.physical_size_mm.height();
+    info.refresh_millihertz = metrics.refresh_millihertz;
+    return info;
+  }
+  return std::nullopt;
+}
