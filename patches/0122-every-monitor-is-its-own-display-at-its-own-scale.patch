+AuraDisplaySource* g_instance = nullptr;
+
+constexpr char kDisplaysEnv[] = "AURADE_DISPLAYS";
+constexpr char kConfigTextEnv[] = "AURADE_DISPLAY_CONF_TEXT";
+constexpr char kLegacyScaleEnv[] = "AURADE_DISPLAY_SCALE";
+constexpr char kScaleKey[] = "scale";
+constexpr char kMonitorScalePrefix[] = "scale.";
+constexpr float kMinScale = 1.f;
+constexpr float kMaxScale = 3.f;
+constexpr float kScaleStep = 0.25f;
+// Logical pixels per inch a monitor aims for, near the eyes and further off.
+constexpr float kNearTargetDpi = 135.f;
+constexpr float kFarTargetDpi = 110.f;
+constexpr float kNearMonitorMaxInches = 20.f;
+constexpr float kMinLogicalHeight = 720.f;
+
+std::optional<std::string> GetEnv(base::cstring_view name) {
+  return base::Environment::Create()->GetVar(name);
+}
+
+float NormalizeScale(double scale) {
+  if (!std::isfinite(scale)) {
+    return kMinScale;
+  }
+  return std::clamp(static_cast<float>(scale), kMinScale, kMaxScale);
+}
+
+std::string FormatScale(float scale) {
+  return base::NumberToString(std::round(scale * 100.f) / 100.f);
+}
+
+base::FilePath GetConfigPath() {
+  const std::optional<std::string> config_home = GetEnv("XDG_CONFIG_HOME");
+  if (config_home && !config_home->empty()) {
+    return base::FilePath(*config_home).Append("aurade/display.conf");
+  }
+  const std::optional<std::string> home = GetEnv("HOME");
+  if (!home || home->empty()) {
+    return base::FilePath();
+  }
+  return base::FilePath(*home).Append(".config/aurade/display.conf");
+}
+
+base::FilePath GetLayoutPath() {
+  const std::optional<std::string> runtime_dir = GetEnv("XDG_RUNTIME_DIR");
+  if (!runtime_dir || runtime_dir->empty()) {
+    return base::FilePath();
+  }
+  return base::FilePath(*runtime_dir).Append("aurade/display-layout");
+}
+
+bool IsKnownString(const std::string& value) {
+  return !value.empty() && !base::EqualsCaseInsensitiveASCII(value, "unknown");
+}
+
+std::string MonitorKey(const AuraDisplaySource::Monitor& monitor) {
+  std::string key = monitor.connector + "/" + monitor.make + "/" + monitor.model;
+  for (char& c : key) {
+    if (c == '=' || c == '\n' || c == '\r' || c == '\t') {
+      c = '_';
+    }
+  }
+  return std::string(base::TrimWhitespaceASCII(key, base::TRIM_ALL));
+}
+
+// Ash sorts displays by the low byte of their ids, takes the first as the
+// primary display when no arrangement is saved, and requires the bytes to
+// differ, as ChromeOS keeps the connector's index there. This orders
+// connectors the way a graphics card lists them: the laptop's panel, then
+// DisplayPort, HDMI, DVI and VGA, each by its number.
+uint8_t ConnectorIndex(const std::string& connector) {
+  static constexpr std::pair<std::string_view, uint8_t> kTypes[] = {
+      {"eDP", 0x00},   {"LVDS", 0x00},   {"DSI", 0x00}, {"DP", 0x20},
+      {"HDMI", 0x40},  {"DVI", 0x60},    {"VGA", 0x80}, {"USB", 0xA0},
+      {"Virtual", 0xC0},
+  };
+  uint8_t type = 0xE0;
+  for (const auto& [prefix, value] : kTypes) {
+    if (connector.starts_with(prefix)) {
+      type = value;
+      break;
+    }
+  }
+  unsigned number = 0;
+  const size_t dash = connector.rfind('-');
+  if (dash == std::string::npos ||
+      !base::StringToUint(std::string_view(connector).substr(dash + 1),
+                          &number)) {
+    number = base::PersistentHash(connector);
+  }
+  return type | (number & 0x1F);
+}
+
+int64_t MonitorDisplayId(const std::string& key, uint8_t index) {
+  // A positive id well clear of the ones Ash makes up for its default
+  // display, the same for a monitor on the same connector every session.
+  return (int64_t{0x7A} << 40) |
+         (int64_t{base::PersistentHash(key)} << 8) | index;
+}
+
+std::string MonitorName(const AuraDisplaySource::Monitor& monitor) {
+  if (monitor.internal) {
+    return l10n_util::GetStringUTF8(IDS_DISPLAY_NAME_INTERNAL);
+  }
+  if (IsKnownString(monitor.model)) {
+    return monitor.model;
+  }
+  if (IsKnownString(monitor.make)) {
+    return monitor.make + " (" + monitor.connector + ")";
+  }
+  return monitor.connector;
+}
+
+void WriteFileOnBlockingThread(base::FilePath path, std::string text) {
+  if (path.empty() || !base::CreateDirectory(path.DirName())) {
+    return;
+  }
+  if (!base::ImportantFileWriter::WriteFileAtomically(path, text)) {
+    LOG(WARNING) << "Could not write " << path.value();
+  }
+}
+
+void SaveScalesOnBlockingThread(base::FilePath path,
+                                std::map<std::string, float> scales) {
+  if (path.empty()) {
+    return;
+  }
+  std::string text;
+  base::ReadFileToString(path, &text);
+  WriteFileOnBlockingThread(path,
+                            AuraDisplaySource::UpdateConfig(text, scales));
+}
