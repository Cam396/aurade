+// On a Linux host Ash is a client of a Wayland compositor, which owns the
+// monitors, and nothing else tells Ash what they are. This builds Ash's
+// displays out of the compositor's outputs: one display per monitor, with an
+// id that stays the same from one session to the next, its own scale and the
+// monitor's own name. It keeps them current as monitors come and go, puts
+// each display's host window on its monitor, and writes where Ash has
+// arranged the displays for the compositor's shell, so the pointer crosses
+// from one monitor to the next where Ash's arrangement has them meet.
+class ASH_EXPORT AuraDisplaySource : public display::DisplayObserver,
+                                     public display::DisplayManagerObserver,
+                                     public ui::EventHandler {
+ public:
+  // One monitor, as the compositor reports it.
+  struct Monitor {
+    Monitor();
+    Monitor(const Monitor&);
+    Monitor& operator=(const Monitor&);
+    ~Monitor();
+
+    // The compositor's id for the output, and Ash's for the display.
+    int64_t platform_id = display::kInvalidDisplayId;
+    int64_t display_id = display::kInvalidDisplayId;
+    // The connector, "eDP-1", and what the monitor says it is.
+    std::string connector;
+    std::string make;
+    std::string model;
+    // Where the compositor has the output, in its pixels.
+    gfx::Rect bounds_in_pixels;
+    gfx::Size size_mm;
+    float refresh_rate = 60.f;
+    bool internal = false;
+    // The scale the monitor gets when nobody has chosen one, and the one it
+    // has.
+    float recommended_scale = 1.f;
+    float scale = 1.f;
+    // What the monitor's scale is saved under in display.conf.
+    std::string key;
+  };
+
+  // Whether Ash takes its displays from the compositor: on a Linux host,
+  // under Ozone/Wayland, unless AURADE_DISPLAYS=single asks for the single
+  // display Ash had before or --ash-host-window-bounds lays the hosts out.
+  static bool ShouldUse();
+
+  // The instance, or null when Ash takes its displays from somewhere else.
+  static AuraDisplaySource* Get();
+
+  // Creates the instance and hands Ash the compositor's monitors. Returns
+  // false when the compositor has reported none yet, in which case Ash
+  // starts on its default display and the monitors replace it when they
+  // arrive.
+  static bool Start(display::DisplayManager* display_manager);
+  static void Shutdown();
+
+  AuraDisplaySource(const AuraDisplaySource&) = delete;
+  AuraDisplaySource& operator=(const AuraDisplaySource&) = delete;
+
+  const std::vector<Monitor>& monitors() const { return monitors_; }
+  const Monitor* GetMonitor(int64_t display_id) const;
+
+  // Sets the scale of a display, now and for the sessions after this one.
+  // Returns false for a display this does not know or a scale out of range.
+  bool SetScale(int64_t display_id, float scale);
+
+  // The scales Settings offers, from 100% to 300% in quarter steps.
+  static std::vector<float> GetScaleOptions();
+
+  // The scale a monitor gets when nobody has chosen one. It aims for about
+  // 135 pixels per inch of logical size on a laptop panel or a monitor under
+  // 20 inches across, which sit near the eyes, and about 110 on anything
+  // larger. It rounds to a quarter step, never goes under 100%, and stops
+  // short of leaving the desktop less than 720 logical pixels tall. A monitor
+  // that reports no size, or one that cannot be right, gets 100%.
+  static float RecommendScale(const gfx::Size& pixels,
+                              const gfx::Size& size_mm,
+                              bool internal);
+
+  // Whether a connector name is a laptop's own panel.
+  static bool IsInternalConnector(const std::string& connector);
+
+  // The text of display.conf with |scales| saved, keyed as Monitor::key.
+  // Lines it does not own are kept. The single "scale=" of older sessions
+  // is dropped, since every monitor that used it is given a line of its own.
+  static std::string UpdateConfig(const std::string& text,
+                                  const std::map<std::string, float>& scales);
+
+  // display::DisplayObserver, for the compositor's outputs:
+  void OnDisplayAdded(const display::Display& display) override;
+  void OnDisplaysRemoved(const display::Displays& displays) override;
+  void OnDisplayMetricsChanged(const display::Display& display,
+                               uint32_t changed_metrics) override;
+
+  // display::DisplayManagerObserver, for Ash's displays:
+  void OnDisplaysInitialized() override;
+  void OnDidApplyDisplayChanges() override;
+
+  // ui::EventHandler:
+  void OnMouseEvent(ui::MouseEvent* event) override;
+
+ private:
+  explicit AuraDisplaySource(display::DisplayManager* display_manager);
+  ~AuraDisplaySource() override;
+
+  void ReadConfig(const std::string& text);
+  // Rebuilds |monitors_| from the compositor's outputs. Returns whether
+  // anything Ash cares about changed.
+  bool RefreshMonitors();
+  display::ManagedDisplayInfo BuildDisplayInfo(const Monitor& monitor) const;
+  void ApplyToDisplayManager();
+  void OnOutputsChanged();
+  // Puts each display's host window on its monitor.
+  void PlaceHosts();
+  // Writes Ash's arrangement for the compositor's shell.
+  void WriteLayout();
+  void SaveScales(std::map<std::string, float> scales);
+
+  raw_ptr<display::DisplayManager> display_manager_;
+  std::unique_ptr<ui::PlatformScreen> platform_screen_;
+  std::vector<Monitor> monitors_;
+
+  // Scales from display.conf by monitor key, and the single scale older
+  // sessions saved, which a monitor without a line of its own still uses.
+  std::map<std::string, float> saved_scales_;
+  std::optional<float> legacy_scale_;
+
+  // The output each host window was last put on, by its widget.
+  std::map<gfx::AcceleratedWidget, int64_t> placed_hosts_;
+  std::string last_layout_;
+
+  scoped_refptr<base::SequencedTaskRunner> file_task_runner_;
+  base::WeakPtrFactory<AuraDisplaySource> weak_factory_{this};
+};
