+// static
+bool AuraDisplaySource::ShouldUse() {
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return false;
+  }
+  if (GetEnv(kDisplaysEnv).value_or(std::string()) == "single") {
+    return false;
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kHostWindowBounds)) {
+    return false;
+  }
+  return ui::OzonePlatform::IsInitialized() &&
+         ui::OzonePlatform::GetPlatformNameForTest() == "wayland";
+}
+
+// static
+AuraDisplaySource* AuraDisplaySource::Get() {
+  return g_instance;
+}
+
+// static
+bool AuraDisplaySource::Start(display::DisplayManager* display_manager) {
+  CHECK(!g_instance);
+  g_instance = new AuraDisplaySource(display_manager);
+  if (g_instance->monitors_.empty()) {
+    LOG(WARNING) << "The compositor has reported no outputs yet";
+    return false;
+  }
+  g_instance->ApplyToDisplayManager();
+  return true;
+}
+
+// static
+void AuraDisplaySource::Shutdown() {
+  delete g_instance;
+  g_instance = nullptr;
+}
+
+AuraDisplaySource::AuraDisplaySource(display::DisplayManager* display_manager)
+    : display_manager_(display_manager),
+      file_task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  // The compositor's outputs, through the same screen a Chrome browser on a
+  // Wayland desktop uses. Ash keeps its own display::Screen; this one is
+  // only read here, and it also lets a host window go fullscreen on a chosen
+  // output.
+  platform_screen_ = ui::OzonePlatform::GetInstance()->CreateScreen();
+  ui::OzonePlatform::GetInstance()->InitScreen(platform_screen_.get());
+  platform_screen_->AddObserver(this);
+
+  // Files cannot be read this early in Ash's start, so the launcher hands
+  // over display.conf's text.
+  ReadConfig(GetEnv(kConfigTextEnv).value_or(std::string()));
+  // One scale for the whole session, which the launcher takes from an older
+  // display.conf unless the environment gives one, counts for every monitor
+  // without a scale of its own.
+  const std::optional<std::string> session_scale = GetEnv(kLegacyScaleEnv);
+  double session_scale_value = 0;
+  if (session_scale &&
+      base::StringToDouble(*session_scale, &session_scale_value)) {
+    legacy_scale_ = NormalizeScale(session_scale_value);
+  }
+  RefreshMonitors();
+
+  display_manager_->AddDisplayManagerObserver(this);
+  aura::Env::GetInstance()->AddPreTargetHandler(
+      this, ui::EventTarget::Priority::kSystem);
+
+  // The host windows are made after the displays, later in Shell::Init().
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AuraDisplaySource::PlaceHosts,
+                                weak_factory_.GetWeakPtr()));
+}
+
+AuraDisplaySource::~AuraDisplaySource() {
+  aura::Env::GetInstance()->RemovePreTargetHandler(this);
+  display_manager_->RemoveDisplayManagerObserver(this);
+  platform_screen_->RemoveObserver(this);
+}
+
+const AuraDisplaySource::Monitor* AuraDisplaySource::GetMonitor(
+    int64_t display_id) const {
+  for (const Monitor& monitor : monitors_) {
+    if (monitor.display_id == display_id) {
+      return &monitor;
+    }
+  }
+  return nullptr;
+}
+
+bool AuraDisplaySource::SetScale(int64_t display_id, float scale) {
+  if (!std::isfinite(scale) || scale < kMinScale || scale > kMaxScale) {
+    return false;
+  }
+  auto it = std::ranges::find(monitors_, display_id, &Monitor::display_id);
+  if (it == monitors_.end()) {
+    return false;
+  }
+
+  // Saving a scale for one monitor drops the single scale older sessions
+  // kept, so every other monitor still using it is saved with it too.
+  std::map<std::string, float> to_save;
+  if (legacy_scale_) {
+    for (const Monitor& monitor : monitors_) {
+      if (!saved_scales_.contains(monitor.key)) {
+        to_save[monitor.key] = *legacy_scale_;
+        saved_scales_[monitor.key] = *legacy_scale_;
+      }
+    }
+    legacy_scale_.reset();
+  }
+  to_save[it->key] = scale;
+  saved_scales_[it->key] = scale;
+  SaveScales(std::move(to_save));
+
+  RefreshMonitors();
+  ApplyToDisplayManager();
+  return true;
+}
+
+// static
+std::vector<float> AuraDisplaySource::GetScaleOptions() {
+  std::vector<float> options;
+  for (float scale = kMinScale; scale <= kMaxScale + 0.001f;
+       scale += kScaleStep) {
+    options.push_back(scale);
+  }
+  return options;
+}
+
+// static
+float AuraDisplaySource::RecommendScale(const gfx::Size& pixels,
+                                        const gfx::Size& size_mm,
+                                        bool internal) {
+  if (pixels.IsEmpty() || !display::IsDisplaySizeValid(size_mm)) {
+    return kMinScale;
+  }
+  const float dpi_x = display::kInchInMm * pixels.width() / size_mm.width();
+  const float dpi_y = display::kInchInMm * pixels.height() / size_mm.height();
+  // A size giving the two directions very different densities, or a density
+  // no monitor has, is not the monitor's real size.
+  if (dpi_x < 50.f || dpi_x > 600.f ||
+      std::abs(dpi_x - dpi_y) > 0.2f * dpi_x) {
+    return kMinScale;
+  }
+  const float diagonal_inches =
+      std::hypot(static_cast<float>(size_mm.width()),
+                 static_cast<float>(size_mm.height())) /
+      display::kInchInMm;
+  const float target = internal || diagonal_inches < kNearMonitorMaxInches
+                           ? kNearTargetDpi
+                           : kFarTargetDpi;
+  float scale = std::round(dpi_x / target / kScaleStep) * kScaleStep;
+  scale = std::clamp(scale, kMinScale, kMaxScale);
+  while (scale > kMinScale && pixels.height() / scale < kMinLogicalHeight) {
+    scale -= kScaleStep;
+  }
+  return scale;
+}
+
+// static
+bool AuraDisplaySource::IsInternalConnector(const std::string& connector) {
+  return connector.starts_with("eDP") || connector.starts_with("LVDS") ||
+         connector.starts_with("DSI");
+}
+
+// static
+std::string AuraDisplaySource::UpdateConfig(
+    const std::string& text,
+    const std::map<std::string, float>& scales) {
+  std::vector<std::string> lines;
+  std::set<std::string> written;
+  for (const std::string& line : base::SplitString(
+           text, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    const std::string_view trimmed =
+        base::TrimWhitespaceASCII(line, base::TRIM_ALL);
+    const size_t separator = trimmed.find('=');
+    if (!trimmed.starts_with("#") && separator != std::string::npos) {
+      const std::string key(base::TrimWhitespaceASCII(
+          trimmed.substr(0, separator), base::TRIM_ALL));
+      if (key == kScaleKey) {
+        continue;
+      }
+      if (key.starts_with(kMonitorScalePrefix)) {
+        const std::string monitor_key =
+            key.substr(std::char_traits<char>::length(kMonitorScalePrefix));
+        auto it = scales.find(monitor_key);
+        if (it != scales.end()) {
+          if (written.insert(monitor_key).second) {
+            lines.push_back(key + "=" + FormatScale(it->second));
+          }
+          continue;
+        }
+      }
+    }
+    lines.push_back(line);
+  }
+  while (!lines.empty() &&
+         base::TrimWhitespaceASCII(lines.back(), base::TRIM_ALL).empty()) {
+    lines.pop_back();
+  }
+  if (lines.empty()) {
+    lines.push_back("# AuraDE display settings");
+  }
+  for (const auto& [monitor_key, scale] : scales) {
+    if (!written.contains(monitor_key)) {
+      lines.push_back(std::string(kMonitorScalePrefix) + monitor_key + "=" +
+                      FormatScale(scale));
+    }
+  }
+  return base::JoinString(lines, "\n") + "\n";
+}
