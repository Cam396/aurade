diff --git a/ui/file_manager/file_manager/foreground/js/aurade_cut_marks.ts b/ui/file_manager/file_manager/foreground/js/aurade_cut_marks.ts
--- a/ui/file_manager/file_manager/foreground/js/aurade_cut_marks.ts
+++ b/ui/file_manager/file_manager/foreground/js/aurade_cut_marks.ts
@@ -14,56 +14,73 @@ import type {FilesAppEntry} from '../../common/js/files_app_entry_types.js';
  * and the only way to find out was to paste somewhere and look.
  *
  * Every other file manager dims a cut file until it is pasted. This is the set
  * that makes that possible.
  *
  * Keyed by URL rather than by entry, because the list rebuilds its entry
  * objects as rows are recycled, so the object that was cut is not the object
  * the row is later rendered from. The URL survives that.
  */
 const cutUrls = new Set<string>();
+let cutFolders = 0;
 
 /**
  * Marks entries as cut, replacing anything marked before.
  *
  * There is only ever one clipboard, so a second cut replaces the first rather
  * than adding to it.
  */
 export function auraDeMarkCut(entries: Array<Entry|FilesAppEntry>) {
   cutUrls.clear();
+  cutFolders = 0;
   for (const entry of entries) {
     cutUrls.add(entry.toURL());
+    if (entry.isDirectory) {
+      cutFolders++;
+    }
   }
 }
 
 /**
  * Forgets what was cut. Returns whether anything was actually forgotten, so a
  * caller can skip a redraw it does not need.
  */
 export function auraDeClearCut(): boolean {
   if (cutUrls.size === 0) {
     return false;
   }
   cutUrls.clear();
+  cutFolders = 0;
   return true;
 }
 
 /**
  * How many files are waiting to be moved.
  *
  * The dimming only says which ones while you are looking at the folder they
  * are in. Walk into another folder and the clipboard becomes invisible again,
  * which is where the status bar picks it up.
  */
 export function auraDeCutCount(): number {
   return cutUrls.size;
 }
 
+/**
+ * How many of the things waiting to be moved are folders.
+ *
+ * Counted when the cut is made rather than worked out later. The status bar
+ * asks from any folder in the app, including ones the cut files are not in,
+ * and by then there is nothing on hand to ask whether a URL was a directory.
+ */
+export function auraDeCutFolderCount(): number {
+  return cutFolders;
+}
+
 /**
  * Whether this entry is waiting to be moved.
  */
 export function auraDeIsCut(entry: Entry|FilesAppEntry): boolean {
   if (cutUrls.size === 0) {
     return false;
   }
   return cutUrls.has(entry.toURL());
 }
