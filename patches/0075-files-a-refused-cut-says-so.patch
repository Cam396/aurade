+  /**
+   * AuraDE: say so when a cut or a copy is refused, and stop the marks lying.
+   *
+   * Measured on the Dell. Select two folders, one of them a folder the app
+   * will not move, press Ctrl+X, and nothing at all happens: no dimming, no
+   * message. Worse, the marks from the *previous* cut stay exactly where they
+   * were and the status bar goes on naming them, so someone who has just
+   * selected two things and pressed the keys sees two other things dimmed and
+   * has every reason to believe it worked. Pasting then moves files they never
+   * chose. Silence would have been bad on its own; silence on top of state
+   * that describes a different cut is worse than either.
+   *
+   * Clearing is not optional here even though the refusal changed nothing:
+   * what is on screen has to describe what a paste would now do, and after a
+   * refusal that is nothing.
+   *
+   * Nothing is said when the selection is empty, because Ctrl+X with nothing
+   * chosen is a keystroke into the air rather than a request that was turned
+   * down, and a message would be scolding someone for pressing a key.
+   */
+  private auraDeRefused_(isMove: boolean) {
+    if (this.selectionHandler_.selection.totalCount === 0) {
+      return;
+    }
+    if (auraDeClearCut()) {
+      this.auraDeRedrawForCutMarks_();
+    }
+    this.filesToast_.show(
+        isMove ? str('AURADE_CANNOT_MOVE_THESE') :
+                 str('AURADE_CANNOT_COPY_THESE'));
+  }
+
