+      for (let i = 0; i < 8; i++) {
+        keys.push(asFileKey(platform.add(ROOT, `f-${i}.txt`, false, {size: 10})));
+      }
+      const port = new ChromeOsBackend(platform);
+      await port.metadata(keys, ['size']);
+      equal(platform.metadataCalls.length, 1,
+            'eight files should not be eight round trips');
+    },
+  },
+  {
+    name: 'metadata asks for the fields wanted and no others',
+    async run() {
+      const platform = withRoot();
+      const key = asFileKey(
