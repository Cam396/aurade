@@ -0,0 +1,330 @@
+/**
+ * What the shared contract cannot ask.
+ *
+ * The contract is written to be true of any backend, so it cannot mention
+ * DOMException names, ChromeOS volume type strings, or the fact that a change
+ * event is allowed to omit what changed. Those are the adapter's whole job, so
+ * they are tested here.
+ */
+import {ChromeOsBackend} from '../../adapter/chromeos_backend.js';
+import type {ChangeEvent, EntryPage} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import {FakePlatform} from './fake_platform.js';
+import {beginCheck} from '../progress.js';
+
+const ROOT = 'filesystem:chrome://file-manager/external/myfiles';
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+function withRoot(options?: ConstructorParameters<typeof FakePlatform>[0]):
+    FakePlatform {
+  return new FakePlatform(options).addVolume({
+    volumeId: 'system',
+    volumeType: 'downloads',
+    label: 'My files',
+    url: ROOT,
+    sizeStats: {totalSize: 512e9, remainingSize: 8.7e9},
+  });
+}
+
+async function drain(pages: AsyncIterable<EntryPage>): Promise<string[]> {
+  const names: string[] = [];
+  for await (const page of pages) {
+    names.push(...page.entries.map(entry => entry.name));
+  }
+  return names;
+}
+
+interface Check {
+  name: string;
+  run(): Promise<void>;
+}
+
+const CHECKS: Check[] = [
+  {
+    name: 'every DOMException the platform throws becomes a typed code',
+    async run() {
+      const expected: Array<[string, string]> = [
+        ['NotFoundError', 'not-found'],
+        ['TypeMismatchError', 'unsupported'],
+        ['NoModificationAllowedError', 'read-only'],
+        ['SecurityError', 'permission-denied'],
+        ['NotAllowedError', 'permission-denied'],
+        ['QuotaExceededError', 'no-space'],
+        ['AbortError', 'cancelled'],
+        // Anything unrecognised is io rather than a crash or a guess.
+        ['SomeFutureChromeError', 'io'],
+      ];
+      for (const [name, code] of expected) {
+        const platform = withRoot();
+        const folder = platform.add(ROOT, 'sub', true);
+        platform.failWith(folder, name);
+        const port = new ChromeOsBackend(platform);
+        try {
+          await drain(port.list(asFileKey(folder)));
+          throw new AssertionError(`${name} did not fail at all`);
+        } catch (error) {
+          assert(error instanceof FilesError,
+                 `${name} came back as ${(error as Error)?.name}, not a FilesError`);
+          equal(error.code, code, `${name} mapped to the wrong code`);
+        }
+      }
+    },
+  },
+  {
