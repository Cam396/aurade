diff --git a/ui/file_manager/file_manager/aurade/tests/progress.ts b/ui/file_manager/file_manager/aurade/tests/progress.ts
new file mode 100644
index 0000000..682f6db
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/progress.ts
@@ -0,0 +1,18 @@
+/**
+ * What the suite is in the middle of.
+ *
+ * Only read by the watchdog. A hanging test cannot report its own failure,
+ * because it never finishes, so without this the only thing anybody learns is
+ * that something somewhere stopped. That is enough to fail a run and not enough
+ * to fix one, and it is also not enough for the mutation gate to attribute the
+ * hang to the test that was supposed to catch it.
+ */
+let inFlight = 'nothing yet';
+
+export function beginCheck(label: string): void {
+  inFlight = label;
+}
+
+export function currentCheck(): string {
+  return inFlight;
+}
