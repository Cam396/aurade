+        for await (const event of port.watch(asFileKey(ROOT), controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await Promise.resolve();
+      platform.add(ROOT, 'after.txt', false);
+      await pump;
+      controller.abort();
+      equal(seen.length, 1, 'nothing was reported');
+      const event = seen[0]!;
+      equal(event.kind, 'added', 'the difference was not worked out');
+      assert(event.kind === 'added' && event.entries[0]?.name === 'after.txt',
+             'it found the wrong entry');
+    },
+  },
+  {
+    name: 'a vague removal is worked out too',
+    async run() {
+      const platform = withRoot({vagueChanges: true});
+      const doomed = platform.add(ROOT, 'doomed.txt', false);
+      const port = new ChromeOsBackend(platform);
+      await drain(port.list(asFileKey(ROOT)));
+      const controller = new AbortController();
+      const seen: ChangeEvent[] = [];
+      const pump = (async () => {
+        for await (const event of port.watch(asFileKey(ROOT), controller.signal)) {
+          seen.push(event);
+          break;
+        }
+      })();
+      await Promise.resolve();
+      platform.remove(doomed);
+      await pump;
+      controller.abort();
+      equal(seen[0]?.kind, 'removed', 'a removal was not noticed');
+    },
+  },
+  {
+    name: 'metadata is one call for the whole selection',
+    async run() {
