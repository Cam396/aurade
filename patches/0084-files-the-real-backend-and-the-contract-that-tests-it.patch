index 0000000..2ffbf3d
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/adapter/chromeos_backend.ts
@@ -0,0 +1,508 @@
+/**
+ * The real backend: `FilesBackendPort` over the plumbing we kept.
+ *
+ * Everything it touches is behind `Platform`, so the contract suite runs
+ * against it here rather than only on a machine. That proves the translation:
+ * identity, paging, error mapping, revisions and the change diff. It does not
+ * prove that `Platform` describes ChromeOS correctly, and only hardware can.
+ *
+ * Four capabilities are implemented: list, metadata, watch and volumes, which
+ * is what the window uses. The rest throw `unsupported` rather than returning
+ * something plausible, and the contract reports them as skipped rather than
+ * passing over them quietly.
+ */
+import type {FilesBackendPort} from '../port/port.js';
+import type {ChangeEvent, DialogMode, EntryDto, EntryPage, FileKey, IoProgress, IoRequest, ListOptions, Metadata, MetadataField, MetadataSnapshot, TaskDescriptor, TaskId, Volume, VolumeKind} from '../port/types.js';
+import {asFileKey, FilesError} from '../port/types.js';
+import type {Platform, PlatformEntry, PlatformMetadata, PlatformVolume, PlatformWatchEvent} from './platform.js';
+
+/** ChromeOS volume types, as they are actually spelled. */
+const VOLUME_KINDS: Record<string, VolumeKind> = {
+  downloads: 'system',
+  system_internal: 'system',
+  removable: 'removable',
+  archive: 'archive',
+  provided: 'provided',
+  documents_provider: 'provided',
+  smb: 'provided',
+  drive: 'drive',
+  android_files: 'android',
+  crostini: 'crostini',
+  guest_os: 'crostini',
+  mtp: 'mtp',
+  trash: 'trash',
+  // An aggregated view rather than a device, which is the same shape as Recent.
+  media_view: 'recent',
+  recent: 'recent',
+};
+
+/** Anything you can unplug or unmount out from under yourself. */
+const DETACHABLE = new Set(['removable', 'archive', 'mtp']);
+
+/** Our field names to the ones MetadataModel answers to. */
+const METADATA_NAMES: Record<MetadataField, string> = {
+  size: 'size',
+  modificationTime: 'modificationTime',
+  mimeType: 'contentMimeType',
+  pinned: 'pinned',
+  shared: 'shared',
+  availableOffline: 'availableOffline',
+  restricted: 'restricted',
+};
+
+/**
+ * A DOMException is a name, not a code, and the UI has to say something
+ * different for each. Matching on the message is how that stops working in
+ * another language, which is the same reason FilesError is typed at all.
+ */
+function translateError(error: unknown, what: string): FilesError {
+  if (error instanceof FilesError) {
+    return error;
+  }
+  const name = (error as {name?: string} | null)?.name ?? '';
+  switch (name) {
+    case 'NotFoundError':
+      return new FilesError('not-found', `${what} is not there.`);
+    case 'TypeMismatchError':
+      return new FilesError('unsupported', `${what} is not a folder.`);
+    case 'NoModificationAllowedError':
+      return new FilesError('read-only', `${what} is read only.`);
+    case 'SecurityError':
+    case 'NotAllowedError':
+      return new FilesError('permission-denied', `${what} could not be opened.`);
+    case 'QuotaExceededError':
+      return new FilesError('no-space', 'There is no room left.');
+    case 'AbortError':
+      return new FilesError('cancelled', 'That was cancelled.');
+    default:
+      return new FilesError('io', `${what} could not be read.`);
+  }
+}
+
+/**
+ * An async iterable queue.
+ *
+ * Deliberately not shared with the mock's. A queue used by both the fake and
+ * the real thing is a place a single bug can hide from a suite designed to
+ * compare them.
+ */
+class Stream<T> implements AsyncIterable<T> {
+  private readonly buffer: T[] = [];
+  private wake: (() => void)|null = null;
+  private closed = false;
+
+  push(value: T): void {
+    if (this.closed) {
+      return;
+    }
+    this.buffer.push(value);
+    this.wake?.();
+    this.wake = null;
+  }
+
+  close(): void {
+    this.closed = true;
+    this.wake?.();
+    this.wake = null;
+  }
+
+  async * [Symbol.asyncIterator](): AsyncIterator<T> {
+    for (;;) {
+      while (this.buffer.length) {
+        yield this.buffer.shift()!;
+      }
+      if (this.closed) {
+        return;
+      }
+      await new Promise<void>(resolve => {
+        this.wake = resolve;
+      });
+    }
+  }
+}
+
+export class ChromeOsBackend implements FilesBackendPort {
+  /**
+   * ChromeOS has no revision concept, so this is ours. It advances whenever a
+   * change is observed for a directory, which is exactly what `list` and
+   * `watch` have to agree on for the session's replay to close its race.
+   */
+  private readonly revisions = new Map<FileKey, number>();
+  /**
+   * What we last told anybody a directory contained, per watch. Needed because
+   * a change event is allowed to omit what changed, and the honest answer to
+   * "something happened here" is to go and find out rather than to pass the
+   * shrug along.
+   */
+  private readonly known = new Map<FileKey, Set<FileKey>>();
+
+  constructor(private readonly platform: Platform) {}
+
+  private revisionOf(key: FileKey): number {
+    return this.revisions.get(key) ?? 1;
+  }
+
+  private bump(key: FileKey): number {
+    const next = this.revisionOf(key) + 1;
+    this.revisions.set(key, next);
+    return next;
+  }
+
+  private toDto(entry: PlatformEntry, parent: FileKey): EntryDto {
+    return {
+      key: asFileKey(entry.toURL()),
+      name: entry.name,
+      isDirectory: entry.isDirectory,
+      parent,
+    };
+  }
+
+  private async resolveDirectory(key: FileKey): Promise<PlatformEntry> {
+    let entry: PlatformEntry;
+    try {
+      entry = await this.platform.resolve(key);
+    } catch (error) {
+      throw translateError(error, 'That folder');
+    }
+    if (!entry.isDirectory) {
+      throw new FilesError('unsupported', `${entry.name} is not a folder.`);
+    }
+    return entry;
+  }
+
+  private async readAll(
+      directory: PlatformEntry, key: FileKey,
+      options: ListOptions): Promise<EntryDto[]> {
+    const reader = this.platform.createReader(directory);
+    const found: EntryDto[] = [];
+    for (;;) {
+      if (options.signal?.aborted) {
+        return found;
+      }
+      let chunk: readonly PlatformEntry[];
+      try {
+        chunk = await reader.readEntries();
+      } catch (error) {
+        throw translateError(error, `${directory.name}`);
+      }
+      // An empty chunk is the end. It is not "no entries": a directory with a
+      // thousand children answers several times before it says nothing.
+      if (!chunk.length) {
+        return found;
+      }
+      for (const child of chunk) {
+        if (!options.showHidden && child.name.startsWith('.')) {
+          continue;
+        }
+        found.push(this.toDto(child, key));
+      }
+    }
+  }
+
+  /**
+   * Streamed, not buffered.
+   *
+   * The obvious implementation reads the whole directory and then slices it
+   * into pages, which is a page shaped API over a blocking read and defeats the
+   * entire reason `list` returns an iterable. A hundred thousand entries has to
+   * start arriving before the last one has been counted.
+   */
+  async * list(key: FileKey, options: ListOptions = {}):
+      AsyncIterable<EntryPage> {
+    const directory = await this.resolveDirectory(key);
+    const reader = this.platform.createReader(directory);
+    const revision = this.revisionOf(key);
+    const size = options.pageSize ?? 200;
+    const seen = new Set<FileKey>();
+    let batch: EntryDto[] = [];
+    for (;;) {
+      if (options.signal?.aborted) {
+        return;
+      }
+      let chunk: readonly PlatformEntry[];
+      try {
+        chunk = await reader.readEntries();
+      } catch (error) {
+        throw translateError(error, directory.name);
+      }
+      if (!chunk.length) {
+        break;
+      }
+      for (const child of chunk) {
+        if (!options.showHidden && child.name.startsWith('.')) {
+          continue;
+        }
+        const dto = this.toDto(child, key);
+        seen.add(dto.key);
+        batch.push(dto);
+        if (batch.length >= size) {
+          yield {revision, entries: batch, done: false};
+          batch = [];
+        }
+      }
+    }
+    this.known.set(key, seen);
+    // The final page carries whatever is left, which may be nothing. An empty
+    // last page is how a directory whose size is an exact multiple of the page
+    // size still says it has finished.
+    yield {revision, entries: batch, done: true};
+  }
+
+  async metadata(keys: readonly FileKey[], fields: readonly MetadataField[]):
+      Promise<MetadataSnapshot> {
+    const out = new Map<FileKey, Metadata>();
+    if (!keys.length) {
+      return out;
+    }
+    const entries: PlatformEntry[] = [];
+    for (const key of keys) {
+      try {
+        entries.push(await this.platform.resolve(key));
+      } catch {
+        // A file that vanished between listing and stat is ordinary. It gets
+        // no entry in the snapshot rather than failing the whole batch.
+      }
+    }
+    const names = fields.map(field => METADATA_NAMES[field]);
+    let items: readonly PlatformMetadata[];
+    try {
+      items = await this.platform.getMetadata(entries, names);
+    } catch (error) {
+      throw translateError(error, 'Those files');
+    }
+    entries.forEach((entry, index) => {
+      const item = items[index];
+      if (!item) {
+        return;
+      }
+      const value: Record<string, unknown> = {};
+      // Only what was asked for. Handing back everything makes the caller's
+      // field list decorative and hides a provider that ignored it.
+      for (const field of fields) {
+        switch (field) {
+          case 'size':
+            if (item.size !== undefined) {
+              value['size'] = item.size;
+            }
+            break;
+          case 'modificationTime':
+            if (item.modificationTime) {
+              value['modificationTime'] = item.modificationTime.getTime();
+            }
+            break;
+          case 'mimeType':
+            if (item.contentMimeType !== undefined) {
+              value['mimeType'] = item.contentMimeType;
+            }
+            break;
+          default:
+            if (item[field] !== undefined) {
+              value[field] = item[field];
+            }
+        }
+      }
+      out.set(asFileKey(entry.toURL()), value as Metadata);
+    });
+    return out;
+  }
+
+  /**
+   * Turns a change event into what actually changed.
+   *
+   * When ChromeOS says which files moved, this is a translation. When it does
+   * not, and it is allowed not to, the directory is read again and compared
+   * with what we last reported. Passing the shrug along as an empty change
+   * would be a lie in the other direction: the caller would be told nothing
+   * happened.
+   */
+  private async describe(key: FileKey, event: PlatformWatchEvent):
+      Promise<ChangeEvent[]> {
+    if (event.changedFiles?.length) {
+      const added: FileKey[] = [];
+      const removed: FileKey[] = [];
+      for (const change of event.changedFiles) {
+        (change.changes.includes('delete') ? removed : added)
+            .push(asFileKey(change.url));
+      }
+      const out: ChangeEvent[] = [];
+      const seen = this.known.get(key);
+      if (removed.length) {
+        for (const gone of removed) {
+          seen?.delete(gone);
+        }
+        out.push({kind: 'removed', revision: this.bump(key), keys: removed});
+      }
+      if (added.length) {
+        // add_or_update covers both, so an entry we already knew about has
+        // changed rather than appeared.
+        const fresh = added.filter(candidate => !seen?.has(candidate));
+        const touched = added.filter(candidate => !!seen?.has(candidate));
+        if (touched.length) {
+          out.push({kind: 'changed', revision: this.bump(key), keys: touched});
+        }
+        if (fresh.length) {
+          const entries: EntryDto[] = [];
+          for (const candidate of fresh) {
+            try {
+              entries.push(this.toDto(await this.platform.resolve(candidate), key));
+            } catch {
+              // Added and gone again before we looked. Nothing to report.
+            }
+          }
+          if (entries.length) {
+            for (const entry of entries) {
+              seen?.add(entry.key);
+            }
+            out.push({kind: 'added', revision: this.bump(key), entries});
+          }
+        }
+      }
+      return out;
+    }
+
+    let directory: PlatformEntry;
+    try {
+      directory = await this.resolveDirectory(key);
+    } catch (error) {
+      if (error instanceof FilesError && error.code === 'not-found') {
+        return [{kind: 'gone', revision: this.bump(key)}];
+      }
+      return [];
+    }
+    const now = await this.readAll(directory, key, {showHidden: true});
+    const before = this.known.get(key) ?? new Set<FileKey>();
+    const after = new Set(now.map(entry => entry.key));
+    const gone = [...before].filter(candidate => !after.has(candidate));
+    const fresh = now.filter(entry => !before.has(entry.key));
+    this.known.set(key, after);
+    const out: ChangeEvent[] = [];
+    if (gone.length) {
+      out.push({kind: 'removed', revision: this.bump(key), keys: gone});
+    }
+    if (fresh.length) {
+      out.push({kind: 'added', revision: this.bump(key), entries: fresh});
+    }
+    return out;
+  }
+
+  /**
+   * Armed before anything is awaited.
+   *
+   * An async generator body does not run at all until the consumer starts
+   * iterating, and every `await` after that is a window in which a change
+   * arrives and is dropped on the floor. Resolving the directory first cost
+   * several microtasks, which was long enough to miss a change made in the very
+   * next statement, and the contract caught it by hanging forever waiting for
+   * an event that had already been thrown away.
+   *
+   * A window remains on real hardware: `addFileWatch` is what arms ChromeOS,
+   * and a change landing before it returns is not delivered to anybody. The
+   * session opens `watch` before `list` precisely so the listing that follows
+   * picks such a change up, and the revision on each is what lets it tell.
+   */
+  async * watch(key: FileKey, signal?: AbortSignal): AsyncIterable<ChangeEvent> {
+    const stream = new Stream<ChangeEvent>();
+    const off = this.platform.onDirectoryChanged(event => {
+      if (event.directoryUrl !== key) {
+        return;
+      }
+      void this.describe(key, event).then(events => {
+        for (const change of events) {
+          stream.push(change);
+        }
+      });
+    });
+    let directory: PlatformEntry|null = null;
+    let stopped = false;
+    const stop = () => {
+      if (stopped) {
+        return;
+      }
+      stopped = true;
+      off();
+      if (directory) {
+        void this.platform.removeFileWatch(directory);
+      }
+      stream.close();
+    };
+    if (signal?.aborted) {
+      stop();
+      return;
+    }
+    signal?.addEventListener('abort', stop, {once: true});
+    try {
+      directory = await this.resolveDirectory(key);
+      await this.platform.addFileWatch(directory);
+      // Also runs when the consumer breaks out of the loop, which is how the
+      // platform watch gets released rather than leaking one per navigation.
+      yield* stream;
+    } finally {
+      stop();
+    }
+  }
+
+  private async toVolume(volume: PlatformVolume): Promise<Volume> {
+    const kind = VOLUME_KINDS[volume.volumeType] ?? 'provided';
+    let capacity: {total: number, free: number}|null = null;
+    try {
+      const stats = await this.platform.getSizeStats(volume.volumeId);
+      if (stats && stats.totalSize > 0) {
+        capacity = {total: stats.totalSize, free: stats.remainingSize};
+      }
+    } catch {
+      // A volume that will not answer has no capacity to show, which is the
+      // same as one that has no notion of it. Neither is worth failing over.
+    }
+    return {
+      id: volume.volumeId,
+      root: asFileKey(volume.root.toURL()),
+      label: volume.label,
+      kind,
+      removable: DETACHABLE.has(volume.volumeType),
+      readOnly: volume.isReadOnly,
+      capacity,
+    };
+  }
+
+  async volumes(): Promise<readonly Volume[]> {
+    const found = await this.platform.listVolumes();
+    return Promise.all(found.map(volume => this.toVolume(volume)));
+  }
+
+  // Not implemented yet, and saying so rather than returning something
+  // plausible. The contract reports these as skipped for this backend.
+
+  private unsupported(what: string): never {
+    throw new FilesError('unsupported', `${what} is not wired up yet.`);
+  }
+
+  // eslint-disable-next-line require-yield
+  async * search(): AsyncIterable<EntryPage> {
+    this.unsupported('Search');
+  }
+  async tasks(): Promise<readonly TaskDescriptor[]> {
+    this.unsupported('Open with');
+  }
+  async executeTask(): Promise<void> {
+    this.unsupported('Open with');
+  }
+  async startIo(_request: IoRequest): Promise<TaskId> {
+    this.unsupported('File operations');
+  }
+  // eslint-disable-next-line require-yield
+  async * subscribeIo(): AsyncIterable<IoProgress> {
+    this.unsupported('File operations');
+  }
+  async cancelIo(): Promise<void> {
+    this.unsupported('File operations');
+  }
+  async dialogMode(): Promise<DialogMode|null> {
+    this.unsupported('Dialog mode');
+  }
+  async confirmDialog(): Promise<void> {
+    this.unsupported('Dialog mode');
+  }
+  async cancelDialog(): Promise<void> {
+    this.unsupported('Dialog mode');
+  }
+}
