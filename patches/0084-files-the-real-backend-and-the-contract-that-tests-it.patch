+/**
+ * The contract, run against the real adapter.
+ *
+ * This is the file the port's docstring has been promising since M0: the same
+ * cases, two implementations, and a difference between them is a bug in
+ * whichever one is lying. Four capabilities are implemented so far, and the six
+ * cases covering the rest are reported as not run rather than passed over.
+ */
+import {ChromeOsBackend} from '../../adapter/chromeos_backend.js';
+import type {FileKey} from '../../port/types.js';
+import {asFileKey, FilesError} from '../../port/types.js';
+import type {Capability, Fixture} from '../contract/port_contract.js';
+import {runContract} from '../contract/port_contract.js';
+import {FakePlatform} from './fake_platform.js';
+
+const ROOT = 'filesystem:chrome://file-manager/external/myfiles';
+const USB = 'filesystem:chrome://file-manager/external/usb';
+
+/** Our codes back to the DOMException names the platform actually throws. */
+const DOM_NAMES: Record<string, string> = {
+  'not-found': 'NotFoundError',
+  'permission-denied': 'SecurityError',
+  'read-only': 'NoModificationAllowedError',
+  'no-space': 'QuotaExceededError',
+  cancelled: 'AbortError',
+  unsupported: 'TypeMismatchError',
+  io: 'InvalidStateError',
+  busy: 'InvalidStateError',
+};
+
+export const IMPLEMENTED: readonly Capability[] =
+    ['list', 'metadata', 'watch', 'volumes'];
+
+export function makeAdapterFixture(): Fixture {
+  const platform = new FakePlatform();
+  platform.addVolume({
+    volumeId: 'system',
+    volumeType: 'downloads',
+    label: 'My files',
+    url: ROOT,
+    sizeStats: {totalSize: 512e9, remainingSize: 8.7e9},
+  });
+  platform.addVolume({
+    volumeId: 'usb',
+    volumeType: 'removable',
+    label: 'Samsung Flash Drive',
+    url: USB,
+    sizeStats: {totalSize: 128e9, remainingSize: 96e9},
+  });
+  return {
+    port: new ChromeOsBackend(platform),
+    root: asFileKey(ROOT),
+    add: (parent: FileKey, name: string, isDirectory: boolean) =>
+        asFileKey(platform.add(parent, name, isDirectory, {size: 1024})),
+    remove: (key: FileKey) => platform.remove(key),
+    failWith: (key: FileKey, error: FilesError) =>
+        platform.failWith(key, DOM_NAMES[error.code] ?? 'InvalidStateError'),
+  };
+}
+
+export async function runAdapterContract() {
+  return runContract('ChromeOsBackend', makeAdapterFixture, IMPLEMENTED);
+}
