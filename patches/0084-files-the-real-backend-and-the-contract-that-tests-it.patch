@@ -0,0 +1,86 @@
+/**
+ * The narrow slice of ChromeOS the adapter is allowed to touch.
+ *
+ * Written against the real definitions in `definitions/file_manager_private.d.ts`
+ * rather than from memory, and deliberately narrow: the adapter reaches for
+ * nothing outside this, so the whole of it can be driven by a fake in a browser
+ * that has no `chrome.fileManagerPrivate` and no filesystem.
+ *
+ * The shapes here are the real ones. `changedFiles` really is optional, chunked
+ * reads really do end with an empty array, and metadata really does come back
+ * positionally. Where this lies, the adapter is verified against a fiction.
+ */
+
+/** A DOM `Entry`, reduced to what we read from it. */
+export interface PlatformEntry {
+  readonly name: string;
+  readonly isDirectory: boolean;
+  /** The identity used throughout the Files store already. */
+  toURL(): string;
+}
+
+/**
+ * A `DirectoryReader`, promisified.
+ *
+ * Chunked by design: it is called repeatedly and returns an empty array when
+ * the directory is exhausted. One call is not one directory.
+ */
+export interface PlatformDirectoryReader {
+  readEntries(): Promise<readonly PlatformEntry[]>;
+}
+
+/** A `MetadataItem`, of which we read a handful of fields. */
+export interface PlatformMetadata {
+  readonly size?: number;
+  readonly modificationTime?: Date;
+  readonly contentMimeType?: string;
+  readonly pinned?: boolean;
+  readonly shared?: boolean;
+  readonly availableOffline?: boolean;
+  readonly restricted?: boolean;
+}
+
+/** A `VolumeInfo`, reduced. */
+export interface PlatformVolume {
+  readonly volumeId: string;
+  /** The raw ChromeOS volume type string, mapped in the adapter. */
+  readonly volumeType: string;
+  readonly label: string;
+  readonly isReadOnly: boolean;
+  readonly root: PlatformEntry;
+}
+
+/** `chrome.fileManagerPrivate.FileChange`. */
+export interface PlatformFileChange {
+  readonly url: string;
+  readonly changes: ReadonlyArray<'add_or_update'|'delete'>;
+}
+
+/**
+ * `chrome.fileManagerPrivate.FileWatchEvent`, reduced.
+ *
+ * `changedFiles` is optional in the real API, which is the single most
+ * important fact in this file: ChromeOS is allowed to say only that a
+ * directory changed, without saying how.
+ */
+export interface PlatformWatchEvent {
+  readonly directoryUrl: string;
+  readonly changedFiles?: readonly PlatformFileChange[];
+}
+
+export interface Platform {
+  /** `webkitResolveLocalFileSystemURL`. Rejects with a DOMException. */
+  resolve(url: string): Promise<PlatformEntry>;
+  createReader(directory: PlatformEntry): PlatformDirectoryReader;
+  /** `MetadataModel.get`, which is batched and returns results positionally. */
+  getMetadata(
+      entries: readonly PlatformEntry[],
+      names: readonly string[]): Promise<readonly PlatformMetadata[]>;
+  listVolumes(): Promise<readonly PlatformVolume[]>;
+  /** `getSizeStats`, which returns nothing for a volume that has no notion. */
+  getSizeStats(volumeId: string):
+      Promise<{totalSize: number, remainingSize: number}|null>;
+  addFileWatch(entry: PlatformEntry): Promise<void>;
+  removeFileWatch(entry: PlatformEntry): Promise<void>;
+  onDirectoryChanged(listener: (event: PlatformWatchEvent) => void): () => void;
+}
diff --git a/ui/file_manager/file_manager/aurade/tests/adapter/adapter_test.ts b/ui/file_manager/file_manager/aurade/tests/adapter/adapter_test.ts
