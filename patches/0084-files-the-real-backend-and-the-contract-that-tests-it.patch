+        platform.addVolume({
+          volumeId: `v${index}`,
+          volumeType: type,
+          label: type,
+          url: `filesystem:chrome://file-manager/external/${type}`,
+        });
+      });
+      const volumes = await new ChromeOsBackend(platform).volumes();
+      types.forEach(([type, kind], index) => {
+        equal(volumes[index]!.kind, kind, `${type} mapped wrongly`);
+      });
+    },
+  },
+  {
+    name: 'only what can be unplugged is marked removable',
+    async run() {
+      const platform = new FakePlatform();
+      for (const type of ['downloads', 'removable', 'mtp', 'archive', 'drive']) {
+        platform.addVolume({
+          volumeId: type,
+          volumeType: type,
+          label: type,
+          url: `filesystem:chrome://file-manager/external/${type}`,
+        });
+      }
+      const volumes = await new ChromeOsBackend(platform).volumes();
+      const removable =
+          volumes.filter(volume => volume.removable).map(volume => volume.id);
+      equal(removable.join(','), 'removable,mtp,archive',
+            'the wrong things are marked as unpluggable');
+    },
+  },
+  {
+    name: 'a volume with no size stats has no capacity rather than zero',
+    async run() {
+      const platform = new FakePlatform().addVolume({
+        volumeId: 'drive',
+        volumeType: 'drive',
+        label: 'Google Drive',
+        url: 'filesystem:chrome://file-manager/external/drive',
+      });
+      const volumes = await new ChromeOsBackend(platform).volumes();
+      equal(volumes[0]!.capacity, null,
+            'a cloud mount was given a capacity of zero, which draws a full bar');
+    },
+  },
+  {
+    name: 'pages arrive before the whole directory has been read',
+    async run() {
+      // Two entries per read, twenty entries, ten reads to exhaust. If the
+      // first page waits for all of them, the iterable is a page shaped API
+      // over a blocking read and a hundred thousand entries never starts.
+      const platform = withRoot({chunk: 2});
+      for (let i = 0; i < 20; i++) {
+        platform.add(ROOT, `f-${i}.txt`, false);
+      }
+      const port = new ChromeOsBackend(platform);
+      let readsAtFirstPage = -1;
+      let reads = 0;
+      const inner = platform.createReader.bind(platform);
+      platform.createReader = directory => {
+        const reader = inner(directory);
+        return {
+          readEntries: async () => {
+            reads++;
+            return reader.readEntries();
+          },
+        };
+      };
+      for await (const page of port.list(asFileKey(ROOT), {pageSize: 2})) {
+        if (readsAtFirstPage < 0 && page.entries.length) {
+          readsAtFirstPage = reads;
+        }
+      }
+      assert(readsAtFirstPage > 0, 'no page ever arrived');
+      assert(readsAtFirstPage <= 2,
+             `the first page waited for ${readsAtFirstPage} reads of the directory`);
+    },
+  },
+  {
+    name: 'walking away from a watch releases it on the platform',
+    async run() {
+      const platform = withRoot();
+      const port = new ChromeOsBackend(platform);
+      const controller = new AbortController();
+      const pump = (async () => {
+        for await (const _event of port.watch(asFileKey(ROOT), controller.signal)) {
+          break;
+        }
+      })();
+      await Promise.resolve();
+      platform.add(ROOT, 'poke.txt', false);
+      await pump;
+      // Give the teardown its microtask.
+      await new Promise(resolve => setTimeout(resolve, 0));
+      equal(platform.watched.size, 0,
+            'the platform watch leaked, one per navigation');
+    },
+  },
+];
+
+export async function runAdapterTests(): Promise<boolean> {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const check of CHECKS) {
+    try {
+      beginCheck(`adapter: ${check.name}`);
+      await check.run();
+      passed++;
+    } catch (error) {
+      failures.push(`  FAIL ${check.name}\n       ${
+          error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`adapter: ${passed}/${CHECKS.length} passed`);
+  for (const failure of failures) {
+    console.log(failure);
+  }
+  return failures.length === 0;
+}
diff --git a/ui/file_manager/file_manager/aurade/tests/adapter/fake_platform.ts b/ui/file_manager/file_manager/aurade/tests/adapter/fake_platform.ts
new file mode 100644
index 0000000..8451c80
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/adapter/fake_platform.ts
@@ -0,0 +1,206 @@
+/**
+ * A ChromeOS shaped fake, for running the contract against the real adapter.
+ *
+ * The point of this file is to be awkward in the same ways the real thing is,
+ * not convenient. So `createReader` hands back a few entries at a time and only
+ * signals the end with an empty array, `getMetadata` answers positionally and
+ * only for the names it was asked for, failures arrive as objects with
+ * DOMException names rather than as our own error type, and a change event can
+ * legitimately arrive with no `changedFiles` at all.
+ *
+ * It proves the adapter translates correctly. It cannot prove this description
+ * of ChromeOS is right, and only the hardware can do that.
+ */
+import type {Platform, PlatformDirectoryReader, PlatformEntry, PlatformFileChange, PlatformMetadata, PlatformVolume, PlatformWatchEvent} from '../../adapter/platform.js';
+
+class FakeEntry implements PlatformEntry {
+  constructor(
+      readonly name: string, readonly isDirectory: boolean,
+      private readonly url: string) {}
+  toURL(): string {
+    return this.url;
+  }
+}
+
+interface Node {
+  entry: FakeEntry;
+  parent: string|null;
+  children: string[];
+  metadata: PlatformMetadata;
+}
+
+/** Thrown the way the platform throws: a name, not a type of ours. */
+function domError(name: string): Error {
+  const error = new Error(name);
+  error.name = name;
+  return error;
+}
+
+export interface FakeOptions {
+  /** Entries per readEntries call. Small on purpose, so paging is exercised. */
+  readonly chunk?: number;
+  /**
+   * When true, change events omit `changedFiles`, which the real API is
+   * allowed to do. The adapter then has to go and find out what happened.
+   */
+  readonly vagueChanges?: boolean;
+}
+
+export class FakePlatform implements Platform {
+  private readonly nodes = new Map<string, Node>();
+  private readonly volumeList: PlatformVolume[] = [];
+  private readonly sizes = new Map<string, {totalSize: number, remainingSize: number}>();
+  private readonly listeners = new Set<(event: PlatformWatchEvent) => void>();
+  private readonly failures = new Map<string, string>();
+  readonly watched = new Set<string>();
+  /** Every name list getMetadata was asked for, so a test can check batching. */
+  readonly metadataCalls: Array<readonly string[]> = [];
+
+  constructor(private readonly options: FakeOptions = {}) {}
+
+  addVolume(volume: {
+    volumeId: string,
+    volumeType: string,
+    label: string,
+    url: string,
+    isReadOnly?: boolean,
+    sizeStats?: {totalSize: number, remainingSize: number},
+  }): this {
+    const root = new FakeEntry(volume.label, true, volume.url);
+    this.nodes.set(volume.url, {entry: root, parent: null, children: [], metadata: {}});
+    this.volumeList.push({
+      volumeId: volume.volumeId,
+      volumeType: volume.volumeType,
+      label: volume.label,
+      isReadOnly: volume.isReadOnly ?? false,
+      root,
+    });
+    if (volume.sizeStats) {
+      this.sizes.set(volume.volumeId, volume.sizeStats);
+    }
+    return this;
+  }
+
+  add(parentUrl: string, name: string, isDirectory: boolean,
+      metadata: PlatformMetadata = {}): string {
+    const parent = this.nodes.get(parentUrl);
+    if (!parent) {
+      throw new Error(`no such parent ${parentUrl}`);
+    }
+    const url = `${parentUrl.replace(/\/$/, '')}/${name}`;
+    this.nodes.set(
+        url,
+        {entry: new FakeEntry(name, isDirectory, url), parent: parentUrl,
+         children: [], metadata});
+    parent.children.push(url);
+    this.notify(parentUrl, [{url, changes: ['add_or_update']}]);
+    return url;
+  }
+
+  remove(url: string): void {
+    const node = this.nodes.get(url);
+    if (!node) {
+      return;
+    }
+    this.nodes.delete(url);
+    if (node.parent) {
+      const parent = this.nodes.get(node.parent);
+      if (parent) {
+        parent.children = parent.children.filter(child => child !== url);
+      }
+      this.notify(node.parent, [{url, changes: ['delete']}]);
+    }
+  }
+
+  /** Makes this url fail the way the platform fails, by DOMException name. */
+  failWith(url: string, domExceptionName: string): void {
+    this.failures.set(url, domExceptionName);
+  }
+
+  private notify(directoryUrl: string, changes: PlatformFileChange[]): void {
+    const event: PlatformWatchEvent = this.options.vagueChanges ?
+        {directoryUrl} :
+        {directoryUrl, changedFiles: changes};
+    for (const listener of [...this.listeners]) {
+      listener(event);
+    }
+  }
+
+  async resolve(url: string): Promise<PlatformEntry> {
+    const failure = this.failures.get(url);
+    if (failure) {
+      throw domError(failure);
+    }
+    const node = this.nodes.get(url);
+    if (!node) {
+      throw domError('NotFoundError');
+    }
+    return node.entry;
+  }
+
+  createReader(directory: PlatformEntry): PlatformDirectoryReader {
+    const url = directory.toURL();
+    const chunk = this.options.chunk ?? 3;
+    let offset = 0;
+    let exhausted = false;
+    return {
+      readEntries: async () => {
+        const failure = this.failures.get(url);
+        if (failure) {
+          throw domError(failure);
+        }
+        if (exhausted) {
+          return [];
+        }
+        const node = this.nodes.get(url);
+        if (!node) {
+          throw domError('NotFoundError');
+        }
+        const slice = node.children.slice(offset, offset + chunk);
+        offset += slice.length;
+        if (!slice.length) {
+          exhausted = true;
+          return [];
+        }
+        return slice.map(child => this.nodes.get(child)!.entry);
+      },
+    };
+  }
+
+  async getMetadata(
+      entries: readonly PlatformEntry[],
+      names: readonly string[]): Promise<readonly PlatformMetadata[]> {
+    this.metadataCalls.push(names.slice());
+    // Positionally, and carrying whatever it happens to have cached.
+    //
+    // Deliberately more than was asked for. MetadataModel is a cache in front
+    // of several providers, so a MetadataItem can arrive holding fields nobody
+    // requested on this call. A fake that returns exactly the requested names
+    // makes the adapter's own filter look load bearing when it is not, and a
+    // mutation removing that filter escaped for precisely that reason.
+    return entries.map(
+        entry => (this.nodes.get(entry.toURL())?.metadata ?? {}));
+  }
+
+  async listVolumes(): Promise<readonly PlatformVolume[]> {
+    return this.volumeList.slice();
+  }
+
+  async getSizeStats(volumeId: string):
+      Promise<{totalSize: number, remainingSize: number}|null> {
+    return this.sizes.get(volumeId) ?? null;
+  }
+
+  async addFileWatch(entry: PlatformEntry): Promise<void> {
+    this.watched.add(entry.toURL());
+  }
+
+  async removeFileWatch(entry: PlatformEntry): Promise<void> {
+    this.watched.delete(entry.toURL());
+  }
+
+  onDirectoryChanged(listener: (event: PlatformWatchEvent) => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+}
