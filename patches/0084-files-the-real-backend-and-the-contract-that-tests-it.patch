+      const port = new ChromeOsBackend(platform);
+      const snapshot = await port.metadata([key], ['size']);
+      equal(platform.metadataCalls[0]?.join(','), 'size',
+            'it asked the provider for more than it needed');
+      const item = snapshot.get(key)!;
+      equal(item.size, 10, 'the size did not come back');
+      equal(item.mimeType, undefined,
+            'a field nobody asked for was handed back anyway');
+    },
+  },
+  {
+    name: 'our field names are translated to the ones the provider knows',
+    async run() {
+      const platform = withRoot();
+      const key = asFileKey(platform.add(
+          ROOT, 'one.txt', false, {contentMimeType: 'text/plain'}));
+      const port = new ChromeOsBackend(platform);
+      const snapshot = await port.metadata([key], ['mimeType']);
+      // The provider calls it contentMimeType. Asking it for "mimeType" gets
+      // nothing back and no error, which is the quietest kind of wrong.
+      equal(platform.metadataCalls[0]?.join(','), 'contentMimeType',
+            'the field name was not translated');
+      equal(snapshot.get(key)?.mimeType, 'text/plain', 'and it did not arrive');
+    },
+  },
+  {
+    name: 'a file that vanishes mid batch does not fail the batch',
+    async run() {
+      const platform = withRoot();
+      const good = asFileKey(platform.add(ROOT, 'here.txt', false, {size: 4}));
+      const gone = asFileKey(`${ROOT}/never-existed.txt`);
+      const port = new ChromeOsBackend(platform);
+      const snapshot = await port.metadata([gone, good], ['size']);
+      equal(snapshot.get(good)?.size, 4, 'the file that is there was lost');
+      equal(snapshot.has(gone), false, 'the one that is not there was invented');
+    },
+  },
+  {
+    name: 'ChromeOS volume types become the kinds the sidebar groups by',
+    async run() {
+      const platform = new FakePlatform();
+      const types: Array<[string, string]> = [
+        ['downloads', 'system'],
+        ['removable', 'removable'],
+        ['drive', 'drive'],
+        ['android_files', 'android'],
+        ['crostini', 'crostini'],
+        ['mtp', 'mtp'],
+        ['archive', 'archive'],
+        ['trash', 'trash'],
+        ['media_view', 'recent'],
+        // Something we have never heard of is a provider, not a crash and not
+        // a disk in the machine.
+        ['some_future_type', 'provided'],
+      ];
