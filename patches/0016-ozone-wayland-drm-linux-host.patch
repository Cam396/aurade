+TEST(SharedMemoryRegionWrapperTest, SinglePlaneRGBA_8888PaddedStride) {
+  constexpr gfx::Size size(696, 100);
+  constexpr viz::SharedImageFormat format = viz::SinglePlaneFormat::kRGBA_8888;
+  constexpr uint32_t stride = 2816;
+
+  auto shared_memory_region =
+      base::UnsafeSharedMemoryRegion::Create(stride * size.height());
+  ASSERT_TRUE(shared_memory_region.IsValid());
+
+  gfx::GpuMemoryBufferHandle handle(std::move(shared_memory_region));
+  handle.type = gfx::SHARED_MEMORY_BUFFER;
+  handle.offset = 0;
+  handle.stride = stride;
+
+  SharedMemoryRegionWrapper wrapper;
+  EXPECT_TRUE(wrapper.Initialize(std::move(handle), size, format));
+  EXPECT_EQ(stride, wrapper.GetStride(0));
+}
