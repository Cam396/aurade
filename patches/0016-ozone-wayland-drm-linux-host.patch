+std::optional<size_t> SharedMemorySizeForStride(viz::SharedImageFormat format,
+                                                const gfx::Size& size,
+                                                uint32_t stride) {
+  if (!format.is_single_plane()) {
+    return viz::SharedMemorySizeForSharedImageFormat(format, size);
+  }
+
+  std::optional<size_t> row_size =
+      viz::SharedMemoryRowSizeForSharedImageFormat(format, /*plane=*/0,
+                                                   size.width());
+  if (!row_size) {
+    return std::nullopt;
+  }
+
+  base::CheckedNumeric<size_t> checked_size = stride;
+  checked_size *= std::max(0, size.height() - 1);
+  checked_size += row_size.value();
+  if (!checked_size.IsValid()) {
+    return std::nullopt;
+  }
+
+  return checked_size.ValueOrDie();
+}
+
 }  // namespace
 
