+
+// AuraDE compatibility: host applications draw their own light or dark look
+// from GNOME's settings, which xdg-desktop-portal hands to GTK, libadwaita,
+// Qt and Firefox alike. Nothing set them, so every application stayed light
+// on a dark desktop. The GTK theme only follows when it is still one of the
+// two stock Adwaita names, so a theme someone picked is left alone.
+std::string GetAuraDeGnomeSetting(const char* key) {
+  std::string value;
+  base::GetAppOutput(
+      {"/usr/bin/gsettings", "get", "org.gnome.desktop.interface", key},
+      &value);
+  return std::string(base::TrimWhitespaceASCII(value, base::TRIM_ALL));
+}
+
+void SetAuraDeGnomeSetting(const char* key, const std::string& value) {
+  if (GetAuraDeGnomeSetting(key) == "'" + value + "'") {
+    return;
+  }
+  std::string output;
+  base::GetAppOutputAndError(
+      {"/usr/bin/gsettings", "set", "org.gnome.desktop.interface", key, value},
+      &output);
+}
+
+void ApplyAuraDeHostColorSchemeOnThread(bool dark_mode_enabled) {
+  if (!base::PathExists(base::FilePath("/usr/bin/gsettings"))) {
+    return;
+  }
+  SetAuraDeGnomeSetting("color-scheme",
+                        dark_mode_enabled ? "prefer-dark" : "default");
+  const std::string gtk_theme = GetAuraDeGnomeSetting("gtk-theme");
+  if (gtk_theme == "'Adwaita'" || gtk_theme == "'Adwaita-dark'") {
+    SetAuraDeGnomeSetting("gtk-theme",
+                          dark_mode_enabled ? "Adwaita-dark" : "Adwaita");
+  }
+}
