+
+// Reads a string, or an object path that a player sent where the
+// specification says string, or the other way around.
+bool PopText(dbus::MessageReader* value, size_t max_bytes, std::string* out) {
+  switch (value->GetDataType()) {
+    case dbus::Message::STRING: {
+      std::string text;
+      if (!value->PopString(&text)) {
+        return false;
+      }
+      base::TruncateUTF8ToByteSize(text, max_bytes, out);
+      return true;
+    }
+    case dbus::Message::OBJECT_PATH: {
+      dbus::ObjectPath path;
+      if (!value->PopObjectPath(&path)) {
+        return false;
+      }
+      *out = path.value();
+      return true;
+    }
+    default:
+      return false;
+  }
+}
+
+// xesam:artist is a list of strings; some players send one string.
+bool PopTexts(dbus::MessageReader* value, std::vector<std::string>* out) {
+  out->clear();
+  if (value->GetDataType() != dbus::Message::ARRAY) {
+    std::string text;
+    if (!PopText(value, kMaxTextBytes, &text)) {
+      return false;
+    }
+    if (!text.empty()) {
+      out->push_back(std::move(text));
+    }
+    return true;
+  }
+  dbus::MessageReader array(nullptr);
+  if (!value->PopArray(&array)) {
+    return false;
+  }
+  while (array.HasMoreData()) {
+    std::string text;
+    if (!PopText(&array, kMaxTextBytes, &text)) {
+      return false;
+    }
+    if (!text.empty() && out->size() < kMaxArtists) {
+      out->push_back(std::move(text));
+    }
+  }
+  return true;
+}
+
+bool PopBool(dbus::MessageReader* value, bool* out) {
+  return value->GetDataType() == dbus::Message::BOOL && value->PopBool(out);
+}
+
+// Lengths and positions are 64 bit microseconds; players send all kinds of
+// numbers for them.
+std::optional<int64_t> PopNumber(dbus::MessageReader* value) {
+  switch (value->GetDataType()) {
+    case dbus::Message::INT64: {
+      int64_t number;
+      if (value->PopInt64(&number)) {
+        return number;
+      }
+      break;
+    }
+    case dbus::Message::UINT64: {
+      uint64_t number;
+      if (value->PopUint64(&number)) {
+        return base::saturated_cast<int64_t>(number);
+      }
+      break;
+    }
+    case dbus::Message::INT32: {
+      int32_t number;
+      if (value->PopInt32(&number)) {
+        return number;
+      }
+      break;
+    }
+    case dbus::Message::UINT32: {
+      uint32_t number;
+      if (value->PopUint32(&number)) {
+        return number;
+      }
+      break;
+    }
+    case dbus::Message::DOUBLE: {
+      double number;
+      if (value->PopDouble(&number)) {
+        return base::saturated_cast<int64_t>(number);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  return std::nullopt;
+}
+
+// Not base::ReadFileToString: a player could name a pipe or a device, and
+// reading one of those may never end.
+std::optional<std::string> ReadArtworkFile(const base::FilePath& path) {
+  base::ScopedFD fd(HANDLE_EINTR(open(
+      path.value().c_str(), O_RDONLY | O_CLOEXEC | O_NOCTTY | O_NONBLOCK)));
+  if (!fd.is_valid()) {
+    return std::nullopt;
+  }
+  struct stat info;
+  if (fstat(fd.get(), &info) != 0 || !S_ISREG(info.st_mode) ||
+      info.st_size <= 0 ||
+      static_cast<uint64_t>(info.st_size) > kMaxArtworkBytes) {
+    return std::nullopt;
+  }
+  std::string bytes(static_cast<size_t>(info.st_size), '\0');
+  if (!base::ReadFromFD(fd.get(), bytes)) {
+    return std::nullopt;
+  }
+  return bytes;
+}
+
+// Media sessions hand artwork on as tightly packed 32 bit pixels, no larger
+// than asked for.
+SkBitmap ToArtwork(const SkBitmap& image, int desired_size_px) {
+  if (image.drawsNothing()) {
+    return SkBitmap();
+  }
+  SkBitmap scaled = image;
+  const int longest = std::max(image.width(), image.height());
+  if (desired_size_px > 0 && longest > desired_size_px) {
+    const double scale = static_cast<double>(desired_size_px) / longest;
+    scaled = skia::ImageOperations::Resize(
+        image, skia::ImageOperations::RESIZE_GOOD,
+        std::max(1, base::ClampRound(image.width() * scale)),
+        std::max(1, base::ClampRound(image.height() * scale)));
+    if (scaled.drawsNothing()) {
+      return SkBitmap();
+    }
+  }
+  const SkImageInfo info = scaled.info()
+                               .makeColorType(kN32_SkColorType)
+                               .makeAlphaType(kPremul_SkAlphaType);
+  if (scaled.info() == info && scaled.rowBytes() == info.minRowBytes()) {
+    return scaled;
+  }
+  SkBitmap packed;
+  if (!packed.tryAllocPixels(info) ||
+      !scaled.readPixels(info, packed.getPixels(), packed.rowBytes(), 0, 0)) {
+    return SkBitmap();
+  }
+  return packed;
+}
+
+void OnArtworkDecoded(int desired_size_px,
+                      base::OnceCallback<void(const SkBitmap&)> callback,
+                      const SkBitmap& image) {
+  std::move(callback).Run(ToArtwork(image, desired_size_px));
+}
+
+// Artwork comes from whatever the player names, so it is decoded in the
+// sandboxed data decoder, never here.
+void DecodeArtwork(int desired_size_px,
+                   base::OnceCallback<void(const SkBitmap&)> callback,
+                   std::optional<std::string> bytes) {
+  if (!bytes || bytes->empty()) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  data_decoder::DecodeImageIsolated(
+      base::as_byte_span(*bytes), data_decoder::mojom::ImageCodec::kDefault,
+      /*shrink_to_fit=*/true, kMaxDecodedArtworkBytes,
+      gfx::Size(desired_size_px, desired_size_px),
+      base::BindOnce(&OnArtworkDecoded, desired_size_px, std::move(callback)));
+}
