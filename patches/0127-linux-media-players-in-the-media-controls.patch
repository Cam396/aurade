+MprisMediaBridge::Player::Player(MprisMediaBridge* bridge,
+                                 std::string name,
+                                 std::string owner)
+    : bridge_(bridge),
+      name_(std::move(name)),
+      owner_(std::move(owner)),
+      proxy_(bridge->bus_->GetObjectProxyWithOptions(
+          owner_,
+          dbus::ObjectPath(kPlayerPath),
+          dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS)) {
+  proxy_->ConnectToSignal(
+      kPropertiesInterface, "PropertiesChanged",
+      base::BindRepeating(&Player::OnPropertiesChanged,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::DoNothing());
+  proxy_->ConnectToSignal(kPlayerInterface, "Seeked",
+                          base::BindRepeating(&Player::OnSeeked,
+                                              weak_ptr_factory_.GetWeakPtr()),
+                          base::DoNothing());
+  GetAll(kRootInterface);
+  GetAll(kPlayerInterface);
+}
+
+MprisMediaBridge::Player::~Player() {
+  AbandonFocus();
+  if (focus_ever_requested_) {
+    // The controls drop the player now rather than wait for it to return.
+    bridge_->audio_focus_manager_->RequestIdReleased(request_id_);
+  }
+  bridge_->bus_->RemoveObjectProxyWithOptions(
+      owner_, dbus::ObjectPath(kPlayerPath),
+      dbus::ObjectProxy::IGNORE_SERVICE_UNKNOWN_ERRORS, base::DoNothing());
+}
+
+void MprisMediaBridge::Player::GetMediaSessionInfo(
+    GetMediaSessionInfoCallback callback) {
+  std::move(callback).Run(GetInfo());
+}
+
+void MprisMediaBridge::Player::GetDebugInfo(GetDebugInfoCallback callback) {
+  auto info = media_session::mojom::MediaSessionDebugInfo::New();
+  info->name = identity_;
+  info->owner = name_;
+  info->state = status_ == Status::kPlaying  ? "Playing"
+                : status_ == Status::kPaused ? "Paused"
+                                             : "Stopped";
+  std::move(callback).Run(std::move(info));
+}
+
+void MprisMediaBridge::Player::Suspend(SuspendType suspend_type) {
+  // Audio focus suspends every session under the one that gained it each
+  // time it is enforced; a player already quiet is not asked again.
+  if (suspend_type == SuspendType::kSystem && status_ != Status::kPlaying) {
+    return;
+  }
+  // A player that cannot pause, a radio stream say, has to stop instead.
+  CallPlayer(can_pause_ ? "Pause" : "Stop");
+}
+
+void MprisMediaBridge::Player::Resume(SuspendType suspend_type) {
+  CallPlayer("Play");
+}
+
+void MprisMediaBridge::Player::AddObserver(
+    mojo::PendingRemote<media_session::mojom::MediaSessionObserver> observer) {
+  mojo::Remote<media_session::mojom::MediaSessionObserver> remote(
+      std::move(observer));
+  remote->MediaSessionInfoChanged(GetInfo());
+  remote->MediaSessionMetadataChanged(GetMetadata());
+  remote->MediaSessionActionsChanged(GetActions());
+  remote->MediaSessionImagesChanged(GetImages());
+  remote->MediaSessionPositionChanged(GetPosition());
+  observers_.Add(std::move(remote));
+}
