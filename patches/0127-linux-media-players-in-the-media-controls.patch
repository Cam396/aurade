+void MprisMediaBridge::Player::Seek(base::TimeDelta seek_time) {
+  dbus::MethodCall method_call(kPlayerInterface, "Seek");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendInt64(seek_time.InMicroseconds());
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+}
+
+void MprisMediaBridge::Player::Stop(SuspendType suspend_type) {
