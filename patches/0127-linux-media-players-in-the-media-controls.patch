+// names without end does not grow the controls without end.
+constexpr size_t kMaxPlayers = 32;
+// Titles, artists and albums are cut to this; the controls show a line each.
+constexpr size_t kMaxTextBytes = 1024;
+constexpr size_t kMaxArtists = 16;
+// The longest URL a media session can carry, artwork as a data URL included.
+constexpr size_t kMaxArtUrlBytes = 2 * 1024 * 1024;
+// Artwork files and downloads larger than this are not shown.
+constexpr size_t kMaxArtworkBytes = 16 * 1024 * 1024;
+// Artwork that decodes larger than this is shrunk while it is decoded.
+constexpr uint64_t kMaxDecodedArtworkBytes = 16 * 1024 * 1024;
+constexpr base::TimeDelta kArtworkDownloadTimeout = base::Seconds(30);
