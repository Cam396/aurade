+  std::vector<MediaSessionAction> GetActions() const;
+  base::flat_map<MediaSessionImageType, std::vector<media_session::MediaImage>>
+  GetImages() const;
+  std::optional<media_session::MediaPosition> GetPosition() const;
+
+  // Takes, keeps or gives up audio focus for what the player is doing now,
