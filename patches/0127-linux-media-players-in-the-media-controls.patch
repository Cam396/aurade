+// AuraDE compatibility: media players among the Linux applications, music
+// players and browsers alike, announce themselves on the session bus with
+// MPRIS, which is what KDE's and GNOME's media controls read. This shows each
+// one in Ash's media controls the way Ash shows a web page playing media: its
+// title, artist and artwork, with play, pause, next, previous and seeking
+// passed back to the player, and the keyboard's media keys reaching the one
+// that last played. Players take part in Ash's audio focus as web pages do:
+// with focus enforcement on, one that starts playing pauses the one that was.
+class MprisMediaBridge {
+ public:
+  // Returns null when the bridge cannot start.
+  static std::unique_ptr<MprisMediaBridge> Create(
+      media_session::MediaSessionService* media_session_service,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+
+  MprisMediaBridge(const MprisMediaBridge&) = delete;
+  MprisMediaBridge& operator=(const MprisMediaBridge&) = delete;
+  ~MprisMediaBridge();
+
+ private:
+  class Player;
+  using ArtworkCallback = base::OnceCallback<void(const SkBitmap&)>;
+  using ArtworkLoaders = std::list<std::unique_ptr<network::SimpleURLLoader>>;
+
+  MprisMediaBridge(
+      media_session::MediaSessionService* media_session_service,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+
+  bool Start();
+  void OnNameOwnerChangedConnected(const std::string& interface_name,
+                                   const std::string& signal_name,
+                                   bool success);
+  void OnListNames(dbus::Response* response);
+  void OnGetNameOwner(const std::string& name, dbus::Response* response);
+  void OnNameOwnerChanged(dbus::Signal* signal);
+  void AddPlayer(const std::string& name, const std::string& owner);
+  void RemovePlayer(const std::string& name, const std::string& owner);
+
+  // Reads, fetches or unpacks a player's artwork and decodes it out of
+  // process, no larger than `desired_size_px` on its longest side. Runs
+  // `callback` with an empty bitmap when there is none to show.
+  void LoadArtwork(const GURL& url,
+                   int desired_size_px,
+                   ArtworkCallback callback);
+  void OnArtworkDownloaded(ArtworkLoaders::iterator loader,
+                           int desired_size_px,
+                           ArtworkCallback callback,
+                           std::optional<std::string> body);
+
+  std::unique_ptr<base::Thread> dbus_thread_;
+  scoped_refptr<dbus::Bus> bus_;
+  raw_ptr<dbus::ObjectProxy> bus_proxy_ = nullptr;
+  mojo::Remote<media_session::mojom::AudioFocusManager> audio_focus_manager_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  ArtworkLoaders artwork_loaders_;
+  // The players, by the unique name of their connection to the bus. A
+  // player that owns two MPRIS names, as some do, is shown once.
+  std::map<std::string, std::unique_ptr<Player>> players_;
+  base::WeakPtrFactory<MprisMediaBridge> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
