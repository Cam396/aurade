+  void GetVisibility(GetVisibilityCallback callback) override;
+  void SaveVideoFrame() override {}
+
+ private:
+  enum class Status { kStopped, kPaused, kPlaying };
+
+  void GetAll(const std::string& interface_name);
+  void OnGetAll(const std::string& interface_name, dbus::Response* response);
+  void OnPropertiesChanged(dbus::Signal* signal);
