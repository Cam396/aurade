+}
+
+void MprisMediaBridge::Player::GetMediaImageBitmap(
+    const media_session::MediaImage& image,
+    int32_t minimum_size_px,
+    int32_t desired_size_px,
+    GetMediaImageBitmapCallback callback) {
+  // Only the artwork this player named; the controls ask by URL.
+  if (image.src != art_url_) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  bridge_->LoadArtwork(image.src, desired_size_px, std::move(callback));
+}
+
+void MprisMediaBridge::Player::SeekTo(base::TimeDelta seek_time) {
+  if (!length_.is_positive()) {
+    return;
+  }
+  seek_time = std::clamp(seek_time, base::TimeDelta(), length_);
+  const dbus::ObjectPath track(track_id_);
+  if (!track.IsValid() || track.value() == kNoTrack) {
+    // SetPosition needs the track; without one, seek by the difference.
+    Seek(seek_time - EstimatedPosition());
+    return;
+  }
+  dbus::MethodCall method_call(kPlayerInterface, "SetPosition");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendObjectPath(track);
+  writer.AppendInt64(seek_time.InMicroseconds());
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+}
+
+void MprisMediaBridge::Player::ScrubTo(base::TimeDelta seek_time) {
+  SeekTo(seek_time);
+}
+
+void MprisMediaBridge::Player::Raise() {
+  dbus::MethodCall method_call(kRootInterface, "Raise");
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+}
+
+void MprisMediaBridge::Player::GetVisibility(GetVisibilityCallback callback) {
+  std::move(callback).Run(false);
+}
+
+void MprisMediaBridge::Player::GetAll(const std::string& interface_name) {
+  dbus::MethodCall method_call(kPropertiesInterface, "GetAll");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(interface_name);
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::BindOnce(&Player::OnGetAll,
+                                    weak_ptr_factory_.GetWeakPtr(),
+                                    interface_name));
+}
+
+void MprisMediaBridge::Player::OnGetAll(const std::string& interface_name,
+                                        dbus::Response* response) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  ReadProperties(interface_name, &reader);
+  if (interface_name == kPlayerInterface) {
+    player_read_ = true;
+  }
+  Update();
+}
+
+void MprisMediaBridge::Player::OnPropertiesChanged(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  std::string interface_name;
+  if (!reader.PopString(&interface_name) ||
+      (interface_name != kRootInterface &&
+       interface_name != kPlayerInterface)) {
+    return;
+  }
+  ReadProperties(interface_name, &reader);
+  // Some players announce that a property changed without its new value.
+  std::vector<std::string> invalidated;
+  if (reader.PopArrayOfStrings(&invalidated) && !invalidated.empty()) {
+    GetAll(interface_name);
+  }
+  Update();
+}
+
+void MprisMediaBridge::Player::OnSeeked(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  if (std::optional<int64_t> position = PopNumber(&reader)) {
+    SetPosition(base::Microseconds(*position));
+    NotifyObservers();
+  }
+}
+
+void MprisMediaBridge::Player::FetchPosition() {
+  position_stale_ = false;
+  dbus::MethodCall method_call(kPropertiesInterface, "Get");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(kPlayerInterface);
+  writer.AppendString("Position");
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::BindOnce(&Player::OnPosition,
+                                    weak_ptr_factory_.GetWeakPtr()));
+}
+
+void MprisMediaBridge::Player::OnPosition(dbus::Response* response) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  dbus::MessageReader value(nullptr);
+  if (!reader.PopVariant(&value)) {
+    return;
+  }
+  if (std::optional<int64_t> position = PopNumber(&value)) {
+    SetPosition(base::Microseconds(*position));
+    NotifyObservers();
+  }
+}
+
+void MprisMediaBridge::Player::ReadProperties(const std::string& interface_name,
+                                              dbus::MessageReader* properties) {
+  dbus::MessageReader array(nullptr);
+  if (!properties->PopArray(&array)) {
+    return;
+  }
+  while (array.HasMoreData()) {
+    dbus::MessageReader entry(nullptr);
+    std::string property;
+    dbus::MessageReader value(nullptr);
+    if (!array.PopDictEntry(&entry) || !entry.PopString(&property) ||
+        !entry.PopVariant(&value)) {
+      return;
+    }
+    if (interface_name == kRootInterface) {
+      ReadRootProperty(property, &value);
+    } else {
+      ReadPlayerProperty(property, &value);
+    }
+  }
+  // MPRIS never signals the position as it moves, only when it jumps; a new
+  // track, rate or status is when to ask for it again.
+  if (position_stale_) {
+    FetchPosition();
+  }
+}
+
+void MprisMediaBridge::Player::ReadRootProperty(const std::string& property,
+                                                dbus::MessageReader* value) {
+  if (property == "Identity") {
+    PopText(value, kMaxTextBytes, &identity_);
+  } else if (property == "CanRaise") {
+    PopBool(value, &can_raise_);
+  }
+}
+
+void MprisMediaBridge::Player::ReadPlayerProperty(const std::string& property,
+                                                  dbus::MessageReader* value) {
+  if (property == "PlaybackStatus") {
+    std::string status_name;
+    if (!PopText(value, kMaxTextBytes, &status_name)) {
+      return;
+    }
+    const Status status = status_name == "Playing"  ? Status::kPlaying
+                          : status_name == "Paused" ? Status::kPaused
+                                                    : Status::kStopped;
+    if (status != status_) {
+      RebasePosition();
+      status_ = status;
+      position_stale_ = true;
+    }
+  } else if (property == "Metadata") {
+    ReadMetadata(value);
+    position_stale_ = true;
+  } else if (property == "Rate") {
+    double rate;
+    if (value->GetDataType() == dbus::Message::DOUBLE &&
+        value->PopDouble(&rate) && rate != rate_) {
+      RebasePosition();
+      rate_ = rate;
+      position_stale_ = true;
+    }
+  } else if (property == "Position") {
+    if (std::optional<int64_t> position = PopNumber(value)) {
+      SetPosition(base::Microseconds(*position));
+    }
+  } else if (property == "CanPlay") {
+    PopBool(value, &can_play_);
+  } else if (property == "CanPause") {
+    PopBool(value, &can_pause_);
+  } else if (property == "CanGoNext") {
+    PopBool(value, &can_go_next_);
+  } else if (property == "CanGoPrevious") {
+    PopBool(value, &can_go_previous_);
+  } else if (property == "CanSeek") {
+    PopBool(value, &can_seek_);
+  } else if (property == "CanControl") {
+    PopBool(value, &can_control_);
+  }
+}
+
+void MprisMediaBridge::Player::ReadMetadata(dbus::MessageReader* value) {
+  const base::TimeDelta old_length = length_;
+  title_.clear();
+  artists_.clear();
+  album_.clear();
+  art_url_ = GURL();
+  track_id_.clear();
+  length_ = base::TimeDelta();
+
+  dbus::MessageReader array(nullptr);
+  if (value->PopArray(&array)) {
+    while (array.HasMoreData()) {
+      dbus::MessageReader entry(nullptr);
+      std::string key;
+      dbus::MessageReader field(nullptr);
+      if (!array.PopDictEntry(&entry) || !entry.PopString(&key) ||
+          !entry.PopVariant(&field)) {
+        break;
+      }
+      if (key == "xesam:title") {
+        PopText(&field, kMaxTextBytes, &title_);
+      } else if (key == "xesam:artist") {
+        PopTexts(&field, &artists_);
+      } else if (key == "xesam:album") {
+        PopText(&field, kMaxTextBytes, &album_);
+      } else if (key == "mpris:artUrl") {
+        std::string url;
+        if (PopText(&field, kMaxArtUrlBytes, &url) &&
+            url.size() < kMaxArtUrlBytes) {
+          art_url_ = GURL(url);
+        }
+      } else if (key == "mpris:trackid") {
+        PopText(&field, kMaxTextBytes, &track_id_);
+      } else if (key == "mpris:length") {
+        if (std::optional<int64_t> length = PopNumber(&field)) {
+          length_ = base::Microseconds(std::max<int64_t>(*length, 0));
+        }
+      }
+    }
+  }
+  if (length_ != old_length) {
+    position_changed_ = true;
+  }
+}
+
+base::TimeDelta MprisMediaBridge::Player::EstimatedPosition() const {
+  base::TimeDelta position = position_;
+  if (status_ == Status::kPlaying && !position_time_.is_null()) {
+    position += (base::TimeTicks::Now() - position_time_) * rate_;
+  }
+  if (length_.is_positive()) {
+    position = std::min(position, length_);
+  }
+  return std::max(position, base::TimeDelta());
+}
+
+void MprisMediaBridge::Player::RebasePosition() {
+  position_ = EstimatedPosition();
+  position_time_ = base::TimeTicks::Now();
+  position_changed_ = true;
+}
+
+void MprisMediaBridge::Player::SetPosition(base::TimeDelta position) {
+  position_ = std::max(position, base::TimeDelta());
+  position_time_ = base::TimeTicks::Now();
+  position_stale_ = false;
+  position_changed_ = true;
+}
+
+void MprisMediaBridge::Player::CallPlayer(const char* method) {
+  dbus::MethodCall method_call(kPlayerInterface, method);
+  proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+}
+
+std::string MprisMediaBridge::Player::DisplayTitle() const {
+  // A stream or a player between tracks may have no title; the controls show
+  // nothing without one, so the player's own name stands in.
+  return title_.empty() ? identity_ : title_;
+}
+
+media_session::mojom::MediaSessionInfoPtr MprisMediaBridge::Player::GetInfo()
+    const {
+  auto info = MediaSessionInfo::New();
+  const bool playing = status_ == Status::kPlaying;
+  info->state = playing ? MediaSessionInfo::SessionState::kActive
+                        : MediaSessionInfo::SessionState::kSuspended;
+  info->playback_state =
+      playing ? MediaPlaybackState::kPlaying : MediaPlaybackState::kPaused;
+  info->is_controllable = can_control_;
+  // A player that has not played since it was shown does not take the
+  // media keys or the lock screen from one that has.
+  info->ignore_for_active_session = focus_type_ != AudioFocusType::kGain;
+  return info;
+}
+
+media_session::MediaMetadata MprisMediaBridge::Player::GetMetadata() const {
+  media_session::MediaMetadata metadata;
+  metadata.title = base::UTF8ToUTF16(DisplayTitle());
+  metadata.artist = base::UTF8ToUTF16(base::JoinString(artists_, ", "));
+  metadata.album = base::UTF8ToUTF16(album_);
+  if (!title_.empty()) {
+    metadata.source_title = base::UTF8ToUTF16(identity_);
+  }
+  return metadata;
+}
+
+std::vector<MediaSessionAction> MprisMediaBridge::Player::GetActions() const {
+  std::vector<MediaSessionAction> actions;
+  if (!can_control_) {
+    return actions;
+  }
+  if (can_play_) {
+    actions.push_back(MediaSessionAction::kPlay);
+  }
+  if (can_pause_) {
+    actions.push_back(MediaSessionAction::kPause);
+  }
+  actions.push_back(MediaSessionAction::kStop);
+  if (can_go_previous_) {
+    actions.push_back(MediaSessionAction::kPreviousTrack);
+  }
+  if (can_go_next_) {
+    actions.push_back(MediaSessionAction::kNextTrack);
+  }
+  if (can_seek_ && length_.is_positive()) {
+    actions.push_back(MediaSessionAction::kSeekTo);
+    actions.push_back(MediaSessionAction::kScrubTo);
+    actions.push_back(MediaSessionAction::kSeekForward);
+    actions.push_back(MediaSessionAction::kSeekBackward);
+  }
+  if (can_raise_) {
+    actions.push_back(MediaSessionAction::kRaise);
+  }
+  return actions;
+}
+
+base::flat_map<MediaSessionImageType, std::vector<media_session::MediaImage>>
+MprisMediaBridge::Player::GetImages() const {
+  base::flat_map<MediaSessionImageType, std::vector<media_session::MediaImage>>
+      images;
+  if (art_url_.SchemeIsFile() || art_url_.SchemeIsHTTPOrHTTPS() ||
+      art_url_.SchemeIs(url::kDataScheme)) {
+    media_session::MediaImage image;
+    image.src = art_url_;
+    images[MediaSessionImageType::kArtwork].push_back(std::move(image));
+  }
+  return images;
+}
+
+std::optional<media_session::MediaPosition>
+MprisMediaBridge::Player::GetPosition() const {
+  if (!length_.is_positive()) {
+    return std::nullopt;
+  }
+  return media_session::MediaPosition(
+      status_ == Status::kPlaying ? rate_ : 0.0, length_, EstimatedPosition(),
+      /*end_of_media=*/false);
+}
+
+void MprisMediaBridge::Player::Update() {
+  if (!player_read_) {
+    return;
+  }
+  const bool playing = status_ == Status::kPlaying;
+  // Shown while it plays, and while paused once it has played or has a
+  // track loaded, as GNOME and KDE show a paused player.
+  const bool shown =
+      can_control_ && !DisplayTitle().empty() &&
+      (playing || (status_ == Status::kPaused &&
+                   (client_.is_bound() || !title_.empty())));
+  if (!shown) {
+    if (client_.is_bound()) {
+      client_->MediaSessionInfoChanged(GetInfo());
+      if (!stopped_timer_.IsRunning()) {
+        stopped_timer_.Start(
+            FROM_HERE, kStoppedGrace,
+            base::BindOnce(&Player::AbandonFocus, base::Unretained(this)));
+      }
+    }
+    was_playing_ = false;
+    NotifyObservers();
+    return;
+  }
+  stopped_timer_.Stop();
+  if (!client_.is_bound()) {
+    // Paused, the player shows without pausing whatever else plays.
+    RequestFocus(playing ? AudioFocusType::kGain : AudioFocusType::kAmbient);
+  } else if (playing && !was_playing_) {
+    // Started, from its own window or from the controls: what else plays
+    // pauses, as it would for a web page.
+    focus_type_ = AudioFocusType::kGain;
+    client_->RequestAudioFocus(GetInfo(), AudioFocusType::kGain,
+                               base::DoNothing());
+  } else {
+    client_->MediaSessionInfoChanged(GetInfo());
+  }
+  was_playing_ = playing && client_.is_bound();
+  NotifyObservers();
+}
+
+void MprisMediaBridge::Player::RequestFocus(AudioFocusType type) {
+  if (!bridge_->audio_focus_manager_.is_bound()) {
+    return;
+  }
+  focus_type_ = type;
+  focus_ever_requested_ = true;
+  bridge_->audio_focus_manager_->RequestGroupedAudioFocus(
+      request_id_, client_.BindNewPipeAndPassReceiver(),
+      receiver_.BindNewPipeAndPassRemote(), GetInfo(), type, group_id_,
+      base::BindOnce(&Player::OnFocusRequested,
+                     weak_ptr_factory_.GetWeakPtr()));
+  // The service going away takes the focus with it; the next change asks
+  // again.
+  client_.set_disconnect_handler(
+      base::BindOnce(&Player::AbandonFocus, base::Unretained(this)));
+}
+
+void MprisMediaBridge::Player::OnFocusRequested(bool success) {
+  if (success) {
+    focus_retries_ = 0;
+    return;
+  }
+  AbandonFocus();
+  if (++focus_retries_ > kMaxFocusRetries) {
+    LOG(WARNING) << "AuraDE media controls could not show " << name_;
+    return;
+  }
+  retry_timer_.Start(FROM_HERE, kFocusRetryDelay,
+                     base::BindOnce(&Player::Update, base::Unretained(this)));
+}
+
+void MprisMediaBridge::Player::AbandonFocus() {
+  stopped_timer_.Stop();
+  if (client_.is_bound()) {
+    client_->AbandonAudioFocus();
+  }
+  client_.reset();
+  receiver_.reset();
+  focus_type_ = AudioFocusType::kAmbient;
+  was_playing_ = false;
+}
+
+void MprisMediaBridge::Player::NotifyObservers() {
+  media_session::mojom::MediaSessionInfoPtr info = GetInfo();
+  if (!sent_info_ || !sent_info_.Equals(info)) {
+    for (auto& observer : observers_) {
+      observer->MediaSessionInfoChanged(info.Clone());
+    }
+    sent_info_ = std::move(info);
+  }
+
+  media_session::MediaMetadata metadata = GetMetadata();
+  if (sent_metadata_ != metadata) {
+    for (auto& observer : observers_) {
+      observer->MediaSessionMetadataChanged(metadata);
+    }
+    sent_metadata_ = std::move(metadata);
+  }
+
+  std::vector<MediaSessionAction> actions = GetActions();
+  if (sent_actions_ != actions) {
+    for (auto& observer : observers_) {
+      observer->MediaSessionActionsChanged(actions);
+    }
+    sent_actions_ = std::move(actions);
+  }
+
+  auto images = GetImages();
+  if (sent_images_ != images) {
+    for (auto& observer : observers_) {
+      observer->MediaSessionImagesChanged(images);
+    }
+    sent_images_ = std::move(images);
+  }
+
+  if (position_changed_) {
+    position_changed_ = false;
+    const std::optional<media_session::MediaPosition> position = GetPosition();
+    for (auto& observer : observers_) {
+      observer->MediaSessionPositionChanged(position);
+    }
+  }
+}
+
+MprisMediaBridge::MprisMediaBridge(
+    media_session::MediaSessionService* media_session_service,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : url_loader_factory_(std::move(url_loader_factory)) {
+  if (media_session_service) {
+    media_session_service->BindAudioFocusManager(
+        audio_focus_manager_.BindNewPipeAndPassReceiver());
+  }
+}
+
+MprisMediaBridge::~MprisMediaBridge() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  players_.clear();
+  artwork_loaders_.clear();
+  bus_proxy_ = nullptr;
+  if (bus_) {
+    bus_->ShutdownOnDBusThreadAndBlock();
+    bus_.reset();
+  }
+  if (dbus_thread_) {
+    dbus_thread_->Stop();
+  }
+}
+
+// static
+std::unique_ptr<MprisMediaBridge> MprisMediaBridge::Create(
+    media_session::MediaSessionService* media_session_service,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory) {
+  auto bridge = std::unique_ptr<MprisMediaBridge>(new MprisMediaBridge(
+      media_session_service, std::move(url_loader_factory)));
+  if (!bridge->Start()) {
+    return nullptr;
+  }
+  return bridge;
+}
+
+bool MprisMediaBridge::Start() {
+  dbus_thread_ = std::make_unique<base::Thread>("AuraDE media D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!dbus_thread_->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "AuraDE media controls could not start their D-Bus thread";
+    return false;
+  }
+
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SESSION;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = dbus_thread_->task_runner();
+  bus_ = new dbus::Bus(std::move(bus_options));
+  bus_proxy_ =
+      bus_->GetObjectProxy(kBusService, dbus::ObjectPath(kBusPath));
+  // Listen first, then list, so no player that starts in between is missed.
+  bus_proxy_->ConnectToSignal(
+      kBusInterface, "NameOwnerChanged",
+      base::BindRepeating(&MprisMediaBridge::OnNameOwnerChanged,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&MprisMediaBridge::OnNameOwnerChangedConnected,
+                     weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
+
+void MprisMediaBridge::OnNameOwnerChangedConnected(
+    const std::string& interface_name,
+    const std::string& signal_name,
+    bool success) {
+  LOG_IF(WARNING, !success)
+      << "AuraDE media controls will not see players start and stop";
+  dbus::MethodCall method_call(kBusInterface, "ListNames");
+  bus_proxy_->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                         base::BindOnce(&MprisMediaBridge::OnListNames,
+                                        weak_ptr_factory_.GetWeakPtr()));
+}
+
+void MprisMediaBridge::OnListNames(dbus::Response* response) {
+  std::vector<std::string> names;
+  if (!response) {
+    LOG(WARNING) << "AuraDE media controls could not list the session bus";
+    return;
+  }
+  dbus::MessageReader reader(response);
+  if (!reader.PopArrayOfStrings(&names)) {
+    return;
+  }
+  for (const std::string& name : names) {
+    if (!IsPlayerName(name)) {
+      continue;
+    }
+    dbus::MethodCall method_call(kBusInterface, "GetNameOwner");
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendString(name);
+    bus_proxy_->CallMethod(&method_call,
+                           dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                           base::BindOnce(&MprisMediaBridge::OnGetNameOwner,
+                                          weak_ptr_factory_.GetWeakPtr(),
+                                          name));
+  }
+}
+
+void MprisMediaBridge::OnGetNameOwner(const std::string& name,
+                                      dbus::Response* response) {
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string owner;
+  if (reader.PopString(&owner) && !owner.empty()) {
+    AddPlayer(name, owner);
+  }
+}
+
+void MprisMediaBridge::OnNameOwnerChanged(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  std::string name;
+  std::string old_owner;
+  std::string new_owner;
+  if (!reader.PopString(&name) || !reader.PopString(&old_owner) ||
+      !reader.PopString(&new_owner) || !IsPlayerName(name)) {
+    return;
+  }
+  if (!old_owner.empty()) {
+    RemovePlayer(name, old_owner);
+  }
+  if (!new_owner.empty()) {
+    AddPlayer(name, new_owner);
+  }
+}
+
+void MprisMediaBridge::AddPlayer(const std::string& name,
+                                 const std::string& owner) {
+  if (players_.contains(owner) || players_.size() >= kMaxPlayers) {
+    return;
+  }
+  players_.emplace(owner, std::make_unique<Player>(this, name, owner));
+}
+
+void MprisMediaBridge::RemovePlayer(const std::string& name,
+                                    const std::string& owner) {
+  auto player = players_.find(owner);
+  if (player != players_.end() && player->second->name() == name) {
+    players_.erase(player);
+  }
+}
+
+void MprisMediaBridge::LoadArtwork(const GURL& url,
+                                   int desired_size_px,
+                                   ArtworkCallback callback) {
+  if (url.SchemeIsFile()) {
+    base::FilePath path;
+    if (!net::FileURLToFilePath(url, &path)) {
+      std::move(callback).Run(SkBitmap());
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&ReadArtworkFile, path),
+        base::BindOnce(&DecodeArtwork, desired_size_px, std::move(callback)));
+    return;
+  }
+  if (url.SchemeIs(url::kDataScheme)) {
+    std::string mime_type;
+    std::string charset;
+    std::string data;
+    if (!net::DataURL::Parse(url, &mime_type, &charset, &data)) {
+      std::move(callback).Run(SkBitmap());
+      return;
+    }
+    DecodeArtwork(desired_size_px, std::move(callback), std::move(data));
+    return;
+  }
+  if (!url.SchemeIsHTTPOrHTTPS() || !url_loader_factory_) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  artwork_loaders_.push_front(network::SimpleURLLoader::Create(
+      std::move(request), kArtworkTrafficAnnotation));
+  auto loader = artwork_loaders_.begin();
+  (*loader)->SetTimeoutDuration(kArtworkDownloadTimeout);
+  // Unretained: the loader is this bridge's and never calls back once gone.
+  (*loader)->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&MprisMediaBridge::OnArtworkDownloaded,
+                     base::Unretained(this), loader, desired_size_px,
+                     std::move(callback)),
+      kMaxArtworkBytes);
+}
+
+void MprisMediaBridge::OnArtworkDownloaded(ArtworkLoaders::iterator loader,
+                                           int desired_size_px,
+                                           ArtworkCallback callback,
+                                           std::optional<std::string> body) {
+  artwork_loaders_.erase(loader);
+  DecodeArtwork(desired_size_px, std::move(callback), std::move(body));
+}
