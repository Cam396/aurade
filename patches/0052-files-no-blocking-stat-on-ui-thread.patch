+
 bool OpenLinuxVirtualTask::IsEnabled(Profile* profile) const {
   // AuraDE compatibility: use the freedesktop MIME database on generic Linux
   // while retaining ChromeOS task behavior on ChromeOS images.
-  return !base::SysInfo::IsRunningOnChromeOS() &&
-         base::PathExists(base::FilePath(kAuraDeHostControlPath));
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return false;
+  }
+
+  // This used to be a base::PathExists right here, and it took the desktop
+  // down.
+  //
+  // MatchVirtualTasks() calls IsEnabled() on every virtual task for every non
+  // empty selection, and it takes a raw Profile*, so it runs on the browser UI
+  // thread. base::PathExists wraps its stat in a ScopedBlockingCall, which
+  // calls AssertBlockingAllowed, and blocking is disallowed on that thread. In
+  // a build with DCHECKs on that is not a log line, it is fatal: selecting
+  // files in the Files app killed the whole session and the supervisor
+  // restarted it, with nothing on screen to say why.
+  //
+  // The helper is installed by the AuraDE package and does not come and go
+  // while the session runs, so one probe answers for the life of the process.
+  // Until it answers the task reports itself disabled, which costs at most the
+  // first task lookup after startup and never costs correctness: offering to
+  // open a file with a helper that is not there would be the worse failure.
+  if (!probe_started_) {
+    probe_started_ = true;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&base::PathExists,
+                       base::FilePath(kAuraDeHostControlPath)),
+        base::BindOnce(&OpenLinuxVirtualTask::OnHostControlProbed,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+  return host_control_present_;
 }
 
