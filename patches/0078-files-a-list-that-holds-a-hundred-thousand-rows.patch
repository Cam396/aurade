@@ -184,3 +184,21 @@
   line-height: 15px;
   padding: 2px 9px;
 }
+
+/* The list owns its scrolling. The spacer carries the full extent so the
+   scrollbar is honest about how much there is, and the surface holding the
+   recycled rows is moved rather than repositioned per row. */
+.aurade-list {
+  block-size: 100%;
+  overflow-y: auto;
+  overflow-x: hidden;
+  position: relative;
+}
+.aurade-list:focus-visible { outline: none; }
+.aurade-list-spacer { position: relative; }
+.aurade-list-surface {
+  inset-block-start: 0;
+  inset-inline: 0;
+  position: absolute;
+  will-change: transform;
+}
