diff --git a/ui/file_manager/file_manager/aurade/tests/harness/perf.py b/ui/file_manager/file_manager/aurade/tests/harness/perf.py
new file mode 100755
index 000000000000..03d2f58462ff
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/harness/perf.py
@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+"""Assert the list stays inside a frame budget at a hundred thousand rows.
+
+Reuses the golden harness's build and browser, because a second way to compile
+and launch the same code is a second thing to keep true.
+
+The budget is per scroll step rather than per frame. What is being defended is
+that the cost of a step is the cost of the rows on screen, so a regression that
+starts touching the whole list shows up here as a number that grows with the
+folder rather than staying flat.
+"""
+import argparse
+import importlib.util
+import json
+import os
+import shutil
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+spec = importlib.util.spec_from_file_location(
+    "golden", os.path.join(HERE, "golden.py"))
+golden = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(golden)
+
+FRAME_BUDGET_MS = 16.6
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--budget", type=float, default=FRAME_BUDGET_MS)
+    args = parser.parse_args()
+
+    work = tempfile.mkdtemp(prefix="aurade-perf-")
+    try:
+        golden.build(work)
+        shutil.copy(os.path.join(HERE, "perf.html"),
+                    os.path.join(work, "tests/harness/perf.html"))
+        server, port = golden.serve(work)
+        browser = golden.Browser(os.path.join(work, "profile"))
+        try:
+            browser.call("Emulation.setDeviceMetricsOverride", width=1000,
+                         height=700, deviceScaleFactor=1, mobile=False)
+            browser.call("Page.navigate",
+                         url="http://127.0.0.1:%d/tests/harness/perf.html" % port)
+            browser.wait_for("Page.loadEventFired")
+            import time
+            deadline = time.time() + 30
+            while time.time() < deadline:
+                ready = browser.call(
+                    "Runtime.evaluate", expression="!!window.auradeReady",
+                    returnByValue=True)
+                if ready.get("result", {}).get("value"):
+                    break
+                time.sleep(0.1)
+            else:
+                raise SystemExit("the benchmark page never loaded its module")
+
+            result = browser.call(
+                "Runtime.evaluate",
+                expression="JSON.stringify(window.auradeBench())",
+                returnByValue=True, awaitPromise=True)
+            if "exceptionDetails" in result:
+                raise SystemExit("the benchmark threw: %s"
+                                 % json.dumps(result["exceptionDetails"])[:400])
+            stats = json.loads(result["result"]["value"])
+        finally:
+            browser.close()
+            server.shutdown()
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+    print("  entries          %d" % stats["count"])
+    print("  build            %d ms" % stats["buildMs"])
+    print("  scroll steps     %d" % stats["steps"])
+    print("  mean per step    %.3f ms" % stats["meanStepMs"])
+    print("  p95 per step     %.3f ms" % stats["p95StepMs"])
+    print("  worst step       %.3f ms" % stats["worstStepMs"])
+    print("  nodes after build   %d" % stats["nodesAfterBuild"])
+    print("  nodes after scroll  %d" % stats["nodesAfterScroll"])
+
+    failures = []
+    if stats["meanStepMs"] > args.budget:
+        failures.append("mean step %.3f ms is over the %.1f ms budget"
+                        % (stats["meanStepMs"], args.budget))
+    if stats["p95StepMs"] > args.budget:
+        failures.append("p95 step %.3f ms is over the %.1f ms budget"
+                        % (stats["p95StepMs"], args.budget))
+    # The pool is the size of the viewport and does not grow, so scrolling the
+    # whole list must not add a node. Growth here means rows are being made and
+    # not recycled, which is the failure this whole component exists to avoid.
+    if stats["nodesAfterScroll"] > stats["nodesAfterBuild"]:
+        failures.append("scrolling added %d DOM nodes; rows are not being recycled"
+                        % (stats["nodesAfterScroll"] - stats["nodesAfterBuild"]))
+
+    if failures:
+        for line in failures:
+            print("  FAIL %s" % line)
+        return 1
+    print("\nlist benchmark: PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/ui/file_manager/file_manager/aurade/tests/harness/perf_page.ts b/ui/file_manager/file_manager/aurade/tests/harness/perf_page.ts
