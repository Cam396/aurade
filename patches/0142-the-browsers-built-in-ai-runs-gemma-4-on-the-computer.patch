+  if (!model) {
+    return false;
+  }
+  model->BuildTokenizer();
+  ChromeMLTokenizerParams params{
+      .vocab_size = model->n_vocab,
+      .eos_token_id = model->stop_token,
+      .token_lens = model->token_lens.data(),
+      .token_bytes =
+          reinterpret_cast<const uint8_t*>(model->token_bytes.data()),
+      .tokenizer_json_file_content = nullptr,
+      .tokenize_fn = &TokenizeForConstraint,
+      .tokenize_user_data = model,
+  };
+  fn(params);
+  return true;
+}
