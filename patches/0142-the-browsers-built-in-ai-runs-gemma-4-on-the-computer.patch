+TEST_F(AuraDELocalModelTest, JsonSchemaConstraint) {
+  auto session = StartSession();
+  session->Append(UserTurn("Rate this review from 1 to 5 and give the "
+                           "sentiment: 'Arrived broken, support never "
+                           "answered.'"),
+                  {});
+  auto options = mojom::GenerateOptions::New();
+  options->constraint = mojom::ResponseConstraint::NewJsonSchema(R"({
+    "type": "object",
+    "required": ["rating", "sentiment"],
+    "additionalProperties": false,
+    "properties": {
+      "rating": {"type": "integer", "minimum": 1, "maximum": 5},
+      "sentiment": {"type": "string", "enum": ["positive", "neutral", "negative"]}
+    }
+  })");
+  std::string answer = Generate(session, std::move(options));
+  LOG(INFO) << "JSON: " << answer;
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(answer, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed) << answer;
+  std::optional<int> rating = parsed->FindInt("rating");
+  ASSERT_TRUE(rating);
+  EXPECT_LE(*rating, 2);
+  const std::string* sentiment = parsed->FindString("sentiment");
+  ASSERT_TRUE(sentiment);
+  EXPECT_EQ(*sentiment, "negative");
+  EXPECT_EQ(parsed->size(), 2u);
+}
+
+TEST_F(AuraDELocalModelTest, RegexConstraint) {
+  auto session = StartSession();
+  session->Append(UserTurn("Is water wet?"), {});
+  auto options = mojom::GenerateOptions::New();
+  options->constraint = mojom::ResponseConstraint::NewRegex("(yes|no)");
+  std::string answer = Generate(session, std::move(options));
+  EXPECT_TRUE(answer == "yes" || answer == "no") << answer;
+}
+
+TEST_F(AuraDELocalModelTest, MaxOutputTokensIsHonored) {
+  auto session = StartSession();
+  session->Append(UserTurn("Write a long story about a lighthouse."), {});
+  auto options = mojom::GenerateOptions::New();
+  options->max_output_tokens = 12;
+  TestResponseHolder response;
+  session->Generate(std::move(options), response.BindRemote());
+  response.WaitForCompletion();
+  EXPECT_LE(response.output_token_count(), 12u);
+}
+
+TEST_F(AuraDELocalModelTest, CancelStopsGenerationQuickly) {
+  auto session = StartSession();
+  session->Append(UserTurn("Write a 2000 word essay on the history of tea."),
+                  {});
+  TestResponseHolder response;
+  session->Generate(mojom::GenerateOptions::New(), response.BindRemote());
+  // Wait for the first words, then drop the responder, as a page does when
+  // it aborts the prompt.
+  task_environment_.RunUntilIdle();
+  base::ElapsedTimer timer;
+  while (response.responses().empty() && timer.Elapsed().InSeconds() < 120) {
+    task_environment_.RunUntilIdle();
+  }
+  response.Disconnect();
+  // The session must still work right after.
+  base::ElapsedTimer after;
+  std::string answer = Ask(session, "Say only: done.");
+  EXPECT_NE(base::ToLowerASCII(answer).find("done"), std::string::npos)
+      << answer;
+  EXPECT_LT(after.Elapsed().InSeconds(), 60);
+}
+
+TEST_F(AuraDELocalModelTest, SizeInTokens) {
+  auto session = StartSession();
+  base::test::TestFuture<uint32_t> short_size;
+  session->GetSizeInTokens(MakeInput({"Hello there."}),
+                           short_size.GetCallback());
+  base::test::TestFuture<uint32_t> long_size;
+  session->GetSizeInTokens(
+      MakeInput({std::string(400, 'a') + " and many more words follow here"}),
+      long_size.GetCallback());
+  EXPECT_GT(short_size.Get(), 0u);
+  EXPECT_LT(short_size.Get(), 10u);
+  EXPECT_GT(long_size.Get(), short_size.Get());
+}
