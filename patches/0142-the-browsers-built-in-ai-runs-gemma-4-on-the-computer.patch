@@ -0,0 +1,1080 @@
+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The ChromeML library for AuraDE. Chrome loads it in place of the internal
+// optimization_guide_internal library and runs its on-device model features
+// (the Prompt, Summarizer, Writer, Rewriter and Proofreader APIs) through it.
+// The model is a GGUF file, by default Gemma 4, run by llama.cpp.
+//
+// llama.cpp is opened at run time through its C API only. Nothing of its C++
+// runtime crosses into Chrome, so the system llama.cpp build (CPU, Vulkan or
+// CUDA) can be swapped without rebuilding Chrome.
+
+#ifdef UNSAFE_BUFFERS_BUILD
+// The adapter works on raw llama.cpp buffers throughout.
+#pragma allow_unsafe_buffers
+#pragma allow_unsafe_libc_calls
+#endif
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <sys/random.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <random>
+#include <string>
+#include <thread>
+#include <variant>
+#include <vector>
+
+#include "llama.h"
+#include "services/on_device_model/ml/chrome_ml_api.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+
+namespace aurade_ml {
+namespace {
+
+// ---------------------------------------------------------------------------
+// llama.cpp, opened at run time.
+
+#define AURADE_LLAMA_FUNCTIONS(X)                                           \
+  X(llama_backend_init)                                                     \
+  X(llama_log_set)                                                          \
+  X(llama_model_default_params)                                             \
+  X(llama_context_default_params)                                           \
+  X(llama_model_load_from_file)                                             \
+  X(llama_model_load_from_file_ptr)                                         \
+  X(llama_model_free)                                                       \
+  X(llama_model_get_vocab)                                                  \
+  X(llama_model_n_ctx_train)                                                \
+  X(llama_init_from_model)                                                  \
+  X(llama_free)                                                             \
+  X(llama_n_ctx)                                                            \
+  X(llama_n_batch)                                                          \
+  X(llama_supports_gpu_offload)                                             \
+  X(llama_get_memory)                                                       \
+  X(llama_memory_clear)                                                     \
+  X(llama_memory_seq_rm)                                                    \
+  X(llama_batch_get_one)                                                    \
+  X(llama_decode)                                                           \
+  X(llama_get_logits_ith)                                                   \
+  X(llama_vocab_n_tokens)                                                   \
+  X(llama_vocab_is_eog)                                                     \
+  X(llama_vocab_is_control)                                                 \
+  X(llama_vocab_bos)                                                        \
+  X(llama_vocab_get_add_bos)                                                \
+  X(llama_tokenize)                                                         \
+  X(llama_token_to_piece)
+
+struct Llama {
+#define AURADE_DECLARE(name) decltype(&::name) name = nullptr;
+  AURADE_LLAMA_FUNCTIONS(AURADE_DECLARE)
+#undef AURADE_DECLARE
+};
+
+// AuraDE ships its own llama.cpp, built from the revision these headers come
+// from, so a distribution update can never change the structures this file
+// passes by value.
+constexpr char kDefaultLlamaLibrary[] = "/usr/lib/aurade-ai/libllama.so";
+
+const Llama* GetLlama() {
+  static const Llama* llama = []() -> const Llama* {
+    const char* override_path = getenv("AURADE_LOCAL_MODEL_LLAMA_LIBRARY");
+    const std::string library =
+        override_path && *override_path ? override_path : kDefaultLlamaLibrary;
+    // RTLD_DEEPBIND binds llama.cpp and ggml to the C library's allocator
+    // instead of Chrome's PartitionAlloc, which refuses the single
+    // multi-gigabyte buffers ggml uses for repacked CPU weights. Memory never
+    // crosses between the two: the llama.cpp C API hands none to callers.
+    void* handle =
+        dlopen(library.c_str(), RTLD_NOW | RTLD_LOCAL | RTLD_DEEPBIND);
+    if (!handle) {
+      fprintf(stderr, "aurade local model: cannot open llama.cpp: %s\n",
+              dlerror());
+      return nullptr;
+    }
+    auto* result = new Llama();
+#define AURADE_RESOLVE(name)                                                 \
+  result->name = reinterpret_cast<decltype(&::name)>(dlsym(handle, #name)); \
+  if (!result->name) {                                                       \
+    fprintf(stderr, "aurade local model: llama.cpp lacks %s\n", #name);      \
+    return nullptr;                                                          \
+  }
+    AURADE_LLAMA_FUNCTIONS(AURADE_RESOLVE)
+#undef AURADE_RESOLVE
+    if (!getenv("AURADE_LOCAL_MODEL_VERBOSE")) {
+      result->llama_log_set([](ggml_log_level level, const char* text,
+                               void*) {
+        if (level >= GGML_LOG_LEVEL_ERROR) {
+          fputs(text, stderr);
+        }
+      },
+                            nullptr);
+    }
+    // The CPU code comes as one loadable backend per instruction set, beside
+    // the library in ggml/. ggml picks the best one this processor runs. This
+    // happens before Chrome's sandbox closes, as does everything here.
+    using LoadAllFromPath = void (*)(const char*);
+    if (auto load_all = reinterpret_cast<LoadAllFromPath>(
+            dlsym(handle, "ggml_backend_load_all_from_path"))) {
+      const size_t slash = library.rfind('/');
+      const std::string dir =
+          (slash == std::string::npos ? std::string(".")
+                                      : library.substr(0, slash)) +
+          "/ggml";
+      // ggml opens these itself, without RTLD_DEEPBIND, and they would then
+      // free the C library's memory into PartitionAlloc. Opened here first,
+      // they keep the C library's allocator, and ggml gets the same handles.
+      if (DIR* backends = opendir(dir.c_str())) {
+        while (const dirent* entry = readdir(backends)) {
+          const std::string name = entry->d_name;
+          if (name.starts_with("libggml-") && name.ends_with(".so")) {
+            dlopen((dir + "/" + name).c_str(),
+                   RTLD_NOW | RTLD_LOCAL | RTLD_DEEPBIND);
+          }
+        }
+        closedir(backends);
+      }
+      load_all(dir.c_str());
+    }
+    result->llama_backend_init();
+    return result;
+  }();
+  return llama;
+}
+
+// std::random_device opens /dev/urandom, which the service's sandbox does not
+// allow. getrandom() is allowed.
+uint32_t RandomSeed() {
+  uint32_t seed = 0;
+  if (getrandom(&seed, sizeof(seed), 0) != sizeof(seed)) {
+    seed = static_cast<uint32_t>(
+        std::chrono::steady_clock::now().time_since_epoch().count());
+  }
+  return seed;
+}
+
+int EnvInt(const char* name, int fallback) {
+  const char* value = getenv(name);
+  return value && *value ? atoi(value) : fallback;
+}
+
+ChromeMLFatalErrorFn g_fatal_error_fn = nullptr;
+const ChromeMLConstraintFns* g_constraint_fns = nullptr;
+
+// ---------------------------------------------------------------------------
+// The model, its sessions and the one worker thread that touches llama.cpp.
+
+struct Cancel {
+  std::atomic<bool> cancelled{false};
+};
+
+// Chrome destroys a cancel handle as soon as the call that used it returns,
+// while the work it guards may still be queued here. The handle Chrome holds
+// is one reference; every queued job holds another.
+using CancelRef = std::shared_ptr<Cancel>;
+
+CancelRef RefFromHandle(ChromeMLCancel handle) {
+  return handle ? *reinterpret_cast<CancelRef*>(handle) : CancelRef();
+}
+
+struct Model;
+
+struct Session {
+  Model* model;
+  // Every token this session holds, from the first BOS on.
+  std::vector<llama_token> tokens;
+  float temperature = 0.0f;
+  uint32_t top_k = 1;
+  uint32_t max_tokens = 0;
+};
+
+// Gemma 4 turn markup. The markers are single control tokens; the role names
+// after them are ordinary text.
+struct Markup {
+  llama_token turn_open = -1;    // <|turn>
+  llama_token turn_close = -1;   // <turn|>
+  llama_token channel_open = -1; // <|channel>
+  llama_token channel_close = -1;  // <channel|>
+};
+
+struct Model {
+  const Llama* llama = nullptr;
+  llama_model* model = nullptr;
+  llama_context* context = nullptr;
+  // The weights file Chrome opened, kept for the model's lifetime since the
+  // weights are mapped from it.
+  FILE* weights = nullptr;
+  const llama_vocab* vocab = nullptr;
+  Markup markup;
+  uint32_t n_vocab = 0;
+  uint32_t max_tokens = 0;
+  // What the KV cache holds right now, shared by every session.
+  std::vector<llama_token> cached;
+  bool have_logits = false;
+
+  // Tokenizer data for Chrome's constraint code, built once.
+  std::once_flag tokenizer_once;
+  std::vector<uint32_t> token_lens;
+  std::string token_bytes;
+  uint32_t stop_token = 0;
+
+  // The worker.
+  std::mutex mutex;
+  std::condition_variable wake;
+  std::deque<std::function<void()>> jobs;
+  bool stopping = false;
+  std::thread worker;
+
+  void Post(std::function<void()> job) {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      jobs.push_back(std::move(job));
+    }
+    wake.notify_one();
+  }
+
+  void Run() {
+    for (;;) {
+      std::function<void()> job;
+      {
+        std::unique_lock<std::mutex> lock(mutex);
+        wake.wait(lock, [this] { return stopping || !jobs.empty(); });
+        if (jobs.empty()) {
+          return;
+        }
+        job = std::move(jobs.front());
+        jobs.pop_front();
+      }
+      job();
+    }
+  }
+
+  llama_token SingleToken(const char* text) const {
+    llama_token out[4];
+    int n = llama->llama_tokenize(vocab, text, strlen(text), out, 4,
+                                  /*add_special=*/false,
+                                  /*parse_special=*/true);
+    return n == 1 ? out[0] : -1;
+  }
+
+  std::vector<llama_token> Tokenize(const std::string& text) const {
+    std::vector<llama_token> out(text.size() + 8);
+    int n = llama->llama_tokenize(vocab, text.data(), text.size(), out.data(),
+                                  out.size(), /*add_special=*/false,
+                                  /*parse_special=*/false);
+    if (n < 0) {
+      out.resize(-n);
+      n = llama->llama_tokenize(vocab, text.data(), text.size(), out.data(),
+                                out.size(), false, false);
+    }
+    out.resize(std::max(n, 0));
+    return out;
+  }
+
+  std::string Piece(llama_token token) const {
+    char buffer[256];
+    int n = llama->llama_token_to_piece(vocab, token, buffer, sizeof(buffer),
+                                        /*lstrip=*/0, /*special=*/false);
+    return n > 0 ? std::string(buffer, n) : std::string();
+  }
+
+  // Turns Chrome's input pieces into tokens. User text is tokenized with
+  // special-token parsing off, so text that looks like markup stays text.
+  std::vector<llama_token> Render(const ml::InputPiece* pieces,
+                                  size_t count) const {
+    std::vector<llama_token> out;
+    auto open = [&](const char* role) {
+      out.push_back(markup.turn_open);
+      auto rest = Tokenize(std::string(role) + "\n");
+      out.insert(out.end(), rest.begin(), rest.end());
+    };
+    for (size_t i = 0; i < count; ++i) {
+      const ml::InputPiece& piece = pieces[i];
+      if (const auto* token = std::get_if<ml::Token>(&piece)) {
+        switch (*token) {
+          case ml::Token::kSystem:
+            open("system");
+            break;
+          case ml::Token::kUser:
+            open("user");
+            break;
+          case ml::Token::kModel:
+            open("model");
+            break;
+          case ml::Token::kEnd: {
+            out.push_back(markup.turn_close);
+            auto newline = Tokenize("\n");
+            out.insert(out.end(), newline.begin(), newline.end());
+            break;
+          }
+          case ml::Token::kThought: {
+            out.push_back(markup.channel_open);
+            auto rest = Tokenize("thought\n");
+            out.insert(out.end(), rest.begin(), rest.end());
+            break;
+          }
+          case ml::Token::kToolCall:
+          case ml::Token::kToolResponse:
+            // Tools are not wired up yet; the text pieces still go through.
+            break;
+        }
+      } else if (const auto* text = std::get_if<std::string>(&piece)) {
+        auto tokens = Tokenize(*text);
+        out.insert(out.end(), tokens.begin(), tokens.end());
+      }
+      // Images, audio and tool pieces are not supported by this backend; the
+      // capabilities it reports keep Chrome from sending them.
+    }
+    return out;
+  }
+
+  // Makes the KV cache hold exactly `tokens` and leaves logits for the last
+  // one. Reuses the longest common prefix with what is cached already.
+  bool Sync(const std::vector<llama_token>& tokens, const Cancel* cancel) {
+    if (tokens.empty()) {
+      return false;
+    }
+    size_t common = 0;
+    while (common < cached.size() && common < tokens.size() &&
+           cached[common] == tokens[common]) {
+      ++common;
+    }
+    // The last token always gets decoded again so its logits exist.
+    if (common == tokens.size()) {
+      if (have_logits && cached.size() == tokens.size()) {
+        return true;
+      }
+      --common;
+    }
+    llama_memory_t memory = llama->llama_get_memory(context);
+    if (!llama->llama_memory_seq_rm(memory, 0, common, -1)) {
+      llama->llama_memory_clear(memory, true);
+      common = 0;
+    }
+    cached.resize(common);
+    have_logits = false;
+    const size_t batch = llama->llama_n_batch(context);
+    while (cached.size() < tokens.size()) {
+      if (cancel && cancel->cancelled.load()) {
+        return false;
+      }
+      size_t n = std::min(batch, tokens.size() - cached.size());
+      std::vector<llama_token> chunk(tokens.begin() + cached.size(),
+                                     tokens.begin() + cached.size() + n);
+      if (llama->llama_decode(context, llama->llama_batch_get_one(
+                                           chunk.data(), chunk.size())) != 0) {
+        llama->llama_memory_clear(memory, true);
+        cached.clear();
+        return false;
+      }
+      cached.insert(cached.end(), chunk.begin(), chunk.end());
+    }
+    have_logits = true;
+    return true;
+  }
+
+  bool Step(llama_token token) {
+    if (llama->llama_decode(context, llama->llama_batch_get_one(&token, 1)) !=
+        0) {
+      return false;
+    }
+    cached.push_back(token);
+    have_logits = true;
+    return true;
+  }
+
+  void BuildTokenizer() {
+    std::call_once(tokenizer_once, [this] {
+      token_lens.resize(n_vocab);
+      for (uint32_t i = 0; i < n_vocab; ++i) {
+        std::string piece =
+            llama->llama_vocab_is_control(vocab, i) ? std::string() : Piece(i);
+        token_lens[i] = piece.size();
+        token_bytes += piece;
+      }
+      stop_token = markup.turn_close;
+    });
+  }
+};
+
+// A session's output decoder: holds back incomplete UTF-8 and splits the
+// thought channel from the answer.
+struct OutputDecoder {
+  std::string pending;
+  size_t Complete() const {
+    size_t n = pending.size();
+    size_t i = n;
+    // Walk back over at most 3 continuation bytes to the lead byte.
+    while (i > 0 && n - i < 4 && (pending[i - 1] & 0xC0) == 0x80) {
+      --i;
+    }
+    if (i == 0) {
+      return n;
+    }
+    unsigned char lead = pending[i - 1];
+    size_t need = lead < 0x80 ? 1 : (lead >> 5) == 6 ? 2 : (lead >> 4) == 14 ? 3
+                                                       : (lead >> 3) == 30 ? 4
+                                                                           : 1;
+    return (n - (i - 1)) >= need ? n : i - 1;
+  }
+  std::string Take(bool flush) {
+    size_t n = flush ? pending.size() : Complete();
+    std::string out = pending.substr(0, n);
+    pending.erase(0, n);
+    return out;
+  }
+};
+
+uint32_t SampleToken(Model& m,
+                     const float* logits,
+                     float temperature,
+                     uint32_t top_k,
+                     const uint32_t* mask,
+                     std::mt19937& rng) {
+  const uint32_t n = m.n_vocab;
+  auto allowed = [&](uint32_t t) {
+    return !mask || (mask[t / 32] >> (t % 32)) & 1u;
+  };
+  if (temperature <= 0.0f || top_k <= 1) {
+    uint32_t best = 0;
+    float best_logit = -std::numeric_limits<float>::infinity();
+    for (uint32_t t = 0; t < n; ++t) {
+      if (allowed(t) && logits[t] > best_logit) {
+        best_logit = logits[t];
+        best = t;
+      }
+    }
+    return best;
+  }
+  std::vector<std::pair<float, uint32_t>> candidates;
+  candidates.reserve(1024);
+  for (uint32_t t = 0; t < n; ++t) {
+    if (allowed(t)) {
+      candidates.emplace_back(logits[t], t);
+    }
+  }
+  if (candidates.empty()) {
+    return m.markup.turn_close;
+  }
+  size_t k = std::min<size_t>(top_k, candidates.size());
+  std::partial_sort(candidates.begin(), candidates.begin() + k,
+                    candidates.end(),
+                    [](const auto& a, const auto& b) { return a.first > b.first; });
+  candidates.resize(k);
+  float max_logit = candidates[0].first;
+  std::vector<double> weights;
+  for (const auto& [logit, token] : candidates) {
+    weights.push_back(std::exp((logit - max_logit) / temperature));
+  }
+  std::discrete_distribution<size_t> pick(weights.begin(), weights.end());
+  return candidates[pick(rng)].second;
+}
+
+void Emit(const ChromeMLGenerateOutputFn& fn,
+          const std::string& text,
+          const std::string& thought) {
+  if (text.empty() && thought.empty()) {
+    return;
+  }
+  ChromeMLGenerateOutput output{};
+  output.status = ChromeMLGenerateStatus::kInProgress;
+  output.text = text.empty() ? nullptr : text.c_str();
+  output.thought = thought.empty() ? nullptr : thought.c_str();
+  fn(&output);
+}
+
+void Generate(Session* session,
+              uint32_t max_output_tokens,
+              ChromeMLConstraint constraint,
+              const ChromeMLGenerateOutputFn& fn,
+              const Cancel* cancel) {
+  Model& m = *session->model;
+  int decoded = 0;
+  if (m.Sync(session->tokens, cancel)) {
+    std::mt19937 rng(RandomSeed());
+    std::vector<uint32_t> mask_storage;
+    OutputDecoder answer, thought;
+    bool in_thought = false;
+    bool thought_label_dropped = false;
+    bool continue_without_emit = false;
+    uint32_t limit = max_output_tokens ? max_output_tokens : 4096;
+    const uint32_t room = m.max_tokens > session->tokens.size()
+                              ? m.max_tokens - session->tokens.size()
+                              : 0;
+    limit = std::min(limit, room);
+    for (uint32_t i = 0; i < limit; ++i) {
+      if (cancel && cancel->cancelled.load()) {
+        break;
+      }
+      const uint32_t* mask = nullptr;
+      if (constraint && g_constraint_fns) {
+        ChromeMLConstraintMask constraint_mask{};
+        if (!g_constraint_fns->ComputeMask(constraint, constraint_mask)) {
+          break;
+        }
+        if (constraint_mask.is_stop) {
+          break;
+        }
+        mask = constraint_mask.sample_mask;
+      }
+      const float* logits = m.llama->llama_get_logits_ith(m.context, -1);
+      llama_token token = SampleToken(m, logits, session->temperature,
+                                      session->top_k, mask, rng);
+      if (constraint && g_constraint_fns) {
+        g_constraint_fns->CommitToken(constraint, token);
+      }
+      session->tokens.push_back(token);
+      ++decoded;
+      if (token == m.markup.turn_close ||
+          m.llama->llama_vocab_is_eog(m.vocab, token)) {
+        break;
+      }
+      if (token == m.markup.channel_open) {
+        in_thought = true;
+        thought_label_dropped = false;
+      } else if (token == m.markup.channel_close) {
+        in_thought = false;
+        Emit(fn, std::string(), thought.Take(/*flush=*/true));
+      } else if (!m.llama->llama_vocab_is_control(m.vocab, token)) {
+        (in_thought ? thought : answer).pending += m.Piece(token);
+        if (in_thought && !thought_label_dropped) {
+          const std::string label = "thought\n";
+          if (thought.pending.size() >= label.size() ||
+              label.compare(0, thought.pending.size(), thought.pending) != 0) {
+            if (thought.pending.compare(0, label.size(), label) == 0) {
+              thought.pending.erase(0, label.size());
+            }
+            thought_label_dropped = true;
+          } else {
+            continue_without_emit = true;
+          }
+        }
+        if (continue_without_emit) {
+          continue_without_emit = false;
+        } else if (in_thought) {
+          Emit(fn, std::string(), thought.Take(false));
+        } else {
+          Emit(fn, answer.Take(false), std::string());
+        }
+      }
+      if (constraint && g_constraint_fns &&
+          g_constraint_fns->IsStopped(constraint)) {
+        break;
+      }
+      if (!m.Step(token)) {
+        break;
+      }
+    }
+    // A thought channel the model opened carries its name ("thought\n") as
+    // its first text; Chrome only wants the reasoning.
+    Emit(fn, answer.Take(true), thought.Take(true));
+    // Close the model's turn in the session so the next Append continues a
+    // well formed conversation, as Chrome's own backend does.
+    if (session->tokens.empty() ||
+        session->tokens.back() != m.markup.turn_close) {
+      session->tokens.push_back(m.markup.turn_close);
+    }
+  }
+  if (constraint && g_constraint_fns) {
+    g_constraint_fns->Delete(constraint);
+  }
+  ChromeMLGenerateOutput done{};
+  done.status = ChromeMLGenerateStatus::kComplete;
+  done.tokens_decoded = decoded;
+  fn(&done);
+}
