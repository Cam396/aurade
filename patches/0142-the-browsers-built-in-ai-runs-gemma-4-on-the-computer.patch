+
+// Writes the model manifest and the per-feature configs that let Chrome's
+// built-in AI run on Gemma 4 through the llama.cpp backend in this directory.
+//
+//   aurade_model_config <output dir>
+//
+// The output directory then holds manifest.binarypb and one config per use
+// case. Chrome finds it through --optimization-guide-manifest-override, a
+// JSON file that also maps the model component below to the folder that holds
+// the weights. model.conf names that component for the AuraDE launcher, which
+// writes the JSON file.
+
+#include <string>
+
