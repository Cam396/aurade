+TEST_F(AuraDELocalModelTest, NonAsciiOutputIsWholeCharacters) {
+  auto session = StartSession();
+  std::string answer = Ask(session, "Say 'good morning' in Japanese, in "
+                                    "Japanese script only.");
+  EXPECT_TRUE(base::IsStringUTF8(answer)) << answer;
+  EXPECT_FALSE(answer.empty());
+}
