+TEST_F(AuraDELocalModelTest, AnswersAndStreams) {
+  auto session = StartSession();
+  session->Append(UserTurn("What is the capital of France? One word."), {});
+  size_t chunks = 0;
+  std::string answer = Generate(session, nullptr, &chunks);
+  EXPECT_NE(answer.find("Paris"), std::string::npos) << answer;
+  EXPECT_GE(chunks, 1u);
+}
+
+TEST_F(AuraDELocalModelTest, StreamsLongAnswersInPieces) {
+  auto session = StartSession();
+  session->Append(UserTurn("Count from one to twenty in words, comma "
+                           "separated."),
+                  {});
+  size_t chunks = 0;
+  std::string answer = Generate(session, nullptr, &chunks);
+  EXPECT_NE(base::ToLowerASCII(answer).find("twenty"), std::string::npos)
+      << answer;
+  EXPECT_GT(chunks, 5u);
+}
+
+TEST_F(AuraDELocalModelTest, SystemPromptApplies) {
+  auto session = StartSession();
+  session->Append(SystemTurn("Always answer in French."), {});
+  std::string answer = Ask(session, "What color is the sky on a clear day?");
+  std::string lower = base::ToLowerASCII(answer);
+  EXPECT_NE(lower.find("bleu"), std::string::npos) << answer;
+}
+
+TEST_F(AuraDELocalModelTest, RemembersEarlierTurns) {
+  auto session = StartSession();
+  Ask(session, "My cat is called Zorblat. Just say OK.");
+  std::string answer = Ask(session, "What is my cat called?");
+  EXPECT_NE(answer.find("Zorblat"), std::string::npos) << answer;
+}
+
+TEST_F(AuraDELocalModelTest, ClonesKeepContextAndDiverge) {
+  auto session = StartSession();
+  Ask(session, "Remember the number 4817. Just say OK.");
+  mojo::Remote<mojom::Session> clone;
+  session->Clone(clone.BindNewPipeAndPassReceiver());
+  std::string from_clone = Ask(clone, "What number did I ask you to remember?");
+  EXPECT_NE(from_clone.find("4817"), std::string::npos) << from_clone;
+  Ask(clone, "Also remember the word pineapple. Just say OK.");
+  // The original never saw the clone's turns.
+  std::string from_original = base::ToLowerASCII(
+      Ask(session, "List everything I asked you to remember, nothing else."));
+  EXPECT_NE(from_original.find("4817"), std::string::npos) << from_original;
+  EXPECT_EQ(from_original.find("pineapple"), std::string::npos)
+      << from_original;
+  // And the clone has both.
+  std::string from_clone_after = base::ToLowerASCII(
+      Ask(clone, "List everything I asked you to remember, nothing else."));
+  EXPECT_NE(from_clone_after.find("4817"), std::string::npos)
+      << from_clone_after;
+  EXPECT_NE(from_clone_after.find("pineapple"), std::string::npos)
+      << from_clone_after;
+}
