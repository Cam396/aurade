+TEST_F(AuraDELocalModelTest, ScorePrefersTheRightAnswer) {
+  auto session = StartSession();
+  auto options = mojom::AppendOptions::New();
+  options->input = MakeInput({ml::Token::kUser,
+                              "What is the capital of France? One word.",
+                              ml::Token::kEnd, ml::Token::kModel});
+  session->Append(std::move(options), {});
+  base::test::TestFuture<float> paris, london;
+  session->Score("Paris", paris.GetCallback());
+  session->Score("London", london.GetCallback());
+  LOG(INFO) << "Score Paris=" << paris.Get() << " London=" << london.Get();
+  EXPECT_GT(paris.Get(), london.Get());
+  EXPECT_GT(paris.Get(), 0.5f);
+}
