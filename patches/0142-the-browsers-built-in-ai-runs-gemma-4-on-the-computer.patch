+
+// The probability the model gives to `text` coming next, from its first
+// token: what Chrome uses Score for (yes/no style classification).
+void SessionScore(ChromeMLSession handle,
+                  const std::string& text,
+                  const ChromeMLScoreFn& fn) {
+  auto* session = reinterpret_cast<Session*>(handle);
+  if (!session) {
+    fn(0.0f);
+    return;
+  }
+  ChromeMLScoreFn copy = fn;
+  session->model->Post([session, text, copy] {
+    Model& m = *session->model;
+    std::vector<llama_token> tokens = m.Tokenize(text);
+    if (tokens.empty() || !m.Sync(session->tokens, nullptr)) {
+      copy(0.0f);
+      return;
+    }
+    const float* logits = m.llama->llama_get_logits_ith(m.context, -1);
+    float max_logit = *std::max_element(logits, logits + m.n_vocab);
+    double sum = 0;
+    for (uint32_t t = 0; t < m.n_vocab; ++t) {
+      sum += std::exp(logits[t] - max_logit);
+    }
+    copy(static_cast<float>(std::exp(logits[tokens[0]] - max_logit) / sum));
+  });
+}
+
+void SessionGetProbabilitiesBlocking(
+    ChromeMLSession handle,
+    const std::string& input,
+    const ChromeMLGetProbabilitiesBlockingFn& fn) {
+  auto* session = reinterpret_cast<Session*>(handle);
+  if (!session) {
+    fn({});
+    return;
+  }
+  std::mutex done_mutex;
+  std::condition_variable done;
+  bool finished = false;
+  std::vector<float> result;
+  session->model->Post([&] {
+    Model& m = *session->model;
+    std::vector<llama_token> tokens = session->tokens;
+    auto more = m.Tokenize(input);
+    tokens.insert(tokens.end(), more.begin(), more.end());
+    if (m.Sync(tokens, nullptr)) {
+      const float* logits = m.llama->llama_get_logits_ith(m.context, -1);
+      float max_logit = *std::max_element(logits, logits + m.n_vocab);
+      double sum = 0;
+      result.resize(m.n_vocab);
+      for (uint32_t t = 0; t < m.n_vocab; ++t) {
+        result[t] = std::exp(logits[t] - max_logit);
+        sum += result[t];
+      }
+      for (float& p : result) {
+        p = static_cast<float>(p / sum);
+      }
+    }
+    std::lock_guard<std::mutex> lock(done_mutex);
+    finished = true;
+    done.notify_one();
+  });
+  std::unique_lock<std::mutex> lock(done_mutex);
+  done.wait(lock, [&] { return finished; });
+  fn(result);
+}
