+ChromeMLModel SessionCreateModel(const ChromeMLModelDescriptor* descriptor,
+                                 uintptr_t,
+                                 ChromeMLScheduleFn) {
+  const Llama* llama = GetLlama();
+  if (!llama || !descriptor || !descriptor->model_data) {
+    return 0;
+  }
+  const ChromeMLModelData& data = *descriptor->model_data;
+  if (data.weights_file == kInvalidPlatformFile && !data.model_path) {
+    return 0;
+  }
+  for (PlatformFile cache : {data.cache_file, data.encoder_cache_file,
+                             data.adapter_cache_file, data.program_cache_file}) {
+    if (cache != kInvalidPlatformFile) {
+      close(cache);
+    }
+  }
+
+  auto model = std::make_unique<Model>();
+  model->llama = llama;
+  llama_model_params model_params = llama->llama_model_default_params();
+  model_params.n_gpu_layers = EnvInt(
+      "AURADE_LOCAL_MODEL_GPU_LAYERS",
+      llama->llama_supports_gpu_offload() ? 999 : 0);
+  // In Chrome the service is sandboxed and cannot open files itself: the
+  // weights arrive as an open file and are read from it.
+  if (data.weights_file != kInvalidPlatformFile) {
+    model->weights = fdopen(data.weights_file, "rb");
+    if (!model->weights) {
+      close(data.weights_file);
+      return 0;
+    }
+    model->model =
+        llama->llama_model_load_from_file_ptr(model->weights, model_params);
+  } else {
+    model->model =
+        llama->llama_model_load_from_file(data.model_path, model_params);
+  }
+  if (!model->model) {
+    fprintf(stderr, "aurade local model: cannot load the model\n");
+    if (model->weights) {
+      fclose(model->weights);
+    }
+    return 0;
+  }
+  model->vocab = llama->llama_model_get_vocab(model->model);
+  model->n_vocab = llama->llama_vocab_n_tokens(model->vocab);
+  model->markup.turn_open = model->SingleToken("<|turn>");
+  model->markup.turn_close = model->SingleToken("<turn|>");
+  model->markup.channel_open = model->SingleToken("<|channel>");
+  model->markup.channel_close = model->SingleToken("<channel|>");
+  if (model->markup.turn_open < 0 || model->markup.turn_close < 0) {
+    fprintf(stderr, "aurade local model: not a Gemma 4 vocabulary\n");
+    llama->llama_model_free(model->model);
+    if (model->weights) {
+      fclose(model->weights);
+    }
+    return 0;
+  }
+
+  uint32_t context_size = std::max<uint32_t>(descriptor->max_tokens, 2048);
+  context_size = std::min<uint32_t>(
+      context_size, llama->llama_model_n_ctx_train(model->model));
+  context_size =
+      EnvInt("AURADE_LOCAL_MODEL_CONTEXT", static_cast<int>(context_size));
+  llama_context_params context_params = llama->llama_context_default_params();
+  context_params.n_ctx = context_size;
+  context_params.n_batch = 512;
+  context_params.n_ubatch = 512;
+  // Keep the whole sliding-window cache so a shared prefix can be reused.
+  context_params.swa_full = true;
+  int threads = EnvInt("AURADE_LOCAL_MODEL_THREADS", 0);
+  if (threads <= 0) {
+    threads = std::max(1u, std::thread::hardware_concurrency() / 2);
+  }
+  context_params.n_threads = threads;
+  context_params.n_threads_batch = threads;
+  model->context = llama->llama_init_from_model(model->model, context_params);
+  if (!model->context) {
+    llama->llama_model_free(model->model);
+    if (model->weights) {
+      fclose(model->weights);
+    }
+    return 0;
+  }
+  model->max_tokens = llama->llama_n_ctx(model->context);
+  Model* raw = model.release();
+  raw->worker = std::thread([raw] { raw->Run(); });
+  return reinterpret_cast<ChromeMLModel>(raw);
+}
+
+void DestroyModel(ChromeMLModel handle) {
+  auto* model = reinterpret_cast<Model*>(handle);
+  if (!model) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(model->mutex);
+    model->stopping = true;
+  }
+  model->wake.notify_one();
+  model->worker.join();
+  model->llama->llama_free(model->context);
+  model->llama->llama_model_free(model->model);
+  if (model->weights) {
+    fclose(model->weights);
+  }
+  delete model;
+}
+
+ChromeMLSession CreateSession(ChromeMLModel handle,
+                              const ChromeMLAdaptationDescriptor* descriptor) {
+  auto* model = reinterpret_cast<Model*>(handle);
+  if (!model) {
+    return 0;
+  }
+  auto* session = new Session();
+  session->model = model;
+  if (descriptor) {
+    session->temperature = descriptor->temperature;
+    session->top_k = std::max<uint32_t>(1, descriptor->top_k);
+    session->max_tokens = descriptor->max_tokens;
+    if (descriptor->model_data &&
+        descriptor->model_data->weights_file != kInvalidPlatformFile) {
+      // Gemini Nano feature adaptations do not apply to Gemma; the base
+      // model handles every feature through its prompt.
+      close(descriptor->model_data->weights_file);
+    }
+  }
+  if (model->llama->llama_vocab_get_add_bos(model->vocab)) {
+    session->tokens.push_back(model->llama->llama_vocab_bos(model->vocab));
+  }
+  return reinterpret_cast<ChromeMLSession>(session);
+}
+
+ChromeMLSession CloneSession(ChromeMLSession handle) {
+  auto* session = reinterpret_cast<Session*>(handle);
+  if (!session) {
+    return 0;
+  }
+  // Appends queued before the clone must be in it, so the copy is queued too.
+  auto* clone = new Session();
+  clone->model = session->model;
+  session->model->Post([session, clone] { *clone = *session; });
+  return reinterpret_cast<ChromeMLSession>(clone);
+}
+
+void DestroySession(ChromeMLSession handle) {
+  auto* session = reinterpret_cast<Session*>(handle);
+  if (!session) {
+    return;
+  }
+  // Jobs queued for this session run first.
+  session->model->Post([session] { delete session; });
+}
