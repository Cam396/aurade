+TEST_F(AuraDELocalModelTest, SamplingWithTemperatureVaries) {
+  std::set<std::string> answers;
+  for (int i = 0; i < 4; ++i) {
+    auto session = StartSession(/*temperature=*/1.0f, /*top_k=*/40);
+    answers.insert(Ask(session, "Invent a name for a pet goldfish. One word."));
+  }
+  EXPECT_GT(answers.size(), 1u);
+}
