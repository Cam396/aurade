+
+bool SessionAppend(ChromeMLSession handle,
+                   const ChromeMLAppendOptions* options,
+                   ChromeMLCancel cancel_handle) {
+  auto* session = reinterpret_cast<Session*>(handle);
+  if (!session || !options) {
+    return false;
+  }
+  Model* model = session->model;
+  std::vector<llama_token> tokens =
+      model->Render(options->input, options->input_size);
+  if (options->max_tokens && tokens.size() > options->max_tokens) {
+    tokens.resize(options->max_tokens);
+  }
+  std::optional<ChromeMLContextSavedFn> saved;
+  if (options->context_saved_fn && *options->context_saved_fn) {
+    saved = *options->context_saved_fn;
+  }
+  CancelRef cancel = RefFromHandle(cancel_handle);
+  model->Post([session, tokens = std::move(tokens), saved, cancel]() mutable {
+    Model& m = *session->model;
+    const size_t room = m.max_tokens > session->tokens.size()
+                            ? m.max_tokens - session->tokens.size()
+                            : 0;
+    if (tokens.size() > room) {
+      tokens.resize(room);
+    }
+    session->tokens.insert(session->tokens.end(), tokens.begin(),
+                           tokens.end());
+    // Prefill now, so a later Generate starts at once.
+    m.Sync(session->tokens, cancel.get());
+    if (saved) {
+      (*saved)(static_cast<int>(tokens.size()));
+    }
+  });
+  return true;
+}
+
+bool SessionGenerate(ChromeMLSession handle,
+                     const ChromeMLGenerateOptions* options,
+                     ChromeMLCancel cancel_handle) {
+  auto* session = reinterpret_cast<Session*>(handle);
+  if (!session || !options || !options->output_fn) {
+    return false;
+  }
+  ChromeMLGenerateOutputFn fn = *options->output_fn;
+  uint32_t max_output_tokens = options->max_output_tokens;
+  ChromeMLConstraint constraint = options->constraint;
+  CancelRef cancel = RefFromHandle(cancel_handle);
+  session->model->Post([session, max_output_tokens, constraint, fn, cancel] {
+    Generate(session, max_output_tokens, constraint, fn, cancel.get());
+  });
+  return true;
+}
