+
+size_t TokenizeForConstraint(const void* user_data,
+                             const uint8_t* bytes,
+                             size_t bytes_len,
+                             uint32_t* output_tokens,
+                             size_t output_tokens_len) {
+  const auto* model = static_cast<const Model*>(user_data);
+  auto tokens = model->Tokenize(
+      std::string(reinterpret_cast<const char*>(bytes), bytes_len));
+  for (size_t i = 0; i < std::min(tokens.size(), output_tokens_len); ++i) {
+    output_tokens[i] = tokens[i];
+  }
+  return tokens.size();
+}
