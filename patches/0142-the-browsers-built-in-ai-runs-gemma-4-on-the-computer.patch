+mojom::InputPtr MakeInput(std::vector<ml::InputPiece> pieces) {
+  auto input = mojom::Input::New();
+  for (auto& piece : pieces) {
+    if (auto* token = std::get_if<ml::Token>(&piece)) {
+      input->pieces.push_back(mojom::InputPiece::NewToken(*token));
+    } else if (auto* text = std::get_if<std::string>(&piece)) {
+      input->pieces.push_back(mojom::InputPiece::NewText(*text));
+    }
+  }
+  return input;
+}
+
+// A prompt as the Prompt API frames it: one user turn, then the model's.
+mojom::AppendOptionsPtr UserTurn(const std::string& text) {
+  auto options = mojom::AppendOptions::New();
+  options->input = MakeInput(
+      {ml::Token::kUser, text, ml::Token::kEnd, ml::Token::kModel});
+  options->input_source = mojom::InputSource::kUserInput;
+  return options;
+}
+
+mojom::AppendOptionsPtr SystemTurn(const std::string& text) {
+  auto options = mojom::AppendOptions::New();
+  options->input = MakeInput({ml::Token::kSystem, text, ml::Token::kEnd});
+  options->input_source = mojom::InputSource::kUserInput;
+  return options;
+}
+
+std::string Join(const std::vector<std::string>& pieces) {
+  std::string out;
+  for (const auto& piece : pieces) {
+    out += piece;
+  }
+  return out;
+}
+
+class AuraDELocalModelTest : public testing::Test {
+ public:
+  void SetUp() override {
+    std::optional<std::string> path =
+        base::Environment::Create()->GetVar("AURADE_TEST_MODEL");
+    if (!path) {
+      GTEST_SKIP() << "AURADE_TEST_MODEL is not set";
+    }
+    chrome_ml_ = ml::ChromeML::Get();
+    ASSERT_TRUE(chrome_ml_) << "liboptimization_guide_internal did not load";
+    service_impl_ = std::make_unique<OnDeviceModelService>(
+        service_.BindNewPipeAndPassReceiver(), *chrome_ml_);
+
+    auto params = mojom::LoadModelParams::New();
+    params->backend_type = ml::ModelBackendType::kCpuBackend;
+    params->performance_hint = ml::ModelPerformanceHint::kHighestQuality;
+    params->max_tokens = 8192;
+    params->assets = ModelAssets::FromPath(base::FilePath(*path));
+    base::test::TestFuture<mojom::LoadModelResult> loaded;
+    base::ElapsedTimer timer;
+    service_->LoadModel(std::move(params), model_.BindNewPipeAndPassReceiver(),
+                        loaded.GetCallback());
+    ASSERT_EQ(loaded.Get(), mojom::LoadModelResult::kSuccess);
+    LOG(INFO) << "model loaded in " << timer.Elapsed().InMilliseconds()
+              << " ms";
+  }
+
+  mojo::Remote<mojom::Session> StartSession(float temperature = 0.0f,
+                                            uint32_t top_k = 1) {
+    mojo::Remote<mojom::Session> session;
+    auto params = mojom::SessionParams::New();
+    params->temperature = temperature;
+    params->top_k = top_k;
+    model_->StartSession(session.BindNewPipeAndPassReceiver(),
+                         std::move(params));
+    return session;
+  }
+
+  std::string Generate(mojo::Remote<mojom::Session>& session,
+                       mojom::GenerateOptionsPtr options = nullptr,
+                       size_t* chunks = nullptr) {
+    TestResponseHolder response;
+    session->Generate(options ? std::move(options)
+                              : mojom::GenerateOptions::New(),
+                      response.BindRemote());
+    response.WaitForCompletion();
+    EXPECT_TRUE(response.complete());
+    if (chunks) {
+      *chunks = response.responses().size();
+    }
+    return Join(response.responses());
+  }
+
+  std::string Ask(mojo::Remote<mojom::Session>& session,
+                  const std::string& prompt) {
+    session->Append(UserTurn(prompt), {});
+    std::string answer = Generate(session);
+    LOG(INFO) << "Q: " << prompt << "\nA: " << answer;
+    return answer;
+  }
+
+ protected:
+  base::test::TaskEnvironment task_environment_;
+  raw_ptr<ml::ChromeML> chrome_ml_ = nullptr;
+  mojo::Remote<mojom::OnDeviceModelService> service_;
+  std::unique_ptr<OnDeviceModelService> service_impl_;
+  mojo::Remote<mojom::OnDeviceModel> model_;
+};
