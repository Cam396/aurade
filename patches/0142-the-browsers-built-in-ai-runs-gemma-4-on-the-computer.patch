+import("//services/on_device_model/on_device_model.gni")
+import("//testing/test.gni")
+
+# The ChromeML library Chrome loads from its own directory as
+# liboptimization_guide_internal.so. AuraDE's runs a GGUF model through its
+# own llama.cpp build, which it opens at run time.
+shared_library("llama_chrome_ml") {
+  output_name = "optimization_guide_internal"
+  sources = [ "llama_chrome_ml.cc" ]
+  include_dirs = [ "llama_include" ]
+  deps = [
+    "//services/on_device_model/ml:api",
+    "//third_party/dawn/src/dawn/native:headers",
+  ]
+  libs = [ "dl" ]
+  data_deps = [ ":model_config" ]
+
+  # SkBitmap is only named in Chrome's input type, never used here.
+  configs += [ "//skia:skia_config" ]
+  configs -= [ "//build/config/compiler:chromium_code" ]
+  configs += [ "//build/config/compiler:no_chromium_code" ]
+
+  # Plain C structures shared with llama.cpp, not Chromium objects.
+  configs -= [ "//build/config/clang:find_bad_constructs" ]
+}
+
+# Writes the model manifest and the per-feature prompt configs.
+executable("aurade_model_config") {
+  sources = [ "model_config/aurade_model_config.cc" ]
+  deps = [
+    "//base",
+    "//components/optimization_guide/core/model_execution/configs:manifest_builder",
+    "//components/optimization_guide/core/model_execution/configs:substitution_builders",
+    "//components/optimization_guide/core/model_execution/configs:summarize_config",
+    "//components/optimization_guide/proto:optimization_guide_proto",
+  ]
+}
+
+_model_config_dir = "$root_out_dir/aurade_local_model"
+
+action("model_config") {
+  script = "//build/gn_run_binary.py"
+  _tool = "$root_out_dir/aurade_model_config"
+  inputs = [ _tool ]
+  outputs = [
+    "$_model_config_dir/manifest.binarypb",
+    "$_model_config_dir/model.conf",
+    "$_model_config_dir/prompt_api.binarypb",
+    "$_model_config_dir/proofreader_api.binarypb",
+    "$_model_config_dir/summarizer_api.binarypb",
+    "$_model_config_dir/writing_assistance_api.binarypb",
+  ]
+  args = [
+    rebase_path(_tool, root_build_dir),
+    rebase_path(_model_config_dir, root_build_dir),
+  ]
+  deps = [ ":aurade_model_config" ]
+}
