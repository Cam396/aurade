+constexpr char kAuraDeUseHostPowerStatus[] = "AURADE_USE_HOST_POWER_STATUS";
+constexpr char kBacklightPath[] = "/sys/class/backlight";
+constexpr char kPowerSupplyPath[] = "/sys/class/power_supply";
+constexpr char kAuraDePowerStatePath[] = "/run/aurade/power-state.json";
+constexpr double kBacklightStepPercent = 10.0;
+constexpr double kMinimumVisibleBacklightPercent = 1.0;
+
+struct HostBacklightState {
+  base::FilePath path;
+  int64_t brightness = 0;
+  int64_t max_brightness = 0;
+};
+
+bool IsAuraDeUseHostPowerStatusEnabled() {
+  auto environment = base::Environment::Create();
+  const std::optional<std::string> value =
+      environment->GetVar(kAuraDeUseHostPowerStatus);
+  return value.has_value() && value.value() != "0";
+}
+
+bool LaunchHostPowerCommandWith(const base::FilePath& executable,
+                                const char* command) {
+  base::CommandLine command_line(executable);
+  command_line.AppendArg(command);
+  base::Process process =
+      base::LaunchProcess(command_line, base::LaunchOptions());
+  if (!process.IsValid()) {
+    LOG(ERROR) << "Failed to launch " << executable.value() << " " << command;
+    return false;
+  }
+  return true;
+}
+
+bool LaunchHostPowerCommand(const char* command) {
+  // AuraDE compatibility: generic Linux fake-power production mode uses the
+  // package-owned helper instead of treating suspend as a no-op test counter.
+  if (LaunchHostPowerCommandWith(
+          base::FilePath(FILE_PATH_LITERAL("/usr/bin/aurade-system-helper")),
+          command)) {
+    return true;
+  }
+
+  return LaunchHostPowerCommandWith(
+      base::FilePath(FILE_PATH_LITERAL("/usr/bin/systemctl")), command);
+}
+
+std::optional<std::string> ReadTrimmedString(const base::FilePath& path) {
+  std::string value;
+  if (!base::ReadFileToString(path, &value)) {
+    return std::nullopt;
+  }
+  base::TrimWhitespaceASCII(value, base::TRIM_ALL, &value);
+  return value;
+}
+
+std::optional<std::string> ReadHostLifecycleState() {
+  return ReadTrimmedString(base::FilePath(kAuraDePowerStatePath));
+}
+
+std::optional<double> ReadDouble(const base::FilePath& path) {
+  const std::optional<std::string> value = ReadTrimmedString(path);
+  if (!value.has_value()) {
+    return std::nullopt;
+  }
+  double result = 0.0;
+  if (!base::StringToDouble(value.value(), &result)) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+std::optional<int64_t> ReadInt64(const base::FilePath& path) {
+  const std::optional<std::string> value = ReadTrimmedString(path);
+  if (!value.has_value()) {
+    return std::nullopt;
+  }
+  int64_t result = 0;
+  if (!base::StringToInt64(value.value(), &result)) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+std::optional<HostBacklightState> ReadHostBacklightState() {
+  base::FileEnumerator enumerator(base::FilePath(kBacklightPath),
+                                  /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    const std::optional<int64_t> max_brightness =
+        ReadInt64(path.Append("max_brightness"));
+    const std::optional<int64_t> brightness =
+        ReadInt64(path.Append("brightness"));
+    if (!max_brightness.has_value() || !brightness.has_value() ||
+        max_brightness.value() <= 0 || brightness.value() < 0) {
+      continue;
+    }
+    return HostBacklightState{
+        .path = path,
+        .brightness = brightness.value(),
+        .max_brightness = max_brightness.value(),
+    };
+  }
+  return std::nullopt;
+}
+
+std::optional<double> ReadHostScreenBrightnessPercent() {
+  const std::optional<HostBacklightState> state = ReadHostBacklightState();
+  if (!state.has_value()) {
+    return std::nullopt;
+  }
+  return std::clamp(
+      static_cast<double>(state->brightness) * 100.0 /
+          static_cast<double>(state->max_brightness),
+      0.0, 100.0);
+}
+
+std::optional<double> WriteHostScreenBrightnessPercent(double percent,
+                                                       bool allow_zero) {
+  const std::optional<HostBacklightState> state = ReadHostBacklightState();
+  if (!state.has_value()) {
+    return std::nullopt;
+  }
+
+  double clamped_percent = std::clamp(percent, 0.0, 100.0);
+  if (!allow_zero && clamped_percent <= 0.0) {
+    clamped_percent = kMinimumVisibleBacklightPercent;
+  }
+
+  int64_t target = static_cast<int64_t>(
+      (clamped_percent * static_cast<double>(state->max_brightness) / 100.0) +
+      0.5);
+  target = std::clamp<int64_t>(target, allow_zero ? 0 : 1,
+                               state->max_brightness);
+
+  if (!base::WriteFile(state->path.Append("brightness"),
+                       base::NumberToString(target))) {
+    return std::nullopt;
+  }
+  return ReadHostScreenBrightnessPercent().value_or(clamped_percent);
+}
+
+std::optional<double> AdjustHostScreenBrightnessPercent(bool increase,
+                                                        bool allow_off) {
+  const std::optional<double> current = ReadHostScreenBrightnessPercent();
+  if (!current.has_value()) {
+    return std::nullopt;
+  }
+  const double target =
+      current.value() + (increase ? kBacklightStepPercent
+                                  : -kBacklightStepPercent);
+  return WriteHostScreenBrightnessPercent(target, allow_off);
+}
+
+bool IsOnlinePowerSupply(const base::FilePath& path) {
+  const std::optional<std::string> online =
+      ReadTrimmedString(path.Append("online"));
+  return online.has_value() && online.value() == "1";
+}
+
+std::optional<double> ReadMicroUnitAsBaseUnit(const base::FilePath& path) {
+  const std::optional<double> value = ReadDouble(path);
+  if (!value.has_value()) {
+    return std::nullopt;
+  }
+  return value.value() / 1000000.0;
+}
+
+std::optional<double> ReadBatteryVoltage(const base::FilePath& path) {
+  return ReadMicroUnitAsBaseUnit(path.Append("voltage_now"));
+}
+
+std::optional<double> ReadBatteryCharge(const base::FilePath& path,
+                                        const char* charge_file,
+                                        const char* energy_file,
+                                        std::optional<double> voltage) {
+  const std::optional<double> charge =
+      ReadMicroUnitAsBaseUnit(path.Append(charge_file));
+  if (charge.has_value()) {
+    return charge;
+  }
+
+  const std::optional<double> energy_wh =
+      ReadMicroUnitAsBaseUnit(path.Append(energy_file));
+  if (!energy_wh.has_value() || !voltage.has_value() || voltage.value() <= 0) {
+    return std::nullopt;
+  }
+  return energy_wh.value() / voltage.value();
+}
+
+std::optional<int64_t> EstimateBatterySeconds(
+    double numerator,
+    std::optional<double> denominator) {
+  if (!denominator.has_value() || denominator.value() <= 0 || numerator <= 0) {
+    return std::nullopt;
+  }
+  return static_cast<int64_t>((numerator / denominator.value()) * 3600.0);
+}
+
+power_manager::PowerSupplyProperties::PowerSource::Type
+PowerSourceTypeFromSysfs(const std::string& type) {
+  if (type == "Mains") {
+    return power_manager::PowerSupplyProperties::PowerSource::MAINS;
+  }
+  if (type == "USB_C" || type == "USB_PD" || type == "USB_PD_DRP" ||
+      type == "BrickID") {
+    return power_manager::PowerSupplyProperties::PowerSource::USB_C;
+  }
+  if (type == "USB" || type == "USB_ACA" || type == "USB_CDP" ||
+      type == "USB_DCP") {
+    return power_manager::PowerSupplyProperties::PowerSource::USB_BC_1_2;
+  }
+  return power_manager::PowerSupplyProperties::PowerSource::OTHER;
+}
+
+bool IsExternalPowerSupplyType(const std::string& type) {
+  return type == "Mains" || type == "USB" || type == "USB_ACA" ||
+         type == "USB_CDP" || type == "USB_DCP" || type == "USB_C" ||
+         type == "USB_PD" || type == "USB_PD_DRP" || type == "BrickID";
+}
+
+bool IsLowPowerUsbType(const std::string& type) {
+  return type == "USB" || type == "USB_ACA" || type == "USB_CDP" ||
+         type == "USB_DCP";
+}
+
+void PopulatePowerSource(const base::FilePath& path,
+                         const std::string& type,
+                         power_manager::PowerSupplyProperties* props) {
+  auto* source = props->add_available_external_power_source();
+  source->set_id(path.BaseName().MaybeAsASCII());
+  source->set_type(PowerSourceTypeFromSysfs(type));
+  source->set_port(power_manager::PowerSupplyProperties::PowerSource::UNKNOWN);
+  source->set_active_by_default(IsOnlinePowerSupply(path));
+
+  if (const std::optional<std::string> manufacturer =
+          ReadTrimmedString(path.Append("manufacturer"));
+      manufacturer.has_value()) {
+    source->set_manufacturer_id(manufacturer.value());
+  }
+  if (const std::optional<std::string> model =
+          ReadTrimmedString(path.Append("model_name"));
+      model.has_value()) {
+    source->set_model_id(model.value());
+  }
+
+  const std::optional<double> current =
+      ReadMicroUnitAsBaseUnit(path.Append("current_max"));
+  const std::optional<double> voltage =
+      ReadMicroUnitAsBaseUnit(path.Append("voltage_max_design"));
+  if (current.has_value() && voltage.has_value()) {
+    source->set_max_power(current.value() * voltage.value());
+  }
+
+  if (IsOnlinePowerSupply(path)) {
+    props->set_external_power_source_id(source->id());
+  }
+}
+
+power_manager::PowerSupplyProperties CreateNoBatteryPowerProperties() {
+  power_manager::PowerSupplyProperties props;
+  props.set_battery_percent(0);
+  props.set_is_calculating_battery_time(false);
+  props.set_battery_state(
+      power_manager::PowerSupplyProperties_BatteryState_NOT_PRESENT);
+  props.set_external_power(
+      power_manager::PowerSupplyProperties_ExternalPower_DISCONNECTED);
+  props.set_battery_time_to_full_sec(0);
+  props.set_battery_time_to_empty_sec(0);
+  return props;
+}
+
+std::optional<power_manager::PowerSupplyProperties>
+ReadHostPowerSupplyProperties() {
+  power_manager::PowerSupplyProperties props = CreateNoBatteryPowerProperties();
+  base::FileEnumerator supplies(base::FilePath(kPowerSupplyPath),
+                                /*recursive=*/false,
+                                base::FileEnumerator::DIRECTORIES);
+  std::optional<base::FilePath> battery_path;
+  bool line_power_online = false;
+  bool usb_power_online = false;
+
+  for (base::FilePath path = supplies.Next(); !path.empty();
+       path = supplies.Next()) {
+    const std::optional<std::string> type =
+        ReadTrimmedString(path.Append("type"));
+    if (!type.has_value()) {
+      continue;
+    }
+
+    if (type.value() == "Battery") {
+      battery_path = path;
+      continue;
+    }
+
+    if (!IsExternalPowerSupplyType(type.value())) {
+      continue;
+    }
+
+    PopulatePowerSource(path, type.value(), &props);
+    if (IsOnlinePowerSupply(path)) {
+      if (IsLowPowerUsbType(type.value())) {
+        usb_power_online = true;
+      } else {
+        line_power_online = true;
+      }
+    }
+  }
+
+  if (line_power_online) {
+    props.set_external_power(
+        power_manager::PowerSupplyProperties_ExternalPower_AC);
+  } else if (usb_power_online) {
+    props.set_external_power(
+        power_manager::PowerSupplyProperties_ExternalPower_USB);
+  }
+
+  if (!battery_path.has_value()) {
+    return props;
+  }
+
+  const base::FilePath path = battery_path.value();
+  const std::optional<double> capacity = ReadDouble(path.Append("capacity"));
+  const std::optional<std::string> status =
+      ReadTrimmedString(path.Append("status"));
+  const std::optional<double> voltage = ReadBatteryVoltage(path);
+  const std::optional<double> current =
+      ReadMicroUnitAsBaseUnit(path.Append("current_now"));
+  const std::optional<double> power =
+      ReadMicroUnitAsBaseUnit(path.Append("power_now"));
+  const std::optional<double> charge_now =
+      ReadBatteryCharge(path, "charge_now", "energy_now", voltage);
+  const std::optional<double> charge_full =
+      ReadBatteryCharge(path, "charge_full", "energy_full", voltage);
+  const std::optional<double> charge_full_design =
+      ReadBatteryCharge(path, "charge_full_design", "energy_full_design",
+                        voltage);
+
+  props.set_battery_percent(capacity.value_or(0.0));
+  props.set_battery_time_to_empty_sec(0);
+  props.set_battery_time_to_full_sec(0);
+  props.set_is_calculating_battery_time(false);
+  if (voltage.has_value()) {
+    props.set_battery_voltage(voltage.value());
+  }
+  if (current.has_value()) {
+    props.set_battery_current(current.value());
+  }
+  if (charge_now.has_value()) {
+    props.set_battery_charge(charge_now.value());
+  }
+  if (charge_full.has_value()) {
+    props.set_battery_charge_full(charge_full.value());
+  }
+  if (charge_full_design.has_value()) {
+    props.set_battery_charge_full_design(charge_full_design.value());
+  }
+  if (const std::optional<std::string> vendor =
+          ReadTrimmedString(path.Append("manufacturer"));
+      vendor.has_value()) {
+    props.set_battery_vendor(vendor.value());
+  }
+  if (const std::optional<std::string> model =
+          ReadTrimmedString(path.Append("model_name"));
+      model.has_value()) {
+    props.set_battery_model_name(model.value());
+  }
+  if (const std::optional<std::string> serial =
+          ReadTrimmedString(path.Append("serial_number"));
+      serial.has_value()) {
+    props.set_battery_serial_number(serial.value());
+  }
+  if (const std::optional<std::string> technology =
+          ReadTrimmedString(path.Append("technology"));
+      technology.has_value()) {
+    props.set_battery_technology(technology.value());
+  }
+  if (status.has_value()) {
+    props.set_battery_status(status.value());
+  }
+  if (const std::optional<double> cycle_count =
+          ReadDouble(path.Append("cycle_count"));
+      cycle_count.has_value()) {
+    props.set_battery_cycle_count(static_cast<int64_t>(cycle_count.value()));
+  }
+
+  if (status == "Charging") {
+    props.set_battery_state(
+        power_manager::PowerSupplyProperties_BatteryState_CHARGING);
+    if (charge_full.has_value() && charge_now.has_value()) {
+      if (const std::optional<int64_t> seconds = EstimateBatterySeconds(
