+void FakePowerManagerClient::RequestHostLifecycleUpdate() {
+  if (host_lifecycle_request_in_flight_) {
+    return;
+  }
+  host_lifecycle_request_in_flight_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadHostLifecycleState),
+      base::BindOnce(&FakePowerManagerClient::OnHostLifecycleState,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void FakePowerManagerClient::OnHostLifecycleState(
+    std::optional<std::string> state_json) {
+  host_lifecycle_request_in_flight_ = false;
+  if (!state_json.has_value()) {
+    return;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(*state_json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return;
+  }
+  const base::DictValue& state = value->GetDict();
+  const std::optional<bool> lid_closed = state.FindBool("lid_closed");
+  if (lid_closed.has_value() && host_lid_closed_ != lid_closed) {
+    host_lid_closed_ = lid_closed;
+    SetLidState(*lid_closed ? LidState::CLOSED : LidState::OPEN,
+                base::TimeTicks::Now());
+  }
+
+  const std::optional<bool> preparing =
+      state.FindBool("preparing_for_sleep");
+  if (!preparing.has_value() || host_preparing_for_sleep_ == preparing) {
+    return;
+  }
+
+  const bool was_preparing = host_preparing_for_sleep_.value_or(false);
+  host_preparing_for_sleep_ = preparing;
+  if (*preparing) {
+    host_suspend_started_at_ = base::TimeTicks::Now();
+    SendSuspendImminent(power_manager::SuspendImminent_Reason_OTHER);
+    return;
+  }
+  if (was_preparing) {
+    const base::TimeDelta sleep_duration =
+        host_suspend_started_at_.is_null()
+            ? base::TimeDelta()
+            : base::TimeTicks::Now() - host_suspend_started_at_;
+    host_suspend_started_at_ = base::TimeTicks();
+    SendSuspendDone(sleep_duration);
+    RequestStatusUpdate();
+    GetScreenBrightnessPercent(base::BindOnce(
+        &FakePowerManagerClient::OnHostScreenBrightnessChanged,
+        weak_ptr_factory_.GetWeakPtr(),
+        power_manager::BacklightBrightnessChange_Cause_OTHER));
+  }
+}
