+// AuraDE compatibility: Linux applications put a count or an urgent mark on
+// their launcher icon with com.canonical.Unity.LauncherEntry, which KDE, Dash
+// to Dock and Plank all honour. Ash's shelf and launcher show it as the
+// notification badge its own apps get.
+void CrostiniApps::StartAuraDeLauncherEntryWatch() {
+  auto thread =
+      std::make_unique<base::Thread>("AuraDE launcher entry D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!thread->StartWithOptions(std::move(thread_options))) {
+    return;
+  }
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SESSION;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = thread->task_runner();
+  aurade_launcher_entry_bus_ = new dbus::Bus(std::move(bus_options));
+  aurade_launcher_entry_thread_ = std::move(thread);
+  aurade_launcher_entry_filter_ = std::make_unique<AuraDeLauncherEntryFilter>();
+  aurade_launcher_entry_filter_->on_update = base::BindPostTaskToCurrentDefault(
+      base::BindRepeating(&CrostiniApps::OnAuraDeLauncherEntryUpdate,
+                          weak_ptr_factory_.GetWeakPtr()));
+  // Unretained: the filter is only destroyed by a task posted to the same
+  // D-Bus thread after this one.
+  aurade_launcher_entry_bus_->GetDBusTaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(&AddAuraDeLauncherEntryFilter,
+                                aurade_launcher_entry_bus_,
+                                base::Unretained(
+                                    aurade_launcher_entry_filter_.get())));
+}
+
+void CrostiniApps::OnAuraDeLauncherEntryUpdate(
+    AuraDeLauncherEntryUpdate update) {
+  // "application://org.kde.kate.desktop" names the desktop file the app was
+  // published from.
+  std::string desktop_id = update.app_uri;
+  if (base::StartsWith(desktop_id, "application://")) {
+    desktop_id = desktop_id.substr(strlen("application://"));
   }
+  if (desktop_id.empty()) {
+    return;
+  }
+  if (!base::EndsWith(desktop_id, ".desktop")) {
+    desktop_id += ".desktop";
+  }
+  std::string app_id;
+  for (const auto& [id, host_app] : aurade_host_apps_) {
+    if (base::EqualsCaseInsensitiveASCII(host_app.desktop_file_id,
+                                         desktop_id)) {
+      app_id = id;
+      break;
+    }
+  }
+  if (app_id.empty()) {
+    return;
+  }
+  AuraDeLauncherEntry& entry = aurade_launcher_entries_[app_id];
+  if (update.count) {
+    entry.count = *update.count;
+  }
+  if (update.count_visible) {
+    entry.count_visible = *update.count_visible;
+  }
+  if (update.urgent) {
+    entry.urgent = *update.urgent;
+  }
+  PublishAuraDeBadge(app_id);
+}
+
+void CrostiniApps::PublishAuraDeBadge(const std::string& app_id) {
+  auto it = aurade_launcher_entries_.find(app_id);
+  const bool badge =
+      it != aurade_launcher_entries_.end() &&
+      ((it->second.count_visible && it->second.count > 0) || it->second.urgent);
+  auto app = std::make_unique<App>(AppType(), app_id);
+  app->has_badge = badge;
+  Publish(std::move(app));
 }
 
