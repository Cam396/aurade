+// Read on the launcher entry D-Bus thread while it is a filter there.
+struct AuraDeLauncherEntryFilter {
+  base::RepeatingCallback<void(AuraDeLauncherEntryUpdate)> on_update;
+};
+
 }  // namespace apps
 
 namespace {
 
+constexpr char kLauncherEntryInterface[] = "com.canonical.Unity.LauncherEntry";
+constexpr char kLauncherEntryMatch[] =
+    "type='signal',interface='com.canonical.Unity.LauncherEntry',"
+    "member='Update'";
+
+bool PopLauncherEntryBool(dbus::MessageReader* value, bool* out) {
+  return value->GetDataType() == dbus::Message::BOOL && value->PopBool(out);
+}
+
+// A count arrives as whichever integer the toolkit chose: int64 is what the
+// specification says, int32 and uint32 are what some applications send.
+bool PopLauncherEntryCount(dbus::MessageReader* value, int64_t* out) {
+  switch (value->GetDataType()) {
+    case dbus::Message::INT64:
+      return value->PopInt64(out);
+    case dbus::Message::INT32: {
+      int32_t count = 0;
+      if (!value->PopInt32(&count)) {
+        return false;
+      }
+      *out = count;
+      return true;
+    }
+    case dbus::Message::UINT32: {
+      uint32_t count = 0;
+      if (!value->PopUint32(&count)) {
+        return false;
+      }
+      *out = count;
+      return true;
+    }
+    default:
+      return false;
+  }
+}
+
+DBusHandlerResult AuraDeLauncherEntryFilterFunction(DBusConnection* connection,
+                                                    DBusMessage* raw_message,
+                                                    void* data) {
+  if (!dbus_message_is_signal(raw_message, kLauncherEntryInterface,
+                              "Update")) {
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+  }
+  // The Signal unrefs the message when it goes, and the message is still
+  // libdbus's to hand to the next filter.
+  dbus_message_ref(raw_message);
+  std::unique_ptr<dbus::Signal> signal =
+      dbus::Signal::FromRawMessage(raw_message);
+  dbus::MessageReader reader(signal.get());
+  apps::AuraDeLauncherEntryUpdate update;
+  dbus::MessageReader properties(nullptr);
+  if (!reader.PopString(&update.app_uri) || !reader.PopArray(&properties)) {
+    return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+  }
+  while (properties.HasMoreData()) {
+    dbus::MessageReader entry(nullptr);
+    std::string key;
+    dbus::MessageReader value(nullptr);
+    if (!properties.PopDictEntry(&entry) || !entry.PopString(&key) ||
+        !entry.PopVariant(&value)) {
+      break;
+    }
+    if (key == "count") {
+      int64_t count = 0;
+      if (PopLauncherEntryCount(&value, &count)) {
+        update.count = count;
+      }
+    } else if (key == "count-visible") {
+      bool visible = false;
+      if (PopLauncherEntryBool(&value, &visible)) {
+        update.count_visible = visible;
+      }
+    } else if (key == "urgent") {
+      bool urgent = false;
+      if (PopLauncherEntryBool(&value, &urgent)) {
+        update.urgent = urgent;
+      }
+    }
+  }
+  static_cast<apps::AuraDeLauncherEntryFilter*>(data)->on_update.Run(
+      std::move(update));
+  return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+void AddAuraDeLauncherEntryFilter(scoped_refptr<dbus::Bus> bus,
+                                  apps::AuraDeLauncherEntryFilter* filter) {
+  // Connected alone, the bus never reads its socket; an object proxy would
+  // set that up, and a filter has none.
+  if (!bus->Connect() || !bus->SetUpAsyncOperations()) {
+    LOG(ERROR) << "AuraDE could not reach the session bus for launcher badges";
+    return;
+  }
+  bus->AddFilterFunction(&AuraDeLauncherEntryFilterFunction, filter);
+  dbus::Error error;
+  bus->AddMatch(kLauncherEntryMatch, &error);
+  LOG_IF(ERROR, error.IsValid())
+      << "AuraDE could not listen for launcher badges: " << error.message();
+}
+
+void StopAuraDeLauncherEntryWatch(
+    std::unique_ptr<base::Thread> thread,
+    scoped_refptr<dbus::Bus> bus,
+    std::unique_ptr<apps::AuraDeLauncherEntryFilter> filter) {
+  bus->GetDBusTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](scoped_refptr<dbus::Bus> bus,
+             std::unique_ptr<apps::AuraDeLauncherEntryFilter> filter) {
+            if (bus->IsConnected()) {
+              dbus::Error error;
+              bus->RemoveMatch(kLauncherEntryMatch, &error);
+              bus->RemoveFilterFunction(&AuraDeLauncherEntryFilterFunction,
+                                        filter.get());
+            }
+            filter.reset();
+            bus->ShutdownAndBlock();
+          },
+          bus, std::move(filter)));
+  // Stopping the thread waits for the task above, which is why it is done
+  // here, off the UI thread.
+  thread->Stop();
+}
