+  /**
+   * AuraDE: bring the rows already on screen into line with what is cut.
+   *
+   * Deliberately not list.redraw(). Redraw reuses the rows it already has:
+   * mergeItems takes cachedItems_[index] when one exists and only calls
+   * createItem when it does not, so the render path that applies the class
+   * never runs again for a row that is already on screen. Calling redraw here
+   * dimmed nothing at all, and would have dimmed only the rows scrolled into
+   * view afterwards, which is worse than dimming none of them.
+   *
+   * So the rows on screen are toggled directly and the render path keeps
+   * handling the ones that arrive later. Both are needed: this one cannot see
+   * rows that do not exist yet, and that one does not run for rows that
+   * already do.
+   */
+  private auraDeRedrawForCutMarks_() {
+    const list = this.listContainer_.currentList;
+    const model = list.dataModel;
+    if (!model) {
