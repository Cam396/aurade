@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Compiles the port and its ChromeOS wiring into one file and runs the
+contract against a live Files renderer on the hardware.
+
+The local suite proves the adapter translates correctly against a fake. Nothing
+local can touch `adapter/chromeos_platform.ts`, because that file is the wiring
+itself. This assembles the real modules, sends them to a running Files window
+over the debugger, and runs the same contract cases there.
+
+  python3 hardware_contract.py
+
+Needs the Files app open on the target. If it is not:
+
+  curl -s -X PUT "http://127.0.0.1:19222/json/new?chrome://file-manager"
+
+The lab script is found at AURADE_LAB, defaulting to the usual place. Only the
+assembled payload leaves this machine, and the only thing written on the far
+side is one timestamped directory that the harness removes in a finally.
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+AURADE = os.path.dirname(os.path.dirname(HERE))
+SRC = os.path.abspath(os.path.join(AURADE, "..", "..", "..", ".."))
+NODE = os.path.join(SRC, "third_party/node/linux/node-linux-x64/bin/node")
+TSC = os.path.join(SRC, "third_party/node/node_modules/typescript/bin/tsc")
+LAB = os.environ.get("AURADE_LAB", "/mnt/build/aurade-work/lab")
+
+# Only what the contract actually needs at runtime. Type-only imports leave no
+# trace in the emitted code, so platform.ts arrives as an empty module.
+MODULES = [
+    "port/types.ts",
+    "port/port.ts",
+    "adapter/chromeos_backend.ts",
+    "adapter/chromeos_platform.ts",
+    "tests/progress.ts",
+    "tests/contract/port_contract.ts",
+]
+
+
+def build_bundle(out_path):
+    """Emit every module into one file as named AMD definitions.
+
+    outFile and module=amd are both deprecated in this TypeScript and say so on
+    stderr while emitting perfectly good output, so the exit code is what is
+    trusted here rather than the noise.
+    """
+    command = [
+        NODE, TSC, "--strict", "--skipLibCheck", "--target", "es2022",
+        "--module", "amd", "--outFile", out_path, "--lib", "es2022,dom",
+        "--ignoreDeprecations", "6.0",
+    ] + [os.path.join(AURADE, module) for module in MODULES]
+    finished = subprocess.run(command, capture_output=True, text=True)
+    if not os.path.exists(out_path):
+        sys.stdout.write(finished.stdout + finished.stderr)
+        raise SystemExit("the bundle did not compile")
+    return open(out_path).read()
+
+
+def main():
+    for needed in (NODE, TSC, LAB):
+        if not os.path.exists(needed):
+            raise SystemExit("not found: %s" % needed)
+
+    # Somewhere else entirely. A build artifact left in the source directory is
+    # one an export script will eventually sweep into a patch.
+    with tempfile.TemporaryDirectory() as scratch:
+        bundle = build_bundle(os.path.join(scratch, "bundle.js"))
+    harness = open(os.path.join(HERE, "hardware_contract.js")).read()
+    marker = "// @BUNDLE@"
+    if harness.count(marker) != 1:
+        raise SystemExit("the harness has no single %s to splice into" % marker)
+    payload = harness.replace(marker, bundle)
+
+    print("sending %d bytes to the renderer" % len(payload))
+    # Comfortably longer than the harness's own watchdog, so a hang is reported
+    # by the harness, which knows which case it was in, rather than by the
+    # socket, which only knows that nothing came back.
+    environment = dict(os.environ, AURADE_CDP_TIMEOUT="300")
+    finished = subprocess.run([LAB, "eval", payload], capture_output=True,
+                              text=True, env=environment)
+    sys.stderr.write(finished.stderr)
+    print(finished.stdout.strip())
+    return finished.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
