@@ -0,0 +1,289 @@
+/**
+ * The thin edge: the real ChromeOS APIs, handed to the adapter as a `Platform`.
+ *
+ * Everything above this file is tested locally against a fake. This file is the
+ * one place that cannot be, because it is the wiring itself, and a fake of it
+ * would be a fake of a fake. Its correctness is established two ways instead:
+ * the shapes it depends on are checked against a live renderer by
+ * `tests/harness/platform_probe.js`, and the whole port contract can be run
+ * through it on real hardware by `tests/harness/hardware_contract.js`.
+ *
+ * Nothing here reaches for a global. The three collaborators arrive through the
+ * constructor, so this file states exactly what it needs and a caller decides
+ * where those come from. That matters more than usual: two of the three are not
+ * `chrome.fileManagerPrivate` at all, and finding that out was most of the cost
+ * of the last hardware pass. `getVolumeMetadataList` returns neither a label nor
+ * a root, so volumes come from `VolumeManager`; `getEntryProperties` answers
+ * `{}` for every local file, so metadata comes from `MetadataModel`.
+ */
+import type {Platform, PlatformDirectoryReader, PlatformEntry, PlatformIoProgress, PlatformIoType, PlatformLaunchDialog, PlatformMetadata, PlatformResultingTasks, PlatformTaskDescriptor, PlatformVolume, PlatformWatchEvent} from './platform.js';
+
+/** A listener slot on a `chrome` event. */
+interface ChromeEvent<T> {
+  addListener(listener: (value: T) => void): void;
+  removeListener(listener: (value: T) => void): void;
+}
+
+/**
+ * The slice of `chrome.fileManagerPrivate` this touches, and no more.
+ *
+ * Spelled as the bindings spell it, which is not how our interface spells it:
+ * the io methods are `startIOTask` and `cancelIOTask` with a capital pair, and
+ * `getFileTasks` and `selectFiles` each take an argument our port has no reason
+ * to know about.
+ */
+export interface FileManagerPrivateSlice {
+  getSizeStats(
+      volumeId: string,
+      callback: (stats?: {totalSize: number, remainingSize: number}) => void):
+      void;
+  addFileWatch(entry: PlatformEntry, callback: (success?: boolean) => void): void;
+  removeFileWatch(entry: PlatformEntry, callback: (success?: boolean) => void):
+      void;
+  onDirectoryChanged: ChromeEvent<PlatformWatchEvent>;
+  searchFiles(
+      params: {
+        rootDir: PlatformEntry|null,
+        query: string,
+        types: string,
+        maxResults: number,
+      },
+      callback: (entries: PlatformEntry[]) => void): void;
+  getFileTasks(
+      entries: readonly PlatformEntry[], dlpSourceUrls: readonly string[],
+      callback: (tasks: PlatformResultingTasks) => void): void;
+  executeTask(
+      descriptor: PlatformTaskDescriptor, entries: readonly PlatformEntry[],
+      callback: (result: string) => void): void;
+  startIOTask(
+      type: PlatformIoType, entries: readonly PlatformEntry[],
+      params: {destinationFolder?: PlatformEntry, showNotification?: boolean},
+      callback: (taskId: number) => void): void;
+  cancelIOTask(taskId: number): void;
+  onIOTaskProgressStatus: ChromeEvent<PlatformIoProgress>;
+  selectFiles(
+      paths: readonly string[], shouldReturnLocalPath: boolean,
+      callback: () => void): void;
+  cancelDialog(): void;
+}
+
+/** What we read off `VolumeManager`, which is where a label and a root live. */
+export interface VolumeManagerSlice {
+  readonly volumeInfoList: {
+    readonly length: number,
+    item(index: number): {
+      volumeId: string,
+      volumeType: string,
+      label: string,
+      isReadOnly?: boolean,
+      displayRoot?: PlatformEntry|null,
+    },
+  };
+}
+
+/** `MetadataModel`, which is where the fields actually come from. */
+export interface MetadataModelSlice {
+  get(entries: readonly PlatformEntry[],
+      names: readonly string[]): Promise<PlatformMetadata[]>;
+}
+
+/** Resolves a filesystem url. Passed in so this file needs no global. */
+export type ResolveUrl =
+    (url: string, onSuccess: (entry: PlatformEntry) => void,
+     onError: (error: unknown) => void) => void;
+
+/** `chrome.runtime.lastError`, which is how these APIs report a failure. */
+export interface LastErrorSource {
+  readonly lastError?: {message?: string}|undefined;
+}
+
+/**
+ * Turns a callback API into a promise, failing on `lastError`.
+ *
+ * The private API does not throw and does not reject. It calls back normally
+ * and leaves `chrome.runtime.lastError` set, which is unset again the moment
+ * the callback returns, so reading it anywhere else reads nothing. A wrapper
+ * that forgets this reports every failure as a success carrying undefined.
+ *
+ * The error carries a message rather than a DOMException name, so the adapter's
+ * translation lands on its `io` default. That is honest: the private API does
+ * not tell us which of its failures this was.
+ */
+function fromCallback<T>(
+    runtime: LastErrorSource, call: (done: (value: T) => void) => void):
+    Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    try {
+      call((value: T) => {
+        const failure = runtime.lastError;
+        if (failure) {
+          reject(new Error(failure.message ?? 'the operation failed'));
+          return;
+        }
+        resolve(value);
+      });
+    } catch (error) {
+      // A wrong argument is refused synchronously by the bindings, before the
+      // callback exists, so this is not redundant with the check above.
+      reject(error);
+    }
+  });
+}
+
+class ChromeOsDirectoryReader implements PlatformDirectoryReader {
+  constructor(private readonly reader: {
+    readEntries(
+        onSuccess: (entries: PlatformEntry[]) => void,
+        onError: (error: unknown) => void): void,
+  }) {}
+
+  readEntries(): Promise<readonly PlatformEntry[]> {
+    return new Promise((resolve, reject) => {
+      this.reader.readEntries(resolve, reject);
+    });
+  }
+}
+
+export class ChromeOsPlatform implements Platform {
+  constructor(
+      private readonly api: FileManagerPrivateSlice,
+      private readonly runtime: LastErrorSource,
+      private readonly volumes: VolumeManagerSlice,
+      private readonly metadata: MetadataModelSlice,
+      private readonly resolveUrl: ResolveUrl,
+      /**
+       * The launch parameters, or null for an ordinary window. A window that is
+       * not a picker reports its type as `full-page`, which is not a dialog we
+       * can be, so the caller passes null for it rather than making the adapter
+       * know that string.
+       */
+      private readonly launch: PlatformLaunchDialog|null) {}
+
+  resolve(url: string): Promise<PlatformEntry> {
+    return new Promise((resolve, reject) => {
+      this.resolveUrl(url, resolve, reject);
+    });
+  }
+
+  createReader(directory: PlatformEntry): PlatformDirectoryReader {
+    const source = directory as unknown as {
+      createReader(): {
+        readEntries(
+            onSuccess: (entries: PlatformEntry[]) => void,
+            onError: (error: unknown) => void): void,
+      },
+    };
+    return new ChromeOsDirectoryReader(source.createReader());
+  }
+
+  getMetadata(
+      entries: readonly PlatformEntry[],
+      names: readonly string[]): Promise<readonly PlatformMetadata[]> {
+    return this.metadata.get(entries, names);
+  }
+
+  async listVolumes(): Promise<readonly PlatformVolume[]> {
+    const list = this.volumes.volumeInfoList;
+    const out: PlatformVolume[] = [];
+    for (let index = 0; index < list.length; index++) {
+      const volume = list.item(index);
+      // A volume that is still mounting has no display root yet. It is not an
+      // error and it is not a volume we can navigate to, so it is left out
+      // rather than reported as somewhere you can go and then cannot.
+      if (!volume.displayRoot) {
+        continue;
+      }
+      out.push({
+        volumeId: volume.volumeId,
+        volumeType: volume.volumeType,
+        label: volume.label,
+        isReadOnly: volume.isReadOnly === true,
+        root: volume.displayRoot,
+      });
+    }
+    return out;
+  }
+
+  async getSizeStats(volumeId: string):
+      Promise<{totalSize: number, remainingSize: number}|null> {
+    const stats = await fromCallback<{totalSize: number, remainingSize: number}|
+                                     undefined>(
+        this.runtime, done => this.api.getSizeStats(volumeId, done));
+    return stats ?? null;
+  }
+
+  async addFileWatch(entry: PlatformEntry): Promise<void> {
+    await fromCallback<boolean|undefined>(
+        this.runtime, done => this.api.addFileWatch(entry, done));
+  }
+
+  async removeFileWatch(entry: PlatformEntry): Promise<void> {
+    await fromCallback<boolean|undefined>(
+        this.runtime, done => this.api.removeFileWatch(entry, done));
+  }
+
+  onDirectoryChanged(listener: (event: PlatformWatchEvent) => void): () => void {
+    this.api.onDirectoryChanged.addListener(listener);
+    return () => this.api.onDirectoryChanged.removeListener(listener);
+  }
+
+  searchFiles(params: {
+    rootDir: PlatformEntry|null,
+    query: string,
+    types: 'ALL'|'EXCLUDE_DIRECTORIES'|'OFFLINE'|'SHARED_WITH_ME',
+    maxResults: number,
+  }): Promise<readonly PlatformEntry[]> {
+    return fromCallback<PlatformEntry[]>(
+        this.runtime, done => this.api.searchFiles(params, done));
+  }
+
+  getFileTasks(
+      entries: readonly PlatformEntry[],
+      dlpSourceUrls: readonly string[]): Promise<PlatformResultingTasks> {
+    return fromCallback<PlatformResultingTasks>(
+        this.runtime, done => this.api.getFileTasks(entries, dlpSourceUrls, done));
+  }
+
+  executeTask(
+      descriptor: PlatformTaskDescriptor,
+      entries: readonly PlatformEntry[]): Promise<string> {
+    return fromCallback<string>(
+        this.runtime, done => this.api.executeTask(descriptor, entries, done));
+  }
+
+  startIoTask(
+      type: PlatformIoType, entries: readonly PlatformEntry[],
+      params: {destinationFolder?: PlatformEntry}): Promise<number> {
+    return fromCallback<number>(
+        this.runtime,
+        // The notification is the system's own progress toast. The window is
+        // showing this operation already, so a second announcement of it is
+        // noise rather than news.
+        done => this.api.startIOTask(
+            type, entries, {...params, showNotification: false}, done));
+  }
+
+  cancelIoTask(taskId: number): void {
+    this.api.cancelIOTask(taskId);
+  }
+
+  onIoProgress(listener: (progress: PlatformIoProgress) => void): () => void {
+    this.api.onIOTaskProgressStatus.addListener(listener);
+    return () => this.api.onIOTaskProgressStatus.removeListener(listener);
+  }
+
+  async getLaunchDialog(): Promise<PlatformLaunchDialog|null> {
+    return this.launch;
+  }
+
+  async selectFiles(paths: readonly string[], shouldReturnLocalPath: boolean):
+      Promise<void> {
+    await fromCallback<void>(
+        this.runtime,
+        done => this.api.selectFiles(paths, shouldReturnLocalPath, done));
+  }
+
+  cancelDialog(): void {
+    this.api.cancelDialog();
+  }
+}
