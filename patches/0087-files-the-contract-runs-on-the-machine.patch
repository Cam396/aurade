index 000000000000..3c9e7c067f82
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/harness/hardware_contract.js
@@ -0,0 +1,199 @@
+/**
+ * Runs the real port contract against real ChromeOS, in a live Files renderer.
+ *
+ * The local loop runs the contract against two backends, both of which stand on
+ * a fake. This runs the same cases, unmodified, against `ChromeOsBackend` over
+ * `ChromeOsPlatform` over the actual `chrome.fileManagerPrivate`, the app's
+ * `VolumeManager` and its `MetadataModel`. It is the only thing that exercises
+ * `adapter/chromeos_platform.ts` at all, since that file is the wiring itself
+ * and a fake of it would be a fake of a fake.
+ *
+ * Assembled and sent by `hardware_contract.py`, which compiles the modules into
+ * the marker below. Do not run this file directly: on its own it defines
+ * nothing.
+ *
+ * Every file it creates lives inside one timestamped directory under the
+ * downloads volume, and that directory is removed in a finally.
+ *
+ * Three capabilities are declined rather than faked. `io-holder` ChromeOS
+ * cannot report at all. `io-failure` needs a filesystem that can be told to
+ * fail on demand, and a real one fails when it fails. `task-execution` launches
+ * whatever handles the file, and the handler for a text file here is the Files
+ * app's own viewer: running it navigated this very window and took the
+ * debugger connection with it.
+ */
+
+// Scoped, because Runtime.evaluate declares at the top level of the page and
+// those declarations outlive the call. Without this the second run of the
+// harness dies on "auradeModules has already been declared", which says nothing
+// about the code under test.
+(() => {
+// A minimal AMD loader. The bundle below is a sequence of define() calls with
+// their dependencies already resolved to names, so nothing here needs to fetch.
+const auradeModules = {};
+const auradeExports = {};
+function define(name, deps, factory) {
+  auradeModules[name] = {deps: deps, factory: factory};
+}
+function requireModule(name) {
+  if (Object.prototype.hasOwnProperty.call(auradeExports, name)) {
+    return auradeExports[name];
+  }
+  const module = auradeModules[name];
+  if (!module) {
+    throw new Error('no such module in the bundle: ' + name);
+  }
+  // Registered before the factory runs, so a cycle sees a partial object rather
+  // than recursing forever.
+  const exported = (auradeExports[name] = {});
+  const args = module.deps.map(function(dep) {
+    if (dep === 'require') return requireModule;
+    if (dep === 'exports') return exported;
+    return requireModule(dep);
+  });
+  module.factory.apply(null, args);
+  return exported;
+}
+
+// @BUNDLE@
+
+return (async () => {
+  const {ChromeOsBackend} = requireModule('adapter/chromeos_backend');
+  const {ChromeOsPlatform} = requireModule('adapter/chromeos_platform');
+  const {runContract} = requireModule('tests/contract/port_contract');
+  const {currentCheck} = requireModule('tests/progress');
+
+  const app = window.fileManager;
+  if (!app || !app.volumeManager || !app.metadataModel_) {
+    return JSON.stringify({error: 'the Files app is not open in this renderer'});
+  }
+  const volumeManager = app.volumeManager;
+
+  let home = null;
+  for (let i = 0; i < volumeManager.volumeInfoList.length; i++) {
+    const volume = volumeManager.volumeInfoList.item(i);
+    if (volume.volumeType === 'downloads' && volume.displayRoot) {
+      home = volume.displayRoot;
+      break;
+    }
+  }
+  if (!home) {
+    return JSON.stringify({error: 'no writable downloads volume to work in'});
+  }
+
+  const resolveEntry = (url) =>
+      new Promise((ok, fail) => webkitResolveLocalFileSystemURL(url, ok, fail));
+  const getChild = (parent, name, isDirectory, create) => new Promise(
+      (ok, fail) => isDirectory ?
+          parent.getDirectory(name, {create: create}, ok, fail) :
+          parent.getFile(name, {create: create}, ok, fail));
+
+  // Delegates everything, and additionally reports when addFileWatch has come
+  // back. That is the only precise signal available that ChromeOS is really
+  // watching: the port exposes none, which is the finding this run produced.
+  const DELEGATED = [
+    'resolve', 'createReader', 'getMetadata', 'listVolumes', 'getSizeStats',
+    'removeFileWatch', 'onDirectoryChanged', 'searchFiles', 'getFileTasks',
+    'executeTask', 'startIoTask', 'cancelIoTask', 'onIoProgress',
+    'getLaunchDialog', 'selectFiles', 'cancelDialog',
+  ];
+  function recording(inner) {
+    let armed = () => {};
+    const watching = new Promise(resolve => { armed = resolve; });
+    const shim = {watching: watching};
+    for (const name of DELEGATED) {
+      shim[name] = (...args) => inner[name](...args);
+    }
+    shim.addFileWatch = async (entry) => {
+      const answer = await inner.addFileWatch(entry);
+      armed();
+      return answer;
+    };
+    return shim;
+  }
+
+  const platform = new ChromeOsPlatform(
+      chrome.fileManagerPrivate, chrome.runtime, volumeManager,
+      app.metadataModel_,
+      (url, ok, fail) => webkitResolveLocalFileSystemURL(url, ok, fail),
+      // This window is full-page rather than a picker, so there is no dialog to
+      // describe. dialogMode() should answer null, and the contract checks it.
+      null);
+
+  const stamp = 'aurade-contract-' + Date.now();
+  const box = await getChild(home, stamp, true, true);
+  const logged = [];
+  const realLog = console.log;
+  console.log = (...parts) => { logged.push(parts.join(' ')); };
+  let results;
+  try {
+    // A fresh directory per case, because every case assumes an empty root.
+    let index = 0;
+    const makeFixture = async () => {
+      const root = await getChild(box, 'case-' + (index++), true, true);
+      const watched = recording(platform);
+      return {
+        port: new ChromeOsBackend(watched),
+        root: root.toURL(),
+        // The round trip first, which is exact, and then a short settle for the
+        // baseline read the backend does immediately after it. That read is a
+        // couple of IPC calls on an empty directory, so this is generous rather
+        // than tuned, and it is bounded rather than a guess at the whole thing.
+        armed: async () => {
+          await watched.watching;
+          await new Promise(done => setTimeout(done, 250));
+        },
+        add: async (parent, name, isDirectory) => {
+          const entry = await resolveEntry(String(parent));
+          const child = await getChild(entry, name, isDirectory, true);
+          return child.toURL();
+        },
+        remove: async (key) => {
+          const entry = await resolveEntry(String(key));
+          await new Promise((ok, fail) => entry.isDirectory ?
+                                entry.removeRecursively(ok, fail) :
+                                entry.remove(ok, fail));
+        },
+        failWith: () => {
+          throw new Error(
+              'a real filesystem cannot be told to fail on demand');
+        },
+      };
+    };
+    // The same watchdog the local runner has, for the same reason: a case that
+    // waits forever for an event that never came does not fail, it stops, and
+    // on hardware there are far more ways for an event never to come. Racing
+    // the run means a hang is reported by name instead of looking like a dead
+    // connection to whoever is waiting on the other end of the debugger.
+    const HANG_MS = 180000;
+    let hung = false;
+    const watchdog = new Promise(
+        wake => setTimeout(() => { hung = true; wake('hung'); }, HANG_MS));
+    const run = runContract(
+        'ChromeOsPlatform on hardware', makeFixture,
+        ['list', 'metadata', 'watch', 'volumes', 'search', 'tasks', 'io',
+         'dialog']);
+    const outcome = await Promise.race([run, watchdog]);
+    if (hung) {
+      return JSON.stringify({
+        error: 'a case hung and never finished',
+        hungIn: currentCheck(),
+        log: logged,
+      }, null, 1);
+    }
+    results = outcome;
+  } finally {
+    console.log = realLog;
+    await new Promise(done => box.removeRecursively(done, done));
+  }
+
+  const failed = results.filter(r => !r.ok);
+  return JSON.stringify({
+    ran: results.length,
+    passed: results.length - failed.length,
+    failed: failed.length,
+    failures: failed,
+    log: logged,
+  }, null, 1);
+})();
+})()
