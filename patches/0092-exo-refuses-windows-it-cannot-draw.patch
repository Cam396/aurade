 namespace exo {
 
+namespace {
+
+// AuraDE compatibility: exo draws every window it hosts through the GPU, and
+// the window it builds for one reads the shared GPU context without checking
+// it. Once the desktop has fallen back to software compositing there is no
+// such context, and building the window crashed the whole desktop the moment
+// an application opened one. The window is refused here instead. The caller
+// answers the application with a protocol error, so the application is told
+// and the desktop stays up.
+bool CanHostWindows() {
+  if (aura::Env::GetInstance()
+          ->context_factory()
+          ->SharedMainThreadRasterContextProvider()) {
+    return true;
+  }
+  LOG(WARNING) << "Refusing a Wayland window: the desktop is composited in "
+                  "software and exo needs GPU compositing.";
+  return false;
+}
+
+}  // namespace
