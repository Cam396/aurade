+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PASSAGE_EMBEDDINGS_AURADE_LOCAL_PASSAGE_EMBEDDER_H_
+#define CHROME_BROWSER_PASSAGE_EMBEDDINGS_AURADE_LOCAL_PASSAGE_EMBEDDER_H_
+
+#include <list>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "components/passage_embeddings/core/passage_embeddings_types.h"
+#include "services/passage_embeddings/public/mojom/passage_embeddings.mojom.h"
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace passage_embeddings {
+
+// AuraDE compatibility: computes passage embeddings by calling a local model
+// runtime (Ollama by default) over HTTP instead of the downloaded
+// TFLite/Gemini Nano embedder, which is unavailable on generic Linux.
+class AuraDeLocalPassageEmbedder {
+ public:
+  using ResultCallback = base::OnceCallback<void(
+      std::vector<mojom::PassageEmbeddingsResultPtr> results,
+      ComputeEmbeddingsStatus status)>;
+
+  // True when running on generic Linux with the Advanced Plus AI profile and
+  // a configured local embedding model.
+  static bool IsEnabled();
+
+  // Metadata describing the configured local embedding model. Only meaningful
+  // when IsEnabled() returns true. The model version is derived from the
+  // model name so switching models re-embeds existing databases.
+  static EmbedderMetadata GetMetadata();
+
+  explicit AuraDeLocalPassageEmbedder(
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+  AuraDeLocalPassageEmbedder(const AuraDeLocalPassageEmbedder&) = delete;
+  AuraDeLocalPassageEmbedder& operator=(const AuraDeLocalPassageEmbedder&) =
+      delete;
+  ~AuraDeLocalPassageEmbedder();
+
+  // Requests embeddings for `passages` from the local runtime. Invokes
+  // `callback` with one result per passage on success, or with empty results
+  // and a failure status.
+  void ComputeEmbeddings(std::vector<std::string> passages,
+                         ResultCallback callback);
+
+ private:
+  using LoaderList = std::list<std::unique_ptr<network::SimpleURLLoader>>;
+
+  void OnResponse(LoaderList::iterator loader_it,
+                  size_t expected_count,
+                  ResultCallback callback,
+                  std::optional<std::string> response_body);
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  LoaderList loaders_;
+};
+
+}  // namespace passage_embeddings
+
+#endif  // CHROME_BROWSER_PASSAGE_EMBEDDINGS_AURADE_LOCAL_PASSAGE_EMBEDDER_H_
