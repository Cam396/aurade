diff --git a/chrome/browser/passage_embeddings/aurade_local_passage_embedder.cc b/chrome/browser/passage_embeddings/aurade_local_passage_embedder.cc
new file mode 100644
index 0000000000..c70d0d74a7
--- /dev/null
+++ b/chrome/browser/passage_embeddings/aurade_local_passage_embedder.cc
@@ -0,0 +1,238 @@
+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/passage_embeddings/aurade_local_passage_embedder.h"
+
+#include <cmath>
+#include <utility>
+
+#include "base/environment.h"
+#include "base/hash/hash.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/system/sys_info.h"
+#include "base/values.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace passage_embeddings {
+
+namespace {
+
+constexpr char kProfileEnvVar[] = "AURADE_FEATURE_PROFILE";
+constexpr char kAdvancedPlusAiProfile[] = "advanced_plus_ai";
+constexpr char kEndpointEnvVar[] = "AURADE_LOCAL_AI_ENDPOINT";
+constexpr char kEmbedModelEnvVar[] = "AURADE_LOCAL_AI_EMBED_MODEL";
+constexpr char kEmbedDimEnvVar[] = "AURADE_LOCAL_AI_EMBED_DIM";
+constexpr char kEmbedScoreThresholdEnvVar[] =
+    "AURADE_LOCAL_AI_EMBED_SCORE_THRESHOLD";
+constexpr char kDefaultEndpoint[] = "http://127.0.0.1:11434";
+constexpr size_t kDefaultEmbeddingDimensions = 768;
+// Must stay within SimpleURLLoader's bounded DownloadToString limit.
+constexpr size_t kMaxResponseBytes = 4 * 1024 * 1024;
+constexpr base::TimeDelta kRequestTimeout = base::Seconds(90);
+
+const net::NetworkTrafficAnnotationTag kAuraDeLocalEmbedTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aurade_local_embeddings_request",
+                                        R"(
+        semantics {
+          sender: "AuraDE Local AI"
+          description:
+            "AuraDE sends history passage text to a local embedding model "
+            "runtime running on the same machine. The default endpoint is "
+            "Ollama on localhost."
+          trigger:
+            "Chrome computes embeddings for browsing history passages so "
+            "history search can work with a local model."
+          data: "Extracted page passage text."
+          destination: LOCAL
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Only active when the AuraDE Advanced Plus AI feature profile "
+            "and a local embedding model are configured."
+          policy_exception_justification:
+            "Local-only request; no data leaves the machine."
+        })");
+
+std::string GetEnv(const char* name) {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  return env->GetVar(std::string(name)).value_or(std::string());
+}
+
+std::string GetEmbedModel() {
+  return GetEnv(kEmbedModelEnvVar);
+}
+
+std::string GetEndpoint() {
+  std::string endpoint = GetEnv(kEndpointEnvVar);
+  return endpoint.empty() ? kDefaultEndpoint : endpoint;
+}
+
+size_t GetEmbeddingDimensions() {
+  size_t dimensions = 0;
+  if (base::StringToSizeT(GetEnv(kEmbedDimEnvVar), &dimensions) &&
+      dimensions > 0) {
+    return dimensions;
+  }
+  return kDefaultEmbeddingDimensions;
+}
+
+double GetSearchScoreThreshold() {
+  double threshold = 0.0;
+  if (base::StringToDouble(GetEnv(kEmbedScoreThresholdEnvVar), &threshold) &&
+      threshold > 0.0 && threshold < 1.0) {
+    return threshold;
+  }
+  // Gemma-family embedding similarities for related text sit well below the
+  // 0.9 default tuned for the original Google embedder.
+  return 0.5;
+}
+
+}  // namespace
+
+// static
+bool AuraDeLocalPassageEmbedder::IsEnabled() {
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return false;
+  }
+  if (GetEnv(kProfileEnvVar) != kAdvancedPlusAiProfile) {
+    return false;
+  }
+  return !GetEmbedModel().empty();
+}
+
+// static
+EmbedderMetadata AuraDeLocalPassageEmbedder::GetMetadata() {
+  // Derive a stable nonzero version from the model name so switching the
+  // local model invalidates and re-embeds existing databases.
+  int64_t version =
+      static_cast<int64_t>(base::PersistentHash(GetEmbedModel())) + 1;
+  return EmbedderMetadata(version, GetEmbeddingDimensions(),
+                          GetSearchScoreThreshold());
+}
+
+AuraDeLocalPassageEmbedder::AuraDeLocalPassageEmbedder(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : url_loader_factory_(std::move(url_loader_factory)) {}
+
+AuraDeLocalPassageEmbedder::~AuraDeLocalPassageEmbedder() = default;
+
+void AuraDeLocalPassageEmbedder::ComputeEmbeddings(
+    std::vector<std::string> passages,
+    ResultCallback callback) {
+  base::ListValue input;
+  for (const std::string& passage : passages) {
+    input.Append(passage);
+  }
+  base::DictValue body;
+  body.Set("model", GetEmbedModel());
+  body.Set("input", std::move(input));
+  body.Set("truncate", true);
+  std::string post_body;
+  base::JSONWriter::Write(body, &post_body);
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(GetEndpoint() + "/api/embed");
+  resource_request->method = "POST";
+  resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kAuraDeLocalEmbedTrafficAnnotation);
+  loader->AttachStringForUpload(post_body, "application/json");
+  loader->SetTimeoutDuration(kRequestTimeout);
+
+  loaders_.push_front(std::move(loader));
+  auto loader_it = loaders_.begin();
+  (*loader_it)
+      ->DownloadToString(
+          url_loader_factory_.get(),
+          base::BindOnce(&AuraDeLocalPassageEmbedder::OnResponse,
+                         base::Unretained(this), loader_it, passages.size(),
+                         std::move(callback)),
+          kMaxResponseBytes);
+}
+
+void AuraDeLocalPassageEmbedder::OnResponse(
+    LoaderList::iterator loader_it,
+    size_t expected_count,
+    ResultCallback callback,
+    std::optional<std::string> response_body) {
+  const int net_error = (*loader_it)->NetError();
+  loaders_.erase(loader_it);
+
+  if (net_error != net::OK || !response_body.has_value()) {
+    LOG(ERROR) << "AuraDE embeddings: local endpoint request failed, net "
+                  "error "
+               << net_error;
+    std::move(callback).Run({}, ComputeEmbeddingsStatus::kExecutionFailure);
+    return;
+  }
+
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(*response_body, /*options=*/0);
+  if (!parsed) {
+    LOG(ERROR) << "AuraDE embeddings: local endpoint returned invalid JSON";
+    std::move(callback).Run({}, ComputeEmbeddingsStatus::kExecutionFailure);
+    return;
+  }
+
+  if (const std::string* error = parsed->FindString("error")) {
+    LOG(ERROR) << "AuraDE embeddings: local endpoint error: " << *error;
+    std::move(callback).Run({}, ComputeEmbeddingsStatus::kModelUnavailable);
+    return;
+  }
+
+  const base::ListValue* embeddings = parsed->FindList("embeddings");
+  if (!embeddings || embeddings->size() != expected_count) {
+    LOG(ERROR) << "AuraDE embeddings: expected " << expected_count
+               << " embeddings, got "
+               << (embeddings ? embeddings->size() : 0u);
+    std::move(callback).Run({}, ComputeEmbeddingsStatus::kExecutionFailure);
+    return;
+  }
+
+  const size_t expected_dimensions = GetEmbeddingDimensions();
+  std::vector<mojom::PassageEmbeddingsResultPtr> results;
+  results.reserve(embeddings->size());
+  for (const base::Value& entry : *embeddings) {
+    const base::ListValue* vector = entry.GetIfList();
+    if (!vector || vector->size() != expected_dimensions) {
+      LOG(ERROR) << "AuraDE embeddings: embedding size "
+                 << (vector ? vector->size() : 0u) << " does not match "
+                 << "configured " << kEmbedDimEnvVar << "="
+                 << expected_dimensions;
+      std::move(callback).Run({}, ComputeEmbeddingsStatus::kExecutionFailure);
+      return;
+    }
+    auto result = mojom::PassageEmbeddingsResult::New();
+    result->embeddings.reserve(vector->size());
+    double magnitude_squared = 0.0;
+    for (const base::Value& component : *vector) {
+      const double value = component.GetIfDouble().value_or(0.0);
+      magnitude_squared += value * value;
+      result->embeddings.push_back(static_cast<float>(value));
+    }
+    // Normalize so downstream dot-product scoring behaves like the
+    // upstream embedder, which produces unit vectors.
+    const double magnitude = std::sqrt(magnitude_squared);
+    if (magnitude > 0.0) {
+      for (float& component : result->embeddings) {
+        component = static_cast<float>(component / magnitude);
+      }
+    }
+    results.push_back(std::move(result));
+  }
+
+  std::move(callback).Run(std::move(results),
+                          ComputeEmbeddingsStatus::kSuccess);
+}
+
+}  // namespace passage_embeddings
