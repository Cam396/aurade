+constexpr char kLinuxUnlockCheck[] =
+    "/usr/lib/chromiumos-ash/aurade-unlock-check";
+
+// AuraDE: asks the PAM checker whether `password` is the password of the
+// user this desktop runs as. It reads the password on its standard input, so
+// it never appears in a command line, and answers with its exit status.
+// PAM's own delay after a wrong password applies, as it does at the greeter.
+bool CheckLinuxPassword(std::string password) {
+  bool written = false;
+  int exit_code = -1;
+  int fds[2];
+  if (pipe2(fds, O_CLOEXEC) == 0) {
+    base::ScopedFD read_end(fds[0]);
+    base::ScopedFD write_end(fds[1]);
+    base::LaunchOptions options;
+    options.fds_to_remap.emplace_back(read_end.get(), STDIN_FILENO);
+    // PAM reads the password database through unix_chkpwd, which is setuid;
+    // a child started with no new privileges could not run it as root and
+    // every password, the right one included, would fail.
+    options.allow_new_privs = true;
+    base::Process process = base::LaunchProcess(
+        base::CommandLine(base::FilePath(kLinuxUnlockCheck)), options);
+    read_end.reset();
+    if (process.IsValid()) {
+      written = base::WriteFileDescriptor(write_end.get(), password);
+      write_end.reset();
+      if (!process.WaitForExitWithTimeout(base::Seconds(60), &exit_code)) {
+        process.Terminate(1, /*wait=*/false);
+        exit_code = -1;
+      }
+    } else {
+      LOG(ERROR) << "Cannot start " << kLinuxUnlockCheck;
+    }
+  }
+  std::fill(password.begin(), password.end(), '\0');
+  return written && exit_code == 0;
+}
