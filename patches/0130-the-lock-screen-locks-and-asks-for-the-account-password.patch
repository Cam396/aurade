new file mode 100644
index 000000000000..9157daeee676
--- /dev/null
+++ b/chrome/browser/ash/dbus/logind_lock_bridge.h
@@ -0,0 +1,75 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_LOGIND_LOCK_BRIDGE_H_
+#define CHROME_BROWSER_ASH_DBUS_LOGIND_LOCK_BRIDGE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/session_manager/core/session_manager.h"
+#include "components/session_manager/core/session_manager_observer.h"
+
+namespace base {
+class Thread;
+}  // namespace base
+
+namespace dbus {
+class Bus;
+class ObjectProxy;
+class Response;
+class Signal;
+}  // namespace dbus
+
+namespace ash {
+
+// AuraDE compatibility: the desktop's lock screen answers to logind, as a
+// Linux desktop's locker does. "loginctl lock-session", a locker started by
+// an idle timer or before sleep, and the session control script all ask
+// logind to lock the session, and logind tells the session's own desktop.
+// The other way round, logind's LockedHint follows the lock screen, so the
+// rest of the system can tell whether this session is locked.
+class LogindLockBridge : public session_manager::SessionManagerObserver {
+ public:
+  // Returns null on ChromeOS, which has no logind.
+  static std::unique_ptr<LogindLockBridge> Create();
+
+  LogindLockBridge();
+  LogindLockBridge(const LogindLockBridge&) = delete;
+  LogindLockBridge& operator=(const LogindLockBridge&) = delete;
+  ~LogindLockBridge() override;
+
+  // session_manager::SessionManagerObserver:
+  void OnSessionStateChanged() override;
+
+ private:
+  void OnGotSession(dbus::Response* response);
+  void OnLockSignal(dbus::Signal* signal);
+  void OnSignalConnected(const std::string& interface_name,
+                         const std::string& signal_name,
+                         bool success);
+  void ReportLocked();
+
+  bool Start();
+
+  // A connection of its own, on a thread of its own, as the polkit agent
+  // has: the desktop's shared system bus is not set up off ChromeOS.
+  std::unique_ptr<base::Thread> dbus_thread_;
+  scoped_refptr<dbus::Bus> bus_;
+  raw_ptr<dbus::ObjectProxy> session_proxy_ = nullptr;
+  std::optional<bool> reported_locked_;
+  base::ScopedObservation<session_manager::SessionManager,
+                          session_manager::SessionManagerObserver>
+      session_observation_{this};
+  base::WeakPtrFactory<LogindLockBridge> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_LOGIND_LOCK_BRIDGE_H_
diff --git a/chrome/browser/ash/dbus/logind_lock_bridge.cc b/chrome/browser/ash/dbus/logind_lock_bridge.cc
new file mode 100644
index 000000000000..5c354723c7c8
--- /dev/null
+++ b/chrome/browser/ash/dbus/logind_lock_bridge.cc
@@ -0,0 +1,150 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/logind_lock_bridge.h"
+
+#include <unistd.h>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/message_loop/message_pump_type.h"
+#include "base/system/sys_info.h"
+#include "base/threading/thread.h"
+#include "chrome/browser/ash/login/lock/screen_locker_controller.h"
+#include "components/session_manager/session_manager_types.h"
+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+
+namespace ash {
+
+namespace {
+
+constexpr char kLogindService[] = "org.freedesktop.login1";
+constexpr char kLogindPath[] = "/org/freedesktop/login1";
+constexpr char kLogindManagerInterface[] = "org.freedesktop.login1.Manager";
+constexpr char kLogindSessionInterface[] = "org.freedesktop.login1.Session";
+
+}  // namespace
+
+// static
+std::unique_ptr<LogindLockBridge> LogindLockBridge::Create() {
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return nullptr;
+  }
+  auto bridge = std::make_unique<LogindLockBridge>();
+  if (!bridge->Start()) {
+    return nullptr;
+  }
+  return bridge;
+}
+
+LogindLockBridge::LogindLockBridge() = default;
+
+LogindLockBridge::~LogindLockBridge() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  session_proxy_ = nullptr;
+  if (bus_) {
+    bus_->ShutdownOnDBusThreadAndBlock();
+    bus_.reset();
+  }
+  if (dbus_thread_) {
+    dbus_thread_->Stop();
+  }
+}
+
+bool LogindLockBridge::Start() {
+  dbus_thread_ = std::make_unique<base::Thread>("AuraDE logind D-Bus thread");
+  base::Thread::Options thread_options;
+  thread_options.message_pump_type = base::MessagePumpType::IO;
+  if (!dbus_thread_->StartWithOptions(std::move(thread_options))) {
+    LOG(ERROR) << "AuraDE: the logind lock bridge could not start its thread";
+    return false;
+  }
+  dbus::Bus::Options bus_options;
+  bus_options.bus_type = dbus::Bus::SYSTEM;
+  bus_options.connection_type = dbus::Bus::PRIVATE;
+  bus_options.dbus_task_runner = dbus_thread_->task_runner();
+  bus_ = new dbus::Bus(std::move(bus_options));
+
+  session_observation_.Observe(session_manager::SessionManager::Get());
+  // The desktop runs inside the logind session it was started for, so its
+  // own process names it.
+  dbus::ObjectProxy* manager =
+      bus_->GetObjectProxy(kLogindService, dbus::ObjectPath(kLogindPath));
+  dbus::MethodCall call(kLogindManagerInterface, "GetSessionByPID");
+  dbus::MessageWriter writer(&call);
+  writer.AppendUint32(static_cast<uint32_t>(getpid()));
+  manager->CallMethod(&call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                      base::BindOnce(&LogindLockBridge::OnGotSession,
+                                     weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
+
+void LogindLockBridge::OnGotSession(dbus::Response* response) {
+  dbus::ObjectPath path;
+  if (!response || !dbus::MessageReader(response).PopObjectPath(&path)) {
+    LOG(WARNING) << "AuraDE: no logind session for the desktop; logind "
+                    "cannot lock it";
+    return;
+  }
+  session_proxy_ = bus_->GetObjectProxy(kLogindService, path);
+  session_proxy_->ConnectToSignal(
+      kLogindSessionInterface, "Lock",
+      base::BindRepeating(&LogindLockBridge::OnLockSignal,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&LogindLockBridge::OnSignalConnected,
+                     weak_ptr_factory_.GetWeakPtr()));
+  ReportLocked();
+}
+
+void LogindLockBridge::OnSignalConnected(const std::string& interface_name,
+                                         const std::string& signal_name,
+                                         bool success) {
+  LOG_IF(WARNING, !success) << "AuraDE: cannot listen for " << signal_name;
+}
+
+void LogindLockBridge::OnLockSignal(dbus::Signal* signal) {
+  auto* session_manager = session_manager::SessionManager::Get();
+  if (!session_manager || session_manager->session_state() !=
+                              session_manager::SessionState::ACTIVE) {
+    return;
+  }
+  // Asked of a session that cannot be locked, the lock screen signs out
+  // instead, and a request from outside must never cost the user their
+  // session.
+  const user_manager::User* user =
+      user_manager::UserManager::Get()->GetActiveUser();
+  if (!user || !user->CanLock()) {
+    return;
+  }
+  ScreenLockerController::Get().HandleShowLockScreenRequest();
+}
+
+void LogindLockBridge::OnSessionStateChanged() {
+  ReportLocked();
+}
+
+void LogindLockBridge::ReportLocked() {
+  if (!session_proxy_) {
+    return;
+  }
+  const bool locked = session_manager::SessionManager::Get()->session_state() ==
+                      session_manager::SessionState::LOCKED;
+  if (reported_locked_ == locked) {
+    return;
+  }
+  reported_locked_ = locked;
+  dbus::MethodCall call(kLogindSessionInterface, "SetLockedHint");
+  dbus::MessageWriter writer(&call);
+  writer.AppendBool(locked);
+  session_proxy_->CallMethod(&call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                             base::DoNothing());
+}
+
+}  // namespace ash
