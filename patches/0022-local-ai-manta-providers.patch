+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_MANTA_AURADE_LOCAL_MAHI_PROVIDER_H_
+#define COMPONENTS_MANTA_AURADE_LOCAL_MAHI_PROVIDER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "components/manta/mahi_provider.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace manta {
+
+// AuraDE compatibility: local Mahi implementation backed by the AuraDE Local AI
+// endpoint instead of Google Manta/Gemini services.
+class COMPONENT_EXPORT(MANTA) AuraDELocalMahiProvider : public MahiProvider {
+ public:
+  explicit AuraDELocalMahiProvider(
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+
+  AuraDELocalMahiProvider(const AuraDELocalMahiProvider&) = delete;
+  AuraDELocalMahiProvider& operator=(const AuraDELocalMahiProvider&) = delete;
+
+  ~AuraDELocalMahiProvider() override;
+
+  void Summarize(const std::string& input,
+                 const std::string& title,
+                 const std::optional<std::string>& context,
+                 const std::optional<std::string>& url,
+                 MantaGenericCallback done_callback) override;
+
+  void Elucidate(const std::string& input,
+                 const std::string& context,
+                 const std::string& title,
+                 const std::optional<std::string>& url,
+                 MantaGenericCallback done_callback) override;
+
+  void QuestionAndAnswer(const std::string& content,
+                         const std::string& title,
+                         const std::optional<std::string>& url,
+                         const std::vector<MahiQAPair> QAHistory,
+                         const std::string& question,
+                         MantaGenericCallback done_callback) override;
+
+ private:
+  void CallOllama(const std::string& prompt, MantaGenericCallback callback);
+  void OnOllamaResponse(network::SimpleURLLoader* loader,
+                        MantaGenericCallback callback,
+                        std::optional<std::string> response_body);
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  std::vector<std::unique_ptr<network::SimpleURLLoader>> pending_loaders_;
+  base::WeakPtrFactory<AuraDELocalMahiProvider> weak_ptr_factory_{this};
+};
+
+}  // namespace manta
+
+#endif  // COMPONENTS_MANTA_AURADE_LOCAL_MAHI_PROVIDER_H_
