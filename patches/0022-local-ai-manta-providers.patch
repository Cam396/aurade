+bool ShouldUseAuraDELocalAI() {
+  if (base::SysInfo::IsRunningOnChromeOS()) {
+    return false;
+  }
+
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> profile = env->GetVar("AURADE_FEATURE_PROFILE");
+  if (!profile.has_value() || *profile != "advanced_plus_ai") {
+    return false;
+  }
+
+  std::optional<std::string> backend = env->GetVar("AURADE_LOCAL_AI_BACKEND");
+  return !backend.has_value() || backend->empty() || *backend == "ollama";
