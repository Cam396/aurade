+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace manta {
+
+namespace {
+
+constexpr char kDefaultEndpoint[] = "http://127.0.0.1:11434";
+constexpr char kDefaultModel[] = "gemma4:e2b-it-q4_K_M";
+constexpr size_t kMaxOllamaResponseBytes = 4 * 1024 * 1024;
+
+const net::NetworkTrafficAnnotationTag kAuraDELocalOrcaTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aurade_local_orca_request",
+                                        R"(
+        semantics {
+          sender: "AuraDE Local AI"
+          description:
+            "AuraDE sends Help Me Write text to a local model runtime running "
+            "on the same machine. The default endpoint is Ollama on localhost."
+          trigger:
+            "The user asks AuraDE to write or rewrite text in an editable "
+            "field."
+          user_data {
+            type: USER_CONTENT
+          }
+          data:
+            "The selected text, prompt, tone, locale, and other writing "
+            "metadata supplied by the Help Me Write UI."
+          destination: LOCAL
+          last_reviewed: "2026-06-29"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Only enabled by AuraDE Advanced Plus AI with a local AI backend."
+        })");
+
+std::string GetEnvOrDefault(const char* name, const char* fallback) {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> value = env->GetVar(std::string(name));
+  if (value.has_value() && !value->empty()) {
+    return *value;
+  }
+  return fallback;
+}
+
+GURL GetOllamaGenerateUrl() {
+  std::string endpoint =
+      GetEnvOrDefault("AURADE_LOCAL_AI_ENDPOINT", kDefaultEndpoint);
+  base::TrimString(endpoint, "/", &endpoint);
+  return GURL(endpoint + "/api/generate");
+}
+
+std::string GetOllamaModel() {
+  return GetEnvOrDefault("AURADE_LOCAL_AI_MODEL", kDefaultModel);
+}
+
+std::string DescribeTone(const std::string& tone) {
+  if (tone == "SHORTEN") {
+    return "Shorten the selected text.";
+  }
+  if (tone == "ELABORATE") {
+    return "Elaborate on the selected text.";
+  }
+  if (tone == "REPHRASE") {
+    return "Rephrase the selected text.";
+  }
+  if (tone == "FORMALIZE") {
+    return "Make the selected text more formal.";
+  }
+  if (tone == "EMOJIFY") {
+    return "Rewrite the selected text with appropriate emoji.";
+  }
+  if (tone == "PROOFREAD") {
+    return "Proofread and correct the selected text.";
+  }
+  if (tone == "FREEFORM_WRITE") {
+    return "Write new text for the user request.";
+  }
+  if (tone == "FREEFORM_REWRITE") {
+    return "Rewrite the selected text according to the user request.";
+  }
+  return "Help write or rewrite the text.";
+}
+
+std::string FindInput(const std::map<std::string, std::string>& input,
+                      const char* key) {
+  auto it = input.find(key);
+  return it == input.end() ? std::string() : it->second;
+}
+
+std::string BuildPrompt(const std::map<std::string, std::string>& input) {
+  const std::string tone = FindInput(input, "tone");
+  std::string prompt =
+      "You are AuraDE Local AI, running fully locally. " +
+      DescribeTone(tone) +
+      "\nReturn exactly one useful text suggestion. Do not mention policies, "
+      "prompts, or that you are a model.\n\n";
+
+  const std::string freeform = FindInput(input, "freeform_text");
+  const std::string selected = FindInput(input, "selected_text");
+  const std::string context = FindInput(input, "surrounding_text");
+  const std::string locale = FindInput(input, "locale");
+
+  if (!locale.empty()) {
+    prompt += "Locale: " + locale + "\n";
+  }
+  if (!freeform.empty()) {
+    prompt += "User request:\n" + freeform + "\n\n";
+  }
+  if (!selected.empty()) {
+    prompt += "Selected text:\n" + selected + "\n\n";
+  }
+  if (!context.empty()) {
+    prompt += "Surrounding context:\n" + context + "\n\n";
+  }
+
+  if (freeform.empty() && selected.empty() && context.empty()) {
+    for (const auto& [key, value] : input) {
+      prompt += key + ": " + value + "\n";
+    }
+  }
+
+  return prompt;
+}
+
+}  // namespace
+
+AuraDELocalOrcaProvider::AuraDELocalOrcaProvider(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : OrcaProvider(url_loader_factory, /*identity_manager=*/nullptr,
+                   ProviderParams()),
+      url_loader_factory_(url_loader_factory) {}
+
+AuraDELocalOrcaProvider::~AuraDELocalOrcaProvider() = default;
+
+void AuraDELocalOrcaProvider::Call(
+    const std::map<std::string, std::string>& input,
+    MantaGenericCallback done_callback) {
+  if (!input.contains("tone")) {
+    std::move(done_callback)
+        .Run(base::DictValue(),
+             {MantaStatusCode::kInvalidInput, /*message=*/std::string()});
+    return;
+  }
+
+  CallOllama(BuildPrompt(input), std::move(done_callback));
+}
+
+void AuraDELocalOrcaProvider::CallOllama(const std::string& prompt,
+                                         MantaGenericCallback callback) {
+  if (!url_loader_factory_) {
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kBackendFailure, "AuraDE local AI has no loader"});
+    return;
+  }
+
+  base::DictValue request_body;
+  request_body.Set("model", GetOllamaModel());
+  request_body.Set("prompt", prompt);
+  request_body.Set("stream", false);
+
+  std::string post_body;
+  if (!base::JSONWriter::Write(request_body, &post_body)) {
+    std::move(callback).Run(base::DictValue(),
+                            {MantaStatusCode::kInvalidInput,
+                             "AuraDE local AI request serialization failed"});
+    return;
+  }
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GetOllamaGenerateUrl();
+  resource_request->method = "POST";
+  resource_request->load_flags =
+      net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+  resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kAuraDELocalOrcaTrafficAnnotation);
+  loader->AttachStringForUpload(post_body, "application/json");
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  pending_loaders_.push_back(std::move(loader));
+  loader_ptr->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&AuraDELocalOrcaProvider::OnOllamaResponse,
+                     weak_ptr_factory_.GetWeakPtr(), loader_ptr,
+                     std::move(callback)),
+      kMaxOllamaResponseBytes);
+}
+
+void AuraDELocalOrcaProvider::OnOllamaResponse(
+    network::SimpleURLLoader* loader,
+    MantaGenericCallback callback,
+    std::optional<std::string> response_body) {
+  int net_error = loader ? loader->NetError() : net::ERR_FAILED;
+  auto it = std::find_if(pending_loaders_.begin(), pending_loaders_.end(),
+                         [loader](const auto& pending_loader) {
+                           return pending_loader.get() == loader;
+                         });
+  if (it != pending_loaders_.end()) {
+    pending_loaders_.erase(it);
+  }
+
+  if (net_error != net::OK || !response_body) {
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kNoInternetConnection,
+         "AuraDE local AI backend is unavailable"});
+    return;
+  }
+
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(*response_body, /*options=*/0);
+  if (!parsed.has_value()) {
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kMalformedResponse,
+         "AuraDE local AI returned malformed JSON"});
+    return;
+  }
+
+  const std::string* output = parsed->FindString("response");
+  if (!output || output->empty()) {
+    const std::string* error = parsed->FindString("error");
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kBackendFailure,
+         error ? *error : "AuraDE local AI returned no output"});
+    return;
+  }
+
+  std::move(callback).Run(
+      base::DictValue().Set(
+          "outputData",
+          base::ListValue().Append(base::DictValue().Set("text", *output))),
+      {MantaStatusCode::kOk});
+}
+
+}  // namespace manta
