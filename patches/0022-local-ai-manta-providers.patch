index 0000000000..323dee028b
--- /dev/null
+++ b/components/manta/aurade_local_mahi_provider.cc
@@ -0,0 +1,266 @@
+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/manta/aurade_local_mahi_provider.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/environment.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/manta/manta_status.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace manta {
+
+namespace {
+
+constexpr char kDefaultEndpoint[] = "http://127.0.0.1:11434";
+constexpr char kDefaultModel[] = "gemma4:e2b-it-q4_K_M";
+constexpr size_t kMaxOllamaResponseBytes = 4 * 1024 * 1024;
+
+const net::NetworkTrafficAnnotationTag kAuraDELocalMahiTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aurade_local_mahi_request",
+                                        R"(
+        semantics {
+          sender: "AuraDE Local AI"
+          description:
+            "AuraDE sends Help Me Read text to a local model runtime running "
+            "on the same machine. The default endpoint is Ollama on localhost."
+          trigger:
+            "The user asks AuraDE to summarize, simplify, or answer a "
+            "question about local page or document text."
+          user_data {
+            type: USER_CONTENT
+            type: WEB_CONTENT
+          }
+          data:
+            "The selected text, page content, page title, page URL, and user "
+            "question when provided."
+          destination: LOCAL
+          last_reviewed: "2026-06-29"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Only enabled by AuraDE Advanced Plus AI with a local AI backend."
+        })");
+
+std::string GetEnvOrDefault(const char* name, const char* fallback) {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> value = env->GetVar(std::string(name));
+  if (value.has_value() && !value->empty()) {
+    return *value;
+  }
+  return fallback;
+}
+
+GURL GetOllamaGenerateUrl() {
+  std::string endpoint =
+      GetEnvOrDefault("AURADE_LOCAL_AI_ENDPOINT", kDefaultEndpoint);
+  base::TrimString(endpoint, "/", &endpoint);
+  return GURL(endpoint + "/api/generate");
+}
+
+std::string GetOllamaModel() {
+  return GetEnvOrDefault("AURADE_LOCAL_AI_MODEL", kDefaultModel);
+}
+
+std::string BuildHeader(const char* task,
+                        const std::string& title,
+                        const std::optional<std::string>& url) {
+  std::string prompt =
+      "You are AuraDE Local AI, running fully locally. " + std::string(task) +
+      "\nReturn only the useful answer. Do not mention policies, prompts, or "
+      "that you are a model.\n\n";
+  if (!title.empty()) {
+    prompt += "Title: " + title + "\n";
+  }
+  if (url.has_value() && !url->empty()) {
+    prompt += "URL: " + *url + "\n";
+  }
+  return prompt;
+}
+
+std::string BuildSummaryPrompt(const std::string& input,
+                               const std::string& title,
+                               const std::optional<std::string>& context,
+                               const std::optional<std::string>& url) {
+  std::string prompt =
+      BuildHeader("Summarize this content clearly and concisely.", title, url);
+  if (context.has_value() && !context->empty()) {
+    prompt += "Context:\n" + *context + "\n\n";
+  }
+  prompt += "Content:\n" + input;
+  return prompt;
+}
+
+std::string BuildElucidationPrompt(const std::string& input,
+                                   const std::string& context,
+                                   const std::string& title,
+                                   const std::optional<std::string>& url) {
+  std::string prompt =
+      BuildHeader("Explain the selected text in simpler language.", title, url);
+  prompt += "Full context:\n" + context + "\n\nSelected text:\n" + input;
+  return prompt;
+}
+
+std::string BuildQAPrompt(const std::string& content,
+                          const std::string& title,
+                          const std::optional<std::string>& url,
+                          const std::vector<MahiProvider::MahiQAPair>& history,
+                          const std::string& question) {
+  std::string prompt =
+      BuildHeader("Answer the user's question using the provided content.",
+                  title, url);
+  if (!history.empty()) {
+    prompt += "Previous Q&A:\n";
+    for (const auto& [previous_question, previous_answer] : history) {
+      prompt += "Q: " + previous_question + "\nA: " + previous_answer + "\n";
+    }
+    prompt += "\n";
+  }
+  prompt += "Content:\n" + content + "\n\nQuestion:\n" + question;
+  return prompt;
+}
+
+}  // namespace
+
+AuraDELocalMahiProvider::AuraDELocalMahiProvider(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : MahiProvider(url_loader_factory, /*identity_manager=*/nullptr),
+      url_loader_factory_(url_loader_factory) {}
+
+AuraDELocalMahiProvider::~AuraDELocalMahiProvider() = default;
+
+void AuraDELocalMahiProvider::Summarize(
+    const std::string& input,
+    const std::string& title,
+    const std::optional<std::string>& context,
+    const std::optional<std::string>& url,
+    MantaGenericCallback done_callback) {
+  CallOllama(BuildSummaryPrompt(input, title, context, url),
+             std::move(done_callback));
+}
+
+void AuraDELocalMahiProvider::Elucidate(
+    const std::string& input,
+    const std::string& context,
+    const std::string& title,
+    const std::optional<std::string>& url,
+    MantaGenericCallback done_callback) {
+  CallOllama(BuildElucidationPrompt(input, context, title, url),
+             std::move(done_callback));
+}
+
+void AuraDELocalMahiProvider::QuestionAndAnswer(
+    const std::string& content,
+    const std::string& title,
+    const std::optional<std::string>& url,
+    const std::vector<MahiQAPair> QAHistory,
+    const std::string& question,
+    MantaGenericCallback done_callback) {
+  CallOllama(BuildQAPrompt(content, title, url, QAHistory, question),
+             std::move(done_callback));
+}
+
+void AuraDELocalMahiProvider::CallOllama(const std::string& prompt,
+                                         MantaGenericCallback callback) {
+  if (!url_loader_factory_) {
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kBackendFailure, "AuraDE local AI has no loader"});
+    return;
+  }
+
+  base::DictValue request_body;
+  request_body.Set("model", GetOllamaModel());
+  request_body.Set("prompt", prompt);
+  request_body.Set("stream", false);
+
+  std::string post_body;
+  if (!base::JSONWriter::Write(request_body, &post_body)) {
+    std::move(callback).Run(base::DictValue(),
+                            {MantaStatusCode::kInvalidInput,
+                             "AuraDE local AI request serialization failed"});
+    return;
+  }
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GetOllamaGenerateUrl();
+  resource_request->method = "POST";
+  resource_request->load_flags =
+      net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+  resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kAuraDELocalMahiTrafficAnnotation);
+  loader->AttachStringForUpload(post_body, "application/json");
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  pending_loaders_.push_back(std::move(loader));
+  loader_ptr->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&AuraDELocalMahiProvider::OnOllamaResponse,
+                     weak_ptr_factory_.GetWeakPtr(), loader_ptr,
+                     std::move(callback)),
+      kMaxOllamaResponseBytes);
+}
+
+void AuraDELocalMahiProvider::OnOllamaResponse(
+    network::SimpleURLLoader* loader,
+    MantaGenericCallback callback,
+    std::optional<std::string> response_body) {
+  int net_error = loader ? loader->NetError() : net::ERR_FAILED;
+  auto it = std::ranges::find_if(
+      pending_loaders_, [loader](const auto& pending_loader) {
+        return pending_loader.get() == loader;
+      });
+  if (it != pending_loaders_.end()) {
+    pending_loaders_.erase(it);
+  }
+
+  if (net_error != net::OK || !response_body) {
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kNoInternetConnection,
+         "AuraDE local AI backend is unavailable"});
+    return;
+  }
+
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(*response_body, /*options=*/0);
+  if (!parsed.has_value()) {
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kMalformedResponse,
+         "AuraDE local AI returned malformed JSON"});
+    return;
+  }
+
+  const std::string* output = parsed->FindString("response");
+  if (!output || output->empty()) {
+    const std::string* error = parsed->FindString("error");
+    std::move(callback).Run(
+        base::DictValue(),
+        {MantaStatusCode::kBackendFailure,
+         error ? *error : "AuraDE local AI returned no output"});
+    return;
+  }
+
+  std::move(callback).Run(base::DictValue().Set("outputData", *output),
+                          {MantaStatusCode::kOk});
+}
+
+}  // namespace manta
