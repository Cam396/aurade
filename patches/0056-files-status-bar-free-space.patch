+/* The bar holds three spans and the right hand two share one slot, so
+ * space-between is wrong here: with the middle span empty it would centre
+ * whichever one had text. Pushing the count away from the others puts the
+ * count at the start and packs the rest at the end, which reads correctly
+ * whichever of the two is the one carrying text. */
+#aurade-status-count {
+  margin-inline-end: auto;
+}
+
 #aurade-status-count,
+#aurade-status-space,
 #aurade-status-selection {
   /* These are numbers that change in place as you move through a folder.
    * Proportional digits make the text jitter every time the count ticks. */
@@ -2332,6 +2341,12 @@
   white-space: nowrap;
 }
 
+#aurade-status-space {
+  /* Inherits the bar's own on_surface_variant. Free space is background
+   * information that should never compete with the selection for attention. */
+  text-align: end;
+}
+
 #aurade-status-selection {
   color: var(--cros-sys-primary);
   text-align: end;
