+  private async auraDeRefreshFreeSpace_() {
+    const request = ++this.auraDeSpaceRequest_;
+    const volumeInfo = this.directoryModel_.getCurrentVolumeInfo();
+    if (!volumeInfo || volumeInfo.volumeType === VolumeType.PROVIDED ||
