+  /**
+   * What leaves the window when a row is dragged away.
+   *
+   * The desktop hands a drag to another window's application as files only
+   * when the data is what ChromeOS's own Files app writes: a tag and the list
+   * of file system URLs in `fs/sources`. A key is exactly such a URL, so the
+   * payload is the selection's keys, one to a line. Picking up a row that is
+   * not selected selects it first, as every file manager does.
+   */
+  private onDragStart = (event: DragEvent): void => {
+    const index = this.indexFromEvent(event);
+    const transfer = event.dataTransfer;
+    if (index < 0 || !transfer) {
+      return;
+    }
+    if (!this.selection.has(index)) {
+      this.selectIndex(index, 'replace');
+    }
+    transfer.effectAllowed = 'copyMove';
+    transfer.setData('fs/tag', 'filemanager-data');
+    transfer.setData('fs/sources', [...this.selectedKeys()].join('\n'));
+    transfer.setData('fs/effectallowed', 'copyMove');
+  };
+
