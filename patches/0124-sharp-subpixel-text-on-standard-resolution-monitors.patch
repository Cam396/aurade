+  // AuraDE: the subpixel order is one setting for every monitor, and a
+  // monitor turned on its side would show it the wrong way round.
+  if (!base::SysInfo::IsRunningOnChromeOS()) {
+    for (const auto& display : active_display_list_) {
+      if (GetDisplayInfo(display.id()).GetLogicalActiveRotation() !=
+          Display::ROTATE_0) {
+        force_disable_subpixel_font_rendering = true;
+      }
+    }
+  }
+
   if (features::IsOledScaleFactorEnabled()) {
     force_disable_subpixel_font_rendering = true;
   }
