+ExternalInstallOptions MakeAuraDePwa(const char* install_url,
+                                     const char* start_url,
+                                     const char* scope,
+                                     std::u16string title,
+                                     const char* expected_app_id = nullptr,
+                                     const char* replacement_app_id = nullptr) {
+  GURL app_start_url(start_url);
+  GURL app_scope(scope);
+  ExternalInstallOptions options(GURL(install_url),
+                                 mojom::UserDisplayMode::kStandalone,
+                                 ExternalInstallSource::kExternalDefault);
+  options.user_type_allowlist = {"unmanaged", "managed", "child"};
+  options.load_and_await_service_worker_registration = false;
+  options.is_preferred_app_for_supported_links = true;
+  options.fallback_app_name = base::UTF16ToUTF8(title);
+  options.app_info_factory = base::BindRepeating(
+      [](GURL start_url, GURL scope, std::u16string title) {
+        webapps::ManifestId manifest_id =
+            GenerateManifestIdFromStartUrlOnly(start_url);
+        auto info = std::make_unique<WebAppInstallInfo>(manifest_id, start_url);
+        info->title = std::move(title);
+        info->scope = scope;
+        info->display_mode = blink::mojom::DisplayMode::kStandalone;
+        return info;
+      },
+      app_start_url, app_scope, std::move(title));
+  if (expected_app_id) {
+    options.expected_app_id = webapps::AppId(expected_app_id);
+  }
+  if (replacement_app_id) {
+    options.uninstall_and_replace.push_back(webapps::AppId(replacement_app_id));
+  }
+  return options;
+}
