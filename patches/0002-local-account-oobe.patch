+
+namespace ash {
+
+class AuraLocalAccountScreen;
+
+class AuraLocalAccountView {
+ public:
+  inline constexpr static StaticOobeScreenId kScreenId{
+      "aura-local-account", "AuraLocalAccountScreen"};
+
+  virtual ~AuraLocalAccountView() = default;
+
+  virtual void Show() = 0;
+  virtual base::WeakPtr<AuraLocalAccountView> AsWeakPtr() = 0;
+};
+
+class AuraLocalAccountScreenHandler final : public AuraLocalAccountView,
