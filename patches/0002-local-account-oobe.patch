@@ -0,0 +1,154 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/login/screens/aura_local_account_screen.h"
+
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/strcat.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/ash/login/aura_local_account_screen_handler.h"
+
+namespace ash {
+namespace {
+
+constexpr char kUserActionBack[] = "back";
+constexpr char kUserActionStartSession[] = "start-session";
+
+base::FilePath GetAuraProfileConfigPath() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> xdg_config_home = env->GetVar("XDG_CONFIG_HOME");
+  if (xdg_config_home.has_value() && !xdg_config_home->empty()) {
+    return base::FilePath(*xdg_config_home)
+        .AppendASCII("aurade")
+        .AppendASCII("profile.json");
+  }
+  return base::GetHomeDir()
+      .AppendASCII(".config")
+      .AppendASCII("aurade")
+      .AppendASCII("profile.json");
+}
+
+std::string GetLinuxUsername() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> username = env->GetVar("USER");
+  if (username.has_value() && !username->empty()) {
+    return *username;
+  }
+  username = env->GetVar("LOGNAME");
+  if (username.has_value() && !username->empty()) {
+    return *username;
+  }
+  return "local";
+}
+
+void PersistLocalProfileMetadataBlocking(std::string display_name,
+                                         std::string password_hint) {
+  const std::string linux_username = GetLinuxUsername();
+
+  base::DictValue profile;
+  profile.Set("version", 1);
+  profile.Set("linux_username", linux_username);
+  profile.Set("account_id", base::StrCat({linux_username, "@local.aurade"}));
+  profile.Set("display_name", display_name);
+  profile.Set("password_hint", password_hint);
+  profile.Set("identity_source", "aurade-local");
+
+  std::string json;
+  if (!base::JSONWriter::WriteWithOptions(
+          profile, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json)) {
+    LOG(ERROR) << "AuraDE local profile metadata serialization failed";
+    return;
+  }
+
+  const base::FilePath path = GetAuraProfileConfigPath();
+  if (!base::CreateDirectory(path.DirName())) {
+    PLOG(ERROR) << "AuraDE local profile config directory creation failed: "
+                << path.DirName();
+    return;
+  }
+  if (!base::WriteFile(path, json)) {
+    PLOG(ERROR) << "AuraDE local profile metadata write failed: " << path;
+  }
+}
+
+}  // namespace
+
+// static
+std::string AuraLocalAccountScreen::GetResultString(Result result) {
+  switch (result) {
+    case Result::BACK:
+      return "Back";
+    case Result::START_SESSION:
+      return "StartSession";
+    case Result::NOT_APPLICABLE:
+      return BaseScreen::kNotApplicable;
+  }
+}
+
+AuraLocalAccountScreen::AuraLocalAccountScreen(
+    base::WeakPtr<AuraLocalAccountView> view,
+    const ScreenExitCallback& exit_callback)
+    : BaseScreen(AuraLocalAccountView::kScreenId,
+                 OobeScreenPriority::DEFAULT),
+      view_(std::move(view)),
+      exit_callback_(exit_callback) {}
+
+AuraLocalAccountScreen::~AuraLocalAccountScreen() = default;
+
+bool AuraLocalAccountScreen::MaybeSkip(WizardContext& context) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "aurade-enable-local-accounts")) {
+    exit_callback_.Run(Result::NOT_APPLICABLE);
+    return true;
+  }
+  return false;
+}
+
+void AuraLocalAccountScreen::ShowImpl() {
+  if (view_) {
+    view_->Show();
+  }
+}
+
+void AuraLocalAccountScreen::HideImpl() {}
+
+void AuraLocalAccountScreen::OnUserAction(const base::ListValue& args) {
+  const std::string& action_id = args[0].GetString();
+  if (action_id == kUserActionBack) {
+    exit_callback_.Run(Result::BACK);
+  } else if (action_id == kUserActionStartSession) {
+    ScheduleLocalProfileMetadataPersistence(args);
+    exit_callback_.Run(Result::START_SESSION);
+  } else {
+    BaseScreen::OnUserAction(args);
+  }
+}
+
+void AuraLocalAccountScreen::ScheduleLocalProfileMetadataPersistence(
+    const base::ListValue& args) {
+  std::string display_name;
+  std::string password_hint;
+  if (args.size() > 1 && args[1].is_string()) {
+    display_name = args[1].GetString();
+  }
+  if (args.size() > 2 && args[2].is_string()) {
+    password_hint = args[2].GetString();
+  }
+
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&PersistLocalProfileMetadataBlocking,
+                     std::move(display_name), std::move(password_hint)));
+}
+
+}  // namespace ash
