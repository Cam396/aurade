+ private:
+  void Show() override;
+  base::WeakPtr<AuraLocalAccountView> AsWeakPtr() override;
+
+  void DeclareLocalizedValues(
+      ::login::LocalizedValuesBuilder* builder) override;
+
+  base::WeakPtrFactory<AuraLocalAccountView> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
