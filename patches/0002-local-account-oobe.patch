+void WizardController::OnAuraLocalAccountScreenExit(
+    AuraLocalAccountScreen::Result result) {
+  OnScreenExit(AuraLocalAccountView::kScreenId,
+               AuraLocalAccountScreen::GetResultString(result));
+  switch (result) {
+    case AuraLocalAccountScreen::Result::BACK:
+      AdvanceToScreen(UserCreationView::kScreenId);
+      break;
+    case AuraLocalAccountScreen::Result::START_SESSION: {
+      const std::string linux_username = GetAuraLocalLinuxUsername();
+      const AccountId account_id = AccountId::FromUserEmailGaiaId(
+          base::StrCat({linux_username, kAuraLocalAccountDomain}),
+          GaiaId(base::StrCat({kAuraLocalGaiaIdPrefix, linux_username})));
+      MarkAuraLocalAccountOfflineReady(account_id, &local_state_.get());
+      PerformOOBECompletedActions(
+          OobeMetricsHelper::CompletedPreLoginOobeFlowType::kRegular);
+      if (!StartupUtils::IsOobeCompleted(local_state_.get())) {
+        break;
+      }
+      UserContext user_context(user_manager::UserType::kRegular, account_id);
+      user_context.SetAuthFlow(UserContext::AUTH_FLOW_OFFLINE);
+      user_context.SetIsUsingOAuth(false);
+      user_context.SetSessionLifetime(base::Time::Now() +
+                                      kAuraLocalAuthSessionLifetime);
+      user_context.SetAuthSessionIds(
+          base::StrCat({kAuraLocalGaiaIdPrefix, linux_username, "-session"}),
+          base::StrCat({kAuraLocalGaiaIdPrefix, linux_username, "-broadcast"}));
+      user_context.SetUserIDHash(base::StrCat({"local-", linux_username}));
+      user_context.SetAuthFactorsConfiguration(AuthFactorsConfiguration());
+
+      UserSessionManager::GetInstance()->StartSession(
+          user_context, UserSessionManager::StartSessionType::kPrimary,
+          false,  // has_auth_cookies
+          false,  // has_active_session
+          base::WeakPtr<UserSessionManagerDelegate>());
+      break;
+    }
+    case AuraLocalAccountScreen::Result::NOT_APPLICABLE:
+      AdvanceToScreen(GaiaView::kScreenId);
+      break;
+  }
+}
