+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_AURA_LOCAL_ACCOUNT_SCREEN_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_AURA_LOCAL_ACCOUNT_SCREEN_HANDLER_H_
+
+#include "base/memory/weak_ptr.h"
