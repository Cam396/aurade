+#ifndef CHROME_BROWSER_ASH_LOGIN_SCREENS_AURA_LOCAL_ACCOUNT_SCREEN_H_
+#define CHROME_BROWSER_ASH_LOGIN_SCREENS_AURA_LOCAL_ACCOUNT_SCREEN_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ash/login/screens/base_screen.h"
+
+namespace ash {
+
+class AuraLocalAccountView;
+
+// AuraDE local account setup screen. This is Linux-host only and is gated by
+// the AuraDE launcher flag.
+class AuraLocalAccountScreen : public BaseScreen {
+ public:
+  enum class Result {
+    BACK,
+    START_SESSION,
+    NOT_APPLICABLE,
+  };
+
+  using TView = AuraLocalAccountView;
+  using ScreenExitCallback = base::RepeatingCallback<void(Result result)>;
+
+  static std::string GetResultString(Result result);
+
+  explicit AuraLocalAccountScreen(base::WeakPtr<AuraLocalAccountView> view,
+                                  const ScreenExitCallback& exit_callback);
+  ~AuraLocalAccountScreen() override;
+
+  AuraLocalAccountScreen(const AuraLocalAccountScreen&) = delete;
+  AuraLocalAccountScreen& operator=(const AuraLocalAccountScreen&) = delete;
+
+ private:
+  bool MaybeSkip(WizardContext& context) override;
+  void ShowImpl() override;
+  void HideImpl() override;
+  void OnUserAction(const base::ListValue& args) override;
+
+  void ScheduleLocalProfileMetadataPersistence(const base::ListValue& args);
+
+  base::WeakPtr<AuraLocalAccountView> view_;
+  ScreenExitCallback exit_callback_;
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_LOGIN_SCREENS_AURA_LOCAL_ACCOUNT_SCREEN_H_
