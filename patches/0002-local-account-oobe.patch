+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/login/aura_local_account_screen_handler.h"
+
+#include "components/login/localized_values_builder.h"
+
+namespace ash {
+
+AuraLocalAccountScreenHandler::AuraLocalAccountScreenHandler()
+    : BaseScreenHandler(kScreenId) {}
+
+AuraLocalAccountScreenHandler::~AuraLocalAccountScreenHandler() = default;
+
+void AuraLocalAccountScreenHandler::DeclareLocalizedValues(
+    ::login::LocalizedValuesBuilder* builder) {
+  builder->Add("auraLocalAccountTitle", "Set up your local account");
+  builder->Add("auraLocalAccountSubtitle",
+               "AuraDE will use this Linux user and store files in your home "
+               "folder.");
+  builder->Add("auraLocalAccountDisplayName", "Display name");
+  builder->Add("auraLocalAccountDisplayNamePlaceholder", "Local user");
+  builder->Add("auraLocalAccountPasswordHint", "Password hint");
+  builder->Add("auraLocalAccountPasswordHintPlaceholder",
+               "Optional hint shown only on this device");
+  builder->Add("auraLocalAccountPasswordNote",
+               "Linux password changes require AuraDE account helper support.");
+  builder->Add("auraLocalAccountBack", "Back");
+  builder->Add("auraLocalAccountStart", "Continue");
+}
+
+void AuraLocalAccountScreenHandler::Show() {
+  ShowInWebUI();
+}
+
+base::WeakPtr<AuraLocalAccountView> AuraLocalAccountScreenHandler::AsWeakPtr() {
+  return weak_ptr_factory_.GetWeakPtr();
+}
+
+}  // namespace ash
