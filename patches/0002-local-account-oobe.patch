+<style include="oobe-dialog-host-styles cros-color-overrides">
+  .field-stack {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    width: 100%;
+  }
+
+  .password-note {
+    color: var(--cros-text-color-secondary);
+    font: var(--oobe-default-font);
+    margin-top: 4px;
+  }
+
+  :host-context(.jelly-enabled) cr-input {
+    --cr-input-background-color: var(--cros-sys-input_field_on_shaded);
+  }
+
+  :host-context(.jelly-enabled) .password-note {
+    color: var(--cros-sys-on_surface_variant);
+    font: var(--cros-body-2-font);
+  }
+</style>
+
+<oobe-adaptive-dialog id="auraLocalAccountDialog" role="dialog"
+    single-column>
+  <iron-icon slot="icon" icon="oobe-32:lock"></iron-icon>
+  <h1 slot="title">
+    [[i18nDynamic(locale, 'auraLocalAccountTitle')]]
+  </h1>
+  <div slot="subtitle">
+    [[i18nDynamic(locale, 'auraLocalAccountSubtitle')]]
+  </div>
+  <div slot="content" class="layout vertical center center-justified">
+    <div class="field-stack">
+      <cr-input id="displayNameInput"
+          value="{{displayName_}}"
+          label="[[i18nDynamic(locale, 'auraLocalAccountDisplayName')]]"
+          placeholder="[[i18nDynamic(
+              locale, 'auraLocalAccountDisplayNamePlaceholder')]]"
+          maxlength="80">
+      </cr-input>
+      <cr-input id="passwordHintInput"
+          value="{{passwordHint_}}"
+          label="[[i18nDynamic(locale, 'auraLocalAccountPasswordHint')]]"
+          placeholder="[[i18nDynamic(
+              locale, 'auraLocalAccountPasswordHintPlaceholder')]]"
+          maxlength="120">
+      </cr-input>
+      <div class="password-note">
+        [[i18nDynamic(locale, 'auraLocalAccountPasswordNote')]]
+      </div>
+    </div>
+  </div>
+  <div slot="back-navigation">
+    <oobe-back-button id="backButton" on-click="onBackClicked_">
+    </oobe-back-button>
+  </div>
+  <div slot="bottom-buttons">
+    <oobe-text-button id="startButton" inverse class="focus-on-show"
+        text-key="auraLocalAccountStart"
+        on-click="onStartClicked_">
+    </oobe-text-button>
+  </div>
+</oobe-adaptive-dialog>
