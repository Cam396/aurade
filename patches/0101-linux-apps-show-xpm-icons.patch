+// AuraDE compatibility: older X11 applications, XTerm among them, ship their
+// only icon as an XPM, which nothing here could read, so they showed the
+// generic penguin. XPM is a small text format: a header, a colour table and
+// one string per row. Hex colours, None and the grey scale cover what these
+// applications use; anything else keeps the generic icon.
+std::optional<SkColor> ParseAuraDeXpmColor(std::string_view value) {
+  const std::string name = base::ToLowerASCII(value);
+  if (name == "none") {
+    return SK_ColorTRANSPARENT;
+  }
+  if (name == "black") {
+    return SK_ColorBLACK;
+  }
+  if (name == "white") {
+    return SK_ColorWHITE;
+  }
+  for (std::string_view grey : {"gray", "grey"}) {
+    if (base::StartsWith(name, grey)) {
+      unsigned percent = 0;
+      if (!base::StringToUint(std::string_view(name).substr(grey.size()),
+                              &percent) ||
+          percent > 100) {
+        return std::nullopt;
+      }
+      const uint8_t level = static_cast<uint8_t>((percent * 255 + 50) / 100);
+      return SkColorSetRGB(level, level, level);
+    }
+  }
+  if (name.size() < 4 || name[0] != '#' || (name.size() - 1) % 3 != 0) {
+    return std::nullopt;
+  }
+  const size_t digits = (name.size() - 1) / 3;
+  if (digits > 4) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, 3> channels;
+  for (size_t i = 0; i < 3; ++i) {
+    uint32_t channel = 0;
+    if (!base::HexStringToUInt(
+            std::string_view(name).substr(1 + i * digits, digits), &channel)) {
+      return std::nullopt;
+    }
+    // Keep the top eight bits whatever the width, and widen one hex digit.
+    channels[i] = digits == 1
+                      ? static_cast<uint8_t>(channel * 17)
+                      : static_cast<uint8_t>(channel >> (digits * 4 - 8));
+  }
+  return SkColorSetRGB(channels[0], channels[1], channels[2]);
+}
+
+std::optional<std::vector<uint8_t>> DecodeAuraDeXpmToPng(
+    const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, 4 * 1024 * 1024)) {
+    return std::nullopt;
+  }
+
+  std::vector<std::string_view> strings;
+  for (size_t i = 0; i < text.size(); ++i) {
+    if (text.compare(i, 2, "/*") == 0) {
+      const size_t end = text.find("*/", i + 2);
+      if (end == std::string::npos) {
+        break;
+      }
+      i = end + 1;
+    } else if (text[i] == '"') {
+      const size_t end = text.find('"', i + 1);
+      if (end == std::string::npos) {
+        return std::nullopt;
+      }
+      strings.push_back(std::string_view(text).substr(i + 1, end - i - 1));
+      i = end;
+    }
+  }
+  if (strings.empty()) {
+    return std::nullopt;
+  }
+
+  const std::vector<std::string_view> header = base::SplitStringPiece(
+      strings[0], " \t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  unsigned width = 0, height = 0, colors = 0, chars_per_pixel = 0;
+  if (header.size() < 4 || !base::StringToUint(header[0], &width) ||
+      !base::StringToUint(header[1], &height) ||
+      !base::StringToUint(header[2], &colors) ||
+      !base::StringToUint(header[3], &chars_per_pixel) || width == 0 ||
+      height == 0 || width > 1024 || height > 1024 || colors == 0 ||
+      chars_per_pixel == 0 || chars_per_pixel > 4 ||
+      strings.size() < 1 + colors + height) {
+    return std::nullopt;
+  }
+
+  std::map<std::string_view, SkColor> palette;
+  for (unsigned i = 0; i < colors; ++i) {
+    const std::string_view line = strings[1 + i];
+    if (line.size() <= chars_per_pixel) {
+      return std::nullopt;
+    }
+    const std::vector<std::string_view> words = base::SplitStringPiece(
+        line.substr(chars_per_pixel), " \t", base::TRIM_WHITESPACE,
+        base::SPLIT_WANT_NONEMPTY);
+    std::optional<SkColor> color;
+    for (size_t w = 0; w + 1 < words.size(); ++w) {
+      if (words[w] == "c") {
+        color = ParseAuraDeXpmColor(words[w + 1]);
+        break;
+      }
+    }
+    if (!color) {
+      return std::nullopt;
+    }
+    palette[line.substr(0, chars_per_pixel)] = *color;
+  }
+
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocN32Pixels(width, height)) {
+    return std::nullopt;
+  }
+  for (unsigned y = 0; y < height; ++y) {
+    const std::string_view row = strings[1 + colors + y];
+    if (row.size() < width * chars_per_pixel) {
+      return std::nullopt;
+    }
+    for (unsigned x = 0; x < width; ++x) {
+      const auto it =
+          palette.find(row.substr(x * chars_per_pixel, chars_per_pixel));
+      if (it == palette.end()) {
+        return std::nullopt;
+      }
+      *bitmap.getAddr32(x, y) = SkPreMultiplyColor(it->second);
+    }
+  }
+  return gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                           /*discard_transparency=*/false);
+}
