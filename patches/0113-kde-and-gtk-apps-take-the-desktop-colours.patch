+// One mode of the desktop's palette, in the roles Linux toolkits draw with.
+struct DesktopPalette {
+  // The window frame Ash draws, and the same when the window is inactive.
+  SkColor header = SK_ColorBLACK;
+  SkColor header_inactive = SK_ColorBLACK;
+  // Panels, toolbars and dialogs; lists and documents; buttons.
+  SkColor window = SK_ColorBLACK;
+  SkColor view = SK_ColorBLACK;
+  SkColor view_alternate = SK_ColorBLACK;
+  SkColor button = SK_ColorBLACK;
+  SkColor button_alternate = SK_ColorBLACK;
+  // Menus, popovers and dialogs raised above the window.
+  SkColor raised = SK_ColorBLACK;
+  SkColor text = SK_ColorBLACK;
+  SkColor text_secondary = SK_ColorBLACK;
+  SkColor accent = SK_ColorBLACK;
+  SkColor on_accent = SK_ColorBLACK;
+  SkColor accent_container = SK_ColorBLACK;
+  SkColor focus = SK_ColorBLACK;
+  SkColor visited = SK_ColorBLACK;
+  SkColor negative = SK_ColorBLACK;
+  SkColor neutral = SK_ColorBLACK;
+  SkColor positive = SK_ColorBLACK;
+  SkColor tooltip = SK_ColorBLACK;
+  SkColor on_tooltip = SK_ColorBLACK;
+
+  bool operator==(const DesktopPalette&) const = default;
+};
+
+// What Linux applications are told the desktop looks like.
+struct DesktopTheme {
+  bool dark = false;
+  DesktopPalette light;
+  DesktopPalette dark_palette;
+  // The family Ash draws its own text in.
+  std::string font_family;
+
+  const DesktopPalette& current() const { return dark ? dark_palette : light; }
+  bool operator==(const DesktopTheme&) const = default;
+};
+
+// Reads |provider|'s colours into the roles above. Returns nothing while
+// Ash's colours are not resolved yet.
+std::optional<DesktopPalette> ReadDesktopPalette(
+    const ui::ColorProvider& provider,
+    bool dark);
+
+// The kdeglobals KDE applications read their colours, fonts and icons from.
+// |icon_theme| is left out when empty.
+std::string BuildKdeGlobals(const DesktopTheme& theme,
+                            const std::string& icon_theme);
+
+// The libadwaita colours for both modes, as a GTK 4 stylesheet.
+std::string BuildGtk4Colors(const DesktopTheme& theme);
+
+// Hands Ash's look to the Linux applications on the desktop. KDE applications
+// read colours, fonts and icons from kdeglobals and reload them when told to
+// on the session bus; libadwaita applications read a stylesheet at startup.
+// Both are written to this session's runtime directory, which the launcher
+// puts first in their search paths, and rewritten whenever the wallpaper or
+// the light or dark mode changes, so the applications follow Ash as its own
+// windows do.
+class DesktopThemeExporter final : public ui::NativeThemeObserver {
+ public:
+  // Writes under |runtime_dir|/aurade and signals on |bus|.
+  DesktopThemeExporter(scoped_refptr<dbus::Bus> bus,
+                       const base::FilePath& runtime_dir);
+  DesktopThemeExporter(const DesktopThemeExporter&) = delete;
+  DesktopThemeExporter& operator=(const DesktopThemeExporter&) = delete;
+  ~DesktopThemeExporter() override;
+
+  // ui::NativeThemeObserver:
+  void OnNativeThemeUpdated(ui::NativeTheme* observed_theme) override;
+
+ private:
+  void Export();
+  void OnWritten(DesktopTheme theme,
+                 const std::string& icon_theme,
+                 bool written);
+  void NotifyKde(int type, int arg);
+
+  scoped_refptr<dbus::Bus> bus_;
+  scoped_refptr<dbus::ExportedObject> global_settings_;
+  scoped_refptr<dbus::ExportedObject> icon_loader_;
+  scoped_refptr<base::SequencedTaskRunner> file_task_runner_;
+  const base::FilePath runtime_dir_;
+  // What the files on disk say, once written.
+  std::optional<DesktopTheme> written_;
+  std::string written_icon_theme_;
+  base::OneShotTimer export_timer_;
+  base::ScopedObservation<ui::NativeTheme, ui::NativeThemeObserver>
+      theme_observation_{this};
+  base::WeakPtrFactory<DesktopThemeExporter> weak_ptr_factory_{this};
+};
