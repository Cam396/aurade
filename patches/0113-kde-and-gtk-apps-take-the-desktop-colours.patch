+// The environment a host application starts in, on top of Ash's own.
+base::EnvironmentMap AuraDeHostAppEnvironment(
+    base::Environment& environment,
+    const std::string& wayland_display) {
+  base::EnvironmentMap env;
+  env["WAYLAND_DISPLAY"] = wayland_display;
+  env["GDK_BACKEND"] = "wayland";
+  // AuraDE compatibility: X11 applications reach exo through
+  // xwayland-satellite, which the session starts on this display once exo is
+  // up. Without it an X11-only application had nowhere to draw and exited.
+  if (std::optional<std::string> x11_display =
+          environment.GetVar("AURADE_HOST_APP_X11_DISPLAY");
+      x11_display && !x11_display->empty()) {
+    env["DISPLAY"] = *x11_display;
+  }
+  env["QT_QPA_PLATFORM"] = "wayland";
+  // AuraDE compatibility: with no platform theme Qt drew every application in
+  // its light default whatever the desktop was. KDE's own theme, when
+  // plasma-integration is installed, reads the colours, fonts and icons Ash
+  // writes for this session and follows them as they change; Qt's portal
+  // theme only knows light from dark. A theme the session already chose,
+  // such as qt6ct, is kept.
+  if (!environment.HasVar("QT_QPA_PLATFORMTHEME")) {
+    env["QT_QPA_PLATFORMTHEME"] =
+        base::PathExists(base::FilePath(kAuraDeKdePlatformTheme))
+            ? "kde"
+            : "xdgdesktopportal";
+  }
+  // AuraDE compatibility: Qt's own Fusion style is its oldest look. Breeze,
+  // when installed, is the modern one and still takes its colours from the
+  // desktop. A style the session already chose is kept.
+  if (!environment.HasVar("QT_STYLE_OVERRIDE") &&
+      base::PathExists(
+          base::FilePath("/usr/lib/qt6/plugins/styles/breeze6.so"))) {
+    env["QT_STYLE_OVERRIDE"] = "Breeze";
+  }
+  // AuraDE compatibility: Ash writes this session's kdeglobals under the
+  // runtime directory, and AuraDE ships Breeze's settings beside the system
+  // defaults, so both go ahead of them. The user's own ~/.config is still
+  // read before any of these.
+  std::string config_dirs = "/usr/share/aurade/xdg:";
+  if (std::optional<std::string> runtime_dir =
+          environment.GetVar("XDG_RUNTIME_DIR");
+      runtime_dir && !runtime_dir->empty()) {
+    config_dirs = *runtime_dir + "/aurade/xdg:" + config_dirs;
+  }
+  std::optional<std::string> system_config_dirs =
+      environment.GetVar("XDG_CONFIG_DIRS");
+  config_dirs += system_config_dirs && !system_config_dirs->empty()
+                     ? *system_config_dirs
+                     : std::string("/etc/xdg");
+  env["XDG_CONFIG_DIRS"] = config_dirs;
+  // AuraDE compatibility: open and save dialogs go through the desktop
+  // portal, which Ash answers with the AuraDE Files picker, so KDE, GTK and
+  // Firefox ask for files the way the rest of the desktop does.
+  env["PLASMA_INTEGRATION_USE_PORTAL"] = "1";
+  env["GTK_USE_PORTAL"] = "1";
+  env["SDL_VIDEODRIVER"] = "wayland";
+  env["MOZ_ENABLE_WAYLAND"] = "1";
+  env["NO_AT_BRIDGE"] = "1";
+  env["XDG_CURRENT_DESKTOP"] = "AuraDE";
+  env["XDG_SESSION_DESKTOP"] = "aurade";
+  env["DESKTOP_SESSION"] = "aurade";
+  return env;
+}
+
+// AuraDE compatibility: the Files app opens files in Linux applications
+// through its file service, a user service that has none of this session's
+// display or bus. It reads them from here, so an application it starts lands
+// on this desktop in the environment the launcher would have given it.
+void WriteAuraDeAppEnvironmentOnThread() {
+  auto environment = base::Environment::Create();
+  std::optional<std::string> runtime_dir =
+      environment->GetVar("XDG_RUNTIME_DIR");
+  if (!runtime_dir || runtime_dir->empty()) {
+    return;
+  }
+  base::EnvironmentMap env = AuraDeHostAppEnvironment(
+      *environment, ChooseAuraDeHostWaylandDisplay(*environment));
+  for (const std::string& name : {std::string("DBUS_SESSION_BUS_ADDRESS"),
+                                 std::string("XDG_RUNTIME_DIR"),
+                                 std::string("XDG_SESSION_TYPE")}) {
+    if (std::optional<std::string> value = environment->GetVar(name);
+        value && !value->empty()) {
+      env[name] = *value;
+    }
+  }
+  std::string contents =
+      "# Written by Ash: what Linux applications start with on this "
+      "desktop.\n";
+  for (const auto& [name, value] : env) {
+    if (value.find('\n') == std::string::npos) {
+      contents += name + "=" + value + "\n";
+    }
+  }
+  const base::FilePath dir = base::FilePath(*runtime_dir).Append("aurade");
+  if (!base::CreateDirectory(dir) ||
+      !base::ImportantFileWriter::WriteFileAtomically(
+          dir.Append("app-environment"), contents)) {
+    LOG(ERROR) << "AuraDE could not write the application environment";
+  }
+}
