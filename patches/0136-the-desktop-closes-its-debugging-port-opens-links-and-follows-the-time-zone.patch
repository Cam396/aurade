+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/aurade_browser_service.h"
+
+#include <cstddef>
+#include <utility>
+
+#include "ash/public/cpp/new_window_delegate.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "url/url_constants.h"
+
+namespace ash {
+namespace {
+
+constexpr char kServiceName[] = "org.aurade.Browser";
+constexpr char kObjectPath[] = "/org/aurade/Browser";
+constexpr char kInterfaceName[] = "org.aurade.Browser";
+constexpr char kOpenUrlMethod[] = "OpenURL";
+constexpr char kInvalidArgsError[] = "org.freedesktop.DBus.Error.InvalidArgs";
+constexpr char kFailedError[] = "org.freedesktop.DBus.Error.Failed";
+
+// Longer than any address a person would click, short enough that a program
+// cannot hand the browser a page's worth of data in one.
+constexpr size_t kMaxUrlLength = 64 * 1024;
+
+}  // namespace
+
+AuraDeBrowserService::AuraDeBrowserService(scoped_refptr<dbus::Bus> bus)
+    : bus_(std::move(bus)) {
+  exported_object_ = bus_->GetExportedObject(dbus::ObjectPath(kObjectPath));
+  exported_object_->ExportMethod(
+      kInterfaceName, kOpenUrlMethod,
+      base::BindRepeating(&AuraDeBrowserService::HandleOpenUrl,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&AuraDeBrowserService::OnExported,
+                     weak_ptr_factory_.GetWeakPtr()));
+  bus_->RequestOwnership(kServiceName, dbus::Bus::REQUIRE_PRIMARY,
+                         base::BindOnce(&AuraDeBrowserService::OnOwnership,
+                                        weak_ptr_factory_.GetWeakPtr()));
+}
+
+AuraDeBrowserService::~AuraDeBrowserService() {
+  if (bus_) {
+    bus_->UnregisterExportedObject(dbus::ObjectPath(kObjectPath));
+  }
+}
+
+// static
+GURL AuraDeBrowserService::AllowedUrl(const std::string& spec) {
+  if (spec.empty() || spec.size() > kMaxUrlLength) {
+    return GURL();
+  }
+  GURL url(spec);
+  if (!url.is_valid()) {
+    return GURL();
+  }
+  if (url.SchemeIsHTTPOrHTTPS()) {
+    return url;
+  }
+  // A local page, such as an application's own help, by its absolute path.
+  if (url.SchemeIsFile() && url.GetHost().empty() &&
+      url.GetPath().starts_with('/')) {
+    return url;
+  }
+  return GURL();
+}
+
+void AuraDeBrowserService::HandleOpenUrl(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string spec;
+  if (!reader.PopString(&spec)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(method_call, kInvalidArgsError,
+                                                 "Expected a URL"));
+    return;
+  }
+  const GURL url = AllowedUrl(spec);
+  if (!url.is_valid()) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, kInvalidArgsError,
+            "Only web pages and local files open here"));
+    return;
+  }
+  NewWindowDelegate* delegate = NewWindowDelegate::GetInstance();
+  if (!delegate || !ProfileManager::GetActiveUserProfile()) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(method_call, kFailedError,
+                                                 "Nobody is signed in"));
+    return;
+  }
+  delegate->OpenUrl(url, NewWindowDelegate::OpenUrlFrom::kUserInteraction,
+                    NewWindowDelegate::Disposition::kNewForegroundTab);
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+
+void AuraDeBrowserService::OnExported(const std::string& interface_name,
+                                      const std::string& method_name,
+                                      bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE could not export " << interface_name << "."
+                          << method_name;
+}
+
+void AuraDeBrowserService::OnOwnership(const std::string& service_name,
+                                       bool success) {
+  LOG_IF(ERROR, !success) << "AuraDE could not own " << service_name;
+}
+
+}  // namespace ash
