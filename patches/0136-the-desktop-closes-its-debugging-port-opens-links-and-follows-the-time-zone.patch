+#ifndef CHROME_BROWSER_ASH_DBUS_AURADE_BROWSER_SERVICE_H_
+#define CHROME_BROWSER_ASH_DBUS_AURADE_BROWSER_SERVICE_H_
+
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "dbus/exported_object.h"
+#include "url/gurl.h"
+
+namespace dbus {
+class Bus;
+class MethodCall;
+}  // namespace dbus
+
+namespace ash {
+
+// AuraDE compatibility: the desktop's browser, reachable from the user's
+// session bus as org.aurade.Browser. A link clicked in a Linux application
+// goes through xdg-open to aurade-open-url, which asks here, and the page
+// opens in a tab of the AuraDE browser rather than in nothing at all, or in
+// whatever other browser happens to be installed.
+//
+// The session bus only carries this user's own programs, which is the point:
+// the alternative, Chrome's DevTools port, answers anybody on the machine.
+class AuraDeBrowserService final {
+ public:
+  explicit AuraDeBrowserService(scoped_refptr<dbus::Bus> bus);
+  AuraDeBrowserService(const AuraDeBrowserService&) = delete;
+  AuraDeBrowserService& operator=(const AuraDeBrowserService&) = delete;
+  ~AuraDeBrowserService();
+
+  // The page |spec| asks for, if it is one a Linux application may open:
+  // a web page, or a file by its absolute path. Anything else, the browser's
+  // own pages among them, is refused.
+  static GURL AllowedUrl(const std::string& spec);
+
+ private:
+  void HandleOpenUrl(dbus::MethodCall* method_call,
+                     dbus::ExportedObject::ResponseSender response_sender);
+  void OnExported(const std::string& interface_name,
+                  const std::string& method_name,
+                  bool success);
+  void OnOwnership(const std::string& service_name, bool success);
+
+  scoped_refptr<dbus::Bus> bus_;
+  scoped_refptr<dbus::ExportedObject> exported_object_;
+  base::WeakPtrFactory<AuraDeBrowserService> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_AURADE_BROWSER_SERVICE_H_
