+// AuraDE compatibility: the zone is the system's, not only the desktop's.
+// On a Linux system the clock everything else reads, Linux applications, the
+// login screen, logs and timers, follows /etc/localtime, and the stub below
+// only ever told Ash. So the desktop showed one time and the rest of the
+// machine another. systemd-timedated keeps the system's zone; a polkit rule
+// in the chromiumos-ash package lets the person at the machine change it, as
+// on a Chromebook, without an administrator's password.
+bool SystemTimezoneAlreadyIs(const std::string& id) {
+  base::FilePath link;
+  if (!base::ReadSymbolicLink(base::FilePath("/etc/localtime"), &link)) {
+    return false;
+  }
+  const std::string& path = link.value();
+  constexpr std::string_view kZoneinfo = "zoneinfo/";
+  const size_t at = path.find(kZoneinfo);
+  if (at == std::string::npos) {
+    return false;
+  }
+  const std::string current_id = path.substr(at + kZoneinfo.size());
+  if (current_id == id) {
+    return true;
+  }
+  // Ash names a zone by a known zone with the same rules: UTC is Etc/GMT to
+  // it, and US/Central is America/Chicago. When it applies its zone as the
+  // desktop starts, that is not a change, and the system keeps the name it
+  // was given.
+  std::unique_ptr<icu::TimeZone> current(icu::TimeZone::createTimeZone(
+      icu::UnicodeString::fromUTF8(current_id)));
+  std::unique_ptr<icu::TimeZone> wanted(
+      icu::TimeZone::createTimeZone(icu::UnicodeString::fromUTF8(id)));
+  const icu::TimeZone& unknown = icu::TimeZone::getUnknown();
+  return *current != unknown && *wanted != unknown &&
+         current->hasSameRules(*wanted);
+}
+
+void SetLinuxSystemTimezone(const std::string& id) {
+  if (SystemTimezoneAlreadyIs(id)) {
+    return;
+  }
+  base::Process process = base::LaunchProcess(
+      {"/usr/bin/timedatectl", "--no-ask-password", "set-timezone", id},
+      base::LaunchOptions());
+  int exit_code = -1;
+  if (!process.IsValid() ||
+      !process.WaitForExitWithTimeout(base::Seconds(10), &exit_code) ||
+      exit_code != 0) {
+    LOG(ERROR) << "AuraDE could not set the system time zone to " << id;
+  }
+}
