 /**
+ * AuraDE: copies the names of the selected files to the clipboard.
+ *
+ * Renaming a file to match another one, quoting a filename in a message,
+ * typing it into a terminal: all of it currently means reading the name off
+ * the screen and retyping it, and a name like IMG_20260714_193045.heic is
+ * exactly the sort of thing people get wrong twice before getting it right.
+ *
+ * This deliberately does not use document.execCommand('copy'). Files listens
+ * for the copy event on the document and rewrites the clipboard with the
+ * selected file entries, so a text copy raised that way is silently replaced
+ * by a file copy and the user gets neither what they asked for nor an error.
+ * The async clipboard API raises no copy event and so is not intercepted.
+ */
+export class CopyNameCommand extends FilesCommand {
+  execute(_event: CommandEvent, fileManager: CommandHandlerDeps) {
+    const names = fileManager.getSelection().entries.map(entry => entry.name);
+    if (names.length === 0) {
+      return;
+    }
+    // One name per line, so a multiple selection pastes into a list rather
+    // than a run-on sentence somebody has to split by hand.
+    navigator.clipboard.writeText(names.join('\n'))
+        .then(() => {
+          const message = names.length === 1 ?
+              `Copied the name ${names[0]}` :
+              `Copied ${names.length} names`;
+          fileManager.ui.toast.show(message);
+          fileManager.ui.speakA11yMessage(message);
+        })
+        .catch(() => {
+          // Saying nothing here would leave somebody pasting an old clipboard
+          // into a message and wondering why the wrong name arrived.
+          const message = 'Could not reach the clipboard';
+          fileManager.ui.toast.show(message);
+          fileManager.ui.speakA11yMessage(message);
+        });
+  }
+
+  override canExecute(event: CanExecuteEvent, fileManager: CommandHandlerDeps) {
+    const count = fileManager.getSelection().entries.length;
+    event.canExecute = count > 0;
+    event.command.setHidden(count === 0);
+    // The label counts, because "Copy name" over a selection of nine reads as
+    // though it will copy one of them.
+    event.command.label = count > 1 ? `Copy ${count} names` : 'Copy name';
+  }
+}
+
