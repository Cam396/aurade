+
+void ExternalAppResolutionCommand::OnFallbackIconFetched(
+    std::optional<SkBitmap> bitmap) {
+  custom_icon_fetcher_.reset();
+  GetMutableDebugValue().Set("fallback_icon_fetched", bitmap.has_value());
+  if (bitmap && !bitmap->drawsNothing() && bitmap->width() > 0 &&
+      bitmap->width() == bitmap->height()) {
+    apps::IconInfo icon_info(install_options_.fallback_icon_url.value(),
+                             bitmap->width());
+    icon_info.purpose = apps::IconInfo::Purpose::kAny;
+    web_app_info_->manifest_icons = {icon_info};
+    web_app_info_->icon_bitmaps.any[bitmap->width()] = std::move(*bitmap);
+  }
+  ContinueInstallFromInfo();
+}
