diff --git a/ui/file_manager/file_manager/aurade/tests/ui/voice_test.ts b/ui/file_manager/file_manager/aurade/tests/ui/voice_test.ts
new file mode 100644
index 000000000000..eb3e0dcaa976
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/ui/voice_test.ts
@@ -0,0 +1,186 @@
+/**
+ * The voice, enforced.
+ *
+ * Style is the easy half: dashes, exclamation marks, sentences that end. The
+ * half that actually matters is claims. A string can be warm, correctly
+ * punctuated, free of every banned character, and still be false. An earlier
+ * draft of this catalogue offered "press Ctrl+Shift+N to make a new folder";
+ * that chord is bound in ash to a new incognito window and never reaches Files,
+ * so a style checker would have waved it through and the first person to
+ * believe it would have found out.
+ */
+import type {EmptyReason} from '../../ui/copy.js';
+import {duration, emptyCopy, ERRORS, SHORTCUTS} from '../../ui/copy.js';
+
+class AssertionError extends Error {}
+function fail(message: string): never {
+  throw new AssertionError(message);
+}
+
+const REASONS: EmptyReason[] = [
+  'empty', 'filtered', 'search', 'trash', 'basket', 'unreadable', 'gone',
+  'offline',
+];
+
+/** Every user visible sentence this app can produce, with where it came from. */
+function catalogue(): Array<{where: string, text: string}> {
+  const out: Array<{where: string, text: string}> = [];
+  for (const reason of REASONS) {
+    const copy = emptyCopy(reason, 'holiday photos');
+    out.push({where: `emptyCopy(${reason}).title`, text: copy.title});
+    if (copy.detail) {
+      out.push({where: `emptyCopy(${reason}).detail`, text: copy.detail});
+    }
+  }
+  out.push({where: 'ERRORS.busy', text: ERRORS.busy('Music', 'Celluloid')});
+  out.push({where: 'ERRORS.readOnly', text: ERRORS.readOnly()});
+  out.push({where: 'ERRORS.noSpace', text: ERRORS.noSpace('2.4 GB', '900 MB')});
+  out.push({where: 'ERRORS.gone', text: ERRORS.gone('Music')});
+  for (const seconds of [1, 30, 120, 3600]) {
+    out.push({where: `duration(${seconds})`, text: duration(seconds)});
+  }
+  return out;
+}
+
+/** Words that describe the machine to itself rather than the person to their files. */
+const JARGON = [
+  'EBUSY', 'ENOENT', 'EACCES', 'errno', 'inode', 'null', 'undefined', 'NaN',
+  'fd ', 'syscall', 'stat()', 'mkfs', 'unmount failed',
+];
+
+/** Reassurance about nothing, which is chatter rather than warmth. */
+const CHATTER = [
+  'plenty of room', 'ready for your files', 'oops', 'sorry', 'whoops',
+  'no worries', 'all good', 'awesome', 'great news',
+];
+
+interface Case {
+  name: string;
+  run(): void;
+}
+
+const CASES: Case[] = [
+  {
+    name: 'no em dashes and no en dashes anywhere',
+    run() {
+      for (const {where, text} of catalogue()) {
+        if (/[–—]/.test(text)) {
+          fail(`${where} contains a dash: ${text}`);
+        }
+      }
+    },
+  },
+  {
+    name: 'no exclamation marks and no cheerfulness where an error belongs',
+    run() {
+      for (const {where, text} of catalogue()) {
+        if (text.includes('!')) {
+          fail(`${where} shouts: ${text}`);
+        }
+        const lowered = text.toLowerCase();
+        for (const phrase of CHATTER) {
+          if (lowered.includes(phrase)) {
+            fail(`${where} reassures about nothing ("${phrase}"): ${text}`);
+          }
+        }
+      }
+    },
+  },
+  {
+    name: 'every string is a complete sentence',
+    run() {
+      for (const {where, text} of catalogue()) {
+        if (!/[.?]$/.test(text)) {
+          fail(`${where} does not end a sentence: ${text}`);
+        }
+        if (!/^[A-Z"]/.test(text)) {
+          fail(`${where} does not start one: ${text}`);
+        }
+        if (text.split(' ').length < 3) {
+          fail(`${where} is a label rather than a sentence: ${text}`);
+        }
+      }
+    },
+  },
+  {
+    name: 'nothing describes the machine to itself',
+    run() {
+      for (const {where, text} of catalogue()) {
+        for (const word of JARGON) {
+          if (text.includes(word)) {
+            fail(`${where} leaks "${word}": ${text}`);
+          }
+        }
+      }
+    },
+  },
+  {
+    name: 'a string that names a shortcut names one that exists',
+    run() {
+      // The claim check. Anything of the form "press X" has to name a chord
+      // this app actually binds, or the sentence is a promise it cannot keep.
+      const pattern = /press ([A-Z][A-Za-z0-9]*(?:\+[A-Za-z0-9]+)*)/gi;
+      for (const {where, text} of catalogue()) {
+        for (const match of text.matchAll(pattern)) {
+          const chord = match[1]!;
+          if (!SHORTCUTS.has(chord)) {
+            fail(`${where} names ${chord}, which this app does not bind: ${text}`);
+          }
+        }
+      }
+    },
+  },
+  {
+    name: 'the empty states differ, because the reasons differ',
+    run() {
+      const seen = new Map<string, EmptyReason>();
+      for (const reason of REASONS) {
+        const title = emptyCopy(reason, 'a drive').title;
+        const already = seen.get(title);
+        if (already) {
+          fail(`${reason} says the same as ${already}: ${title}`);
+        }
+        seen.set(title, reason);
+      }
+    },
+  },
+  {
+    name: 'a search with no results repeats what was searched for',
+    run() {
+      const copy = emptyCopy('search', 'quarterly report');
+      if (!copy.title.includes('quarterly report')) {
+        fail(`the query is not echoed back: ${copy.title}`);
+      }
+    },
+  },
+  {
+    name: 'time is said coarsely rather than counted down',
+    run() {
+      const long = duration(4000);
+      if (/\d/.test(long)) {
+        fail(`a long operation claims a precision it does not have: ${long}`);
+      }
+      if (!long.includes('carry on')) {
+        fail(`a long operation does not say it survives the window: ${long}`);
+      }
+    },
+  },
+];
+
+export function runVoiceTests(): boolean {
+  let passed = 0;
+  const failures: string[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      passed++;
+    } catch (error) {
+      failures.push(
+          `  FAIL ${testCase.name}\n       ${
+              error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+  console.log(`voice: ${passed}/${CASES.length} passed`);
+  failures.forEach(line => console.log(line));
+  return failures.length === 0;
+}
