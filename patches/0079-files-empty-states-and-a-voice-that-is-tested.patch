+def read_stories(browser, port):
+    """Ask the module what the stories are.
+
+    Reading them out of the source meant reimplementing the list, and that
+    implementation only understood stories written as literals. Four built by a
+    factory were silently skipped, which is the worst way for a test suite to
+    lose coverage: everything reported as passing.
+    """
+    browser.call("Page.navigate",
+                 url="http://127.0.0.1:%d/tests/harness/index.html" % port)
+    browser.wait_for("Page.loadEventFired")
+    deadline = time.time() + 20
+    while time.time() < deadline:
+        result = browser.call(
+            "Runtime.evaluate",
+            expression="JSON.stringify(window.auradeStories || null)",
+            returnByValue=True)
+        value = result.get("result", {}).get("value")
+        if value and value != "null":
+            return json.loads(value)
+        time.sleep(0.1)
+    raise SystemExit("the harness never published its story list")
 
 
