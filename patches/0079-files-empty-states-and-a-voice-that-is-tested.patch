@@ -0,0 +1,131 @@
+/**
+ * Every user visible string, in one place, so the voice can be tested.
+ *
+ * The rules, taken from the greeter, which already has them right:
+ * complete sentences, second person, what happened and then what you can do,
+ * never blaming the person, no exclamation marks, and no em or en dashes.
+ *
+ * Two rules that are easier to get wrong.
+ *
+ * Warmth is service, not commentary. A good host does not tell you the room is
+ * nice, they have already made it nice. So nothing here says "plenty of room"
+ * or "ready for your files". When everything is fine the right tone is an
+ * accurate number and silence.
+ *
+ * And nothing claims what we did not observe. "Everything here was moved to
+ * Trash" asserts a history this app did not watch happen, so it is not said.
+ */
+
+/**
+ * The chords this app actually binds.
+ *
+ * Copy that names a shortcut is checked against this table, because a sentence
+ * can be warm, correctly punctuated, free of dashes, and false. An earlier
+ * draft offered "press Ctrl+Shift+N to make a new folder"; that chord is taken
+ * by ash for a new incognito window and never reaches Files, so the sentence
+ * would have failed the first time anybody believed it.
+ */
+export const SHORTCUTS: ReadonlyMap<string, string> = new Map([
+  ['Enter', 'open the selected item'],
+  ['Backspace', 'go up one folder'],
+  ['Alt+Up', 'go up one folder'],
+  ['Ctrl+A', 'select everything'],
+  ['Escape', 'cancel'],
+]);
+
+export type EmptyReason =
+    'empty'|'filtered'|'search'|'trash'|'basket'|'unreadable'|'gone'|'offline';
+
+interface EmptyCopy {
+  readonly title: string;
+  readonly detail?: string;
+}
+
+/**
+ * What an empty view says.
+ *
+ * A room somebody walks into should read as clean and prepared rather than
+ * abandoned, and it should never be the same sentence for two different
+ * reasons, because "no files" tells you nothing about which of these happened.
+ */
+export function emptyCopy(reason: EmptyReason, subject?: string): EmptyCopy {
+  switch (reason) {
+    case 'empty':
+      return {
+        title: 'This folder is empty.',
+        detail: 'Drag files here to add them.',
+      };
+    case 'filtered':
+      return {
+        title: 'No files match this filter.',
+        detail: 'Clear the filter to see everything in this folder.',
+      };
+    case 'search':
+      return {
+        title: subject ? `Nothing matches "${subject}".` : 'Nothing matches that.',
+        detail: 'Check the spelling, or search across all of your files.',
+      };
+    case 'trash':
+      return {title: 'There is nothing in Trash.'};
+    case 'basket':
+      return {
+        title: 'Your basket is empty.',
+        detail: 'Gather files from different folders here to work with them together.',
+      };
+    case 'unreadable':
+      return {
+        title: 'This folder cannot be opened with your current permissions.',
+        detail: 'Ask whoever owns it for access, or choose another folder.',
+      };
+    case 'gone':
+      return {
+        title: 'This folder is no longer there.',
+        detail: 'It may have been moved or removed since you opened it.',
+      };
+    case 'offline':
+      // The label goes in the detail rather than at the front of the title.
+      // A drive is named by whoever formatted it, so a title that opens with
+      // one opens with whatever they typed, and "usb backup was unplugged"
+      // starts a sentence in lower case. Nothing here begins with a value
+      // somebody else chose.
+      return {
+        title: 'That drive was unplugged.',
+        detail: subject ? `Plug ${subject} back in to browse its files.` :
+                          'Plug it back in to browse its files.',
+      };
+  }
+}
+
+/** Sentences for the things that go wrong during an operation. */
+export const ERRORS = {
+  busy: (name: string, program: string) =>
+      `${name} is open in ${program}, so it cannot be moved right now. ` +
+      `Close ${program} and try again, or end it here.`,
+  readOnly: () =>
+      'This folder is protected, so new files cannot be placed here. ' +
+      'Check the folder permissions, or choose another location.',
+  noSpace: (needed: string, free: string) =>
+      `There is not enough room. This needs ${needed} and ${free} is free.`,
+  gone: (name: string) =>
+      `${name} is no longer there, so it could not be opened.`,
+} as const;
+
+/**
+ * How long something will take, said coarsely.
+ *
+ * A range nobody can be disappointed by is worth ten countdown clocks that
+ * lie. The estimate is a rate measured over the last few seconds, and printing
+ * "2 hours 37 minutes" claims a precision the number does not have.
+ */
+export function duration(seconds: number): string {
+  if (seconds < 10) {
+    return 'This will take just a moment.';
+  }
+  if (seconds < 60) {
+    return 'This usually takes under a minute.';
+  }
+  if (seconds < 600) {
+    return 'This usually takes a few minutes.';
+  }
+  return 'This will take a while. You can close this window and it will carry on.';
+}
