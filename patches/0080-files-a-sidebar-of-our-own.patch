index 0000000..65069a5
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/harness/dom.html
@@ -0,0 +1,28 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>AuraDE Files DOM tests</title>
+<link rel="stylesheet" href="../../ui/tokens.css">
+<style>html, body { margin: 0; background: var(--aurade-ground); }</style>
+<script type="module">
+  import {runListDomTests} from '../dom/list_test.js';
+  import {runSidebarDomTests} from '../dom/sidebar_test.js';
+  // Named here rather than in each suite so a suite that throws on import is
+  // still reported as a failure with a name, instead of the page simply never
+  // publishing a result and the runner timing out with nothing to say.
+  const suites = [['list', runListDomTests], ['sidebar', runSidebarDomTests]];
+  const results = [];
+  for (const [suite, run] of suites) {
+    try {
+      for (const result of run()) {
+        results.push(Object.assign({}, result, {name: suite + ': ' + result.name}));
+      }
+    } catch (error) {
+      results.push({
+        name: suite + ': the suite itself',
+        ok: false,
+        error: String(error && error.stack || error),
+      });
+    }
+  }
+  window.auradeDomResults = results;
+</script>
diff --git a/ui/file_manager/file_manager/aurade/tests/harness/dom.py b/ui/file_manager/file_manager/aurade/tests/harness/dom.py
new file mode 100755
index 0000000..403e619
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/harness/dom.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Run the DOM suite in a real browser.
+
+The unit suite runs in node, which has no DOM, so keyboard handling, ARIA and
+row recycling had code written and nothing exercising it. Those are not details
+that can be checked by reading: whether an arrow key moved the selection is a
+question about events, and whether scrolling builds elements is a question
+about what the browser actually did.
+
+Shares the golden harness's build and browser rather than adding a second way
+to compile and launch the same code.
+"""
+import argparse
+import importlib.util
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+spec = importlib.util.spec_from_file_location(
+    "golden", os.path.join(HERE, "golden.py"))
+golden = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(golden)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.parse_args()
+
+    work = tempfile.mkdtemp(prefix="aurade-dom-")
+    try:
+        # build() compiles the folders the golden harness needs; the DOM suite
+        # lives beside them and has to be added to that set.
+        sources = []
+        for folder in ("port", "session", "ui", "tests/harness", "tests/dom"):
+            directory = os.path.join(golden.AURADE, folder)
+            sources += [os.path.join(directory, f)
+                        for f in sorted(os.listdir(directory))
+                        if f.endswith(".ts")]
+        import subprocess
+        result = subprocess.run(
+            [golden.NODE, golden.TSC, "--strict", "--skipLibCheck",
+             "--target", "es2022", "--module", "es2022",
+             "--moduleResolution", "bundler", "--lib", "es2022,dom",
+             "--rootDir", golden.AURADE, "--outDir", work] + sources,
+            capture_output=True, text=True)
+        if result.returncode:
+            sys.stderr.write(result.stdout + result.stderr)
+            raise SystemExit("the DOM suite does not compile")
+        os.makedirs(os.path.join(work, "ui"), exist_ok=True)
+        shutil.copy(os.path.join(golden.AURADE, "ui/tokens.css"),
+                    os.path.join(work, "ui/tokens.css"))
+        shutil.copy(os.path.join(HERE, "dom.html"),
+                    os.path.join(work, "tests/harness/dom.html"))
+
+        server, port = golden.serve(work)
+        browser = golden.Browser(os.path.join(work, "profile"))
+        try:
+            browser.call("Emulation.setDeviceMetricsOverride", width=900,
+                         height=700, deviceScaleFactor=1, mobile=False)
+            browser.call("Page.navigate",
+                         url="http://127.0.0.1:%d/tests/harness/dom.html" % port)
+            browser.wait_for("Page.loadEventFired")
+            deadline = time.time() + 30
+            results = None
+            while time.time() < deadline:
+                answer = browser.call(
+                    "Runtime.evaluate",
+                    expression="JSON.stringify(window.auradeDomResults || null)",
+                    returnByValue=True)
+                value = answer.get("result", {}).get("value")
+                if value and value != "null":
+                    results = json.loads(value)
+                    break
+                time.sleep(0.1)
+            if results is None:
+                raise SystemExit("the DOM suite never reported a result")
+        finally:
+            browser.close()
+            server.shutdown()
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+    failed = [r for r in results if not r["ok"]]
+    print("DOM suites: %d/%d passed" % (len(results) - len(failed), len(results)))
+    for result in failed:
+        print("  FAIL %s\n       %s" % (result["name"], result.get("error", "")))
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
