index 0000000..8d46092
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/dom/list_test.ts
@@ -0,0 +1,349 @@
+/**
+ * The list, driven the way a person drives it.
+ *
+ * The unit suite runs in node and has no DOM, so keyboard handling, ARIA and
+ * recycling had roles and handlers written but nothing exercising them. This
+ * runs in a real browser against real events.
+ *
+ * Every assertion here is about behaviour a person would notice: whether the
+ * arrow key moved the selection, whether a screen reader is told how many
+ * items there are, whether scrolling a hundred thousand rows quietly builds a
+ * hundred thousand elements.
+ */
+import type {EntryDto, Metadata} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {FileList} from '../../ui/file_list.js';
+
+const NOW = new Date('2026-09-02T15:30:00').getTime();
+const ROOT = asFileKey('mock://myfiles');
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+interface Harness {
+  list: FileList;
+  host: HTMLElement;
+  viewport: HTMLElement;
+  entries: EntryDto[];
+  rows(): HTMLElement[];
+  key(key: string, modifiers?: {shift?: boolean, ctrl?: boolean}): void;
+  selectedNames(): string[];
+  destroy(): void;
+}
+
+function makeHarness(count = 20, height = 400): Harness {
+  const host = document.createElement('div');
+  host.style.height = `${height}px`;
+  host.style.width = '760px';
+  document.body.appendChild(host);
+
+  const entries: EntryDto[] = [];
+  const metadata = new Map<ReturnType<typeof asFileKey>, Metadata>();
+  for (let i = 0; i < count; i++) {
+    const name = i % 4 === 0 ? `folder-${i}` : `file-${i}.txt`;
+    const key = asFileKey(`${ROOT}/${name}`);
+    entries.push({key, name, isDirectory: i % 4 === 0, parent: ROOT});
+    metadata.set(key, {size: (i + 1) * 1024, modificationTime: NOW});
+  }
+
+  const list = new FileList(host, {rowHeight: 40});
+  list.setEntries(entries, NOW);
+  list.setMetadata(metadata);
+  const viewport = host.querySelector('.aurade-list') as HTMLElement;
+
+  return {
+    list,
+    host,
+    viewport,
+    entries,
+    rows: () => [...host.querySelectorAll<HTMLElement>('.aurade-row')],
+    key(key, modifiers = {}) {
+      viewport.dispatchEvent(new KeyboardEvent('keydown', {
+        key,
+        bubbles: true,
+        cancelable: true,
+        shiftKey: !!modifiers.shift,
+        ctrlKey: !!modifiers.ctrl,
+      }));
+    },
+    selectedNames() {
+      const keys = list.selectedKeys();
+      return entries.filter(e => keys.has(e.key)).map(e => e.name);
+    },
+    destroy() {
+      list.destroy();
+      host.remove();
+    },
+  };
+}
+
+interface Case {
+  name: string;
+  run(): void;
+}
+
+const CASES: Case[] = [
+  {
+    name: 'the list tells a screen reader what it is and how big it is',
+    run() {
+      const h = makeHarness(20);
+      try {
+        equal(h.viewport.getAttribute('role'), 'listbox', 'role');
+        equal(h.viewport.getAttribute('aria-multiselectable'), 'true',
+              'multiselectable');
+        equal(h.viewport.getAttribute('aria-setsize'), '20', 'set size');
+        const rows = h.rows();
+        assert(rows.length > 0, 'some rows are rendered');
+        equal(rows[0]!.getAttribute('role'), 'option', 'row role');
+        equal(rows[0]!.getAttribute('aria-posinset'), '1',
+              'the first row is position one, not zero');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'every row carries a name that reads as a sentence, not as cells',
+    run() {
+      const h = makeHarness(6);
+      try {
+        const label = h.rows()[1]!.getAttribute('aria-label') ?? '';
+        assert(label.includes('file-1.txt'), `names the file: ${label}`);
+        assert(label.includes('Document') || label.includes('File'),
+               `says what kind it is: ${label}`);
+        assert(label.split(',').length >= 3,
+               `carries the columns rather than just the name: ${label}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'arrow keys move the selection',
+    run() {
+      const h = makeHarness(20);
+      try {
+        h.key('ArrowDown');
+        equal(h.selectedNames().length, 1, 'one selected');
+        h.key('ArrowDown');
+        h.key('ArrowDown');
+        equal(h.selectedNames()[0], 'file-3.txt', 'moved three down');
+        h.key('ArrowUp');
+        equal(h.selectedNames()[0], 'file-2.txt', 'and back up one');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'shift and an arrow extends the selection rather than moving it',
+    run() {
+      const h = makeHarness(20);
+      try {
+        h.key('ArrowDown');
+        h.key('ArrowDown', {shift: true});
+        h.key('ArrowDown', {shift: true});
+        equal(h.selectedNames().length, 3, 'three in the range');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'home and end reach the ends without walking there',
+    run() {
+      const h = makeHarness(500);
+      try {
+        h.key('End');
+        equal(h.selectedNames()[0], 'file-499.txt', 'the last entry');
+        h.key('Home');
+        equal(h.selectedNames()[0], 'folder-0', 'the first entry');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'page keys move by a viewport rather than by one',
+    run() {
+      const h = makeHarness(200, 400);
+      try {
+        h.key('Home');
+        h.key('PageDown');
+        const after = h.selectedNames()[0]!;
+        assert(after !== 'folder-0', 'it moved');
+        const index = h.entries.findIndex(e => e.name === after);
+        assert(index >= 8, `moved most of a viewport, landed on ${index}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'control A selects everything, including what is not rendered',
+    run() {
+      const h = makeHarness(1000);
+      try {
+        h.key('a', {ctrl: true});
+        equal(h.list.selectedKeys().size, 1000,
+              'the selection is over indices, not over rendered rows');
+        assert(h.rows().length < 100,
+               `and only a viewport is rendered, not ${h.rows().length}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'aria-selected follows the selection',
+    run() {
+      const h = makeHarness(20);
+      try {
+        h.key('ArrowDown');
+        const selected = h.rows().filter(
+            row => row.getAttribute('aria-selected') === 'true');
+        equal(selected.length, 1, 'exactly one row is marked selected');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'Enter opens what is focused',
+    run() {
+      const h = makeHarness(10);
+      try {
+        let opened: string|null = null;
+        const host = document.createElement('div');
+        host.style.height = '400px';
+        document.body.appendChild(host);
+        const list = new FileList(host, {
+          rowHeight: 40,
+          onActivate: entry => { opened = entry.name; },
+        });
+        list.setEntries(h.entries, NOW);
+        const viewport = host.querySelector('.aurade-list') as HTMLElement;
+        viewport.dispatchEvent(
+            new KeyboardEvent('keydown', {key: 'ArrowDown', bubbles: true}));
+        viewport.dispatchEvent(
+            new KeyboardEvent('keydown', {key: 'Enter', bubbles: true}));
+        equal(opened, 'file-1.txt', 'the focused entry was opened');
+        list.destroy();
+        host.remove();
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'scrolling a long list does not build a long list',
+    run() {
+      const h = makeHarness(20_000);
+      try {
+        const before = h.rows().length;
+        for (let step = 0; step < 40; step++) {
+          h.viewport.scrollTop = step * 4_000;
+          h.list.render();
+        }
+        equal(h.rows().length, before,
+              'the pool is the size of the viewport and stays there');
+        assert(before < 40, `and it is small: ${before} rows`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'a short directory after a long one leaves no rows behind',
+    run() {
+      const h = makeHarness(2_000);
+      try {
+        const many = h.rows().length;
+        assert(many > 4, `the pool should start bigger than that: ${many}`);
+        // The pool only ever shrinks on this path. Scrolling never takes it,
+        // because the viewport keeps the same height and therefore asks for the
+        // same number of rows every time, so a suite that only scrolls will
+        // happily pass with the shrink deleted and leave a thousand rows from
+        // the previous directory sitting on screen.
+        const parent = h.entries[0]!.parent;
+        const short = ['one.txt', 'two.txt', 'three.txt'].map(name => ({
+          key: asFileKey(`${parent}/${name}`),
+          name,
+          isDirectory: false,
+          parent,
+        }));
+        h.list.setEntries(short, NOW);
+        equal(h.rows().length, 3,
+              'rows from the previous directory are still in the tree');
+        const shown = h.rows().map(row => row.textContent ?? '').join(' ');
+        assert(!shown.includes('file-1'),
+               `a row kept its old contents: ${shown.slice(0, 120)}`);
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'the empty state replaces the rows and is announced',
+    run() {
+      const h = makeHarness(0);
+      try {
+        h.list.setEmptyReason('filtered');
+        const empty = h.host.querySelector('.aurade-empty') as HTMLElement;
+        assert(empty && !empty.hidden, 'the empty state is showing');
+        equal(empty.getAttribute('role'), 'status', 'it is announced');
+        assert((empty.textContent ?? '').includes('filter'),
+               `it says which emptiness this is: ${empty.textContent}`);
+        equal(h.rows().length, 0, 'and there are no rows behind it');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+  {
+    name: 'a selection set programmatically reads back as those entries',
+    run() {
+      const h = makeHarness(50);
+      try {
+        h.list.setSelectedIndices([2, 3, 4]);
+        equal(h.selectedNames().length, 3, 'three selected');
+        equal(h.selectedNames()[0], 'file-2.txt', 'and the right three');
+      } finally {
+        h.destroy();
+      }
+    },
+  },
+];
+
+export interface DomResult {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+export function runListDomTests(): DomResult[] {
+  const results: DomResult[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  return results;
+}
diff --git a/ui/file_manager/file_manager/aurade/tests/dom/sidebar_test.ts b/ui/file_manager/file_manager/aurade/tests/dom/sidebar_test.ts
new file mode 100644
index 0000000..d42d73d
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/tests/dom/sidebar_test.ts
@@ -0,0 +1,406 @@
+/**
+ * The sidebar, driven the way a person drives it.
+ *
+ * The upstream tree lives in a shadow root and was restyled by pushing a
+ * stylesheet into every item; its selected state painted dark ink on a dark
+ * fill for months without anything noticing. These assertions are the reason
+ * that cannot happen again here: they are about what a person sees and what a
+ * screen reader is told, not about which classes exist.
+ */
+import type {Volume} from '../../port/types.js';
+import {asFileKey} from '../../port/types.js';
+import {Sidebar} from '../../ui/sidebar.js';
+import type {Place} from '../../ui/sidebar.js';
+
+const GIB = 1024 * 1024 * 1024;
+
+class AssertionError extends Error {}
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) {
+    throw new AssertionError(message);
+  }
+}
+function equal<T>(actual: T, expected: T, message: string): void {
+  if (actual !== expected) {
+    throw new AssertionError(
+        `${message}: expected ${String(expected)}, got ${String(actual)}`);
+  }
+}
+
+function volume(overrides: Partial<Volume> & {id: string}): Volume {
+  return {
+    root: asFileKey(`mock://${overrides.id}`),
+    label: overrides.id,
+    kind: 'drive',
+    removable: false,
+    readOnly: false,
+    capacity: null,
+    ...overrides,
+  } as Volume;
+}
+
+function places(): Place[] {
+  const internal = volume({
+    id: 'internal',
+    label: 'Home',
+    kind: 'system',
+    capacity: {total: 32 * GIB, free: 8 * GIB},
+  });
+  const stick = volume({
+    id: 'stick',
+    label: 'CRUZER',
+    removable: true,
+    capacity: {total: 16 * GIB, free: 128 * 1024 * 1024},
+  });
+  return [
+    {key: asFileKey('fake://recent'), label: 'Recent', kind: 'recent'},
+    {key: asFileKey('fake://starred'), label: 'Starred', kind: 'starred'},
+    {key: asFileKey('fake://trash'), label: 'Trash', kind: 'trash'},
+    {key: internal.root, label: internal.label, kind: 'volume', volume: internal},
+    {key: stick.root, label: stick.label, kind: 'volume', volume: stick},
+    {key: asFileKey('fake://basket'), label: 'Basket', kind: 'basket', badge: 3},
+  ];
+}
+
+interface Harness {
+  sidebar: Sidebar;
+  host: HTMLElement;
+  chosen: Place[];
+  buttons(): HTMLElement[];
+  labels(): string[];
+  headings(): string[];
+  destroy(): void;
+}
+
+function makeHarness(list: Place[] = places()): Harness {
+  const host = document.createElement('div');
+  document.body.appendChild(host);
+  const chosen: Place[] = [];
+  const sidebar = new Sidebar(host, {onSelect: place => chosen.push(place)});
+  sidebar.setPlaces(list);
+  return {
+    sidebar,
+    host,
+    chosen,
+    buttons: () => [...host.querySelectorAll<HTMLElement>('.aurade-place')],
+    labels: () => [...host.querySelectorAll<HTMLElement>('.aurade-place-label')]
+                      .map(node => node.textContent ?? ''),
+    headings: () => [...host.querySelectorAll<HTMLElement>('.aurade-place-heading')]
+                        .map(node => node.textContent ?? ''),
+    destroy: () => {
+      sidebar.destroy();
+      host.remove();
+    },
+  };
+}
+
+function press(target: HTMLElement, key: string): void {
+  target.dispatchEvent(
+      new KeyboardEvent('keydown', {key, bubbles: true, cancelable: true}));
+}
+
+interface DomResult {
+  name: string;
+  ok: boolean;
+  error?: string;
+}
+
+const CASES: Array<{name: string, run: () => void}> = [
+  {
+    name: 'the sidebar is a navigation landmark with a name',
+    run: () => {
+      const h = makeHarness();
+      const nav = h.host.querySelector('nav');
+      assert(nav, 'there is no nav element');
+      equal(nav!.getAttribute('aria-label'), 'Places',
+            'the landmark is unnamed, so it is announced as just "navigation"');
+      h.destroy();
+    },
+  },
+  {
+    name: 'each group is a list that says which group it is',
+    run: () => {
+      const h = makeHarness();
+      const lists = [...h.host.querySelectorAll('.aurade-place-list')];
+      assert(lists.length >= 3, `expected several groups, got ${lists.length}`);
+      for (const list of lists) {
+        const id = list.getAttribute('aria-labelledby');
+        assert(id, 'a group is not associated with its heading');
+        const heading = h.host.querySelector(`#${id}`);
+        assert(heading, `nothing carries the id ${id}`);
+        assert((heading!.textContent ?? '').length > 0,
+               'the heading a group points at is empty');
+      }
+      h.destroy();
+    },
+  },
+  {
+    name: 'removable media is separated from what is bolted in',
+    run: () => {
+      const h = makeHarness();
+      const headings = h.headings();
+      assert(headings.includes('This computer'),
+             `no fixed group heading in ${JSON.stringify(headings)}`);
+      assert(headings.includes('Devices'),
+             `no removable group heading in ${JSON.stringify(headings)}`);
+      const groups = [...h.host.querySelectorAll('.aurade-place-group')];
+      const devices = groups.find(
+          group => group.querySelector('.aurade-place-heading')?.textContent ===
+              'Devices')!;
+      const names = [...devices.querySelectorAll('.aurade-place-label')]
+                        .map(node => node.textContent);
+      equal(names.join(','), 'CRUZER',
+            'the removable group holds the wrong drives');
+      h.destroy();
+    },
+  },
+  {
+    name: 'where you are is announced as current, and only once',
+    run: () => {
+      const h = makeHarness();
+      const all = places();
+      h.sidebar.setSelected(all[3]!.key);
+      const current = h.buttons().filter(
+          button => button.getAttribute('aria-current') === 'page');
+      equal(current.length, 1, 'exactly one place should be current');
+      equal(current[0]!.querySelector('.aurade-place-label')!.textContent,
+            'Home', 'the wrong place is marked current');
+      h.destroy();
+    },
+  },
+  {
+    name: 'selecting a different place moves the current marker',
+    run: () => {
+      const h = makeHarness();
+      const all = places();
+      h.sidebar.setSelected(all[3]!.key);
+      h.sidebar.setSelected(all[0]!.key);
+      const current = h.buttons().filter(
+          button => button.getAttribute('aria-current') === 'page');
+      equal(current.length, 1, 'the old marker was left behind');
+      equal(current[0]!.querySelector('.aurade-place-label')!.textContent,
+            'Recent', 'the marker did not move');
+      h.destroy();
+    },
+  },
+  {
+    name: 'clicking a place asks to go there',
+    run: () => {
+      const h = makeHarness();
+      h.buttons()[4]!.click();
+      equal(h.chosen.length, 1, 'the click was not reported');
+      equal(h.chosen[0]!.label, 'CRUZER', 'the wrong place was reported');
+      h.destroy();
+    },
+  },
+  {
+    name: 'arrow keys walk the whole sidebar, not one group',
+    run: () => {
+      const h = makeHarness();
+      const buttons = h.buttons();
+      buttons[2]!.focus();
+      press(buttons[2]!, 'ArrowDown');
+      // Trash is the last of Quick access; the next place down is the first
+      // drive. A sidebar that stops at a heading makes the keyboard useless.
+      equal(document.activeElement, buttons[3]!,
+            'arrowing down stopped at the end of the group');
+      h.destroy();
+    },
+  },
+  {
+    name: 'arrow keys stop at the ends rather than wrapping',
+    run: () => {
+      const h = makeHarness();
+      const buttons = h.buttons();
+      buttons[0]!.focus();
+      press(buttons[0]!, 'ArrowUp');
+      equal(document.activeElement, buttons[0]!, 'focus wrapped off the top');
+      const last = buttons[buttons.length - 1]!;
+      last.focus();
+      press(last, 'ArrowDown');
+      equal(document.activeElement, last, 'focus wrapped off the bottom');
+      h.destroy();
+    },
+  },
+  {
+    name: 'home and end reach the ends of the whole sidebar',
+    run: () => {
+      const h = makeHarness();
+      const buttons = h.buttons();
+      buttons[2]!.focus();
+      press(buttons[2]!, 'End');
+      equal(document.activeElement, buttons[buttons.length - 1]!,
+            'End did not reach the last place');
+      press(document.activeElement as HTMLElement, 'Home');
+      equal(document.activeElement, buttons[0]!,
+            'Home did not reach the first place');
+      h.destroy();
+    },
+  },
+  {
+    name: 'tab reaches the sidebar once, not once per place',
+    run: () => {
+      const h = makeHarness();
+      const stops = h.buttons().filter(button => button.tabIndex === 0);
+      equal(stops.length, 1,
+            'a roving tabindex means exactly one place is a tab stop');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the sidebar stays reachable when you are somewhere it does not list',
+    run: () => {
+      const h = makeHarness();
+      // Three levels into a folder, nothing in the sidebar is current. That is
+      // the ordinary case rather than the exception, and it must not drop the
+      // whole sidebar out of the tab order.
+      h.sidebar.setSelected(asFileKey('mock://internal/deep/deeper/deepest'));
+      const stops = h.buttons().filter(button => button.tabIndex === 0);
+      equal(stops.length, 1,
+            'with nothing current the sidebar became unreachable by keyboard');
+      h.destroy();
+    },
+  },
+  {
+    name: 'two sidebars on one page do not share heading ids',
+    run: () => {
+      const first = makeHarness();
+      const second = makeHarness();
+      const ids = [...document.querySelectorAll('.aurade-place-heading')].map(
+          node => node.id);
+      equal(new Set(ids).size, ids.length,
+            `split view would resolve the wrong heading: ${ids.join(', ')}`);
+      second.destroy();
+      first.destroy();
+    },
+  },
+  {
+    name: 'capacity is a sentence, not only a bar',
+    run: () => {
+      const h = makeHarness();
+      const free = [...h.host.querySelectorAll('.aurade-place-free')]
+                       .map(node => node.textContent);
+      assert(free.includes('8.0 GB free of 32 GB'),
+             `capacity did not read as free of total: ${JSON.stringify(free)}`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'the bar is not read out twice',
+    run: () => {
+      const h = makeHarness();
+      const bars = [...h.host.querySelectorAll('.aurade-place-bar')];
+      assert(bars.length > 0, 'no capacity bars were drawn');
+      for (const bar of bars) {
+        equal(bar.getAttribute('aria-hidden'), 'true',
+              'the bar repeats what the sentence already said');
+      }
+      h.destroy();
+    },
+  },
+  {
+    name: 'a drive with no room left says so in colour as well as words',
+    run: () => {
+      const h = makeHarness();
+      const fills =
+          [...h.host.querySelectorAll<HTMLElement>('.aurade-place-bar-fill')];
+      // The stick is 16 GB with 128 MB left, which is over 99% used.
+      const alarming = fills.filter(fill => fill.dataset['level'] === 'full');
+      equal(alarming.length, 1,
+            'a drive at 99% should not look the same as one at 25%');
+      const roomy = fills.filter(fill => fill.dataset['level'] === undefined);
+      equal(roomy.length, 1, 'a drive with room to spare should look ordinary');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a place with no notion of capacity draws none',
+    run: () => {
+      const h = makeHarness();
+      const groups = [...h.host.querySelectorAll('.aurade-place-group')];
+      const quick = groups[0]!;
+      equal(quick.querySelectorAll('.aurade-place-capacity').length, 0,
+            'Recent and Trash are not drives and have no free space');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a count says what it counts',
+    run: () => {
+      const h = makeHarness();
+      const basket = h.buttons().find(
+          button => button.querySelector('.aurade-place-label')?.textContent ===
+              'Basket')!;
+      equal(basket.getAttribute('aria-label'), 'Basket, 3 items',
+            'the badge is announced as a bare number');
+      h.destroy();
+    },
+  },
+  {
+    name: 'one gathered item is not "1 items"',
+    run: () => {
+      const list = places().map(
+          place => place.kind === 'basket' ? {...place, badge: 1} : place);
+      const h = makeHarness(list);
+      const basket = h.buttons().find(
+          button => button.querySelector('.aurade-place-label')?.textContent ===
+              'Basket')!;
+      equal(basket.getAttribute('aria-label'), 'Basket, 1 item',
+            'the plural rule does not hold at one');
+      h.destroy();
+    },
+  },
+  {
+    name: 'an empty basket shows no badge at all',
+    run: () => {
+      const list = places().map(
+          place => place.kind === 'basket' ? {...place, badge: 0} : place);
+      const h = makeHarness(list);
+      equal(h.host.querySelectorAll('.aurade-place-badge').length, 0,
+            'a zero should be absent rather than drawn as a zero');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a drive named by its owner cannot inject markup',
+    run: () => {
+      // Deliberately not alert(): a dialog blocks the page, so the suite
+      // would hang instead of failing, and a hang tells you far less.
+      delete (window as unknown as Record<string, unknown>)['auradeInjected'];
+      const nasty = volume({
+        id: 'x',
+        label: '<img src=x onerror="window.auradeInjected = true">',
+      });
+      const h = makeHarness([{
+        key: nasty.root,
+        label: nasty.label,
+        kind: 'volume',
+        volume: nasty,
+      }]);
+      equal(h.host.querySelectorAll('img').length, 0,
+            'a volume label was parsed as HTML');
+      equal(h.labels()[0], '<img src=x onerror="window.auradeInjected = true">',
+            'the label should be shown literally');
+      equal((window as unknown as Record<string, unknown>)['auradeInjected'],
+            undefined, 'a volume label ran as script');
+      h.destroy();
+    },
+  },
+];
+
+export function runSidebarDomTests(): DomResult[] {
+  const results: DomResult[] = [];
+  for (const testCase of CASES) {
+    try {
+      testCase.run();
+      results.push({name: testCase.name, ok: true});
+    } catch (error) {
+      results.push({
+        name: testCase.name,
+        ok: false,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  return results;
+}
diff --git a/ui/file_manager/file_manager/aurade/tests/harness/dom.html b/ui/file_manager/file_manager/aurade/tests/harness/dom.html
