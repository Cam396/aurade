+  block-size: 16px;
+  border-radius: var(--aurade-radius-pill);
+  content: "";
+  inline-size: 3px;
+  inset-block-start: 50%;
+  inset-inline-start: 1px;
+  position: absolute;
+  translate: 0 -50%;
+}
+.aurade-place-glyph {
