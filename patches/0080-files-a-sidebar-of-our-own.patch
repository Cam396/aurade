index 0000000..3548b95
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/sidebar.ts
@@ -0,0 +1,269 @@
+/**
+ * The places you can go, as our own component.
+ *
+ * Upstream puts this in a shadow root, which is why restyling it needed a
+ * stylesheet pushed into every tree item individually and why its selected
+ * state was unreadable for months: the rule paints on_primary over primary and
+ * a palette that retints those separately lands dark on dark. None of that is
+ * a problem you can have if you own the markup.
+ *
+ * Built as a list of buttons rather than a tree. A tree role promises expand
+ * and collapse semantics, arrow keys that walk levels, and a shape a screen
+ * reader will describe as nested. This is a flat set of destinations in
+ * labelled groups, so it says so.
+ */
+import type {FileKey, Volume} from '../port/types.js';
+import {formatSize} from './format.js';
+
+export type PlaceKind = 'recent'|'starred'|'trash'|'basket'|'volume';
+
+export interface Place {
+  readonly key: FileKey;
+  readonly label: string;
+  readonly kind: PlaceKind;
+  readonly volume?: Volume;
+  /** Shown as a count beside the label, for the basket. */
+  readonly badge?: number;
+}
+
+export interface SidebarOptions {
+  readonly onSelect?: (place: Place) => void;
+}
+
+const GLYPHS: Record<PlaceKind|'removable'|'system', string> = {
+  recent: 'M10 5v5l3.5 2M10 3.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z',
+  starred: 'M10 3.5l2 4.2 4.5.6-3.3 3.2.8 4.5-4-2.2-4 2.2.8-4.5L3.5 8.3l4.5-.6z',
+  trash: 'M4.5 6h11M8 6V4.5h4V6M6 6l.7 9.5h6.6L14 6M8.5 8.5v5M11.5 8.5v5',
+  basket: 'M3.5 7.5h13l-1.4 8h-10.2zM7 7.5 8.5 3.5M13 7.5 11.5 3.5',
+  volume: 'M3 5.5h14v9H3zM3 11.5h14',
+  system: 'M4 5h12v7H4zM2.5 14.5h15',
+  removable: 'M7 3.5h6v5h2v8H5v-8h2zM9 5v2M11 5v2',
+};
+
+const STROKED = new Set<string>(['recent', 'trash', 'volume', 'system',
+                                 'removable', 'basket']);
+
+function glyph(kind: string): string {
+  const path = GLYPHS[kind as keyof typeof GLYPHS] ?? GLYPHS.volume;
+  const stroke = STROKED.has(kind) ?
+      'fill="none" stroke="currentColor" stroke-width="1.5" ' +
+          'stroke-linejoin="round" stroke-linecap="round"' :
+      'fill="currentColor"';
+  return `<svg class="aurade-place-glyph" viewBox="0 0 20 20" aria-hidden="true">` +
+      `<path d="${path}" ${stroke}/></svg>`;
+}
+
+function volumeGlyphKind(volume: Volume): string {
+  if (volume.removable) {
+    return 'removable';
+  }
+  return volume.kind === 'system' ? 'system' : 'volume';
+}
+
+let instances = 0;
+
+export class Sidebar {
+  private readonly nav: HTMLElement;
+  /** Distinguishes this sidebar's heading ids from another pane's. */
+  private readonly instance = ++instances;
+  private places: Place[] = [];
+  private selected: FileKey|null = null;
+
+  constructor(
+      private readonly container: HTMLElement,
+      private readonly options: SidebarOptions = {}) {
+    this.nav = document.createElement('nav');
+    this.nav.className = 'aurade-sidebar';
+    this.nav.setAttribute('aria-label', 'Places');
+    this.container.appendChild(this.nav);
+    this.nav.addEventListener('click', this.onClick);
+    this.nav.addEventListener('keydown', this.onKeyDown);
+  }
+
+  setPlaces(places: readonly Place[]): void {
+    this.places = places.slice();
+    this.render();
+  }
+
+  setSelected(key: FileKey|null): void {
+    this.selected = key;
+    this.render();
+  }
+
+  private groups(): Array<{title: string, places: Place[]}> {
+    const quick = this.places.filter(
+        place => place.kind !== 'volume' && place.kind !== 'basket');
+    const volumes = this.places.filter(place => place.kind === 'volume');
+    const basket = this.places.filter(place => place.kind === 'basket');
+    const out: Array<{title: string, places: Place[]}> = [];
+    if (quick.length) {
+      out.push({title: 'Quick access', places: quick});
+    }
+    // Removable media is separated from what is always there, because a drive
+    // you can pull out and a drive you cannot are not the same kind of place.
+    const fixed = volumes.filter(place => !place.volume?.removable);
+    const removable = volumes.filter(place => place.volume?.removable);
+    if (fixed.length) {
+      out.push({title: 'This computer', places: fixed});
+    }
+    if (removable.length) {
+      out.push({title: 'Devices', places: removable});
+    }
+    if (basket.length) {
+      out.push({title: 'Gathered', places: basket});
+    }
+    return out;
+  }
+
+  private render(): void {
+    this.nav.textContent = '';
+    for (const group of this.groups()) {
+      const section = document.createElement('div');
+      section.className = 'aurade-place-group';
+      const heading = document.createElement('h2');
+      heading.className = 'aurade-place-heading';
+      heading.textContent = group.title;
+      const id = `aurade-group-${this.instance}-` +
+          group.title.replace(/\s+/g, '-').toLowerCase();
+      heading.id = id;
+      const list = document.createElement('ul');
+      list.className = 'aurade-place-list';
+      list.setAttribute('aria-labelledby', id);
+      for (const place of group.places) {
+        list.appendChild(this.renderPlace(place));
+      }
+      section.append(heading, list);
+      this.nav.appendChild(section);
+    }
+  }
+
+  private renderPlace(place: Place): HTMLElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'aurade-place';
+    button.dataset['key'] = place.key;
+    const current = place.key === this.selected;
+    // aria-current rather than aria-selected: this is where you are, not one
+    // of a set of things you have picked.
+    if (current) {
+      button.setAttribute('aria-current', 'page');
+    }
+    // Where you are is the natural place for the keyboard to land, but only if
+    // it is somewhere this sidebar actually lists. It usually is not: open a
+    // folder three levels down and none of these is current. Falling back to
+    // the first place keeps the sidebar in the tab order instead of dropping
+    // it out of the document entirely.
+    button.tabIndex = place === this.tabStop() ? 0 : -1;
+
+    const kind = place.kind === 'volume' && place.volume ?
+        volumeGlyphKind(place.volume) : place.kind;
+    const label = document.createElement('span');
+    label.className = 'aurade-place-label';
+    label.textContent = place.label;
+
+    button.innerHTML = glyph(kind);
+    button.appendChild(label);
+
+    if (place.badge !== undefined && place.badge > 0) {
+      const badge = document.createElement('span');
+      badge.className = 'aurade-place-badge';
+      badge.textContent = String(place.badge);
+      // The number is meaningless read on its own, so the button says what it
+      // counts and the badge itself is decoration.
+      button.setAttribute(
+          'aria-label',
+          `${place.label}, ${place.badge} ${place.badge === 1 ? 'item' : 'items'}`);
+      button.appendChild(badge);
+    }
+
+    item.appendChild(button);
+
+    const capacity = place.volume?.capacity;
+    if (capacity && capacity.total > 0) {
+      // Exact free space in words, with the bar as the supplement. A ring or a
+      // bar on its own is poor for comparison and worse for anybody who cannot
+      // see it, so the sentence carries the meaning.
+      const used = 1 - capacity.free / capacity.total;
+      const meter = document.createElement('div');
+      meter.className = 'aurade-place-capacity';
+      const text = document.createElement('span');
+      text.className = 'aurade-place-free';
+      text.textContent =
+          `${formatSize(capacity.free)} free of ${formatSize(capacity.total)}`;
+      const bar = document.createElement('div');
+      bar.className = 'aurade-place-bar';
+      bar.setAttribute('role', 'img');
+      bar.setAttribute('aria-hidden', 'true');
+      const fill = document.createElement('div');
+      fill.className = 'aurade-place-bar-fill';
+      fill.style.inlineSize = `${Math.round(used * 100)}%`;
+      if (used >= 0.98) {
+        fill.dataset['level'] = 'full';
+      } else if (used >= 0.90) {
+        fill.dataset['level'] = 'high';
+      }
+      bar.appendChild(fill);
+      meter.append(text, bar);
+      item.appendChild(meter);
+    }
+
+    return item;
+  }
+
+  private tabStop(): Place|undefined {
+    return this.places.find(place => place.key === this.selected) ??
+        this.places[0];
+  }
+
+  private buttons(): HTMLElement[] {
+    return [...this.nav.querySelectorAll<HTMLElement>('.aurade-place')];
+  }
+
+  private activate(button: HTMLElement): void {
+    const key = button.dataset['key'];
+    const place = this.places.find(candidate => candidate.key === key);
+    if (place) {
+      this.options.onSelect?.(place);
+    }
+  }
+
+  private onClick = (event: MouseEvent): void => {
+    const button = (event.target as HTMLElement|null)?.closest?.('.aurade-place');
+    if (button) {
+      this.activate(button as HTMLElement);
+    }
+  };
+
+  // Arrow keys walk the whole sidebar rather than one group, because the
+  // grouping is a way of reading it and not a set of separate controls.
+  private onKeyDown = (event: KeyboardEvent): void => {
+    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' &&
+        event.key !== 'Home' && event.key !== 'End') {
+      return;
+    }
+    const buttons = this.buttons();
+    if (!buttons.length) {
+      return;
+    }
+    const active = document.activeElement as HTMLElement|null;
+    const at = buttons.findIndex(button => button === active);
+    let next: number;
+    switch (event.key) {
+      case 'ArrowDown': next = at < 0 ? 0 : Math.min(buttons.length - 1, at + 1); break;
+      case 'ArrowUp': next = at < 0 ? 0 : Math.max(0, at - 1); break;
+      case 'Home': next = 0; break;
+      default: next = buttons.length - 1;
+    }
+    for (const button of buttons) {
+      button.tabIndex = -1;
+    }
+    buttons[next]!.tabIndex = 0;
+    buttons[next]!.focus();
+    event.preventDefault();
+  };
+
+  destroy(): void {
+    this.nav.remove();
+  }
+}
