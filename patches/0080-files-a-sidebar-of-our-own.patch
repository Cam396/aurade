+
+
+/* The sidebar: where you can go, as opposed to what is in front of you.
+
+   Group headings are quiet and small rather than uppercase and tracked out.
+   Small caps at this size is a legibility cost paid for a filing cabinet
+   aesthetic nobody asked for, and these are three or four words that want to
+   be skimmed past on the way to the thing underneath. */
+.aurade-sidebar {
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  inline-size: 232px;
+  overflow-y: auto;
+  padding: 12px 10px;
+}
+.aurade-place-heading {
+  color: var(--aurade-quiet);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: .01em;
+  margin: 0 0 4px;
+  padding-inline: 10px;
+}
+.aurade-place-list {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.aurade-place {
+  align-items: center;
+  background: none;
+  border: 0;
+  border-radius: var(--aurade-radius-row);
+  color: var(--aurade-ink);
+  cursor: default;
+  display: flex;
+  font: inherit;
+  gap: 10px;
+  inline-size: 100%;
+  padding: 7px 10px;
+  position: relative;
+  text-align: start;
+}
+.aurade-place:hover { background: var(--aurade-row-hover); }
+.aurade-place:focus-visible {
+  outline: 2px solid var(--aurade-accent);
+  outline-offset: -2px;
+}
+.aurade-place[aria-current="page"] {
+  background: var(--aurade-row-selected);
+  color: var(--aurade-accent);
+  font-weight: 600;
+}
+/* A rail rather than a full bleed fill. The fill alone reads as a hover that
+   got stuck; the rail is what says this is where you are. */
+.aurade-place[aria-current="page"]::before {
+  background: var(--aurade-accent);
+  block-size: 16px;
+  border-radius: var(--aurade-radius-pill);
+  content: "";
+  inline-size: 3px;
+  inset-block-start: 50%;
+  inset-inline-start: 1px;
+  position: absolute;
+  translate: 0 -50%;
+}
+.aurade-place-glyph {
+  block-size: 18px;
+  color: var(--aurade-glyph);
+  flex: none;
+  inline-size: 18px;
+}
+.aurade-place[aria-current="page"] .aurade-place-glyph { color: inherit; }
+.aurade-place-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.aurade-place-badge {
+  background: var(--aurade-tag-bg);
+  border-radius: var(--aurade-radius-pill);
+  color: var(--aurade-quiet);
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+  margin-inline-start: auto;
+  padding: 1px 7px;
+}
+.aurade-place[aria-current="page"] .aurade-place-badge {
+  background: var(--aurade-panel);
+  color: var(--aurade-accent);
+}
+
+/* Capacity sits under the drive it belongs to, indented to the label rather
+   than the glyph, so the eye reads it as a note about that row. */
+.aurade-place-capacity {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 1px 10px 6px 38px;
+}
+.aurade-place-free {
+  color: var(--aurade-quiet);
+  font-size: 11px;
+}
+.aurade-place-bar {
+  background: var(--aurade-line);
+  block-size: 3px;
+  border-radius: var(--aurade-radius-pill);
+  overflow: hidden;
+}
+.aurade-place-bar-fill {
+  background: var(--aurade-accent);
+  block-size: 100%;
+  border-radius: inherit;
+}
+.aurade-place-bar-fill[data-level="high"] { background: var(--aurade-warn); }
+.aurade-place-bar-fill[data-level="full"] { background: var(--aurade-danger); }
