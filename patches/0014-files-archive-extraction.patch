+void ExtractIOTask::ExtractArchiveViaCli(
+    ArchiveType type,
+    const base::FilePath& source_file,
+    const base::FilePath& destination_directory) {
+  // Build the CLI command based on archive type.
+  std::vector<std::string> argv;
+  switch (type) {
+    case ArchiveType::kTar:
+    case ArchiveType::kTarGz:
+    case ArchiveType::kTarBz2:
+    case ArchiveType::kTarXz:
+    case ArchiveType::kTarLz:
+    case ArchiveType::kTarZst:
+      argv = {"tar", "xf", source_file.value(), "-C",
+              destination_directory.value()};
+      break;
+    case ArchiveType::kSevenZ:
+      argv = {"7z", "x", source_file.value(),
+              "-o" + destination_directory.value(), "-y"};
+      if (!password_.empty()) {
+        argv.push_back("-p" + password_);
+      }
+      break;
+    case ArchiveType::kRar:
+      argv = {"unrar", "x", source_file.value(), destination_directory.value(),
+              "-y"};
+      if (!password_.empty()) {
+        argv.push_back("-p" + password_);
+      }
+      break;
+    case ArchiveType::kUnknown:
+    case ArchiveType::kZip:
+      NOTREACHED();
   }
+
+  // Run extraction on a thread pool (blocking I/O). The process handle stays
+  // local to the lambda; there is no shared state with the UI thread.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const std::vector<std::string>& argv) -> bool {
+            if (argv.empty()) {
+              LOG(ERROR) << "No extraction command specified";
+              return false;
+            }
+            base::LaunchOptions options;
+            base::Process process = base::LaunchProcess(argv, options);
+            if (!process.IsValid()) {
+              LOG(ERROR) << "Failed to launch: " << argv.front();
+              return false;
+            }
+            int exit_code;
+            if (!process.WaitForExit(&exit_code)) {
+              LOG(ERROR) << "Failed to wait for: " << argv.front();
+              return false;
+            }
+            return exit_code == 0;
+          },
+          std::move(argv)),
+      base::BindOnce(&ExtractIOTask::CliExtractCallback,
+                     weak_ptr_factory_.GetWeakPtr(), destination_directory));
+}
+
+void ExtractIOTask::CliExtractCallback(base::FilePath destination_directory,
+                                       bool success) {
+  // Apply directory permissions and finish.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&SetDirectoryPermissions, destination_directory, success),
+      base::BindOnce(&ExtractIOTask::FinishedExtraction,
+                     weak_ptr_factory_.GetWeakPtr(), destination_directory));
 }
 
