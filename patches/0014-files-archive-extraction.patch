+// static
+bool ExtractIOTask::IsArchiveExtension(const base::FilePath& path) {
+  const std::string lower_name = base::ToLowerASCII(path.BaseName().value());
+  for (std::string_view extension : kArchiveExtensions) {
+    if (PathEndsWith(lower_name, extension)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// static
+ExtractIOTask::ArchiveType ExtractIOTask::GetArchiveType(
+    const base::FilePath& path) {
+  const std::string lower_name = base::ToLowerASCII(path.BaseName().value());
+  if (PathEndsWith(lower_name, ".zip")) {
+    return ArchiveType::kZip;
+  }
+  if (PathEndsWith(lower_name, ".7z")) {
+    return ArchiveType::kSevenZ;
+  }
+  if (PathEndsWith(lower_name, ".rar")) {
+    return ArchiveType::kRar;
+  }
+  if (PathEndsWith(lower_name, ".tar")) {
+    return ArchiveType::kTar;
+  }
+  if (PathEndsWith(lower_name, ".tgz") || PathEndsWith(lower_name, ".tar.gz")) {
+    return ArchiveType::kTarGz;
+  }
+  if (PathEndsWith(lower_name, ".tbz2") ||
+      PathEndsWith(lower_name, ".tar.bz2")) {
+    return ArchiveType::kTarBz2;
+  }
+  if (PathEndsWith(lower_name, ".txz") || PathEndsWith(lower_name, ".tar.xz")) {
+    return ArchiveType::kTarXz;
+  }
+  if (PathEndsWith(lower_name, ".tar.lz")) {
+    return ArchiveType::kTarLz;
+  }
+  if (PathEndsWith(lower_name, ".tar.zst")) {
+    return ArchiveType::kTarZst;
+  }
+  return ArchiveType::kUnknown;
+}
+
+// static
+std::string ExtractIOTask::GetArchiveStem(const base::FilePath& path) {
+  const std::string name = path.BaseName().value();
+  const std::string lower_name = base::ToLowerASCII(name);
+  for (std::string_view extension : kArchiveExtensions) {
+    if (PathEndsWith(lower_name, extension)) {
+      return name.substr(0, name.size() - extension.size());
+    }
+  }
+  return path.BaseName().RemoveExtension().value();
+}
