+}
+.aurade-status-summary {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.aurade-status-space {
+  align-items: center;
+  display: flex;
+  flex: none;
+  gap: 8px;
+}
+.aurade-status-track {
+  background: var(--aurade-line);
+  block-size: 3px;
+  border-radius: var(--aurade-radius-pill);
