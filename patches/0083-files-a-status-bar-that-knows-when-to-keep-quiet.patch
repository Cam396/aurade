--- a/ui/file_manager/file_manager/aurade/tests/dom/shell_test.ts
+++ b/ui/file_manager/file_manager/aurade/tests/dom/shell_test.ts
@@ -137,6 +137,9 @@ interface Harness {
   crumbs(): string[];
   tool(kind: string): HTMLButtonElement;
   openRow(name: string): Promise<void>;
+  status(): string;
+  freeSpace(): string|null;
+  clickRow(name: string): void;
   places(): string[];
   headings(): string[];
   currentPlace(): string|null;
@@ -179,6 +182,23 @@ function makeHarness(backend: MockBackend = backendWith()): Harness {
       }
       row.dispatchEvent(new MouseEvent('dblclick', {bubbles: true}));
     },
+    status: () =>
+        host.querySelector('.aurade-status-summary')?.textContent ?? '',
+    freeSpace: () => {
+      const space = host.querySelector<HTMLElement>('.aurade-status-space');
+      return space && !space.hidden ?
+          space.querySelector('.aurade-status-free')?.textContent ?? '' :
+          null;
+    },
+    clickRow: (name: string) => {
+      const row = [...host.querySelectorAll<HTMLElement>('.aurade-row')].find(
+          candidate => candidate.querySelector('.aurade-name')?.textContent ===
+              name);
+      if (!row) {
+        throw new AssertionError(`${name} is not on screen`);
+      }
+      row.dispatchEvent(new MouseEvent('click', {bubbles: true}));
+    },
     notice: () => {
       const notice = host.querySelector<HTMLElement>('.aurade-shell-notice');
       return notice && !notice.hidden ? notice.textContent : null;
@@ -573,6 +593,120 @@ const CASES: Array<{name: string, run: () => Promise<void>}> = [
       h.destroy();
     },
   },
+  {
+    name: 'the status bar says what is in the folder',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const text = h.status();
+      // Two folders (Documents, Photos) and six files.
+      assert(/folders/.test(text) && /files/.test(text),
+             `the summary does not describe the folder: "${text}"`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'it shows how much room is left on the drive you are on',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      equal(h.freeSpace(), '8.0 GB free', 'the free space is wrong or absent');
+      h.destroy();
+    },
+  },
+  {
+    name: 'the drive does not change just because you opened a folder',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      await h.openRow('Documents');
+      await settle(10);
+      equal(h.freeSpace(), '8.0 GB free',
+            'going one folder down lost track of which drive you are on');
+      h.destroy();
+    },
+  },
+  {
+    name: 'selecting something replaces the count with the selection',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      h.clickRow('home-0.txt');
+      await settle();
+      const text = h.status();
+      assert(/1 item selected/.test(text),
+             `the selection is not reported: "${text}"`);
+      assert(!/1 items selected/.test(text), 'the plural rule broke at one');
+      h.destroy();
+    },
+  },
+  {
+    name: 'a total is given only when every size is actually known',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      // A small folder fits in one window, so every size has arrived and the
+      // total is real.
+      assert(/\d+(\.\d+)? (bytes|KB|MB|GB)/.test(h.status()),
+             `a small folder should total up: "${h.status()}"`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'a huge directory is not given a total assembled from one screen',
+    run: async () => {
+      const backend = backendWith(0);
+      for (let i = 0; i < 20_000; i++) {
+        backend.add(ROOT, `bulk-${i}.txt`, false, {size: 1024});
+      }
+      const h = makeHarness(backend);
+      await h.shell.start();
+      await settle(12);
+      const text = h.status();
+      // Sizes exist for the forty rows on screen and for nothing else. A total
+      // built from those grows as you scroll and is wrong until the very end,
+      // which is worse than no total because it looks like an answer.
+      assert(!/(bytes|KB|MB|GB)/.test(text),
+             `it totalled up one screen and called it the folder: "${text}"`);
+      assert(/20,?000 files|20000 files/.test(text),
+             `and it should still say how many there are: "${text}"`);
+      h.destroy();
+    },
+  },
+  {
+    name: 'the free space bar is not read out as well as the words',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const track = h.host.querySelector('.aurade-status-track')!;
+      equal(track.getAttribute('aria-hidden'), 'true',
+            'the bar repeats what the sentence already said');
+      h.destroy();
+    },
+  },
+  {
+    name: 'somewhere with no notion of free space shows none',
+    run: async () => {
+      const h = makeHarness();
+      await h.shell.start();
+      await settle(10);
+      const recent = [...h.host.querySelectorAll<HTMLElement>('.aurade-place')]
+                         .find(button =>
+                                   button.querySelector('.aurade-place-label')
+                                       ?.textContent === 'Recent')!;
+      recent.click();
+      await settle(10);
+      equal(h.freeSpace(), null,
+            'Recent is not a drive and has no free space to report');
+      h.destroy();
+    },
+  },
   {
     name: 'a huge directory does not stat every entry to fill one screen',
     run: async () => {
