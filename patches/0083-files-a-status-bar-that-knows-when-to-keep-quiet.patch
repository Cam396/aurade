diff --git a/ui/file_manager/file_manager/aurade/ui/status_bar.ts b/ui/file_manager/file_manager/aurade/ui/status_bar.ts
new file mode 100644
index 000000000000..57254a4ad446
--- /dev/null
+++ b/ui/file_manager/file_manager/aurade/ui/status_bar.ts
@@ -0,0 +1,107 @@
+/**
+ * What is in front of you, along the bottom.
+ *
+ * The hard part of a status bar is not the layout, it is knowing when to keep
+ * quiet. Metadata is fetched for the window on screen rather than the whole
+ * directory, so a total assembled from whatever happens to have arrived is a
+ * number that changes as you scroll and is wrong until you reach the end. This
+ * shows a size only when every file it is counting has actually reported one,
+ * and otherwise says how many things there are and stops there.
+ *
+ * Deliberately not a live region. The list is a listbox and already announces
+ * each row as focus moves through it, so a polite region repeating the count
+ * would speak over the row you just arrived at. Announcing bulk changes only,
+ * such as select all, would be better than either and is not built yet.
+ */
+import {formatCount, formatSelection, formatSize} from './format.js';
+
+export interface StatusModel {
+  readonly folders: number;
+  readonly files: number;
+  readonly selected: number;
+  /** Bytes, or null when a size is missing for anything being counted. */
+  readonly bytes: number|null;
+  readonly capacity: {readonly total: number, readonly free: number}|null;
+}
+
+const EMPTY: StatusModel = {
+  folders: 0,
+  files: 0,
+  selected: 0,
+  bytes: null,
+  capacity: null,
+};
+
+export class StatusBar {
+  private readonly bar: HTMLElement;
+  private readonly summary: HTMLElement;
+  private readonly space: HTMLElement;
+  private readonly free: HTMLElement;
+  private readonly bar_fill: HTMLElement;
+  private model: StatusModel = EMPTY;
+
+  constructor(container: HTMLElement) {
+    this.bar = document.createElement('div');
+    this.bar.className = 'aurade-status';
+    // The window's summary of itself, which is what contentinfo is for.
+    this.bar.setAttribute('role', 'contentinfo');
+
+    this.summary = document.createElement('span');
+    this.summary.className = 'aurade-status-summary';
+
+    this.space = document.createElement('div');
+    this.space.className = 'aurade-status-space';
+    this.free = document.createElement('span');
+    this.free.className = 'aurade-status-free';
+    const track = document.createElement('div');
+    track.className = 'aurade-status-track';
+    // The sentence beside it carries the meaning, so this is not read out.
+    track.setAttribute('aria-hidden', 'true');
+    this.bar_fill = document.createElement('div');
+    this.bar_fill.className = 'aurade-status-fill';
+    track.appendChild(this.bar_fill);
+    this.space.append(this.free, track);
+
+    this.bar.append(this.summary, this.space);
+    container.appendChild(this.bar);
+    this.render();
+  }
+
+  set(model: StatusModel): void {
+    this.model = model;
+    this.render();
+  }
+
+  private summaryText(): string {
+    const {folders, files, selected, bytes} = this.model;
+    const head =
+        selected > 0 ? formatSelection(selected) : formatCount(folders, files);
+    // Only when the number is real. A total that grows as you scroll is worse
+    // than no total, because it looks like an answer.
+    return bytes === null ? head : `${head}, ${formatSize(bytes)}`;
+  }
+
+  private render(): void {
+    this.summary.textContent = this.summaryText();
+    const capacity = this.model.capacity;
+    if (!capacity || capacity.total <= 0) {
+      this.space.hidden = true;
+      return;
+    }
+    this.space.hidden = false;
+    this.free.textContent = `${formatSize(capacity.free)} free`;
+    const used = 1 - capacity.free / capacity.total;
+    this.bar_fill.style.inlineSize = `${Math.round(used * 100)}%`;
+    if (used >= 0.98) {
+      this.bar_fill.dataset['level'] = 'full';
+    } else if (used >= 0.90) {
+      this.bar_fill.dataset['level'] = 'high';
+    } else {
+      delete this.bar_fill.dataset['level'];
+    }
+  }
+
+  destroy(): void {
+    this.bar.remove();
+  }
+}
