 }
+
+/* AuraDE: the Devices panel, shown only in Computer.
+ *
+ * It sits above the list in the same column flexbox the status bar pins itself
+ * to the bottom of, so it takes its height from the list rather than floating
+ * over it. flex: none for the same reason: a panel that grew with the window
+ * would push the listing out of view on a short screen.
+ *
+ * The artwork is the volume set already in the tree, drawn as masks so a disk
+ * icon takes a colour from the theme like every other icon in the app rather
+ * than arriving as a fixed-colour picture that looks wrong in one scheme.
+ */
+#aurade-devices {
+  border-bottom: 1px solid var(--cros-sys-separator);
+  box-sizing: border-box;
+  flex: none;
+  padding: 12px 16px 14px;
+}
+
+#aurade-devices[hidden] {
+  display: none;
+}
+
+#aurade-devices-title {
+  color: var(--cros-sys-on_surface_variant);
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  margin-bottom: 10px;
+  text-transform: uppercase;
+}
+
+#aurade-devices-list {
+  display: grid;
+  gap: 8px;
+  /* Wide enough for a name, a filesystem and a capacity bar without wrapping,
+   * and it reflows to one column on a narrow window instead of clipping. */
+  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+}
+
+.aurade-device {
+  align-items: center;
+  background: var(--cros-sys-app_base_shaded);
+  border-radius: 12px;
+  display: flex;
+  gap: 12px;
+  padding: 10px 14px;
+}
+
+#aurade-devices [aurade-device-icon] {
+  background-color: var(--cros-sys-primary);
+  flex: none;
+  height: 20px;
+  -webkit-mask-position: center;
+  -webkit-mask-repeat: no-repeat;
+  -webkit-mask-size: 20px;
+  width: 20px;
+}
+
+#aurade-devices [aurade-device-icon='hdd'] {
+  -webkit-mask-image: url(../images/volumes/hard_drive.svg);
+}
+
+#aurade-devices [aurade-device-icon='usb'] {
+  -webkit-mask-image: url(../images/volumes/usb.svg);
+}
+
+#aurade-devices [aurade-device-icon='sd'] {
+  -webkit-mask-image: url(../images/volumes/sd.svg);
+}
+
+#aurade-devices [aurade-device-icon='optical'] {
+  -webkit-mask-image: url(../images/volumes/cd.svg);
+}
+
+#aurade-devices [aurade-device-icon='mobile'] {
+  -webkit-mask-image: url(../images/volumes/phone.svg);
+}
+
+#aurade-devices [aurade-device-icon='computer'] {
+  -webkit-mask-image: url(../images/volumes/computer.svg);
+}
+
+#aurade-devices [aurade-device-icon='smb'] {
+  -webkit-mask-image: url(../images/volumes/smb.svg);
+}
+
+#aurade-devices [aurade-device-icon='archive'] {
+  -webkit-mask-image: url(../images/volumes/archive.svg);
+}
+
+.aurade-device-text {
+  flex: auto;
+  min-width: 0;
+}
+
+.aurade-device-name {
+  color: var(--cros-sys-on_surface);
+  font-size: 13px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.aurade-device-detail {
+  color: var(--cros-sys-on_surface_variant);
+  font-size: 11px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.aurade-device-meter {
+  flex: none;
+  /* Wide enough that "999.9 GB of 999.9 GB" stays on one line. Narrower and
+   * the unit wraps onto a line of its own, which reads as a broken layout
+   * rather than a tight one. */
+  width: 132px;
+}
+
+.aurade-device-meter[hidden] {
+  display: none;
+}
+
+.aurade-device-bar {
+  background: var(--cros-sys-separator);
+  border-radius: 3px;
+  height: 4px;
+  overflow: hidden;
+}
+
+.aurade-device-fill {
+  background: var(--cros-sys-primary);
+  height: 100%;
+  width: 0;
+}
+
+/* A disk with almost nothing left is the one case where this panel should
+ * raise its voice. Warning rather than error: it is a thing to see coming. */
+.aurade-device-low .aurade-device-fill {
+  background: var(--cros-sys-warning);
+}
+
+.aurade-device-figure {
+  color: var(--cros-sys-on_surface_variant);
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+  margin-top: 5px;
+  overflow: hidden;
+  text-align: end;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
