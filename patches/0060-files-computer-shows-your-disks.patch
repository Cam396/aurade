+++ b/ui/file_manager/file_manager/foreground/js/aurade_devices_controller.ts
@@ -0,0 +1,225 @@
+// Copyright 2026 The AuraDE Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {getSizeStats} from '../../common/js/api.js';
+import {bytesToString} from '../../common/js/translations.js';
+import {RootType, VolumeType} from '../../common/js/volume_manager_types.js';
+import type {Volume} from '../../state/state.js';
+import {getStore} from '../../state/store.js';
+import type {Store} from '../../state/store.js';
+
+import type {DirectoryModel} from './directory_model.js';
+
+/**
+ * AuraDE: the panel that turns Computer into a view of the machine.
+ *
+ * Computer opened onto seven curated entries, Downloads and Filesystem Root
+ * and Users and the rest, which is a list of places rather than a picture of
+ * the hardware. Nothing on the screen told you what disks the machine has, how
+ * big they are, or how full. Every other desktop answers that in the same
+ * place.
+ *
+ * The data is already in the frontend. The store carries a Volume for every
+ * mounted volume with its label, device type, filesystem and read only flag,
+ * and getSizeStats gives the capacity. So this is a rendering job and nothing
+ * more: no new plumbing, no new host call.
+ */
+export class AuraDeDevicesController {
+  private store_: Store;
+  private panel_: HTMLElement|null = null;
+  private list_: HTMLElement|null = null;
+
+  /**
+   * Guards against a slow capacity query painting a panel that has since been
+   * rebuilt for another folder. Each render takes the next number.
+   */
+  private render_ = 0;
+
+  constructor(private directoryModel_: DirectoryModel) {
+    this.store_ = getStore();
+    this.directoryModel_.addEventListener(
+        'directory-changed', this.update_.bind(this));
+    this.directoryModel_.addEventListener(
+        'cur-dir-scan-completed', this.update_.bind(this));
+  }
+
+  /**
+   * The panel lives in the same document as the file picker dialogs, which
+   * have no Computer root and no panel, so this tolerates absence rather than
+   * asserting on it.
+   */
+  private elements_(): boolean {
+    if (!this.panel_) {
+      this.panel_ = document.querySelector<HTMLElement>('#aurade-devices');
+      this.list_ = document.querySelector<HTMLElement>('#aurade-devices-list');
+    }
+    return !!this.panel_ && !!this.list_;
+  }
+
+  private update_() {
+    if (!this.elements_()) {
+      return;
+    }
+    const onComputer =
+        this.directoryModel_.getCurrentRootType() === RootType.LOCAL_ROOT;
+    this.panel_!.hidden = !onComputer;
+    if (!onComputer) {
+      // Emptied rather than left in place. A stale panel behind hidden is a
+      // panel that flashes the previous machine state on the way back in.
+      this.list_!.textContent = '';
+      return;
+    }
+    this.render_++;
+    this.draw_(this.render_);
+  }
+
+  /**
+   * Volumes worth showing as hardware.
+   *
+   * Downloads and the Linux container are places, not disks, and the sidebar
+   * already lists them. Showing them here again would make the panel a second
+   * copy of the sidebar rather than an answer to a different question.
+   */
+  private isDevice_(volume: Volume): boolean {
+    switch (volume.volumeType) {
+      case VolumeType.REMOVABLE:
+      case VolumeType.ARCHIVE:
+      case VolumeType.MTP:
+      case VolumeType.SMB:
+      case VolumeType.LOCAL_ROOT:
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  private iconFor_(volume: Volume): string {
+    if (volume.volumeType === VolumeType.LOCAL_ROOT) {
+      return 'computer';
+    }
+    if (volume.volumeType === VolumeType.ARCHIVE) {
+      return 'archive';
+    }
+    if (volume.volumeType === VolumeType.SMB) {
+      return 'smb';
+    }
+    if (volume.volumeType === VolumeType.MTP) {
+      return 'mobile';
+    }
+    switch (volume.deviceType) {
+      case 'usb':
+        return 'usb';
+      case 'sd':
+        return 'sd';
+      case 'optical':
+        return 'optical';
+      case 'mobile':
+        return 'mobile';
+      default:
+        return 'hdd';
+    }
+  }
+
+  /**
+   * What the row says under its name.
+   *
+   * Only facts the store actually holds. A filesystem it does not know is left
+   * out rather than guessed at, because a wrong filesystem next to a Format
+   * command is worse than no filesystem at all.
+   */
+  private detailFor_(volume: Volume): string {
+    const parts: string[] = [];
+    if (volume.diskFileSystemType) {
+      parts.push(volume.diskFileSystemType);
+    }
+    if (volume.isReadOnly) {
+      parts.push('Read only');
+    }
+    return parts.join('  ·  ');
+  }
+
+  private draw_(render: number) {
+    const list = this.list_!;
+    list.textContent = '';
+
+    const volumes = Object.values(this.store_.getState().volumes ?? {})
+                        .filter(volume => this.isDevice_(volume));
+    if (!volumes.length) {
+      return;
+    }
+
+    for (const volume of volumes) {
+      const row = document.createElement('div');
+      row.className = 'aurade-device';
+
+      const icon = document.createElement('span');
+      icon.setAttribute('aurade-device-icon', this.iconFor_(volume));
+      row.appendChild(icon);
+
+      const text = document.createElement('div');
+      text.className = 'aurade-device-text';
+
+      const name = document.createElement('div');
+      name.className = 'aurade-device-name';
+      name.textContent = volume.label || volume.volumeId;
+      text.appendChild(name);
+
+      const detail = document.createElement('div');
+      detail.className = 'aurade-device-detail';
+      detail.textContent = this.detailFor_(volume);
+      text.appendChild(detail);
+      row.appendChild(text);
+
+      const meter = document.createElement('div');
+      meter.className = 'aurade-device-meter';
+      const bar = document.createElement('div');
+      bar.className = 'aurade-device-bar';
+      const fill = document.createElement('div');
+      fill.className = 'aurade-device-fill';
+      bar.appendChild(fill);
+      const figure = document.createElement('div');
+      figure.className = 'aurade-device-figure';
+      meter.appendChild(bar);
+      meter.appendChild(figure);
+      row.appendChild(meter);
+
+      list.appendChild(row);
+      this.fill_(render, volume, fill, figure, meter);
+    }
+  }
+
+  /**
+   * Asks for one volume's capacity and fills its bar.
+   *
+   * A volume that cannot answer keeps its row and loses its bar. The row is
+   * still the useful part: the machine has that disk whether or not its size
+   * can be read, and dropping the row would make hardware disappear because a
+   * stat call failed.
+   */
+  private async fill_(
+      render: number, volume: Volume, fill: HTMLElement, figure: HTMLElement,
+      meter: HTMLElement) {
+    let stats;
+    try {
+      stats = await getSizeStats(volume.volumeId);
+    } catch (error) {
+      stats = undefined;
+    }
+    if (render !== this.render_) {
+      return;
+    }
+    if (!stats || !stats.totalSize) {
+      meter.hidden = true;
+      return;
+    }
+    const used = Math.max(0, stats.totalSize - stats.remainingSize);
+    const ratio = Math.min(1, Math.max(0, used / stats.totalSize));
+    fill.style.width = `${(ratio * 100).toFixed(1)}%`;
+    // Rounding a nearly full disk down to 99% would be a comforting lie, so
+    // the bar carries the proportion and the text carries the numbers.
+    figure.textContent =
+        `${bytesToString(used)} of ${bytesToString(stats.totalSize)}`;
+    meter.classList.toggle('aurade-device-low', ratio >= 0.9);
+  }
+}
