/*
 * Chrome OS typography styles for GM3.
 *
 * Generated by installer/tools/generate-theme.py. Do not edit by hand.
 *
 * The families are AuraDE's, which is the same face the installer is set
 * in. Upstream asks for Google Sans and falls through to Roboto, so a
 * machine walked through this product's installer signed into a desktop
 * set in a different typeface.
 *
 * The sizes and line heights are still ChromeOS's. The weights are not:
 * headings from 36px down through 18px are set at 600, which is the
 * difference between a heading and a big sentence. See CROS_TYPEFACES.
 */
{
  "options": {
    "CSS": {
      "prefix": "cros"
    }
  },
  "typography": {
    "font_families": {
      font_family_aurade_regular: "'Adwaita Sans', 'Cantarell', sans-serif",
      font_family_aurade_medium: "'Adwaita Sans', 'Cantarell', sans-serif",
      font_family_aurade_bold: "'Adwaita Sans', 'Cantarell', sans-serif",
      font_family_aurade_text_regular: "'Adwaita Sans', 'Cantarell', sans-serif",
      font_family_aurade_text_medium: "'Adwaita Sans', 'Cantarell', sans-serif",
      font_family_aurade_text_bold: "'Adwaita Sans', 'Cantarell', sans-serif",
      font_family_aurade_mono: "'JetBrains Mono', 'Adwaita Mono', monospace",
    },
    "font_faces": {
    },
    "typefaces": {
      "display_0": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 52,
        "font_weight": 500,
        "line_height": 60
      },
      "display_0-regular": {
        "font_family": '$font_family_aurade_regular',
        "font_size": 52,
        "font_weight": 400,
        "line_height": 60
      },
      "display_1": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 44,
        "font_weight": 500,
        "line_height": 52
      },
      "display_2": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 36,
        "font_weight": 600,
        "line_height": 44
      },
      "display_3": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 32,
        "font_weight": 600,
        "line_height": 40
      },
      "display_3-regular": {
        "font_family": '$font_family_aurade_regular',
        "font_size": 32,
        "font_weight": 400,
        "line_height": 40
      },
      "display_4": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 28,
        "font_weight": 600,
        "line_height": 36
      },
      "display_5": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 24,
        "font_weight": 600,
        "line_height": 32
      },
      "display_6": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 22,
        "font_weight": 600,
        "line_height": 28
      },
      "display_6-regular": {
        "font_family": '$font_family_aurade_regular',
        "font_size": 22,
        "font_weight": 400,
        "line_height": 28
      },
      "display_7": {
        "font_family": '$font_family_aurade_medium',
        "font_size": 18,
        "font_weight": 600,
        "line_height": 24
      },
      "title_1": {
        "font_family": '$font_family_aurade_text_medium',
        "font_size": 16,
        "font_weight": 500,
        "line_height": 24
      },
      "title_2": {
        "font_family": '$font_family_aurade_text_bold',
        "font_size": 13,
        "font_weight": 700,
