#!/usr/bin/env python3
"""Serves the local Glic page from /usr/share/aurade-ai/glic.

systemd hands it the listening socket (aurade-glic.socket). Only the files in
that directory are served, read only, to GET and HEAD.
"""
import http.server
import os
import secrets
import socket
import sys

ROOT = os.environ.get("AURADE_GLIC_ROOT", "/usr/share/aurade-ai/glic")
TYPES = {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".svg": "image/svg+xml",
}
# The page runs the Glic API Chrome sends it as a script of its own, which
# carries this response's nonce.
CSP = ("default-src 'none'; script-src 'self' 'nonce-{nonce}'; style-src 'self'; "
       "img-src 'self' data:; connect-src 'self'; base-uri 'none'; "
       "form-action 'none'; frame-ancestors 'none'")


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "aurade-glic"
    sys_version = ""

    def send_file(self, body_too):
        path = self.path.split("?", 1)[0].split("#", 1)[0]
        name = path.lstrip("/") or "index.html"
        kind = TYPES.get(os.path.splitext(name)[1])
        full = os.path.join(ROOT, name)
        if (kind is None or "/" in name or name.startswith(".")
                or not os.path.isfile(full)):
            self.send_error(404)
            return
        with open(full, "rb") as f:
            data = f.read()
        nonce = secrets.token_urlsafe(18)
        if name.endswith(".html"):
            data = data.replace(b"{{nonce}}", nonce.encode())
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Content-Security-Policy", CSP.format(nonce=nonce))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        if body_too:
            self.wfile.write(data)

    def do_GET(self):
        self.send_file(True)

    def do_HEAD(self):
        self.send_file(False)

    def log_message(self, fmt, *args):
        pass


def main():
    if os.environ.get("LISTEN_FDS") != "1":
        sys.exit("aurade-glic-server: start it through aurade-glic.socket")
    server = http.server.ThreadingHTTPServer(
        ("127.0.0.1", 0), Handler, bind_and_activate=False)
    server.socket.close()
    server.socket = socket.socket(fileno=3)
    server.daemon_threads = True
    server.serve_forever()


if __name__ == "__main__":
    main()
