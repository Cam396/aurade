+/* Android says it will not resize this task while it is full screen (the
+ * install prompt always is), so holding the asked size would only show its
+ * buffer stretched until the hold runs out. */
+static bool
+task_keeps_its_size(const struct wl_conn *conn)
+{
+    if (!conn || conn->is_ctl || !conn->task_id)
+        return false;
+    char value[PROPERTY_VALUE_MAX];
+    const std::string name = "waydroid.trs_no." + std::to_string(conn->task_id);
+    return property_get(name.c_str(), value, nullptr) > 0 && value[0] == '1';
+}
