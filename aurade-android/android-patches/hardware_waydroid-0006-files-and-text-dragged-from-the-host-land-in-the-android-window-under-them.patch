+/* The app whose window a host surface belongs to, or empty when that cannot
+ * be told from this thread. */
+std::string hwc_app_for_surface(struct wl_conn *conn, struct wl_surface *surface)
+{
+    struct display *display = conn->dpy;
+    if (!surface || !pthread_equal(pthread_self(), conn->wayland_thread) ||
+            display->windowsMutex.held_by_caller())
+        return "";
+    std::scoped_lock lock(display->windowsMutex);
+    struct window *window = window_for_surface(conn, surface);
+    return window ? window->appID : "";
+}
+
+/* Types Ctrl+V into Android, for the clipboard code to paste a dropped text
+ * with (AuraDE). The paste key on its own is ignored by text fields. */
+bool hwc_inject_paste(struct display *display)
+{
+    bool sent = send_key_event(display, KEY_LEFTCTRL, WL_KEYBOARD_KEY_STATE_PRESSED);
+    sent = send_key_event(display, KEY_V, WL_KEYBOARD_KEY_STATE_PRESSED) && sent;
+    sent = send_key_event(display, KEY_V, WL_KEYBOARD_KEY_STATE_RELEASED) && sent;
+    return send_key_event(display, KEY_LEFTCTRL, WL_KEYBOARD_KEY_STATE_RELEASED) && sent;
+}
