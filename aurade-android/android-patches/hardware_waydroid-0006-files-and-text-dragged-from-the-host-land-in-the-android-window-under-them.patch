+/* Something dragged from the host over an Android window (AuraDE). Text is
+ * pasted into the field that has focus, by putting it on the clipboard and
+ * typing the paste key. A list of files is announced in the log for the host
+ * service, which can reach the files; the container cannot. */
+static struct wl_data_offer *dnd_offer = nullptr;
+static std::string dnd_mime;
+static std::string dnd_app;
+
+static void dnd_forget() {
+    if (dnd_offer)
+        wl_data_offer_destroy(dnd_offer);
+    dnd_offer = nullptr;
+    dnd_mime.clear();
+    dnd_app.clear();
+}
+
+static void data_device_handle_enter(void *data, struct wl_data_device *, uint32_t serial, struct wl_surface *surface, wl_fixed_t, wl_fixed_t, struct wl_data_offer *offer) {
+    struct wl_conn *conn = (struct wl_conn *)data;
+    struct display *display = conn->dpy;
+    dnd_forget();
+    std::list<std::string> offered;
+    offered.swap(display->clipboard_offer_mime_types);
+    if (!offer)
+        return;
+    dnd_offer = offer;
+    dnd_app = hwc_app_for_surface(conn, surface);
+    std::string all;
+    for (auto &m : offered)
+        all += m + " ";
+    ALOGI("dnd: enter offering %s", all.c_str());
+    std::vector<std::string> wanted = {"application/x-arc-uri-list", "text/uri-list"};
+    wanted.insert(wanted.end(), MIME_TYPES.begin(), MIME_TYPES.end());
+    for (auto &w : wanted) {
+        if (std::find(offered.begin(), offered.end(), w) != offered.end()) {
+            dnd_mime = w;
+            break;
+        }
+    }
+    wl_data_offer_accept(offer, serial, dnd_mime.empty() ? nullptr : dnd_mime.c_str());
+    if (!dnd_mime.empty() && wl_data_offer_get_version(offer) >= 3)
+        wl_data_offer_set_actions(offer, WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY, WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);
+}
+
+static void data_device_handle_leave(void *, struct wl_data_device *) {
+    ALOGI("dnd: leave");
+    dnd_forget();
+}
