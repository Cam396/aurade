+
+static void data_device_handle_drop(void *data, struct wl_data_device *) {
+    struct wl_conn *conn = (struct wl_conn *)data;
+    struct display *display = conn->dpy;
+    /* The host's leave arrives while the data is being read, so the offer is
+     * taken out of the shared state first. */
+    struct wl_data_offer *offer = dnd_offer;
+    std::string mime = dnd_mime;
+    std::string app = dnd_app;
+    dnd_offer = nullptr;
+    dnd_mime.clear();
+    dnd_app.clear();
+    ALOGI("dnd: drop offer=%p mime=%s", (void *)offer, mime.c_str());
+    if (!offer)
+        return;
+    if (mime.empty()) {
+        wl_data_offer_destroy(offer);
+        return;
+    }
+    int fds[2];
+    if (pipe(fds) != 0) {
+        wl_data_offer_destroy(offer);
+        return;
+    }
+    wl_data_offer_receive(offer, mime.c_str(), fds[1]);
+    close(fds[1]);
+    wl_display_roundtrip(conn->display);
+    std::string contents;
+    while (true) {
+        char buf[1024];
+        ssize_t n = read(fds[0], buf, sizeof(buf));
+        if (n <= 0)
+            break;
+        contents.append(buf, n);
+    }
+    close(fds[0]);
+    if (wl_data_offer_get_version(offer) >= 3)
+        wl_data_offer_finish(offer);
+    wl_data_offer_destroy(offer);
+    if (contents.empty())
+        return;
+    bool arc_list = mime == "application/x-arc-uri-list";
+    if (arc_list) {
+        /* The host sends that kind of list as UTF-16. */
+        std::string narrow;
+        for (size_t i = 0; i + 1 < contents.size(); i += 2) {
+            unsigned c = (unsigned char)contents[i] | ((unsigned char)contents[i + 1] << 8);
+            if (c < 0x80) {
+                narrow += (char)c;
+            } else if (c < 0x800) {
+                narrow += (char)(0xC0 | (c >> 6));
+                narrow += (char)(0x80 | (c & 0x3F));
+            } else {
+                narrow += (char)(0xE0 | (c >> 12));
+                narrow += (char)(0x80 | ((c >> 6) & 0x3F));
+                narrow += (char)(0x80 | (c & 0x3F));
+            }
+        }
+        contents = narrow;
+    }
+    if (arc_list || mime == "text/uri-list") {
+        /* One line a service on the host reads out of the log. */
+        std::string line;
+        for (char c : contents)
+            line += (c == '\r' || c == '\n') ? ' ' : c;
+        __android_log_print(ANDROID_LOG_INFO, "AuraDEDnd", "files app=%s %s", app.c_str(), line.c_str());
+    } else {
+        display->clipboard = contents;
+        ALOGI("dnd: pasting %zu bytes of text", contents.size());
+        hwc_inject_paste(display);
+    }
+}
 
