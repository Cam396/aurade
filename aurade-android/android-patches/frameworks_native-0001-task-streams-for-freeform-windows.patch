+            const auto* snapshot = layerFE->mSnapshot.get();
+            if (!snapshot || !snapshot->hasBufferOrSidebandStream()) continue;
+            const std::string& n = snapshot->name;
+            if (n.rfind("Caption of", 0) == 0 || n.rfind("Decor container", 0) == 0 ||
+                n.find("InputSink") != std::string::npos) {
+                continue;
