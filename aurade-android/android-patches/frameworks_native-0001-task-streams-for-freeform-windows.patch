+
+bool hasNestedTask(const frontend::LayerHierarchy& node) {
+    bool found = false;
+    node.traverse([&](const frontend::LayerHierarchy& child,
+                      const frontend::LayerHierarchy::TraversalPath& path) {
+        if (&child == &node) {
+            return true;
+        }
+        if (found || path.variant == frontend::LayerHierarchy::Variant::Detached) {
+            return false;
+        }
+        if (child.getLayer()->metadata.has(gui::METADATA_TASK_ID)) {
+            found = true;
+            return false;
+        }
+        return true;
+    });
+    return found;
+}
