+            const FloatRect& b = snapshot->transformedBounds;
+            if (b.getWidth() <= 0 || b.getHeight() <= 0) continue;
+            if (!have) {
+                left = b.left; top = b.top; right = b.right; bottom = b.bottom;
+                have = true;
+            } else {
+                left = std::min(left, b.left); top = std::min(top, b.top);
