+
+    /* AuraDE: every Android window is a freeform task of its own, so each one
+     * keeps its own size while others are in front (persist.aurade.multiwin). */
+    private static boolean multiwin() {
+        return SystemProperties.getBoolean("persist.aurade.multiwin", false);
+    }
+
+    private static ActivityOptions freeformOptions() {
+        ActivityOptions o = ActivityOptions.makeBasic();
+        o.setLaunchWindowingMode(WindowConfiguration.WINDOWING_MODE_FREEFORM);
+        return o;
+    }
+
+    private int windowingModeOf(int taskId) {
+        try {
+            List<android.app.ActivityManager.RunningTaskInfo> tasks =
+                    ActivityTaskManager.getService().getTasks(MAX_SNAPSHOT_TASKS,
+                            false, false, android.view.Display.INVALID_DISPLAY);
+            for (android.app.ActivityManager.RunningTaskInfo t : tasks) {
+                if (t.taskId == taskId)
+                    return t.configuration.windowConfiguration.getWindowingMode();
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "windowingModeOf failed: " + e);
+        }
+        return WindowConfiguration.WINDOWING_MODE_UNDEFINED;
+    }
+
+    /* The host window layer asks for a task size by writing
+     * waydroid.trs.<task> = "<w>,<h>" and then bumping waydroid.trs_seq. The
+     * task's bounds carry any strip Android draws above the app, so it is
+     * measured from where the task's stream starts (waydroid.torg.<task>) and
+     * added. */
+    private String mLastTaskResizeSeq = "";
+    private boolean mTaskResizePending = false;
+    private final HashMap<Integer, String> mAppliedTaskResize = new HashMap<>();
+
+    private void registerTaskResizeMonitor() {
+        // A property set from native code reaches no change callback, so ask.
+        Runnable poll = new Runnable() {
+            @Override
+            public void run() {
+                applyTaskResize();
+                BackgroundThread.getHandler().postDelayed(this, 100);
+            }
+        };
+        BackgroundThread.getHandler().postDelayed(poll, 100);
+        // The big display would otherwise get a density of its own; every
+        // window should look the way it does on the density the host chose.
+        BackgroundThread.getHandler().postDelayed(() -> {
+            try {
+                int dpi = SystemProperties.getInt("ro.sf.lcd_density", 180);
+                android.view.WindowManagerGlobal.getWindowManagerService()
+                        .setForcedDisplayDensityForUser(android.view.Display.DEFAULT_DISPLAY, dpi,
+                                UserHandle.USER_SYSTEM);
+            } catch (Exception e) {
+                Log.w(TAG, "forcing the density failed: " + e);
+            }
+        }, multiwin() ? 4000 : Long.MAX_VALUE / 4);
+    }
+
+    private void applyTaskResize() {
+        if (!multiwin())
+            return;
+        String seq = SystemProperties.get("waydroid.trs_seq", "");
+        if (seq.isEmpty() || (seq.equals(mLastTaskResizeSeq) && !mTaskResizePending))
+            return;
+        mLastTaskResizeSeq = seq;
+        mTaskResizePending = false;
+        try {
+            List<android.app.ActivityManager.RunningTaskInfo> tasks =
+                    ActivityTaskManager.getService().getTasks(MAX_SNAPSHOT_TASKS,
+                            false, false, android.view.Display.INVALID_DISPLAY);
+            for (android.app.ActivityManager.RunningTaskInfo t : tasks) {
+                String req = SystemProperties.get("waydroid.trs." + t.taskId, "");
+                if (req.isEmpty() || req.equals(mAppliedTaskResize.get(t.taskId)))
+                    continue;
+                if (resizeOneTask(t.taskId, req))
+                    mAppliedTaskResize.put(t.taskId, req);
+                else
+                    mTaskResizePending = true;
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "task resize failed: " + e);
+        }
+    }
+
+    /* False when the task cannot take the size yet (it is still opening and
+     * is not freeform), so the request is kept and tried again. */
+    private boolean resizeOneTask(int taskId, String req) {
+        try {
+            if (windowingModeOf(taskId) != WindowConfiguration.WINDOWING_MODE_FREEFORM)
+                return false;
+            String[] f = req.split(",");
+            int w = Integer.parseInt(f[0]);
+            int h = Integer.parseInt(f[1]);
+            if (w < 64 || h < 64)
+                return true;
+            Rect cur = ActivityTaskManager.getService().getTaskBounds(taskId);
+            if (cur == null || cur.isEmpty())
+                return true;
+            int dx = 0, dy = 0;
+            String org = SystemProperties.get("waydroid.torg." + taskId, "");
+            if (!org.isEmpty()) {
+                String[] o = org.split(",");
+                dx = Integer.parseInt(o[0]) - cur.left;
+                dy = Integer.parseInt(o[1]) - cur.top;
+                if (dx < 0 || dx > 400) dx = 0;
+                if (dy < 0 || dy > 400) dy = 0;
+            }
+            Rect next = new Rect(cur.left, cur.top, cur.left + w + dx, cur.top + h + dy);
+            if (next.equals(cur))
+                return true;
+            ActivityTaskManager.getService().resizeTask(taskId, next,
+                    ActivityTaskManager.RESIZE_MODE_USER_FORCED);
+        } catch (Exception e) {
+            Log.w(TAG, "task " + taskId + " resize failed: " + e);
+        }
         return true;
     }
 
