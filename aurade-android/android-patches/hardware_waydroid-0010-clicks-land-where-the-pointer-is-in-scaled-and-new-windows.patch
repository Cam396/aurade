+/* AuraDE: a window can show its stream scaled: the host asked for a size
+ * and Android has not drawn at it yet, or never will, as with a dialog whose
+ * task cannot be resized. Input comes in window units; Android wants stream
+ * units, or a click lands beside what it was aimed at (outside a dialog, which
+ * then closes as if dismissed). */
+static void window_to_stream(struct wl_conn *conn, struct wl_surface *surface,
+                             int *x, int *y);
+
+/* AuraDE: the window keeps the size the host asked for until Android draws
+ * at it, for a few seconds at most, and that is checked when a frame arrives.
+ * A dialog that cannot be resized and does not redraw would stay stretched to
+ * the asked size, so the pointer coming over the window checks too. */
+static void release_expired_hold(struct wl_conn *conn, struct wl_surface *surface);
