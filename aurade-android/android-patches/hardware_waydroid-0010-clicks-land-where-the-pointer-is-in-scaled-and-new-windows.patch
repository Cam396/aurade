+static void
+window_to_stream(struct wl_conn *conn, struct wl_surface *surface, int *x, int *y)
+{
+    if (conn->is_ctl || !property_get_bool("persist.aurade.multiwin", false))
+        return;
+    std::scoped_lock lock(conn->dpy->windowsMutex);
+    struct window *w = window_for_surface(conn, surface);
+    if (!w || w->stream_w <= 0 || w->stream_h <= 0 || w->buf_w <= 0 || w->buf_h <= 0)
+        return;
+    if (w->stream_w != w->buf_w)
+        *x = int(int64_t(*x) * w->buf_w / w->stream_w);
+    if (w->stream_h != w->buf_h)
+        *y = int(int64_t(*y) * w->buf_h / w->stream_h);
+}
+
+static void
+release_expired_hold(struct wl_conn *conn, struct wl_surface *surface)
+{
+    if (conn->is_ctl || !property_get_bool("persist.aurade.multiwin", false))
+        return;
+    std::scoped_lock lock(conn->dpy->windowsMutex);
+    struct window *w = window_for_surface(conn, surface);
+    if (!w || w->cfg_w <= 0 || w->buf_w <= 0 || w->buf_h <= 0 || !w->viewport ||
+        std::chrono::steady_clock::now() <= w->cfg_until)
+        return;
+    w->cfg_w = w->cfg_h = 0;
+    if (w->stream_w == w->buf_w && w->stream_h == w->buf_h)
+        return;
+    w->stream_w = w->buf_w;
+    w->stream_h = w->buf_h;
+    wp_viewport_set_destination(w->viewport, w->buf_w, w->buf_h);
+    wl_surface_commit(w->surface);
+    wl_display_flush(conn->display);
+}
