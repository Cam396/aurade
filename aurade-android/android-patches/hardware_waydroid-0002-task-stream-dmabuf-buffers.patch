@@ -468,3 +473,24 @@ gralloc_handler::gralloc_handler(display *display)
     : get_buffer_metadata_impl(select_get_buffer_metadata_impl(display->gtype))
     , create_buffer_impl(select_create_buffer_impl(display->ctl.get(), display->gtype))
     , update_shm_buffer_impl(select_update_shm_buffer_impl(display->gtype)) { }
+
+std::unique_ptr<buffer> create_dmabuf_task_stream_buffer(wl_conn *conn, const buffer_metadata& metadata,
+                                                         buffer_handle_t handle, GrallocType gtype,
+                                                         const wl_buffer_listener *listener, void *listener_data) {
+    if (!conn->dmabuf) {
+        ALOGE("task stream buffer: the compositor has neither android_wlegl nor zwp_linux_dmabuf_v1");
+        return nullptr;
+    }
+    if (gtype == GrallocType::GRALLOC_GBM) {
+        auto *drm_handle = reinterpret_cast<const gralloc_handle_t *>(handle);
+        return create_dmabuf_wl_buffer(conn, metadata, drm_handle->prime_fd, -1, drm_handle->stride, 0,
+                                       drm_handle->modifier, handle, listener, listener_data);
+    }
+    if (gtype == GrallocType::GRALLOC_CROS) {
+        auto *cros_handle = reinterpret_cast<const cros_gralloc_handle *>(handle);
+        return create_dmabuf_wl_buffer(conn, metadata, cros_handle->fds[0], cros_handle->format,
+                                       cros_handle->strides[0], cros_handle->offsets[0],
+                                       cros_handle->format_modifier, handle, listener, listener_data);
+    }
+    return nullptr;
+}
