+// AuraDE: these sensors are virtual. Each reads its value from the property
+// aurade.sensor.<name> when that is set ("x,y,z" for a vector, one number
+// otherwise), so an app can be tested lying flat, turned, in the dark or with
+// something near; with it unset the sensor keeps the value below.
+static void overrideFrom(const char* name, float* values, size_t count) {
+    std::string raw = ::android::base::GetProperty(std::string("aurade.sensor.") + name, "");
+    if (raw.empty()) return;
+    std::vector<std::string> parts = ::android::base::Split(raw, ",");
+    if (parts.size() != count) return;
+    float parsed[3];
+    for (size_t i = 0; i < count; i++) {
+        char* end = nullptr;
+        parsed[i] = strtof(parts[i].c_str(), &end);
+        if (end == parts[i].c_str() || !std::isfinite(parsed[i])) return;
+    }
+    for (size_t i = 0; i < count; i++) values[i] = parsed[i];
+}
+
+static void setVec3(Event::EventPayload& payload, const char* name, float x, float y, float z) {
+    float v[3] = {x, y, z};
+    overrideFrom(name, v, 3);
+    Event::EventPayload::Vec3 vec3 = {
+            .x = v[0],
+            .y = v[1],
+            .z = v[2],
+            .status = SensorStatus::ACCURACY_HIGH,
+    };
+    payload.set<Event::EventPayload::Tag::vec3>(vec3);
+}
+
+static void setScalar(Event::EventPayload& payload, const char* name, float value) {
+    overrideFrom(name, &value, 1);
+    payload.set<Event::EventPayload::Tag::scalar>(value);
+}
