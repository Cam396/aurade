+/* A drag configures a window many times a second; Android is asked once the
+ * size has stood still for the settle time. One worker serves every window. */
+namespace {
+struct pending_task_resize { int w, h; std::chrono::steady_clock::time_point at; int asked_w, asked_h; };
+std::mutex g_resize_mutex;
+std::map<std::string, pending_task_resize> g_resize_pending;
+std::atomic<int> g_resize_seq {0};
+bool g_resize_worker_started = false;
+
+void resize_worker_main()
+{
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        std::vector<std::pair<std::string, std::pair<int, int>>> due;
+        {
+            std::scoped_lock lock(g_resize_mutex);
+            const auto now = std::chrono::steady_clock::now();
+            for (auto &[tid, p] : g_resize_pending) {
+                if (now < p.at || (p.w == p.asked_w && p.h == p.asked_h))
+                    continue;
+                p.asked_w = p.w;
+                p.asked_h = p.h;
+                due.push_back({tid, {p.w, p.h}});
+            }
+        }
+        for (auto &d : due) {
+            const std::string value = std::to_string(d.second.first) + "," +
+                                      std::to_string(d.second.second);
+            property_set(("waydroid.trs." + d.first).c_str(), value.c_str());
+            ALOGI("task %s: asked Android for %dx%d", d.first.c_str(), d.second.first, d.second.second);
+        }
+        if (!due.empty())
+            property_set("waydroid.trs_seq", std::to_string(++g_resize_seq).c_str());
+    }
+}
+} // namespace
+
+static void
+request_task_resize(const std::string &taskID, int width, int height)
+{
+    const auto settle = std::chrono::milliseconds(std::max(0, property_get_int32(
+        "persist.waydroid.resize_settle_ms", kResizeSettleDefaultMs)));
+    std::scoped_lock lock(g_resize_mutex);
+    auto &p = g_resize_pending[taskID];
+    if (p.w != width || p.h != height) {
+        p.w = width;
+        p.h = height;
+        p.at = std::chrono::steady_clock::now() + settle;
+    }
+    if (!g_resize_worker_started) {
+        g_resize_worker_started = true;
+        std::thread(resize_worker_main).detach();
+    }
+}
