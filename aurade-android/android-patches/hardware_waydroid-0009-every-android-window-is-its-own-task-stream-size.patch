 /* Attach a task-stream buffer that was stashed while the window could not
  * take it (initial configure not acked yet, or card deactivated). Runs on the
  * wayland thread. */
+/* A task stream is the size of its task, not of the display: with several
+ * freeform tasks each card shows its own buffer at that buffer's size. Under
+ * the older single display mode the two are the same. */
+static void
+set_stream_destination(struct display *display, struct window *window,
+                       struct wp_viewport *viewport,
+                       const std::shared_ptr<buffer> &buf)
+{
+    if (buf && buf->metadata.width && buf->metadata.height &&
+        property_get_bool("persist.aurade.multiwin", false)) {
+        const double scale = display->scale > 0 ? display->scale : 1.0;
+        const int w = int(buf->metadata.width / scale);
+        const int h = int(buf->metadata.height / scale);
+        if (window->viewport && (w != window->stream_w || h != window->stream_h)) {
+            /* The window is as big as its root surface: follow the stream, not
+             * the display, or every card opens display wide. */
+            wp_viewport_set_destination(window->viewport, w, h);
+            wl_surface_commit(window->surface);
+        }
+        window->stream_w = w;
+        window->stream_h = h;
+        wp_viewport_set_destination(viewport, w, h);
+        return;
+    }
+    wp_viewport_set_destination(viewport, display->width, display->height);
+}
