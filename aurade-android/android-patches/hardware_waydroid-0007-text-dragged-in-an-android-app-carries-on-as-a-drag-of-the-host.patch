+/* A drag of the host ends with the drop being finished or the drag being
+ * cancelled, and either way the source is done with. */
+static void drag_source_handle_send(void *data, struct wl_data_source *source, const char *mime_type, int fd) {
+    ALOGI("dnd: the host asked for the dragged text as %s", mime_type);
+    data_source_handle_send(data, source, mime_type, fd);
+}
+
+static void drag_source_handle_cancelled(void *data, struct wl_data_source *source) {
+    ALOGI("dnd: the host cancelled the drag");
+    data_source_handle_cancelled(data, source);
+}
+
+static void drag_source_handle_dnd_drop_performed(void *, struct wl_data_source *) {
+    ALOGI("dnd: the drag was dropped");
+}
+
+static void drag_source_handle_dnd_finished(void *data, struct wl_data_source *source) {
+    ALOGI("dnd: the drop was finished");
+    data_source_handle_cancelled(data, source);
+}
