+bool clipboard_start_drag(struct wl_conn *conn)
+{
+    struct display *display = conn->dpy;
+    if (!conn->data_device || !conn->data_device_manager || !conn->pointer_surface)
+        return false;
+    struct wl_data_source *source = wl_data_device_manager_create_data_source(conn->data_device_manager);
+    wl_data_source_add_listener(source, &drag_source_listener, strdup(display->drag_text.c_str()));
+    for (auto mime_type : MIME_TYPES)
+        wl_data_source_offer(source, mime_type.c_str());
+    if (wl_data_source_get_version(source) >= 3)
+        wl_data_source_set_actions(source, WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);
+    wl_data_device_start_drag(conn->data_device, source, conn->pointer_surface, nullptr, conn->pointer_button_serial);
+    wl_display_flush(conn->display);
+    return true;
+}
