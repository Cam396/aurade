+/* An Android app began dragging text. If the pointer then leaves the Android
+ * display, the drag carries on as a drag of the host, which is what lets the
+ * text be dropped on a desktop window (AuraDE). */
+Return<void> WaydroidClipboard::startDrag(const hidl_string& in) {
+    std::scoped_lock lock(mDisplay->windowsMutex);
+    mDisplay->drag_text = in;
+    mDisplay->drag_armed = !mDisplay->drag_text.empty();
+    return Void();
+}
