package() {
  install -Dm755 aurade-android "${pkgdir}/usr/lib/aurade-android/aurade-android"
  install -Dm755 aurade-android-loop "${pkgdir}/usr/lib/aurade-android/aurade-android-loop"
  install -Dm755 aurade-android-patch-waydroid \
    "${pkgdir}/usr/lib/aurade-android/aurade-android-patch-waydroid"
  install -Dm755 aurade-apk-check "${pkgdir}/usr/bin/aurade-apk-check"
  install -Dm644 aurade-android.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-android.service"
  install -Dm644 aurade-android-loop.conf \
    "${pkgdir}/usr/lib/systemd/system/waydroid-container.service.d/aurade-android-loop.conf"
  install -Dm644 aurade-android.sysusers "${pkgdir}/usr/lib/sysusers.d/aurade-android.conf"
  install -Dm644 aurade-android-waydroid.hook \
    "${pkgdir}/usr/share/libalpm/hooks/aurade-android-waydroid.hook"
  install -Dm644 org.aurade.Android1.conf \
    "${pkgdir}/usr/share/dbus-1/system.d/org.aurade.Android1.conf"
  install -Dm644 org.aurade.Android1.service \
    "${pkgdir}/usr/share/dbus-1/system-services/org.aurade.Android1.service"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
