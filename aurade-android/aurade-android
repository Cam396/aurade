#!/usr/bin/env python3
"""The AuraDE Android service: starts and stops the Android container for Ash.

Ash (the AuraDE desktop) asks for Android over the system bus. This service
is the part that has root, so Ash does not need it:

  org.aurade.Android1 at /org/aurade/Android1
    Start(s locale)   brings up the container and the user's Android session
    Stop()            stops them
    signal Stopped()  the session ended, whoever ended it
    ListApps()        a(sssb) of (label, package, activity, is_system) for launchable apps
    GetIcon(s pkg)    ay, the app's PNG icon ("" bytes when unknown)
    Launch(s pkg, s activity)   opens the app in its own window
    Uninstall(s pkg)  removes an app
    CloseTask(i id)   closes one window
    Provision()       downloads and checks the Android image, then sets Waydroid up
    Status()          s: "absent", "provisioning" or "ready"
    signal Progress(s stage, i percent)   while Provision runs
    signal AppsChanged()                the app list changed
    signal TaskCreated(i id, s pkg, s activity) and TaskDestroyed(i id)

It runs on the same machine as Ash and trusts only a caller that is a real
user with a running login session. The Android session itself runs as that
user, under its own session bus, because Waydroid's tools speak D-Bus
to each other and Ash's private bus is not shared.
"""
import hashlib
import json
import os
import pwd
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

NAME = "org.aurade.Android1"
PATH = "/org/aurade/Android1"
CONTAINER_UNIT = "waydroid-container.service"
LXC = ["lxc-attach", "-P", "/var/lib/waydroid/lxc", "-n", "waydroid", "--clear-env", "--"]
LXC_PATH = ["/var/lib/waydroid/lxc"]


def log(msg):
    print(f"aurade-android: {msg}", file=sys.stderr, flush=True)


class Android(dbus.service.Object):
    def __init__(self, bus, loop):
        super().__init__(bus, PATH)
        self.bus = bus
        self.loop = loop
        self.session = None  # (uid, Popen)
        self.waiting = []  # Start calls waiting for a download already running
        self.logcat = None

    def caller_uid(self, sender):
        proxy = self.bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus")
        return int(proxy.GetConnectionUnixUser(sender, dbus_interface="org.freedesktop.DBus"))

    def check_caller(self, sender):
        uid = self.caller_uid(sender)
        if uid < 1000 or not os.path.isdir(f"/run/user/{uid}"):
            raise dbus.exceptions.DBusException(
                "org.aurade.Android1.NotAllowed",
                "only a logged-in user can start Android")
        return uid

    @dbus.service.method(NAME, in_signature="s", out_signature="", sender_keyword="sender",
                         async_callbacks=("ok", "fail"))
    def Start(self, locale, ok, fail, sender=None):
        try:
            uid = self.check_caller(sender)
        except dbus.exceptions.DBusException as e:
            fail(e)
            return
        if self.session and self.session[1].poll() is None:
            ok()
            return
        if self.image_ready():
            self.do_start(uid, locale, ok, fail)
            return
        # Turning Android on for the first time: fetch the image, then start.
        if not os.path.exists(MANIFEST):
            fail(dbus.exceptions.DBusException(
                "org.aurade.Android1.NoImage", "no Android image is available"))
            return

        def after(good):
            if good:
                self.do_start(uid, locale, ok, fail)
            else:
                fail(dbus.exceptions.DBusException(
                    "org.aurade.Android1.Failed", "the Android image could not be downloaded"))

        if not getattr(self, "provisioning", False):
            self.provisioning = True
            threading.Thread(target=self.provision_worker, args=(after,), daemon=True).start()
        else:
            self.waiting.append(after)

    def do_start(self, uid, locale, ok, fail):
        try:
            ensure_props()
            subprocess.run(["systemctl", "start", CONTAINER_UNIT], check=True, timeout=60)
            user = pwd.getpwuid(uid).pw_name
            env = {
                "XDG_RUNTIME_DIR": f"/run/user/{uid}",
                "WAYLAND_DISPLAY": "wayland-0",
                "HOME": pwd.getpwuid(uid).pw_dir,
                "PATH": "/usr/local/bin:/usr/bin",
            }
            if locale:
                env["LANG"] = locale
            bus = session_bus(uid)
            if bus:
                env["DBUS_SESSION_BUS_ADDRESS"] = bus
                tail = ["waydroid", "session", "start"]
            else:
                tail = ["dbus-run-session", "--", "waydroid", "session", "start"]
            cmd = ["runuser", "-u", user, "--", "env"] + [f"{k}={v}" for k, v in env.items()] + tail
            proc = subprocess.Popen(cmd)
        except Exception as e:  # noqa: BLE001
            log(f"start failed: {e}")
            fail(dbus.exceptions.DBusException("org.aurade.Android1.Failed", str(e)))
            return
        self.session = (uid, proc)
        GLib.child_watch_add(proc.pid, self.on_exit)
        self.start_watchers(uid)
        threading.Thread(target=self.grant_when_ready, args=(uid,), daemon=True).start()
        ok()

    def on_exit(self, pid, status):
        log(f"session {pid} ended with status {status}")
        self.session = None
        self.stop_watchers()
        self.Stopped()

    @dbus.service.method(NAME, in_signature="", out_signature="", sender_keyword="sender")
    def Stop(self, sender=None):
        self.check_caller(sender)
        if self.session and self.session[1].poll() is None:
            self.session[1].send_signal(signal.SIGTERM)
        subprocess.run(["systemctl", "stop", CONTAINER_UNIT], timeout=60, check=False)

    @dbus.service.signal(NAME, signature="")
    def Stopped(self):
        pass

    # ---- the Android image ------------------------------------------------
    #
    # The image is about 1 GB, so it is not in the package: it is fetched and
    # checked when the user turns Android on. The manifest names where from and
    # the sha256 each file must have; a file that does not match is discarded.

    def image_ready(self):
        return all(os.path.exists(os.path.join(IMAGE_DIR, n)) for n in ("system.img", "vendor.img")) \
            and os.path.exists(WAYDROID_CFG)

    @dbus.service.method(NAME, in_signature="", out_signature="s", sender_keyword="sender")
    def Status(self, sender=None):
        self.check_caller(sender)
        if getattr(self, "provisioning", False):
            return "provisioning"
        return "ready" if self.image_ready() else "absent"

    @dbus.service.signal(NAME, signature="si")
    def Progress(self, stage, percent):
        pass

    @dbus.service.method(NAME, in_signature="", out_signature="", sender_keyword="sender")
    def Provision(self, sender=None):
        self.check_caller(sender)
        if getattr(self, "provisioning", False) or self.image_ready():
            return
        self.provisioning = True
        threading.Thread(target=self.provision_worker, daemon=True).start()

    @dbus.service.method(NAME, in_signature="", out_signature="", sender_keyword="sender")
    def Update(self, sender=None):
        """Fetches the images the manifest names when they differ from the
        installed ones. Android is stopped first; the user's apps and data stay."""
        self.check_caller(sender)
        if getattr(self, "provisioning", False):
            return
        if self.session and self.session[1].poll() is None:
            self.session[1].send_signal(signal.SIGTERM)
        subprocess.run(["systemctl", "stop", CONTAINER_UNIT], timeout=60, check=False)
        self.provisioning = True
        threading.Thread(target=self.provision_worker, daemon=True).start()

    def emit(self, stage, percent):
        GLib.idle_add(lambda: (self.Progress(stage, percent), False)[1])

    def provision_worker(self, after=None):
        good = False
        try:
            with open(MANIFEST, encoding="utf-8") as f:
                man = json.load(f)
            base = man["base_url"].rstrip("/") + "/"
            files = man["files"]
            os.makedirs(IMAGE_DIR, exist_ok=True)
            total = sum(int(x["size"]) for x in files)
            done_before = 0
            for item in files:
                name, want, size = item["name"], item["sha256"], int(item["size"])
                if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
                    raise ValueError(f"bad file name {name!r}")
                final = os.path.join(IMAGE_DIR, name)
                part = final + ".part"
                if os.path.exists(final) and self.sha256_of(final) == want:
                    done_before += size
                    continue
                have = os.path.getsize(part) if os.path.exists(part) else 0
                req = urllib.request.Request(base + name)
                if have:
                    req.add_header("Range", f"bytes={have}-")
                with urllib.request.urlopen(req, timeout=60) as resp:
                    if have and resp.status != 206:
                        have = 0
                    with open(part, "ab" if have else "wb") as out:
                        got = have
                        while True:
                            chunk = resp.read(1 << 20)
                            if not chunk:
                                break
                            out.write(chunk)
                            got += len(chunk)
                            self.emit("download", int((done_before + got) * 90 / max(total, 1)))
                self.emit("verify", 90)
                if self.sha256_of(part) != want:
                    os.unlink(part)
                    raise ValueError(f"{name} does not match its checksum")
                os.replace(part, final)
                done_before += size
            self.emit("setup", 95)
            with open(INSTALLED, "w", encoding="utf-8") as f:
                json.dump({"version": man.get("version", ""),
                           "files": {x["name"]: x["sha256"] for x in files}}, f)
            subprocess.run(["waydroid", "init", "-f"], check=True, timeout=300,
                           capture_output=True)
            ensure_props()
            self.emit("done", 100)
            good = True
        except Exception as e:  # noqa: BLE001
            log(f"provisioning failed: {e}")
            self.emit("failed", 0)
        finally:
            self.provisioning = False
            waiting, self.waiting = self.waiting, []
            for cb in ([after] if after else []) + waiting:
                GLib.idle_add(lambda cb=cb: (cb(good), False)[1])

    @staticmethod
    def sha256_of(path):
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(1 << 20), b""):
                h.update(block)
        return h.hexdigest()

    # ---- what the Settings page shows ----------------------------------------

    @staticmethod
    def tree_bytes(path):
        total = 0
        for base, dirs, names in os.walk(path, followlinks=False):
            for n in names:
                try:
                    total += os.lstat(os.path.join(base, n)).st_size
                except OSError:
                    pass
        return total

    @dbus.service.method(NAME, in_signature="", out_signature="s", sender_keyword="sender")
    def Info(self, sender=None):
        """One JSON object: whether Android is installed, running, how much disk
        it uses, which image is installed and whether the manifest has a newer
        one. The Settings page reads this and nothing else."""
        uid = self.check_caller(sender)
        home = pwd.getpwuid(uid).pw_dir
        installed, wanted = {}, {}
        version = ""
        try:
            with open(INSTALLED, encoding="utf-8") as f:
                rec = json.load(f)
            installed, version = rec.get("files", {}), rec.get("version", "")
        except (OSError, ValueError):
            pass
        have_manifest = False
        try:
            with open(MANIFEST, encoding="utf-8") as f:
                man = json.load(f)
            have_manifest = True
            wanted = {x["name"]: x["sha256"] for x in man["files"]}
            new_version = man.get("version", "")
        except (OSError, ValueError, KeyError):
            new_version = ""
        ready = self.image_ready()
        image_bytes = sum(os.path.getsize(os.path.join(IMAGE_DIR, n))
                          for n in ("system.img", "vendor.img")
                          if os.path.exists(os.path.join(IMAGE_DIR, n)))
        data_bytes = self.tree_bytes(os.path.join(home, ".local/share/waydroid/data"))
        data_bytes += self.tree_bytes("/var/lib/waydroid/overlay_rw")
        st = os.statvfs(os.path.dirname(IMAGE_DIR))
        running = subprocess.run(["systemctl", "is-active", "--quiet", CONTAINER_UNIT],
                                 check=False).returncode == 0
        return json.dumps({
            "state": "provisioning" if getattr(self, "provisioning", False)
                     else ("ready" if ready else "absent"),
            "running": running and bool(self.session and self.session[1].poll() is None),
            "imageBytes": image_bytes,
            "dataBytes": data_bytes,
            "freeBytes": st.f_bavail * st.f_frsize,
            "version": version,
            "newVersion": new_version,
            "updateAvailable": bool(ready and installed and wanted and wanted != installed),
            "canDownload": have_manifest,
        })

    @dbus.service.method(NAME, in_signature="", out_signature="", sender_keyword="sender")
    def Remove(self, sender=None):
        """Takes Android off the computer: stops it, deletes the image, the
        system's overlay and this user's Android data. Apps and their data are
        gone; nothing outside Android's own folders is touched."""
        uid = self.check_caller(sender)
        home = pwd.getpwuid(uid).pw_dir
        if self.session and self.session[1].poll() is None:
            self.session[1].send_signal(signal.SIGTERM)
        subprocess.run(["systemctl", "stop", CONTAINER_UNIT], timeout=60, check=False)
        for name in ("system.img", "vendor.img", "installed.json"):
            self.unlink_quiet(os.path.join(IMAGE_DIR, name))
        for d in ("overlay_rw", "overlay_work", "cache_http"):
            shutil.rmtree(os.path.join("/var/lib/waydroid", d), ignore_errors=True)
        for f in (WAYDROID_CFG, "/var/lib/waydroid/waydroid.prop"):
            self.unlink_quiet(f)
        shutil.rmtree(os.path.join(home, ".local/share/waydroid/data"), ignore_errors=True)
        appdir = os.path.join(home, ".local/share/applications")
        try:
            for n in os.listdir(appdir):
                if n.startswith("waydroid."):
                    self.unlink_quiet(os.path.join(appdir, n))
        except OSError:
            pass
        self.AppsChanged()

    @staticmethod
    def unlink_quiet(path):
        try:
            os.unlink(path)
        except OSError:
            pass

    # ---- apps -----------------------------------------------------------

    def guest(self, *args, timeout=20):
        """Runs a command inside the container; the container freezes when no
        window is open, so it is thawed first."""
        subprocess.run(["lxc-unfreeze", "-P", LXC_PATH[0], "-n", "waydroid"],
                       capture_output=True, timeout=10, check=False)
        return subprocess.run(LXC + list(args), capture_output=True, text=True,
                              timeout=timeout, check=False)

    @staticmethod
    def full_activity(pkg, act):
        if act.startswith("."):
            return pkg + act
        if "." not in act:
            return pkg + "." + act
        return act

    def read_apps(self, uid):
        home = pwd.getpwuid(uid).pw_dir
        labels = {}
        appdir = os.path.join(home, ".local/share/applications")
        try:
            names = os.listdir(appdir)
        except OSError:
            names = []
        for n in names:
            if not (n.startswith("waydroid.") and n.endswith(".desktop")):
                continue
            pkg = n[len("waydroid."):-len(".desktop")]
            try:
                for line in open(os.path.join(appdir, n), encoding="utf-8"):
                    if line.startswith("Name="):
                        labels[pkg] = line[5:].strip()
                        break
            except OSError:
                pass
        # waydroid's own list knows every app's label, and asking for it also
        # makes the guest write any icon that is missing.
        bus = session_bus(uid)
        if bus:
            try:
                res = subprocess.run(
                    ["runuser", "-u", pwd.getpwuid(uid).pw_name, "--", "env",
                     f"XDG_RUNTIME_DIR=/run/user/{uid}", f"DBUS_SESSION_BUS_ADDRESS={bus}",
                     f"HOME={home}", "PATH=/usr/local/bin:/usr/bin", "waydroid", "app", "list"],
                    capture_output=True, text=True, timeout=20, check=False)
                name = None
                for line in res.stdout.splitlines():
                    if line.startswith("Name: "):
                        name = line[6:].strip()
                    elif line.startswith("packageName: ") and name is not None:
                        labels[line[13:].strip()] = name
                        name = None
            except (OSError, subprocess.TimeoutExpired) as e:
                log(f"waydroid app list failed: {e}")
        out = []
        res = self.guest("/system/bin/pm", "query-activities", "--components",
                         "-a", "android.intent.action.MAIN",
                         "-c", "android.intent.category.LAUNCHER")
        sysres = self.guest("/system/bin/pm", "list", "packages", "-s")
        system = {l.split(":", 1)[1].strip() for l in sysres.stdout.splitlines() if l.startswith("package:")}
        seen = set()
        # A stable order, so a package with several launcher entries (an
        # icon alias, for one) is always listed under the same activity.
        for line in sorted(l.strip() for l in res.stdout.splitlines()):
            line = line.strip()
            if "/" not in line:
                continue
            pkg, act = line.split("/", 1)
            if pkg in seen:
                continue
            seen.add(pkg)
            out.append((labels.get(pkg, pkg), pkg, self.full_activity(pkg, act), pkg in system))
        return out

    @dbus.service.method(NAME, in_signature="", out_signature="a(sssb)", sender_keyword="sender")
    def ListApps(self, sender=None):
        uid = self.check_caller(sender)
        return dbus.Array([dbus.Struct((a[0], a[1], a[2], dbus.Boolean(a[3])), signature="sssb")
                           for a in self.read_apps(uid)], signature="(sssb)")

    @dbus.service.method(NAME, in_signature="s", out_signature="ay", sender_keyword="sender")
    def GetIcon(self, pkg, sender=None):
        uid = self.check_caller(sender)
        if not re.fullmatch(r"[A-Za-z0-9_.]+", pkg):
            return dbus.Array([], signature="y")
        path = os.path.join(pwd.getpwuid(uid).pw_dir, ".local/share/waydroid/data/icons", pkg + ".png")
        try:
            with open(path, "rb") as f:
                return dbus.Array(f.read(), signature="y")
        except OSError:
            return dbus.Array([], signature="y")

    @dbus.service.method(NAME, in_signature="ss", out_signature="", sender_keyword="sender")
    def Launch(self, pkg, activity, sender=None):
        uid = self.check_caller(sender)
        if not re.fullmatch(r"[A-Za-z0-9_.]+", pkg) or not re.fullmatch(r"[A-Za-z0-9_.$]*", activity):
            raise dbus.exceptions.DBusException("org.aurade.Android1.Failed", "bad name")
        # waydroid's own launch sets the active-app property the window layer
        # keys on, so it is preferred when the user's session bus is there.
        bus = session_bus(uid)
        if bus:
            user = pwd.getpwuid(uid).pw_name
            env = ["XDG_RUNTIME_DIR=" + f"/run/user/{uid}", "WAYLAND_DISPLAY=wayland-0",
                   "DBUS_SESSION_BUS_ADDRESS=" + bus, "HOME=" + pwd.getpwuid(uid).pw_dir,
                   "PATH=/usr/local/bin:/usr/bin"]
            subprocess.run(["lxc-unfreeze", "-P", LXC_PATH[0], "-n", "waydroid"],
                           capture_output=True, timeout=10, check=False)
            subprocess.run(["runuser", "-u", user, "--", "env"] + env + ["waydroid", "app", "launch", pkg],
                           capture_output=True, timeout=30, check=False)
            return
        if not activity:
            res = self.guest("/system/bin/cmd", "package", "resolve-activity", "--brief",
                             "-c", "android.intent.category.LAUNCHER", pkg)
            lines = [l for l in res.stdout.splitlines() if "/" in l]
            if not lines:
                raise dbus.exceptions.DBusException("org.aurade.Android1.Failed", "no launcher activity")
            comp = lines[-1].strip()
        else:
            comp = f"{pkg}/{activity}"
        self.guest("/system/bin/am", "start", "-n", comp)

    def media_dir(self, uid):
        return os.path.join(pwd.getpwuid(uid).pw_dir, ".local/share/waydroid/data/media")

    def grant_storage(self, uid):
        """Let the user read and write Android's shared storage.

        The files belong to Android's own ids and the directory is closed to
        everyone else, so the host user could not see their own phone files.
        An ACL for that one user opens it without changing the owner Android
        sees, and the default ACL carries it to files Android makes later.
        """
        media = self.media_dir(uid)
        root = os.path.join(media, "0")
        if not os.path.isdir(root):
            return
        acl = f"u:{uid}:rwX"
        subprocess.run(["setfacl", "-m", f"u:{uid}:rx", media], timeout=20, check=False)
        subprocess.run(["setfacl", "-R", "-m", acl, root], timeout=600, check=False)
        subprocess.run(["setfacl", "-R", "-d", "-m", acl, root], timeout=600, check=False)

    def grant_when_ready(self, uid):
        # Android makes its storage a little after the container starts.
        for _ in range(120):
            if os.path.isdir(os.path.join(self.media_dir(uid), "0")):
                self.grant_storage(uid)
                return
            time.sleep(2)

    @dbus.service.method(NAME, in_signature="", out_signature="s", sender_keyword="sender")
    def StorageDir(self, sender=None):
        """Path of Android's shared storage, readable by the caller. Empty when
        Android has not made it yet."""
        uid = self.check_caller(sender)
        root = os.path.join(self.media_dir(uid), "0")
        if not os.path.isdir(root):
            return ""
        threading.Thread(target=self.grant_storage, args=(uid,), daemon=True).start()
        return root

    @dbus.service.method(NAME, in_signature="s", out_signature="", sender_keyword="sender")
    def Uninstall(self, pkg, sender=None):
        self.check_caller(sender)
        if not re.fullmatch(r"[A-Za-z0-9_.]+", pkg):
            raise dbus.exceptions.DBusException("org.aurade.Android1.Failed", "bad name")
        self.guest("/system/bin/pm", "uninstall", pkg, timeout=60)

    @dbus.service.method(NAME, in_signature="i", out_signature="", sender_keyword="sender")
    def CloseTask(self, task_id, sender=None):
        self.check_caller(sender)
        # `am` removes whole root tasks, so find the one holding this task.
        res = self.guest("/system/bin/am", "stack", "list")
        root = None
        for line in res.stdout.splitlines():
            m = re.match(r"RootTask id=(\d+)", line)
            if m:
                root = m.group(1)
                continue
            if root and re.match(rf"\s+taskId={int(task_id)}:", line):
                self.guest("/system/bin/am", "stack", "remove", root)
                return

    @dbus.service.signal(NAME, signature="")
    def AppsChanged(self):
        pass

    @dbus.service.signal(NAME, signature="iss")
    def TaskCreated(self, task_id, pkg, activity):
        pass

    @dbus.service.signal(NAME, signature="i")
    def TaskDestroyed(self, task_id):
        pass

    # ---- watchers: tasks from the guest log, app list by polling ----------

    def start_watchers(self, uid):
        self.stop_watchers()
        self.watch_uid = uid
        self.apps_seen = None
        self.log_buf = ""
        self.start_logcat()
        self.poll_src = GLib.timeout_add_seconds(5, self.poll_apps)

    def start_logcat(self):
        """The guest log carries the window layer's task events. The container
        may not be up yet right after Start, so this is retried from the poll."""
        self.drop_logcat()
        try:
            self.logcat = subprocess.Popen(
                LXC + ["/system/bin/logcat", "-v", "brief", "-T", "1", "WayDroidService:I", "*:S"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
        except OSError as e:
            log(f"logcat failed: {e}")
            self.logcat = None
            return
        os.set_blocking(self.logcat.stdout.fileno(), False)
        self.log_src = GLib.io_add_watch(self.logcat.stdout.fileno(), GLib.IO_IN | GLib.IO_HUP,
                                         self.on_log)

    def drop_logcat(self):
        src = getattr(self, "log_src", None)
        if src:
            GLib.source_remove(src)
            self.log_src = None
        lc = getattr(self, "logcat", None)
        if lc:
            if lc.poll() is None:
                lc.terminate()
            lc.wait()
        self.logcat = None

    def stop_watchers(self):
        src = getattr(self, "poll_src", None)
        if src:
            GLib.source_remove(src)
            self.poll_src = None
        self.drop_logcat()

    def on_log(self, fd, cond):
        try:
            data = os.read(fd, 65536).decode("utf-8", "replace")
        except (BlockingIOError, OSError):
            data = ""
        if not data:
            if cond & GLib.IO_HUP or not (self.logcat and self.logcat.poll() is None):
                self.log_src = None
                return False
            return True
        self.log_buf += data
        *lines, self.log_buf = self.log_buf.split("\n")
        for line in lines:
            m = re.search(r"taskCreated (\d+) (\S+)/(\S+)", line)
            if m:
                tid, pkg, act = int(m.group(1)), m.group(2), m.group(3)
                self.TaskCreated(tid, pkg, self.full_activity(pkg, act))
                continue
            m = re.search(r"taskRemoved (\d+)", line)
            if m:
                self.TaskDestroyed(int(m.group(1)))
        return True

    def poll_apps(self):
        if not (self.session and self.session[1].poll() is None):
            return True
        if self.logcat is None or self.logcat.poll() is not None or not getattr(self, "log_src", None):
            self.start_logcat()
        # One cheap guest command decides whether the real list is worth asking
        # for; the list itself starts several processes.
        try:
            res = self.guest("/system/bin/pm", "list", "packages", "--show-versioncode")
        except Exception as e:  # noqa: BLE001
            log(f"app poll failed: {e}")
            return True
        key = hash(res.stdout)
        if self.apps_seen is not None and key != self.apps_seen:
            self.AppsChanged()
        self.apps_seen = key
        return True


# Properties the window layer needs: per-app windows, one stream per task, and
# the window ids Ash's ARC code expects (org.chromium.arc.<task id>).
WAYDROID_PROPS = {
    "persist.waydroid.multi_windows": "true",
    "persist.waydroid.task_streams": "true",
    "persist.aurade.arc_app_ids": "1",
    "persist.waydroid.forward_notifications": "true",
}
WAYDROID_CFG = "/var/lib/waydroid/waydroid.cfg"
IMAGE_DIR = "/etc/waydroid-extra/images"
INSTALLED = os.path.join(IMAGE_DIR, "installed.json")
MANIFEST = os.environ.get("AURADE_ANDROID_MANIFEST", "/etc/aurade-android/images.json")


def ensure_props():
    import configparser
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    try:
        cfg.read(WAYDROID_CFG)
    except configparser.Error as e:
        log(f"cannot read {WAYDROID_CFG}: {e}")
        return
    if not cfg.has_section("properties"):
        cfg.add_section("properties")
    changed = False
    for k, v in WAYDROID_PROPS.items():
        if cfg.get("properties", k, fallback=None) != v:
            cfg.set("properties", k, v)
            changed = True
    if changed:
        with open(WAYDROID_CFG, "w", encoding="utf-8") as f:
            cfg.write(f)
        # Waydroid only folds the config into the Android property files when
        # it upgrades itself, so do that now, without touching the network.
        subprocess.run(["waydroid", "upgrade", "-o"], capture_output=True, timeout=120,
                       check=False)


def session_bus(uid):
    """The bus the user's desktop lives on. Ash and its notification server,
    portals and file manager are on the bus that dbus-run-session made for the
    compositor, not on the user's systemd bus, so Android's session talks
    there when it can; the systemd bus is the fallback."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/status", encoding="utf-8") as f:
                if f"Uid:\t{uid}\t" not in f.read():
                    continue
            with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                comm = f.read().strip()
            if comm != "weston":
                continue
            with open(f"/proc/{pid}/environ", "rb") as f:
                for kv in f.read().split(b"\0"):
                    if kv.startswith(b"DBUS_SESSION_BUS_ADDRESS="):
                        return kv.split(b"=", 1)[1].decode()
        except OSError:
            continue
    path = f"/run/user/{uid}/bus"
    return f"unix:path={path}" if os.path.exists(path) else None


def write_host_generated():
    """Ash reads the board name from here when it builds the default app list."""
    d = "/run/arc/host_generated"
    os.makedirs(d, mode=0o755, exist_ok=True)
    with open(os.path.join(d, "build.prop"), "w", encoding="utf-8") as f:
        f.write("ro.product.board=aurade\nro.product.device=aurade\n")
    os.chmod(os.path.join(d, "build.prop"), 0o644)


def main():
    write_host_generated()
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    bus_name = dbus.service.BusName(NAME, bus)  # kept alive: dropping it releases the name
    loop = GLib.MainLoop()
    Android(bus, loop).bus_name = bus_name
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, lambda *_: loop.quit())
    log("ready")
    loop.run()


if __name__ == "__main__":
    main()
