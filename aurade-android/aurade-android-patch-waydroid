#!/usr/bin/python3
"""Small fixes to Waydroid's host tools, applied once.

A Waydroid upgrade puts its stock files back and the pacman hook runs this
again. Each fix is skipped when it is already in, and says so on stderr when
the file it expects has changed so far that the fix no longer fits.
"""
import os
import sys

FIXES = [
    # Android 17 mounts its APEX files through loop devices.
    (
        "/usr/lib/waydroid/tools/helpers/lxc.py",
        "loop-control",
        '    make_entry("/dev/char", options="bind,create=dir,optional 0 0")\n',
        '''    make_entry("/dev/char", options="bind,create=dir,optional 0 0")

    # AuraDE: Android 17 mounts its APEX files through loop devices
    make_entry("/dev/loop-control")
    for i in range(128):
        make_entry("/dev/loop%d" % i, "dev/block/loop%d" % i)
''',
    ),
    # dbus-python cannot guess the type of an empty action list, so a
    # notification with no buttons was never shown.
    (
        "/usr/lib/waydroid/tools/services/notification_manager.py",
        'signature="s")',
        '        actions_flat = [s for action in actions for s in (action.id, action.label)]\n',
        '        actions_flat = dbus.Array([s for action in actions for s in (action.id, action.label)], signature="s")\n',
    ),
    # gbinder hands back None or bytes for empty or odd strings, which
    # dbus-python refuses ("Expected a string or unicode object").
    (
        "/usr/lib/waydroid/tools/services/notification_manager.py",
        "AuraDE: plain strings",
        '        app_icon = ""\n',
        '''        app_icon = ""
        # AuraDE: plain strings for D-Bus
        def _s(v):
            if isinstance(v, (bytes, bytearray)):
                return bytes(v).decode("utf-8", "replace")
            return "" if v is None else str(v)
        app_name, summary, body = _s(app_name), _s(summary), _s(body)
        package_name, category = _s(package_name), _s(category)
        replaces_id = dbus.UInt32(replaces_id or 0)
        expire_timeout = dbus.Int32(expire_timeout)
''',
    ),
    # With mixed value types dbus-python cannot guess the hints dictionary's
    # type and raises, so no Android notification ever reached the desktop.
    (
        "/usr/lib/waydroid/tools/services/notification_manager.py",
        'dbus.Dictionary(hints, signature="sv")',
        "actions_flat, hints, expire_timeout)",
        'actions_flat, dbus.Dictionary(hints, signature="sv"), expire_timeout)',
    ),
    # Swiping a notification away on the desktop dismisses it in Android too:
    # remember what each desktop notification was, and when the user closes
    # one leave a note for the bridge app's notification listener.
    (
        "/usr/lib/waydroid/tools/services/notification_manager.py",
        "AuraDE: sent notifications",
        '            return dbus_proxy.Notify(app_name, replaces_id, app_icon, summary, body, actions_flat, dbus.Dictionary(hints, signature="sv"), expire_timeout)\n',
        '''            # AuraDE: sent notifications
            nid = dbus_proxy.Notify(app_name, replaces_id, app_icon, summary, body, actions_flat, dbus.Dictionary(hints, signature="sv"), expire_timeout)
            sent[int(nid)] = (package_name, summary, body)
            return nid
''',
    ),
    (
        "/usr/lib/waydroid/tools/services/notification_manager.py",
        "AuraDE: closed on the desktop",
        '    bus_signals.append(dbus_proxy.connect_to_signal("ActionInvoked", onActionInvoked))\n',
        '''    bus_signals.append(dbus_proxy.connect_to_signal("ActionInvoked", onActionInvoked))

    # AuraDE: closed on the desktop
    sent = dict()

    def onNotificationClosed(notification_id, reason):
        info = sent.pop(int(notification_id), None)
        if info is None or int(reason) != 2:
            return
        import json, time
        base = os.path.expanduser("~/.local/share/waydroid/data/media/0/Android/data/org.aurade.bridge/files/cmd")
        try:
            os.makedirs(base, exist_ok=True)
            tmp = os.path.join(base, "%d.tmp" % time.time_ns())
            with open(tmp, "w") as f:
                json.dump({"type": "dismiss", "pkg": info[0], "title": info[1], "text": info[2]}, f)
            os.rename(tmp, tmp[:-4] + ".json")
        except OSError as e:
            logging.warning("could not tell Android about a dismissed notification: %s", e)
    bus_signals.append(dbus_proxy.connect_to_signal("NotificationClosed", onNotificationClosed))
''',
    ),
    # Waydroid shares the clipboard through the pyclip module, which Arch does
    # not ship. wl-clipboard is already a dependency and does the same job.
    (
        "/usr/lib/waydroid/tools/services/clipboard_manager.py",
        "AuraDE: wl-clipboard",
        "try:\n    import pyclip\n    canClip = True\n",
        '''# AuraDE: wl-clipboard
import subprocess


class _WlClip:
    def copy(self, value):
        if isinstance(value, bytes):
            value = value.decode("utf-8", "replace")
        subprocess.run(["wl-copy", "--", str(value)], timeout=5, check=False,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)

    def paste(self):
        res = subprocess.run(["wl-paste", "--no-newline"], timeout=5, check=False,
                             stdin=subprocess.DEVNULL, capture_output=True)
        return res.stdout.decode("utf-8", "replace")


try:
    try:
        import pyclip
    except ImportError:
        pyclip = _WlClip()
    canClip = True
''',
    ),
]

for path, marker, anchor, replacement in FIXES:
    if not os.path.exists(path):
        continue
    with open(path, encoding="utf-8") as f:
        src = f.read()
    if marker in src:
        continue
    if anchor not in src:
        print(f"aurade-android: {path} has changed, a fix was not applied", file=sys.stderr)
        continue
    with open(path, "w", encoding="utf-8") as f:
        f.write(src.replace(anchor, replacement, 1))
