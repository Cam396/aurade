pkgname=aurade-host-bridge
pkgver=0.1.0
pkgrel=2
pkgdesc="BlueZ, udisks2, pacman, and MIME integration bridge for AuraDE"
arch=('any')
url="https://github.com/aurade/aurade"
license=('BSD-3-Clause')
depends=(
  'bluez'
  'dbus'
  'glib2'
  'pacman'
  'pacman-contrib'
  'polkit'
  'python'
  'python-dbus'
  'python-gobject'
  'systemd'
  'udisks2'
)
optdepends=('xdg-utils: fallback MIME launcher when gio is unavailable')
source=(
  'aurade_host_bridge_core.py'
  'aurade_host_bridge.py'
  'aurade_desktop_bridge.py'
  'aurade_hostctl.py'
  'aurade-host-bridge.service'
  'org.aurade.HostBridge.service'
  'org.aurade.DesktopBridge.service'
  'org.aurade.HostBridge.conf'
  'org.aurade.host-bridge.policy'
  'README.md'
  'LICENSE'
  'test_core.py'
)
