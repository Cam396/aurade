check() {
  local module_dir="${srcdir}"
  PYTHONPATH="${module_dir}" python -m py_compile \
    aurade_host_bridge_core.py aurade_host_bridge.py \
    aurade_desktop_bridge.py aurade_hostctl.py
  PYTHONPATH="${module_dir}" python -c \
    'import aurade_host_bridge; assert aurade_host_bridge.OBJECT_MANAGER_INTERFACE == "org.freedesktop.DBus.ObjectManager"'
  PYTHONPATH="${module_dir}" python test_core.py
  PYTHONPATH="${module_dir}" python aurade_hostctl.py \
    --dry-run bluetooth pair AA:BB:CC:DD:EE:FF >/dev/null
  PYTHONPATH="${module_dir}" python aurade_hostctl.py \
    --dry-run pacman uninstall test-package >/dev/null
  env -u XDG_RUNTIME_DIR dbus-run-session -- bash -c '
    ./aurade_desktop_bridge.py >/tmp/aurade-desktop-bridge-check.log 2>&1 &
    service_pid=$!
    trap "kill ${service_pid} 2>/dev/null || true" EXIT
    sleep 0.5
    gdbus call --session --dest org.aurade.DesktopBridge \
      --object-path /org/aurade/DesktopBridge \
      --method org.aurade.DesktopBridge1.MimeOpen relative.txt
  ' | grep -q 'invalid_argument'
  env -u XDG_RUNTIME_DIR dbus-run-session -- bash -c '
    python -c "import dbus, aurade_host_bridge as bridge; bridge.dbus.SystemBus = dbus.SessionBus; raise SystemExit(bridge.main())" >/tmp/aurade-host-bridge-check.log 2>&1 &
    service_pid=$!
    trap "kill ${service_pid} 2>/dev/null || true" EXIT
    sleep 0.5
    gdbus call --session --dest org.aurade.HostBridge \
      --object-path /org/aurade/HostBridge \
      --method org.aurade.HostBridge1.GetCapabilities
  ' | grep -q '"operation":"capabilities"'
}

package() {
  local bridge_dir="${pkgdir}/usr/lib/aurade-host-bridge"
  install -Dm644 aurade_host_bridge_core.py \
    "${bridge_dir}/aurade_host_bridge_core.py"
  install -Dm755 aurade_host_bridge.py \
    "${bridge_dir}/aurade_host_bridge.py"
  install -Dm755 aurade_desktop_bridge.py \
    "${bridge_dir}/aurade_desktop_bridge.py"
  install -Dm755 aurade_hostctl.py \
    "${bridge_dir}/aurade_hostctl.py"

  install -d "${pkgdir}/usr/bin"
  ln -s ../lib/aurade-host-bridge/aurade_host_bridge.py \
    "${pkgdir}/usr/bin/aurade-host-bridge"
  ln -s ../lib/aurade-host-bridge/aurade_desktop_bridge.py \
    "${pkgdir}/usr/bin/aurade-desktop-bridge"
  ln -s ../lib/aurade-host-bridge/aurade_hostctl.py \
    "${pkgdir}/usr/bin/aurade-hostctl"

  install -Dm644 aurade-host-bridge.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-host-bridge.service"
  install -Dm644 org.aurade.HostBridge.service \
    "${pkgdir}/usr/share/dbus-1/system-services/org.aurade.HostBridge.service"
  install -Dm644 org.aurade.DesktopBridge.service \
    "${pkgdir}/usr/share/dbus-1/services/org.aurade.DesktopBridge.service"
  install -Dm644 org.aurade.HostBridge.conf \
    "${pkgdir}/usr/share/dbus-1/system.d/org.aurade.HostBridge.conf"
  install -Dm644 org.aurade.host-bridge.policy \
    "${pkgdir}/usr/share/polkit-1/actions/org.aurade.host-bridge.policy"
  install -Dm644 README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
