# Optional AuraDE Google API/OAuth configuration.
#
# The package includes a public fallback OAuth client for unbranded Chromium.
# This file documents the same variables without copying the fallback values.
# A per-user file at ~/.config/aurade/google-api.conf overrides the package
# defaults, and environment variables take precedence over both files.
#
# Chromium/Ash reads these environment variables at startup.

GOOGLE_API_KEY=
GOOGLE_DEFAULT_CLIENT_ID=
GOOGLE_DEFAULT_CLIENT_SECRET=

# Optional main-client-specific overrides. Leave blank unless a Google Cloud
# project explicitly issues separate main client credentials.
GOOGLE_CLIENT_ID_MAIN=
GOOGLE_CLIENT_SECRET_MAIN=
