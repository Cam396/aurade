    'chromiumos-ash-wayland.desktop'
    'aurade.features.conf'
    'google-api.conf.example'
    'test-google-api-config.sh'
    'aurade-session-manager-shim.py'
    'aurade-session-manager.service'
    'org.chromium.SessionManager.conf'
    'org.chromium.SessionManager.service'
    'chromiumos-ash.sysusers.conf'
    'chromiumos-ash.tmpfiles.conf'
    'LICENSE'
)
