check() {
    bash "${srcdir}/test-session-error.sh" "${srcdir}/aurade-session-error"
}

build() {
    # CHROME_SRC must point to a synced+patched ChromiumOS src dir
    local chrome_src="${CHROME_SRC:-${srcdir}/chromiumos-src}"
    local out_dir="${chrome_src}/out/Ash"

    if [ ! -d "${chrome_src}" ]; then
        echo "ERROR: CHROME_SRC not found at ${chrome_src}"
        echo "Run 'ci/bootstrap-chromium-src.sh --run' first."
        exit 1
    fi

    cd "${chrome_src}"

    if [ "${AURADE_SKIP_CHROMIUM_BUILD:-0}" = "1" ]; then
        if [ ! -x "${out_dir}/chrome" ] || [ ! -x "${out_dir}/chrome_sandbox" ]; then
            echo "ERROR: AURADE_SKIP_CHROMIUM_BUILD=1 but chrome artifacts are missing."
            echo "Expected ${out_dir}/chrome and ${out_dir}/chrome_sandbox."
            exit 1
        fi
        echo "Using existing ChromiumOS Ash build artifacts from ${out_dir}."
        return
    fi

    # Generate GN args
    gn gen "${out_dir}" --args="
        target_os = \"chromeos\"
        is_debug = false
        is_component_build = false
        is_official_build = false
        symbol_level = 0
        use_ozone = true
        ozone_platform_wayland = true
        use_system_minigbm = true
        enable_rust = true
    "

    # Build the chrome target and its setuid sandbox helper.
    ninja -C "${out_dir}" -j"$(nproc)" chrome chrome_sandbox
}

package() {
    local chrome_src="${CHROME_SRC:-${srcdir}/chromiumos-src}"
    local out_dir="${chrome_src}/out/Ash"
    local gn_bin="gn"
    local runtime_deps="${srcdir}/chromiumos-ash.runtime_deps"

    if [ -x "${chrome_src}/buildtools/linux64/gn" ]; then
        gn_bin="${chrome_src}/buildtools/linux64/gn"
    fi

    copy_runtime_dep() {
        local rel="${1#./}"
        local src
        local dest

        if [ -z "${rel}" ]; then
            return
        fi

        case "${rel}" in
            *.TOC|*.rsp|*.runtime_deps)
                return
                ;;
        esac

        src="${out_dir}/${rel}"
        dest="${pkgdir}/usr/lib/chromiumos-ash/${rel}"

        if [ ! -e "${src}" ]; then
            printf 'warning: runtime dependency not found: %s\n' "${rel}" >&2
            return
        fi

        if [ -d "${src}" ]; then
            mkdir -p "${dest}"
            cp -a "${src}/." "${dest}/"
        else
            install -Dm644 "${src}" "${dest}"
            if [ -x "${src}" ]; then
                chmod 755 "${dest}"
            fi
        fi
    }

    (
        cd "${chrome_src}"
        if ! "${gn_bin}" desc "${out_dir}" //chrome:chrome runtime_deps >"${runtime_deps}"; then
            cat >"${runtime_deps}" <<'EOF'
./chrome
./chrome_crashpad_handler
./chrome_sandbox
chrome_100_percent.pak
chrome_200_percent.pak
icudtl.dat
keyboard_resources.pak
resources.pak
snapshot_blob.bin
libEGL.so
libGLESv2.so
libvk_swiftshader.so
libvulkan.so.1
vk_swiftshader_icd.json
IwaKeyDistribution
MEIPreload
PrivacySandboxAttestationsPreloaded
dbus
locales
mojo_service_manager
resources
EOF
        fi
    )

    while IFS= read -r runtime_dep; do
        copy_runtime_dep "${runtime_dep}"
    done < <(sort -u "${runtime_deps}")

    # AuraDE compatibility: Chromium's ChromeOS accessibility extensions are
    # emitted as generated files under resources/.  GN runtime_deps currently
    # lists their manifests but not every extension payload, so copying only
    # runtime_deps leaves ChromeVox and Select-to-Speak unable to start.
    # Preserve the complete generated trees in the package.
    for resource_dir in \
        accessibility \
        chromeos/accessibility; do
        if [ -d "${out_dir}/resources/${resource_dir}" ]; then
            mkdir -p "${pkgdir}/usr/lib/chromiumos-ash/resources/${resource_dir}"
            cp -a "${out_dir}/resources/${resource_dir}/." \
                "${pkgdir}/usr/lib/chromiumos-ash/resources/${resource_dir}/"
        fi
    done

    if [ -e "${pkgdir}/usr/lib/chromiumos-ash/chrome_sandbox" ]; then
        mv "${pkgdir}/usr/lib/chromiumos-ash/chrome_sandbox" \
            "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox"
    fi

    chmod -R u+rwX,go+rX "${pkgdir}/usr/lib/chromiumos-ash"

    if [ -e "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox" ]; then
        chown root:root "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox"
        chmod 4755 "${pkgdir}/usr/lib/chromiumos-ash/chrome-sandbox"
    fi

    # AuraDE compatibility: a few ChromiumOS/Chrome paths still probe the
    # historical Google Chrome install prefix. Keep the real payload in
    # /usr/lib/chromiumos-ash and expose stable symlinks for those probes.
    install -dm755 "${pkgdir}/opt/google/chrome"
    for rel in \
        chrome \
        chrome_100_percent.pak \
        chrome_200_percent.pak \
        icudtl.dat \
        resources.pak; do
        if [ -e "${pkgdir}/usr/lib/chromiumos-ash/${rel}" ]; then
            ln -s "/usr/lib/chromiumos-ash/${rel}" \
                "${pkgdir}/opt/google/chrome/${rel}"
        fi
    done

    # AuraDE compatibility: Arch's ttf-roboto package installs under
    # /usr/share/fonts/TTF, while some ChromeOS readahead paths still probe the
    # ChromeOS-style /usr/share/fonts/roboto directory.
    install -dm755 "${pkgdir}/usr/share/fonts/roboto"
    ln -s /usr/share/fonts/TTF/Roboto-Regular.ttf \
        "${pkgdir}/usr/share/fonts/roboto/Roboto-Regular.ttf"
    ln -s /usr/share/fonts/TTF/Roboto-Medium.ttf \
        "${pkgdir}/usr/share/fonts/roboto/Roboto-Medium.ttf"

    # Install launcher script
    install -Dm755 "${srcdir}/chromiumos-ash.sh" \
        "${pkgdir}/usr/bin/chromiumos-ash"
    install -Dm755 "${srcdir}/chromiumos-ash-session.sh" \
        "${pkgdir}/usr/bin/chromiumos-ash-session"
    install -Dm755 "${srcdir}/chromiumos-ash-session-child.sh" \
        "${pkgdir}/usr/bin/chromiumos-ash-session-child"
    install -Dm755 "${srcdir}/aurade-session-error" \
        "${pkgdir}/usr/bin/aurade-session-error"

    # Install X11 session entry for display managers.
    install -Dm644 "${srcdir}/chromiumos-ash.desktop" \
        "${pkgdir}/usr/share/xsessions/chromiumos-ash.desktop"
    install -Dm644 "${srcdir}/chromiumos-ash-wayland.desktop" \
        "${pkgdir}/usr/share/wayland-sessions/chromiumos-ash.desktop"

    # Install feature defaults.
    install -Dm644 "${srcdir}/aurade.features.conf" \
        "${pkgdir}/etc/aurade/features.conf"
    install -Dm644 "${srcdir}/google-api.conf.example" \
        "${pkgdir}/usr/share/doc/${pkgname}/google-api.conf.example"

    # Install optional SessionManager shim components. D-Bus activation can
    # start this on demand once the AuraDE session lifecycle switches from the
    # in-process fake client to a host service.
    install -Dm755 "${srcdir}/aurade-session-manager-shim.py" \
        "${pkgdir}/usr/lib/chromiumos-ash/aurade-session-manager-shim.py"
    install -Dm644 "${srcdir}/aurade-session-manager.service" \
        "${pkgdir}/usr/lib/systemd/system/aurade-session-manager.service"
    install -Dm644 "${srcdir}/org.chromium.SessionManager.conf" \
        "${pkgdir}/usr/share/dbus-1/system.d/org.chromium.SessionManager.conf"
    install -Dm644 "${srcdir}/org.chromium.SessionManager.service" \
        "${pkgdir}/usr/share/dbus-1/system-services/org.chromium.SessionManager.service"

    # AuraDE compatibility: generic Linux installs need the Wayland group for
    # exo's Wayland server and writable ChromeOS metrics state directories.
    install -Dm644 "${srcdir}/chromiumos-ash.sysusers.conf" \
        "${pkgdir}/usr/lib/sysusers.d/chromiumos-ash.conf"
    install -Dm644 "${srcdir}/chromiumos-ash.tmpfiles.conf" \
        "${pkgdir}/usr/lib/tmpfiles.d/chromiumos-ash.conf"

    install -Dm644 "${srcdir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
