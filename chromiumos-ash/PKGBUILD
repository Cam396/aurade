# Maintainer: AuraDE Contributors
#
# ChromiumOS Ash — ChromeOS desktop environment for Linux, built with
# ChromeOS features (OOBE, login manager, Ash shell) but runs on a
# standard Linux system via Ozone/X11, Ozone/Wayland, or direct DRM.
#
# This package requires shill-nm-adapter for network management via
# NetworkManager and dbus-glib for session management.

pkgname=chromiumos-ash
# Version mirrors the upstream ChromeOS milestone + build revision.
# Run the update-patches script to refresh before bumping.
pkgver=154.0.8015.0
pkgrel=2
pkgdesc="ChromeOS Ash desktop environment for Linux (Ozone X11/Wayland/DRM build)"
arch=('x86_64')
url="https://www.chromium.org/chromium-os/"
license=('BSD-3-Clause')
