# Maintainer: AuraDE Contributors

pkgname=auradefs
pkgver=0.1.0
pkgrel=4
pkgdesc="The file service behind the AuraDE Files app"
arch=('x86_64')
url="https://github.com/Cam396/aurade"
license=('MIT')
# libgit2 is linked, not vendored, and was missing here: the binary shipped
# with a DT_NEEDED on libgit2.so.1.9 that nothing declared, so it installed
# cleanly onto a machine without the library and died on every start with
# "error while loading shared libraries". Pinned by soname rather than by
# package name so the same mismatch fails at install time instead of at
# runtime; a libgit2 that bumps its soname is a rebuild, and this is what
# makes that a decision rather than a surprise.
depends=('gcc-libs' 'glibc' 'xz' 'bzip2' 'zlib' 'libgit2.so=1.9-64')
makedepends=('cargo' 'rust')
optdepends=(
  'ffmpeg: video thumbnails, media details and the covers of sound files'
  'poppler: PDF thumbnails and previews'
  'gnupg: signature verification in Properties'
  'polkit: Run as administrator, through pkexec'
)
# The source is the Cargo workspace beside this file, under workspace/. It is
# not a tarball and it is not listed here: the tree is copied into
# ${srcdir}/auradefs-src by ci/build-auradefs-package.sh, which is the only
# supported way to drive this PKGBUILD. Everything the tree needs from
# crates.io is fetched in prepare() and pinned by Cargo.lock; the one
# dependency this project patches, sevenz-rust2, is vendored in the tree.
source=(
  'README.md'
  'LICENSE'
  'auradefs.service'
)
sha256sums=('b10ea51389ffcac705a1616a9f93dca8a00d4396ec5a45713fb4f73c7b5a0d7a'
            'd9980fe1b68b40a5b2b87ee437e874888186d0ac4f51c6e8ffe32d7ff9ecfa4e'
  '24d43ae82a15cf5c4147258ddf43b5be5c5728006823cc66aa9586ddfc8c249e'
)

prepare() {
  local tree="${AURADEFS_SRC:-${srcdir}/auradefs-src}"
  [ -f "${tree}/Cargo.lock" ] || {
    echo "ERROR: ${tree} is not the auradefs workspace; run ci/build-auradefs-package.sh" >&2
    return 1
  }
  cd "${tree}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${AURADEFS_SRC:-${srcdir}/auradefs-src}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-Wl,-z,now"
  cargo build --release --frozen -p auradefs-daemon
}

check() {
  cd "${AURADEFS_SRC:-${srcdir}/auradefs-src}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  # The service's own tests, the ones that need nothing outside the tree.
  # Thumbnails through ffmpeg and PDFs through poppler are exercised where
  # those are installed and skipped where they are not, by the tests
  # themselves.
  cargo test --release --frozen --workspace
}

package() {
  install -Dm755 "${srcdir}/target/release/auradefs" \
    "${pkgdir}/usr/bin/auradefs"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # A user unit, not a system one: the service answers for the person whose
  # session it belongs to. The session child starts it by name and stops it
  # when the session ends; this file is what gives that start a restart on
  # failure, a place in the journal and the hardening below. It has no
  # dependency that would start it on its own: nothing on an AuraDE machine
  # reaches graphical-session.target, so WantedBy there is a courtesy to a
  # future session that does, and enabling it by hand changes nothing.
  install -Dm644 "${srcdir}/auradefs.service" \
    "${pkgdir}/usr/lib/systemd/user/auradefs.service"
}
