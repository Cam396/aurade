#!/usr/bin/env python3
"""Graphical front end for aurade-install.

This starts the model process, asks it whether a graphical installer can run
on this machine, and either draws one or hands over to the text installer.

The handover is the important part and it runs first. The probe's second job -
saying, while the disk is still intact, that the desktop about to be installed
will not start here - is not something a graphical installer can do after it
has failed to open a window. So the decision is made before any GTK import,
and a missing toolkit, a missing display or a probe that says no all end the
same way: exec the text installer, which is the renderer this product
guarantees.
"""

from __future__ import annotations

import argparse
import os
import sys

SELF_DIR = os.path.dirname(os.path.realpath(__file__))

for _lib in ("/usr/local/lib/aurade", os.path.join(SELF_DIR, "..", "lib")):
    _lib = os.path.normpath(_lib)
    if os.path.isdir(os.path.join(_lib, "aurade_gui")) and _lib not in sys.path:
        sys.path.insert(0, _lib)

try:
    from aurade_gui import stage as S
    from aurade_gui.bridge import Bridge, BridgeError, find_bridge
except ImportError as exc:  # pragma: no cover - packaging failure
    print(f"aurade-installer-gui: cannot load the graphical installer: {exc}", file=sys.stderr)
    sys.exit(1)


#: Where a crash gets written down, if this process has one.
#:
#: The launcher runs this inside a compositor and keeps every attempt's output
#: in a log, so in principle a crash is already recorded. In practice the text
#: installer then clears the screen, and what the person in front of the
#: machine remembers is that the installer vanished. The path is fixed rather
#: than made unique on purpose: "run this one command" is the whole difference
#: between a diagnosis and a conversation.
CRASH_LOG = os.environ.get("AURADE_GUI_CRASH_LOG", "/tmp/aurade-installer-crash.log")


def record_crashes() -> None:
    """Leave evidence, whichever way this process dies.

    Two different deaths, and neither of them left anything findable before.

    A Python exception raised inside a GTK callback is printed by PyGObject and
    swallowed, so the installer carries on in a state where some of the screen
    is from before the exception and some is from after. That is worse than
    stopping, and it is invisible.

    A crash in the graphics stack is not a Python exception at all. It is a
    signal, and Python's default handling of it is to be gone, with nothing
    written anywhere. `faulthandler` turns that into a stack trace, which on a
    machine whose driver has just died is the only evidence there will ever be.
    """
    try:
        handle = open(CRASH_LOG, "a", buffering=1)
    except OSError:
        return

    import faulthandler
    faulthandler.enable(file=handle, all_threads=True)

    import traceback

    def hook(kind, value, tb) -> None:
        handle.write("\n=== aurade-installer-gui stopped ===\n")
        traceback.print_exception(kind, value, tb, file=handle)
        traceback.print_exception(kind, value, tb, file=sys.stderr)

    sys.excepthook = hook

    # The one that matters most here. An exception raised inside a GTK signal
    # handler never reaches `sys.excepthook`: PyGObject prints it and lets the
    # program carry on, so a failed button press leaves half the screen from
    # before the exception and half from after, on a console that is about to
    # be cleared. Python routes those through `sys.unraisablehook`, which is
    # how they get written down here as well.
    def unraisable(args) -> None:
        handle.write("\n=== aurade-installer-gui: unraisable ===\n")
        traceback.print_exception(
            args.exc_type, args.exc_value, args.exc_traceback, file=handle)
        traceback.print_exception(
            args.exc_type, args.exc_value, args.exc_traceback, file=sys.stderr)

    sys.unraisablehook = unraisable


def find_tui() -> str | None:
    override = os.environ.get("AURADE_INSTALLER_TUI")
    if override:
        return override if os.access(override, os.X_OK) else None
    for candidate in (
        "/usr/local/sbin/aurade-installer-tui",
        os.path.join(SELF_DIR, "aurade-installer-tui"),
    ):
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def fall_back(reason: str, argv: list[str]) -> int:
    """Hand over to the text installer, saying why on the way out."""
    print(f"aurade-installer-gui: {reason}", file=sys.stderr)

    # Inside a compositor the launcher started, there is no terminal behind
    # this process: a text installer started here draws onto a surface nobody
    # can reach and takes the console with it. The launcher still has the real
    # console, so tell it the graphical path is over and let it hand over
    # there. Saying so also stops it walking the rest of the renderer list,
    # none of which can fix a missing toolkit or a probe that said no.
    if S.launcher_managed():
        S.report(S.DECLINED)
        return 1

    tui = find_tui()
    if tui is None:
        print(
            "aurade-installer-gui: the text installer is missing from this image",
            file=sys.stderr,
        )
        return 1
    print(f"aurade-installer-gui: starting the text installer instead", file=sys.stderr)
    os.execv(tui, [tui, *argv])
    return 1  # pragma: no cover - execv does not return


def toolkit_available() -> tuple[bool, str]:
    try:
        import gi  # noqa: F401
    except ImportError:
        return False, "the graphical toolkit is not installed on this image"
    try:
        gi.require_version("Gtk", "4.0")
        gi.require_version("Adw", "1")
        from gi.repository import Adw, Gtk  # noqa: F401
    except (ImportError, ValueError) as exc:
        return False, f"the graphical toolkit is not usable here: {exc}"
    return True, ""


def main() -> int:
    # Before anything else, because the thing most worth recording is a crash
    # during setup, and a handler installed after it would miss exactly that.
    record_crashes()
    parser = argparse.ArgumentParser(
        prog="aurade-installer-gui",
        description="Graphical installer for AuraDE.",
    )
    parser.add_argument("--journal", default=os.environ.get(
        "AURADE_JOURNAL_PATH", "/run/aurade-install/journal.jsonl"))
    parser.add_argument("--raw-log", default=os.environ.get(
        "AURADE_JOURNAL_RAW", "/run/aurade-install/install.log"))
    parser.add_argument(
        "--plan-only",
        action="store_true",
        help="ask the questions and check the plan; never offer to erase",
    )
    parser.add_argument(
        "--self-check",
        action="store_true",
        help="report whether this image can run the graphical installer, and exit",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="draw the graphical installer even if the probe advises against it",
    )
    args = parser.parse_args()
    passthrough = ["--journal", args.journal, "--raw-log", args.raw_log]
    if args.plan_only:
        passthrough.append("--plan-only")

    bridge_path = find_bridge(SELF_DIR)
    if bridge_path is None:
        return fall_back("part of the graphical installer is missing from this image", passthrough)

    ok, toolkit_reason = toolkit_available()

    model = Bridge(
        program=bridge_path,
        journal=args.journal,
        raw_log=args.raw_log,
        plan_only=args.plan_only,
    )
    try:
        model.start()
        model.ping()
        probe = model.probe()
    except BridgeError as exc:
        return fall_back(str(exc), passthrough)

    if args.self_check:
        model.close()
        print(f"toolkit: {'ok' if ok else toolkit_reason}")
        print(f"model: ok ({bridge_path})")
        print(f"renderer: {probe.get('renderer')} ({probe.get('reason')})")
        print(f"graphics: {probe.get('graphics')}")
        return 0 if ok else 1

    if not ok:
        model.close()
        return fall_back(toolkit_reason, passthrough)

    if not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("DISPLAY"):
        model.close()
        return fall_back("no display is running for a graphical installer", passthrough)

    if probe.get("renderer") != "gui" and not args.force:
        model.close()
        reason = probe.get("advice") or probe.get("graphics") or "graphics are not usable"
        return fall_back(reason, passthrough)

    from aurade_gui.app import run

    try:
        return run(model, plan_only=args.plan_only)
    finally:
        model.close()


if __name__ == "__main__":
    sys.exit(main())
