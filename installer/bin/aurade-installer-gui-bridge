#!/usr/bin/env bash
# The model process behind the graphical installer.
#
# The graphical front end is a renderer and nothing else. It owns pixels,
# focus order and wording layout; it owns no question, no validation rule, no
# argument list, no secret and no opinion about what is reversible. Everything
# in that second list already exists in shell, has tests, and is the code the
# text installer runs. So this program sources that code and speaks it over a
# pipe, and the graphical front end asks it.
#
# The reuse is deliberate and total. `aurade-installer-tui` can be sourced with
# AURADE_INSTALLER_TUI_LIB=1, which defines every function and stops before its
# entry point. That gives this bridge the identical `build_engine_args`,
# `hash_password`, `write_secret`, `apply_answer`, `disk_table`, journal
# readers and stage vocabulary the text installer uses. A graphical installer
# that built its own argument list would be a second implementation of the one
# join where a mistake reaches a destructive engine, and the two would drift.
#
# The dependency runs one way. Nothing here is on the text installer's path, so
# a broken or absent GUI cannot affect the fallback, which is the renderer this
# product guarantees.
#
# Protocol: one command per line on stdin, one line of JSON per response on
# stdout. Commands that carry a value read exactly one more line, unmodified,
# so a passphrase containing spaces survives - the text installer has already
# shipped that bug once, in a widget that dropped the space key.
#
# Secrets are held in this process and written only by `write_secret`. They are
# never echoed back, never logged, and never appear in a response. The renderer
# sends a password once and can never read it again.

set -Eeuo pipefail

GB_SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

GB_TUI=${AURADE_INSTALLER_TUI:-}
if [[ -z $GB_TUI ]]; then
  for _candidate in /usr/local/sbin/aurade-installer-tui "$GB_SELF_DIR/aurade-installer-tui"; do
    [[ -r $_candidate ]] || continue
    GB_TUI=$_candidate
    break
  done
fi
[[ -n $GB_TUI && -r $GB_TUI ]] || {
  echo 'aurade-installer-gui-bridge: cannot find aurade-installer-tui' >&2
  exit 1
}

export AURADE_INSTALLER_TUI_LIB=1
# shellcheck source=/dev/null
. "$GB_TUI"
unset AURADE_INSTALLER_TUI_LIB

# --------------------------------------------------------------------------
# Options
# --------------------------------------------------------------------------

while (($#)); do
  case $1 in
    # Exported, not merely set: the engine is a child process and reads these
    # from its environment. Setting them privately would point the renderer at
    # one journal and the engine at another.
    --journal) JOURNAL_FILE=$2; export AURADE_JOURNAL_PATH=$2; shift 2 ;;
    --raw-log) RAW_LOG=$2; export AURADE_JOURNAL_RAW=$2; shift 2 ;;
    --plan-only) PLAN_ONLY=1; shift ;;
    -h|--help)
      cat <<'EOF'
Usage: aurade-installer-gui-bridge [options]

Reads commands on stdin and writes one line of JSON per command on stdout.
This is the model process for aurade-installer-gui; it is not a user command.

Options:
  --journal FILE   Structured journal to read progress and failure from
  --raw-log FILE   Private unstructured installer log
  --plan-only      Build and check a plan; the execute command does not exist
EOF
      exit 0
      ;;
    *) echo "aurade-installer-gui-bridge: unknown option: $1" >&2; exit 2 ;;
  esac
done

SECRET_DIR=$(mktemp -d "${TMPDIR:-/run}/aurade-installer-gui.XXXXXX")
chmod 700 "$SECRET_DIR"
install -d -m 0700 "$(dirname "$JOURNAL_FILE")" 2>/dev/null || true
install -d -m 0700 "$(dirname "$RAW_LOG")" 2>/dev/null || true

GB_PLANNED=0
GB_ENGINE_PID=

# --------------------------------------------------------------------------
# JSON output
# --------------------------------------------------------------------------
#
# `_json_escape` comes from aurade-journal.sh, which is already sourced and
# already the escaper the journal itself is written with. Responses are built
# whole and printed once, so a reader never sees half a record.

_gb_str() { printf '"%s"' "$(_json_escape "${1-}")"; }

_gb_bool() { if "$@"; then printf 'true'; else printf 'false'; fi; }

_gb_emit() { printf '%s\n' "$1"; }

_gb_ok() { _gb_emit "{\"ok\":true${1:+,$1}}"; }

_gb_err() { _gb_emit "{\"ok\":false,\"error\":$(_gb_str "$1")}"; }

# --------------------------------------------------------------------------
# Read-only views
# --------------------------------------------------------------------------

# Which questions are currently askable. The encryption passphrase exists only
# when encryption was chosen, and that rule lives in `visible_questions`, so the
# renderer asks again after an answer that could change it rather than keeping
# a second copy of the condition.
gb_visible() {
  local id out='[' sep=''
  for id in $(visible_questions); do
    out+="${sep}$(_gb_str "$id")"; sep=','
  done
  out+=']'
  _gb_emit "$out"
}

gb_manifest() {
  local id out sep=''
  out='{"order":['
  for id in $(visible_questions); do
    out+="${sep}$(_gb_str "$id")"; sep=','
  done
  out+='],"advanced":['
  sep=''
  for id in "${AURADE_QUESTION_IDS[@]}"; do
    aurade_question_is_advanced "$id" || continue
    out+="${sep}$(_gb_str "$id")"; sep=','
  done
  out+='],"questions":{'
  sep=''
  for id in "${AURADE_QUESTION_IDS[@]}"; do
    out+="${sep}$(_gb_str "$id"):{"
    out+="\"label\":$(_gb_str "$(aurade_question_field "$id" label)"),"
    out+="\"short\":$(_gb_str "$(aurade_question_field "$id" short)"),"
    out+="\"help\":$(_gb_str "$(aurade_question_field "$id" help)"),"
    out+="\"type\":$(_gb_str "$(aurade_question_field "$id" type)"),"
    out+="\"default\":$(_gb_str "$(aurade_question_default "$id")"),"
    out+="\"error\":$(_gb_str "$(aurade_question_field "$id" error)"),"
    out+="\"advanced\":$(_gb_bool aurade_question_is_advanced "$id"),"
    out+="\"secret\":$(_gb_bool aurade_question_is_secret "$id")}"
    sep=','
  done
  out+='}}'
  _gb_emit "$out"
}

gb_disks() {
  local out='[' sep='' path size model tran serial
  while IFS='|' read -r path size model tran serial; do
    [[ -n $path ]] || continue
    out+="${sep}{\"path\":$(_gb_str "$path"),\"size\":$(_gb_str "$size"),"
    out+="\"model\":$(_gb_str "$model"),\"transport\":$(_gb_str "$tran"),"
    out+="\"serial\":$(_gb_str "$serial")}"
    sep=','
  done < <(disk_table)
  out+=']'
  _gb_emit "$out"
}

gb_probe() {
  local out
  aurade_probe_renderer
  out='{'
  out+="\"renderer\":$(_gb_str "$AURADE_PROBE_RENDERER"),"
  out+="\"reason\":$(_gb_str "$AURADE_PROBE_REASON"),"
  out+="\"graphics\":$(_gb_str "$AURADE_PROBE_GRAPHICS"),"
  out+="\"memory\":$(_gb_str "$AURADE_PROBE_MEMORY"),"
  out+="\"virt\":$(_gb_str "$AURADE_PROBE_VIRT"),"
  out+="\"driver\":$(_gb_str "$AURADE_PROBE_DRIVER"),"
  out+="\"node\":$(_gb_str "$AURADE_PROBE_NODE"),"
  out+="\"gl\":$(_gb_str "$AURADE_PROBE_GL"),"
  out+="\"advice\":$(_gb_str "$(aurade_probe_advice)"),"
  out+="\"predicts_black_screen\":$(_gb_bool aurade_probe_predicts_black_screen)}"
  _gb_emit "$out"
}

# Whether this computer can run AuraDE, as a list of findings.
#
# Every check here is one the engine already enforces, moved forward. The
# engine refuses a legacy BIOS boot. Secure Boot is different: setup mode and a
# supplied key use signing, while an enabled or unreadable state without a key
# is a warning. The install continues so the user can finish, then explains
# that firmware must be disabled or an AuraDE key enrolled before first boot.
#
# The states are `ok`, `warn` and `blocked`, and they mean exactly one thing
# each: it is fine, it will work but worse, and this will not install.
AURADE_EFI_DIR=${AURADE_EFI_DIR:-/sys/firmware/efi}

_gb_check() {
  local id=$1 title=$2 state=$3 finding=$4 action=${5:-} detail=${6:-}
  printf '{"id":%s,"title":%s,"state":%s,"finding":%s,"action":%s,"detail":%s}' \
    "$(_gb_str "$id")" "$(_gb_str "$title")" "$(_gb_str "$state")" \
    "$(_gb_str "$finding")" "$(_gb_str "$action")" "$(_gb_str "$detail")"
}

_gb_efi_boolean() {
  local name=$1 variable
  for variable in "${AURADE_EFIVARS_DIR:-/sys/firmware/efi/efivars}/${name}-"*; do
    [[ -r $variable ]] || continue
    od -An -j4 -N1 -tu1 "$variable" 2>/dev/null | tr -d '[:space:]'
    return 0
  done
  return 1
}

# Compare two lsblk size strings ("931.5G", "476.9G", "1.8T"). Bigger wins.
_gb_size_gt() {
  local a=$1 b=$2
  awk -v a="$a" -v b="$b" '
    function bytes(s,   n, u) {
      n = s + 0
      u = toupper(substr(s, length(s)))
      if (u == "T") return n * 1024 * 1024
      if (u == "G") return n * 1024
      if (u == "M") return n
      if (u == "K") return n / 1024
      return n
    }
    BEGIN { exit !(bytes(a) > bytes(b)) }'
}

_gb_readiness_disk() {
  local path size model tran serial biggest='' biggest_size='' count=0
  while IFS='|' read -r path size model tran serial; do
    [[ -n $path ]] || continue
    count=$(( count + 1 ))
    # Compared as printed, which is what lsblk gives: a plain numeric sort of
    # "931.5G" against "476.9G" is right, and against "28.7G" it is right too.
    if [[ -z $biggest ]] || _gb_size_gt "$size" "$biggest_size"; then
      biggest="$path"
      biggest_size=$size
    fi
  done < <(disk_table)
  if (( count == 0 )); then
    _gb_check disk 'Storage' blocked 'No disk to install to.' \
      'Check that the drive is connected and that the firmware can see it.'
    return 0
  fi
  if (( count == 1 )); then
    _gb_check disk 'Storage' ok \
      "$(printf '%s, %s.' "$biggest" "$biggest_size")" '' \
      "$(disk_table | tr '|' ' ' | tr '\n' ';')"
  else
    _gb_check disk 'Storage' ok \
      "$(printf '%s disks. The largest is %s, %s.' "$count" "$biggest" "$biggest_size")" '' \
      "$(disk_table | tr '|' ' ' | tr '\n' ';')"
  fi
}

gb_readiness() {
  local out='' sep='' verdict=ok secure state finding action
  aurade_probe_renderer

  # Firmware mode. `aurade-install` refuses outright without it.
  if [[ -d $AURADE_EFI_DIR ]]; then
    out+="${sep}$(_gb_check firmware 'Firmware' ok 'Booted in UEFI mode.')"
  else
    verdict=blocked
    out+="${sep}$(_gb_check firmware 'Firmware' blocked \
      'This computer booted in legacy BIOS mode. AuraDE only installs in UEFI mode.' \
      'Restart, open the firmware settings, turn off legacy or CSM boot, then start the installer again.')"
  fi
  sep=','

# Secure Boot is actionable information, not a reason to repeat the entire
  # install. Signing is used when available; otherwise the engine continues
  # and the completion guidance covers the firmware step.
  secure=$(bootctl is-secure-boot 2>/dev/null || printf 'unknown')
  case $secure in
    disabled)
      out+="${sep}$(_gb_check secure_boot 'Secure Boot' ok 'Off, which is what AuraDE needs.')" ;;
    enabled)
      setup_mode=$(_gb_efi_boolean SetupMode 2>/dev/null || true)
      if [[ $setup_mode == 1 ]]; then
        [[ $verdict == blocked ]] || verdict=attention
        out+="${sep}$(_gb_check secure_boot 'Secure Boot' warn \
          'On, with firmware in setup mode. AuraDE will sign the boot chain and offer to enroll its key on first boot.' \
          'Leave setup mode on until the installed system offers the AuraDE enrollment entry, then turn Secure Boot back on.')"
      elif [[ $setup_mode == 0 && -r ${AURADE_SECURE_BOOT_KEY:-/dev/null} && \
          -r ${AURADE_SECURE_BOOT_CERT:-/dev/null} && \
          -n ${AURADE_SECURE_BOOT_KEY:-} && -n ${AURADE_SECURE_BOOT_CERT:-} ]]; then
        out+="${sep}$(_gb_check secure_boot 'Secure Boot' ok \
          'On, with a pre-enrolled AuraDE signing key.' '' \
          'The installer will sign systemd-boot and the kernel with the supplied key.')"
      else
        [[ $verdict == blocked ]] || verdict=attention
        out+="${sep}$(_gb_check secure_boot 'Secure Boot' warn \
          'On, but no AuraDE signing key is available. The install will continue.' \
          'Disable Secure Boot before the first boot, or enroll an AuraDE key after installation.')"
      fi ;;
    *)
      [[ $verdict == blocked ]] || verdict=attention
      out+="${sep}$(_gb_check secure_boot 'Secure Boot' warn \
        'Could not tell whether Secure Boot is on.' \
        'The install will continue. If firmware has Secure Boot enabled, disable it or enroll an AuraDE key before the first boot.' \
        "bootctl is-secure-boot: ${secure}")" ;;
  esac

  # Memory, from the same probe the renderer decision uses. Reported in the
  # unit the number is printed on the side of the machine in, not in mebibytes.
  local free_gb
  free_gb=$(printf '%s.%s' "$(( AURADE_PROBE_MEM_MIB / 1024 ))" \
    "$(( (AURADE_PROBE_MEM_MIB % 1024) * 10 / 1024 ))")
  if (( AURADE_PROBE_MEM_MIB >= AURADE_PROBE_MIN_GUI_MIB )); then
    out+="${sep}$(_gb_check memory 'Memory' ok \
      "$(printf '%s GB free.' "$free_gb")" '' \
      "$AURADE_PROBE_MEMORY")"
  else
    [[ $verdict == blocked ]] || verdict=attention
    out+="${sep}$(_gb_check memory 'Memory' warn \
      "$(printf '%s GB free. The installed system gets more to work with than this live image does.' "$free_gb")" \
      '' "$AURADE_PROBE_MEMORY")"
  fi

  out+="${sep}$(_gb_readiness_disk)"

  # Graphics, in one sentence. The driver strings and node paths are real
  # evidence and they stay available, but they belong behind the details
  # control rather than in the middle of the first screen someone reads.
  if aurade_probe_predicts_black_screen; then
    verdict=blocked
    state=blocked
    finding='No working graphics driver, so the desktop would not appear after installing.'
    action='On a virtual machine, turn on 3D acceleration in its display settings. On a real one, the graphics card is probably not supported.'
  elif [[ $AURADE_PROBE_REASON == software-rendering ]]; then
    [[ $verdict == blocked ]] || verdict=attention
    state=warn
    finding='Drawn by the processor rather than a graphics card. The desktop will work, slowly.'
    action='On a virtual machine, turning on 3D acceleration usually fixes it.'
  else
    state=ok
    finding='Driver loaded. The desktop should come up fine.'
    action=''
  fi
  out+="${sep}$(_gb_check graphics 'Graphics' "$state" "$finding" "$action" \
    "$AURADE_PROBE_GRAPHICS")"

  _gb_emit "{\"ok\":true,\"verdict\":$(_gb_str "$verdict"),\"checks\":[$out]}"
}

# The stage rows the progress view draws, in journal order, with the display
# rule and the reversibility boundary both taken from the shared libraries
# rather than restated here.
gb_stages() {
  local stage out='[' sep=''
  for stage in "${AURADE_STAGES[@]}"; do
    stage_displayed "$stage" || continue
    out+="${sep}{\"stage\":$(_gb_str "$stage"),"
    out+="\"label\":$(_gb_str "$(stage_label "$stage")"),"
    out+="\"reversible\":$(_gb_bool aurade_stage_reversible "$stage")}"
    sep=','
  done
  out+=']'
  _gb_emit "$out"
}

gb_enum() {
  local id=$1 out='[' sep='' candidate count=0
  while IFS= read -r candidate; do
    [[ -n $candidate ]] || continue
    out+="${sep}$(_gb_str "$candidate")"; sep=','
    count=$(( count + 1 ))
    (( count < 5000 )) || break
  done < <(enum_candidates "$id")
  out+=']'
  _gb_emit "$out"
}

# The review rows, with the same rule the text installer uses: a secret is
# reported as having been set, never as its value.
gb_answers() {
  local id out='{' sep='' value
  for id in "${AURADE_QUESTION_IDS[@]}"; do
    if aurade_question_is_secret "$id"; then
      [[ -n ${ANSWERS[$id]:-} ]] || continue
      value='set'
    else
      value=${ANSWERS[$id]:-}
      [[ -n $value ]] || continue
    fi
    out+="${sep}$(_gb_str "$id"):{\"short\":$(_gb_str "$(aurade_question_field "$id" short)"),"
    out+="\"value\":$(_gb_str "$value"),"
    out+="\"advanced\":$(_gb_bool aurade_question_is_advanced "$id")}"
    sep=','
  done
  out+='}'
  _gb_emit "$out"
}

# The erase gate's identity block, read from the same disk table the text
# installer's gate reads.
gb_target() {
  local target=${ANSWERS[target]:-} out layout
  layout=${ANSWERS[layout]:-$(aurade_question_default layout)}
  [[ -n $target ]] || { _gb_err 'no disk has been chosen'; return 0; }
  out='{"ok":true,'
  out+="\"path\":$(_gb_str "$target"),"
  out+="\"model\":$(_gb_str "$(disk_field "$target" 3)"),"
  out+="\"serial\":$(_gb_str "$(disk_serial "$target")"),"
  out+="\"size\":$(_gb_str "$(disk_field "$target" 2)"),"
  out+="\"transport\":$(_gb_str "$(disk_field "$target" 4)"),"
  out+="\"layout\":$(_gb_str "$layout"),"
  out+="\"token\":$(_gb_str "$(aurade_confirmation_token "$target" "$layout")")}"
  _gb_emit "$out"
}

# The live-session network and clock preflight, which is a read-only helper
# that already exists and already has a test. The graphical installer shows
# its result on a page of its own because "packages could not be downloaded"
# is a much worse place to learn that the clock is wrong.
#
# This does not become a question. The engine has no flag for it, and the
# manifest deliberately carries nothing the engine cannot consume.
NETWORK_HELPER=${AURADE_NETWORK_HELPER:-/usr/local/sbin/aurade-network-diagnostics}
[[ -x $NETWORK_HELPER ]] ||
  NETWORK_HELPER="$GB_SELF_DIR/../archiso/airootfs/usr/local/sbin/aurade-network-diagnostics"

gb_network() {
  local status=0 report errors out='{' sep='' line
  if [[ ! -x $NETWORK_HELPER ]]; then
    _gb_emit '{"ok":false,"available":false,"notes":[],"issues":["The network check is missing from this image."]}'
    return 0
  fi
  report=$(mktemp "${TMPDIR:-/tmp}/aurade-net.XXXXXX")
  errors=$(mktemp "${TMPDIR:-/tmp}/aurade-net-err.XXXXXX")
  "$NETWORK_HELPER" >"$report" 2>"$errors" || status=$?
  out+="\"ok\":$(if (( status == 0 )); then printf 'true'; else printf 'false'; fi),"
  out+='"available":true,"notes":['
  while IFS= read -r line; do
    line=${line#"${line%%[![:space:]]*}"}
    [[ -n $line ]] || continue
    out+="${sep}$(_gb_str "$line")"; sep=','
  done <"$report"
  out+='],"issues":['
  sep=''
  while IFS= read -r line; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line#ERROR: }
    [[ -n $line ]] || continue
    out+="${sep}$(_gb_str "$line")"; sep=','
  done <"$errors"
  out+=']}'
  rm -f -- "$report" "$errors"
  _gb_emit "$out"
}

# --------------------------------------------------------------------------
# Wireless
# --------------------------------------------------------------------------
#
# Joining a network is a live-session action, not an installer question. The
# engine has no flag for it and the manifest deliberately carries nothing the
# engine cannot consume, so this sits beside `apply_answer` rather than beside
# the question set: something the user does now, so the rest of the flow can
# proceed, exactly like loading a keymap.
#
# The passphrase never appears in a command line. `nmcli ... password <psk>`
# would put it in argv where every process on the machine can read it, so the
# profile is written the way NetworkManager stores one itself: a mode-0600
# keyfile in its own profile directory, which is where the secret was going to
# end up regardless.

NMCLI=${AURADE_NMCLI:-nmcli}
NM_PROFILE_DIR=${AURADE_NM_PROFILE_DIR:-/etc/NetworkManager/system-connections}

_nm_available() { command -v "$NMCLI" >/dev/null 2>&1; }

# nmcli's terse output escapes `:` and `\` inside values. An SSID may contain
# both, and a half-unescaped SSID is one that cannot be joined.
_nm_unescape() {
  local s=$1 out='' i c
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    if [[ $c == '\' ]]; then
      i=$(( i + 1 ))
      out+=${s:i:1}
    else
      out+=$c
    fi
  done
  printf '%s' "$out"
}

# Split a terse nmcli record on unescaped colons.
_nm_fields() {
  local line=$1 field='' i c
  NM_FIELDS=()
  for (( i = 0; i < ${#line}; i++ )); do
    c=${line:i:1}
    if [[ $c == '\' ]]; then
      field+=$c${line:i+1:1}
      i=$(( i + 1 ))
    elif [[ $c == ':' ]]; then
      NM_FIELDS+=("$(_nm_unescape "$field")")
      field=''
    else
      field+=$c
    fi
  done
  NM_FIELDS+=("$(_nm_unescape "$field")")
}
NM_FIELDS=()

gb_net_status() {
  local out wired=false wifi=false radio=unavailable ssid='' state=''
  if ! _nm_available; then
    _gb_emit '{"ok":false,"available":false,"wired":false,"wifi":false,"radio":"unavailable","ssid":"","reason":"Nothing on this image can set up a wireless connection."}'
    return 0
  fi
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    _nm_fields "$line"
    case ${NM_FIELDS[1]:-} in
      ethernet) [[ ${NM_FIELDS[2]:-} != connected ]] || wired=true ;;
      wifi)
        wifi=true
        if [[ ${NM_FIELDS[2]:-} == connected ]]; then
          ssid=${NM_FIELDS[3]:-}
        fi
        ;;
    esac
  done < <("$NMCLI" -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null || true)
  radio=$("$NMCLI" -t radio wifi 2>/dev/null || printf 'unavailable')
  [[ -n $radio ]] || radio=unavailable
  state=$("$NMCLI" -t -f CONNECTIVITY general status 2>/dev/null | head -1 || true)
  out='{"ok":true,"available":true,'
  out+="\"wired\":$wired,\"wifi\":$wifi,"
  out+="\"radio\":$(_gb_str "$radio"),"
  out+="\"ssid\":$(_gb_str "$ssid"),"
  out+="\"connectivity\":$(_gb_str "$state")}"
  _gb_emit "$out"
}

gb_wifi_scan() {
  local out='[' sep='' line ssid signal security active seen=''
  if ! _nm_available; then
    _gb_emit '{"ok":false,"error":"NetworkManager is not on this image","networks":[]}'
    return 0
  fi
  "$NMCLI" device wifi rescan >/dev/null 2>&1 || true
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    _nm_fields "$line"
    ssid=${NM_FIELDS[0]:-}
    signal=${NM_FIELDS[1]:-0}
    security=${NM_FIELDS[2]:-}
    active=${NM_FIELDS[3]:-no}
    # A hidden network broadcasts an empty SSID and cannot be joined by
    # picking it from a list, so it is not offered as though it could be.
    [[ -n $ssid ]] || continue
    # Access points repeat once per band and per radio. The list is of
    # networks, not of radios, so the strongest sighting wins.
    [[ $seen != *"|$ssid|"* ]] || continue
    seen+="|$ssid|"
    [[ $signal =~ ^[0-9]+$ ]] || signal=0
    out+="${sep}{\"ssid\":$(_gb_str "$ssid"),\"signal\":${signal},"
    out+="\"security\":$(_gb_str "$security"),"
    out+="\"open\":$(if [[ -z $security || $security == '--' ]]; then printf 'true'; else printf 'false'; fi),"
    out+="\"active\":$(if [[ $active == yes ]]; then printf 'true'; else printf 'false'; fi),"
    out+="\"saved\":$(if _wifi_saved "$ssid"; then printf 'true'; else printf 'false'; fi)}"
    sep=','
  done < <("$NMCLI" -t -f SSID,SIGNAL,SECURITY,IN-USE device wifi list 2>/dev/null || true)
  out+=']'
  _gb_emit "{\"ok\":true,\"networks\":$out}"
}

_wifi_saved() {
  local want=$1 line
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    _nm_fields "$line"
    [[ ${NM_FIELDS[1]:-} == 802-11-wireless ]] || continue
    [[ ${NM_FIELDS[0]:-} != "$want" ]] || return 0
  done < <("$NMCLI" -t -f NAME,TYPE connection show 2>/dev/null || true)
  return 1
}

# Join a network. The passphrase arrives on the protocol's value line and goes
# straight into a mode-0600 keyfile; it is never an argument, never logged and
# never echoed back.
gb_wifi_connect() {
  local ssid=$1 psk=$2 uuid profile status=0 output
  if ! _nm_available; then
    _gb_err 'NetworkManager is not on this image'
    return 0
  fi
  [[ -n $ssid ]] || { _gb_err 'choose a network first'; return 0; }
  if [[ -n $psk && ${#psk} -lt 8 ]]; then
    # WPA rejects anything shorter, and it rejects it after a slow association
    # attempt. Saying so now is faster and clearer than letting it fail.
    _gb_err 'A Wi-Fi password is at least 8 characters.'
    return 0
  fi
  if ! install -d -m 0700 -- "$NM_PROFILE_DIR" 2>/dev/null; then
    _gb_err 'cannot write a network profile on this system'
    return 0
  fi
  uuid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || printf 'aurade-%s' "$$")
  profile="$NM_PROFILE_DIR/aurade-${uuid}.nmconnection"
  (
    umask 077
    {
      printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\n\n' "$ssid" "$uuid"
      printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$ssid"
      if [[ -n $psk ]]; then
        printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$psk"
      fi
      printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
    } >"$profile"
  )
  chmod 600 "$profile" 2>/dev/null || true
  "$NMCLI" connection load "$profile" >/dev/null 2>&1 || true
  output=$("$NMCLI" connection up uuid "$uuid" 2>&1) || status=$?
  if (( status != 0 )); then
    # A profile that did not connect is a profile that will be retried on the
    # installed system for no reason, so it does not outlive the attempt.
    "$NMCLI" connection delete uuid "$uuid" >/dev/null 2>&1 || true
    rm -f -- "$profile"
    _gb_err "$(_wifi_reason "$output" "$psk")"
    return 0
  fi
  _gb_ok "\"ssid\":$(_gb_str "$ssid")"
}

# Turn nmcli's diagnostic into something a person can act on. The raw text is
# not shown: it names D-Bus paths and profile UUIDs, and none of that tells
# anyone what to do next.
_wifi_reason() {
  local text=${1,,} had_psk=$2
  case $text in
    *"secrets were required"*|*"no secrets"*|*"802.1x supplicant"*)
      if [[ -n $had_psk ]]; then
        printf '%s' 'That password was not accepted. Check it and try again.'
      else
        printf '%s' 'This network needs a password.'
      fi
      ;;
    *timeout*|*timed\ out*)
      printf '%s' 'The network did not answer in time. Move closer to the router, or try again.'
      ;;
    *"not authorized"*|*"not permitted"*)
      printf '%s' 'This session is not allowed to change network settings.'
      ;;
    *"no network with ssid"*|*"not found"*)
      printf '%s' 'That network is no longer in range.'
      ;;
    *) printf '%s' 'Could not join that network. Check the password, or pick another network.' ;;
  esac
}

gb_wifi_forget() {
  local ssid=$1
  _nm_available || { _gb_err 'NetworkManager is not on this image'; return 0; }
  "$NMCLI" connection delete id "$ssid" >/dev/null 2>&1 || true
  _gb_ok
}

# The accessibility choices, read and written through the same shared state the
# text installer uses. Neither command can reach a disk, so both are available
# in plan-only mode: somebody checking a plan still has to be able to read the
# screen they are checking it on.
gb_access() {
  local key out='{' sep='' value values
  for key in "${ACCESS_ORDER[@]}"; do
    values='['
    local candidate first=1
    for candidate in ${ACCESS_VALUES[$key]}; do
      (( first )) || values+=','
      values+=$(_gb_str "$candidate")
      first=0
    done
    values+=']'
    out+="${sep}$(_gb_str "$key"):{"
    out+="\"value\":$(_gb_str "${ACCESS[$key]}"),"
    out+="\"label\":$(_gb_str "${ACCESS_LABEL[$key]}"),"
    out+="\"help\":$(_gb_str "${ACCESS_HELP[$key]}"),"
    out+="\"values\":$values}"
    sep=','
  done
  out+='}'
  _gb_emit "{\"ok\":true,\"access\":$out,\"order\":$(_gb_str "${ACCESS_ORDER[*]}")}"
}

gb_access_set() {
  local pair=$1 key value
  [[ $pair == *=* ]] || { _gb_err 'expected key=value'; return 0; }
  key=${pair%%=*}
  value=${pair#*=}
  if access_set "$key" "$value"; then
    _gb_ok
  else
    # The engine refuses the same values independently. This refusal is what
    # makes a mistake visible in the interface rather than at install time.
    _gb_err "$key cannot be set to that"
  fi
}

gb_wifi_radio() {
  local want=$1
  _nm_available || { _gb_err 'NetworkManager is not on this image'; return 0; }
  case $want in
    on|off) ;;
    *) _gb_err 'the radio is either on or off'; return 0 ;;
  esac
  if "$NMCLI" radio wifi "$want" >/dev/null 2>&1; then
    _gb_ok
  else
    _gb_err "Could not turn the Wi-Fi radio $want."
  fi
}

gb_progress() {
  local stage record status out='[' sep='' active='' pct detail elapsed running
  local reversible can_stop
  for stage in "${AURADE_STAGES[@]}"; do
    stage_displayed "$stage" || continue
    record=$(journal_last_for_stage "$stage")
    status=pending
    pct=0
    detail=''
    elapsed=''
    if [[ -n $record ]]; then
      status=$(json_field status "$record")
      detail=$(json_field message "$record")
      case $status in
        running)
          active=$stage
          pct=$(json_field pct "$record")
          [[ $pct =~ ^[0-9]+$ ]] || pct=0
          ;;
        ok) elapsed=$(json_field elapsed_ms "$record") ;;
      esac
    fi
    out+="${sep}{\"stage\":$(_gb_str "$stage"),"
    out+="\"label\":$(_gb_str "$(stage_label "$stage")"),"
    out+="\"status\":$(_gb_str "$status"),\"pct\":${pct:-0},"
    out+="\"detail\":$(_gb_str "$detail"),"
    # Roughly how long this one takes, from lib/aurade-copy.sh, so the two
    # front ends give the same answer to "is it stuck".
    out+="\"pacing\":$(_gb_str "$(stage_pacing "$stage")"),"
    out+="\"elapsed\":$(_gb_str "$(format_elapsed "${elapsed:-}")")}"
    sep=','
  done
  out+=']'
  running=false
  if [[ -n $GB_ENGINE_PID ]] && kill -0 "$GB_ENGINE_PID" 2>/dev/null; then
    running=true
  fi
  # Two different questions, kept apart because they have different answers.
  #
  # `reversible` is about the disk: has anything been written yet. It comes
  # from `aurade_stage_reversible`, the same boundary the engine and the text
  # installer use, never from a second opinion held here.
  #
  # `can_stop` is about the offer: a Stop control may only appear while the
  # engine is running AND nothing has been written. The instant the engine
  # reaches `partition` the offer is gone, because from there the only honest
  # thing to say is that stopping would leave a half-written disk.
  reversible=true
  [[ -z $active ]] || aurade_stage_reversible "$active" || reversible=false
  can_stop=false
  [[ $running != true || $reversible != true ]] || can_stop=true
  # Total time so far, summed from the journal rather than from a clock this
  # process started, so that a screen redrawn from a saved journal shows the
  # same number it showed at the time.
  local total_ms=0
  if [[ -r $JOURNAL_FILE ]]; then
    total_ms=$(awk '
      match($0, /"elapsed_ms":[0-9]+/) {
        sum += substr($0, RSTART + 13, RLENGTH - 13) + 0
      }
      END { printf "%d", sum }
    ' "$JOURNAL_FILE" 2>/dev/null || printf '0')
    [[ $total_ms =~ ^[0-9]+$ ]] || total_ms=0
  fi
  _gb_emit "{\"ok\":true,\"stages\":$out,\"active\":$(_gb_str "$active"),\"running\":$running,\"position\":$(_gb_str "$(stage_position "$active")"),\"elapsed_ms\":${total_ms},\"reversible\":${reversible},\"can_stop\":${can_stop}}"
}

# Stop a run that has not written anything yet.
#
# This is not a new capability and not a new code path. `aurade-install`
# already traps TERM and already has `handle_cancel`, which writes a
# `cancelled` journal record, preserves the evidence, and lets its EXIT
# cleanup unmount, close any LUKS mapping and remove the work directory. All
# this does is surface that, and only while the shared reversibility boundary
# says the disk is still untouched.
gb_stop() {
  local active record stage
  [[ -n $GB_ENGINE_PID ]] && kill -0 "$GB_ENGINE_PID" 2>/dev/null || {
    _gb_err 'nothing is running'
    return 0
  }
  active=''
  for stage in "${AURADE_STAGES[@]}"; do
    record=$(journal_last_for_stage "$stage")
    [[ -n $record ]] || continue
    [[ $(json_field status "$record") == running ]] || continue
    active=$stage
  done
  if [[ -n $active ]] && ! aurade_stage_reversible "$active"; then
    _gb_err 'the disk has already been changed. Stopping now would leave it half written'
    return 0
  fi
  kill -TERM "$GB_ENGINE_PID" 2>/dev/null || true
  _gb_ok '"stopping":true'
}

gb_failure() {
  local record stage cause message out
  record=$(journal_last_failed)
  stage=$(json_field stage "$record")
  cause=$(json_field cause "$record")
  message=$(json_field message "$record")
  out='{"ok":true,'
  out+="\"stage\":$(_gb_str "$stage"),"
  out+="\"label\":$(_gb_str "${stage:+$(stage_label "$stage")}"),"
  out+="\"cause\":$(_gb_str "$cause"),"
  out+="\"cause_text\":$(_gb_str "${cause:+$(cause_explanation "$cause")}"),"
  out+="\"explanation\":$(_gb_str "${stage:+$(stage_explanation "$stage")}"),"
  out+="\"next_step\":$(_gb_str "$(cause_next_step "$cause")"),"
  out+="\"detail\":$(_gb_str "$message"),"
  out+="\"restart_advice\":$(_gb_str "$(restart_advice "$stage")"),"
  out+="\"position\":$(_gb_str "$(stage_position "$stage")"),"
  out+="\"reversible\":$(_gb_bool aurade_stage_reversible "${stage:-start}"),"
  out+="\"raw_log\":$(_gb_str "$RAW_LOG")}"
  _gb_emit "$out"
}

# --------------------------------------------------------------------------
# Answers
# --------------------------------------------------------------------------
#
# One entry point, so validation and immediate application happen for every
# answer regardless of which widget produced it. `aurade_question_validate`
# and `apply_answer` are the text installer's; nothing is re-decided here.

gb_set() {
  local id=$1 value=$2
  aurade_question_exists "$id" || { _gb_err "unknown question: $id"; return 0; }
  if ! aurade_question_validate "$id" "$value"; then
    _gb_err "$(aurade_question_field "$id" error)"
    return 0
  fi
  if ! apply_answer "$id" "$value"; then
    _gb_err "${APPLY_ERROR:-That answer could not be applied.}"
    return 0
  fi
  ANSWERS[$id]=$value
  # A plan built from earlier answers is no longer the plan for these.
  GB_PLANNED=0
  _gb_ok
}

# Secret questions carry no validator in the manifest, because what makes a
# password acceptable is that it was typed twice and is not empty, and both of
# those are the renderer's business. What is not the renderer's business is
# where the value then goes, which is why it comes here.
gb_secret() {
  local id=$1 value=$2
  aurade_question_exists "$id" || { _gb_err "unknown question: $id"; return 0; }
  aurade_question_is_secret "$id" || { _gb_err "$id is not a secret question"; return 0; }
  [[ -n $value ]] || { _gb_err "$(aurade_question_field "$id" error)"; return 0; }
  ANSWERS[$id]=$value
  GB_PLANNED=0
  _gb_ok
}

gb_get() {
  local id=$1
  aurade_question_exists "$id" || { _gb_err "unknown question: $id"; return 0; }
  if aurade_question_is_secret "$id"; then
    _gb_emit "{\"ok\":true,\"value\":$(_gb_str "${ANSWERS[$id]:+set}")}"
    return 0
  fi
  _gb_emit "{\"ok\":true,\"value\":$(_gb_str "${ANSWERS[$id]:-}")}"
}

# --------------------------------------------------------------------------
# The engine
# --------------------------------------------------------------------------

# Hash the password, write the passphrase to its mode-0600 file, build the
# argument list, and run the engine's own dry run. All four steps are the text
# installer's functions. The plan the user approves is therefore the plan the
# engine produced from these exact arguments, not a description of it.
gb_plan() {
  local status=0
  [[ -n $ENGINE && -x $ENGINE ]] || { _gb_err 'the installation engine is missing from this image'; return 0; }
  [[ -n ${ANSWERS[target]:-} ]] || { _gb_err 'no disk has been chosen'; return 0; }
  if ! hash_password; then
    _gb_err 'the account password could not be prepared on this system'
    return 0
  fi
  if [[ ${ANSWERS[encrypt]:-no} == yes && ${ANSWERS[luks_passphrase]:-} != set ]]; then
    write_secret luks.passphrase "${ANSWERS[luks_passphrase]}"
    ANSWERS[luks_passphrase]='set'
  fi
  build_engine_args
  # `|| status=$?` and not `if ! ...`: inside an `if !` the value of `$?` is the
  # status of the negation, which is always zero when the branch is taken. That
  # exact mistake once made a failed dry run report a successful install.
  status=0
  "$ENGINE" "${ENGINE_ARGS[@]}" --dry-run >>"$RAW_LOG" 2>&1 || status=$?
  if (( status != 0 )); then
    GB_PLANNED=0
    _gb_emit "{\"ok\":false,\"status\":${status},\"error\":\"the plan did not pass the engine's own checks\"}"
    return 0
  fi
  GB_PLANNED=1
  _gb_ok "\"plan_only\":$(if (( PLAN_ONLY )); then printf 'true'; else printf 'false'; fi)"
}

# The confirmation token is compared whole against the one built from the
# canonical target. The engine independently requires the same token, so a
# renderer bug here cannot by itself cause an erase.
gb_execute() {
  local token=$1 expected
  (( GB_PLANNED )) || { _gb_err 'no checked plan. The plan step has to succeed first'; return 0; }
  [[ -z $GB_ENGINE_PID ]] || { _gb_err 'the installation is already running'; return 0; }
  expected=$(aurade_confirmation_token "${ANSWERS[target]:-}" \
    "${ANSWERS[layout]:-$(aurade_question_default layout)}")
  [[ $token == "$expected" ]] || { _gb_err 'the confirmation did not match the disk'; return 0; }
  "$ENGINE" "${ENGINE_ARGS[@]}" --execute --confirm "$expected" >>"$RAW_LOG" 2>&1 &
  GB_ENGINE_PID=$!
  _gb_ok '"started":true'
}

gb_wait() {
  local status=0
  if [[ -z $GB_ENGINE_PID ]]; then
    _gb_err 'nothing is running'
    return 0
  fi
  wait "$GB_ENGINE_PID" || status=$?
  GB_ENGINE_PID=
  _gb_emit "{\"ok\":$(if (( status == 0 )); then printf 'true'; else printf 'false'; fi),\"status\":${status}}"
}

# Whether saving the report worked is decided by looking at the artifact, not
# at the helper's exit status: the helper exits with the install's own status
# on success and 2 on failure, and the install status may itself be 2.
gb_export() {
  local status=$1
  [[ $status =~ ^[0-9]+$ ]] || status=1
  if export_report "$status"; then
    _gb_emit "{\"ok\":true,\"notice\":$(_gb_str "$EXPORT_NOTICE")}"
  else
    _gb_emit "{\"ok\":false,\"notice\":$(_gb_str "$EXPORT_NOTICE"),\"error\":$(_gb_str "$EXPORT_NOTICE")}"
  fi
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------
#
# Two tables, chosen once at startup. In plan-only mode `execute` is not a
# command that is refused; it is a command that does not exist, which is the
# same shape as the text installer's terminal `planned` state. A flag consulted
# just before a destructive call is one edit away from being consulted after it.

_gb_common() {
  local command=$1 argument=$2 value
  case $command in
    manifest)  gb_manifest ;;
    visible)   gb_visible ;;
    disks)     gb_disks ;;
    probe)     gb_probe ;;
    readiness) gb_readiness ;;
    network)   gb_network ;;
    net-status) gb_net_status ;;
    wifi-scan) gb_wifi_scan ;;
    wifi-forget) gb_wifi_forget "$argument" ;;
    wifi-radio) gb_wifi_radio "$argument" ;;
    wifi-connect) IFS= read -r value || value=''; gb_wifi_connect "$argument" "$value" ;;
    stages)    gb_stages ;;
    enum)      gb_enum "$argument" ;;
    answers)   gb_answers ;;
    access)    gb_access ;;
    access-set) gb_access_set "$argument" ;;
    target)    gb_target ;;
    progress)  gb_progress ;;
    failure)   gb_failure ;;
    get)       gb_get "$argument" ;;
    set)       IFS= read -r value || value=''; gb_set "$argument" "$value" ;;
    secret)    IFS= read -r value || value=''; gb_secret "$argument" "$value" ;;
    plan)      gb_plan ;;
    export)    gb_export "$argument" ;;
    ping)      _gb_ok ;;
    *)         return 1 ;;
  esac
  return 0
}

_gb_dispatch_plan_only() {
  _gb_common "$1" "$2" && return 0
  _gb_err "unknown command: $1"
}

_gb_dispatch_full() {
  local command=$1 argument=$2
  case $command in
    execute) gb_execute "$argument"; return 0 ;;
    wait)    gb_wait; return 0 ;;
    stop)    gb_stop; return 0 ;;
  esac
  _gb_common "$command" "$argument" && return 0
  _gb_err "unknown command: $command"
}

GB_DISPATCH=_gb_dispatch_full
(( ! PLAN_ONLY )) || GB_DISPATCH=_gb_dispatch_plan_only

while IFS= read -r line; do
  [[ -n $line ]] || continue
  gb_command=${line%% *}
  gb_argument=''
  [[ $gb_command == "$line" ]] || gb_argument=${line#* }
  [[ $gb_command != quit ]] || break
  "$GB_DISPATCH" "$gb_command" "$gb_argument"
done

exit 0
