#!/usr/bin/env bash
# Interactive front end for aurade-install. The engine remains noninteractive.
set -Eeuo pipefail

ENGINE=${AURADE_INSTALL_ENGINE:-/usr/local/sbin/aurade-install}
[[ -x $ENGINE ]] || ENGINE="$(dirname "$0")/aurade-install"
[[ -x $ENGINE ]] || { echo 'aurade-installer: aurade-install engine not found' >&2; exit 1; }

VALIDATORS=${AURADE_VALIDATE_LIB:-/usr/local/lib/aurade/aurade-validate.sh}
[[ -r $VALIDATORS ]] || VALIDATORS="$(dirname "$0")/../lib/aurade-validate.sh"
[[ -r $VALIDATORS ]] || { echo 'aurade-installer: validation library not found' >&2; exit 1; }
# shellcheck source=../lib/aurade-validate.sh
. "$VALIDATORS"

NETWORK_DIAGNOSTICS=${AURADE_NETWORK_DIAGNOSTICS:-/usr/local/sbin/aurade-network-diagnostics}
[[ -x $NETWORK_DIAGNOSTICS ]] || NETWORK_DIAGNOSTICS="$(dirname "$0")/../archiso/airootfs/usr/local/sbin/aurade-network-diagnostics"

if (( EUID != 0 )); then
  echo 'aurade-installer: run as root from the AuraDE installation image' >&2
  exit 1
fi

snapshot_default=
[[ ! -r /etc/aurade-installer/snapshot ]] || read -r snapshot_default </etc/aurade-installer/snapshot
snapshot_default=${snapshot_default:-$(date -u +%Y/%m/%d)}
bundle_default=/opt/aurade/repo
repo_key_default=$bundle_default/aurade-repository.gpg
fingerprint_default=
[[ ! -r /etc/aurade-installer/repo-fingerprint ]] || read -r fingerprint_default </etc/aurade-installer/repo-fingerprint
repo_url_default=file:///var/cache/aurade/repo
[[ ! -r /etc/aurade-installer/repo-url ]] || read -r repo_url_default </etc/aurade-installer/repo-url

secret_dir=$(mktemp -d /run/aurade-installer.XXXXXX)
chmod 700 "$secret_dir"
secure_remove() {
  local file=$1
  [[ -e $file ]] || return 0
  if command -v shred >/dev/null 2>&1; then
    shred --force --remove --zero "$file" >/dev/null 2>&1 || rm -f -- "$file"
  else
    : >"$file"
    rm -f -- "$file"
  fi
}
cleanup() {
  local file
  if [[ -d ${secret_dir:-} ]]; then
    while IFS= read -r -d '' file; do secure_remove "$file"; done \
      < <(find "$secret_dir" -type f -print0 2>/dev/null || true)
    rmdir -- "$secret_dir" 2>/dev/null || rm -rf -- "$secret_dir"
  fi
}
trap cleanup EXIT INT TERM

read_secret_file() {
  local prompt=$1 destination=$2 response confirmation
  while true; do
    read -r -s -p "$prompt: " response
    printf '\n'
    read -r -s -p "Confirm $prompt: " confirmation
    printf '\n'
    if [[ -n $response && $response == "$confirmation" ]]; then
      umask 077
      printf '%s' "$response" >"$destination"
      chmod 600 "$destination"
      unset response confirmation
      return 0
    fi
    unset response confirmation
    printf '%s\n' 'Values were empty or did not match.' >&2
  done
}

printf '%s\n' 'AuraDE installer' 'This program will show a dry-run plan before it can erase a disk.' ''
if [[ -x $NETWORK_DIAGNOSTICS ]]; then
  printf '%s\n' 'Network and clock preflight:'
  if ! "$NETWORK_DIAGNOSTICS"; then
    printf '%s\n' 'The preflight found an issue. Package acquisition remains bounded and happens before any disk change; fix the issue now if possible.' >&2
  fi
  printf '\n'
fi
lsblk -d -o NAME,PATH,SIZE,MODEL,TRAN,TYPE
while true; do
  printf '\nTarget disk (select an exact PATH from the table above): '
  read -r target
  target=$(readlink -f -- "$target" 2>/dev/null || printf '%s' "$target")
  if [[ -b $target ]] && [[ $(lsblk -dnro TYPE "$target" 2>/dev/null) == disk ]]; then
    break
  fi
  printf '%s\n' 'That is not one of the discovered whole-disk block devices; nothing has been changed. Choose an exact PATH from the table.' >&2
done
target_size=$(lsblk -dnro SIZE "$target")
target_model=$(lsblk -dnro MODEL "$target" | sed 's/[[:space:]]*$//' || true)
target_serial=$(lsblk -dnro SERIAL "$target" | sed 's/[[:space:]]*$//' || true)
target_transport=$(lsblk -dnro TRAN "$target" | sed 's/[[:space:]]*$//' || true)
printf 'Selected disk: %s | size=%s | model=%s | serial=%s | transport=%s\n' \
  "$target" "$target_size" "${target_model:-unknown}" \
  "${target_serial:-unknown}" "${target_transport:-unknown}"
if [[ $target_transport == usb ]]; then
  printf '%s\n' 'WARNING: this is a USB/removable disk. Confirm that it is the intended target; the installer will erase the entire device.' >&2
fi
printf '%s\n' 'Storage note: the installer creates a whole-disk UEFI layout; LUKS2 encryption and Btrfs recovery snapshots consume additional space.'
printf '%s\n' 'Memory note: no swap or hibernation setup is created by default; low-memory systems should add zram or a swapfile after installation.'
while true; do
  printf 'Hostname [aurade]: '
  read -r hostname
  hostname=${hostname:-aurade}
  if aurade_valid_hostname "$hostname"; then
    break
  fi
  printf '%s\n' 'Hostname must be 1-63 letters, digits or inner hyphens (for example aurade-laptop).' >&2
done
while true; do
  printf 'Initial username: '
  read -r username
  if aurade_valid_username "$username"; then
    break
  fi
  printf '%s\n' 'Username must start with a lowercase letter or underscore, contain only lowercase letters, digits, _ or -, and must not be a reserved system account.' >&2
done
while true; do
  printf 'Timezone [UTC]: '
  read -r timezone
  timezone=${timezone:-UTC}
  if aurade_valid_timezone "$timezone"; then
    break
  fi
  printf '%s\n' 'Timezone must name an installed zone (for example America/Chicago or UTC).' >&2
done
while true; do
  printf 'Locale [en_US.UTF-8]: '
  read -r locale
  locale=${locale:-en_US.UTF-8}
  if aurade_valid_locale "$locale"; then
    break
  fi
  printf '%s\n' 'Locale must name an installed locale (for example en_US.UTF-8 or C.UTF-8).' >&2
done
while true; do
  printf 'Keyboard layout [us]: '
  read -r keymap
  keymap=${keymap:-us}
  if aurade_valid_keymap "$keymap"; then
    if command -v loadkeys >/dev/null 2>&1; then
      loadkeys "$keymap" >/dev/null 2>&1 || {
        printf '%s\n' 'The selected keyboard layout could not be loaded; choose another layout.' >&2
        continue
      }
    fi
    break
  fi
  printf '%s\n' 'Keyboard layout must name an installed keymap (for example us or us-altgr-intl).' >&2
done
printf 'Arch snapshot [%s]: ' "$snapshot_default"
read -r snapshot
snapshot=${snapshot:-$snapshot_default}

read_secret_file 'Account password' "$secret_dir/password"
command -v openssl >/dev/null 2>&1 || {
  echo 'aurade-installer: openssl is required to hash the account password' >&2
  exit 1
}
openssl passwd -6 -stdin <"$secret_dir/password" >"$secret_dir/password.hash"
chmod 600 "$secret_dir/password.hash"
secure_remove "$secret_dir/password"

read -r -p 'Encrypt the root filesystem with LUKS2? [Y/n]: ' encrypt_answer
encrypt_answer=${encrypt_answer:-Y}
if [[ $encrypt_answer =~ ^[Yy]$ ]]; then
  read_secret_file 'Disk encryption passphrase' "$secret_dir/luks.passphrase"
fi

common_args=(
  --target "$target"
  --hostname "$hostname"
  --username "$username"
  --timezone "$timezone"
  --locale "$locale"
  --keymap "$keymap"
  --password-hash-file "$secret_dir/password.hash"
  --arch-snapshot "$snapshot"
  --bundle-dir "$bundle_default"
  --repo-url "$repo_url_default"
)

if [[ -r $repo_key_default && -n $fingerprint_default ]]; then
  common_args+=(--repo-key "$repo_key_default" --repo-fingerprint "$fingerprint_default")
else
  printf '%s\n' 'WARNING: this image has no repository trust key; package hashes will be checked but pacman signatures cannot be required.' >&2
  read -r -p 'Type ALLOW-UNSIGNED to use this development image: ' unsigned_confirmation
  [[ $unsigned_confirmation == ALLOW-UNSIGNED ]] || exit 1
  common_args+=(--allow-unsigned)
fi

if [[ $encrypt_answer =~ ^[Yy]$ ]]; then
  common_args+=(--encrypt --luks-passphrase-file "$secret_dir/luks.passphrase")
fi

printf '\n%s\n' 'Dry-run installation plan:'
"$ENGINE" "${common_args[@]}" --dry-run

token="ERASE:$target"
printf '\nThe target will be irreversibly erased. Type exactly: %s\n> ' "$token"
read -r confirmation
[[ $confirmation == "$token" ]] || { echo 'Confirmation did not match; nothing was written.' >&2; exit 1; }

"$ENGINE" "${common_args[@]}" --execute --confirm "$confirmation"
printf '%s\n' 'Installation complete. Remove the installation media and reboot.'
