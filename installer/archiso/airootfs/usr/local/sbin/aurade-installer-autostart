#!/usr/bin/env bash
# Start what the boot menu asked for.
#
# The boot menu is the first screen anyone sees, and it used to offer one entry
# that dropped to a root shell with instructions in the message of the day.
# Reading a paragraph and typing a command is a reasonable thing to ask of
# someone recovering a system and an unreasonable thing to ask of someone
# installing one, so the menu now has an entry per front end and this is what
# turns that choice into a running installer.
#
# The choice arrives on the kernel command line, because that is the only
# channel that exists between a boot menu entry and a booted system, and it is
# read here rather than in the launcher so that `aurade-installer-start` stays
# a command anyone can run with arguments.
#
# Nothing here can install anything. It chooses a front end; both front ends
# ask the same questions and neither writes to a disk until the disk has been
# confirmed by name.
set -Eeuo pipefail

CMDLINE_FILE=${AURADE_CMDLINE_FILE:-/proc/cmdline}
START=${AURADE_INSTALLER_START:-/usr/local/sbin/aurade-installer-start}
# Once per boot. The service owns tty1 until the installer exits, and the stamp
# protects against a manual second invocation on the same live session. The
# stamp lives on a tmpfs, so a restart of the machine is a clean slate.
STAMP=${AURADE_AUTOSTART_STAMP:-/run/aurade-installer-autostarted}

# The last occurrence wins, the way the kernel treats a repeated parameter.
aurade_requested_front_end() {
  local word choice=none
  [[ -r $CMDLINE_FILE ]] || { printf 'none'; return 0; }
  for word in $(<"$CMDLINE_FILE"); do
    case $word in
      aurade.installer=*) choice=${word#aurade.installer=} ;;
    esac
  done
  case $choice in
    gui|speech|text|safe|serial|none) printf '%s' "$choice" ;;
    # An unknown value is a typo in a boot entry, not an instruction. Say so
    # and leave the console alone rather than guessing which was meant.
    *) printf 'unknown:%s' "$choice" ;;
  esac
}

# Bring up console speech before anything draws.
#
# espeakup is a small daemon in front of the kernel's speakup module, so the
# module has to be there first. Both steps are allowed to fail: an image
# without the module, or a machine with no working audio, should still get an
# installer rather than a console that stopped before it started. Somebody who
# chose this entry and hears nothing is in a bad position; somebody who chose
# it and gets no installer at all is in a worse one.
start_speech() {
  modprobe speakup_soft >/dev/null 2>&1 || true
  if command -v systemctl >/dev/null 2>&1; then
    systemctl start espeakup.service >/dev/null 2>&1 || true
  fi
  # Give the daemon a moment to attach before the first screen is drawn,
  # otherwise the welcome screen is spoken to nobody.
  sleep 1
}

# Retire the boot screen, if there is one, and wait until it is really gone.
#
# Every step is allowed to fail. An image with no plymouth, a boot entry with
# no `splash`, or a daemon that has already exited must all end with an
# installer rather than with a console that stopped before it started.
quit_boot_screen() {
  # `--ping` is the whole guard, and it covers both ways there is nothing to
  # quit: no plymouth on this image, and plymouth installed with no boot screen
  # up. The second is not unusual, it is three of the six boot entries, which
  # carry no `splash` on purpose. It matters because `--wait` below blocks
  # until a daemon goes away, and asking it to wait for a daemon that was never
  # there is a console that stops before the installer starts.
  plymouth --ping >/dev/null 2>&1 || return 0
  plymouth quit >/dev/null 2>&1 || true
  # `--wait` returns when the daemon has gone. Without it the next thing to
  # open the graphics device can still be too early, which is the whole bug
  # this is here for, moved a second later.
  plymouth --wait >/dev/null 2>&1 || true
}

main() {
  local choice status=0
  choice=$(aurade_requested_front_end)
  case $choice in
    none) return 0 ;;
    unknown:*)
      printf 'The boot menu asked for "%s", which is not one of the installers.\n' \
        "${choice#unknown:}" >&2
      printf 'Run `aurade-installer-start` to start it yourself.\n' >&2
      return 0
      ;;
  esac

  # Make sure the boot screen has actually gone before anything tries to draw.
  #
  # The unit is ordered after `plymouth-quit.service`, which is the real fix and
  # is what every getty on this image does. This is the second line of defence,
  # because the ordering only helps when that service is present and enabled,
  # and because `quit` returning is a stronger statement than a unit having
  # been started.
  #
  # It matters because of what failure looks like without it. plymouth holds
  # DRM master, `cage` cannot take it, every renderer in the negotiation fails
  # for a reason that is not about graphics, and all of it happens behind a
  # boot screen that hides the messages explaining why. The install still
  # works, in text, and nobody can tell why it did not offer the other one.
  #
  # Plain `quit` rather than `quit --retain-splash`. Retaining the splash is
  # prettier when the graphical installer starts, and leaves an image on the
  # screen with an invisible text installer underneath it when it does not.
  # Until the graphical path is proven on real hardware, the fallback has to
  # be the one that is certain to be readable.
  quit_boot_screen

  [[ -x $START ]] || {
    printf 'The installer is missing from this image.\n' >&2
    printf 'Nothing at %s.\n' "$START" >&2
    return 0
  }

  if [[ -e $STAMP ]]; then
    printf 'The installer has already run on this console.\n' >&2
    printf 'Run `aurade-installer-start` to start it again.\n' >&2
    return 0
  fi
  : >"$STAMP" 2>/dev/null || true

  # The system service owns tty1 while this runs. The recovery-console entry
  # gets the ordinary login shell only after the selected installer exits.
  case $choice in
    gui)    "$START" --graphical || status=$? ;;
    safe)   "$START" --graphical --safe-graphics || status=$? ;;
    text)   "$START" --text || status=$? ;;
    # A serial line cannot show a graphical installer and there is no point
    # probing for one. Everything else about it is ordinary: the text
    # installer measures the terminal at the far end and centres itself in
    # whatever it finds.
    serial) "$START" --text || status=$? ;;
    speech)
      start_speech
      # The boot menu made this choice, so the installer records it as one.
      # Without the second variable somebody boots the speech entry, installs
      # with a talking installer, and reboots into silence having done nothing
      # wrong: the reader was started by this script and never became an
      # answer that travelled to the engine.
      AURADE_TUI_PLAIN=1 AURADE_ACCESS_SCREEN_READER=yes \
        "$START" --text || status=$? ;;
  esac

  printf '\nThe installer closed.\n' >&2
  printf 'Run `aurade-installer-start` to start it again.\n' >&2
  (( status == 0 )) ||
    printf 'It stopped with status %s.\n' "$status" >&2
  return 0
}

main "$@"
