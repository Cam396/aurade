#!/usr/bin/env bash
# Read-only live-session network and clock preflight for actionable installer errors.
set -Eeuo pipefail

QUIET=0
SNAPSHOT=${AURADE_NETWORK_SNAPSHOT:-}
while (($#)); do
  case $1 in
    --quiet) QUIET=1; shift ;;
    --snapshot) SNAPSHOT=${2:?}; shift 2 ;;
    -h|--help)
      printf '%s\n' 'Usage: aurade-network-diagnostics [--quiet] [--snapshot YYYY/MM/DD]'
      exit 0
      ;;
    *) printf 'aurade-network-diagnostics: unknown option: %s\n' "$1" >&2; exit 2 ;;
esac
done

issues=0
report() {
  (( QUIET )) || printf '  %s\n' "$*"
}
# `ERROR:` here is a marker, not a heading. The graphical bridge strips it
# before the line reaches a screen; on a console it is what separates the two
# streams by eye. Nothing a user reads keeps it.
issue() {
  issues=$((issues + 1))
  (( QUIET )) || printf '  ERROR: %s\n' "$*" >&2
}

if [[ -z $SNAPSHOT && -r /etc/aurade-installer/snapshot ]]; then
  read -r SNAPSHOT </etc/aurade-installer/snapshot || true
fi
if [[ -n $SNAPSHOT && ! $SNAPSHOT =~ ^20[0-9]{2}/(0[1-9]|1[0-2])/(0[1-9]|[12][0-9]|3[01])$ ]]; then
  issue 'The package snapshot recorded on this image is not a date. The image was built wrong.'
  SNAPSHOT=
fi

if ! command -v ip >/dev/null 2>&1; then
  issue 'This image has no network tools, so the connection could not be checked.'
else
  if ip -o link show up 2>/dev/null | awk -F': ' '$2 != "lo" {found=1} END {exit !found}'; then
    report 'A network connection is up.'
  else
    issue 'No active network connection. Connect Wi-Fi or a cable before installing.'
  fi
  if ip route show default 2>/dev/null | grep -q '^default '; then
    report 'There is a route out to the internet.'
  else
    issue 'There is no route out to the internet, so the package archive cannot be reached.'
  fi
fi

if ! command -v getent >/dev/null 2>&1; then
  issue 'This image cannot look up names, so the package archive was not checked.'
elif getent ahosts archive.archlinux.org >/dev/null 2>&1; then
  report 'The package archive can be looked up.'
else
  issue 'The package archive could not be looked up. Check the connection, or whether a sign-in page is waiting.'
fi

if [[ -n $SNAPSHOT ]]; then
  if command -v curl >/dev/null 2>&1; then
    archive_url="https://archive.archlinux.org/repos/${SNAPSHOT}/core/os/x86_64/"
    if curl --fail --silent --show-error --connect-timeout 5 --max-time 10 \
      --proto '=https' --output /dev/null "$archive_url"; then
      report "The pinned package snapshot answers (${SNAPSHOT})."
    else
      issue "The pinned package snapshot (${SNAPSHOT}) could not be reached. Check the connection, or whether a sign-in page is waiting."
    fi
  else
    report 'This image cannot fetch over the network, so the package snapshot was not checked.'
  fi
fi

if command -v timedatectl >/dev/null 2>&1; then
  ntp_state=$(timedatectl show --property=NTPSynchronized --value 2>/dev/null || true)
  if [[ $ntp_state == yes ]]; then
    report "This computer's clock is set."
  else
    issue "This computer's clock is wrong. Package signatures will not verify until it is right."
  fi
else
  report "This computer's clock could not be checked. Make sure the date is right before installing."
fi

if (( issues )); then
  (( QUIET )) || printf 'Network check: %d thing(s) to look at. The package list is checked before the disk changes. When memory is tight, downloads happen after formatting.\n' "$issues" >&2
  exit 1
fi
report 'Network check: ready to download packages.'
