# The boot screen.
#
# Thirty five seconds of black was the worst thing in the product. It is the
# first thing the machine does after somebody chooses to install an operating
# system, and it looked exactly like a machine that had not started.
#
# What replaced it was the mark on black with three dots taking turns fading
# up, and the dots were the safe choice rather than the right one. A row of
# pulsing dots is what a boot screen looks like when nobody decided what it
# should look like, which is the opposite of what this product is for.
#
# This screen is lit by the same three fields of light as the installer and
# the login screen. Same colours out of the same tokens, same figure of eight
# drift out of `brand.aurora_drift`, so the boot, the install and the sign in
# are one continuous piece of light rather than three unrelated screens that
# happen to share a logo.
#
# The fields are three images and the arithmetic is here, rather than a film
# of pre-rendered frames, for two reasons. The drift is three incommensurate
# rates and never repeats, so there is no loop to render and cutting one out
# of a long sequence puts a visible jump at the seam. And full screen frames
# cost about a hundred and fifty megabytes resident once plymouth has scaled
# them to a panel. Three sprites cost three.
#
# There is still no progress bar, and that is still deliberate. The kernel does
# not know how long its own boot will take, and a bar that fills at a made up
# rate and then sits at ninety five percent makes a working machine look stuck.
# What the light promises is only what it can keep, which is that this is still
# going.
#
# No message function and no password function, for the same reasons as before:
# a live image has no encrypted root to unlock, and drawing text from a script
# plugin means finding and sizing a font for a case that cannot arise. What can
# arise is something going wrong, and Escape shows the boot messages under
# every theme. That is plymouth's own behaviour and no theme can take it away.

# The product's own dark ground, not black.
#
# It was black, argued from OLED: pixels that are off rather than on, over the
# longest continuous stretch of one colour anybody sees. That argument loses to
# a bigger one. This colour is the surface the installer and the login screen
# both stand on, and the handoff from this screen to those is invisible only if
# all three agree on it. A boot that fades to black and then reveals a slightly
# different dark is a boot with a seam in it.
ground_r = 0.071;
ground_g = 0.075;
ground_b = 0.094;
Window.SetBackgroundTopColor(ground_r, ground_g, ground_b);
Window.SetBackgroundBottomColor(ground_r, ground_g, ground_b);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

# The fields are sized against the longer edge, which is what draw_aurora does,
# so the composition holds the same shape on a wide panel as on a square one.
span = screen_width;
if (screen_height > span) {
  span = screen_height;
}

# Position, radius and rate for each field, lifted from brand.aurora_fields and
# brand.aurora_drift. Peak opacity is already baked into the images, because
# plymouth's opacity is a whole sprite multiplier and doing it twice would put
# half the calculation in a file nothing here can test.
field_x[0] = 0.18; field_y[0] = 0.12; field_r[0] = 0.62;
field_x[1] = 0.86; field_y[1] = 0.30; field_r[1] = 0.55;
field_x[2] = 0.55; field_y[2] = 0.95; field_r[2] = 0.70;

for (i = 0; i < 3; i++) {
  diameter = field_r[i] * span * 2;
  field_image[i] = Image("field-" + i + ".png").Scale(diameter, diameter);
  field_sprite[i] = Sprite(field_image[i]);
  field_sprite[i].SetZ(0);
  field_half[i] = diameter / 2;
}

# Sized against the height rather than the width. A 21:9 monitor is not
# entitled to a bigger logo than a 4:3 one, and sizing off the width gives it
# one.
mark_size = screen_height * 0.15;
if (mark_size < 96) {
  mark_size = 96;
}

mark_image = Image("aurade-mark.png").Scale(mark_size, mark_size);

# The wordmark keeps its own proportions, set against the mark rather than
# against the screen so the two always sit together as one lockup. 628 by 142
# is the shape of the asset.
word_width = mark_size * 1.9;
word_height = word_width * 142 / 628;
word_image = Image("aurade-wordmark.png").Scale(word_width, word_height);

gap = mark_size * 0.34;
lockup_height = mark_size + gap + word_height;
lockup_top = screen_y + (screen_height - lockup_height) / 2;

mark_sprite = Sprite(mark_image);
mark_sprite.SetX(screen_x + (screen_width - mark_size) / 2);
mark_sprite.SetY(lockup_top);
mark_sprite.SetZ(10);

word_sprite = Sprite(word_image);
word_sprite.SetX(screen_x + (screen_width - word_width) / 2);
word_sprite.SetY(lockup_top + mark_size + gap);
word_sprite.SetZ(10);

# How fast the light moves.
#
# Faster here than in the login screen, and the difference is the point. The
# login screen's aurora is a backdrop for however long somebody leaves the
# machine sitting there, so it drifts at about a turn a minute and is meant to
# be noticed only if you look for it. This screen exists for about ten
# seconds. At that speed it would not appear to move at all, and a boot screen
# that does not move is a boot screen somebody is deciding whether to hold the
# power button on.
#
# The refresh function runs about fifty times a second. This is one turn of
# the slowest field in roughly twelve seconds: visible without being urgent,
# because urgency here would be a lie about how long is left.
phase = 0;
step = 0.0105;

fun refresh() {
  phase = phase + step;
  for (i = 0; i < 3; i++) {
    rate = 1.0 + i * 0.37;
    dx = Math.Sin(phase * rate) * 0.035;
    dy = Math.Sin(phase * rate * 2.0 + i) * 0.022;
    field_sprite[i].SetX(screen_x + (field_x[i] + dx) * screen_width
                         - field_half[i]);
    field_sprite[i].SetY(screen_y + (field_y[i] + dy) * screen_height
                         - field_half[i]);
  }
}

Plymouth.SetRefreshFunction(refresh);
