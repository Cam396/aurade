check() {
  AURADE_TEST_ROOT="${srcdir}" \
    AURADE_TEST_SESSION_CHILD="${srcdir}/test-session-child" \
    AURADE_TEST_GREETD="${srcdir}/test-greetd" \
    bash "${srcdir}/test-session-supervisor.sh"
}

package() {
  install -Dm755 aurade-session-control \
    "${pkgdir}/usr/bin/aurade-session-control"
  install -Dm755 aurade-session-supervisor \
    "${pkgdir}/usr/bin/aurade-session-supervisor"
  install -Dm644 aurade-greetd.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-greetd.service"
  install -Dm644 aurade-greetd-vt@.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-greetd-vt@.service"
  install -Dm755 aurade-greetd-vt \
    "${pkgdir}/usr/lib/aurade-login/aurade-greetd-vt"
  install -Dm640 aurade.toml \
    "${pkgdir}/etc/greetd/aurade.toml"
  install -Dm644 49-aurade-greeter-switch.rules \
    "${pkgdir}/usr/share/polkit-1/rules.d/49-aurade-greeter-switch.rules"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
