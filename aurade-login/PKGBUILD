depends=(
  'bash'
  'chromiumos-ash'
  'greetd'
  'greetd-tuigreet'
  'gtklock'
  'pam'
  'polkit'
  'systemd'
  'util-linux'
)
checkdepends=('bubblewrap')
backup=('etc/greetd/aurade.toml')
install='aurade-login.install'
source=(
  'aurade-session-control'
  'aurade-session-supervisor'
  'aurade-greetd.service'
  'aurade-greetd-vt@.service'
  'aurade-greetd-vt'
  'aurade.toml'
  '49-aurade-greeter-switch.rules'
  'LICENSE'
  'aurade-login.install'
  'test-session-supervisor.sh'
  'test-session-child'
  'test-greetd'
)
