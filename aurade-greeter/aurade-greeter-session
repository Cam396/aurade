#!/bin/bash
# The greeter, with the compositor it needs underneath it.
#
# greetd runs a command on a virtual terminal. The greeter is a GTK4 program
# and GTK4 has no way to draw on a bare terminal, so pointing greetd straight
# at `/usr/bin/aurade-greeter` gives a login screen that starts, fails to find
# a display, and exits, over and over, on a machine whose only way in is the
# screen that is not appearing. This is what goes in `aurade.toml`.
#
# Weston with the kiosk shell, and the greeter as its only client. When the
# greeter exits, weston exits with it, which is what tells greetd the
# conversation is over.
set -u

# The photographs, where an installed system keeps them. `brand.py` looks here
# anyway; naming it means a machine that keeps them somewhere else can say so
# in one place rather than in every unit file.
export AURADE_WALLPAPER_DIR="${AURADE_WALLPAPER_DIR:-/usr/share/aurade/wallpapers}"

# logind gives the greeter's session one of these. The fallback is for a
# machine whose PAM stack does not include pam_systemd, where weston would
# otherwise refuse to start with nothing said about why.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Weston writes a screenshot into its working directory, and the greeter user's
# home is `/`. Somewhere writable, and somewhere that already belongs to this
# package.
cd /var/lib/aurade-greeter 2>/dev/null || cd /tmp || exit 1

# A machine with no GPU still gets a login screen. Without a render node this
# user can open, weston composites with pixman and GTK draws with cairo, the
# same rule the desktop session follows. Otherwise weston fails to start,
# greetd starts it again, and the one screen that is the way in never appears.
# Unlike the desktop, a render node this user cannot open is not refused here:
# the screen only has to be good enough to sign in to, and the desktop session
# reports that fault properly once somebody has.
#
# A render node with no 3D behind it counts as none: virtio-gpu on a host that
# gives it no 3D publishes one anyway, GTK then renders with software GL, and
# the animated screen starves its own main loop until a keypress takes a
# minute to land. Bit 0 of the virtio device's features is VIRTIO_GPU_F_VIRGL.
has_3d() {
  local device virtio driver
  device=$(readlink -f "${AURADE_SYSFS_DRM:-/sys/class/drm}/${1##*/}/device" 2>/dev/null) || return 0
  for virtio in "$device"/virtio*; do
    [[ -r $virtio/features ]] || continue
    driver=$(readlink -f "$virtio/driver" 2>/dev/null) || continue
    [[ ${driver##*/} == virtio_gpu ]] || continue
    [[ $(head -c 1 "$virtio/features") == 1 ]] || return 1
  done
  return 0
}
renderer="${AURADE_WESTON_RENDERER:-auto}"
have_render=0
for node in "${AURADE_DRI_DIR:-/dev/dri}"/renderD*; do
  if [[ -r $node && -w $node ]] && has_3d "$node"; then
    have_render=1
    break
  fi
done
if [[ ${AURADE_FORCE_SOFTWARE_RENDERING:-0} == 1 || $have_render == 0 ]]; then
  renderer="${AURADE_WESTON_RENDERER:-pixman}"
  export GSK_RENDERER="${GSK_RENDERER:-cairo}"
fi

# The way in when this screen will not start. greetd starts the greeter again
# every time it exits, so a greeter that dies on this machine would otherwise
# loop forever over the only way to log in. Three failures in a row, each
# within seconds and with an error, in the same boot, hand the screen to the
# text greeter aurade-login ships. A login exits cleanly and resets the count,
# and a new boot tries the graphical greeter again.
FALLBACK_STATE="${AURADE_GREETER_FALLBACK_STATE:-/var/lib/aurade-greeter/quick-exits}"
QUICK_EXIT_SECONDS="${AURADE_GREETER_QUICK_EXIT_SECONDS:-20}"
QUICK_EXIT_LIMIT="${AURADE_GREETER_QUICK_EXIT_LIMIT:-3}"
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
quick_exits=0
if read -r saved_boot saved_count <"$FALLBACK_STATE" 2>/dev/null &&
    [[ $saved_boot == "$boot_id" && $saved_count =~ ^[0-9]+$ ]]; then
  quick_exits=$saved_count
fi
if (( quick_exits >= QUICK_EXIT_LIMIT )); then
  exec tuigreet --time --remember --remember-user-session \
    --asterisks --sessions /usr/share/wayland-sessions \
    --session-wrapper /usr/bin/aurade-session-supervisor \
    --cmd /usr/bin/chromiumos-ash-session
fi

# The keyboard layout. weston types US unless a config file says otherwise,
# and it reads neither the console's KEYMAP nor XKB's environment variables.
# The installer writes the layout as XKB lines in /etc/vconsole.conf, from the
# same conversion the graphical installer typed this machine's passwords with,
# so those lines are what this screen types on. A machine with no XKB lines
# keeps the US this screen has always had: the graphical installer before the
# conversion typed its passwords on US, whatever layout was chosen.
#
# The greeter is told which layout that came to, so that "This keyboard is set
# to" names the one under the cursor rather than one in a file weston ignored.
weston_config=()
xkb_ini=''
xkb_layout=''
vconsole="${AURADE_VCONSOLE_CONF:-/etc/vconsole.conf}"
if [[ -r $vconsole ]]; then
  while IFS='=' read -r key value; do
    value=${value%[\"\']}
    value=${value#[\"\']}
    [[ -n $value ]] || continue
    case $key in
      XKBLAYOUT) xkb_layout=$value; xkb_ini+="keymap_layout=$value"$'\n' ;;
      XKBMODEL) xkb_ini+="keymap_model=$value"$'\n' ;;
      XKBVARIANT) xkb_ini+="keymap_variant=$value"$'\n' ;;
      XKBOPTIONS) xkb_ini+="keymap_options=$value"$'\n' ;;
    esac
  done <"$vconsole"
fi
weston_ini="$XDG_RUNTIME_DIR/aurade-greeter-weston.ini"
if [[ -n $xkb_layout ]] && printf '[keyboard]\n%s' "$xkb_ini" >"$weston_ini" 2>/dev/null; then
  weston_config=(--config="$weston_ini")
else
  xkb_layout=us
fi
export AURADE_GREETER_XKB_LAYOUT="$xkb_layout"

# weston runs as a child rather than in place of this script, because the
# script has to see how it ended. greetd still sees the screen go when weston
# goes, and anything greetd sends to stop the greeter is passed on to weston
# rather than leaving it behind with nothing waiting on it.
started=$(date +%s)
weston \
  --backend=drm \
  --shell=kiosk-shell.so \
  --renderer="$renderer" \
  --idle-time=0 \
  --continue-without-input \
  ${weston_config[@]+"${weston_config[@]}"} \
  -- /usr/bin/aurade-greeter &
weston_pid=$!
trap 'kill -TERM "$weston_pid" 2>/dev/null' TERM INT HUP
status=0
wait "$weston_pid" || status=$?
# A signal interrupts the first wait. The second one collects weston itself.
while kill -0 "$weston_pid" 2>/dev/null; do
  status=0
  wait "$weston_pid" || status=$?
done
if (( status != 0 && $(date +%s) - started < QUICK_EXIT_SECONDS )); then
  quick_exits=$((quick_exits + 1))
else
  quick_exits=0
fi
printf '%s %s\n' "$boot_id" "$quick_exits" >"$FALLBACK_STATE" 2>/dev/null || true
exit "$status"
