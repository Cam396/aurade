#!/bin/bash
# The greeter, with the compositor it needs underneath it.
#
# greetd runs a command on a virtual terminal. The greeter is a GTK4 program
# and GTK4 has no way to draw on a bare terminal, so pointing greetd straight
# at `/usr/bin/aurade-greeter` gives a login screen that starts, fails to find
# a display, and exits, over and over, on a machine whose only way in is the
# screen that is not appearing. This is what goes in `aurade.toml`.
#
# Weston with the kiosk shell, and the greeter as its only client. When the
# greeter exits, weston exits with it, which is what tells greetd the
# conversation is over.
set -u

# The photographs, where an installed system keeps them. `brand.py` looks here
# anyway; naming it means a machine that keeps them somewhere else can say so
# in one place rather than in every unit file.
export AURADE_WALLPAPER_DIR="${AURADE_WALLPAPER_DIR:-/usr/share/aurade/wallpapers}"

# logind gives the greeter's session one of these. The fallback is for a
# machine whose PAM stack does not include pam_systemd, where weston would
# otherwise refuse to start with nothing said about why.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Weston writes a screenshot into its working directory, and the greeter user's
# home is `/`. Somewhere writable, and somewhere that already belongs to this
# package.
cd /var/lib/aurade-greeter 2>/dev/null || cd /tmp || exit 1

# A machine with no GPU still gets a login screen. Without a render node this
# user can open, weston composites with pixman and GTK draws with cairo, the
# same rule the desktop session follows. Otherwise weston fails to start,
# greetd starts it again, and the one screen that is the way in never appears.
# Unlike the desktop, a render node this user cannot open is not refused here:
# the screen only has to be good enough to sign in to, and the desktop session
# reports that fault properly once somebody has.
#
# A render node with no 3D behind it counts as none: virtio-gpu on a host that
# gives it no 3D publishes one anyway, GTK then renders with software GL, and
# the animated screen starves its own main loop until a keypress takes a
# minute to land. Bit 0 of the virtio device's features is VIRTIO_GPU_F_VIRGL.
has_3d() {
  local device virtio driver
  device=$(readlink -f "${AURADE_SYSFS_DRM:-/sys/class/drm}/${1##*/}/device" 2>/dev/null) || return 0
  for virtio in "$device"/virtio*; do
    [[ -r $virtio/features ]] || continue
    driver=$(readlink -f "$virtio/driver" 2>/dev/null) || continue
    [[ ${driver##*/} == virtio_gpu ]] || continue
    [[ $(head -c 1 "$virtio/features") == 1 ]] || return 1
  done
  return 0
}
renderer="${AURADE_WESTON_RENDERER:-auto}"
have_render=0
for node in "${AURADE_DRI_DIR:-/dev/dri}"/renderD*; do
  if [[ -r $node && -w $node ]] && has_3d "$node"; then
    have_render=1
    break
  fi
done
if [[ ${AURADE_FORCE_SOFTWARE_RENDERING:-0} == 1 || $have_render == 0 ]]; then
  renderer="${AURADE_WESTON_RENDERER:-pixman}"
  export GSK_RENDERER="${GSK_RENDERER:-cairo}"
fi

exec weston \
  --backend=drm \
  --shell=kiosk-shell.so \
  --renderer="$renderer" \
  --idle-time=0 \
  --continue-without-input \
  -- /usr/bin/aurade-greeter
