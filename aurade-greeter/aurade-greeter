#!/usr/bin/env python3
"""The AuraDE greeter, started by greetd.

A launcher and nothing else. Everything it needs is one directory over, and
keeping this file empty of decisions means the thing greetd runs is the thing
the tests drive.
"""

import sys

sys.path.insert(0, "/usr/lib/aurade-greeter")

from aurade_greeter.app import run  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(run(sys.argv[1:]))
