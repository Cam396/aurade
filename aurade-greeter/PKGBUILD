_module=(__init__.py accounts.py alerts.py alertui.py app.py copy.py glass.py locate.py glyphs.py greeter.css network.py nmlive.py outlook.py preferences.py protocol.py sessions.py settings.py shade.py weather.py weatherdraw.py weatherui.py a11y.py brand.py status.py tokens.py theme.css theme-dark.css theme-hc.css theme-dark-hc.css theme-oled.css)
_test=(accounts_test.py alerts_test.py copy_test.py glass_test.py locate_test.py network_test.py preferences_test.py protocol_test.py runtime_test.py sessions_test.py settings_test.py shade_test.py outlook_test.py shared_test.py weather_test.py packaging_test.py test-runtime.sh)

_stage() {
  # Put the flat sources back into the shape the package imports, so the
  # tests run against the layout that ships rather than against the one the
  # repository happens to have.
  local name
  install -d "${srcdir}/staged/aurade_greeter" "${srcdir}/staged/tests"
  for name in "${_module[@]}"; do
    install -m644 "${srcdir}/${name}" "${srcdir}/staged/aurade_greeter/${name}"
  done
  for name in "${_test[@]}"; do
    install -m644 "${srcdir}/${name}" "${srcdir}/staged/tests/${name}"
  done
  install -m755 "${srcdir}/run-tests.sh" "${srcdir}/staged/run-tests.sh"
  chmod +x "${srcdir}/staged/tests/test-runtime.sh"
}

check() {
  _stage
  "${srcdir}/staged/run-tests.sh"
}

package() {
  install -Dm755 "${srcdir}/aurade-greeter" "${pkgdir}/usr/bin/aurade-greeter"

  # The compositor wrapper, which is what greetd is pointed at. Beside the
  # package rather than on PATH: it is not a thing to run by hand.
  install -Dm755 "${srcdir}/aurade-greeter-session" \
    "${pkgdir}/usr/lib/aurade-greeter/aurade-greeter-session"

  local name
  for name in "${_module[@]}"; do
    install -Dm644 "${srcdir}/${name}" \
      "${pkgdir}/usr/lib/aurade-greeter/aurade_greeter/${name}"
  done

  # The greeter reads the account list and remembers who signed in last.
  install -dm755 "${pkgdir}/var/lib/aurade-greeter"

  # And it keeps the last reading and the last location here, so a machine
  # that has just come up paints what it knew before the network answers.
  # Its own directory rather than the shared `/var/cache/aurade`, which
  # belongs to no package and is root owned, so writing into it from the
  # greeter user failed silently on every start.
  install -dm755 "${pkgdir}/var/cache/aurade-greeter"

  # The rule that lets this screen join a network. Without it every connect
  # comes back NotAuthorized and the panel can only look.
  install -Dm644 "${srcdir}/49-aurade-greeter-network.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/49-aurade-greeter-network.rules"

  install -Dm644 "${srcdir}/aurade.toml.example" \
    "${pkgdir}/usr/share/aurade-greeter/aurade.toml.example"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
