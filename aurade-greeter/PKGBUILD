depends=(
  'greetd'
  'networkmanager'
  'polkit'
  'gtk4'
  'libadwaita'
  'python'
  'python-gobject'
)
# tuigreet stays alongside rather than being replaced. It is the way in when
# this greeter will not start, and a machine whose only greeter is broken
# needs a rescue disk to log into.
optdepends=(
  'greetd-tuigreet: text greeter, kept as the way in if this one will not start'
  'accountsservice: user pictures and real names on the sign in list'
)
checkdepends=('python' 'weston')
# Basenames, because makepkg resolves every local source to its basename and
# refuses a path. The repository keeps the real tree; the top level entries
# are symlinks into it, which is how aurade-host-bridge exposes its test too.
