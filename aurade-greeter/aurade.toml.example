# The graphical greeter, for a machine that wants it.
#
# Not installed over /etc/greetd/aurade.toml. Switching what greets somebody
# at boot is a decision with a bad failure mode, so this package ships the
# greeter and leaves the switch to whoever is running the machine.
#
# To use it, copy this over /etc/greetd/aurade.toml and restart greetd. To go
# back, put the tuigreet line from aurade-login's aurade.toml back.
#
# Keep greetd-tuigreet installed either way. It is the way in when the
# graphical greeter will not start, and a machine whose only greeter is broken
# is a machine that needs a rescue disk to log into.
#
# The command is the session wrapper, not the greeter. greetd runs its command
# on a bare virtual terminal and a GTK4 program cannot draw on one, so the
# wrapper starts weston first and hands the greeter to it.

[terminal]
vt = 1

[default_session]
command = "/usr/lib/aurade-greeter/aurade-greeter-session"
user = "greeter"
