# Maintainer: AuraDE Contributors

pkgname=aurade-hardware
pkgver=0.1.0
pkgrel=1
_mbpfan_ver=2.4.0
pkgdesc="Hardware support for AuraDE on Surface laptops and Intel Macs"
arch=('x86_64')
url="https://github.com/Cam396/aurade"
license=('BSD-3-Clause' 'GPL-3.0-only')
depends=('glibc' 'mkinitcpio' 'systemd')
provides=('mbpfan')
conflicts=('mbpfan')
backup=('etc/mkinitcpio.conf.d/90-aurade-hardware.conf'
        'etc/mbpfan.conf')
source=(
  "mbpfan-${_mbpfan_ver}.tar.gz::https://github.com/linux-on-mac/mbpfan/archive/refs/tags/v${_mbpfan_ver}.tar.gz"
  '90-aurade-hardware.conf'
  'aurade-mbpfan.service'
  'test-hardware-initramfs.sh'
  'LICENSE'
)
sha256sums=('e1cdcffaba52be215ae40a8568949190866d500d6ae2a1e96b71ab5372f3580b'
            'e6501fe9f55ce7061e94ff5f1baf5bd19f0164251dfa9d1d9976d9f6fb64e554'
            'a98e4a2dee959fcfe4ddb27e050281a582c86c75ef5941d283719f3f28b6ba35'
            '0f7b4eb46dedf54eab65ff4e47ccc733cac6f73ec79ffbef19ea43c97864c975'
            'add5bd0656d73c9f620c35d0c2f978f3607f0621f4052b6a4aabfacb5db271a2')

build() {
  # mbpfan, the fan daemon Intel Macs need: they leave their fans to the
  # operating system.
  make -C "mbpfan-${_mbpfan_ver}"
}

check() {
  bash "${srcdir}/test-hardware-initramfs.sh" "${srcdir}/90-aurade-hardware.conf"
}

package() {
  install -Dm644 90-aurade-hardware.conf \
    "${pkgdir}/etc/mkinitcpio.conf.d/90-aurade-hardware.conf"

  install -Dm755 "mbpfan-${_mbpfan_ver}/bin/mbpfan" "${pkgdir}/usr/bin/mbpfan"
  install -Dm644 "mbpfan-${_mbpfan_ver}/mbpfan.conf" "${pkgdir}/etc/mbpfan.conf"
  install -Dm644 "mbpfan-${_mbpfan_ver}/mbpfan.8.gz" \
    "${pkgdir}/usr/share/man/man8/mbpfan.8.gz"
  install -Dm644 aurade-mbpfan.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-mbpfan.service"
  # On for every install: the unit's own condition keeps it off anything that
  # is not an Intel Mac.
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../aurade-mbpfan.service \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/aurade-mbpfan.service"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "mbpfan-${_mbpfan_ver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/mbpfan-COPYING"
}
