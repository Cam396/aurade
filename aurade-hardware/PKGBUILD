# Maintainer: AuraDE Contributors

pkgname=aurade-hardware
pkgver=0.1.0
pkgrel=4
_mbpfan_ver=2.4.0
pkgdesc="Hardware support for AuraDE: Wi-Fi tuning, Surface laptops and Intel Macs"
arch=('x86_64')
url="https://github.com/Cam396/aurade"
license=('BSD-3-Clause' 'GPL-3.0-only')
depends=('glibc' 'iw' 'mkinitcpio' 'systemd' 'tzdata')
provides=('mbpfan')
conflicts=('mbpfan')
backup=('etc/mkinitcpio.conf.d/90-aurade-hardware.conf'
        'etc/mbpfan.conf')
source=(
  "mbpfan-${_mbpfan_ver}.tar.gz::https://github.com/linux-on-mac/mbpfan/archive/refs/tags/v${_mbpfan_ver}.tar.gz"
  '90-aurade-hardware.conf'
  'aurade-hardware-initcpio.conf'
  'aurade-mbpfan.service'
  'test-hardware-initramfs.sh'
  '90-aurade-wifi.conf'
  'aurade-wifi-country'
  'aurade-wifi-country.service'
  '90-aurade-wifi-country.dispatcher'
  '90-aurade-wifi-country.rules'
  'test-wifi-country.sh'
  'LICENSE'
)
sha256sums=('e1cdcffaba52be215ae40a8568949190866d500d6ae2a1e96b71ab5372f3580b'
            'b210efee7ab94c02c9cfd44a8b219956d265743a37530976c82658669152a712'
            '540547e39e4afe3cb38ba9937a0eada3f13c22af160f827d8c44edb461f1f4de'
            'ea295d9ed34306c71d79a649abd2b58b76a349a64d7117a1520232237db4d7ac'
            'b2d7f08f7a178e4874d1a5a38276f3e13e524e7d962dd9143ecea4ec893b326f'
            'f5ddebcd1acacf50ac69cec64ca78933931d556747beaba604b428231683cf4e'
            '4cfb592853d2bda7e966ee83cab33f300a7e8c5c49ad60dd3f747d327db856b0'
            'f68617c3b2c96169673b970c77ddea1241d8060e47306a5b2e51dd9ef9ead770'
            '543db65ec4397874042d1e268964a3e9a02fe5a77503f0143220b0e5edc6d577'
            'cf9119476ceef974f2deff5874e575467f2c1de0444c859977bbf558852bb776'
            '5ba32b18f4a406131422a820a40e5680852a575c66086bf348173f286914bee6'
            'add5bd0656d73c9f620c35d0c2f978f3607f0621f4052b6a4aabfacb5db271a2')

build() {
  # mbpfan, the fan daemon Intel Macs need: they leave their fans to the
  # operating system.
  make -C "mbpfan-${_mbpfan_ver}"
}

check() {
  bash "${srcdir}/test-hardware-initramfs.sh" "${srcdir}/90-aurade-hardware.conf" \
    "${srcdir}/aurade-hardware-initcpio.conf"
  bash "${srcdir}/test-wifi-country.sh" "${srcdir}/aurade-wifi-country" \
    "${srcdir}/90-aurade-wifi.conf" "${srcdir}/90-aurade-wifi-country.dispatcher"
}

package() {
  install -Dm644 90-aurade-hardware.conf \
    "${pkgdir}/etc/mkinitcpio.conf.d/90-aurade-hardware.conf"
  # The rules themselves. Under usr/lib/initcpio, so installing or updating
  # this package makes mkinitcpio's own hook rebuild the initramfs.
  install -Dm644 aurade-hardware-initcpio.conf \
    "${pkgdir}/usr/lib/initcpio/aurade-hardware.conf"

  install -Dm755 "mbpfan-${_mbpfan_ver}/bin/mbpfan" "${pkgdir}/usr/bin/mbpfan"
  install -Dm644 "mbpfan-${_mbpfan_ver}/mbpfan.conf" "${pkgdir}/etc/mbpfan.conf"
  install -Dm644 "mbpfan-${_mbpfan_ver}/mbpfan.8.gz" \
    "${pkgdir}/usr/share/man/man8/mbpfan.8.gz"
  install -Dm644 aurade-mbpfan.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-mbpfan.service"
  # On for every install: the unit's own condition keeps it off anything that
  # is not an Intel Mac.
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../aurade-mbpfan.service \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/aurade-mbpfan.service"

  # Wi-Fi, on every machine: power saving off, and the country's own limits
  # instead of the worldwide ones.
  install -Dm644 90-aurade-wifi.conf \
    "${pkgdir}/usr/lib/NetworkManager/conf.d/90-aurade-wifi.conf"
  install -Dm755 aurade-wifi-country "${pkgdir}/usr/lib/aurade/aurade-wifi-country"
  install -Dm644 aurade-wifi-country.service \
    "${pkgdir}/usr/lib/systemd/system/aurade-wifi-country.service"
  install -Dm755 90-aurade-wifi-country.dispatcher \
    "${pkgdir}/usr/lib/NetworkManager/dispatcher.d/90-aurade-wifi-country"
  install -Dm644 90-aurade-wifi-country.rules \
    "${pkgdir}/usr/lib/udev/rules.d/90-aurade-wifi-country.rules"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "mbpfan-${_mbpfan_ver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/mbpfan-COPYING"
}
