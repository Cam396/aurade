# aurade-boot.script: the AuraDE boot screen, and the disk unlock in it.
#
# Everything with a shape, every sentence included, is drawn ahead of time by
# tools/build-assets.py, once for each of a set of screen sizes. This script
# picks the set nearest the screen, places it, and moves it. It never scales
# anything but the photograph and the shade over it, because plymouth scales
# by sampling single points and small type does not survive that.
#
# The photographs are not in the theme. The aurade-boot initramfs hook adds
# the wallpapers photos.list names as photo-0.png and on, and a missing one
# is skipped, so the screen still stands on the plain ground without any.

# BEGIN GENERATED by tools/build-assets.py; edit that, not this.
scales[0] = 0.75; scale_dirs[0] = "s075";
scales[1] = 1; scale_dirs[1] = "s100";
scales[2] = 1.25; scale_dirs[2] = "s125";
scales[3] = 1.5; scale_dirs[3] = "s150";
scales[4] = 1.75; scale_dirs[4] = "s175";
scales[5] = 2; scale_dirs[5] = "s200";
scales[6] = 2.5; scale_dirs[6] = "s250";
scales[7] = 3; scale_dirs[7] = "s300";
scale_count = 8;
photo_shade[0] = 1; photo_pool[0] = 0;
photo_shade[1] = 1; photo_pool[1] = 0.75;
photo_shade[2] = 1; photo_pool[2] = 0;
photo_shade[3] = 1; photo_pool[3] = 0.45;
photo_shade[4] = 0.8; photo_pool[4] = 0;
photo_shade[5] = 0.7; photo_pool[5] = 0.25;
photo_shade[6] = 0.85; photo_pool[6] = 0;
photo_shade[7] = 1; photo_pool[7] = 0.3;
photo_count = 8;
L.field_y = 0.64;
L.mark_dy = -172;
L.title_dy = -98;
L.subtitle_dy = -64;
L.status_dy = 54;
L.field_w = 420;
L.field_h = 52;
L.inset = 22;
L.dot = 8;
L.dot_step = 15;
L.caret_w = 2;
L.caret_h = 20;
L.go = 36;
L.caption_margin = 28;
L.rise = 10;
L.shadow_pad = 16;
L.plain_pad = 4;
L.field_pad = 28;
L.mark = 56;
L.mark_pad = 16;
# END GENERATED

FPS = 50;
Plymouth.SetRefreshRate(FPS);

# The ground every AuraDE surface stands on, the greeter's #121318.
Window.SetBackgroundTopColor(0.071, 0.075, 0.094);
Window.SetBackgroundBottomColor(0.071, 0.075, 0.094);

# -- state ------------------------------------------------------------------

t = 0;                  # frames since the script started
mode = "boot";          # boot, ask, unlocking, starting, ending
bullets = 0;            # characters typed so far, as plymouth counts them
last_prompt = "";       # the prompt last asked, to tell a retry from a new disk
failed = 0;             # the last answer did not unlock anything
failed_t = -1000;       # when it failed, for the shake
asked_t = -1;           # when the question first appeared, for its entrance
left_t = -1;            # when the question went, for its exit
typed_t = 0;            # the last keystroke, so the caret holds still while typing
capslock = 0;
status_key = "";        # which sentence the status line shows
status_t = 0;           # when it changed, for its fade
message_text = "";

slot = -1;              # which photograph, chosen once per boot
field_state = "";       # which field image is up, so it is set only on a change
label_key = "";         # and which label

# -- small helpers ----------------------------------------------------------

fun clamp01(v) {
  if (v < 0) return 0;
  if (v > 1) return 1;
  return v;
}

# Eased progress of an animation that started at frame `start` and lasts
# `frames`: 0 before it, 1 after it, a cubic ease out in between.
fun ease(start, frames) {
  local.p = clamp01((t - start) / frames);
  local.q = 1 - p;
  return 1 - q * q * q;
}

fun asset(name) {
  return Image(scale_dir + "/" + name);
}

fun place_centred(sprite, x, y) {
  local.image = sprite.GetImage();
  if (!image) return;
  sprite.SetX(Math.Int(x - image.GetWidth() / 2));
  sprite.SetY(Math.Int(y - image.GetHeight() / 2));
}

# -- the photograph ---------------------------------------------------------

fun choose_photo() {
  # The initramfs carries a few of the photographs, not all of them, so a
  # slot can be empty. A few random tries, then the first that is there.
  if (photo_count < 1) return -1;
  for (local.n = 0; n < photo_count * 2; n++) {
    local.i = Math.Int(Math.Random() * photo_count);
    if (i >= photo_count) i = photo_count - 1;
    local.image = Image("photo-" + i + ".png");
    if (image) {
      global.photo_source = image;
      return i;
    }
  }
  for (local.i = 0; i < photo_count; i++) {
    local.image = Image("photo-" + i + ".png");
    if (image) {
      global.photo_source = image;
      return i;
    }
  }
  return -1;
}

# -- layout -----------------------------------------------------------------

photo_sprite = Sprite();
shade_sprite = Sprite();
pool_sprite = Sprite();
caption_sprite = Sprite();
mark_sprite = Sprite();
title_sprite = Sprite();
subtitle_sprite = Sprite();
field_sprite = Sprite();
placeholder_sprite = Sprite();
caret_sprite = Sprite();
status_sprite = Sprite();
message_sprite = Sprite();
label_sprite = Sprite();
keyboard_icon_sprite = Sprite();
keyboard_text_sprite = Sprite();
keyboard_shadow_sprite = Sprite();
dot_count = 0;

photo_sprite.SetZ(-30);
shade_sprite.SetZ(-20);
pool_sprite.SetZ(-19);
caption_sprite.SetZ(5);
mark_sprite.SetZ(10);
title_sprite.SetZ(10);
subtitle_sprite.SetZ(10);
label_sprite.SetZ(10);
field_sprite.SetZ(11);
placeholder_sprite.SetZ(12);
caret_sprite.SetZ(13);
status_sprite.SetZ(10);
message_sprite.SetZ(10);
keyboard_shadow_sprite.SetZ(5);
keyboard_text_sprite.SetZ(6);
keyboard_icon_sprite.SetZ(6);

fun layout() {
  # Plymouth draws one canvas as large as the largest screen and shows each
  # screen its centred part, so the part every screen shows is the centred
  # rectangle as small as the smallest. Everything that matters goes in it.
  global.canvas_w = Window.GetWidth();
  global.canvas_h = Window.GetHeight();
  local.w = canvas_w;
  local.h = canvas_h;
  for (local.i = 0; Window.GetWidth(i); i++) {
    if (Window.GetWidth(i) < w) w = Window.GetWidth(i);
    if (Window.GetHeight(i) < h) h = Window.GetHeight(i);
  }
  global.view_w = w;
  global.view_h = h;
  global.view_x = Math.Int((canvas_w - w) / 2);
  global.view_y = Math.Int((canvas_h - h) / 2);

  # The drawn size nearest the screen, of the ones this initramfs carries.
  local.u = Math.Min(h / 1080, w / 1600);
  local.best = -1;
  for (local.i = 0; i < scale_count; i++) {
    if (best < 0 || Math.Abs(scales[i] - u) < Math.Abs(scales[best] - u) - 0.0001) {
      if (Image(scale_dirs[i] + "/dot.png")) best = i;
    }
  }
  if (best < 0) best = 1;
  global.s = scales[best];
  global.scale_dir = scale_dirs[best];

  global.cx = view_x + Math.Int(w / 2);
  global.fy = view_y + Math.Int(h * L.field_y);
  global.field_left = cx - L.field_w * s / 2;

  if (slot >= 0) {
    local.pw = photo_source.GetWidth();
    local.ph = photo_source.GetHeight();
    local.k = Math.Max(canvas_w / pw, canvas_h / ph);
    local.sw = Math.Int(pw * k + 0.999);
    local.sh = Math.Int(ph * k + 0.999);
    photo_sprite.SetImage(photo_source.Scale(sw, sh));
    photo_sprite.SetX(Math.Int((canvas_w - sw) / 2));
    photo_sprite.SetY(Math.Int((canvas_h - sh) / 2));
    shade_sprite.SetImage(Image("shade.png").Scale(canvas_w, canvas_h));
    shade_sprite.SetX(0);
    shade_sprite.SetY(0);
    if (photo_pool[slot] > 0) {
      pool_sprite.SetImage(Image("pool.png").Scale(view_w, view_h));
      pool_sprite.SetX(view_x);
      pool_sprite.SetY(view_y);
    }
    caption_sprite.SetImage(asset("caption-" + slot + ".png"));
    local.cap = caption_sprite.GetImage();
    if (cap) {
      caption_sprite.SetX(Math.Int(view_x + (L.caption_margin - L.shadow_pad) * s));
      caption_sprite.SetY(Math.Int(view_y + view_h - L.caption_margin * s - cap.GetHeight() + L.shadow_pad * s));
    }
  }

  mark_sprite.SetImage(asset("mark.png"));
  title_sprite.SetImage(asset("title.png"));
  subtitle_sprite.SetImage(asset("subtitle.png"));
  placeholder_sprite.SetImage(asset("placeholder.png"));
  caret_sprite.SetImage(asset("caret.png"));

  global.field_images["idle"] = asset("field-idle.png");
  global.field_images["focus"] = asset("field-focus.png");
  global.field_images["ready"] = asset("field-ready.png");
  global.field_images["error"] = asset("field-error.png");
  global.dot_image = asset("dot.png");
  global.status_images["error"] = asset("error.png");
  global.status_images["capslock"] = asset("capslock.png");
  global.status_images["unlocking"] = asset("unlocking.png");
  global.label_images["starting"] = asset("starting.png");
  global.label_images["shutdown"] = asset("shutdown.png");
  global.label_images["reboot"] = asset("reboot.png");

  # How many dots fit before the round button, and the dots themselves.
  local.room = L.field_w - L.inset - L.go - (L.field_h - L.go) / 2 - 6;
  global.dot_room = Math.Int(room / L.dot_step);
  for (local.i = 0; i < dot_room; i++) {
    if (i >= dot_count) {
      global.dots[i] = Sprite();
      global.dots[i].SetZ(12);
      global.dots[i].SetOpacity(0);
      global.dot_born[i] = -1000;
      global.dot_count = i + 1;
    }
    global.dots[i].SetImage(dot_image);
  }
  for (local.i = dot_room; i < dot_count; i++) dots[i].SetOpacity(0);

  place_keyboard();
  global.field_state = "";
  global.label_key = "";
  if (status_key != "") status_sprite.SetImage(status_images[status_key]);
  if (message_text != "") show_message(message_text);
  draw();
}

# -- drawing ----------------------------------------------------------------

# Everything that moves is placed again each frame from the state, so a
# change of screen in the middle of an animation lands in the right place.
fun draw() {
  # The screen arrives: the photograph fades up from the ground once, then
  # the mark settles in. Both only the first time; a second screen laid out
  # later appears as it is.
  local.photo_in = ease(0, 18);
  photo_sprite.SetOpacity(photo_in);
  if (slot >= 0) {
    shade_sprite.SetOpacity(photo_in * photo_shade[slot]);
    pool_sprite.SetOpacity(photo_in * photo_pool[slot]);
    caption_sprite.SetOpacity(ease(20, 24));
  }

  local.mark_in = ease(6, 24);
  mark_sprite.SetOpacity(mark_in);
  place_centred(mark_sprite, cx, fy + L.mark_dy * s + (1 - mark_in) * L.rise * s);

  # The question rises into place under the mark, and leaves the same way.
  local.q = 0;
  if (asked_t >= 0) q = ease(asked_t, 22);
  if (left_t >= 0) q = q * (1 - ease(left_t, 16));
  local.lift = (1 - q) * L.rise * s;
  if (left_t >= 0) lift = -(1 - q) * L.rise * s * 0.5;

  title_sprite.SetOpacity(q);
  place_centred(title_sprite, cx, fy + L.title_dy * s + lift);
  subtitle_sprite.SetOpacity(q);
  place_centred(subtitle_sprite, cx, fy + L.subtitle_dy * s + lift);

  # A failed answer shakes the field, three times and smaller each time.
  local.dx = 0;
  local.since = t - failed_t;
  if (since >= 0 && since < 26) {
    local.decay = 1 - since / 26;
    dx = Math.Sin(since * 0.75) * 9 * s * decay * decay;
  }

  local.state = "focus";
  if (mode == "unlocking" || mode == "starting") state = "idle";
  else if (failed && bullets == 0) state = "error";
  else if (bullets > 0) state = "ready";
  if (state != field_state) {
    # Setting an image redraws it, even the same one, so only on a change.
    field_sprite.SetImage(field_images[state]);
    global.field_state = state;
  }
  field_sprite.SetOpacity(q);
  place_centred(field_sprite, cx + dx, fy + lift);

  local.left = field_left + L.inset * s + dx;
  local.shown = Math.Min(bullets, dot_room);
  for (local.i = 0; i < dot_count; i++) {
    local.a = 0;
    if (i < shown) {
      a = clamp01((t - dot_born[i]) / 5);
      # A passphrase longer than the field slides under its left edge.
      if (bullets > dot_room && i == 0) a = a * 0.35;
      if (bullets > dot_room && i == 1) a = a * 0.7;
      if (mode == "unlocking" || mode == "starting") a = a * 0.55;
    }
    dots[i].SetOpacity(a * q);
    dots[i].SetX(Math.Int(left + i * L.dot_step * s));
    dots[i].SetY(Math.Int(fy + lift - dot_image.GetHeight() / 2));
  }

  local.hint = 0;
  if (bullets == 0 && mode == "ask") hint = q;
  placeholder_sprite.SetOpacity(hint);
  local.ph = placeholder_sprite.GetImage();
  placeholder_sprite.SetX(Math.Int(left - L.plain_pad * s));
  placeholder_sprite.SetY(Math.Int(fy + lift - ph.GetHeight() / 2));

  # The caret: still while typing, then a slow soft blink.
  local.c = 0;
  if (mode == "ask") {
    local.idle = t - typed_t;
    local.phase = idle % 60;
    c = 1;
    if (idle > 30) {
      if (phase >= 30 && phase < 38) c = 1 - (phase - 30) / 8;
      else if (phase >= 38 && phase < 52) c = 0;
      else if (phase >= 52) c = (phase - 52) / 8;
    }
  }
  caret_sprite.SetOpacity(c * q);
  local.ci = caret_sprite.GetImage();
  local.caret_x = left + shown * L.dot_step * s + 2 * s;
  if (shown == 0) caret_x = left - 3 * s;
  caret_sprite.SetX(Math.Int(caret_x));
  caret_sprite.SetY(Math.Int(fy + lift - ci.GetHeight() / 2));

  draw_status(q, lift);
  draw_label();

  keyboard_text_sprite.SetOpacity(q);
  keyboard_shadow_sprite.SetOpacity(q);
  keyboard_icon_sprite.SetOpacity(q);
}

fun set_status(key) {
  if (key == status_key) return;
  global.status_key = key;
  global.status_t = t;
  if (key != "") status_sprite.SetImage(status_images[key]);
}

fun draw_status(q, lift) {
  local.key = "";
  if (mode == "unlocking") key = "unlocking";
  else if (mode == "ask" && capslock) key = "capslock";
  else if (mode == "ask" && failed && bullets == 0) key = "error";
  set_status(key);
  local.a = 0;
  if (status_key != "") {
    a = ease(status_t, 10);
    # Unlocking breathes, slowly, so a long key derivation still looks alive.
    if (status_key == "unlocking") a = a * (0.62 + 0.38 * (0.5 + 0.5 * Math.Cos((t - status_t) * 2 * Math.Pi / 80)));
  }
  status_sprite.SetOpacity(a * q);
  place_centred(status_sprite, cx, fy + L.status_dy * s + lift);
}

fun draw_label() {
  local.key = "";
  if (mode == "starting") key = "starting";
  if (mode == "ending") key = Plymouth.GetMode();
  if (key == "" || !label_images[key]) {
    label_sprite.SetOpacity(0);
    return;
  }
  if (key != label_key) {
    label_sprite.SetImage(label_images[key]);
    global.label_key = key;
  }
  local.a = ease(label_t, 20);
  label_sprite.SetOpacity(a);
  place_centred(label_sprite, cx, fy + L.title_dy * s + (1 - a) * L.rise * s * 0.6);
}

# The keyboard layout the passphrase is being typed with, in the corner
# opposite the caption. The initramfs hook sets `keyboard` only when the
# layout is not plain US, or when the console and plymouth disagree, which is
# when a passphrase is most likely to go in wrong.
fun place_keyboard() {
  if (!keyboard) return;
  local.font = "Sans " + Math.Int(12 * s + 0.5) + "px";
  local.text = Image.Text(keyboard, 1, 1, 1, 0.74, font);
  local.shadow = Image.Text(keyboard, 0, 0, 0, 0.5, font);
  if (!text) return;
  local.right = view_x + view_w - L.caption_margin * s;
  local.mid = view_y + view_h - L.caption_margin * s - 8 * s;
  local.x = Math.Int(right - text.GetWidth());
  local.y = Math.Int(mid - text.GetHeight() / 2);
  keyboard_text_sprite.SetImage(text);
  keyboard_text_sprite.SetX(x);
  keyboard_text_sprite.SetY(y);
  keyboard_shadow_sprite.SetImage(shadow);
  keyboard_shadow_sprite.SetX(x);
  keyboard_shadow_sprite.SetY(Math.Int(y + s));
  keyboard_icon_sprite.SetImage(asset("keyboard.png"));
  local.icon = keyboard_icon_sprite.GetImage();
  if (icon) {
    keyboard_icon_sprite.SetX(Math.Int(x - 7 * s - icon.GetWidth() + L.plain_pad * s));
    keyboard_icon_sprite.SetY(Math.Int(mid - icon.GetHeight() / 2));
  }
}

fun show_message(text) {
  global.message_text = text;
  local.size = Math.Int(13 * s + 0.5);
  message_sprite.SetImage(Image.Text(text, 1, 1, 1, 0.78, "Sans " + size + "px", "center"));
  place_centred(message_sprite, cx, view_y + view_h - L.caption_margin * s - 10 * s);
  message_sprite.SetOpacity(1);
}

# -- plymouth's callbacks ---------------------------------------------------

fun on_refresh() {
  global.t = t + 1;
  if (mode == "ask" && t % 10 == 0) {
    local.now = Plymouth.GetCapslockState();
    if (now) global.capslock = 1;
    else global.capslock = 0;
  }
  draw();
}

fun on_password(prompt, count) {
  if (mode == "unlocking" && prompt == last_prompt) {
    # The same question again straight after an answer: the answer was wrong.
    global.failed = 1;
    global.failed_t = t;
  }
  if (mode != "ask") {
    global.mode = "ask";
    if (asked_t < 0 || left_t >= 0) global.asked_t = t;
    global.left_t = -1;
  }
  if (count > bullets) {
    for (local.i = bullets; i < count && i < dot_room; i++) global.dot_born[i] = t;
    if (count > dot_room) {
      # The row is full: everything shifts left by one, so the newest dot is
      # the one that arrives.
      global.dot_born[dot_room - 1] = t;
    }
    global.failed = 0;
  }
  if (count != bullets) global.typed_t = t;
  global.bullets = count;
  global.last_prompt = prompt;
}

fun on_normal() {
  if (mode == "ask") {
    global.mode = "unlocking";
    global.typed_t = t;
  }
}

fun on_root_mounted() {
  # The disk is open and the system it holds is starting.
  if (mode == "ask" || mode == "unlocking") global.left_t = t;
  global.mode = "starting";
  global.failed = 0;
  global.label_t = t;
}

fun on_message(text) {
  show_message(text);
}

fun on_hide_message(text) {
  global.message_text = "";
  message_sprite.SetOpacity(0);
}

fun on_quit() {
  global.mode = "ending";
  global.left_t = t;
  draw();
}

label_t = 0;
if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot") {
  mode = "ending";
}

slot = choose_photo();
layout();

Plymouth.SetRefreshFunction(on_refresh);
Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayNormalFunction(on_normal);
Plymouth.SetRootMountedFunction(on_root_mounted);
Plymouth.SetDisplayMessageFunction(on_message);
Plymouth.SetHideMessageFunction(on_hide_message);
Plymouth.SetDisplayHotplugFunction(layout);
Plymouth.SetQuitFunction(on_quit);
