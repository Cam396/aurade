package() {
    install -Dm755 "${srcdir}/aurade" \
        "${pkgdir}/usr/bin/aurade"
    install -Dm755 "${srcdir}/aurade-session" \
        "${pkgdir}/usr/bin/aurade-session"
    install -Dm755 "${srcdir}/aurade-shell" \
        "${pkgdir}/usr/bin/aurade-shell"
    install -Dm755 "${srcdir}/aurade-hardware-report" \
        "${pkgdir}/usr/bin/aurade-hardware-report"
    install -Dm755 "${srcdir}/aurade-audio" \
        "${pkgdir}/usr/bin/aurade-audio"

