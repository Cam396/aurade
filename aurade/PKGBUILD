        "${pkgdir}/usr/share/wayland-sessions/aurade.desktop"
    install -Dm644 "${srcdir}/aurade-shell.desktop" \
        "${pkgdir}/usr/share/xsessions/aurade-shell.desktop"

    install -Dm644 "${srcdir}/LICENSE" \
